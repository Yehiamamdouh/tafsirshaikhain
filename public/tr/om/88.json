[["Sila oduun haguugduu (Qiyaamaa) sitti dhufeeraa? [1]","[1] hagooyduun maqaa qiyaamaati."],["Fuulleen (gariin) guyyaa san xiqqaattuudha.[2]","[2] sun fuula warra hoongayeeti."],["Hojjattuu ifaajjuudha.",""],["Ibidda gubduu seenti.",""],["Burqituu danfituu irraa obaafamti.",""],["Adaamii (cuqun) (hadhaawaa, ajaawaa) malee nyaanni isaaniif hin jiru.",""],["(isa nyaachuun) Hin gabbisu; beela irraas hin duroomsu.",""],["Fuulleen gariin guyyaa san qananiituudha. [3]","[3] sunfuula warra milkaayeeti, mu'imintootaati."],["Dalagaa ishee jaalattuudha.",""],["Jannata ol fuudhamtuu keessa jiraatti.",""],["Ishee keessatti waca hin dhageessu.",""],["Ishee keessa burqituu yaatutu jirti.",""],["Ishee keessa sireewwan ol fuudhamtuutu jirti.",""],["Kubbaayyaawwan kaa’amtuutu jirti.",""],["Boraatiiwwan tarree galfamantu (isaaniif jira).",""],["Afaawwan diriirfamanis (isaaniif jirti).",""],["Sila gara gaalaa hin ilaalanuu akkamitti akka uumamte?",""],["Gara samii akkamitti akka ol fuudhamte (hin ilaalanuu)?",""],["Gara gaarreenis akkamitti akka dhaabamte (hin ilaalanuu)?",""],["Gara dachiis akkamitti akka diriirfamte (hin ilaalanuu)?",""],["Yaadachiisi; ati yaadachiisaa qofa.",""],["Isaan irratti dirqisiisaa hin taane.",""],["Nama gara galee kafare malee,",""],["Rabbiin adabbii guddaa isa adaba. [4]","[4] jahannam isa seensisa."],["Deebiin isaanii garuma Keenya.",""],["Ergasii qormaanni isaanii Nurra jira.",""]]