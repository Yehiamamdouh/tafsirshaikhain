rty=\"og:locale\" content=\"mdh_PH\">\n<meta property=\"og:type\" content=\"article\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta property=\"og:image:width\" content=\"1200\">\n<meta property=\"og:image:height\" content=\"630\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<link rel=\"manifest\" href=\"/manifest.webmanifest\">\n<link rel=\"apple-touch-icon\" href=\"/icon-192.png\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"Tafsir ng Saba 34:51 — ayon kina Ibn Taymiyya at Ibn al-Qayyim\", \"description\": \"Endu upama ka mailay nengka bu su katekaw sa kanilan sa kanu kambuwat a dala palaguyan nin endu kwan silan kanu kubur nilan a masupeg.\", \"inLanguage\": \"mdh\", \"url\": \"https://tafsirshaikhain.com/mdh/ayah/34-51.html\", \"mainEntityOfPage\": \"https://tafsirshaikhain.com/mdh/ayah/34-51.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"Shaykh al-Islam Ibn Taymiyya\"}, {\"@type\": \"Person\", \"name\": \"Imam Ibn al-Qayyim\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"Tafsir ng Dalawang Shaykh\", \"url\": \"https://tafsirshaikhain.com/mdh/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://tafsirshaikhain.com/mdh/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Saba\", \"item\": \"https://tafsirshaikhain.com/mdh/surah/34.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Talata 51\", \"item\": \"https://tafsirshaikhain.com/mdh/ayah/34-51.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.muy{display:grid;gap:6px;background:var(--sheet,#fff);border:1px dashed var(--line,#d9dee6);border-inline-start:4px solid var(--muted,#5b6676);border-radius:10px;padding:12px 14px;margin:4px 0}.muy-head{display:flex;flex-wrap:wrap;gap:4px 10px;align-items:baseline}.muy-head b{font-family:var(--f-display,sans-serif);font-weight:600;font-size:15px}.muy-head small{font-size:12.5px;color:var(--muted,#5b6676)}.muy-text{margin:0;font-family:var(--f-read,serif);font-size:17px;line-height:1.95;overflow-wrap:anywhere}.muy-fn{margin:0;font-size:14px;line-height:1.7;color:var(--muted,#5b6676);white-space:pre-line}.muy-credit{font-size:12px;color:var(--muted,#5b6676);overflow-wrap:anywhere}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/mdh/\">Home</a> › <a href=\"/mdh/surah/34.html\">Surah Saba</a> › Talata 51</nav><h1>Tafsir ng Surah Saba 34:51</h1><p class=\"vt ar\" lang=\"ar\">﴿وَلَوْ تَرَىٰ إِذْ فَزِعُوا فَلَا فَوْتَ وَأُخِذُوا مِن مَّكَانٍ قَرِيبٍ﴾</p><section><h3>Salin ng kahulugan</h3><p class=\"tr\">Endu upama ka mailay nengka bu su katekaw sa kanilan sa kanu kambuwat a dala palaguyan nin endu kwan silan kanu kubur nilan a masupeg.</p><span class=\"cr\" dir=\"ltr\">Filipino Translation (Maguindanaon) - Rowwad Translation Center — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">Ang mga salita ng dalawang imam ay ibinibigay sa orihinal na Arabe, salita sa salita, kasama ang mga sanggunian.</p><section><h2>Shaykh al-Islam Ibn Taymiyya</h2><blockquote class=\"ar\" lang=\"ar\">وهو سبحانه يذكر جواب القسم تارة وهو الغالب. وتارة يحذفه كما يحذف جواب لو كثيرا كقوله تعالى: {لو تعلمون علم اليقين} وقوله: {ولو أن قرآنا سيرت به الجبال} {ولو ترى إذ يتوفى الذين كفروا الملائكة} {ولو ترى إذ فزعوا فلا فوت} {ولو ترى إذ وقفوا على النار} {ولو ترى إذ وقفوا على ربهم} . ومثل هذا حذفه من أحسن الكلام؛ لأن المراد أنك لو رأيته لرأيت هولا عظيما<cite>«مجموع الفتاوى» 13/315</cite></blockquote></section><section><h2>Imam Ibn al-Qayyim</h2><h3>Ang sinipi niya mula sa iba</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">شيخه ابن تيمية (فصل أقسام القرآن، مجموع الفتاوى 13/314-316)</span> <span class=\"st\">أقرّه</span> «قوله تعالى {ولو يرى الذين ظلموا إذ يرون العذاب أن القوة لله جميعا وأن الله شديد العذاب} فالمعنى في أظهر الوجهين لو يرى الذين ظلموا في الدنيا إذ يرون العذاب في الآخرة والجواب محذوف ثم قال {أن القوة لله جميعا} كما قال تعالى {ولو ترى إذ فزعوا فلا فوت} {ولو ترى إذ يتوفى الذين كفروا الملائكة} أي لو ترى ذلك الوقت وما فيه»<cite>«التبيان في أقسام القرآن» 1/3</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=mdh#s34a51\">Buksan sa interaktibong tafsir (buong mga teksto)</a><div class=\"pn\"><a href=\"/mdh/ayah/34-50.html\">Naunang talata (34:50)</a><a href=\"/mdh/ayah/34-54.html\">Susunod na talata (34:54)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/34-51.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/34-51.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/34-51.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/34-51.html\" href