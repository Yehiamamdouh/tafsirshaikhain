px 48px;line-height:1.6}.muy{display:grid;gap:6px;background:var(--sheet,#fff);border:1px dashed var(--line,#d9dee6);border-inline-start:4px solid var(--muted,#5b6676);border-radius:10px;padding:12px 14px;margin:4px 0}.muy-head{display:flex;flex-wrap:wrap;gap:4px 10px;align-items:baseline}.muy-head b{font-family:var(--f-display,sans-serif);font-weight:600;font-size:15px}.muy-head small{font-size:12.5px;color:var(--muted,#5b6676)}.muy-text{margin:0;font-family:var(--f-read,serif);font-size:17px;line-height:1.95;overflow-wrap:anywhere}.muy-fn{margin:0;font-size:14px;line-height:1.7;color:var(--muted,#5b6676);white-space:pre-line}.muy-credit{font-size:12px;color:var(--muted,#5b6676);overflow-wrap:anywhere}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ml/\">ഹോം</a> › <a href=\"/ml/surah/110.html\">സൂറത്ത് An-Nasr</a> › ആയത്ത് 3</nav><h1>തഫ്സീർ: സൂറത്ത് An-Nasr 110:3</h1><p class=\"vt ar\" lang=\"ar\">﴿فَسَبِّحْ بِحَمْدِ رَبِّكَ وَاسْتَغْفِرْهُ إِنَّهُ كَانَ تَوَّابًا﴾</p><section><h3>അർത്ഥവിവർത്തനം</h3><p class=\"tr\">നിന്റെ രക്ഷിതാവിനെ സ്തുതിക്കുന്നതോടൊപ്പം നീ അവന്റെ പരിശുദ്ധിയെ പ്രകീര്‍ത്തിക്കുകയും, നീ അവനോട് പാപമോചനം തേടുകയും ചെയ്യുക. തീര്‍ച്ചയായും അവന്‍ പശ്ചാത്താപം സ്വീകരിക്കുന്നവനാകുന്നു.</p><span class=\"cr\" dir=\"ltr\">Malayalam Translation - Abdul Hamid Haidar and Kunhi Muhammad — v1.0.3 · QuranEnc.com</span></section><p class=\"cr\">രണ്ട് ഇമാമുമാരുടെയും വാക്കുകൾ മൂല അറബിയിൽ, അതേപടി, അവലംബങ്ങളോടെ നൽകിയിരിക്കുന്നു.</p><section><h2>ശൈഖുൽ ഇസ്‌ലാം ഇബ്നു തൈമിയ്യ</h2><blockquote class=\"ar\" lang=\"ar\">وتأويل الأمر والنهي نفس فعل المأمور ونفس ترك المحظور. كما في الصحيح {عن عائشة رضي الله عنها قالت: كان رسول الله صلى الله عليه وسلم يقول في ركوعه وسجوده سبحانك اللهم ربنا وبحمدك اللهم اغفر لي يتأول القرآن} فكان هذا الكلام تأويل قوله: {فسبح بحمد ربك واستغفره} .<cite>«مجموع الفتاوى» 17/368</cite></blockquote></section><section><h2>ഇമാം ഇബ്നുൽ ഖയ്യിം</h2><blockquote class=\"ar\" lang=\"ar\">فإنه - سبحانه - لن يعلق الاستغفار بعمله، بل علقه بما يحدثه هو - سبحانه - من نعمة فتحه على رسوله ودخول الناس في دينه، وهذا ليس بسبب للاستغفار، فعلم أن سبب الاستغفار غيره، وهو حضور الأجل الذي من تمام نعمة الله على عبده توفيقه للتوبة النصوح والاستغفار بين يديه ليلقى ربه طاهرا مطهرا من كل ذنب فيقدم عليه مسرورا راضيا مرضيا عنه<cite>«إعلام الموقعين عن رب العالمين» 1/266</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">ويدل عليه أيضا قوله: {فسبح بحمد ربك واستغفره} [النصر: 3] وهو - صلى الله عليه وسلم - كان يسبح بحمده دائما. فعلم أن المأمور به من ذلك التسبيح بعد الفتح ودخول الناس في هذا الدين أمر أكبر من ذلك المتقدم، وذلك مقدمة بين يدي انتقاله إلى الرفيق الأعلى. وأنه قد بقيت عليه من عبودية التسبيح والاستغفار التي ترقيه إلى ذلك المقام بقية فأمره بتوفيتها<cite>«إعلام الموقعين عن رب العالمين» 1/266</cite></blockquote></section><div class=\"muy\"><div class=\"muy-head\"><b>അൽ-മുഖ്തസർ ഫീ തഫ്സീറിൽ ഖുർആനിൽ കരീം</b><small>ആയത്തിന്റെ പൊതുവായ അർത്ഥം — രണ്ട് ശൈഖുമാരുടെ വാക്കുകളല്ല</small></div><p class=\"muy-text\">(അത് സംഭവിച്ചാൽ) നിൻ്റെ മേൽ ഏൽപ്പിക്കപ്പെട്ട ബാധ്യത അവസാനിക്കാറായി എന്നതിൻ്റെ അടയാളമാണത് എന്ന് നീ മനസ്സിലാക്കുക. അപ്പോൾ നിൻ്റെ രക്ഷിതാവ് നിനക്ക് നൽകിയ വിജയത്തിനും സഹായത്തിനും നന്ദിയായി കൊണ്ട്, അവനെ സ്തുതിച്ചു കൊണ്ട് പ്രകീർത്തിക്കുക. തൻ്റെ അടിമകളുടെ പശ്ചാത്താപം അങ്ങേയറ്റം സ്വീകരിക്കുകയും, അവർക്ക് പൊറുത്തു കൊടുക്കുകയും ചെയ്യുന്ന &#x27;തവ്വാബ്&#x27; ആണവൻ.</p><a class=\"muy-credit\" href=\"https://quranenc.com/en/browse/malayalam_mokhtasar\" target=\"_blank\" rel=\"noopener\" dir=\"ltr\">Malayalam Translation of Al-Mukhtasar in Interpreting the Noble Quran — 2026-11-04 · QuranEnc.com</a></div><a class=\"btn pri open\" href=\"/tafsir.html?lang=ml#s110a3\">ഇന്ററാക്ടീവ് തഫ്സീറിൽ തുറക്കുക (പൂർണ്ണ പാഠങ്ങൾ)</a><div class=\"pn\"><a href=\"/ml/ayah/110-2.html\">മുമ്പത്തെ ആയത്ത് (110:2)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/110-3.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/110-3.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/110-3.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/110-3.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/110-3.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/110-3.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/110-3.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/110-3.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/110-3.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/110-3.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/110-3.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/110-3.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/110-3.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/110-3.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/110-3.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a> · <a href=\"/hi/ayah/110-3.html\" hreflang=\"hi\" lang=\"hi\" data-l=\"hi\">हिन्दी</a> · <a href=\"/ps/ayah/110-3.html\" hreflang=\"ps\" lang=\"ps\" data-l=\"ps\">پښتو</a> · <a href=\"/so/ayah/110-3.html\" hreflang=\"so\" lang=\"so\" data-l=\"so\">Soomaali</a> · <a href=\"/uz/ayah/110-3.html\" hreflang=\"uz\" lang=\"uz