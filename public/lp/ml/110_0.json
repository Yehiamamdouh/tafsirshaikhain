new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ml/\">ഹോം</a> › <a href=\"/ml/surah/110.html\">സൂറത്ത് An-Nasr</a> › ആയത്ത് 2</nav><h1>തഫ്സീർ: സൂറത്ത് An-Nasr 110:2</h1><p class=\"vt ar\" lang=\"ar\">﴿وَرَأَيْتَ النَّاسَ يَدْخُلُونَ فِي دِينِ اللَّهِ أَفْوَاجًا﴾</p><section><h3>അർത്ഥവിവർത്തനം</h3><p class=\"tr\">ജനങ്ങള്‍ അല്ലാഹുവിന്റെ മതത്തില്‍ കൂട്ടംകൂട്ടമായി പ്രവേശിക്കുന്നത് നീ കാണുകയും ചെയ്താല്‍</p><span class=\"cr\" dir=\"ltr\">Malayalam Translation - Abdul Hamid Haidar and Kunhi Muhammad — v1.0.3 · QuranEnc.com</span></section><p class=\"cr\">രണ്ട് ഇമാമുമാരുടെയും വാക്കുകൾ മൂല അറബിയിൽ, അതേപടി, അവലംബങ്ങളോടെ നൽകിയിരിക്കുന്നു.</p><section><h2>ശൈഖുൽ ഇസ്‌ലാം ഇബ്നു തൈമിയ്യ</h2><blockquote class=\"ar\" lang=\"ar\">فدخل الناس في دين الله أفواجا بعد الفتح، فما مات صلى الله عليه وسلم، وفي بلاد العرب كلها موضع لم يدخله الإسلام.<cite>«الجواب الصحيح لمن بدل دين المسيح» 6/78</cite></blockquote></section><div class=\"muy\"><div class=\"muy-head\"><b>അൽ-മുഖ്തസർ ഫീ തഫ്സീറിൽ ഖുർആനിൽ കരീം</b><small>ആയത്തിന്റെ പൊതുവായ അർത്ഥം — രണ്ട് ശൈഖുമാരുടെ വാക്കുകളല്ല</small></div><p class=\"muy-text\">ജനങ്ങൾ ഇസ്ലാമിലേക്ക് നിവേദകസംഘങ്ങളായി -കൂട്ടംകൂട്ടമായി- പ്രവേശിക്കുന്നത് നീ കാണുകയും ചെയ്താൽ.</p><a class=\"muy-credit\" href=\"https://quranenc.com/en/browse/malayalam_mokhtasar\" target=\"_blank\" rel=\"noopener\" dir=\"ltr\">Malayalam Translation of Al-Mukhtasar in Interpreting the Noble Quran — 2026-11-04 · QuranEnc.com</a></div><a class=\"btn pri open\" href=\"/tafsir.html?lang=ml#s110a2\">ഇന്ററാക്ടീവ് തഫ്സീറിൽ തുറക്കുക (പൂർണ്ണ പാഠങ്ങൾ)</a><div class=\"pn\"><a href=\"/ml/ayah/110-1.html\">മുമ്പത്തെ ആയത്ത് (110:1)</a><a href=\"/ml/ayah/110-3.html\">അടുത്ത ആയത്ത് (110:3)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/110-2.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/110-2.html\" hrefla