=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ml/\">ഹോം</a> › <a href=\"/ml/surah/34.html\">സൂറത്ത് Saba</a> › ആയത്ത് 54</nav><h1>തഫ്സീർ: സൂറത്ത് Saba 34:54</h1><p class=\"vt ar\" lang=\"ar\">﴿وَحِيلَ بَيْنَهُمْ وَبَيْنَ مَا يَشْتَهُونَ كَمَا فُعِلَ بِأَشْيَاعِهِم مِّن قَبْلُ إِنَّهُمْ كَانُوا فِي شَكٍّ مُّرِيبٍ﴾</p><section><h3>അർത്ഥവിവർത്തനം</h3><p class=\"tr\">അങ്ങനെ മുമ്പ് അവരുടെ പക്ഷക്കാരെക്കൊണ്ട് ചെയ്തതുപോലെത്തന്നെ അവര്‍ക്കും അവര്‍ ആഗ്രഹിക്കുന്ന കാര്യത്തിനുമിടയില്‍ തടസ്സം സൃഷ്ടിക്കപ്പെട്ടു.(30) തീര്‍ച്ചയായും അവര്‍ അവിശ്വാസജനകമായ സംശയത്തിലായിരുന്നു.</p><span class=\"cr\" dir=\"ltr\">Malayalam Translation - Abdul Hamid Haidar and Kunhi Muhammad — v1.0.3 · QuranEnc.com</span></section><p class=\"cr\">രണ്ട് ഇമാമുമാരുടെയും വാക്കുകൾ മൂല അറബിയിൽ, അതേപടി, അവലംബങ്ങളോടെ നൽകിയിരിക്കുന്നു.</p><section><h2>ഇമാം ഇബ്നുൽ ഖയ്യിം</h2><blockquote class=\"ar\" lang=\"ar\">ولهذا جعل الله سبحانه وتعالى مفارقة المشتهيات من أعظم العقوبات، فقال تعالى: {وحيل بينهم وبين ما يشتهون - كما فعل بأشياعهم من قبل إنهم كانوا في شك مريب} [سبأ: 54]<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 3/178</cite></blockquote></section><div class=\"muy\"><div class=\"muy-head\"><b>അൽ-മുഖ്തസർ ഫീ തഫ്സീറിൽ ഖുർആനിൽ കരീം</b><small>ആയത്തിന്റെ പൊതുവായ അർത്ഥം — രണ്ട് ശൈഖുമാരുടെ വാക്കുകളല്ല</small></div><p class=\"muy-text\">അങ്ങനെ ഐഹിക സുഖസൗകര്യങ്ങളിൽ നിന്നും, തങ്ങൾ ചെയ്തു പോയ നിഷേധത്തിൽ നിന്ന് പശ്ചാത്തപിച്ച് മടങ്ങുന്നതിൽ നിന്നും, നരകത്തിൽ നിന്ന് രക്ഷപ്പെടുന്നതിൽ നിന്നും, ഇഹലോകത്തേക്ക് മടങ്ങിപ്പോകുന്നതിൽ നിന്നും അവർ തടയപ്പെട്ടു. അവർക്ക് മുൻപ് നിഷേധിച്ചു തള്ളിയ, അവരോട് സമാനരായ മുൻസമുദായങ്ങളോടും ഇപ്രകാരം തന്നെയാണ് ചെയ്യപ്പെട്ടത്. തീർച്ചയായും അല്ലാഹുവിൻ്റെ ദൂതന്മാർ കൊണ്ടു വന്ന അല്ലാഹുവിനെ ഏകനാക്കുക എന്ന തൗഹീദിനോടും, പുനരുത്ഥാനത്തിലുള്ള വിശ്വാസത്തോടും കടുത്ത സംശയത്തിലായിരുന്നു അവർ. (അല്ലാഹുവിനെ) നിഷേധിക്കുന്നതിലേക്ക് എത്തിക്കുന്ന സംശയമായിരുന്നു അത്.</p><a class=\"muy-credit\" href=\"https://quranenc.com/en/browse/malayalam_mokhtasar\" target=\"_blank\" rel=\"noopener\" dir=\"ltr\">Malayalam Translation of Al-Mukhtasar in Interpreting the Noble Quran — 2026-11-04 · QuranEnc.com</a></div><a class=\"btn pri open\" href=\"/tafsir.html?lang=ml#s34a54\">ഇന്ററാക്ടീവ് തഫ്സീറിൽ തുറക്കുക (പൂർണ്ണ പാഠങ്ങൾ)</a><div class=\"pn\"><a href=\"/ml/ayah/34-51.html\">മുമ്പത്തെ ആയത്ത് (34:51)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/34-54.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/34-54.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/34-54.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/34-54.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/34-54.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/34-54.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/34-54.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/34-54.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/34-54.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/34-54.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/34-54.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/34-54.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/34-54.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/34-54.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/34-54.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a> · <a href=\"/hi/ayah/34-54.html\" h