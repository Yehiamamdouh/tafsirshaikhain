weight:600;font-size:15px}.muy-head small{font-size:12.5px;color:var(--muted,#5b6676)}.muy-text{margin:0;font-family:var(--f-read,serif);font-size:17px;line-height:1.95;overflow-wrap:anywhere}.muy-fn{margin:0;font-size:14px;line-height:1.7;color:var(--muted,#5b6676);white-space:pre-line}.muy-credit{font-size:12px;color:var(--muted,#5b6676);overflow-wrap:anywhere}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ml/\">ഹോം</a> › <a href=\"/ml/surah/34.html\">സൂറത്ത് Saba</a> › ആയത്ത് 50</nav><h1>തഫ്സീർ: സൂറത്ത് Saba 34:50</h1><p class=\"vt ar\" lang=\"ar\">﴿قُلْ إِن ضَلَلْتُ فَإِنَّمَا أَضِلُّ عَلَىٰ نَفْسِي وَإِنِ اهْتَدَيْتُ فَبِمَا يُوحِي إِلَيَّ رَبِّي إِنَّهُ سَمِيعٌ قَرِيبٌ﴾</p><section><h3>അർത്ഥവിവർത്തനം</h3><p class=\"tr\">നീ പറയുക: ഞാന്‍ പിഴച്ചുപോയിട്ടുണ്ടെങ്കില്‍ ഞാന്‍ പിഴക്കുന്നതിന്‍റെ ദോഷം എനിക്കു തന്നെയാണ്‌. ഞാന്‍ നേര്‍മാര്‍ഗം പ്രാപിച്ചുവെങ്കിലോ അത് എനിക്ക് എന്‍റെ രക്ഷിതാവ് ബോധനം നല്‍കുന്നതിന്‍റെ ഫലമായിട്ടാണ്‌. തീര്‍ച്ചയായും അവന്‍ എല്ലാം കേള്‍ക്കുന്നവനും സമീപസ്ഥനുമാകുന്നു.</p><span class=\"cr\" dir=\"ltr\">Malayalam Translation - Abdul Hamid Haidar and Kunhi Muhammad — v1.0.3 · QuranEnc.com</span></section><p class=\"cr\">രണ്ട് ഇമാമുമാരുടെയും വാക്കുകൾ മൂല അറബിയിൽ, അതേപടി, അവലംബങ്ങളോടെ നൽകിയിരിക്കുന്നു.</p><section><h2>ശൈഖുൽ ഇസ്‌ലാം ഇബ്നു തൈമിയ്യ</h2><blockquote class=\"ar\" lang=\"ar\">فما أوحاه الله إليه يهدي الله به من يشاء من عباده، كما أنه صلى الله عليه وسلم بذلك هداه الله تعالى كما قال تعالى: {قل إن ضللت فإنما أضل على نفسي وإن اهتديت فبما يوحي إلي ربي} .<cite>«مجموع الفتاوى» 1/5</cite></blockquote></section><section><h2>ഇമാം ഇബ്നുൽ ഖയ്യിം</h2><blockquote class=\"ar\" lang=\"ar\">وقال تعالى لرسوله صلى الله عليه وسلم: {قل إن ضللت فإنما أضل على نفسي وإن اهتديت فبما يوحي إلي ربي إنه سميع قريب} فهذا نص صريح في أن هدي الرسول صلى الله عليه وسلم إنما يحصل بالوحي، فيا عجبا! كيف يحصل الهدى لغيره من الآراء والعقول المختلفة والأقوال المضطربة؟!<cite>«الرسالة التبوكية = زاد المهاجر إلى ربه» 1/45</cite></blockquote><h3>മറ്റുള്ളവരിൽ നിന്ന് അദ്ദേഹം ഉദ്ധരിച്ചത്</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">نفاة القياس</span> <span class=\"st\">حكاه</span> «فلو كان القياس هدى لم ينحصر الهدى في الوحي،»<cite>«إعلام الموقعين عن رب العالمين» 1/174</cite></blockquote></section><div class=\"muy\"><div class=\"muy-head\"><b>അൽ-മുഖ്തസർ ഫീ തഫ്സീറിൽ ഖുർആനിൽ കരീം</b><small>ആയത്തിന്റെ പൊതുവായ അർത്ഥം — രണ്ട് ശൈഖുമാരുടെ വാക്കുകളല്ല</small></div><p class=\"muy-text\">അല്ലാഹുവിൻ്റെ റസൂലേ! നിഷേധികളായ ഈ ബഹുദൈവാരാധകരോട് പറയുക: നിങ്ങൾക്ക് ഞാൻ എത്തിച്ചു നൽകുന്ന ഈ സത്യത്തിൽ നിന്ന് ഞാൻ വഴിതെറ്റിപ്പോയാൽ എൻ്റെ വഴികേടിൻ്റെ ദോഷഫലം എൻ്റെ മേൽ മാത്രമായിരിക്കും. അതിൻ്റെ ഒരു ഫലവും നിങ്ങളെ ബാധിക്കുകയില്ല. ഇനി ഞാൻ സന്മാർഗം സ്വീകരിച്ചിട്ടുണ്ടെങ്കിൽ; അതാകട്ടെ എൻ്റെ രക്ഷിതാവ് എനിക്ക് നൽകിയ സന്ദേശം കാരണത്താലാണ്. തീർച്ചയായും അവൻ തൻ്റെ അടിമകളുടെ സംസാരങ്ങളെല്ലാം കേൾക്കുന്നവനും (സമീഅ്), സമീപസ്ഥനുമാണ് (ഖരീബ്); ഞാൻ പറയുന്നതൊന്നും അവന് കേൾക്കാൻ കഴിയാതെയാകില്ല.</p><a class=\"muy-credit\" href=\"https://quranenc.com/en/browse/malayalam_mokhtasar\" target=\"_blank\" rel=\"noopener\" dir=\"ltr\">Malayalam Translation of Al-Mukhtasar in Interpreting the Noble Quran — 2026-11-04 · QuranEnc.com</a></div><a class=\"btn pri open\" href=\"/tafsir.html?lang=ml#s34a50\">ഇന്ററാക്ടീവ് തഫ്സീറിൽ തുറക്കുക (പൂർണ്ണ പാഠങ്ങൾ)</a><div class=\"pn\"><a href=\"/ml/ayah/34-47.html\">മുമ്പത്തെ ആയത്ത് (34:47)</a><a href=\"/ml/ayah/34-51.html\">അടുത്ത ആയത്ത് (34:51)</a></div></main><nav class=\"langs\" aria-label=\"Language\