ype=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"ഹോം\", \"item\": \"https://tafsirshaikhain.com/ml/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"സൂറത്ത് Fussilat\", \"item\": \"https://tafsirshaikhain.com/ml/surah/41.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"ആയത്ത് 53\", \"item\": \"https://tafsirshaikhain.com/ml/ayah/41-53.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ml/\">ഹോം</a> › <a href=\"/ml/surah/41.html\">സൂറത്ത് Fussilat</a> › ആയത്ത് 53</nav><h1>തഫ്സീർ: സൂറത്ത് Fussilat 41:53</h1><p class=\"vt ar\" lang=\"ar\">﴿سَنُرِيهِمْ آيَاتِنَا فِي الْآفَاقِ وَفِي أَنفُسِهِمْ حَتَّىٰ يَتَبَيَّنَ لَهُمْ أَنَّهُ الْحَقُّ أَوَلَمْ يَكْفِ بِرَبِّكَ أَنَّهُ عَلَىٰ كُلِّ شَيْءٍ شَهِيدٌ﴾</p><section><h3>അർത്ഥവിവർത്തനം</h3><p class=\"tr\">ഇത് (ഖുര്‍ആന്‍) സത്യമാണെന്ന് അവര്‍ക്ക് വ്യക്തമാകത്തക്കവണ്ണം വിവിധ ദിക്കുകളിലും അവരില്‍ തന്നെയും നമ്മുടെ ദൃഷ്ടാന്തങ്ങള്‍ വഴിയെ നാം അവര്‍ക്ക് കാണിച്ചുകൊടുക്കുന്നതാണ്‌. നിന്‍റെ രക്ഷിതാവ് ഏത് കാര്യത്തിനും സാക്ഷിയാണ് എന്നതു തന്നെ മതിയായതല്ലേ?</p><span class=\"cr\" dir=\"ltr\">Malayalam Translation - Abdul Hamid Haidar and Kunhi Muhammad — v1.0.3 · QuranEnc.com</span></section><p class=\"cr\">രണ്ട് ഇമാമുമാരുടെയും വാക്കുകൾ മൂല അറബിയിൽ, അതേപടി, അവലംബങ്ങളോടെ നൽകിയിരിക്കുന്നു.</p><section><h2>ശൈഖുൽ ഇസ്‌ലാം ഇബ്നു തൈമിയ്യ</h2><blockquote class=\"ar\" lang=\"ar\">فأخبر: أنه سيريهم الآيات المرئية المشهودة حتى يتبين لهم أن القرآن حق. ثم قال: {أولم يكف بربك أنه على كل شيء شهيد} أي بإخبار الله ربك في القرآن وشهادته بذلك.<cite>«مجموع الفتاوى» 4/9</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">والصواب الذي عليه المفسرون وعليه تدل الآية أن الضمير عائد إلى القرآن<cite>«درء تعارض العقل والنقل» 3/134</cite></blockquote></section><section><h2>ഇമാം ഇബ്നുൽ ഖയ്യിം</h2><blockquote class=\"ar\" lang=\"ar\">والمقصود: أن الله سبحانه يشهد بما جعل آياته المخلوقة دالة عليه، فإن دلالتها إنما هي بخلقه وجعله، ويشهد بآياته القولية الكلامية المطابقة لما شهدت به آياته الخلقية، فتتطابق شهادة القول وشهادة الفعل، كما قال تعالى: {سنريهم آياتنا في الآفاق وفي أنفسهم حتى يتبين لهم أنه الحق} [فصلت: 53] ، أي أن القرآن حق، فأخبر أنه يدل بآياته الأفقية والنفسية على صدق آياته القولية الكلامية<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 3/422</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فقال تعالى {سنريهم آياتنا في الآفاق وفي أنفسهم حتى يتبين لهم أنه الحق} [فصلت: 53] أي القرآن، فإنه هو المتقدم في قوله: {قل أرأيتم إن كان من عند الله ثم كفرتم به}<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 3/432</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ml#s41a53\">ഇന്ററാക്ടീവ് തഫ്സീറിൽ തുറക്കുക (പൂർണ്ണ പാഠങ്ങൾ)</a><div class=\"pn\"><a href=\"/ml/ayah/41-51.html\">മുമ്പത്തെ ആയത്ത് (41:51)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/41-53.html\" hreflang=\"ar\" lang=\"a