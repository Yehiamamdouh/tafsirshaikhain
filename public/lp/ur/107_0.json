, \"name\": \"آیت 4\", \"item\": \"https://tafsirshaikhain.com/ur/ayah/107-4.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ur/\">صفحۂ اول</a> › <a href=\"/ur/surah/107.html\">سورۃ الماعون</a> › آیت 4</nav><h1>تفسیر سورۃ الماعون 107:4</h1><p class=\"vt ar\" lang=\"ar\">﴿فَوَيْلٌ لِّلْمُصَلِّينَ﴾</p><section><h3>ترجمۂ معانی</h3><p class=\"tr\">ان نمازیوں کے لئے افسوس (اور ویل نامی جہنم کی جگہ) ہے.</p><span class=\"cr\" dir=\"ltr\">Urdu Translation - Muhammad Junagarhi — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">دونوں ائمہ کا کلام اصل عربی میں لفظ بلفظ، حوالوں کے ساتھ دیا گیا ہے۔</p><section><h2>شیخ الاسلام ابن تیمیہ</h2><h3>جو انہوں نے دوسروں سے نقل کیا</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">طائفة من السلف</span> <span class=\"st\">أقرّه</span> «هم الذين يؤخرونها عن وقتها.»<cite>«مجموع الفتاوى» 22/29</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">بعض السلف</span> <span class=\"st\">حكاه</span> «هم الذين لا يؤدونها على الوجه المأمور به.»<cite>«مجموع الفتاوى» 22/29</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ur#s107a4\">تفاعلی تفسیر میں کھولیں (مکمل متون)</a><div class=\"pn\"><span></span><a href=\"/ur/ayah/107-5.html\">اگلی آیت (107:5)</a></d