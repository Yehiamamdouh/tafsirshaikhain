crumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"صفحۂ اول\", \"item\": \"https://tafsirshaikhain.com/ur/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سورۃ المدثر\", \"item\": \"https://tafsirshaikhain.com/ur/surah/74.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیت 56\", \"item\": \"https://tafsirshaikhain.com/ur/ayah/74-56.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ur/\">صفحۂ اول</a> › <a href=\"/ur/surah/74.html\">سورۃ المدثر</a> › آیت 56</nav><h1>تفسیر سورۃ المدثر 74:56</h1><p class=\"vt ar\" lang=\"ar\">﴿وَمَا يَذْكُرُونَ إِلَّا أَن يَشَاءَ اللَّهُ هُوَ أَهْلُ التَّقْوَىٰ وَأَهْلُ الْمَغْفِرَةِ﴾</p><section><h3>ترجمۂ معانی</h3><p class=\"tr\">اور وه اس وقت نصیحت حاصل کریں گے جب اللہ تعالیٰ چاہے ، وه اسی ﻻئق ہے کہ اس سے ڈریں اور اس ﻻئق بھی کہ وه بخشے.</p><span class=\"cr\" dir=\"ltr\">Urdu Translation - Muhammad Junagarhi — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">دونوں ائمہ کا کلام اصل عربی میں لفظ بلفظ، حوالوں کے ساتھ دیا گیا ہے۔</p><section><h2>شیخ الاسلام ابن تیمیہ</h2><blockquote class=\"ar\" lang=\"ar\">فهو سبحانه أهل التقوى ولم يقل سبحانه أهل للتقوى. بل قال: {أهل التقوى} فهو وحده أهل أن يتقى فيعبد دون ما سواه ولا يستحق غيره أن يتقى كما قال: {وله ما في السماوات والأرض وله الدين واصبا أفغير الله تتقون}<cite>«مجموع الفتاوى» 11/690</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وهو أهل المغفرة ولا يغفر الذنوب غيره كما قال تعالى: {ومن يغفر الذنوب إلا الله}<cite>«مجموع الفتاوى» 11/690</cite></blockquote></section><section><h2>امام ابن القیم</h2><blockquote class=\"ar\" lang=\"ar\">وقد أخبر سبحانه أن العباد لا يشاؤن إلا بعد مشيئته ولا يفعلون شيئا إلا بعد مشيئته<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/104</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ur#s74a56\">تفاعلی تفسیر میں کھولیں (مکمل متون)</a><div class=\"pn\"><a href=\"/ur/ayah/74-55.html\">پچھلی آیت (74:55)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/74-56.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/74-56.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <b lang=\"ur\">اردو</b> · <a href=\"/id/ayah/74-56.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/74-56.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/74-56.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/74-56.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/74-56.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/74-56.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/74-56.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/74-56.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/74-56.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/74-56.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/74-56.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/74-56.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a></nav>\n<footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/ur/\">صفحۂ اول</a> · <a href=\"/about.html\">منصوبے کے بارے میں</a> · <a href=\"/privacy.html\">رازداری اور شرائط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n<script>try{localStorage.setItem(\"lang\",\"ur\")}catch(e){}document.addEventListener(\"click\",function(e){var a=e.target.closest&&e.target.closest(\"[data-l]\");if(a)try{localStorage.setItem(\"lang\",a.dataset.l)}catch(x){}})</script>\n</body>\n</html>\n"}