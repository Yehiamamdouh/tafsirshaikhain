" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ur/\">صفحۂ اول</a> › <a href=\"/ur/surah/104.html\">سورۃ الهمزة</a> › آیت 2</nav><h1>تفسیر سورۃ الهمزة 104:2</h1><p class=\"vt ar\" lang=\"ar\">﴿الَّذِي جَمَعَ مَالًا وَعَدَّدَهُ﴾</p><section><h3>ترجمۂ معانی</h3><p class=\"tr\">جو مال کو جمع کرتا جائے اور گنتا جائے.</p><span class=\"cr\" dir=\"ltr\">Urdu Translation - Muhammad Junagarhi — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">دونوں ائمہ کا کلام اصل عربی میں لفظ بلفظ، حوالوں کے ساتھ دیا گیا ہے۔</p><section><h2>شیخ الاسلام ابن تیمیہ</h2><blockquote class=\"ar\" lang=\"ar\">وصفه بالطعن في الناس والعيب لهم وبجمع المال وتعديده<cite>«مجموع الفتاوى» 16/522</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وذلك ناشئ عن حب الشرف والمال فإن محبة الشرف تحمل على انتقاص غيره بالهمز واللمز والفخر والخيلاء ومحبة المال تحمل على البخل<cite>«مجموع الفتاوى» 16/522</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ur#s104a2\">تفاعلی تفسیر میں کھولیں (مکمل متون)</a><div class=\"pn\"><a href=\"/ur/ayah/104-1.html\">پچھلی آیت (104:1)</a></div></main><footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/ur/\">صفحۂ اول</a> · <a href=\"/about.html\">منصوبے کے بارے میں</a> · <a href=\"/privacy.html\">رازداری اور شرائط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/104.html":"<!doctype html>\n<html lang=\"ur\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-wid