": 2, \"name\": \"سورۃ الزلزلة\", \"item\": \"https://tafsirshaikhain.com/ur/surah/99.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیت 7\", \"item\": \"https://tafsirshaikhain.com/ur/ayah/99-7.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ur/\">صفحۂ اول</a> › <a href=\"/ur/surah/99.html\">سورۃ الزلزلة</a> › آیت 7</nav><h1>تفسیر سورۃ الزلزلة 99:7</h1><p class=\"vt ar\" lang=\"ar\">﴿فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُ﴾</p><section><h3>ترجمۂ معانی</h3><p class=\"tr\">پس جس نے ذره برابر نیکی کی ہوگی وه اسے دیکھ لے گا.</p><span class=\"cr\" dir=\"ltr\">Urdu Translation - Muhammad Junagarhi — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">دونوں ائمہ کا کلام اصل عربی میں لفظ بلفظ، حوالوں کے ساتھ دیا گیا ہے۔</p><section><h2>شیخ الاسلام ابن تیمیہ</h2><blockquote class=\"ar\" lang=\"ar\">وإذا علم أن السيئة من نفسه لم يطمع في السعادة التامة مع ما فيه من الشر؛ بل علم تحقيق قوله: {من يعمل سوءا يجز به} وقوله: {فمن يعمل مثقال ذرة خيرا يره} {ومن يعمل مثقال ذرة شرا يره} . وعلم أن الرب جارية أفعاله على قانون العدل والإحسان<cite>«مجموع الفتاوى» 8/226</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">والعبد إذا اجتمع له سيئات وحسنات فإنه وإن استحق العقاب على سيئاته فإن الله يثيبه على حسناته، ولا يحبط حسنات المؤمن لأجل ما صدر منه؛<cite>«مجموع الفتاوى» 35/68</cite></blockquote></section><section><h2>امام ابن القیم</h2><blockquote class=\"ar\" lang=\"ar\">وسمى النبي - صلى الله عليه وسلم - هذه الآية جامعة فاذة: {فمن يعمل مثقال ذرة خيرا يره} [الزلزلة: 7] {ومن يعمل مثقال ذرة شرا يره} [الزلزلة: 8]<cite>«إعلام الموقعين عن رب العالمين» 1/251</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ur#s99a7\">تفاعلی تفسیر میں کھولیں (مکمل متون)</a><div class=\"pn\"><a href=\"/ur/ayah/99-4.html\">پچھلی آیت (99:4)</a><a href=\"/ur/ayah/99-8.html\">اگلی آیت (99:8)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/99-7.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/99-7.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <b lang=\"ur\">اردو</b> · <a href=\"/id/ayah/99-7.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/99-7.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/99-7.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/99-7.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/99-7.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/99-7.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/99-7.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/99-7.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/99-7.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/99-7.html\" hreflang=\"es\" lang=\"es\" data-