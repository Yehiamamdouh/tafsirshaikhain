2, \"name\": \"سورۃ القمر\", \"item\": \"https://tafsirshaikhain.com/ur/surah/54.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیت 52\", \"item\": \"https://tafsirshaikhain.com/ur/ayah/54-52.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ur/\">صفحۂ اول</a> › <a href=\"/ur/surah/54.html\">سورۃ القمر</a> › آیت 52</nav><h1>تفسیر سورۃ القمر 54:52</h1><p class=\"vt ar\" lang=\"ar\">﴿وَكُلُّ شَيْءٍ فَعَلُوهُ فِي الزُّبُرِ﴾</p><section><h3>ترجمۂ معانی</h3><p class=\"tr\">جوکچھ انہوں نے (اعمال) کیے ہیں سب نامہٴ اعمال میں لکھے ہوئے ہیں.</p><span class=\"cr\" dir=\"ltr\">Urdu Translation - Muhammad Junagarhi — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">دونوں ائمہ کا کلام اصل عربی میں لفظ بلفظ، حوالوں کے ساتھ دیا گیا ہے۔</p><section><h2>شیخ الاسلام ابن تیمیہ</h2><blockquote class=\"ar\" lang=\"ar\">فإن المراد بذلك ذكره وكتابته. و &quot; الزبر &quot; جمع زبور والزبور فعول بمعنى مفعول أي مزبور أي: مكتوب<cite>«مجموع الفتاوى» 12/386</cite></blockquote></section><section><h2>امام ابن القیم</h2><h3>جو انہوں نے دوسروں سے نقل کیا</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">عطاء ومقاتل</span> <span class=\"st\">رجّح غيره</span> «كل شيء فعلوه مكتوب عليهم في اللوح المحفوظ»<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/42</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">طائفة</span> <span class=\"st\">رجّح غيره</span> «المعنى أنه يحصى عليهم في كتب أعمالهم»<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/42</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">أبو إسحاق</span> <span class=\"st\">أقرّه</span> «مكتوب عليهم قبل أن يفعلوه ومكتوب عليهم إذا فعلوه للجزاء»<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/42</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ur#s54a52\">تفاعلی تفسیر میں کھولیں (مکمل متون)</a><div class=\"pn\"><a href=\"/ur/ayah/54-50.html\">پچھلی آیت (54:50)</a><a href=\"/ur/ayah/54-53.html\">اگلی آیت (54:53)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/54-52.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/54-52.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <b lang=\"ur\">اردو</b> · <a href=\"/id/ayah/54-52.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/54-52.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/54-52.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/54-52.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/54-52.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/54-52.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/54-52.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/54-52.html\" hreflang=\"sw\" lang=