tps://tafsirshaikhain.com/ur/surah/41.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیت 53\", \"item\": \"https://tafsirshaikhain.com/ur/ayah/41-53.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ur/\">صفحۂ اول</a> › <a href=\"/ur/surah/41.html\">سورۃ فصلت</a> › آیت 53</nav><h1>تفسیر سورۃ فصلت 41:53</h1><p class=\"vt ar\" lang=\"ar\">﴿سَنُرِيهِمْ آيَاتِنَا فِي الْآفَاقِ وَفِي أَنفُسِهِمْ حَتَّىٰ يَتَبَيَّنَ لَهُمْ أَنَّهُ الْحَقُّ أَوَلَمْ يَكْفِ بِرَبِّكَ أَنَّهُ عَلَىٰ كُلِّ شَيْءٍ شَهِيدٌ﴾</p><section><h3>ترجمۂ معانی</h3><p class=\"tr\">عنقریب ہم انہیں اپنی نشانیاں آفاق عالم میں بھی دکھائیں گے اور خود ان کی اپنی ذات میں بھی یہاں تک کہ ان پر کھل جائے کہ حق یہی ہے ، کیا آپ کے رب کا ہر چیز سے واقف و آگاه ہونا کافی نہیں.</p><span class=\"cr\" dir=\"ltr\">Urdu Translation - Muhammad Junagarhi — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">دونوں ائمہ کا کلام اصل عربی میں لفظ بلفظ، حوالوں کے ساتھ دیا گیا ہے۔</p><section><h2>شیخ الاسلام ابن تیمیہ</h2><blockquote class=\"ar\" lang=\"ar\">فأخبر: أنه سيريهم الآيات المرئية المشهودة حتى يتبين لهم أن القرآن حق. ثم قال: {أولم يكف بربك أنه على كل شيء شهيد} أي بإخبار الله ربك في القرآن وشهادته بذلك.<cite>«مجموع الفتاوى» 4/9</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">والصواب الذي عليه المفسرون وعليه تدل الآية أن الضمير عائد إلى القرآن<cite>«درء تعارض العقل والنقل» 3/134</cite></blockquote></section><section><h2>امام ابن القیم</h2><blockquote class=\"ar\" lang=\"ar\">والمقصود: أن الله سبحانه يشهد بما جعل آياته المخلوقة دالة عليه، فإن دلالتها إنما هي بخلقه وجعله، ويشهد بآياته القولية الكلامية المطابقة لما شهدت به آياته الخلقية، فتتطابق شهادة القول وشهادة الفعل، كما قال تعالى: {سنريهم آياتنا في الآفاق وفي أنفسهم حتى يتبين لهم أنه الحق} [فصلت: 53] ، أي أن القرآن حق، فأخبر أنه يدل بآياته الأفقية والنفسية على صدق آياته القولية الكلامية<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 3/422</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فقال تعالى {سنريهم آياتنا في الآفاق وفي أنفسهم حتى يتبين لهم أنه الحق} [فصلت: 53] أي القرآن، فإنه هو المتقدم في قوله: {قل أرأيتم إن كان من عند الله ثم كفرتم به}<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 3/432</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ur#s41a53\">تفاعلی تفسیر میں کھولیں (مکمل متون)</a><div class=\"pn\"><a href=\"/ur/ayah/41-51.html\">پچھلی آیت (41:51)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/41-53.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/41-53.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <b lang=\"ur\">اردو</b> · <a href=\"/id/ayah/41-53.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/41-53.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/41-53.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/41-53.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/41-53.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/41-53.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/41-53.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/41-53.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/41-53.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/41-53.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/41-53.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/41-53.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a></nav>\n<footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/ur/\">صفحۂ اول</a> · <a href=\"/about.html\">منصوبے کے بارے میں</a> · <a href=\"/privacy.html\">رازداری اور شرائط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n<script>try{localStorage.setItem(\"lang\",\"ur\")}catch(e){}document.addEventListener(\"click\",function(e){var a=e.target.closest&&e.target.closest(\"[data-l]\");if(a)try{localStorage.setItem(\"lang\",a.dataset.l)}catch(x){}})</script>\n</body>\n</html>\n"}