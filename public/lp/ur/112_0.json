\": 3, \"name\": \"آیت 2\", \"item\": \"https://tafsirshaikhain.com/ur/ayah/112-2.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ur/\">صفحۂ اول</a> › <a href=\"/ur/surah/112.html\">سورۃ الإخلاص</a> › آیت 2</nav><h1>تفسیر سورۃ الإخلاص 112:2</h1><p class=\"vt ar\" lang=\"ar\">﴿اللَّهُ الصَّمَدُ﴾</p><section><h3>ترجمۂ معانی</h3><p class=\"tr\">اللہ تعالیٰ بے نیاز ہے.</p><span class=\"cr\" dir=\"ltr\">Urdu Translation - Muhammad Junagarhi — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">دونوں ائمہ کا کلام اصل عربی میں لفظ بلفظ، حوالوں کے ساتھ دیا گیا ہے۔</p><section><h2>شیخ الاسلام ابن تیمیہ</h2><blockquote class=\"ar\" lang=\"ar\">فأدخل اللام في الصمد ولم يدخلها في أحد؛ لأنه ليس في الموجودات ما يسمى أحدا في الإثبات مفردا غير مضاف إلا الله تعالى<cite>«مجموع الفتاوى» 17/235</cite></blockquote><h3>جو انہوں نے دوسروں سے نقل کیا</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">حديث مرفوع (من رواية أبي بن كعب)</span> <span class=\"st\">استشهد به</span> «الصمد الذي لم يلد ولم يولد؛ لأنه ليس شيء يولد إلا سيموت وليس شيء يموت إلا سيورث»<cite>«مجموع الفتاوى» 17/216</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ur#s112a2\">تفاعلی تفسیر میں کھولیں (مکمل متون)</a><div class=\"pn\"><a href=\"/ur/ayah/112-1.html\">پچھلی آیت (112:1)</a><a href=\"/ur/ayah/112-3.html\">اگلی آیت (112:3)</a></div></main><footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/ur/\">صفحۂ اول</a> · <a href=\"/about.html\">منصوبے کے بارے میں</a> · <a href=\"/privacy.html\">رازداری اور شرائط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/112-3.html":"<!doctype html>\n<html lang=\"ur\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>تفسیر الإخلاص 112:3 — ابن تیمیہ اور ابن القیم کے کلام میں</title>\n<meta name=\"description\" content=\"نہ اس سے کوئی پیدا ہوا نہ وه کسی سے پیدا ہوا.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/ur/ayah/112-3.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/112-3.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/112-3.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/112-3.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/112-3.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/112-3.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/112-3.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/112-3.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/112-3.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/112-3.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/112-3.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/112-3.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/112-3.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/112-3.html\">\n<link rel=\"alternate\"