5-3.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ur/\">صفحۂ اول</a> › <a href=\"/ur/surah/105.html\">سورۃ الفيل</a> › آیت 3</nav><h1>تفسیر سورۃ الفيل 105:3</h1><p class=\"vt ar\" lang=\"ar\">﴿وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ﴾</p><section><h3>ترجمۂ معانی</h3><p class=\"tr\">اور ان پر پرندوں کے جھنڈ کے جھنڈ بھیج دیئے.</p><span class=\"cr\" dir=\"ltr\">Urdu Translation - Muhammad Junagarhi — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">دونوں ائمہ کا کلام اصل عربی میں لفظ بلفظ، حوالوں کے ساتھ دیا گیا ہے۔</p><section><h2>امام ابن القیم</h2><blockquote class=\"ar\" lang=\"ar\">وكذلك قوله: {وفي وفي عاد إذ أرسلنا عليهم الريح العقيم} أي سلطناها وسخرناها عليهم وكذلك قوله: {وأرسل عليهم طيرا أبابيل}<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/63</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ur#s105a3\">تفاعلی تفسیر میں کھولیں (مکمل متون)</a><div class=\"pn\"><a href=\"/ur/ayah/105-1.html\">پچھلی آیت (105:1)</a><a href=\"/ur/ayah/105-4.html\">اگلی آیت (105:4)</a></div></main><footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/ur/\">صفحۂ اول</a> · <a href=\"/about.html\">منصوبے کے بارے میں</a> · <a href=\"/privacy.html\">رازداری اور شرائط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/105-4.html":"<!doc