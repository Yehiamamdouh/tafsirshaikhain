og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"صفحۂ اول\", \"item\": \"https://tafsirshaikhain.com/ur/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سورۃ التكوير\", \"item\": \"https://tafsirshaikhain.com/ur/surah/81.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیت 28\", \"item\": \"https://tafsirshaikhain.com/ur/ayah/81-28.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ur/\">صفحۂ اول</a> › <a href=\"/ur/surah/81.html\">سورۃ التكوير</a> › آیت 28</nav><h1>تفسیر سورۃ التكوير 81:28</h1><p class=\"vt ar\" lang=\"ar\">﴿لِمَن شَاءَ مِنكُمْ أَن يَسْتَقِيمَ﴾</p><section><h3>ترجمۂ معانی</h3><p class=\"tr\">(بالخصوص) اس کے لئے جو تم میں سے سیدھی راه پر چلنا چاہے.</p><span class=\"cr\" dir=\"ltr\">Urdu Translation - Muhammad Junagarhi — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">دونوں ائمہ کا کلام اصل عربی میں لفظ بلفظ، حوالوں کے ساتھ دیا گیا ہے۔</p><section><h2>شیخ الاسلام ابن تیمیہ</h2><blockquote class=\"ar\" lang=\"ar\">فأثبت للعبد مشيئة وفعلا<cite>«مجموع الفتاوى» 8/488</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وقال تعالى: {إن هو إلا ذكر للعالمين} . ثم قال: {لمن شاء منكم أن يستقيم} فذكر العام والخاص.<cite>«مجموع الفتاوى» 16/157</cite></blockquote></section><section><h2>امام ابن القیم</h2><blockquote class=\"ar\" lang=\"ar\">وقوله {لمن شاء منكم} رد على الجبرية القائلين بأن العبد لا مشيئة له<cite>«التبيان في أقسام القرآن» 1/129</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فإنها معلومة له سبحانه مقدورة له مخلوقة وإضافتها إليهم لا تمنع هذه الإضافة كالأموال فإنها مخلوقة له سبحانه وهي ملكه حقيقة قد أضافها إليهم<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/152</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ur#s81a28\">تفاعلی تفسیر میں کھولیں (مکمل متون)</a><div class=\"pn\"><a href=\"/ur/ayah/81-25.html\">پچھلی آیت (81:25)</a><a href=\"/ur/ayah/81-29.html\">اگلی آیت (81:29)</a></div></main><footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/ur/\">صفحۂ اول</a> · <a href=\"/about.html\">منصوبے کے بارے میں</a> · <a href=\"/privacy.html\">رازداری اور شرائط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/81-29.html":"<!doctype html>\n<html lang=\"ur\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>تفسیر التكوير 81:29 — ابن تیمیہ اور ابن القیم کے کلام میں</title>\n<meta name=\"description\" content=\"اور تم بغیر پروردگار عالم کے چاہے کچھ نہیں چاه سکتے.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/ur/ayah/81-29.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/81-29.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/81-29.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/81-29.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/81-29.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/81-29.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/81-29.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/81-29.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/81-29.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/81-29.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/81-29.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/81-29.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/81-29.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/81-29.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/81-29.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/81-29.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/81-29.html\">\n<meta property=\"og:title\" content=\"تفسیر التكوير 81:29 — ابن تیمیہ اور ابن القیم کے کلام میں\">\n<meta property=\"og:description\" content=\"اور تم بغیر پروردگار عالم کے چاہے کچھ نہیں چاه سکتے.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"صفحۂ اول\", \"item\": \"https://tafsirshaikhain.com/ur/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سورۃ التكوير\", \"item\": \"https://tafsirshaikhain.com/ur/surah/81.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیت 29\", \"item\": \"https://tafsirshaikhain.com/ur/ayah/81-29.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ur/\">صفحۂ اول</a> › <a href=\"/ur/surah/81.html\">سورۃ التكوير</a> › آیت 29</nav><h1>تفسیر سورۃ التكوير 81:29</h1><p class=\"vt ar\" lang=\"ar\">﴿وَمَا تَشَاءُونَ إِلَّا أَن يَشَاءَ اللَّهُ رَبُّ الْعَالَمِينَ﴾</p><section><h3>ترجمۂ معانی</h3><p class=\"tr\">اور تم بغیر پروردگار عالم کے چاہے کچھ نہیں چاه سکتے.</p><span class=\"cr\" dir=\"ltr\">Urdu Translation - Muhammad Junagarhi — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">دونوں ائمہ کا کلام اصل عربی میں لفظ بلفظ، حوالوں کے ساتھ دیا گیا ہے۔</p><section><h2>شیخ الاسلام ابن تیمیہ</h2><blockquote class=\"ar\" lang=\"ar\">أخبر أن مشيئتهم موقوفة على مشيئته ومع هذا فلا يوجب ذلك وجود الفعل منهم<cite>«مجموع الفتاوى» 16/81</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وهذه الآية رد على الطائفتين: المجبرة الجهمية والمعتزلة القدرية<cite>«مجموع الفتاوى» 8/488</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فبين أن مشيئة العبد معلقة بمشيئة الله.<cite>«مجموع الفتاوى» 8/488</cite></blockquote></section><section><h2>امام ابن القیم</h2><blockquote class=\"ar\" lang=\"ar\">وقوله {وما تشاءون إلا أن يشاء الله} رد على القدرية القائلين بأن مشيئة العبد مستقلة بإيجاد الفعل من غير توقف على مشيئة الله<cite>«التبيان في أقسام القرآن» 1/130</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ur#s81a29\">تفاعلی تفسیر میں کھولیں (مکمل متون)</a><div class=\"pn\"><a href=\"/ur/ayah/81-28.html\">پچھلی آیت (81:28)</a></div></main><footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/ur/\">صفحۂ اول</a> · <a href=\"/about.html\">منصوبے کے بارے میں</a> · <a href=\"/privacy.html\">رازداری اور شرائط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/81.html":"<!doctype html>\n<html lang=\"ur\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>تفسیر سورۃ التكوير — ابن تیمیہ اور ابن القیم کے کلام میں</title>\n<meta name=\"description\" content=\"تفسیر سورۃ التكوير — ابن تیمیہ اور ابن القیم کے کلام میں قرآن کے معانی\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/ur/surah/81.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/surah/81.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/surah/81.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/surah/81.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/surah/81.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/surah/81.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/surah/81.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/surah/81.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/surah/81.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/surah/81.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/surah/81.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/surah/81.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/surah/81.html\">\n<link rel=\"a