sition\": 1, \"name\": \"صفحۂ اول\", \"item\": \"https://tafsirshaikhain.com/ur/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سورۃ البينة\", \"item\": \"https://tafsirshaikhain.com/ur/surah/98.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیت 8\", \"item\": \"https://tafsirshaikhain.com/ur/ayah/98-8.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ur/\">صفحۂ اول</a> › <a href=\"/ur/surah/98.html\">سورۃ البينة</a> › آیت 8</nav><h1>تفسیر سورۃ البينة 98:8</h1><p class=\"vt ar\" lang=\"ar\">﴿جَزَاؤُهُمْ عِندَ رَبِّهِمْ جَنَّاتُ عَدْنٍ تَجْرِي مِن تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا أَبَدًا رَّضِيَ اللَّهُ عَنْهُمْ وَرَضُوا عَنْهُ ذَٰلِكَ لِمَنْ خَشِيَ رَبَّهُ﴾</p><section><h3>ترجمۂ معانی</h3><p class=\"tr\">ان کا بدلہ ان کے رب کے پاس ہمیشگی والی جنتیں ہیں جن کے نیچے نہریں بہہ رہی ہیں جن میں وه ہمیشہ ہمیشہ رہیں گے۔ اللہ تعالیٰ ان سے راضی ہوا اور یہ اس سے راضی ہوئے۔ یہ ہے اس کے لئے جو اپنے پروردگار سے ڈرے.</p><span class=\"cr\" dir=\"ltr\">Urdu Translation - Muhammad Junagarhi — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">دونوں ائمہ کا کلام اصل عربی میں لفظ بلفظ، حوالوں کے ساتھ دیا گیا ہے۔</p><section><h2>امام ابن القیم</h2><blockquote class=\"ar\" lang=\"ar\">وأما الرضا عنه: فهو رضا العبد بما يفعله به، ويعطيه إياه، ولهذا لم يجئ إلا في الثواب والجزاء.<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 2/181</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ur#s98a8\">تفاعلی تفسیر میں کھولیں (مکمل متون)</a><div class=\"pn\"><a href=\"/ur/ayah/98-7.html\">پچھلی آیت (98:7)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/98-8.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/98-8.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <b lang=\"ur\">اردو</b> · <a href=\"/id/ayah/98-8.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/98-8.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/98-8.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/98-8.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/98-8.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/98-8.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/98-8.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/98-8.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/98-8.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/98-8.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/98-8.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/98-8.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a></nav>\n<footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"