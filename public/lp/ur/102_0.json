adcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"صفحۂ اول\", \"item\": \"https://tafsirshaikhain.com/ur/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سورۃ التكاثر\", \"item\": \"https://tafsirshaikhain.com/ur/surah/102.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیت 7\", \"item\": \"https://tafsirshaikhain.com/ur/ayah/102-7.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ur/\">صفحۂ اول</a> › <a href=\"/ur/surah/102.html\">سورۃ التكاثر</a> › آیت 7</nav><h1>تفسیر سورۃ التكاثر 102:7</h1><p class=\"vt ar\" lang=\"ar\">﴿ثُمَّ لَتَرَوُنَّهَا عَيْنَ الْيَقِينِ﴾</p><section><h3>ترجمۂ معانی</h3><p class=\"tr\">اور تم اسے یقین کی آنکھ سے دیکھ لو گے.</p><span class=\"cr\" dir=\"ltr\">Urdu Translation - Muhammad Junagarhi — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">دونوں ائمہ کا کلام اصل عربی میں لفظ بلفظ، حوالوں کے ساتھ دیا گیا ہے۔</p><section><h2>شیخ الاسلام ابن تیمیہ</h2><blockquote class=\"ar\" lang=\"ar\">ولهذا أتبع ذلك بالقسم على الرؤية التي هي عين اليقين التي هي فوق الخبر الذي هو علم اليقين<cite>«مجموع الفتاوى» 16/518</cite></blockquote></section><section><h2>امام ابن القیم</h2><blockquote class=\"ar\" lang=\"ar\">فاليقين للسمع وعين اليقين للبصر<cite>«التبيان في أقسام القرآن» 1/192</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فهذه الرؤية الثانية غير الأولى من وج