in.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"صفحۂ اول\", \"item\": \"https://tafsirshaikhain.com/ur/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سورۃ الصافات\", \"item\": \"https://tafsirshaikhain.com/ur/surah/37.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیت 49\", \"item\": \"https://tafsirshaikhain.com/ur/ayah/37-49.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ur/\">صفحۂ اول</a> › <a href=\"/ur/surah/37.html\">سورۃ الصافات</a> › آیت 49</nav><h1>تفسیر سورۃ الصافات 37:49</h1><p class=\"vt ar\" lang=\"ar\">﴿كَأَنَّهُنَّ بَيْضٌ مَّكْنُونٌ﴾</p><section><h3>ترجمۂ معانی</h3><p class=\"tr\">ایسی جیسے چھپائے ہوئے انڈے.</p><span class=\"cr\" dir=\"ltr\">Urdu Translation - Muhammad Junagarhi — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">دونوں ائمہ کا کلام اصل عربی میں لفظ بلفظ، حوالوں کے ساتھ دیا گیا ہے۔</p><section><h2>امام ابن القیم</h2><h3>جو انہوں نے دوسروں سے نقل کیا</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">حديث مرفوع</span> <span class=\"st\">استشهد به</span> «رقتهن كرقة الجلد الذي رأيت في داخل البيضة»<cite>«إعلام الموقعين عن رب العالمين» 4/211</cite></blockquote></section><a