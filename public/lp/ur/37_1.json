reflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/37-95.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/37-95.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/37-95.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/37-95.html\">\n<meta property=\"og:title\" content=\"تفسیر الصافات 37:95 — ابن تیمیہ اور ابن القیم کے کلام میں\">\n<meta property=\"og:description\" content=\"تو آپ نے فرمایا تم انہیں پوجتے ہو جنہیں (خود) تم تراشتے ہو.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"صفحۂ اول\", \"item\": \"https://tafsirshaikhain.com/ur/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سورۃ الصافات\", \"item\": \"https://tafsirshaikhain.com/ur/surah/37.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیت 95\", \"item\": \"https://tafsirshaikhain.com/ur/ayah/37-95.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ur/\">صفحۂ اول</a> › <a href=\"/ur/surah/37.html\">سورۃ الصافات</a> › آیت 95</nav><h1>تفسیر سورۃ الصافات 37:95</h1><p class=\"vt ar\" lang=\"ar\">﴿قَالَ أَتَعْبُدُونَ مَا تَنْحِتُونَ﴾</p><section><h3>ترجمۂ معانی</h3><p class=\"tr\">تو آپ نے فرمایا تم انہیں پوجتے ہو جنہیں (خود) تم تراشتے ہو.</p><span class=\"cr\" dir=\"ltr\">Urdu Translation - Muhammad Junagarhi — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">دونوں ائمہ کا کلام اصل عربی میں لفظ بلفظ، حوالوں کے ساتھ دیا گیا ہے۔</p><section><h2>شیخ الاسلام ابن تیمیہ</h2><blockquote class=\"ar\" lang=\"ar\">فجعل الأصنام منحوتة معمولة لهم<cite>«مجموع الفتاوى» 8/17</cite></blockquote></section><section><h2>امام ابن القیم</h2><blockquote class=\"ar\" lang=\"ar\">وأن الآية وردت لبيان عدم استحقاق معبوديهم للعبادة لأنها مخلوقة لله وذكرنا شواهده من القرآن<cite>«بدائع الفوائد» 1/151</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ur#s37a95\">تفاعلی تفسیر میں کھولیں (مکمل متون)</a><div class=\"pn\"><a href=\"/ur/ayah/37-89.html\">پچھلی آیت (37:89)</a><a href=\"/ur/ayah/37-96.html\">اگلی آیت (37:96)</a></div></main><footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/ur/\">صفحۂ اول</a> · <a href=\"/about.html\">منصوبے کے بارے میں</a> · <a href=\"/privacy.html\">رازداری اور شرائط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/37-96.html":"<!doctype html>\n<html lang=\"ur\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>تفسیر الصافات 37:96 — ابن تیمیہ اور ابن القیم کے کلام میں</title>\n<meta name=\"description\" content=\"حاﻻنکہ تمہیں اور تمہاری بنائی ہوئی چیزوں کو اللہ ہی نے پیدا کیا ہے.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/ur/ayah/37-96.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/37-96.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/37-96.html\">\n<link rel=\"alternat