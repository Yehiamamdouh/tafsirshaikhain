-3.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ur/\">صفحۂ اول</a> › <a href=\"/ur/surah/88.html\">سورۃ الغاشية</a> › آیت 3</nav><h1>تفسیر سورۃ الغاشية 88:3</h1><p class=\"vt ar\" lang=\"ar\">﴿عَامِلَةٌ نَّاصِبَةٌ﴾</p><section><h3>ترجمۂ معانی</h3><p class=\"tr\">(اور) محنت کرنے والے تھکے ہوئے ہوں گے.</p><span class=\"cr\" dir=\"ltr\">Urdu Translation - Muhammad Junagarhi — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">دونوں ائمہ کا کلام اصل عربی میں لفظ بلفظ، حوالوں کے ساتھ دیا گیا ہے۔</p><section><h2>شیخ الاسلام ابن تیمیہ</h2><blockquote class=\"ar\" lang=\"ar\">ومعلوم أنه إنما وصفها بالنعمة يوم القيامة لا في الدنيا؛ إذ هذا ليس بمدح فالواجب تشابه الكلام وتناظر القسمين لا اختلافهما<cite>«مجموع الفتاوى» 16/218</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ur#s88a3\">تفاعلی تفسیر میں کھولیں (مکمل متون)</a><div class=\"pn\"><span></span><a href=\"/ur/ayah/88-17.html\">اگلی آیت (88:17)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/88-3.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/88-3.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <b lang=\"ur\">اردو</b> · <a href=\"/id/ayah/88-3.html\" hreflang=\"id\" lang=\"id\"