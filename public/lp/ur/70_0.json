hain.com/ur/surah/70.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیت 8\", \"item\": \"https://tafsirshaikhain.com/ur/ayah/70-8.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ur/\">صفحۂ اول</a> › <a href=\"/ur/surah/70.html\">سورۃ المعارج</a> › آیت 8</nav><h1>تفسیر سورۃ المعارج 70:8</h1><p class=\"vt ar\" lang=\"ar\">﴿يَوْمَ تَكُونُ السَّمَاءُ كَالْمُهْلِ﴾</p><section><h3>ترجمۂ معانی</h3><p class=\"tr\">جس دن آسمان مثل تیل کی تلچھٹ کے ہو جائے گا۔</p><span class=\"cr\" dir=\"ltr\">Urdu Translation - Muhammad Junagarhi — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">دونوں ائمہ کا کلام اصل عربی میں لفظ بلفظ، حوالوں کے ساتھ دیا گیا ہے۔</p><section><h2>شیخ الاسلام ابن تیمیہ</h2><blockquote class=\"ar\" lang=\"ar\">وأمثال هذه النصوص التي تبين الاستحالة والتغير على السموات والأرض والجبال وأنها تستحيل أنواعا من الاستحالة لتعدد الأوقات.<cite>«الصفدية» 2/225</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ur#s70a8\">تفاعلی تفسیر میں کھولیں (مکمل متون)</a><div class=\"pn\"><a href=\"/ur/ayah/70-4.html\">پچھلی آیت (70:4)</a><a href=\"/ur/ayah/70-9.html\">اگلی آیت (70:9)</a></div></main><footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/ur/\">صفحۂ اول</a> · <a href=\"/about.html\">منصوبے کے بارے میں</a> · <a href=\"/privacy.html\">رازداری اور شرائط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/70-9.html":"<!doctype html>\n<html lang=\"ur\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>تفسیر المعارج 70:9 — ابن تیمیہ اور ابن القیم کے کلام میں</title>\n<meta name=\"description\" content=\"اور پہاڑ مثل رنگین اون کے ہو جائیں گے.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/ur/ayah/70-9.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/70-9.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/70-9.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/70-9.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/70-9.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/70-9.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/70-9.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/70-9.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/70-9.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/70-9.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/70-9.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/70-9.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/70-9.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/70-9.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/70-9.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/70-9.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://t