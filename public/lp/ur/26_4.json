: \"ListItem\", \"position\": 3, \"name\": \"آیت 225\", \"item\": \"https://tafsirshaikhain.com/ur/ayah/26-225.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ur/\">صفحۂ اول</a> › <a href=\"/ur/surah/26.html\">سورۃ الشعراء</a> › آیت 225</nav><h1>تفسیر سورۃ الشعراء 26:225</h1><p class=\"vt ar\" lang=\"ar\">﴿أَلَمْ تَرَ أَنَّهُمْ فِي كُلِّ وَادٍ يَهِيمُونَ﴾</p><section><h3>ترجمۂ معانی</h3><p class=\"tr\">کیا آپ نے نہیں دیکھا کہ شاعر ایک ایک بیابان میں سر ٹکراتے پھرتے ہیں.</p><span class=\"cr\" dir=\"ltr\">Urdu Translation - Muhammad Junagarhi — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">دونوں ائمہ کا کلام اصل عربی میں لفظ بلفظ، حوالوں کے ساتھ دیا گیا ہے۔</p><section><h2>شیخ الاسلام ابن تیمیہ</h2><blockquote class=\"ar\" lang=\"ar\">والغاوي: هو الذي يتبع هواه بغير علم؛ وهذا هو الغي؛ وهو خلاف الرشد.<cite>«مجموع الفتاوى» 28/163</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">والشعراء جرت عادتهم أن يمشوا مع الطبع؛ كما قال الله تعالى: {ألم تر أنهم في كل واد يهيمون} {وأنهم يقولون ما لا يفعلون}<cite>«مجموع الفتاوى» 28/163</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ur#s26a225\">تفاعلی تفسیر میں کھولیں (مکمل متون)</a><div class=\"pn\"><a href=\"/ur/ayah/26-222.html\">پچھلی آیت (26:222)</a></div></main><footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/ur/\">صفحۂ اول</a> · <a href=\"/about.html\">منصوبے کے بارے میں</a> · <a href=\"/privacy.html\">رازداری اور شرائط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}