me\": \"امام ابن قیم\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"جامع تفسیر الشیخین\", \"url\": \"https://tafsirshaikhain.com/fa/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"صفحهٔ اصلی\", \"item\": \"https://tafsirshaikhain.com/fa/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سوره المؤمنون\", \"item\": \"https://tafsirshaikhain.com/fa/surah/23.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیه 101\", \"item\": \"https://tafsirshaikhain.com/fa/ayah/23-101.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/23.html\">سوره المؤمنون</a> › آیه 101</nav><h1>تفسیر سوره المؤمنون 23:101</h1><p class=\"vt ar\" lang=\"ar\">﴿فَإِذَا نُفِخَ فِي الصُّورِ فَلَا أَنسَابَ بَيْنَهُمْ يَوْمَئِذٍ وَلَا يَتَسَاءَلُونَ﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">روزی که در صور دمیده می‌شود، هیچ ‌یک از [افتخارات خانوادگی و] پیوندهای خویشاوندی میانشان [برقرار] نخواهد بود و [از وحشتِ عذاب] از [حال] یکدیگر نمی‌پرسند.</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>شیخ‌الاسلام ابن تیمیه</h2><h3>آنچه از دیگران نقل کرده است</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن عباس</span> <span class=\"st\">حكاه</span> «لا أنساب في النفخة الأولى {ونفخ في الصور فصعق من في السماوات ومن في الأرض إلا من شاء الله} [الزمر: 68] فلا أنساب عند ذلك ولا يتساءلون. في النفخة الآخرة أقبل بعضهم على بعض يتساءلون»<cite>«الفتاوى الكبرى لابن تيمية» 6/388</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s23a101\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><a href=\"/fa/ayah/23-100.html\">آیهٔ قبلی (23:100)</a><a href=\"/fa/ayah/23-111.html\">آیهٔ بعدی (23:111)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/23-101.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/23-101.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/23-101.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/23-101.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/23-101.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/23-101.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/23-101.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/23-101.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <b lang=\"fa\">فارسی</b> · <a href=\"/ru/ayah/23-101.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/23-101.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/23-101.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/23-101.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/23-101.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">D