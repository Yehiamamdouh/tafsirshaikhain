7.html\">\n<meta property=\"og:title\" content=\"تفسیر الأنبياء 21:107 — از سخنان ابن تیمیه و ابن قیم\">\n<meta property=\"og:description\" content=\"و [ای محمد،] تو را جز رحمتی برای جهانیان نفرستادیم.\">\n<meta property=\"og:url\" content=\"https://tafsirshaikhain.com/fa/ayah/21-107.html\">\n<meta property=\"og:site_name\" content=\"جامع تفسیر الشیخین\">\n<meta property=\"og:locale\" content=\"fa_IR\">\n<meta property=\"og:type\" content=\"article\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta property=\"og:image:width\" content=\"1200\">\n<meta property=\"og:image:height\" content=\"630\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<link rel=\"manifest\" href=\"/manifest.webmanifest\">\n<link rel=\"apple-touch-icon\" href=\"/icon-192.png\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"تفسیر الأنبياء 21:107 — از سخنان ابن تیمیه و ابن قیم\", \"description\": \"و [ای محمد،] تو را جز رحمتی برای جهانیان نفرستادیم.\", \"inLanguage\": \"fa\", \"url\": \"https://tafsirshaikhain.com/fa/ayah/21-107.html\", \"mainEntityOfPage\": \"https://tafsirshaikhain.com/fa/ayah/21-107.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"شیخ‌الاسلام ابن تیمیه\"}, {\"@type\": \"Person\", \"name\": \"امام ابن قیم\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"جامع تفسیر الشیخین\", \"url\": \"https://tafsirshaikhain.com/fa/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"صفحهٔ اصلی\", \"item\": \"https://tafsirshaikhain.com/fa/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سوره الأنبياء\", \"item\": \"https://tafsirshaikhain.com/fa/surah/21.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیه 107\", \"item\": \"https://tafsirshaikhain.com/fa/ayah/21-107.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/21.html\">سوره الأنبياء</a> › آیه 107</nav><h1>تفسیر سوره الأنبياء 21:107</h1><p class=\"vt ar\" lang=\"ar\">﴿وَمَا أَرْسَلْنَاكَ إِلَّا رَحْمَةً لِّلْعَالَمِينَ﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">و [ای محمد،] تو را جز رحمتی برای جهانیان نفرستادیم.</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>شیخ‌الاسلام ابن تیمیه</h2><blockquote class=\"ar\" lang=\"ar\">وبهذا يتبين لك أن العقوبات الشرعية كلها أدوية نافعة يصلح الله بها مرض القلوب وهي من رحمة الله بعباده ورأفته بهم<cite>«مجموع الفتاوى» 15/290</cite></blockquote></section><section><h2>امام ابن قیم</h2><blockquote class=\"ar\" l