, {\"@type\": \"Person\", \"name\": \"امام ابن قیم\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"جامع تفسیر الشیخین\", \"url\": \"https://tafsirshaikhain.com/fa/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"صفحهٔ اصلی\", \"item\": \"https://tafsirshaikhain.com/fa/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سوره الأنبياء\", \"item\": \"https://tafsirshaikhain.com/fa/surah/21.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیه 112\", \"item\": \"https://tafsirshaikhain.com/fa/ayah/21-112.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/21.html\">سوره الأنبياء</a> › آیه 112</nav><h1>تفسیر سوره الأنبياء 21:112</h1><p class=\"vt ar\" lang=\"ar\">﴿قَالَ رَبِّ احْكُم بِالْحَقِّ وَرَبُّنَا الرَّحْمَٰنُ الْمُسْتَعَانُ عَلَىٰ مَا تَصِفُونَ﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">[پیامبر] گفت: «پروردگارا، [بین ما و کافران] به حق داوری کن؛ و پروردگار ما، [الله] رحمان است که در برابر آنچه [از کفر و شرک] می‌گویید از او یاری می‌خواهیم».</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>شیخ‌الاسلام ابن تیمیه</h2><blockquote class=\"ar\" lang=\"ar\">ويكون الحكم حكما بالحق والتكوين والفعل كقوله: {فلن أبرح الأرض حتى يأذن لي أبي أو يحكم الله لي} وقوله: {قال رب احكم بالحق} .<cite>«مجموع الفتاوى» 2/264</cite></blockquote></section><section><h2>امام ابن قیم</h2><blockquote class=\"ar\" lang=\"ar\">أي افعل ما تنصر به عبادك وتخذل به أعداءك<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/280</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">عطف الخبر على الطلب كثير كقوله تعالى: {قال رب احكم بالحق، وربنا الرحمن المستعان على ما تصفون} [الأنبياء: 112] ، وقوله تعالى: {وقل رب اغفر وارحم وأنت خير الراحمين}<cite>«طريق الهجرتين وباب السعادتين» 1/350</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s21a112\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><a href=\"/fa/ayah/21-107.html\">آیهٔ قبلی (21:107)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/21-112.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/21-112.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/21-112.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/21-112.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/21-112.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/21-112.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/21-112.html\" hreflang=\"bn\" lang=\"bn\" 