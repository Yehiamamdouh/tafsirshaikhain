mary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"صفحهٔ اصلی\", \"item\": \"https://tafsirshaikhain.com/fa/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سوره الأحزاب\", \"item\": \"https://tafsirshaikhain.com/fa/surah/33.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیه 71\", \"item\": \"https://tafsirshaikhain.com/fa/ayah/33-71.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/33.html\">سوره الأحزاب</a> › آیه 71</nav><h1>تفسیر سوره الأحزاب 33:71</h1><p class=\"vt ar\" lang=\"ar\">﴿يُصْلِحْ لَكُمْ أَعْمَالَكُمْ وَيَغْفِرْ لَكُمْ ذُنُوبَكُمْ وَمَن يُطِعِ اللَّهَ وَرَسُولَهُ فَقَدْ فَازَ فَوْزًا عَظِيمًا﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">[پرهیزگار و راستگو باشید] تا الله کارهایتا‌ن را اصلاح کند و گناهانتان را بیامرزد و [بدانید] هر کس از الله و پیامبرش اطاعت کند، یقیناً به کامیابی بزرگی دست یافته است.</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>امام ابن قیم</h2><blockquote class=\"ar\" lang=\"ar\">وكل ما الناس فيه فإما طاعة للرسول، وإما هوى<cite>«الكلام على مسألة السماع» 1/12</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وهذا جزاء على الطاعات بالطاعات<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/161</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s33a71\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><a href=\"/fa/ayah/33-68.html\">آیهٔ قبلی (33:68)</a></div></main><footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/fa/\">صفحهٔ اصلی</a> · <a href=\"/about.html\">دربارهٔ پروژه</a> · <a href=\"/privacy.html\">حریم خصوصی و شرایط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}