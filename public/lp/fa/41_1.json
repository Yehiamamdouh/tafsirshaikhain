https://tafsirshaikhain.com/fa/surah/41.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیه 53\", \"item\": \"https://tafsirshaikhain.com/fa/ayah/41-53.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/41.html\">سوره فصلت</a> › آیه 53</nav><h1>تفسیر سوره فصلت 41:53</h1><p class=\"vt ar\" lang=\"ar\">﴿سَنُرِيهِمْ آيَاتِنَا فِي الْآفَاقِ وَفِي أَنفُسِهِمْ حَتَّىٰ يَتَبَيَّنَ لَهُمْ أَنَّهُ الْحَقُّ أَوَلَمْ يَكْفِ بِرَبِّكَ أَنَّهُ عَلَىٰ كُلِّ شَيْءٍ شَهِيدٌ﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">[در این دنیا و در هنگامۀ قیامت،] نشانه‌هاى [توان و تدبیر] خود را در آفاق [جهان] و در [وجود] خودشان به آنان نشان خواهیم داد تا برایشان روشن شود كه قرآن حق است. آیا كافى نیست كه پروردگارت بر هر چیزی گواه است؟</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>شیخ‌الاسلام ابن تیمیه</h2><blockquote class=\"ar\" lang=\"ar\">فأخبر: أنه سيريهم الآيات المرئية المشهودة حتى يتبين لهم أن القرآن حق. ثم قال: {أولم يكف بربك أنه على كل شيء شهيد} أي بإخبار الله ربك في القرآن وشهادته بذلك.<cite>«مجموع الفتاوى» 4/9</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">والصواب الذي عليه المفسرون وعليه تدل الآية أن الضمير عائد إلى القرآن<cite>«درء تعارض العقل والنقل» 3/134</cite></blockquote></section><section><h2>امام ابن قیم</h2><blockquote class=\"ar\" lang=\"ar\">والمقصود: أن الله سبحانه يشهد بما جعل آياته المخلوقة دالة عليه، فإن دلالتها إنما هي بخلقه وجعله، ويشهد بآياته القولية الكلامية المطابقة لما شهدت به آياته الخلقية، فتتطابق شهادة القول وشهادة الفعل، كما قال تعالى: {سنريهم آياتنا في الآفاق وفي أنفسهم حتى يتبين لهم أنه الحق} [فصلت: 53] ، أي أن القرآن حق، فأخبر أنه يدل بآياته الأفقية والنفسية على صدق آياته القولية الكلامية<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 3/422</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فقال تعالى {سنريهم آياتنا في الآفاق وفي أنفسهم حتى يتبين لهم أنه الحق} [فصلت: 53] أي القرآن، فإنه هو المتقدم في قوله: {قل أرأيتم إن كان من عند الله ثم كفرتم به}<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 3/432</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s41a53\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><a href=\"/fa/ayah/41-51.html\">آیهٔ قبلی (41:51)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/41-53.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/41-53.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/41-53.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/41-53.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/41-53.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/41-53.html\"