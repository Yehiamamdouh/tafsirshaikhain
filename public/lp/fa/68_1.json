ps://tafsirshaikhain.com/fa/ayah/68-50.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/68.html\">سوره القلم</a> › آیه 50</nav><h1>تفسیر سوره القلم 68:50</h1><p class=\"vt ar\" lang=\"ar\">﴿فَاجْتَبَاهُ رَبُّهُ فَجَعَلَهُ مِنَ الصَّالِحِينَ﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">آنگاه پروردگارش او را برگُزید و از صالحان قرار داد.</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>شیخ‌الاسلام ابن تیمیه</h2><blockquote class=\"ar\" lang=\"ar\">فكانت حاله بعد قوله: {لا إله إلا أنت سبحانك إني كنت من الظالمين} أرفع من حاله قبل أن يكون ما كان والاعتبار بكمال النهاية لا بما جرى في البداية<cite>«مجموع الفتاوى» 10/299</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s68a50\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><a href=\"/fa/ayah/68-49.html\">آیهٔ قبلی (68:49)</a><a href=\"/fa/ayah/68-51.html\">آیهٔ بعدی (68:51)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/68-50.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/68-50.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/68-50.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/68-50.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/68-50.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/68-50.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/68-50.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/68-50.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <b lang=\"fa\">فارسی</b> · <a href=\"/ru/ayah/68-50.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/68-50.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/68-50.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/68-50.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/68-50.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/68-50.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a></nav>\n<footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/fa/\">صفحهٔ اصلی</a> · <a href=\"/about.html\">دربارهٔ پروژه</a> · <a href=\"/privacy.html\">حریم خصوصی و شرایط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n<script>try{localStorage.setItem(\"lang\",\"fa\")}catch(e){}document.addEventListener(\"click\",function(e){var a=e.target.closest&&e.target.closest(\"[data-l]\");if(a)try{localStorage.setItem(\"lang\",a.dataset.l)}catch(x){}})</script>\n</