le\" content=\"تفسیر الكوثر 108:2 — از سخنان ابن تیمیه و ابن قیم\">\n<meta property=\"og:description\" content=\"پس برای پروردگارت نماز بخوان و قربانی کن.\">\n<meta property=\"og:url\" content=\"https://tafsirshaikhain.com/fa/ayah/108-2.html\">\n<meta property=\"og:site_name\" content=\"جامع تفسیر الشیخین\">\n<meta property=\"og:locale\" content=\"fa_IR\">\n<meta property=\"og:type\" content=\"article\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta property=\"og:image:width\" content=\"1200\">\n<meta property=\"og:image:height\" content=\"630\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<link rel=\"manifest\" href=\"/manifest.webmanifest\">\n<link rel=\"apple-touch-icon\" href=\"/icon-192.png\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"تفسیر الكوثر 108:2 — از سخنان ابن تیمیه و ابن قیم\", \"description\": \"پس برای پروردگارت نماز بخوان و قربانی کن.\", \"inLanguage\": \"fa\", \"url\": \"https://tafsirshaikhain.com/fa/ayah/108-2.html\", \"mainEntityOfPage\": \"https://tafsirshaikhain.com/fa/ayah/108-2.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"شیخ‌الاسلام ابن تیمیه\"}, {\"@type\": \"Person\", \"name\": \"امام ابن قیم\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"جامع تفسیر الشیخین\", \"url\": \"https://tafsirshaikhain.com/fa/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"صفحهٔ اصلی\", \"item\": \"https://tafsirshaikhain.com/fa/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سوره الكوثر\", \"item\": \"https://tafsirshaikhain.com/fa/surah/108.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیه 2\", \"item\": \"https://tafsirshaikhain.com/fa/ayah/108-2.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/108.html\">سوره الكوثر</a> › آیه 2</nav><h1>تفسیر سوره الكوثر 108:2</h1><p class=\"vt ar\" lang=\"ar\">﴿فَصَلِّ لِرَبِّكَ وَانْحَرْ﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">پس برای پروردگارت نماز بخوان و قربانی کن.</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>شیخ‌الاسلام ابن تیمیه</h2><blockquote class=\"ar\" lang=\"ar\">أمره الله أن يجمع بين هاتين العبادتين العظيمتين وهما الصلاة والنسك الدالتان على القرب والتواضع والافتقار وحسن الظن<cite>«مجموع الفتاوى» 16/531</cite></blockquote></section><section><h2>امام ابن قیم</h2><blockquote class=\"ar\" lang=\"ar\">ولهذا يقرن الله سبحانه بينهما كقوله: {فصل لربك وانحر}<cite>«إعلام الموقعين عن رب العالمين» 2/118</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وبدأ في العيد بالصلاة ثم جعل النحر بعدها، وأخبر أن ( «من ذبح قبلها، فلا نسك له» ) تقديما لما بدأ الله به في قوله {فصل لربك وانحر}<cite>«زاد المعاد في هدي خير العباد» 2/320</cite></blockquote><h3>آنچه از دیگران نقل کرده است</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">بعض المتأولين</span> <span class=\"st\">ردّه</span> «إن المراد به ضع يدك على نحرك»<cite>«الصواعق المرسلة في الرد على الجهمية والمعطلة» 2/695</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">علي</span> <span class=\"st\">حكاه</span> «إنه وضع اليمين على الشمال في الصلاة تحت صدره،»<cite>«إعلام الموقعين عن رب العالمين» 2/290</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s108a2\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><span></span><a href=\"/fa/ayah/108-3.html\">آیهٔ بعدی (108:3)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/108-2.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/108-2.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/108-2.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/108-2.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/108-2.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/108-2.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/108-2.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/108-2.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <b lang=\"fa\">فارسی</b> · <a href=\"/ru/ayah/108-2.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/108-2.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/108-2.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/108-2.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/108-2.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/108-2.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a></nav>\n<footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/fa/\">صف