6px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/95.html\">سوره التين</a> › آیه 5</nav><h1>تفسیر سوره التين 95:5</h1><p class=\"vt ar\" lang=\"ar\">﴿ثُمَّ رَدَدْنَاهُ أَسْفَلَ سَافِلِينَ﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">سپس او را [که انحراف یافت،] به پست‌ترین [مراحلِ] پَستی برگرداندیم.</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>شیخ‌الاسلام ابن تیمیه</h2><blockquote class=\"ar\" lang=\"ar\">وفي قوله {أسفل سافلين} قولان. قيل: الهرم. وقيل: العذاب بعد الموت وهذا هو الذي دلت عليه الآية قطعا.<cite>«مجموع الفتاوى» 16/279</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s95a5\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><a href=\"/fa/ayah/95-1.html\">آیهٔ قبلی (95:1)</a><a href=\"/fa/ayah/95-6.html\">آیهٔ بعدی (95:6)</a></div></main><footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/fa/\">صفحهٔ اصلی</a> · <a href=\"/about.html\">دربارهٔ پروژه</a> · <a href=\"/privacy.html\">حریم خصوصی و شرایط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/95-6.html":"<!doctype html>\n<html lang=\"fa\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>تفسیر التين 95:6 — از سخنان ابن تیمیه و ابن قیم</title>\n<meta name=\"description\" content=\"مگر کسانی که ایمان آوردند و کار‌های شایسته انجام دادند؛ که پاداشی پایدار برایشان [در پیش] است.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/fa/ayah/95-6.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/95-6.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/95-6.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/95-6.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/95-6.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/95-6.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/95-6.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/95-6.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/95-6.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/95-6.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/95-6.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/95-6.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/95-6.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/95-6.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/95-6.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/95-6.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/95-6.html\">\n<meta property=\"og:title\" content=\"تفسیر التين 95:6 — از سخنان ابن تیمیه و ابن قیم\">\n<meta property=\"og:description\" content=\"مگر کسانی که ایمان آوردند و کار‌های شایسته انجام دادند؛ که پاداشی پایدار برایشان [در پیش] است.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"صفحهٔ اصلی\", \"item\": \"https://tafsirshaikhain.com/fa/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سوره التين\", \"item\": \"https://tafsirshaikhain.com/fa/surah/95.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیه 6\", \"item\": \"https://tafsirshaikhain.com/fa/ayah/95-6.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/95.html\">سوره التين</a> › آیه 6</nav><h1>تفسیر سوره التين 95:6</h1><p class=\"vt ar\" lang=\"ar\">﴿إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">مگر کسانی که ایمان آوردند و کار‌های شایسته انجام دادند؛ که پاداشی پایدار برایشان [در پیش] است.</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>شیخ‌الاسلام ابن تیمیه</h2><blockquote class=\"ar\" lang=\"ar\">فإنه جعله في أسفل سافلين إلا المؤمنين. والناس نوعان: فالكافر بعد الموت يعذب في أسفل سافلين والمؤمن في عليين.<cite>«مجموع الفتاوى» 16/279</cite></blockquote><h3>آنچه از دیگران نقل کرده است</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">إبراهيم النخعي</span> <span class=\"st\">رجّح غيره</span> «إذا بلغ المؤمن من الكبر ما يعجز عن العمل كتب الله له ما كان يعمل وهو قوله {فلهم أجر غير ممنون}»<cite>«مجموع الفتاوى» 16/280</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن قتيبة</span> <span class=\"st\">رجّح غيره</span> «المعنى {إلا الذين آمنوا} في وقت القوة والقدرة فإنهم في حال الكبر غير منقوصين وإن عجزوا عن الطاعات. فإن الله يعلم لو لم يسلبهم القوة لم ينقطعوا عن أفعال الخير فهو يجري لهم أجر ذلك.»<cite>«مجموع الفتاوى» 16/280</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s95a6\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><a href=\"/fa/ayah/95-5.html\">آیهٔ قبلی (95:5)</a><a href=\"/fa/ayah/95-7.html\">آیهٔ بعدی (95:7)</a></div></main><footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/fa/\">صفحهٔ اصلی</a> · <a href=\"/about.html\">دربارهٔ پروژه</a> · <a href=\"/privacy.html\">حریم خصوصی و شرایط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/95-7.html":"<!doctype html>\n<html lang=\"fa\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>تفسیر التين 95:7 — از سخنان ابن تیمیه و ابن قیم</title>\n<meta name=\"description\" content=\"پس [ای انسان،] چه چیزی بعد [از این همه دلایل روشن،] تو را به تکذیب [روز] جزا وا می‌دارد؟\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/fa/ayah/95-7.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/95-7.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/95-7.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/95-7.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/95-7.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhai