-7.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/95.html\">سوره التين</a> › آیه 7</nav><h1>تفسیر سوره التين 95:7</h1><p class=\"vt ar\" lang=\"ar\">﴿فَمَا يُكَذِّبُكَ بَعْدُ بِالدِّينِ﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">پس [ای انسان،] چه چیزی بعد [از این همه دلایل روشن،] تو را به تکذیب [روز] جزا وا می‌دارد؟</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>شیخ‌الاسلام ابن تیمیه</h2><blockquote class=\"ar\" lang=\"ar\">وقوله {فما يكذبك بعد بالدين} أي بالجزاء يتناول جزاءه على الأعمال في الدنيا والبرزخ والآخرة.<cite>«مجموع الفتاوى» 16/283</cite></blockquote><h3>آنچه از دیگران نقل کرده است</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">قتادة</span> <span class=\"st\">ردّه</span> «أي استيقن فقد جاءك البيان من الله.»<cite>«مجموع الفتاوى» 16/287</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الفراء</span> <span class=\"st\">حكاه</span> «فمن يكذبك بالثواب والعقاب؟»<cite>«مجموع الفتاوى» 16/287</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s95a7\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><a href=\"/fa/ayah/95-6.html\">آیهٔ قبلی (95:6)</a><