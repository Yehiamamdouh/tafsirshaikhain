e=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › سوره ص</nav><h1>تفسیر سوره ص — از سخنان ابن تیمیه و ابن قیم</h1><section><p>آیاتی از این سوره که شرح دارند:</p><div class=\"vl\"><a href=\"/fa/ayah/38-1.html\">1</a><a href=\"/fa/ayah/38-5.html\">5</a><a href=\"/fa/ayah/38-27.html\">27</a><a href=\"/fa/ayah/38-28.html\">28</a><a href=\"/fa/ayah/38-45.html\">45</a><a href=\"/fa/ayah/38-54.html\">54</a><a href=\"/fa/ayah/38-75.html\">75</a><a href=\"/fa/ayah/38-76.html\">76</a><a href=\"/fa/ayah/38-85.html\">85</a></div></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s38a1\">باز کردن در تفسیر تعاملی (متن کامل)</a></main><footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/fa/\">صفحهٔ اصلی</a> · <a href=\"/about.html\">دربارهٔ پروژه</a> · <a href=\"/privacy.html\">حریم خصوصی و شرایط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}