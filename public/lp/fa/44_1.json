\" content=\"تفسیر الدخان 44:51 — از سخنان ابن تیمیه و ابن قیم\">\n<meta property=\"og:description\" content=\"یقیناً پرهیزگاران در جایگاه امنی هستند؛\">\n<meta property=\"og:url\" content=\"https://tafsirshaikhain.com/fa/ayah/44-51.html\">\n<meta property=\"og:site_name\" content=\"جامع تفسیر الشیخین\">\n<meta property=\"og:locale\" content=\"fa_IR\">\n<meta property=\"og:type\" content=\"article\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta property=\"og:image:width\" content=\"1200\">\n<meta property=\"og:image:height\" content=\"630\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<link rel=\"manifest\" href=\"/manifest.webmanifest\">\n<link rel=\"apple-touch-icon\" href=\"/icon-192.png\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"تفسیر الدخان 44:51 — از سخنان ابن تیمیه و ابن قیم\", \"description\": \"یقیناً پرهیزگاران در جایگاه امنی هستند؛\", \"inLanguage\": \"fa\", \"url\": \"https://tafsirshaikhain.com/fa/ayah/44-51.html\", \"mainEntityOfPage\": \"https://tafsirshaikhain.com/fa/ayah/44-51.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"شیخ‌الاسلام ابن تیمیه\"}, {\"@type\": \"Person\", \"name\": \"امام ابن قیم\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"جامع تفسیر الشیخین\", \"url\": \"https://tafsirshaikhain.com/fa/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"صفحهٔ اصلی\", \"item\": \"https://tafsirshaikhain.com/fa/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سوره الدخان\", \"item\": \"https://tafsirshaikhain.com/fa/surah/44.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیه 51\", \"item\": \"https://tafsirshaikhain.com/fa/ayah/44-51.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/44.html\">سوره الدخان</a> › آیه 51</nav><h1>تفسیر سوره الدخان 44:51</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّ الْمُتَّقِينَ فِي مَقَامٍ أَمِينٍ﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">یقیناً پرهیزگاران در جایگاه امنی هستند؛</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>امام ابن قیم</h2><blockquote class=\"ar\" lang=\"ar\">والمقام الأمين موضع الإقامة والأمين الآمن من كل سوء وآفة ومكروه وهو الذي قد جمع صفات الأمن كلها فهو آمن من الزوال والخراب وأنواع النقص وأهله آمنون فيه من الخروج والنغص والنكد<cite>«حادي الأرواح إلى بلاد الأفراح» 1/100</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s44a51\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><a href=\"/fa/ayah/44-49.html\">آیهٔ قبلی (44:49)</a><a href=\"/fa/ayah/44-56.html\">آیهٔ بعدی (44:56)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/44-51.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/44-51.htm