irshaikhain.com/ha/ayah/82-13.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/82-13.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/82-13.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/82-13.html\">\n<meta property=\"og:title\" content=\"تفسیر الإنفطار 82:13 — از سخنان ابن تیمیه و ابن قیم\">\n<meta property=\"og:description\" content=\"مسلماً نیکوکاران در نعمت[های بهشت] هستند.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/82.html\">سوره الإنفطار</a> › آیه 13</nav><h1>تفسیر سوره الإنفطار 82:13</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّ الْأَبْرَارَ لَفِي نَعِيمٍ﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">مسلماً نیکوکاران در نعمت[های بهشت] هستند.</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>امام ابن قیم</h2><blockquote class=\"ar\" lang=\"ar\">مختص بيوم المعاد فقط، بل هؤلاء في نعيم في دورهم الثلاثة، وهؤلاء في جحيم في دورهم الثلاثة<cite>«الجواب الكافي لمن سأل عن الدواء الشافي أو الداء والدواء» 1/121</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s82a13\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><a href=\"/fa/ayah/82-11.html\">آیهٔ قبلی (82:11)</a><a href=\"/fa/ayah/82-14.html\">آیهٔ بعدی (82:14)</a></div></main><footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/fa/\">صفحهٔ اصلی</a> · <a href=\"/about.html\">دربارهٔ پروژه</a> · <a href=\"/privacy.html\">حریم خصوصی و شرایط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/82-14.html":"<!doctype html>\n<html lang=\"fa\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>تفسیر الإنفطار 82:14 — از سخنان ابن تیمیه و ابن قیم</title>\n<meta name=\"description\" content=\"و یقیناً بدکاران در [آتش] جهنمند.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/fa/ayah/82-14.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/82-14.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/82-14.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/82-14.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/82-14.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/82-14.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/82-14.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/82-14.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/82-14.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/82-14.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/82-14.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/82-14.html\">\n<link rel=\"altern