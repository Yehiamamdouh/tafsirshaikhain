ge\": \"https://tafsirshaikhain.com/fa/ayah/42-51.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"شیخ‌الاسلام ابن تیمیه\"}, {\"@type\": \"Person\", \"name\": \"امام ابن قیم\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"جامع تفسیر الشیخین\", \"url\": \"https://tafsirshaikhain.com/fa/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"صفحهٔ اصلی\", \"item\": \"https://tafsirshaikhain.com/fa/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سوره الشورى\", \"item\": \"https://tafsirshaikhain.com/fa/surah/42.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیه 51\", \"item\": \"https://tafsirshaikhain.com/fa/ayah/42-51.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/42.html\">سوره الشورى</a> › آیه 51</nav><h1>تفسیر سوره الشورى 42:51</h1><p class=\"vt ar\" lang=\"ar\">﴿وَمَا كَانَ لِبَشَرٍ أَن يُكَلِّمَهُ اللَّهُ إِلَّا وَحْيًا أَوْ مِن وَرَاءِ حِجَابٍ أَوْ يُرْسِلَ رَسُولًا فَيُوحِيَ بِإِذْنِهِ مَا يَشَاءُ إِنَّهُ عَلِيٌّ حَكِيمٌ﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">درخورِ هیچ بشرى نیست كه الله با او سخن بگوید؛ مگر با وحى یا از فراسویِ حجابى یا [اینکه الله] فرشته‌اى بفرستد كه به فرمانش هر چه بخواهد، وحى كند. بی‌تردید، او تعالی بلندمرتبۀ حکیم است.</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>شیخ‌الاسلام ابن تیمیه</h2><blockquote class=\"ar\" lang=\"ar\">فبين سبحانه أن التكليم تارة يكون وحيا<cite>«مجموع الفتاوى» 12/300</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وتارة من وراء حجاب كما كلم موسى وتارة يرسل رسولا فيوحي الرسول بإذن الله ما يشاء<cite>«مجموع الفتاوى» 12/300</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فدل على أن التكليم من وراء حجاب - كما كلم موسى - أمر غير الإيحاء.<cite>«مجموع الفتاوى» 12/129</cite></blockquote></section><section><h2>امام ابن قیم</h2><blockquote class=\"ar\" lang=\"ar\">فجعل الوحي في هذه الآية قسما من أقسام التكليم، وجعله في آية النساء قسيما للتكليم، وذلك باعتبارين، فإنه قسيم التكليم الخاص الذي هو بلا واسطة، وقسم من التكليم العام الذي هو إيصال المعنى بطرق متعددة.<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/62</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s42a51\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><a href=\"/fa/ayah/42-50.html\">آیهٔ قبلی (42:50)</a><a href=\"/fa/ayah/42-52.html\">آیهٔ بعدی (42:52)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/42-51.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/42-51.html\" hreflang=\"en\" lang=\"en\" data-l=\"