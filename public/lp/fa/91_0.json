e=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"صفحهٔ اصلی\", \"item\": \"https://tafsirshaikhain.com/fa/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سوره الشمس\", \"item\": \"https://tafsirshaikhain.com/fa/surah/91.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیه 8\", \"item\": \"https://tafsirshaikhain.com/fa/ayah/91-8.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/91.html\">سوره الشمس</a> › آیه 8</nav><h1>تفسیر سوره الشمس 91:8</h1><p class=\"vt ar\" lang=\"ar\">﴿فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَاهَا﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">سپس نافرمانی و پرهیزگاری‌اش را [به او] الهام کرد.</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>شیخ‌الاسلام ابن تیمیه</h2><blockquote class=\"ar\" lang=\"ar\">وهذا في تلك الآية أظهر لأن الإلهام استعماله مشهور في إلهام القلوب لا في التبيين الظاهر الذي تقوم به الحجة.<cite>«مجموع الفتاوى» 16/145</cite></blockquote><h3>آنچه از دیگران نقل کرده است</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">قيل</span> <span class=\"st\">رجّح غيره</span> «هو البيان العام»<cite>«مجموع الفتاوى» 16/145</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">قيل</span> <span class=\"st\">أقرّه</span> «بل ألهم الفاجر الفجور والتقي التقوى.»<cite>«مجموع الفتاوى» 16/145</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s91a8\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><a href=\"/fa/ayah/91-7.html\">آیهٔ قبلی (91:7)</a><a href=\"/fa/ayah/91-9.html\">آیهٔ بعدی (91:9)</a></div></main><footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/fa/\">صفحهٔ اصلی</a> · <a href=\"/about.html\">دربارهٔ پروژه</a> · <a href=\"/privacy.html\">حریم خصوصی و شرایط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/91-9.html":"<!doctype html>\n<html lang=\"fa\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>تفسیر الشمس 91:9 — از سخنان ابن تیمیه و ابن قیم</title>\n<meta name=\"description\" content=\"بی‌تردید، هر کس نفس خود را [از گناهان] پاک کند، رستگار می‌شود.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/fa/ayah/91-9.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/91-9.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/91-9.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/91-9.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/91-9.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/91-9.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/91-9.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/91-9.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/91-9.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/91-9.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/91-9.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/91-9.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/91-9.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/91-9.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/91-9.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/91-9.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/91-9.html\">\n<meta property=\"og:title\" content=\"تفسیر الشمس 91:9 — از سخنان ابن تیمیه و ابن قیم\">\n<meta property=\"og:description\" content=\"بی‌تردید، هر کس نفس خود را [از گناهان] پاک کند، رستگار می‌شود.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"صفحهٔ اصلی\", \"item\": \"https://tafsirshaikhain.com/fa/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سوره الشمس\", \"item\": \"https://tafsirshaikhain.com/fa/surah/91.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیه 9\", \"item\": \"https://tafsirshaikhain.com/fa/ayah/91-9.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/91.html\">سوره الشمس</a> › آیه 9</nav><h1>تفسیر سوره الشمس 91:9</h1><p class=\"vt ar\" lang=\"ar\">﴿قَدْ أَفْلَحَ مَن زَكَّاهَا﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">بی‌تردید، هر کس نفس خود را [از گناهان] پاک کند، رستگار می‌شود.</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>شیخ‌الاسلام ابن تیمیه</h2><blockquote class=\"ar\" lang=\"ar\">إثبات لفعل العبد والوعد والوعيد بفلاح من زكى نفسه وخيبة من دساها.<cite>«مجموع الفتاوى» 16/243</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وأما الزكاة فهي متضمنة النماء والزيادة كالزرع وإن كانت الطهارة قد تدخل في معناها؛ فإن الشيء إذا تنظف مما يفسده زكا ونما وصلح وزاد في نفسه كالزرع ينفى من الدغل<cite>«مجموع الفتاوى» 15/387</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">والمفلحون هم الذين أدوا الواجبات وتركوا المحرمات<cite>«مجموع الفتاوى» 15/388</cite></blockquote><h3>آنچه از دیگران نقل کرده است</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">بعض المفسرين</span> <span class=\"st\">ردّه</span> «إن الضمير عائد إلى &quot; الله &quot; أي &quot; قد أفلح من زكاها الله وقد خاب من دساها الله &quot;»<cite>«مجموع الفتاوى» 16/231</cite></blockquote></section><section><h2>امام ابن قیم</h2><blockquote class=\"ar\" lang=\"ar\">أى تعمل بطاعة الله تعالى، فتصير زاكيا<cite>«إغاثة اللهفان من مصايد الشيطان» 1/50</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">ثم خص بالفلاح من زكاها فنماها وعلاها. ورفعها بآدابه التي أدب بها رسله وأنبياءه وأولياءه. وهي التقوى.<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 2/361</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فالعالم بالحق العامل به هو المنعم عليه، وهو الذي زكى نفسه بالعلم النافع والعمل الصالح، وهو المفلح {قد أفلح من زكاها} [الشمس: 9]<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/34</cite></blockquote><h3>آنچه از دیگران نقل کرده است</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الحسن البصري وقتادة</span> <span class=\"st\">حكاه</span> «قد أفلح من زكى نفسه وحملها على طاعة الله وقد خاب من أهلكها وحملها على معصية الله»<cite>«التبيان في أقسام القرآن» 1/21</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الزجاج وغيره</span> <span class=\"st\">حكاه</span> «جواب القسم {قد أفلح من زكاها} ولما طال الكلام حسن حذف اللام من الجواب»<cite>«التبيان في أقسام القرآن» 1/18</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s91a9\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><a href=\"/fa/ayah/91-8.html\">آیهٔ قبلی (91:8)</a><a href=\"/fa/ayah/91-10.html\">آیهٔ بعدی (91:10)</a></div></main><footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/fa/\">صفحهٔ اصلی</a> · <a href=\"/about.html\">دربارهٔ پروژه</a> · <a href=\"/privacy.html\">حریم خصوصی و شرایط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/91-10.html":"<!doctype html>\n<html lang=\"fa\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>تفسیر الشمس 91:10 — از سخنان ابن تیمیه و ابن قیم</title>\n<meta name=\"description\" content=\"و هر کس آن را [با گناه] آلوده سازد، یقیناً زیانکار می‌شود.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com