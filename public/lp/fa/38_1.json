lesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/38.html\">سوره ص</a> › آیه 54</nav><h1>تفسیر سوره ص 38:54</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّ هَٰذَا لَرِزْقُنَا مَا لَهُ مِن نَّفَادٍ﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">این روزی [و لطف] ماست که پایانی ندارد.</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>امام ابن قیم</h2><blockquote class=\"ar\" lang=\"ar\">وإنما استفيد عدم انتهاء نعيم الجنة بقوله: {إن هذا لرزقنا ما له من نفاد}<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/258</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">ولهذا جاء أن أهل الجنة في مزيد دائم بلا انتهاء فإن نعيمهم متصل ممن لا نهاية لفضله ولا لعطائه، ولا لمزيده ولا لأوصافه.<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 2/256</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s38a54\">باز کردن در تفسیر تعاملی (متن کامل)</a><div cla