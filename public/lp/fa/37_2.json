=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/37.html\">سوره الصافات</a> › آیه 112</nav><h1>تفسیر سوره الصافات 37:112</h1><p class=\"vt ar\" lang=\"ar\">﴿وَبَشَّرْنَاهُ بِإِسْحَاقَ نَبِيًّا مِّنَ الصَّالِحِينَ﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">و او را به [تولد] اسحاق که پیامبری از شایستگان بود بشارت دادیم.</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>شیخ‌الاسلام ابن تیمیه</h2><blockquote class=\"ar\" lang=\"ar\">فبين أنهما بشارتان: بشارة بالذبيح وبشارة ثانية بإسحاق وهذا بين.<cite>«مجموع الفتاوى» 4/333</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s37a112\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><a href=\"/fa/ayah/37-107.html\">آیهٔ قبلی (37:107)</a><a href=\"/fa/ayah/37-147.html\">آیهٔ بعدی (37:147)</a></div></main><footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/fa/\">صفحهٔ اصلی</a> · <a href=\"/about.html\">دربارهٔ پروژه</a> · <a href=\"/privacy.html\">حریم خصوصی و شرایط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/37-147.html":"<!doctype html>\n<html lang=\"fa\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>تفسیر الصافات 37:147 — از سخنان ابن تیمیه و ابن قیم</title>\n<meta name=\"description\" content=\"و [دوباره] او را به سوی صد هزار نفر یا بیشتر [به رسالت] فرستادیم.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/fa/ayah/37-147.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/37-147.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/37-147.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/37-147.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/37-147.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/37-147.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/37-147.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/37-147.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/37-147.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/37-147.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/37-147.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/37-147.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/37-147.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/37-147.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/37-147.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/37-147.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/37-147.html\">\n<meta property=\"og:title\" content=\"تفسیر الصافات 37:147 — از سخنان ابن تیمیه و ابن قیم\">\n<meta property=\"og:description\" content=\"و [دوباره] او را به سوی صد هزار نفر یا بیشتر [به رسالت] فرستادیم.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"صفحهٔ اصلی\", \"item\": \"https://tafsirshaikhain.com/fa/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سوره الصافات\", \"item\": \"https://tafsirshaikhain.com/fa/surah/37.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیه 147\", \"item\": \"https://tafsirshaikhain.com/fa/ayah/37-147.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/37.html\">سوره الصافات</a> › آیه 147</nav><h1>تفسیر سوره الصافات 37:147</h1><p class=\"vt ar\" lang=\"ar\">﴿وَأَرْسَلْنَاهُ إِلَىٰ مِائَةِ أَلْفٍ أَوْ يَزِيدُونَ﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">و [دوباره] او را به سوی صد هزار نفر یا بیشتر [به رسالت] فرستادیم.</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>امام ابن قیم</h2><blockquote class=\"ar\" lang=\"ar\">تحقيق لهذا العدد وأنهم لا ينقصون عن مائة ألف رجل واحدا<cite>«التبيان في أقسام القرآن» 1/250</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فذكر &quot; أو &quot; هاهنا كالتنصيص على حفظ المائة الألف، وأنها ليست مما أريد بها المبالغة، والله أعلم.<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/326</cite></blockquote><h3>آنچه از دیگران نقل کرده است</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">النبي صلى الله عليه وسلم</span> <span class=\"st\">استشهد به</span> «وفي الترمذي «أنه سئل - صلى الله عليه وسلم - عن قوله تعالى: {وأرسلناه إلى مائة ألف أو يزيدون} [الصافات: 147] كم كانت الزيادة؟ قال عشرة آلاف» .»<cite>«إعلام الموقعين عن رب العالمين» 4/312</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s37a147\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><a href=\"/fa/ayah/37-112.html\">آیهٔ قبلی (37:112)</a><a href=\"/fa/ayah/37-156.html\">آیهٔ بعدی (37:156)</a></div></main><footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/fa/\">صفحهٔ اصلی</a> · <a href=\"/about.html\">دربارهٔ پروژه</a> · <a href=\"/privacy.html\">حریم خصوصی و شرایط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}