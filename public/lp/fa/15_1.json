/15-75.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/15.html\">سوره الحجر</a> › آیه 75</nav><h1>تفسیر سوره الحجر 15:75</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّ فِي ذَٰلِكَ لَآيَاتٍ لِّلْمُتَوَسِّمِينَ﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">به یقین، در این [كیفر،] براى هوشیاران عبرت‌هاست.</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>شیخ‌الاسلام ابن تیمیه</h2><blockquote class=\"ar\" lang=\"ar\">والتوسم من السمة وهي العلامة<cite>«مجموع الفتاوى» 15/398</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فدل ذلك على أن من اعتبر بما عاقب الله به غيره من أهل الفواحش كان من المتوسمين.<cite>«مجموع الفتاوى» 15/399</cite></blockquote></section><section><h2>امام ابن قیم</h2><blockquote class=\"ar\" lang=\"ar\">وأما الفراسة فأثنى على أهلها ومدحهم في قوله تعالى {إن في ذلك لآيات للمتوسمين}<cite>«الروح في الكلام على أرواح الأموات والأحياء بالدلائل من الكتاب والسنة» 1/238</cite></blockquote><h3>آنچه از دیگران نقل کرده است</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن عباس وغيره</span> <span class=\"st\">أقرّه</span> «هم المتفرسون الذين يأخذون بالسيما وهي العلامة»<cite>«الكلام على مسألة السماع» 1/245</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">النبي صلى الله عليه وسلم</span> <span class=\"st\">استشهد به</span> «قلت: وأصل هذا في الترمذي مرفوعا: «اتقوا فراسة المؤمن؛ فإنه ينظر بنور الله، ثم قرأ {إن في ذلك لآيات للمتوسمين} [الحجر: 75] »»<cite>«إعلام الموقعين عن رب العالمين» 1/51</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s15a75\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><a href=\"/fa/ayah/15-72.html\">آیهٔ قبلی (15:72)</a><a href=\"/fa/ayah/15-91.html\">آیهٔ بعدی (15:91)</a></div></main><footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/fa/\">صفحهٔ اصلی</a> · <a href=\"/about.html\">دربارهٔ پروژه</a> · <a href=\"/privacy.html\">حریم خصوصی و شرایط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/15-91.html":"<!doctype html>\n<html lang=\"fa\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>تفسیر الحجر 15:91 — از سخنان ابن تیمیه و ابن قیم</title>\n<meta name=\"description\" content=\"همان کسانی كه قرآن را بخش بخش کردند [و آن را شعر، سحر، کذب، و اساطیر ‌نامیدند].\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/fa/ayah/15-91.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/15-91.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/15-91.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/15-91.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/15-91.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/15-91.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/15-91.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/15-91.html\">\n<