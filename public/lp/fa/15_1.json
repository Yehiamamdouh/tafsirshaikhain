\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/15.html\">سوره الحجر</a> › آیه 93</nav><h1>تفسیر سوره الحجر 15:93</h1><p class=\"vt ar\" lang=\"ar\">﴿عَمَّا كَانُوا يَعْمَلُونَ﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">از آنچه می‌کردند.</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>شیخ‌الاسلام ابن تیمیه</h2><blockquote class=\"ar\" lang=\"ar\">فالأولى تحقيق شهادة أن لا إله إلا الله والثانية تحقيق الشهادة بأن محمدا رسول<cite>«مجموع الفتاوى» 19/172</cite></blockquote><h3>آنچه از دیگران نقل کرده است</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">أبو العالية</span> <span class=\"st\">أقرّه</span> «خلتان يسأل عنهما كل أحد: ماذا كنت تعبد؟ وماذا أجبت المرسلين؟»<cite>«مجموع الفتاوى» 19/172</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s15a93\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><a href=\"/fa/ayah/15-92.html\">آیهٔ قبلی (15:92)</a><a href=\"/fa/ayah/15-99.html\">آیهٔ بعدی (15:99)</a></div></main><footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/fa/\">صفحهٔ اصلی</a> · <a href=\"/about.html\">دربارهٔ پروژه</a> · <a href=\"/privacy.html\">حریم خصوصی و شرایط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/15-99.html":"<!doctype html>\n<html lang=\"fa\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>تفسیر الحجر 15:99 — از سخنان ابن تیمیه و ابن قیم</title>\n<meta name=\"description\" content=\"و تا هنگامی‌ که مرگت فرامی‌رسد پروردگارت را عبادت کن.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/fa/ayah/15-99.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/15-99.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/15-99.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/15-99.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/15-99.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/15-99.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/15-99.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/15-99.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/15-99.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/15-99.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/15-99.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/15-99.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/15-99.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/15-99.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/15-99.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/15-99.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/15-99.html\">\n<meta property=\"og:title\" content=\"تفسیر الحجر 15:99 — از سخنان ابن تیمیه و ابن قیم\">\n<meta property=\"og:description\" content=\"و تا هنگامی‌ که مرگت فرامی‌رسد پروردگارت را عبادت کن.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"صفحهٔ اصلی\", \"item\": \"https://tafsirshaikhain.com/fa/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سوره الحجر\", \"item\": \"https://tafsirshaikhain.com/fa/surah/15.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیه 99\", \"item\": \"https://tafsirshaikhain.com/fa/ayah/15-99.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/15.html\">سوره الحجر</a> › آیه 99</nav><h1>تفسیر سوره الحجر 15:99</h1><p class=\"vt ar\" lang=\"ar\">﴿وَاعْبُدْ رَبَّكَ حَتَّىٰ يَأْتِيَكَ الْيَقِينُ﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">و تا هنگامی‌ که مرگت فرامی‌رسد پروردگارت را عبادت کن.</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>شیخ‌الاسلام ابن تیمیه</h2><blockquote class=\"ar\" lang=\"ar\">وهذا خطأ بإجماع المسلمين أهل التفسير وغيرهم فإن المسلمين متفقون على أن وجوب العبادات كالصلوات الخمس ونحوها وتحريم المرحمات كالفواحش والمظالم لا يزال واجبا على كل أحد ما دام عقله حاضرا، ولو بلغ، وأن الصلوات لا تسقط عن أحد قط إلا عن الحائض والنفساء أو من زال عقله.<cite>«درء تعارض العقل والنقل» 3/270</cite></blockquote><h3>آنچه از دیگران نقل کرده است</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">بعض المنتسبين إلى التصوف</span> <span class=\"st\">ردّه</span> «ويقول معناها: اعبد ربك حتى يحصل لك العلم والمعرفة فإذا حصل ذلك سقطت العبادة.»<cite>«مجموع الفتاوى» 11/417</cite></blockquote></section><section><h2>امام ابن قیم</h2><blockquote class=\"ar\" lang=\"ar\">واليقين هاهنا هو الموت بإجماع أهل التفسير<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/124</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فلا ينفك العبد من العبودية ما دام في دار التكليف<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/124</cite></blockquote><h3>آنچه از دیگران نقل کرده است</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">بعض أهل الشطح (اليقين: شهود الحقيقة)</span> <span class=\"st\">ردّه</span> «من شهد الحقيقة سقط عنه الأمر، ويحتجون بقوله تعالى {واعبد ربك حتى يأتيك اليقين} [الحجر: 99] ويفسرون اليقين بشهود الحكم الكوني»<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/182</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s15a99\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><a href=\"/fa/ayah/15-93.html\">آیهٔ قبلی (15:93)</a></div></main><footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/fa/\">صفحهٔ اصلی</a> · <a href=\"/about.html\">دربارهٔ پروژه</a> · <a href=\"/privacy.html\">حریم خصوصی و شرایط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}