content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"صفحهٔ اصلی\", \"item\": \"https://tafsirshaikhain.com/fa/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سوره الحجر\", \"item\": \"https://tafsirshaikhain.com/fa/surah/15.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیه 92\", \"item\": \"https://tafsirshaikhain.com/fa/ayah/15-92.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/15.html\">سوره الحجر</a> › آیه 92</nav><h1>تفسیر سوره الحجر 15:92</h1><p class=\"vt ar\" lang=\"ar\">﴿فَوَرَبِّكَ لَنَسْأَلَنَّهُمْ أَجْمَعِينَ﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">سوگند به پروردگارت، قطعاً [در قیامت] از همۀ آنان سؤال خواهیم کرد،</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>شیخ‌الاسلام ابن تیمیه</h2><blockquote class=\"ar\" lang=\"ar\">وإما على جملة طلبية كقوله تعالى: {فوربك لنسألنهم أجمعين} {عما كانوا يعملون} مع أن هذا القسم قد يراد به تحقيق المقسم عليه فيكون من باب الخبر وقد يراد به محض القسم.<cite>«مجموع الفتاوى» 13/315</cite></blockquote><h3>آنچه از دیگران نقل کرده است</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">أبو العالية</span> <span class=\"st\">أقرّه</span> «خلتان تسأل العباد يوم القيامة عنهما: عما كانوا يعملون وعما أجابوا الرسل.»<cite>«مجموع الفتاوى» 27/274</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s15a92\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><a href=\"/fa/ayah/15-91.html\">آیهٔ قبلی (15:91)</a><a href=\"/fa/ayah/15-93.html\">آیهٔ بعدی (15:93)</a></div></main><footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/fa/\">صفحهٔ اصلی</a> · <a href=\"/about.html\">دربارهٔ پروژه</a> · <a href=\"/privacy.html\">حریم خصوصی و شرایط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/15-93.html":"<!doctype html>\n<html lang=\"fa\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>تفسیر الحجر 15:93 — از سخنان ابن تیمیه و ابن قیم</title>\n<meta name=\"description\" content=\"از آنچه می‌کردند.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/fa/ayah/15-93.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/15-93.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/15-93.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/15-93.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/15-93.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/15-93.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/15-93.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/15-93.html\">\n<link rel=\"alternate\" hreflang=\