\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"صفحهٔ اصلی\", \"item\": \"https://tafsirshaikhain.com/fa/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سوره الأعراف\", \"item\": \"https://tafsirshaikhain.com/fa/surah/7.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیه 148\", \"item\": \"https://tafsirshaikhain.com/fa/ayah/7-148.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/7.html\">سوره الأعراف</a> › آیه 148</nav><h1>تفسیر سوره الأعراف 7:148</h1><p class=\"vt ar\" lang=\"ar\">﴿وَاتَّخَذَ قَوْمُ مُوسَىٰ مِن بَعْدِهِ مِنْ حُلِيِّهِمْ عِجْلًا جَسَدًا لَّهُ خُوَارٌ أَلَمْ يَرَوْا أَنَّهُ لَا يُكَلِّمُهُمْ وَلَا يَهْدِيهِمْ سَبِيلًا اتَّخَذُوهُ وَكَانُوا ظَالِمِينَ﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">و قوم موسی پس از [رفتنِ] او [به کوه طور،] از زیورهایشان مجسمۀ گوساله‌ای را ساختند [و عبادت کردند] که صدایی [همچون صدای گوساله] داشت. آیا نمی‌دیدند که [آن پیکرِ بی‌جان] با آنان سخن نمی‌گوید و آنان را به راهی هدایت نمی‌کند؟ آن را [معبود] گرفتند و [به خاطر این شرک، نسبت به خویش] ستمكار بودند.</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>شیخ‌الاسلام ابن تیمیه</h2><blockquote class=\"ar\" lang=\"ar\">فدل ذلك على أن عدم التكلم والهداية نقص، وأن الذي يتكلم ويهدي أكمل ممن لا يتكلم<cite>«الرسالة الأكملية في ما يجب لله من صفات الكمال» 1/18</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">والمقصود: أن ما أخرجه كان جسدا مصمتا لا روح فيه حتى تبين نقصه وأنه كان مسلوب الحياة والحركة.<cite>«مجموع الفتاوى» 5/219</cite></blockquote></section><section><h2>امام ابن قیم</h2><blockquote class=\"ar\" lang=\"ar\">فلو كان إله الخلق سبحانه كذلك لم يكن في هذا إنكار عليهم، واستدلال على بطلان الإلهية بذلك.<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/49</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s7a148\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><a href=\"/fa/ayah/7-145.html\">آیهٔ قبلی (7:145)</a><a href=\"/fa/ayah/7-154.html\">آیهٔ بعدی (7:154)</a></div></main><footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/fa/\">صفحهٔ اصلی</a> · <a href=\"/about.html\">دربارهٔ پروژه</a> · <a href=\"/privacy.html\">حریم خصوصی و شرایط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}