pe\": \"ListItem\", \"position\": 1, \"name\": \"صفحهٔ اصلی\", \"item\": \"https://tafsirshaikhain.com/fa/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سوره آل عمران\", \"item\": \"https://tafsirshaikhain.com/fa/surah/3.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیه 200\", \"item\": \"https://tafsirshaikhain.com/fa/ayah/3-200.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/3.html\">سوره آل عمران</a> › آیه 200</nav><h1>تفسیر سوره آل عمران 3:200</h1><p class=\"vt ar\" lang=\"ar\">﴿يَا أَيُّهَا الَّذِينَ آمَنُوا اصْبِرُوا وَصَابِرُوا وَرَابِطُوا وَاتَّقُوا اللَّهَ لَعَلَّكُمْ تُفْلِحُونَ﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">ای کسانی که ایمان آورده‌اید، [بر تکالیف دینی و رنج‌های دنیوی] شکیبایی ورزید و [در برابر دشمنان] پایدار باشید و مرزها[ی سرزمین اسلامی] را نگهبانى كنيد و پرهیزگاری پیشه کنید؛ باشد که رستگار شوید.</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>امام ابن قیم</h2><blockquote class=\"ar\" lang=\"ar\">والمرابطة مفاعلة من الربط وهو الشد. وسمي المرابط مرابطا لأن المرابطين يربطون خيولهم ينتظرون الفزع. ثم قيل لكل منتظر قد ربط نفسه لطاعة ينتظرها: مرابط.<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 2/158</cite></blockquote><h3>آنچه از دیگران نقل کرده است</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">قيل</span> <span class=\"st\">حكاه</span> «إنه انتقال من الأدنى إلى الأعلى. فالصبر دون المصابرة. والمصابرة دون المرابطة»<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 2/158</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s3a200\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><a href=\"/fa/ayah/3-199.html\">آیهٔ قبلی (3:199)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/3-200.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/3-200.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/3-200.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/3-200.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/3-200.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/3-200.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/3-200.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/3-200.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <b lang=\"fa\">فارسی</b> · <a href=\"/ru/ayah/3-200.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/3-200.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/3-200.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/3-200.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/3-200.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/3-200.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a></nav>\n<footer class=\"site-foot\"><sp