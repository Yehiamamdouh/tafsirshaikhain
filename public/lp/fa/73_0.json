href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/73.html\">سوره المزمل</a> › آیه 9</nav><h1>تفسیر سوره المزمل 73:9</h1><p class=\"vt ar\" lang=\"ar\">﴿رَّبُّ الْمَشْرِقِ وَالْمَغْرِبِ لَا إِلَٰهَ إِلَّا هُوَ فَاتَّخِذْهُ وَكِيلًا﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">[همان] پروردگار مشرق و مغرب که معبودی [به‌حق] جز او نیست؛ پس او را کارساز [و نگهبان خود] برگُزین.</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>امام ابن قیم</h2><blockquote class=\"ar\" lang=\"ar\">د أمر الله رسوله صلى الله عليه وسلم بأن يتخذه وكيلا.<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 2/138</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s73a9\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><a href=\"/fa/ayah/73-7.html\">آیهٔ قبلی (73:7)</a><a href=\"/fa/ayah/73-15.html\">آیهٔ بعدی (73:15)</a></div></main><footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/fa/\">صفحهٔ اصلی</a> · <a href=\"/about.html\">دربارهٔ پروژه</a> · <a href=\"/privacy.html\">حریم خصوصی و شرایط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/73-15.html":"<!doctype html>\n<html lang=\"fa\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>تفسیر المزمل 73:15 — از سخنان ابن تیمیه و ابن قیم</title>\n<meta name=\"description\" content=\"یقیناً ما پیامبری به سوی شما فرستادیم که بر شما شاهد [و گواه] است؛ همان‌گونه که به سوی فرعون پیامبری فرستادیم.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/fa/ayah/73-15.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/73-15.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/73-15.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/73-15.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/73-15.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/73-15.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/73-15.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/73-15.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/73-15.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/73-15.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/73-15.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/73-15.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/73-15.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/73-15.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/73-15.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/73-15.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/73-15.html\">\n<meta property=\"og:title\" content=\"تفسیر المزمل 73:15 — از سخنان ابن تیمیه و ابن قیم\">\n<meta property=\"og:description\" content=\"یقیناً ما پیامبری به سوی شما فرستادیم که بر شما شاهد [و گواه] است؛ همان‌گونه که به سوی فرعون پیامبری فرستادیم.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"صفحهٔ اصلی\", \"item\": \"https://tafsirshaikhain.com/fa/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سوره المزمل\", \"item\": \"https://tafsirshaikhain.com/fa/surah/73.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیه 15\", \"item\": \"https://tafsirshaikhain.com/fa/ayah/73-15.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/73.html\">سوره المزمل</a> › آیه 15</nav><h1>تفسیر سوره المزمل 73:15</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّا أَرْسَلْنَا إِلَيْكُمْ رَسُولًا شَاهِدًا عَلَيْكُمْ كَمَا أَرْسَلْنَا إِلَىٰ فِرْعَوْنَ رَسُولًا﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">یقیناً ما پیامبری به سوی شما فرستادیم که بر شما شاهد [و گواه] است؛ همان‌گونه که به سوی فرعون پیامبری فرستادیم.</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>امام ابن قیم</h2><blockquote class=\"ar\" lang=\"ar\">فأخبر سبحانه أنه أرسل محمدا - صلى الله عليه وسلم - إلينا كما أرسل موسى إلى فرعون، وأن فرعون عصى رسوله فأخذه أخذا وبيلا، فهكذا من عصى منكم محمدا - صلى الله عليه وسلم -<cite>«إعلام الموقعين عن رب العالمين» 1/107</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s73a15\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><a href=\"/fa/ayah/73-9.html\">آیهٔ قبلی (73:9)</a><a href=\"/fa/ayah/73-16.html\">آیهٔ بعدی (73:16)</a></div></main><footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/fa/\">صفحهٔ اصلی</a> · <a href=\"/about.html\">دربارهٔ پروژه</a> · <a href=\"/privacy.html\">حریم خصوصی و شرایط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/73-16.html":"<!doctype html>\n<html lang=\"fa\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>تفسیر المزمل 73:16 — از سخنان ابن تیمیه و ابن قیم</title>\n<meta name=\"description\" content=\"آنگاه فرعون از آن پیامبر نافرمانی [و با او مخالفت] کرد، و ما او را به شدّت مجازات کردیم.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/fa/ayah/73-16.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/73-16.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/73-16.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/73-16.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/73-16.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/73-16.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/73-16.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/73-16.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/73-16.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/73-16.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/73-16.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/73-16.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/73-16.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/73-16.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/73-16.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/73-16.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/73-16.html\">\n<meta property=\"og:title\" content=\"تفسیر المزمل 73:16 — از سخنان ابن تیمیه و ابن قیم\">\n<meta property=\"og:description\" content=\"آنگاه فرعون از آن پیامبر نافرمانی [و با او مخالفت] کرد، و ما او را به شدّت مجازات کردیم.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"صفحهٔ اصلی\", \"item\": \"https://tafsirshaikhain.com/fa/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سوره المزمل\", \"item\": \"https://tafsirshaikhain.com/fa/surah/73.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیه 16\", \"item\": \"https://tafsirshaikhain.com/fa/ayah/73-16.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/73.html\">سوره المزمل</a> › آیه 16</nav><h1>تفسیر سوره المزمل 73:16</h1><p class=\"vt ar\" lang=\"ar\">﴿فَعَصَىٰ فِرْعَوْنُ الرَّسُولَ فَأَخَذْنَاهُ أَخْذًا وَبِيلًا﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">آنگاه فرعون از آن پیامبر نافرمانی [و با او مخالفت] کرد، و ما او را به شدّت مجازات کردیم.</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>شیخ‌الاسلام ابن تیمیه</h2><blockquote class=\"ar\" lang=\"ar\">أن اللام هي أوجبت قصر الرسول على موسى لا نفس لفظ &quot; رسول &quot;.<cite>«مجموع الفتاوى» 11/144</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وذمه في غير موضع من القرآن من تولى؛ دليل على وجوب طاعة الله ورسوله وأن الأمر المطلق يقتضي وجوب الطاعة وذم المتولي عن الطاعة؛ كما علق الذم بمطلق المعصية في مثل قوله: {فعصى فرعون الرسول} .<cite>«مجموع الفتاوى» 7/60</cite></blockquote></section><section><h2>امام ابن قیم</h2><blockquote class=\"ar\" lang=\"ar\">فأخبر سبحانه أنه أرسل محمدا - صلى الله عليه وسلم - إلينا كما أرسل موسى إلى فرعون، وأن فرعون عصى رسوله فأخذه أخذا وبيلا<cite>«إعلام الموقعين عن رب العالمين» 1/107</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s73a16\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><a href=\"/fa/ayah/73-15.html\">آیهٔ قبلی (73:15)</a><a href=\"/fa/ayah/73-19.html\">آیهٔ بعدی (73:19)</a></div></main><footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/fa/\">صفحهٔ اصلی</a> · <a href=\"/about.html\">دربارهٔ پروژه</a> · <a href=\"/privacy.html\">حریم خصوصی و شرایط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/73-19.html":"<!doctype html>\n<html lang=\"fa\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>تفسیر المزمل 73:19 — از سخنان ابن تیمیه و ابن قیم</title>\n<meta name=\"description\" content=\"بی‌گمان، این [آیات،] پند [و هشداری] است تا هر کس بخواهد، به سوى پروردگار خود راهى در پیش گیرد.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/fa/ayah/73-19.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/73-19.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/73-19.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/73-19.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/73-19.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/73-19.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/73-19.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/73-19.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/73-19.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/73-19.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/73-19.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/73-19.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/73-19.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/73-19.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/73-19.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/73-19.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/73-19.html\">\n<meta property=\"og:title\" content=\"تفسیر المزمل 73:19 — از سخنان ابن تیمیه و ابن قیم\">\n<meta property=\"og:description\" content=\"بی‌گمان، این [آیات،] پند [و هشداری] است تا هر کس بخواهد، به سوى پروردگار خود راهى در پیش گیرد.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"صفحهٔ اصلی\", \"item\": \"https://tafsirshaikhain.com/fa/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سوره المزمل\", \"item\": \"https://tafsirshaikhain.com/fa/surah/73.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیه 19\", \"item\": \"https://tafsirshaikhain.com/fa/ayah/73-19.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/73.html\">سوره المزمل</a> › آیه 19</nav><h1>تفسیر سوره المزمل 73:19</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّ هَٰذِهِ تَذْكِرَةٌ فَمَن شَاءَ اتَّخَذَ إِلَىٰ رَبِّهِ سَبِيلًا﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">بی‌گمان، این [آیات،] پند [و هشداری] است تا هر کس بخواهد، به سوى پروردگار خود راهى در پیش گیرد.</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>شیخ‌الاسلام ابن تیمیه</h2><blockquote class=\"ar\" lang=\"ar\">والمراد به اتخاذ السبيل إلى عبادته وطاعته<cite>«درء تعارض العقل والنقل» 9/350</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s73a19\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><a href=\"/fa/ayah/73-16.html\">آیهٔ قبلی (73:16)</a></div></main><footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/fa/\">صفحهٔ اصلی</a> · <a href=\"/about.html\">دربارهٔ پروژه</a> · <a href=\"/privacy.html\">حریم خصوصی و شرایط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/73.html":"<!doctype html>\n<html lang=\"fa\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>تفسیر سوره المزمل — از سخنان ابن تیمیه و ابن قیم</title>\n<meta name=\"description\" content=\"تفسیر سوره المزمل — معانی قرآن در سخنان ابن تیمیه و ابن قیم\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/fa/surah/73.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/surah/73.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/surah/73.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/surah/73.html\">\n<link rel=\"alternate\" hreflang