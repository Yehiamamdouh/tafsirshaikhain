", \"item\": \"https://tafsirshaikhain.com/fa/ayah/103-3.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/103.html\">سوره العصر</a> › آیه 3</nav><h1>تفسیر سوره العصر 103:3</h1><p class=\"vt ar\" lang=\"ar\">﴿إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَتَوَاصَوْا بِالْحَقِّ وَتَوَاصَوْا بِالصَّبْرِ﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">مگر مؤمنان نیکوکاری که یکدیگر را به حق سفارش نموده‌اند و به شکیبایی توصیه کرده‌اند.</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>شیخ‌الاسلام ابن تیمیه</h2><blockquote class=\"ar\" lang=\"ar\">فإن الله تعالى أخبر أن جميع الناس خاسرون إلا من كان في نفسه مؤمنا صالحا؛ ومع غيره موصيا بالحق موصيا بالصبر.<cite>«مجموع الفتاوى» 28/152</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فالعلم النافع هو أصل الهدى والعمل بالحق هو الرشاد وضد الأول الضلال وضد الثاني الغي فالضلال العمل بغير علم والغي اتباع الهوى.<cite>«مجموع الفتاوى» 10/40</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فلا ينال الهدى إلا بالعلم ولا ينال الرشاد إلا بالصبر؛<cite>«مجموع الفتاوى» 10/40</cite></blockquote><h3>آنچه از دیگران نقل کرده است</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الإمام الشافعي</span> <span class=\"st\">أقرّه</span> «وروي عن الشافعي رضي الله عنه أنه قال: لو فكر الناس كلهم في سورة (والعصر لكفتهم.»<cite>«مجموع الفتاوى» 28/152</cite></blockquote></section><section><h2>امام ابن قیم</h2><blockquote class=\"ar\" lang=\"ar\">ولما كان الإنسان له قوتان قوة العلم وقوة العمل وله حالتان حالة يأتمر فيها بأمر غيره وحالة يأمر فيها غيره استثنى سبحانه من كمل قوته العلمية بالإيمان وقوته العملية بالعمل الصالح وإنقاد لأمر غيره له بذلك وأمر غيره به من الانسان الذي هو في خسر فإن العبد له حالتان حالة كمال في نفسه وحالة تكميل لغيره وكماله وتكميله موقوف على أمرين علم بالحق وصبر عليه فتضمنت الآية جميع مراتب الكمال الانساني من العلم النافع والعمل الصالح والاحسان إلى نفسه بذلك وإلى أخيه به وانقياده وقبوله لمن يأمره بذلك<cite>«التبيان في أقسام القرآن» 1/86</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فإن التواصي هو امر الغير بالإيمان والعمل الصالح وهو قدر زائد على مجرد فعله<cite>«التبيان في أقسام القرآن» 1/85</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s103a3\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><a href=\"/fa/ayah/103-2.html\">آیهٔ قبلی (103:2)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/103-3.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/103-3.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/103-3.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/103-3.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/1