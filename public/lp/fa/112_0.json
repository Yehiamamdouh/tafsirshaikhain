ef=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/112.html\">سوره الإخلاص</a> › آیه 4</nav><h1>تفسیر سوره الإخلاص 112:4</h1><p class=\"vt ar\" lang=\"ar\">﴿وَلَمْ يَكُن لَّهُ كُفُوًا أَحَدٌ﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">و هیچ کس همانند و همتای او نبوده و نیست».</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>شیخ‌الاسلام ابن تیمیه</h2><blockquote class=\"ar\" lang=\"ar\">&quot; الأحد &quot; يقتضي أنه لا مثل له ولا نظير<cite>«مجموع الفتاوى» 16/99</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">استعملها هنا في النفي أي ليس شيء من الأشياء كفوا له في شيء من الأشياء لأنه أحد.<cite>«مجموع الفتاوى» 17/238</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s112a4\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><a href=\"/fa/ayah/112-3.html\">آیهٔ قبلی (112:3)</a></div></main><footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/fa/\">صفحهٔ اصلی</a> · <a href=\"/about.html\">دربارهٔ پروژه</a> · <a href=\"/privacy.html\">حریم خصوصی و شرایط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/112.html":"<!doctype html>\n<html lang=\"