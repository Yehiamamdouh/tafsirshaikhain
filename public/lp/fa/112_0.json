l\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیه 2\", \"item\": \"https://tafsirshaikhain.com/fa/ayah/112-2.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/112.html\">سوره الإخلاص</a> › آیه 2</nav><h1>تفسیر سوره الإخلاص 112:2</h1><p class=\"vt ar\" lang=\"ar\">﴿اللَّهُ الصَّمَدُ﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">الله بی‌نیاز است [و همه نیازمند او هستند].</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>شیخ‌الاسلام ابن تیمیه</h2><blockquote class=\"ar\" lang=\"ar\">فأدخل اللام في الصمد ولم يدخلها في أحد؛ لأنه ليس في الموجودات ما يسمى أحدا في الإثبات مفردا غير مضاف إلا الله تعالى<cite>«مجموع الفتاوى» 17/235</cite></blockquote><h3>آنچه از دیگران نقل کرده است</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">حديث مرفوع (من رواية أبي بن كعب)</span> <span class=\"st\">استشهد به</span> «الصمد الذي لم يلد ولم يولد؛ لأنه ليس شيء يولد إلا سيموت وليس شيء يموت إلا سيورث»<cite>«مجموع الفتاوى» 17/216</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s112a2\">باز