\"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"شیخ‌الاسلام ابن تیمیه\"}, {\"@type\": \"Person\", \"name\": \"امام ابن قیم\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"جامع تفسیر الشیخین\", \"url\": \"https://tafsirshaikhain.com/fa/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"صفحهٔ اصلی\", \"item\": \"https://tafsirshaikhain.com/fa/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سوره سبإ\", \"item\": \"https://tafsirshaikhain.com/fa/surah/34.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیه 51\", \"item\": \"https://tafsirshaikhain.com/fa/ayah/34-51.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/34.html\">سوره سبإ</a> › آیه 51</nav><h1>تفسیر سوره سبإ 34:51</h1><p class=\"vt ar\" lang=\"ar\">﴿وَلَوْ تَرَىٰ إِذْ فَزِعُوا فَلَا فَوْتَ وَأُخِذُوا مِن مَّكَانٍ قَرِيبٍ﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">[ای پیامبر!] اگر ببینی هنگامی را که [کافران از مشاهدۀ عذاب] وحشت‌زده می‌شوند و [هیچ راهِ] گریزی نیست و آنان را از جای نزدیکی [که انتظارش را ندارند] دستگیر می‌کنند.</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>شیخ‌الاسلام ابن تیمیه</h2><blockquote class=\"ar\" lang=\"ar\">وهو سبحانه يذكر جواب القسم تارة وهو الغالب. وتارة يحذفه كما يحذف جواب لو كثيرا كقوله تعالى: {لو تعلمون علم اليقين} وقوله: {ولو أن قرآنا سيرت به الجبال} {ولو ترى إذ يتوفى الذين كفروا الملائكة} {ولو ترى إذ فزعوا فلا فوت} {ولو ترى إذ وقفوا على النار} {ولو ترى إذ وقفوا على ربهم} . ومثل هذا حذفه من أحسن الكلام؛ لأن المراد أنك لو رأيته لرأيت هولا عظيما<cite>«مجموع الفتاوى» 13/315</cite></blockquote></section><section><h2>امام ابن قیم</h2><blockquote class=\"ar\" lang=\"ar\">قوله تعالى {ولو يرى الذين ظلموا إذ يرون العذاب أن القوة لله جميعا وأن الله شديد العذاب} فالمعنى في أظهر الوجهين لو يرى الذين ظلموا في الدنيا إذ يرون العذاب في الآخرة والجواب محذوف ثم قال {أن القوة لله جميعا} كما قال تعالى {ولو ترى إذ فزعوا فلا فوت} {ولو ترى إذ يتوفى الذين كفروا الملائكة} أي لو ترى ذلك الوقت وما فيه<cite>«التبيان في أقسام القرآن» 1/3</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s34a51\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><a href=\"/fa/ayah/34-50.html\">آیهٔ قبلی (34:50)</a><a href=\"/fa/ayah/34-54.html\">آیهٔ بعدی (34:54)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/34-51.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/34-51.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/34-51.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو<