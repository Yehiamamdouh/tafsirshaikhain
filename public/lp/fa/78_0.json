tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"صفحهٔ اصلی\", \"item\": \"https://tafsirshaikhain.com/fa/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سوره النبإ\", \"item\": \"https://tafsirshaikhain.com/fa/surah/78.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیه 24\", \"item\": \"https://tafsirshaikhain.com/fa/ayah/78-24.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/78.html\">سوره النبإ</a> › آیه 24</nav><h1>تفسیر سوره النبإ 78:24</h1><p class=\"vt ar\" lang=\"ar\">﴿لَّا يَذُوقُونَ فِيهَا بَرْدًا وَلَا شَرَابًا﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">در آنجا نه [چیز] خنکی می‌چشند و نه آشامیدنی [گوارایی خواهند داشت].</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>شیخ‌الاسلام ابن تیمیه</h2><blockquote class=\"ar\" lang=\"ar\">أي لا يحصل لهم من ذلك ولا ذوق.<cite>«مجموع الفتاوى» 7/111</cite></blockquote></section><section><h2>امام ابن قیم</h2><blockquote class=\"ar\" lang=\"ar\">فإن الحميم والغساق داخل في جنس الذوق المنقسم<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/325</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وفي الثاني: لا يذوقون فيها شيئا إلا حميما وغساقا، ونص على فرد من أفراد الجنس تصريحا، ليكون نفيه بطريق التصريح والتنصيص، لا بطريق العموم الذي يتطرق إليه تخصيص هذا الفرد،<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/325</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s78a24\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><a href=\"/fa/ayah/78-23.html\">آیهٔ قبلی (78:23)</a><a href=\"/fa/ayah/78-25.html\">آیهٔ بعدی (78:25)</a></div></main><footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/fa/\">صفحهٔ اصلی</a> · <a href=\"/about.html\">دربارهٔ پروژه</a> · <a href=\"/privacy.html\">حریم خصوصی و شرایط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/78-25.html":"<!doctype html>\n<html lang=\"fa\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>تفسیر النبإ 78:25 — از سخنان ابن تیمیه و ابن قیم</title>\n<meta name=\"description\" content=\"جز آبی سوزان و [مایعی که] چرک و خون [جهنمیان است].\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/fa/ayah/78-25.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/78-25.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/78-25.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/78-25.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/78-25.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/78-25.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/78-25.html\">\n<link rel=\"alternate\"