\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/78.html\">سوره النبإ</a> › آیه 25</nav><h1>تفسیر سوره النبإ 78:25</h1><p class=\"vt ar\" lang=\"ar\">﴿إِلَّا حَمِيمًا وَغَسَّاقًا﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">جز آبی سوزان و [مایعی که] چرک و خون [جهنمیان است].</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>امام ابن قیم</h2><blockquote class=\"ar\" lang=\"ar\">فإن الحميم والغساق داخل في جنس الذوق المنقسم، فكأنه قيل في الأول: لا يسمعون فيها شيئا إلا سلاما، وفي الثاني: لا يذوقون فيها شيئا إلا حميما وغساقا<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/325</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s78a25\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><a href=\"/fa/ayah/78-24.html\">آیهٔ قبلی (78:24)</a><a href=\"/fa/ayah/78-37.html\">آیهٔ بعدی (78:37)</a></div></main><footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/fa/\">صفحهٔ اصلی</a> · <a href=\"/about.html\">دربارهٔ پروژه</a> · <a href=\"/privacy.html\">حریم خصوصی و شرایط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/78-37.html":"<!doctype html>\n<html lang=\"fa\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-sca