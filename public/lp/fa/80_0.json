e\" content=\"تفسیر عبس 80:3 — از سخنان ابن تیمیه و ابن قیم\">\n<meta property=\"og:description\" content=\"و [ای پیامبر،] تو چه می‌دانی؟ چه بسا او [از گناهانش] پاک ‌شود،\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"صفحهٔ اصلی\", \"item\": \"https://tafsirshaikhain.com/fa/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سوره عبس\", \"item\": \"https://tafsirshaikhain.com/fa/surah/80.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیه 3\", \"item\": \"https://tafsirshaikhain.com/fa/ayah/80-3.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/80.html\">سوره عبس</a> › آیه 3</nav><h1>تفسیر سوره عبس 80:3</h1><p class=\"vt ar\" lang=\"ar\">﴿وَمَا يُدْرِيكَ لَعَلَّهُ يَزَّكَّىٰ﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">و [ای پیامبر،] تو چه می‌دانی؟ چه بسا او [از گناهانش] پاک ‌شود،</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>شیخ‌الاسلام ابن تیمیه</h2><blockquote class=\"ar\" lang=\"ar\">فالتزكية وإن كان أصلها النماء والبركة وزيادة الخير فإنما تحصل بإزالة الشر؛ فلهذا صار التزكي يجمع هذا وهذا.<cite>«مجموع الفتاوى» 10/97</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s80a3\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><span></span><a href=\"/fa/ayah/80-4.html\">آیهٔ بعدی (80:4)</a></div></main><footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/fa/\">صفحهٔ اصلی</a> · <a href=\"/about.html\">دربارهٔ پروژه</a> · <a href=\"/privacy.html\">حریم خصوصی و شرایط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/80-4.html":"<!doctype html>\n<html lang=\"fa\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>تفسیر عبس 80:4 — از سخنان ابن تیمیه و ابن قیم</title>\n<meta name=\"description\" content=\"یا پند گیرد و این پند به سودش باشد.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/fa/ayah/80-4.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/80-4.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/80-4.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/80-4.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/80-4.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/80-4.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/80-4.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/80-4.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/80-4.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/80-4.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/80-4.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/80-4.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/80-4.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/80-4.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/80-4.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/80-4.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/80-4.html\">\n<meta property=\"og:title\" content=\"تفسیر عبس 80:4 — از سخنان ابن تیمیه و ابن قیم\">\n<meta property=\"og:description\" content=\"یا پند گیرد و این پند به سودش باشد.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"صفحهٔ اصلی\", \"item\": \"https://tafsirshaikhain.com/fa/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سوره عبس\", \"item\": \"https://tafsirshaikhain.com/fa/surah/80.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیه 4\", \"item\": \"https://tafsirshaikhain.com/fa/ayah/80-4.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fa/\">صفحهٔ اصلی</a> › <a href=\"/fa/surah/80.html\">سوره عبس</a> › آیه 4</nav><h1>تفسیر سوره عبس 80:4</h1><p class=\"vt ar\" lang=\"ar\">﴿أَوْ يَذَّكَّرُ فَتَنفَعَهُ الذِّكْرَىٰ﴾</p><section><h3>ترجمهٔ معانی</h3><p class=\"tr\">یا پند گیرد و این پند به سودش باشد.</p><span class=\"cr\" dir=\"ltr\">Persian Translation - Rowwad Translation Center — v1.1.3 · QuranEnc.com</span></section><p class=\"cr\">سخنان دو امام به همان عربی اصلی، کلمه به کلمه و همراه با منبع آمده است.</p><section><h2>شیخ‌الاسلام ابن تیمیه</h2><blockquote class=\"ar\" lang=\"ar\">وكذلك التزكي عام لكل من آمن بالرسول وأما التذكر فهو مختص لمن له علوم يذكرها فعرف بتذكره ما لم يعلمه غيره من تلقاء نفسه.<cite>«مجموع الفتاوى» 16/185</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">الوجه الثاني: أن قوله {أو يذكر فتنفعه الذكرى} يدخل فيه النفع قليله وكثيره والتزكي أخص من ذلك. الثالث: أن التذكر سبب التزكي. فإنه إذا تذكر خاف ورجا فتزكى.<cite>«مجموع الفتاوى» 16/185</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">والنفع نوعان: حصول النعمة واندفاع النقمة. ونفس اندفاع النقمة نفع وإن لم يحصل معه نفع آخر ونفس المنافع التي يخاف معها عذاب نفع وكلاهما نفع.<cite>«مجموع الفتاوى» 16/184</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fa#s80a4\">باز کردن در تفسیر تعاملی (متن کامل)</a><div class=\"pn\"><a href=\"/fa/ayah/80-3.html\">آیهٔ قبلی (80:3)</a><a href=\"/fa/ayah/80-7.html\">آیهٔ بعدی (80:7)</a></div></main><footer class=\"site-foot\"><span>جامع تفسیر الشیخین · <a href=\"/fa/\">صفحهٔ اصلی</a> · <a href=\"/about.html\">دربارهٔ پروژه</a> · <a href=\"/privacy.html\">حریم خصوصی و شرایط</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/80-7.html":"<!doctype html>\n<