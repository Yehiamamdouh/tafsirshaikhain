tem\", \"position\": 2, \"name\": \"سوورەتی العصر\", \"item\": \"https://tafsirshaikhain.com/ku/surah/103.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"ئایەت 3\", \"item\": \"https://tafsirshaikhain.com/ku/ayah/103-3.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ku/\">سەرەکی</a> › <a href=\"/ku/surah/103.html\">سوورەتی العصر</a> › ئایەت 3</nav><h1>تەفسیری سوورەتی العصر 103:3</h1><p class=\"vt ar\" lang=\"ar\">﴿إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَتَوَاصَوْا بِالْحَقِّ وَتَوَاصَوْا بِالصَّبْرِ﴾</p><section><h3>وەرگێڕانی واتا</h3><p class=\"tr\">جگە لەوانەی کە بڕوایان ھێنابێت وکردەوە چاکەکانیان کردبێت وە ئامۆژگاریی یەکتریان کردبێ بە ئاینی ڕاست (ودەست پێوەگرتنی، وکارکردن بەفەرمانەکانی خوا) وە ئامۆژگاری یەکتریان کردبێت بە ئارامگرتن (لەسەر پەرستن وبەندایەتی خوا)</p><span class=\"cr\" dir=\"ltr\">Kurdish Translation - Muhammad Salih Bamoki — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">وتەکانی هەردوو ئیمام بە عەرەبیی ڕەسەن، وەک خۆی، لەگەڵ سەرچاوەکان هێنراون.</p><section><h2>شێخولئیسلام ئیبن تەیمییە</h2><blockquote class=\"ar\" lang=\"ar\">فإن الله تعالى أخبر أن جميع الناس خاسرون إلا من كان في نفسه مؤمنا صالحا؛ ومع غيره موصيا بالحق موصيا بالصبر.<cite>«مجموع الفتاوى» 28/151</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فالعلم النافع هو أصل الهدى والعمل بالحق هو الرشاد وضد الأول الضلال وضد الثاني الغي فالضلال العمل بغير علم والغي اتباع الهوى.<cite>«مجموع الفتاوى» 10/40</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فلا ينال الهدى إلا بالعلم ولا ينال الرشاد إلا بالصبر؛<cite>«مجموع الفتاوى» 10/40</cite></blockquote><h3>ئەوەی لە کەسانی ترەوە گواستوویەتییەوە</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الإمام الشافعي</span> <span class=\"st\">أقرّه</span> «وروي عن الشافعي رضي الله عنه أنه قال: لو فكر الناس كلهم في سورة (والعصر لكفتهم.»<cite>«مجموع الفتاوى» 28/151</cite></blockquote></section><section><h2>ئیمام ئیبنولقەییم</h2><blockquote class=\"ar\" lang=\"ar\">ولما كان الإنسان له قوتان قوة العلم وقوة العمل وله حالتان حالة يأتمر فيها بأمر غيره وحالة يأمر فيها غيره استثنى سبحانه من كمل قوته العلمية بالإيمان وقوته العملية بالعمل الصالح وإنقاد لأمر غيره له بذلك وأمر غيره به من الانسان الذي هو في خسر فإن العبد له حالتان حالة كمال في نفسه وحالة تكميل لغيره وكماله وتكميله موقوف على أمرين علم بالحق وصبر عليه فتضمنت الآية جميع مراتب الكمال الانساني من العلم النافع والعمل الصالح والاحسان إلى نفسه بذلك وإلى أخيه به وانقياده وقبوله لمن يأمره بذلك<cite>«التبيان في أقسام القرآن» 1/86</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فإن التواصي هو امر الغير بالإيمان والعمل الصالح وهو قدر زائد على مجرد فعله<cite>«التبيان في أقسام القرآن» 1/85</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ku#s103a3\">لە تەفسیرە کارلێککەرەکەدا بیکەرەوە (دەقە تەواوەکان)</a><div class=\"pn\"><a href=\"/ku/ayah/103-2.html\">ئایەتی پێشوو (103:2)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/103-3.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/103-3.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/103-3.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/103-3.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/103-3.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/103-3.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/103-3.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/103-3.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/103-3.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/103-3.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/103-3.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/103-3.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/103-3.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/103-3.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/103-3.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a> · <a href=\"/hi/ayah/103-3.html\" hreflang=\"hi\" lang=\"hi\" data-l=\"hi\">हिन्दी</a> · <a href=\"/ps/ayah/103-3.html\" hreflang=\"ps\" lang=\"ps\" data-l=\"ps\">پښتو</a> · <a href=\"/so/ayah/103-3.html\" hreflang=\"so\" lang=\"so\" data-l=\"so\">Soomaali</a> · <a href=\"/uz/ayah/103-3.html\" hreflang=\"uz\" lang=\"uz\" data-l=\"uz\">Ўзбекча</a> · <b lang=\"ku\">کوردی</b> · <a href=\"/az/ayah/103-3.html\" hreflang=\"az\" lang=\"az\" data-l=\"az\">Azərbaycanca</a> · <a href=\"/bs/ayah/103-3.html\" hreflang=\"bs\" lang=\"bs\" data-l=\"bs\">Bosanski</a> · <a href=\"/sq/ayah/103-3.html\" hreflang=\"sq\" lang=\"sq\" data-l=\"sq\">Shqip</a> · <a href=\"/ta/ayah/103-3.html\" hreflang=\"ta\" lang=\"t