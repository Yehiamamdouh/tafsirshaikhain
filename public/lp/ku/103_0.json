ication/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"تەفسیری العصر 103:2 — بەپێی ئیبن تەیمییە و ئیبنولقەییم\", \"description\": \"بێگومان ھەموو خەڵکی لە زیاندان\", \"inLanguage\": \"ku\", \"url\": \"https://tafsirshaikhain.com/ku/ayah/103-2.html\", \"mainEntityOfPage\": \"https://tafsirshaikhain.com/ku/ayah/103-2.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"شێخولئیسلام ئیبن تەیمییە\"}, {\"@type\": \"Person\", \"name\": \"ئیمام ئیبنولقەییم\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"تەفسیری هەردوو شێخ\", \"url\": \"https://tafsirshaikhain.com/ku/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"سەرەکی\", \"item\": \"https://tafsirshaikhain.com/ku/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سوورەتی العصر\", \"item\": \"https://tafsirshaikhain.com/ku/surah/103.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"ئایەت 2\", \"item\": \"https://tafsirshaikhain.com/ku/ayah/103-2.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ku/\">سەرەکی</a> › <a href=\"/ku/surah/103.html\">سوورەتی العصر</a> › ئایەت 2</nav><h1>تەفسیری سوورەتی العصر 103:2</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّ الْإِنسَانَ لَفِي خُسْرٍ﴾</p><section><h3>وەرگێڕانی واتا</h3><p class=\"tr\">بێگومان ھەموو خەڵکی لە زیاندان</p><span class=\"cr\" dir=\"ltr\">Kurdish Translation - Muhammad Salih Bamoki — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">وتەکانی هەردوو ئیمام بە عەرەبیی ڕەسەن، وەک خۆی، لەگەڵ سەرچاوەکان هێنراون.</p><section><h2>شێخولئیسلام ئیبن تەیمییە</h2><blockquote class=\"ar\" lang=\"ar\">فإن الله تعالى أخبر أن جميع الناس خاسرون إلا من كان في نفسه مؤمنا صالحا؛ ومع غيره موصيا بالحق موصيا بالصبر.<cite>«مجموع الفتاوى» 28/151</cite></blockquote></section><section><h2>ئیمام ئیبنولقەییم</h2><blockquote class=\"ar\" lang=\"ar\">وتأمل حكمة القرآن لما قال {إن الإنسان لفي خسر} فإنه ضيق الاستثناء وخصصه فقال {إلا الذين آمنوا وعملوا الصالحات وتواصوا بالحق وتواصوا بالصبر}<cite>«التبيان في أقسام القرآن» 1/85</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فمطلق الخسار شيء والخسار المطلق شيء وهو سبحانه إنما قال {إن الإنسان لفي خسر} ومن ربح في سلعة وخسر في غيرها قد يطلق عليه أنه في خسر وأنه ذو خسر<cite>«التبيان في أقسام القرآن» 1/86</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ku#s103a2\">لە تەفسیرە کارلێککەرەکەدا بیکەرەوە (دەقە تەواوەکان)</a><div class=\"pn\"><a href=\"/ku/ayah/103-1.html\">ئایەتی پێشوو (103:1)</a><a href=\"/ku/ayah/103-3.html\">ئایەتی دواتر (103:3)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/103-2.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/103-2.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href