k);padding:20px 16px 48px;line-height:1.6}.muy{display:grid;gap:6px;background:var(--sheet,#fff);border:1px dashed var(--line,#d9dee6);border-inline-start:4px solid var(--muted,#5b6676);border-radius:10px;padding:12px 14px;margin:4px 0}.muy-head{display:flex;flex-wrap:wrap;gap:4px 10px;align-items:baseline}.muy-head b{font-family:var(--f-display,sans-serif);font-weight:600;font-size:15px}.muy-head small{font-size:12.5px;color:var(--muted,#5b6676)}.muy-text{margin:0;font-family:var(--f-read,serif);font-size:17px;line-height:1.95;overflow-wrap:anywhere}.muy-fn{margin:0;font-size:14px;line-height:1.7;color:var(--muted,#5b6676);white-space:pre-line}.muy-credit{font-size:12px;color:var(--muted,#5b6676);overflow-wrap:anywhere}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/uz/\">Бош саҳифа</a> › <a href=\"/uz/surah/41.html\">Сура Fussilat</a> › Оят 51</nav><h1>Тафсир: Сура Fussilat 41:51</h1><p class=\"vt ar\" lang=\"ar\">﴿وَإِذَا أَنْعَمْنَا عَلَى الْإِنسَانِ أَعْرَضَ وَنَأَىٰ بِجَانِبِهِ وَإِذَا مَسَّهُ الشَّرُّ فَذُو دُعَاءٍ عَرِيضٍ﴾</p><section><h3>Маъно таржимаси</h3><p class=\"tr\">Қачон инсонга неъмат ато этсак, юз ўгириб, ўз тарафига кетади. Қачон ёмонликка йўлиқса, узундан-узоқ дуо қилиб қоладиган бўлади.</p><span class=\"cr\" dir=\"ltr\">Uzbek Translation - Rowwad Translation Center — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">Икки имомнинг сўзлари манбалари билан асл араб тилида, айнан келтирилади.</p><section><h2>Шайхулислом Ибн Таймия</h2><blockquote class=\"ar\" lang=\"ar\">وحزب يتضرعون إليه في حال الضراء. ويتوبون إليه. فإذا كشفها عنهم: أعرضوا عنه كما قال تعالى {وإذا مس الإنسان الضر دعانا لجنبه أو قاعدا أو قائما فلما كشفنا عنه ضره مر كأن لم يدعنا إلى ضر مسه كذلك زين للمسرفين ما كانوا يعملون} وقال تعالى {وإذا أنعمنا على الإنسان أعرض ونأى بجانبه وإذا مسه الشر فذو دعاء عريض}<cite>«مجموع الفتاوى» 14/371</cite></blockquote></section><div class=\"muy\"><div class=\"muy-head\"><b>Ал-Мухтасар фий тафсийрил Қуръанил Карийм</b><small>Оятнинг умумий маъноси — икки шайхнинг сўзи эмас</small></div><p class=\"muy-text\">Агар инсонга соғлик, тинчлик-омонлик каби неъматларни ато этсак, Аллоҳни эслаш ва Унга тоат-ибодат қилишни унутиб, такаббурлик билан юз ўгириб кетади. Агар касаллик, камбағаллик каби мусибатларга йўлиқса, Аллоҳга кўп-кўп дуо қиладиган бўлиб қолади. Хуллас, на неъматга шукр қилади ва на балога сабр.</p><a class=\"muy-credit\" href=\"https://quranenc.com/en/browse/uzbek_mokhtasar\" target=\"_blank\" rel=\"noopener\" dir=\"ltr\">Uzbek Translation of Al-Mukhtasar in Interpreting the Noble Quran — 2026-11-04 · QuranEnc.com</a></div><a class=\"btn pri open\" href=\"/tafsir.html?lang=uz#s41a51\">Интерактив тафсирда очиш (тўлиқ матнлар)</a><div class=\"pn\"><a href=\"/uz/ayah/41-50.html\">Олдинги оят (41:50)</a><a href=\"/uz/ayah/41-53.html\">Кейинги оят (41:53)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/41-51.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/41-51.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/41-51.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/41-51.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/41-51.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/41-51.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a h