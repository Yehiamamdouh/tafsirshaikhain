ps://tafsirshaikhain.com/bs/ayah/34-50.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"Šejhul-islam Ibn Tejmijje\"}, {\"@type\": \"Person\", \"name\": \"Imam Ibn el-Kajjim\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"Tefsir dvojice šejhova\", \"url\": \"https://tafsirshaikhain.com/bs/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Početna\", \"item\": \"https://tafsirshaikhain.com/bs/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Saba\", \"item\": \"https://tafsirshaikhain.com/bs/surah/34.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ajet 50\", \"item\": \"https://tafsirshaikhain.com/bs/ayah/34-50.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.muy{display:grid;gap:6px;background:var(--sheet,#fff);border:1px dashed var(--line,#d9dee6);border-inline-start:4px solid var(--muted,#5b6676);border-radius:10px;padding:12px 14px;margin:4px 0}.muy-head{display:flex;flex-wrap:wrap;gap:4px 10px;align-items:baseline}.muy-head b{font-family:var(--f-display,sans-serif);font-weight:600;font-size:15px}.muy-head small{font-size:12.5px;color:var(--muted,#5b6676)}.muy-text{margin:0;font-family:var(--f-read,serif);font-size:17px;line-height:1.95;overflow-wrap:anywhere}.muy-fn{margin:0;font-size:14px;line-height:1.7;color:var(--muted,#5b6676);white-space:pre-line}.muy-credit{font-size:12px;color:var(--muted,#5b6676);overflow-wrap:anywhere}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bs/\">Početna</a> › <a href=\"/bs/surah/34.html\">Sura Saba</a> › Ajet 50</nav><h1>Tefsir Sura Saba 34:50</h1><p class=\"vt ar\" lang=\"ar\">﴿قُلْ إِن ضَلَلْتُ فَإِنَّمَا أَضِلُّ عَلَىٰ نَفْسِي وَإِنِ اهْتَدَيْتُ فَبِمَا يُوحِي إِلَيَّ رَبِّي إِنَّهُ سَمِيعٌ قَرِيبٌ﴾</p><section><h3>Prijevod značenja</h3><p class=\"tr\">Reci: “Ako zalutam, zalutao sam na svoju štetu. A ako sam na Pravom putu, to je zbog onog što mi Gospodar moj objavljuje; On zaista sve čuje i blizu je.”</p><span class=\"cr\" dir=\"ltr\">Bosnian Translation - Rowwad Translation Centre — v2.0.4 · QuranEnc.com</span></section><p class=\"cr\">Riječi dvojice imama navedene su na izvornom arapskom, doslovno, s izvorima.</p><section><h2>Šejhul-islam Ibn Tejmijje</h2><blockquote class=\"ar\" lang=\"ar\">فما أوحاه الله إليه يهدي الله به من يشاء من عباده، كما أنه صلى الله عليه وسلم بذلك هداه الله تعالى كما قال تعالى: {قل إن ضللت فإنما أضل على نفسي وإن اهتديت فبما يوحي إلي ربي} .<cite>«مجموع الفتاوى» 1/5</cite></blockquote></section><section><h2>Imam Ibn el-Kajjim</h2><blockquote class=\"ar\" lang=\"ar\">وقال تعالى لرسوله صلى الله عليه وسلم: {قل إن ضللت فإنما أضل على نفسي وإن اهتديت فبما يوحي إلي ربي إنه سميع قريب} فهذا نص صريح في أن هدي الرسول صلى الله عليه وسلم إنما يحصل بالوحي، فيا عجبا! كيف يحصل الهدى لغيره من الآراء والعقول المختلفة والأقوال المضطربة؟!<cite>«الرسالة التبوكية = زاد المهاجر إلى ربه» 1/45</cite></blockquote><h3>Šta je prenio od drugih</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">نفاة القياس</span> <span class=\"st\">حكاه</span> «فلو كان القياس هدى لم ينحصر الهدى في الوحي،»<cite>«إعلام الموقعين عن رب العالمين» 1/174</cite></blockquote></section><div class=\"muy\"><div class=\"muy-head\"><b>El-Muhtesar fi tefsiril-Kur&#x27;anil-Kerim</b><small>Opće značenje ajeta — nisu riječi dvojice šejhova</small></div><p class=\"muy-text\">Poslaniče, reci poricateljima mnogobošcima: “Ako zastranim, zastranio sam na svoju štetu, vas zbog toga nikakvo zlo neće stići; ako sam se naputio i pošao Pravom stazom – to je zbog časnog Kur’ana, koji mi Allah objavljuje. Moj Gospodar savršeno čuje sve riječi, On je bliski, i čuje ovo što govorim.”</p><a class=\"muy-credit\" href=\"https://quranenc.com/en/browse/bosnian_mokhtasar\" target=\"_blank\" rel=\"noopener\" dir=\"ltr\">Bosnian Translation of Al-Mukhtasar in Interpreting the Noble Quran — 2026-11-04 · QuranEnc.com</a></div><a class=\"btn pri open\" href=\"/tafsir.html?lang=bs#s34a50\">Otvori u interaktivnom tefsiru (puni tekstovi)</a><div class=\"pn\"><a href=\"/bs/ayah/34-47.html\">Prethodni ajet (34:47)</a><a href=\"/bs/ayah/34-51.html\">Sljedeći ajet (34:51)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/34-50.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/34-50.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/34-50.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/34-50.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/34-50.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/34-50.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/34-50.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/34-50.html\" hreflang