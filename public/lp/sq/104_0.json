-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/sq/\">Kreu</a> › <a href=\"/sq/surah/104.html\">Surja Al-Humaza</a> › Ajeti 2</nav><h1>Tefsiri i Surja Al-Humaza 104:2</h1><p class=\"vt ar\" lang=\"ar\">﴿الَّذِي جَمَعَ مَالًا وَعَدَّدَهُ﴾</p><section><h3>Përkthimi i kuptimit</h3><p class=\"tr\">i cili grumbullon pasuri dhe e numëron atë,</p><span class=\"cr\" dir=\"ltr\">Albanian Translation - Rowwad Translation Center — v1.0.5 · QuranEnc.com</span></section><p class=\"cr\">Fjalët e dy imamëve jepen në arabishten origjinale, fjalë për fjalë, me burimet.</p><section><h2>Shejhul-Islam Ibn Tejmije</h2><blockquote class=\"ar\" lang=\"ar\">وقوله: {الذي جمع مالا وعدده} وصفه بالطعن في الناس والعيب لهم وبجمع المال وتعديده وهذا نظير قوله: {والله لا يحب كل مختال فخور} {الذين يبخلون} في &quot; الحديد &quot; ونظيرها في المعنى في &quot; النساء &quot; فإن الهمزة اللمزة يشبه المختال الفخور والجماع المحصي نظير البخيل.<cite>«مجموع الفتاوى» 16/522</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وذلك ناشئ عن حب الشرف والمال فإن محبة الشرف تحمل على انتقاص غيره بالهمز واللمز والفخر والخيلاء ومحبة المال تحمل على البخل<cite>«مجموع الفتاوى» 16/522</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=sq#s104a2\">Hape në tefsirin interaktiv (tekstet e plota)</a><div class=\"pn\"><a href=\"/sq/ayah/104-1.html\">Ajeti i mëparshëm (104:1)</a><a href=\"/sq/ayah/104-8.html\">Ajeti tjetër (104:8)</a></div><