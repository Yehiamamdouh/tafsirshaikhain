ttps://tafsirshaikhain.com/og.png\">\n<meta property=\"og:image:width\" content=\"1200\">\n<meta property=\"og:image:height\" content=\"630\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<link rel=\"manifest\" href=\"/manifest.webmanifest\">\n<link rel=\"apple-touch-icon\" href=\"/icon-192.png\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"Tefsiri i Saba 34:50 — sipas Ibn Tejmijes dhe Ibn el-Kajimit\", \"description\": \"Thuaj: \\\"Nëse unë shmangem nga rruga e drejtë, shmangia ime është në dëm timin, por, nëse jam i udhëzuar, kjo është për shkak të asaj që më shpall Zoti im. \", \"inLanguage\": \"sq\", \"url\": \"https://tafsirshaikhain.com/sq/ayah/34-50.html\", \"mainEntityOfPage\": \"https://tafsirshaikhain.com/sq/ayah/34-50.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"Shejhul-Islam Ibn Tejmije\"}, {\"@type\": \"Person\", \"name\": \"Imam Ibn el-Kajim\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"Tefsiri i dy shejhëve\", \"url\": \"https://tafsirshaikhain.com/sq/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Kreu\", \"item\": \"https://tafsirshaikhain.com/sq/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surja Saba\", \"item\": \"https://tafsirshaikhain.com/sq/surah/34.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ajeti 50\", \"item\": \"https://tafsirshaikhain.com/sq/ayah/34-50.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/sq/\">Kreu</a> › <a href=\"/sq/surah/34.html\">Surja Saba</a> › Ajeti 50</nav><h1>Tefsiri i Surja Saba 34:50</h1><p class=\"vt ar\" lang=\"ar\">﴿قُلْ إِن ضَلَلْتُ فَإِنَّمَا أَضِلُّ عَلَىٰ نَفْسِي وَإِنِ اهْتَدَيْتُ فَبِمَا يُوحِي إِلَيَّ رَبِّي إِنَّهُ سَمِيعٌ قَرِيبٌ﴾</p><section><h3>Përkthimi i kuptimit</h3><p class=\"tr\">Thuaj: &quot;Nëse unë shmangem nga rruga e drejtë, shmangia ime është në dëm timin, por, nëse jam i udhëzuar, kjo është për shkak të asaj që më shpall Zoti im. Ai, me të vërtetë, dëgjon çdo gjë dhe është afër.&quot;</p><span class=\"cr\" dir=\"ltr\">Albanian Translation - Rowwad Translation Center — v1.0.5 · QuranEnc.com</span></section><p class=\"cr\">Fjalët e dy imamëve jepen në arabishten origjinale, fjalë për fjalë, me burimet.</p><section><h2>Shejhul-Islam Ibn Tejmije</h2><blockquote class=\"ar\" lang=\"ar\">فما أوحاه الله إليه يهدي الله به من يشاء من عباده، كما أنه صلى الله عليه وسلم بذلك هداه الله تعالى كما قال تعالى: {قل إن ضللت فإنما أضل على نفسي وإن اهتديت فبما يوحي إلي ربي} .<cite>«مجموع الفتاوى» 1/5</cite></blockquote></section><section><h2>Imam Ibn el-Kajim</h2><blockquote class=\"ar\" lang=\"ar\">وقال تعالى لرسوله صلى الله عليه وسلم: {قل إن ضللت فإنما أضل على نفسي وإن اهتديت فبما يوحي إلي ربي إنه سميع قريب} فهذا نص صريح في أن هدي الرسول صلى الله عليه وسلم إنما يحصل بالوحي، فيا عجبا! كيف يحصل الهدى لغيره من الآراء والعقول المختلفة والأقوال المضطربة؟!<cite>«الرسالة التبوكية = زاد المهاجر إلى ربه» 1/45</cite></blockquote><h3>Çfarë ka përcjellë nga të tjerët</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">نفاة القياس</span> <span class=\"st\">حكاه</span> «فلو كان القياس هدى لم ينحصر الهدى في الوحي،»<cite>«إعلام الموقعين عن رب العالمين» 1/174</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=sq#s34a50\">Hape në tefsirin interaktiv (tekstet e plota)</a><div class=\"pn\"><a href=\"/sq/ayah/34-47.html\">Ajeti i mëparshëm (34:47)</a><a href=\"/sq/ayah/34-51.html\">Ajeti tjetër (34:51)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/34-50.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/34-50.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/34-50.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/34-50.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/34-50.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/34-50.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/34-50.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/34-50.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/34-50.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/34-50.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/34-50.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/34-50.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/34-50.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/34-50.html\" hreflang=\"de\" la