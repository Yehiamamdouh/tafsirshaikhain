emListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Kreu\", \"item\": \"https://tafsirshaikhain.com/sq/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surja Saba\", \"item\": \"https://tafsirshaikhain.com/sq/surah/34.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ajeti 54\", \"item\": \"https://tafsirshaikhain.com/sq/ayah/34-54.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/sq/\">Kreu</a> › <a href=\"/sq/surah/34.html\">Surja Saba</a> › Ajeti 54</nav><h1>Tefsiri i Surja Saba 34:54</h1><p class=\"vt ar\" lang=\"ar\">﴿وَحِيلَ بَيْنَهُمْ وَبَيْنَ مَا يَشْتَهُونَ كَمَا فُعِلَ بِأَشْيَاعِهِم مِّن قَبْلُ إِنَّهُمْ كَانُوا فِي شَكٍّ مُّرِيبٍ﴾</p><section><h3>Përkthimi i kuptimit</h3><p class=\"tr\">Një pengesë do të vihet mes tyre dhe asaj që dëshirojnë, siç ndodhi me të ngjashmit e tyre më parë. Njëmend, ata ishin në mëdyshje të madhe.</p><span class=\"cr\" dir=\"ltr\">Albanian Translation - Rowwad Translation Center — v1.0.5 · QuranEnc.com</span></section><p class=\"cr\">Fjalët e dy imamëve jepen në arabishten origjinale, fjalë për fjalë, me burimet.</p><section><h2>Imam Ibn el-Kajim</h2><blockquote class=\"ar\" lang=\"ar\">ولهذا جعل الله سبحانه وتعالى مفارقة المشتهيات من أعظم العقوبات، فقال تعالى: {وحيل بينهم وبين ما يشتهون - كما فعل بأشياعهم من قبل إنهم كانوا في شك مريب} [سبأ: 54]<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 3/178</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=sq#s34a54\">Hape në tefsirin interaktiv (tekstet e plota)</a><div class=\"pn\"><a href=\"/sq/ayah/34-51.html\">Ajeti i mëparshëm (34:51)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/34-54.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/34-54.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/34-54.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/34-54.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/34-54.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/34-54.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/34-54.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/34-54.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/34-54.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/34-54.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/34-54.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/34-54.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/34-54.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/34-54.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/34