khain.com/fr/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sourate Saad\", \"item\": \"https://tafsirshaikhain.com/fr/surah/38.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verset 75\", \"item\": \"https://tafsirshaikhain.com/fr/ayah/38-75.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fr/\">Accueil</a> › <a href=\"/fr/surah/38.html\">Sourate Saad</a> › Verset 75</nav><h1>Tafsir de Sourate Saad 38:75</h1><p class=\"vt ar\" lang=\"ar\">﴿قَالَ يَا إِبْلِيسُ مَا مَنَعَكَ أَن تَسْجُدَ لِمَا خَلَقْتُ بِيَدَيَّ أَسْتَكْبَرْتَ أَمْ كُنتَ مِنَ الْعَالِينَ﴾</p><section><h3>Traduction du sens</h3><p class=\"tr\">75. « Ô Iblîs ! (lui dit Allah) Qu’est-ce qui t’empêche de te prosterner devant ce que J’ai créé de Mes Mains ? Serais-tu à ce point orgueilleux, ou te croirais-tu supérieur ? »</p><span class=\"cr\" dir=\"ltr\">French translation - Noor International Center — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Les paroles des deux imams sont données dans l&#x27;arabe original, mot pour mot, avec leurs références.</p><section><h2>Cheikh al-Islam Ibn Taymiyya</h2><blockquote class=\"ar\" lang=\"ar\">أنه مخلوق بيدي الله تعالى كما قال تعالى: {ما منعك أن تسجد لما خلقت بيدي}<cite>«مجموع الفتاوى» 15/6</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وهنا أضاف الفعل إليه فقال: {لما خلقت} ثم قال: {بيدي}<cite>«مجموع الفتاوى» 3/45</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fr#s38a75\">Ouvrir dans le tafsir interactif (textes complets)</a><div class=\"pn\"><a href=\"/fr/ayah/38-54.html\">Verset précédent (38:54)</a><a href=\"/fr/ayah/38-76.html\">Verset suivant (38:76)</a></div></main><footer class=\"site-foot\"><span>Tafsir des deux Cheikhs · <a href=\"/fr/\">Accueil</a> · <a href=\"/about.html\">À propos du projet</a> · <a href=\"/privacy.html\">Confidentialité et conditions</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/38-76.html":"<!doctype html>\n<html lang=\"fr\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir de Saad 38:76 — selon Ibn Taymiyya et Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"76. « Je suis bien meilleur que lui, répondit Iblîs ; Tu m’as créé de feu et Tu l’as créé d’argile. »\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/fr/ayah/38-76.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/38-76.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/38-76.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/38-76.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/38-76.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/38-76.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/38-76.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/38-76.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/38-76.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/38-76.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/38-76.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/38-76.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/38-76.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/38-76.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/38-76.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/38-76.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/38-76.html\">\n<meta property=\"og:title\" content=\"Tafsir de Saad 38:76 — selon Ibn Taymiyya et Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"76. « Je suis bien meilleur que lui, répondit Iblîs ; Tu m’as créé de feu et Tu l’as créé d’argile. »\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Accueil\", \"item\": \"https://tafsirshaikhain.com/fr/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sourate Saad\", \"item\": \"https://tafsirshaikhain.com/fr/surah/38.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verset 76\", \"item\": \"https://tafsirshaikhain.com/fr/ayah/38-76.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fr/\">Accueil</a> › <a href=\"/fr/surah/38.html\">Sourate Saad</a> › Verset 76</nav><h1>Tafsir de Sourate Saad 38:76</h1><p class=\"vt ar\" lang=\"ar\">﴿قَالَ أَنَا خَيْرٌ مِّنْهُ خَلَقْتَنِي مِن نَّارٍ وَخَلَقْتَهُ مِن طِينٍ﴾</p><section><h3>Traduction du sens</h3><p class=\"tr\">76. « Je suis bien meilleur que lui, répondit Iblîs ; Tu m’as créé de feu et Tu l’as créé d’argile. »</p><span class=\"cr\" dir=\"ltr\">French translation - Noor International Center — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Les paroles des deux imams sont données dans l&#x27;arabe original, mot pour mot, avec leurs références.</p><section><h2>Cheikh al-Islam Ibn Taymiyya</h2><blockquote class=\"ar\" lang=\"ar\">والاحتجاج على فضل الإنسان على غيره بفضل أصله على أصله حجة فاسدة احتج بها إبليس وهي حجة الذين يفخرون بأنسابهم<cite>«مجموع الفتاوى» 15/6</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fr#s38a76\">Ouvrir dans le tafsir interactif (textes complets)</a><div class=\"pn\"><a href=\"/fr/ayah/38-75.html\">Verset précédent (38:75)</a><a href=\"/fr/ayah/38-85.html\">Verset suivant (38:85)</a></div></main><footer class=\"site-foot\"><span>Tafsir des deux Cheikhs · <a href=\"/fr/\">Accueil</a> · <a href=\"/about.html\">À propos du projet</a> · <a href=\"/privacy.html\">Confidentialité et conditions</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/38-85.html":"<!doctype html>\n<html lang=\"fr\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir de Saad 38:85 — selon Ibn Taymiyya et Ibn al-Qayyim</title>\n<meta name=\