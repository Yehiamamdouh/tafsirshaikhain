f=\"https://tafsirshaikhain.com/sw/ayah/74-47.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/74-47.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/74-47.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/74-47.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/74-47.html\">\n<meta property=\"og:title\" content=\"Tafsir de Al-Muddaththir 74:47 — selon Ibn Taymiyya et Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"47. Jusqu’à ce que nous parvînt la grande certitude. »\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Accueil\", \"item\": \"https://tafsirshaikhain.com/fr/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sourate Al-Muddaththir\", \"item\": \"https://tafsirshaikhain.com/fr/surah/74.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verset 47\", \"item\": \"https://tafsirshaikhain.com/fr/ayah/74-47.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fr/\">Accueil</a> › <a href=\"/fr/surah/74.html\">Sourate Al-Muddaththir</a> › Verset 47</nav><h1>Tafsir de Sourate Al-Muddaththir 74:47</h1><p class=\"vt ar\" lang=\"ar\">﴿حَتَّىٰ أَتَانَا الْيَقِينُ﴾</p><section><h3>Traduction du sens</h3><p class=\"tr\">47. Jusqu’à ce que nous parvînt la grande certitude. »</p><span class=\"cr\" dir=\"ltr\">French translation - Noor International Center — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Les paroles des deux imams sont données dans l&#x27;arabe original, mot pour mot, avec leurs références.</p><section><h2>L&#x27;imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">واليقين هاهنا هو الموت بإجماع أهل التفسير<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/124</cite></blockquote><h3>Ce qu&#x27;il a rapporté d&#x27;autrui</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">النبي صلى الله عليه وسلم</span> <span class=\"st\">استشهد به</span> «وقال صلى الله عليه وسلم «أما عثمان بن مظعون فقد جاءه اليقين من ربه»»<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/184</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fr#s74a47\">Ouvrir dans le tafsir interactif (textes complets)</a><div class=\"pn\"><a href=\"/fr/ayah/74-38.html\">Verset précédent (74:38)</a><a href=\"/fr/ayah/74-48.html\">Verset suivant (74:48)</a></div></main><footer class=\"site-foot\"><span>Tafsir des deux Cheikhs · <a href=\"/fr/\">Accueil</a> · <a href=\"/about.html\">À propos du projet</a> · <a href=\"/privacy.html\">Confidentialité et conditions</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/74-48.html":"<!doctype html>\n<html lang=\"fr\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir de Al-Muddaththir 74:48 — selon Ibn Taymiyya et Ibn al-Qayyim</title>\n<meta name=\"description\" content