ps://tafsirshaikhain.com/fr/ayah/86-8.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"Cheikh al-Islam Ibn Taymiyya\"}, {\"@type\": \"Person\", \"name\": \"L'imam Ibn al-Qayyim\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"Tafsir des deux Cheikhs\", \"url\": \"https://tafsirshaikhain.com/fr/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Accueil\", \"item\": \"https://tafsirshaikhain.com/fr/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sourate At-Taariq\", \"item\": \"https://tafsirshaikhain.com/fr/surah/86.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verset 8\", \"item\": \"https://tafsirshaikhain.com/fr/ayah/86-8.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fr/\">Accueil</a> › <a href=\"/fr/surah/86.html\">Sourate At-Taariq</a> › Verset 8</nav><h1>Tafsir de Sourate At-Taariq 86:8</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّهُ عَلَىٰ رَجْعِهِ لَقَادِرٌ﴾</p><section><h3>Traduction du sens</h3><p class=\"tr\">8. (Allah) est certes Capable de le ressusciter.</p><span class=\"cr\" dir=\"ltr\">French translation - Noor International Center — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Les paroles des deux imams sont données dans l&#x27;arabe original, mot pour mot, avec leurs références.</p><section><h2>L&#x27;imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">الصحيح أن الضمير يرجع على الإنسان، أي إن الله على رده إليه لقادر يوم القيامة<cite>«إعلام الموقعين عن رب العالمين» 1/113</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وطريقة القرآن - وهي الاستدلال بالمبدإ والنشأة الأولى على المعاد والرجوع إليه - وأيضا فإنه قيده بالظرف، وهو {يوم تبلى السرائر} [الطارق: 9]<cite>«إعلام الموقعين عن رب العالمين» 1/113</cite></blockquote><h3>Ce qu&#x27;il a rapporté d&#x27;autrui</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">من قال</span> <span class=\"st\">ردّه</span> «إن الضمير يرجع على الماء أي أن الله على رجعه في الإحليل أو في الصدر أو حبسه عن الخروج لقادر»<cite>«إعلام الموقعين عن رب العالمين» 1/113</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fr#s86a8\">Ouvrir dans le tafsir interactif (textes complets)</a><div class=\"pn\"><a href=\"/fr/ayah/86-7.html\">Verset précédent (86:7)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/86-8.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/86-8.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/86-8.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/86-8.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/86-8.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <b lang=\"fr\">Franç