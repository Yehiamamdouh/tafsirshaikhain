anifest\" href=\"/manifest.webmanifest\">\n<link rel=\"apple-touch-icon\" href=\"/icon-192.png\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"Tafsir de Al-Muminoon 23:115 — selon Ibn Taymiyya et Ibn al-Qayyim\", \"description\": \"115. Pensiez-vous vraiment que Nous vous avons créés absurdement et que vers Nous vous ne seriez point ramenés ? »\", \"inLanguage\": \"fr\", \"url\": \"https://tafsirshaikhain.com/fr/ayah/23-115.html\", \"mainEntityOfPage\": \"https://tafsirshaikhain.com/fr/ayah/23-115.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"Cheikh al-Islam Ibn Taymiyya\"}, {\"@type\": \"Person\", \"name\": \"L'imam Ibn al-Qayyim\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"Tafsir des deux Cheikhs\", \"url\": \"https://tafsirshaikhain.com/fr/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Accueil\", \"item\": \"https://tafsirshaikhain.com/fr/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sourate Al-Muminoon\", \"item\": \"https://tafsirshaikhain.com/fr/surah/23.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verset 115\", \"item\": \"https://tafsirshaikhain.com/fr/ayah/23-115.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fr/\">Accueil</a> › <a href=\"/fr/surah/23.html\">Sourate Al-Muminoon</a> › Verset 115</nav><h1>Tafsir de Sourate Al-Muminoon 23:115</h1><p class=\"vt ar\" lang=\"ar\">﴿أَفَحَسِبْتُمْ أَنَّمَا خَلَقْنَاكُمْ عَبَثًا وَأَنَّكُمْ إِلَيْنَا لَا تُرْجَعُونَ﴾</p><section><h3>Traduction du sens</h3><p class=\"tr\">115. Pensiez-vous vraiment que Nous vous avons créés absurdement et que vers Nous vous ne seriez point ramenés ? »</p><span class=\"cr\" dir=\"ltr\">French translation - Noor International Center — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Les paroles des deux imams sont données dans l&#x27;arabe original, mot pour mot, avec leurs références.</p><section><h2>Cheikh al-Islam Ibn Taymiyya</h2><h3>Ce qu&#x27;il a rapporté d&#x27;autrui</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">المفسرون</span> <span class=\"st\">أقرّه</span> «العبث أن يعمل عملا لا لحكمة وهو جنس من اللعب»<cite>«مجموع الفتاوى» 17/174</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">جعفر بن محمد الصادق</span> <span class=\"st\">حكاه</span> «لم يخلقهم لجر منفعة ولا لدفع مضرة ولكن خلقهم وأحسن إليهم وأرسل إليهم الرسل حتى يفصلوا بين الحق والباطل فمن أحسن كافأه بالجنة ومن عصى كافأه بالنار.»<cite>«مجموع الفتاوى» 5/538</cite></blockquote></section><section><h2>L&#x27;imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">أي لغير شيء، لا تؤمرون ولا تنهون، ولا تثابون ولا تعاقبون، والعبث قبيح، فدل على أن قبح هذا مستقر في الفطر والعقول<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/252</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fr#s23a115\">Ouvrir dans le tafsir interactif (textes complets)</a><div class=\"pn\"><a href=\"/fr/ayah/23-111.html\">Verset précédent (23:111)</a><a href=\"/fr/ayah/23-116.htm