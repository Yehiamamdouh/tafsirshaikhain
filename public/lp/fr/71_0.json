hain.com/zh/ayah/71-10.html\">\n<meta property=\"og:title\" content=\"Tafsir de Nooh 71:10 — selon Ibn Taymiyya et Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"10. J’ai donc dit : “Implorez le pardon de votre Seigneur, car Il est Très Absoluteur !\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fr/\">Accueil</a> › <a href=\"/fr/surah/71.html\">Sourate Nooh</a> › Verset 10</nav><h1>Tafsir de Sourate Nooh 71:10</h1><p class=\"vt ar\" lang=\"ar\">﴿فَقُلْتُ اسْتَغْفِرُوا رَبَّكُمْ إِنَّهُ كَانَ غَفَّارًا﴾</p><section><h3>Traduction du sens</h3><p class=\"tr\">10. J’ai donc dit : “Implorez le pardon de votre Seigneur, car Il est Très Absoluteur !</p><span class=\"cr\" dir=\"ltr\">French translation - Noor International Center — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Les paroles des deux imams sont données dans l&#x27;arabe original, mot pour mot, avec leurs références.</p><section><h2>L&#x27;imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">وأما الاستغفار فهو نوعان: مفرد، ومقرون بالتوبة<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/314</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وأيضا فإنه سبحانه يعلل أحكامه وأفعاله بأسمائه ولو لم يكن لها معنى لما كان التعليل صحيحا كقوله تعالى {استغفروا ربكم إنه كان غفارا} نوح 10<cite>«جلاء الأفهام في فضل الصلاة على محمد خير الأنام» 1/173</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فالاستغفار المفرد كالتوبة، بل هو التوبة بعينها، مع تضمنه طلب المغفرة من الله، وهو محو الذنب، وإزالة أثره، ووقاية شره،<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/314</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fr#s71a10\">Ouvrir dans le tafsir interactif (textes complets)</a><div class=\"pn\"><span></span><a href=\"/fr/ayah/71-15.html\">Verset suivant (71:15)</a></div></main><footer class=\"site-foot\"><span>Tafsir des deux Cheikhs · <a href=\"/fr/\">Accueil</a> · <a href=\"/about.html\">À propos du projet</a> · <a href=\"/privacy.html\">Confidentialité et conditions</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/71-15.html":"<!doctype html>\n<html lang=\"fr\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir de Nooh 71:15 — selon Ibn Taymiyya et Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"15. Ne voyez-vous pas comment Allah a créé sept cieux qui se superposent,\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/fr/ayah/71-15.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/71-15.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/71-15.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/71-15.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/71-15.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/71-15.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/71-15.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/71-15.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/71-15.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/71-15.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/71-15.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/71-15.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/71-15.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/71-15.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/71-15.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/71-15.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/71-15.html\">\n<meta property=\"og:title\" content=\"Tafsir de Nooh 71:15 — selon Ibn Taymiyya et Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"15. Ne voyez-vous pas comment Allah a créé sept cieux qui se superposent,\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fr/\">Accueil</a> › <a href=\"/fr/surah/71.html\">Sourate Nooh</a> › Verset 15</nav><h1>Tafsir de Sourate Nooh 71:15</h1><p class=\"vt ar\" lang=\"ar\">﴿أَلَمْ تَرَوْا كَيْفَ خَلَقَ اللَّهُ سَبْعَ سَمَاوَاتٍ طِبَاقًا﴾</p><section><h3>Traduction du sens</h3><p class=\"tr\">15. Ne voyez-vous pas comment Allah a créé sept cieux qui se superposent,</p><span class=\"cr\" dir=\"ltr\">French translation - Noor International Center — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Les paroles des deux imams sont données dans l&#x27;arabe original, mot pour mot, avec leurs références.</p><section><h2>L&#x27;imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">كما قال تعالى: {ألم تروا كيف خلق الله سبع سماوات طباقا} [نوح: 15] ، وقوله تعالى: {ألم تر كيف فعل ربك بأصحاب الفيل} [الفيل: 1] فهاهنا أوقع الرؤية على نفس الفعل،<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 3/230</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fr#s71a15\">Ouvrir dans le tafsir interactif (textes complets)</a><div class=\"pn\"><a href=\"/fr/ayah/71-10.html\">Verset précédent (71:10)</a><a href=\"/fr/ayah/71-16.html\">Verset suivant (71:16)</a></div></main><footer class=\"site-foot\"><span>Tafsir des deux Cheikhs · <a href=\"/fr/\">Accueil</a> · <a href=\"/about.html\">À propos du projet</a> · <a href=\"/privacy.html\">Confidentialité et conditions</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/71-16.html":"<!doctype html>\n<html lang=\"fr\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir de Nooh 71:16 — selon Ibn Taymiyya et Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"16. y a mis la lune comme lumière et le soleil comme flambeau ?\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/fr/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/71-16.html\">\n<meta property=\"og:title\" content=\"Tafsir de Nooh 71:16 — selon Ibn Taymiyya et Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"16. y a mis la lune comme lumière et le soleil comme flambeau ?\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fr/\">Accueil</a> › <a href=\"/fr/surah/71.html\">Sourate Nooh</a> › Verset 16</nav><h1>Tafsir de Sourate Nooh 71:16</h1><p class=\"vt ar\" lang=\"ar\">﴿وَجَعَلَ الْقَمَرَ فِيهِنَّ نُورًا وَجَعَلَ الشَّمْسَ سِرَاجًا﴾</p><section><h3>Traduction du sens</h3><p class=\"tr\">16. y a mis la lune comme lumière et le soleil comme flambeau ?</p><span class=\"cr\" dir=\"ltr\">French translation - Noor International Center — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Les paroles des deux imams sont données dans l&#x27;arabe original, mot pour mot, avec leurs références.</p><section><h2>Cheikh al-Islam Ibn Taymiyya</h2><blockquote class=\"ar\" lang=\"ar\">فأخبر أنه جعل الشمس والقمر في السموات.<cite>«مجموع الفتاوى» 6/598</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fr#s71a16\">Ouvrir dans le tafsir interactif (textes complets)</a><div class=\"pn\"><a href=\"/fr/ayah/71-15.html\">Verset précédent (71:15)</a><a href=\"/fr/ayah/71-17.html\">Verset suivant (71:17)</a></div></main><footer class=\"site-foot\"><span>Tafsir des deux Cheikhs · <a href=\"/fr/\">Accueil</a> · <a href=\"/about.html\">À propos du projet</a> · <a href=\"/privacy.html\">Confidentialité et conditions</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/71-17.html":"<!doctype html>\n<html lang=\"fr\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir de Nooh 71:17 — selon Ibn Taymiyya et Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"17. C’est bien Allah Qui vous a fait pousser, à partir de la terre, tels des plantes,\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/fr/ayah/71-17.html\">\n<link rel=\"