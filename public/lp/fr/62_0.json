 \"ListItem\", \"position\": 1, \"name\": \"Accueil\", \"item\": \"https://tafsirshaikhain.com/fr/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sourate Al-Jumu'a\", \"item\": \"https://tafsirshaikhain.com/fr/surah/62.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verset 3\", \"item\": \"https://tafsirshaikhain.com/fr/ayah/62-3.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fr/\">Accueil</a> › <a href=\"/fr/surah/62.html\">Sourate Al-Jumu&#x27;a</a> › Verset 3</nav><h1>Tafsir de Sourate Al-Jumu&#x27;a 62:3</h1><p class=\"vt ar\" lang=\"ar\">﴿وَآخَرِينَ مِنْهُمْ لَمَّا يَلْحَقُوا بِهِمْ وَهُوَ الْعَزِيزُ الْحَكِيمُ﴾</p><section><h3>Traduction du sens</h3><p class=\"tr\">3. (Il l’envoya aussi) à d’autres qui ne les ont pas encore rejoints. C’est Lui le Tout-Puissant, le Sage.</p><span class=\"cr\" dir=\"ltr\">French translation - Noor International Center — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Les paroles des deux imams sont données dans l&#x27;arabe original, mot pour mot, avec leurs références.</p><section><h2>Cheikh al-Islam Ibn Taymiyya</h2><blockquote class=\"ar\" lang=\"ar\">فهذا يتناول كل من دخل في الإسلام بعد دخول العرب فيه إلى يوم القيامة<cite>«مجموع الفتاوى» 16/190</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فإن قوله {وآخرين منهم} أي في الدين دون النسب<cite>«مجموع الفتاوى» 16/190</cite></