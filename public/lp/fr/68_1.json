"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"Tafsir des deux Cheikhs\", \"url\": \"https://tafsirshaikhain.com/fr/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Accueil\", \"item\": \"https://tafsirshaikhain.com/fr/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sourate Al-Qalam\", \"item\": \"https://tafsirshaikhain.com/fr/surah/68.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verset 51\", \"item\": \"https://tafsirshaikhain.com/fr/ayah/68-51.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fr/\">Accueil</a> › <a href=\"/fr/surah/68.html\">Sourate Al-Qalam</a> › Verset 51</nav><h1>Tafsir de Sourate Al-Qalam 68:51</h1><p class=\"vt ar\" lang=\"ar\">﴿وَإِن يَكَادُ الَّذِينَ كَفَرُوا لَيُزْلِقُونَكَ بِأَبْصَارِهِمْ لَمَّا سَمِعُوا الذِّكْرَ وَيَقُولُونَ إِنَّهُ لَمَجْنُونٌ﴾</p><section><h3>Traduction du sens</h3><p class=\"tr\">51. Il s’en faut de peu que les mécréants ne te vrillent de leurs regards quand ils entendent le (Coran). Ils disent alors : « Ce n’est qu’un dément ! »</p><span class=\"cr\" dir=\"ltr\">French translation - Noor International Center — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Les paroles des deux imams sont données dans l&#x27;arabe original, mot pour mot, avec leurs références.</p><section><h2>Cheikh al-Islam Ibn Taymiyya</h2><blockquote class=\"ar\" lang=\"ar\">والكافر والمنافق يسمع ويرى على وجه البغض والجهل كما قال تعالى: {وإن يكاد الذين كفروا ليزلقونك بأبصارهم لما سمعوا الذكر}<cite>«مجموع الفتاوى» 15/342</cite></blockquote></section><section><h2>L&#x27;imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">فكل عائن حاسد، وليس كل حاسد عائنا<cite>«زاد المعاد في هدي خير العباد» 4/154</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">العائن قد يصيب من لا يحسده من جماد أو حيوان أو زرع أو مال وإن كان لا يكاد ينفك من حسد صاحبه وربما أصابت عينه نفسه فإن رؤيته للشيء رؤية تعجب وتحديق مع تكيف نفسه بتلك الكيفية تؤثر في المعين<cite>«بدائع الفوائد» 2/231</cite></blockquote><h3>Ce qu&#x27;il a rapporté d&#x27;autrui</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">غير واحد من المفسرين</span> <span class=\"st\">حكاه</span> «إنه الإصابة بالعين فأرادوا أن يصيبوا بها رسول الله صلى الله عليه وسلم»<cite>«بدائع الفوائد» 2/231</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن قتيبة</span> <span class=\"st\">حكاه</span> «ليس المراد أنهم يصيبونك بالعين كما يصيب العائن بعينه ما يعجبه وإنما أراد أنهم ينظرون إليك إذا قرأت القرآن الكريم نظرا شديدا بالعداوة والبغضاء يكاد يسقطك»<cite>«بدائع الفوائد» 2/231</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الزجاج</span> <span class=\"st\">حكاه</span> «يعني من شدة العداوة يكادون بنظرهم نظر البغضاء أن يصرعوك»<cite>«بدائع الفوائد» 2/231</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fr#s68a51\">Ouvrir dans le tafsir interactif (textes complets)</a><div class=\"pn\"><a href=\"/fr/ayah/68-50.html\">Verset précédent (68:50)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/68-51.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/68-51.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/68-51.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/68-51.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/68-51.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <b lang=\"fr\">Français</b> · <a href=\"/bn/ayah/68-51.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/68-51.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/68-51.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/68-51.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/68-51.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/68-51.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/68-51.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/68-51.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/68-51.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a></nav>\n<footer class=\"site-foot\"><span>Tafsir des deux Cheikhs · <a href=\"/fr/\">Accueil</a> · <a href=\"/about.html\">À propos du projet</a> · <a href=\"/privacy.html\">Confidentialité et conditions</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n<script>try{localStorage.setItem(\"lang\",\"fr\")}catch(e){}document.addEventListener(\"click\",function(e){var a=e.target.closest&&e.target.closest(\"[data-l]\");if(a)try{localStorage.setItem(\"l