ly=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fr/\">Accueil</a> › <a href=\"/fr/surah/93.html\">Sourate Ad-Dhuhaa</a> › Verset 3</nav><h1>Tafsir de Sourate Ad-Dhuhaa 93:3</h1><p class=\"vt ar\" lang=\"ar\">﴿مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ﴾</p><section><h3>Traduction du sens</h3><p class=\"tr\">3. Ton Seigneur ne t’a point délaissé, ni ne t’a haï.</p><span class=\"cr\" dir=\"ltr\">French translation - Noor International Center — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Les paroles des deux imams sont données dans l&#x27;arabe original, mot pour mot, avec leurs références.</p><section><h2>Cheikh al-Islam Ibn Taymiyya</h2><blockquote class=\"ar\" lang=\"ar\">والرسول هو الذي أنزل عليه القرآن والخطاب في هذه السور له كقوله {ما ودعك ربك وما قلى} وقوله {ألم نشرح لك صدرك} وقوله {اقرأ باسم ربك} .<cite>«مجموع الفتاوى» 16/284</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fr#s93a3\">Ouvrir dans le tafsir interactif (textes complets)</a><div class=\"pn\"><a href=\"/fr/ayah/93-1.html\">Verset précédent (93:1)</a><a href=\"/fr/ayah/93-6.html\">Verset suivant (93:6)</a></div></main><footer class=\"site-foot\"><span>Tafsir des deux Cheikhs · <a href=\"/fr/\">Accueil</a> · <a href=\"/about.html\">À propos du projet</a> · <a href=\"/privacy.html\">Confidentialité et conditions</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/93-6.html":"<!doctype html>\n<html lang=\"fr\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Taf