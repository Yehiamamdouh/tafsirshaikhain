\": \"https://tafsirshaikhain.com/fr/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sourate Ad-Dhuhaa\", \"item\": \"https://tafsirshaikhain.com/fr/surah/93.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verset 10\", \"item\": \"https://tafsirshaikhain.com/fr/ayah/93-10.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fr/\">Accueil</a> › <a href=\"/fr/surah/93.html\">Sourate Ad-Dhuhaa</a> › Verset 10</nav><h1>Tafsir de Sourate Ad-Dhuhaa 93:10</h1><p class=\"vt ar\" lang=\"ar\">﴿وَأَمَّا السَّائِلَ فَلَا تَنْهَرْ﴾</p><section><h3>Traduction du sens</h3><p class=\"tr\">10. Quant au mendiant, ne le malmène point.</p><span class=\"cr\" dir=\"ltr\">French translation - Noor International Center — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Les paroles des deux imams sont données dans l&#x27;arabe original, mot pour mot, avec leurs références.</p><section><h2>Cheikh al-Islam Ibn Taymiyya</h2><blockquote class=\"ar\" lang=\"ar\">والمسئول مأمور بإجابة السائل.<cite>«مجموع الفتاوى» 1/186</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وقد يكون السؤال منهيا عنه نهي تحريم أو تنزيه وإن كان المسئول مأمورا بإجابة سؤاله.<cite>«مجموع الفتاوى» 1/186</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">أو يردهم بميسور من القول ما لم يحتج إلى الإغلاظ؛ فإن رد السائل يؤلمه خصوصا من يحتاج إلى تأليفه<cite>«مجموع الفتاوى» 28/365</cite></blockquote><h3>Ce qu&#x27;il a rapporté d&#x27;autrui</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">النبي صلى الله عليه وسلم</span> <span class=\"st\">استشهد به</span> «{إن أحدكم ليسألني المسألة فيخرج بها يتأبطها نارا}»<cite>«مجموع الفتاوى» 1/186</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fr#s93a10\">Ouvrir dans le tafsir interactif (textes complets)</a><div class=\"pn\"><a href=\"/fr/ayah/93-8.html\">Verset précédent (93:8)</a><a href=\"/fr/ayah/93-11.html\">Verset suivant (93:11)</a></div></main><footer class=\"site-foot\"><span>Tafsir des deux Cheikhs · <a href=\"/fr/\">Accueil</a> · <a href=\"/about.html\">À propos du projet</a> · <a href=\"/privacy.html\">Confidentialité et conditions</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/93-11.html":"<!doctype html>\n<html lang=\"fr\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir de Ad-Dhuhaa 93:11 — selon Ibn Taymiyya et Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"11. Et quant aux bienfaits de ton Seigneur, proclame-les tout haut !\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/fr/ayah/93-11.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/93-11.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/93-11.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/93-11.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/93-11.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/93-11.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/93-11.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/93-11.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/93-11.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/93-11.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/93-11.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/93-11.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/93-11.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/93-11.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/93-11.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/93-11.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/93-11.html\">\n<meta property=\"og:title\" content=\"Tafsir de Ad-Dhuhaa 93:11 — selon Ibn Taymiyya et Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"11. Et quant aux bienfaits de ton Seigneur, proclame-les tout haut !\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Accueil\", \"item\": \"https://tafsirshaikhain.com/fr/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sourate Ad-Dhuhaa\", \"item\": \"https://tafsirshaikhain.com/fr/surah/93.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verset 11\", \"item\": \"https://tafsirshaikhain.com/fr/ayah/93-11.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https:/