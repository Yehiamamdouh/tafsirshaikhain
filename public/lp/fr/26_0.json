khain.com/fr/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sourate Ash-Shu'araa\", \"item\": \"https://tafsirshaikhain.com/fr/surah/26.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verset 23\", \"item\": \"https://tafsirshaikhain.com/fr/ayah/26-23.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fr/\">Accueil</a> › <a href=\"/fr/surah/26.html\">Sourate Ash-Shu&#x27;araa</a> › Verset 23</nav><h1>Tafsir de Sourate Ash-Shu&#x27;araa 26:23</h1><p class=\"vt ar\" lang=\"ar\">﴿قَالَ فِرْعَوْنُ وَمَا رَبُّ الْعَالَمِينَ﴾</p><section><h3>Traduction du sens</h3><p class=\"tr\">23. Pharaon demanda : « Et qu’est-ce que le Seigneur de l’Univers ? »</p><span class=\"cr\" dir=\"ltr\">French translation - Noor International Center — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Les paroles des deux imams sont données dans l&#x27;arabe original, mot pour mot, avec leurs références.</p><section><h2>Cheikh al-Islam Ibn Taymiyya</h2><blockquote class=\"ar\" lang=\"ar\">فإن سؤال فرعون بقوله: {وما رب العالمين} استفهام إنكار لوجوده، ليس هو استفهام طلب لتعريف ماهيته كما ظن ذلك بعض المتأخرين<cite>«منهاج السنة النبوية في نقض كلام الشيعة القدرية» 2/271</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فإن فرعون لم يكن مقرا بالصانع ألبتة، بل كان جاحدا له، وكان استفهامه استفهام إنكار لوجوده<cite>«منهاج السنة النبوية في نقض كلام الشيعة القدرية» 2/271</cite></blockquote></section><section><h2>L&#x27;imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">ولذلك لما سأل فرعون موسى عن حقيقة ربه، بقوله: {وما رب العالمين} [الشعراء: 23] أجابه موسى بقوله: {رب السماوات والأرض وما بينهما} [مريم: 65] إذ لا وصول للبشر إلى حقيقة ذاته<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 3/221</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فدلهم على نفسه بصفاته الثبوتية؛ من كونه صمدا، وصفاته السلبية المتضمنة للثبوت؛ من كونه &quot; لم يلد ولم يولد ولم يكن له كفوا أحد &quot; لم يجعل لهم سبيلا إلى معرفة الذات والكنه.<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 3/221</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fr#s26a23\">Ouvrir dans le tafsir interactif (textes complets)</a><div class=\"pn\"><a href=\"/fr/ayah/26-10.html\">Verset précédent (26:10)</a><a href=\"/fr/ayah/26-27.html\">Verset suivant (26:27)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/26-23.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/26-23.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/26-23.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/26-23.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/26-23.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <b lang=\"fr\">Français</b> · <a href=\"/bn/ayah/26-23.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/26-23.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/26-23.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/26-23.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/26-23.html\" hreflang=\"sw\" lang=\"sw\" data-