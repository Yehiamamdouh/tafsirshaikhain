osition\": 1, \"name\": \"Accueil\", \"item\": \"https://tafsirshaikhain.com/fr/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sourate Al-Anbiyaa\", \"item\": \"https://tafsirshaikhain.com/fr/surah/21.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verset 105\", \"item\": \"https://tafsirshaikhain.com/fr/ayah/21-105.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fr/\">Accueil</a> › <a href=\"/fr/surah/21.html\">Sourate Al-Anbiyaa</a> › Verset 105</nav><h1>Tafsir de Sourate Al-Anbiyaa 21:105</h1><p class=\"vt ar\" lang=\"ar\">﴿وَلَقَدْ كَتَبْنَا فِي الزَّبُورِ مِن بَعْدِ الذِّكْرِ أَنَّ الْأَرْضَ يَرِثُهَا عِبَادِيَ الصَّالِحُونَ﴾</p><section><h3>Traduction du sens</h3><p class=\"tr\">105. Nous avons écrit dans les Psaumes (le Zabûr), après l’avoir évoqué (dans le Livre éternel) que la terre sera l’héritage de Mes serviteurs les plus vertueux.</p><span class=\"cr\" dir=\"ltr\">French translation - Noor International Center — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Les paroles des deux imams sont données dans l&#x27;arabe original, mot pour mot, avec leurs références.</p><section><h2>Cheikh al-Islam Ibn Taymiyya</h2><blockquote class=\"ar\" lang=\"ar\">قوله: {كتب في الذكر} يعني: اللوح المحفوظ كما قال: {ولقد كتبنا في الزبور من بعد الذكر} أي: من بعد اللوح المحفوظ<cite>«مجموع الفتاوى» 18/211</cite></blockquote></section><section><h2>L&#x27;imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">فالزبور هنا جميع الكتب المنزلة من السماء لا تختص بزبور داود والذكر أم الكتاب الذي عند الله<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/39</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fr#s21a105\">Ouvrir dans le tafsir interactif (textes complets)</a><div class=\"pn\"><a href=\"/fr/ayah/21-101.html\">Verset précédent (21:101)</a><a href=\"/fr/ayah/21-112.html\">Verset suivant (21:112)</a></div></main><footer class=\"site-foot\"><span>Tafsir des deux Cheikhs · <a href=\"/fr/\">Accueil</a> · <a href=\"/about.html\">À propos du projet</a> · <a href=\"/privacy.html\">Confidentialité et conditions</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/21-112.html":"<!doctype html>\n<html lang=\"fr\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir de Al-Anbiyaa 21:112 — selon Ibn Taymiyya et Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"112. Il dit : « Seigneur ! Juge (entre nous) en toute équité ! Et notre Seigneur est le Tout Clément, Celui Dont nous cherchons l’assistance contre vos all\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/fr/ayah/21-112.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/21-112.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/21-112.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/21-112.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/21-112.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/21-112.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/21-112.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/21-112.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/21-112.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/21-112.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/21-112.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/21-112.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/21-112.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/21-112.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/21-112.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/21-112.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/21-112.html\">\n<meta property=\"og:title\" content=\"Tafsir de Al-Anbiyaa 21:112 — selon Ibn Taymiyya et Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"112. Il dit : « Seigneur ! Juge (entre nous) en toute équité ! Et notre Seigneur est le Tout Clément, Celui Dont nous cherchons l’assistance contre vos all\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Accueil\", \"item\": \"https://tafsirshaikhain.com/fr/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sourate Al-Anbiyaa\", \"item\": \"https://tafsirshaikhain.com/fr/surah/21.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verset 112\", \"item\": \"https://tafsirshaikhain.com/fr/ayah/21-112.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fr/\">Accueil</a> › <a href=\"/fr/surah/21.html\">Sourate Al-Anbiyaa</a> › Verset 112</nav><h1>Tafsir de Sourate Al-Anbiyaa 21:112</h1><p class=\"vt ar\" lang=\"ar\">﴿قَالَ رَبِّ احْكُم بِالْحَقِّ وَرَبُّنَا الرَّحْمَٰنُ الْمُسْتَعَانُ عَلَىٰ مَا تَصِفُونَ﴾</p><section><h3>Traduction du sens</h3><p class=\"tr\">112. Il dit : « Seigneur ! Juge (entre nous) en toute équité ! Et notre Seigneur est le Tout Clément, Celui Dont nous cherchons l’assistance contre vos allégations. »</p><span class=\"cr\" dir=\"ltr\">French translation - Noor International Center — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Les paroles des deux imams sont données dans l&#x27;arabe original, mot pour mot, avec leurs références.</p><section><h2>Cheikh al-Islam Ibn Taymiyya</h2><blockquote class=\"ar\" lang=\"ar\">ويكون الحكم حكما بالحق والتكوين والفعل كقوله: {فلن أبرح الأرض حتى يأذن لي أبي أو يحكم الله لي} وقوله: {قال رب احكم بالحق} .<cite>«مجموع الفتاوى» 2/264</cite></blockquote></section><section><h2>L&#x27;imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">أي افعل ما تنصر به عبادك وتخذل به أعداءك<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/280</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">على أن عطف الخبر على الطلب كثير كقوله تعالى: {قال رب احكم بالحق، وربنا الرحمن المستعان على ما تصفون} [الأنبياء: 112] ،<cite>«طريق الهجرتين وباب السعادتين» 1/350</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fr#s21a112\">Ouvrir dans le tafsir interactif (textes complets)</a><div class=\"pn\"><a href=\"/fr/ayah/21-105.html\">Verset précédent (21:105)</a></div></main><footer class=\"site-foot\"><span>Tafsir des deux Cheikhs · <a href=\"/fr/\">Accueil</a> · <a href=\"/about.html\">À propos du projet</a> · <a href=\"/privacy.html\">Confidentialité et conditions</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}