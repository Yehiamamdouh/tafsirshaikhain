s://tafsirshaikhain.com/fr/surah/105.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verset 1\", \"item\": \"https://tafsirshaikhain.com/fr/ayah/105-1.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fr/\">Accueil</a> › <a href=\"/fr/surah/105.html\">Sourate Al-Fil</a> › Verset 1</nav><h1>Tafsir de Sourate Al-Fil 105:1</h1><p class=\"vt ar\" lang=\"ar\">﴿بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَابِ الْفِيلِ﴾</p><section><h3>Traduction du sens</h3><p class=\"tr\">1. N’as-tu pas vu ce que fit ton Seigneur aux compagnons de l’Éléphant ?</p><span class=\"cr\" dir=\"ltr\">French translation - Noor International Center — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Les paroles des deux imams sont données dans l&#x27;arabe original, mot pour mot, avec leurs références.</p><section><h2>Cheikh al-Islam Ibn Taymiyya</h2><blockquote class=\"ar\" lang=\"ar\">فعلم بذلك أن هذه الآية لم تكن لأجل جيران البيت حينئذ، بل كانت لأجل البيت أو لأجل النبي صلى الله عليه وسلم، الذي ولد به في ذلك العام عند البيت، أو لمجموعهما، وأي ذلك كان فهو من دلائل نبوته.<cite>«الجواب الصحيح لمن بدل دين المسيح» 6/56</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">ومن آيات محمد صلى الله عليه وسلم ودلائل نبوته التي في القرآن قصة الفيل<cite>«الجواب الصحيح لمن بدل دين المسيح» 6/55</cite></blockquote></section><section><h2>L&#x27;imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">وقوله تعالى: {ألم تر كيف فعل ربك بأصحاب الفيل} [الفيل: 1] فهاهنا أوقع الرؤية على نفس الفعل<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 3/230</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fr#s105a1\">Ouvrir dans le tafsir interactif (textes complets)</a><div class=\"pn\"><span></span><a href=\"/fr/ayah/105-3.html\">Verset suivant (105:3)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/105-1.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/105-1.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/105-1.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/105-1.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/105-1.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <b lang=\"fr\">Français</b> · <a href=\"/bn/ayah/105-1.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/105-1.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/105-1.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/105-1.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/105-1.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/105-1.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/105-1.html\" hreflang=\"es\" lang=\"es\" da