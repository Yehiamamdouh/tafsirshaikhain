=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fr/\">Accueil</a> › <a href=\"/fr/surah/78.html\">Sourate An-Naba</a> › Verset 23</nav><h1>Tafsir de Sourate An-Naba 78:23</h1><p class=\"vt ar\" lang=\"ar\">﴿لَّابِثِينَ فِيهَا أَحْقَابًا﴾</p><section><h3>Traduction du sens</h3><p class=\"tr\">23. qui y demeureront des ères infinies.</p><span class=\"cr\" dir=\"ltr\">French translation - Noor International Center — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Les paroles des deux imams sont données dans l&#x27;arabe original, mot pour mot, avec leurs références.</p><section><h2>L&#x27;imam Ibn al-Qayyim</h2><h3>Ce qu&#x27;il a rapporté d&#x27;autrui</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن مسعود</span> <span class=\"st\">حكاه</span> «ليأتين يوم على جهنم زمان وليس فيها أحد وذلك بعدما يلبثون فيها أحقابا»<cite>«حادي الأرواح إلى بلاد الأفراح» 1/358</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">البغوي</span> <span class=\"st\">حكاه</span> «ومعناه عند أهل السنة أن ثبت أنه لا يبقى فيها أحد من أهل الإيمان»<cite>«حادي الأرواح إلى بلاد الأفراح» 1/358</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">عبد الله بن عمرو</span> <span class=\"st\">حكاه</span> «ليأتين على جهنم يوم تصفق فيه أبوابها ليس فيها أحد وذلك بعدما يلبثون فيها أحقابا»<cite>«حادي الأرواح إلى بلاد الأفراح» 1/358</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fr#s78a23\">Ouvrir dans le tafsir interactif (textes complets)</a><div class=\"pn\"><a href=\"/fr/ayah/78-14.html\">Verset précédent (78:14)</a><a href=\"/fr/ayah/78-24.html\">Verset suivant (78:24)</a></div></main><footer class=\"site-foot\"><span>Tafsir des deux Cheikhs · <a href=\"/fr/\">Accueil</a> · <a href=\"/about.html\">À propos du projet</a> · <a href=\"/privacy.html\">Confidentialité et conditions</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/78-24.html":"<!doctype html>\n<html lang=\"fr\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir de An-Naba 78:24 — selon Ibn Taymiyya et Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"24. Ils n’y goûteront ni fraîcheur ni boisson,\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/fr/ayah/78-24.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/78-24.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/78-24.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/78-24.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/78-24.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/78-24.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/78-24.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/78-24.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/78-24.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/78-24.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/78-24.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/78-24.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/78-24.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/78-24.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/78-24.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/78-24.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/78-24.html\">\n<meta property=\"og:title\" content=\"Tafsir de An-Naba 78:24 — selon Ibn Taymiyya et Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"24. Ils n’y goûteront ni fraîcheur ni boisson,\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Accueil\", \"item\": \"https://tafsirshaikhain.com/fr/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sourate An-Naba\", \"item\": \"https://tafsirshaikhain.com/fr/surah/78.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verset 24\", \"item\": \"https://tafsirshaikhain.com/fr/ayah/78-24.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fr/\">Accueil</a> › <a href=\"/fr/surah/78.html\">Sourate An-Naba</a> › Verset 24</nav><h1>Tafsir de Sourate An-Naba 78:24</h1><p class=\"vt ar\" lang=\"ar\">﴿لَّا يَذُوقُونَ فِيهَا بَرْدًا وَلَا شَرَابًا﴾</p><section><h3>Traduction du sens</h3><p class=\"tr\">24. Ils n’y goûteront ni fraîcheur ni boisson,</p><span class=\"cr\" dir=\"ltr\">French translation - Noor International Center — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Les paroles des deux imams sont données dans l&#x27;arabe original, mot pour mot, avec leurs références.</p><section><h2>Cheikh al-Islam Ibn Taymiyya</h2><blockquote class=\"ar\" lang=\"ar\">أي لا يحصل لهم من ذلك ولا ذوق.<cite>«مجموع الفتاوى» 7/111</cite></blockquote></section><section><h2>L&#x27;imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">فإن الحميم والغساق داخل في جنس الذوق المنقسم<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/325</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وفي الثاني: لا يذوقون فيها شيئا إلا حميما وغساقا، ونص على فرد من أفراد الجنس تصريحا، ليكون نفيه بطريق التصريح والتنصيص، لا بطريق العموم الذي يتطرق إليه تخصيص هذا الفرد،<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/325</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fr#s78a24\">Ouvrir dans le tafsir interactif (textes complets)</a><div class=\"pn\"><a href=\"/fr/ayah/78-23.html\">Verset précédent (78:23)</a><a href=\"/fr/ayah/78-37.html\">Verset suivant (78:37)</a></div></main><footer class=\"site-foot\"><span>Tafsir des deux Cheikhs · <a href=\"/fr/\">Accueil</a> · <a href=\"/about.html\">À propos du projet</a> · <a href=\"/privacy.html\">Confidentialité et conditions</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/78-37.html":"<!doctype html>\n<html lang=\"fr\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir de An-Naba 7