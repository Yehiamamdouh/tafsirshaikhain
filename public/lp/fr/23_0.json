\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Accueil\", \"item\": \"https://tafsirshaikhain.com/fr/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sourate Al-Muminoon\", \"item\": \"https://tafsirshaikhain.com/fr/surah/23.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verset 9\", \"item\": \"https://tafsirshaikhain.com/fr/ayah/23-9.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fr/\">Accueil</a> › <a href=\"/fr/surah/23.html\">Sourate Al-Muminoon</a> › Verset 9</nav><h1>Tafsir de Sourate Al-Muminoon 23:9</h1><p class=\"vt ar\" lang=\"ar\">﴿وَالَّذِينَ هُمْ عَلَىٰ صَلَوَاتِهِمْ يُحَافِظُونَ﴾</p><section><h3>Traduction du sens</h3><p class=\"tr\">9. qui observent assidûment leur Çalât,</p><span class=\"cr\" dir=\"ltr\">French translation - Noor International Center — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Les paroles des deux imams sont données dans l&#x27;arabe original, mot pour mot, avec leurs références.</p><section><h2>Cheikh al-Islam Ibn Taymiyya</h2><blockquote class=\"ar\" lang=\"ar\">وهذه الآيات تقتضي ذم من ترك شيئا من واجبات الصلاة وإن كان في الظاهر مصليا مثل أن يترك الوقت الواجب أو يترك تكميل الشرائط والأركان من الأعمال الظاهرة والباطنة وبذلك فسرها السلف.<cite>«مجموع الفتاوى» 22/572</cite></blockquote><h3>Ce qu&#x27;il a rapporté d&#x27;autrui</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">قتادة</span> <span class=\"st\">أقرّه</span> «على وضوئها ومواقيتها وركوعها»<cite>«مجموع الفتاوى» 22/572</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">مسروق</span> <span class=\"st\">أقرّه</span> «على مواقيتها»<cite>«مجموع الفتاوى» 22/572</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن جريج</span> <span class=\"st\">ردّه</span> «المكتوبة والتي في سأل سائل: التطوع.»<cite>«مجموع الفتاوى» 22/572</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fr#s23a9\">Ouvrir dans le tafsir interactif (textes complets)</a><div class=\"pn\"><a href=\"/fr/ayah/23-2.html\">Verset précédent (23:2)</a><a href=\"/fr/ayah/23-13.html\">Verset suivant (23:13)</a></div></main><footer class=\"site-foot\"><span>Tafsir des deux Cheikhs · <a href=\"/fr/\">Accueil</a> · <a href=\"/about.html\">À propos du projet</a> · <a href=\"/privacy.html\">Confidentialité et conditions</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/23-13.html":"<!doctype html>\n<html lang=\"fr\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir de Al-Muminoon 23:13 — selon Ibn Taymiyya et Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"13. Nous en avons alors fait une goutte de sperme placée dans un réceptacle sûr.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/fr/ayah/23-13.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/23-13.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/23-13.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/23-13.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/23-13.html\">\n<link 