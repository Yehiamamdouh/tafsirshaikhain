m/fr/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sourate Ash-Sharh\", \"item\": \"https://tafsirshaikhain.com/fr/surah/94.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verset 7\", \"item\": \"https://tafsirshaikhain.com/fr/ayah/94-7.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fr/\">Accueil</a> › <a href=\"/fr/surah/94.html\">Sourate Ash-Sharh</a> › Verset 7</nav><h1>Tafsir de Sourate Ash-Sharh 94:7</h1><p class=\"vt ar\" lang=\"ar\">﴿فَإِذَا فَرَغْتَ فَانصَبْ﴾</p><section><h3>Traduction du sens</h3><p class=\"tr\">7. Quand tu auras accompli (tes devoirs terrestres), lève-toi (pour la prière),</p><span class=\"cr\" dir=\"ltr\">French translation - Noor International Center — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Les paroles des deux imams sont données dans l&#x27;arabe original, mot pour mot, avec leurs références.</p><section><h2>Cheikh al-Islam Ibn Taymiyya</h2><blockquote class=\"ar\" lang=\"ar\">تفسير قوله: {فإذا فرغت فانصب} أي فرغت من الصلاة قول ضعيف فإن قوله: إذا فرغت مطلق ولأن الفارغ إن أريد به الفارغ من العبادة فالدعاء أيضا عبادة وإن أريد به الفراغ من أشغال الدنيا بالصلاة فليس كذلك.<cite>«مجموع الفتاوى» 22/496</cite></blockquote><h3>Ce qu&#x27;il a rapporté d&#x27;autrui</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">أشهر قولي المفسرين</span> <span class=\"st\">أقرّه</span> «قيل: إذا فرغت من أشغال الدنيا فانصب في العبادة وإلى ربك فارغب. وهذا أشهر القولين.»<cite>«مجموع الفتاوى» 22/495</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">بعض المفسرين</span> <span class=\"st\">ردّه</span> «أي فرغت من الصلاة»<cite>«مجموع الفتاوى» 22/496</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">قيل</span> <span class=\"st\">حكاه</span> «{فإذا فرغت} من الصلاة {فانصب} في الدعاء {وإلى ربك فارغب} .»<cite>«مجموع الفتاوى» 22/495</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fr#s94a7\">Ouvrir dans le tafsir interactif (textes complets)</a><div class=\"pn\"><a href=\"/fr/ayah/94-4.html\">Verset précédent (94:4)</a><a href=\"/fr/ayah/94-8.html\">Verset suivant (94:8)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/94-7.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/94-7.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/94-7.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/94-7.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/94-7.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <b lang=\"fr\">Français</b> · <a href=\"/bn/ayah/94-7.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/94-7.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/94-7.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah