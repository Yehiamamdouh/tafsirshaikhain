, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verset 103\", \"item\": \"https://tafsirshaikhain.com/fr/ayah/18-103.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/fr/\">Accueil</a> › <a href=\"/fr/surah/18.html\">Sourate Al-Kahf</a> › Verset 103</nav><h1>Tafsir de Sourate Al-Kahf 18:103</h1><p class=\"vt ar\" lang=\"ar\">﴿قُلْ هَلْ نُنَبِّئُكُم بِالْأَخْسَرِينَ أَعْمَالًا﴾</p><section><h3>Traduction du sens</h3><p class=\"tr\">103. Dis : « Vous apprendrons-Nous donc qui seront les plus grands perdants quant à leurs œuvres ?</p><span class=\"cr\" dir=\"ltr\">French translation - Noor International Center — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Les paroles des deux imams sont données dans l&#x27;arabe original, mot pour mot, avec leurs références.</p><section><h2>Cheikh al-Islam Ibn Taymiyya</h2><h3>Ce qu&#x27;il a rapporté d&#x27;autrui</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">سعد بن أبي وقاص وغيره من السلف</span> <span class=\"st\">حكاه</span> «نزلت في أصحاب الصوامع والديارات.»<cite>«الفتاوى الكبرى لابن تيمية» 1/191</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=fr#s18a103\">Ouvrir dans le tafsir interactif (textes complets)</a><div class=\"pn\"><a href=\"/fr/ayah/18-102.html\">Verset précédent (18:102)</a><a href=\"/fr/ayah/18-104.html\">Verset suivant (18:104)</a></div></mai