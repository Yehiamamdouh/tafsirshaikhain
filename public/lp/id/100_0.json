\" href=\"https://tafsirshaikhain.com/de/ayah/100-6.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/100-6.html\">\n<meta property=\"og:title\" content=\"Tafsir Al-Aadiyaat 100:6 — menurut Ibnu Taimiyah dan Ibnul Qayyim\">\n<meta property=\"og:description\" content=\"sungguh, manusia itu sangat ingkar, (tidak bersyukur) kepada Tuhannya,\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Beranda\", \"item\": \"https://tafsirshaikhain.com/id/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Al-Aadiyaat\", \"item\": \"https://tafsirshaikhain.com/id/surah/100.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 6\", \"item\": \"https://tafsirshaikhain.com/id/ayah/100-6.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/id/\">Beranda</a> › <a href=\"/id/surah/100.html\">Surah Al-Aadiyaat</a> › Ayat 6</nav><h1>Tafsir Surah Al-Aadiyaat 100:6</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّ الْإِنسَانَ لِرَبِّهِ لَكَنُودٌ﴾</p><section><h3>Terjemah makna</h3><p class=\"tr\">sungguh, manusia itu sangat ingkar, (tidak bersyukur) kepada Tuhannya,</p><span class=\"cr\" dir=\"ltr\">Indonesian Translation - Ministry of Religious Affairs — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Perkataan kedua imam disajikan dalam bahasa Arab aslinya, apa adanya, beserta rujukannya.</p><section><h2>Imam Ibnul Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">فوجهه أن الكنود هو الكفور، وهو الذى يذكر المصائب، وينسى النعم، ولا ريب أن الحزن ينشأ عن هذين، ولا ريب أن الحزن الناشيء عن الكنود حزن ناشيء عن النفس الأمارة بالسوء<cite>«طريق الهجرتين وباب السعادتين» 1/343</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=id#s100a6\">Buka di tafsir interaktif (teks lengkap)</a><div class=\"pn\"><a href=\"/id/ayah/100-2.html\">Ayat sebelumnya (100:2)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/id/\">Beranda</a> · <a href=\"/about.html\">Tentang proyek</a> · <a href=\"/privacy.html\">Privasi &amp; ketentuan</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/100.html":"<!doctype html>\n<html lang=\"id\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir Surah Al-Aadiyaat — menurut Ibnu Taimiyah dan Ibnul Qayyim</title>\n<meta name=\"description\" content=\"Tafsir Surah Al-Aadiyaat — Makna Al-Qur&#x27;an dari perkataan Ibnu Taimiyah dan Ibnul Qayyim\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/id/surah/100.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/surah/100.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/surah/100.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/surah/100.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/surah/100.html\">\n<link rel=\"alternate\" hr