.com/id/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Al-Fil\", \"item\": \"https://tafsirshaikhain.com/id/surah/105.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 3\", \"item\": \"https://tafsirshaikhain.com/id/ayah/105-3.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/id/\">Beranda</a> › <a href=\"/id/surah/105.html\">Surah Al-Fil</a> › Ayat 3</nav><h1>Tafsir Surah Al-Fil 105:3</h1><p class=\"vt ar\" lang=\"ar\">﴿وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ﴾</p><section><h3>Terjemah makna</h3><p class=\"tr\">Dan Dia mengirimkan kepada mereka burung yang berbondong-bondong,</p><span class=\"cr\" dir=\"ltr\">Indonesian Translation - Ministry of Religious Affairs — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Perkataan kedua imam disajikan dalam bahasa Arab aslinya, apa adanya, beserta rujukannya.</p><section><h2>Imam Ibnul Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">وكذلك قوله: {وفي وفي عاد إذ أرسلنا عليهم الريح العقيم} أي سلطناها وسخرناها عليهم وكذلك قوله: {وأرسل عليهم طيرا أبابيل}<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/63</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=id#s105a3\">Buka di tafsir interaktif (teks lengkap)</a><div class=\"pn\"><a href=\"/id/ayah/105-1.html\">Ayat sebelumnya (105:1)</a><a href=\"/id/ayah/105-4.html\">Ayat berikutnya (10