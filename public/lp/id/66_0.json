/66.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/id/\">Beranda</a> › Surah At-Tahrim</nav><h1>Tafsir Surah At-Tahrim — menurut Ibnu Taimiyah dan Ibnul Qayyim</h1><section><p>Ayat-ayat yang memiliki penjelasan dalam surah ini:</p><div class=\"vl\"><a href=\"/id/ayah/66-1.html\">1</a><a href=\"/id/ayah/66-2.html\">2</a><a href=\"/id/ayah/66-5.html\">5</a><a href=\"/id/ayah/66-8.html\">8</a><a href=\"/id/ayah/66-11.html\">11</a><a href=\"/id/ayah/66-12.html\">12</a></div></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=id#s66a1\">Buka di tafsir interaktif (teks lengkap)</a></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/id/\">Beranda</a> · <a href=\"/about.html\">Tentang proyek</a> · <a href=\"/privacy.html\">Privasi &amp; ketentuan</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}