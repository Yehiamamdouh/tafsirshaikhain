\": \"https://tafsirshaikhain.com/id/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Beranda\", \"item\": \"https://tafsirshaikhain.com/id/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Ad-Dukhaan\", \"item\": \"https://tafsirshaikhain.com/id/surah/44.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 56\", \"item\": \"https://tafsirshaikhain.com/id/ayah/44-56.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/id/\">Beranda</a> › <a href=\"/id/surah/44.html\">Surah Ad-Dukhaan</a> › Ayat 56</nav><h1>Tafsir Surah Ad-Dukhaan 44:56</h1><p class=\"vt ar\" lang=\"ar\">﴿لَا يَذُوقُونَ فِيهَا الْمَوْتَ إِلَّا الْمَوْتَةَ الْأُولَىٰ وَوَقَاهُمْ عَذَابَ الْجَحِيمِ﴾</p><section><h3>Terjemah makna</h3><p class=\"tr\">Mereka tidak akan merasakan mati di dalamnya, selain kematian pertama (di dunia). Allah melindungi mereka dari azab neraka.</p><span class=\"cr\" dir=\"ltr\">Indonesian Translation - Ministry of Religious Affairs — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Perkataan kedua imam disajikan dalam bahasa Arab aslinya, apa adanya, beserta rujukannya.</p><section><h2>Syaikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">بل استعمل لفظ الذوق في النفي كما قال عن أهل النار: {لا يذوقون فيها بردا ولا شرابا} أي لا يحصل لهم من ذلك ولا ذوق.<cite>«مجموع الفتاوى» 7/111</cite></blockquote></section><section><h2>Imam Ibnul Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">وأما قوله: {لا يذوقون فيها الموت إلا الموتة الأولى} [الدخان: 56] فهذا الاستثناء هو لتحقيق دوام الحياة وعدم ذوق الموت<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/326</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">قوله تعالى: {لا يذوقون فيها الموت إلا الموتة الأولى} فهذا من الاستثناء السابق زمانه زمان المستثنى منه<cite>«بدائع الفوائد» 3/70</cite></blockquote><h3>Yang beliau nukil dari selainnya</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">بعضهم (إلا بمعنى بعد)</span> <span class=\"st\">أقرّه</span> «(إلا) بمعنى بعد والمعنى لا يذوقون بعد الموتة الأولى موتا في الجنة»<cite>«بدائع الفوائد» 3/70</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=id#s44a56\">Buka di tafsir interaktif (teks lengkap)</a><div class=\"pn\"><a href=\"/id/ayah/44-51.html\">Ayat sebelumnya (44:51)</a><a href=\"/id/ayah/44-58.html\">Ayat berikutnya (44:58)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/44-56.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/44-56.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/44-56.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <b lang=\"id\">Bahasa Indonesia</b> · <a href=\"/tr/ayah/44-56.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/44-56.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/44-56.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/44-56.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/44-56.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/44-56.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/44-56.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/44-56.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/44-56.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/44-56.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/44-56.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a></nav>\n<footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/id/\">Beranda</a> · <a href=\"/about.html\">Tentang proyek</a> · <a href=\"/privacy.html\">Privasi &amp; ketentuan</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n<script>try{localStorage.setItem(\"lang\",\"id\")}catch(e){}document.addEventListener(\"click\",function(e){var a=e.target.closest&&e.target.closest(\"[data-l]\");if(a)try{localStorage.setItem(\"lang\",a.dataset.l)}catch(x){}})</script>\n</body>\n</html>\n","ayah/44-58.html":"<!doctype html>\n<html lang=\"id\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir Ad-Dukhaan 44:58 — menurut Ibnu Taimiyah dan Ibnul Qayyim</title>\n<meta name=\"description\" content=\"Sungguh, Kami mudahkan Al-Qur`an itu dengan bahasamu agar mereka mendapat pelajaran.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/id/ayah/44-58.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/44-58.html\">\n<link rel=\"alternate\" h