15.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 40\", \"item\": \"https://tafsirshaikhain.com/id/ayah/15-40.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/id/\">Beranda</a> › <a href=\"/id/surah/15.html\">Surah Al-Hijr</a> › Ayat 40</nav><h1>Tafsir Surah Al-Hijr 15:40</h1><p class=\"vt ar\" lang=\"ar\">﴿إِلَّا عِبَادَكَ مِنْهُمُ الْمُخْلَصِينَ﴾</p><section><h3>Terjemah makna</h3><p class=\"tr\">kecuali hamba-hamba-Mu yang terpilih di antara mereka.&quot;</p><span class=\"cr\" dir=\"ltr\">Indonesian Translation - Ministry of Religious Affairs — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Perkataan kedua imam disajikan dalam bahasa Arab aslinya, apa adanya, beserta rujukannya.</p><section><h2>Syaikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">بمعنى العابد طوعا وهو الذى يعبده ويستعينه،<cite>«قاعدة جامعة في توحيد الله وإخلاص الوجه والعمل له عبادة واستعانة» 1/87</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=id#s15a40\">Buka di tafsir interaktif (teks lengkap)</a><div class=\"pn\"><a href=\"/id/ayah/15-39.html\">Ayat sebelumnya (15:39)</a><a href=\"/id/ayah/15-41.html\">Ayat berikutnya (15:41)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/id/\">Beranda</a> · <a href=\"/about.html\">Tentang proyek</a> · <a href=\"/privacy.html\">Privasi &amp; ketentuan</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/15-41.html":"<!doctype html>\n<html lang=\"id\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir Al-Hijr 15:41 — menurut Ibnu Taimiyah dan Ibnul Qayyim</title>\n<meta name=\"description\" content=\"Dia (Allah) berfirman, &quot;Ini adalah jalan yang lurus (menuju) kepada-Ku.&quot;\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/id/ayah/15-41.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/15-41.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/15-41.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/15-41.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/15-41.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/15-41.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/15-41.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/15-41.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/15-41.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/15-41.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/15-41.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/15-41.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/15-41.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/15-41.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/15-41.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/15-41.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/15-41.html\">\n<meta property=\"og:title\" content=\"Tafsir Al-Hijr 15:41 — menurut Ibnu Taimiyah dan Ibnul Qayyim\">\n<meta property=\"og:description\" content=\"Dia (Allah) berfirman, &quot;Ini adalah jalan yang lurus (menuju) kepada-Ku.&quot;\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Beranda\", \"item\": \"https://tafsirshaikhain.com/id/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Al-Hijr\", \"item\": \"https://tafsirshaikhain.com/id/surah/15.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 41\", \"item\": \"https://tafsirshaikhain.com/id/ayah/15-41.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/id/\">Beranda</a> › <a href=\"/id/surah/15.html\">Surah Al-Hijr</a> › Ayat 41</nav><h1>Tafsir Surah Al-Hijr 15:41</h1><p class=\"vt ar\" lang=\"ar\">﴿قَالَ هَٰذَا صِرَاطٌ عَلَيَّ مُسْتَقِيمٌ﴾</p><section><h3>Terjemah makna</h3><p class=\"tr\">Dia (Allah) berfirman, &quot;Ini adalah jalan yang lurus (menuju) kepada-Ku.&quot;</p><span class=\"cr\" dir=\"ltr\">Indonesian Translation - Ministry of Religious Affairs — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Perkataan kedua imam disajikan dalam bahasa Arab aslinya, apa adanya, beserta rujukannya.</p><section><h2>Syaikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">وقوله هذا إشارة إلى ما تقدم ذكره وهو قوله {إلا عبادك منهم المخلصين} فتعبد العباد له بإخلاص الدين له: طريق يدل عليه وهو طريق مستقيم.<cite>«مجموع الفتاوى» 15/207</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فالهدى وقصد السبيل والصراط المستقيم إنما يدل على عبادته وطاعته - لا يدل على معصيته وطاعة الشيطان.<cite>«مجموع الفتاوى» 15/214</cite></blockquote><h3>Yang beliau nukil dari selainnya</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">البغوي (قولان في: صراط عليّ)</span> <span class=\"st\">حكاه</span> «أي على أمري وإرادتي. وقيل: هو على التهديد كما يقال &quot; علي طريقك وإلي مصيرك &quot;.»<cite>«مجموع الفتاوى» 15/203</cite></blockquote></section><section><h2>Imam Ibnul Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">والسياق يأبى هذا، ولا يناسبه لمن تأمله، فإنه قاله مجيبا لإبليس الذي قال {لأغوينهم أجمعين إلا عبادك منهم المخلصين} [ص: 82] فإنه لا سبيل لي إلى إغوائهم، ولا طريق لي عليهم.<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/40</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">والثاني: أنه أراد التفسير على المعنى، وهو الأشبه بطريق السلف، أي صراط موصل إلي،<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/38</cite></blockquote><h3>Yang beliau nukil dari selainnya</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الكسائي</span> <span class=\"st\">ردّه</span> «وهو قول الكسائي إنه على التهديد والوعيد»<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/40</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الفراء</span> <span class=\"st\">حكاه</span> «يقول مرجعهم إلي فأجازيهم»<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/87</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الكسائي</span> <span class=\"st\">ردّه</span> «إنه على التهديد والوعيد، نظير قوله {إن ربك لبالمرصاد} [الفجر: 14]»<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/40</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الحسن</span> <span class=\"st\">أقرّه</span> «معناه صراط إلي مستقيم»<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/38</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">مجاهد</span> <span class=\"st\">أقرّه</span> «الحق يرجع إلى الله، وعليه طريقه، لا يعرج على شيء»<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/38</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=id#s15a41\">Buka di tafsir interaktif (teks lengkap)</a><div class=\"pn\"><a href=\"/id/ayah/15-40.html\">Ayat sebelumnya (15:40)</a><a href=\"/id/ayah/15-42.html\">Ayat berikutnya (15:42)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/id/\">Beranda</a> · <a href=\"/about.html\">Tentang proyek</a> · <a href=\"/privacy.html\">Privasi &amp; ketentuan</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/15-42.html":"<!doctype html>\n<html lang=\"id\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir Al-Hijr 15:42 — menurut Ibnu Taimiyah dan Ibnul Qayyim</title>\n<meta name=\"description\" content=\"Sesungguhnya kamu (Iblis) tidak kuasa atas hamba-hamba-Ku, kecuali mereka yang mengikutimu, yaitu orang yang sesat.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/id/ayah/15-42.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/15-42.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/15-42.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/15-42.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/15-42.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/15-42.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/15-42.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/15-42.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/15-42.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/15-42.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/15-42.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/15-42.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/15-42.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/15-42.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/15-42.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/15-42.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/15-42.html\">\n<meta property=\"og:title\" content=\"Tafsir Al-Hijr 15:42 — menurut Ibnu Taimiyah dan Ibnul Qayyim\">\n<meta property=\"og:description\" content=\"Sesungguhnya kamu (Iblis) tidak kuasa atas hamba-hamba-Ku, kecuali mereka yang mengikutimu, yaitu orang yang sesat.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Beranda\", \"item\": \"https://tafsirshaikhain.com/id/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Al-Hijr\", \"item\": \"https://tafsirshaikhain.com/id/surah/15.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 42\", \"item\": \"https://tafsirshaikhain.com/id/ayah/15-42.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/id/\">Beranda</a> › <a href=\"/id/surah/15.html\">Surah Al-Hijr</a> › Ayat 42</nav><h1>Tafsir Surah Al-Hijr 15:42</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّ عِبَادِي لَيْسَ لَكَ عَلَيْهِمْ سُلْطَانٌ إِلَّا مَنِ اتَّبَعَكَ مِنَ الْغَاوِينَ﴾</p><section><h3>Terjemah makna</h3><p class=\"tr\">Sesungguhnya kamu (Iblis) tidak kuasa atas hamba-hamba-Ku, kecuali mereka yang mengikutimu, yaitu orang yang sesat.</p><span class=\"cr\" dir=\"ltr\">Indonesian Translation - Ministry of Religious Affairs — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Perkataan kedua imam disajikan dalam bahasa Arab aslinya, apa adanya, beserta rujukannya.</p><section><h2>Syaikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">ولهذا قال بعده {إن عبادي ليس لك عليهم سلطان.}<cite>«مجموع الفتاوى» 15/207</cite></blockquote></section><section><h2>Imam Ibnul Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">وعزل الشيطان عن سلطانه عليهم خاصة، وجعل سلطانه على من تولاه وأشرك به،<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/123</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=id#s15a42\">Buka di tafsir interaktif (teks lengkap)</a><div class=\"pn\"><a href=\"/id/ayah/15-41.html\">Ayat sebelumnya (15:41)</a><a href=\"/id/ayah/15-72.html\">Ayat berikutnya (15:72)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/id/\">Beranda</a> · <a href=\"/about.html\">Tentang proyek</a> · <a href=\"/privacy.html\">Privasi &amp; ketentuan</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/15.html":"<!doctype html>\n<html lang=\"id\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir Surah Al-Hijr — menurut Ibnu Taimiyah dan Ibnul Qayyim</title>\n<meta name=\"description\" content=\"Tafsir Surah Al-Hijr — Makna Al-Qur&#x27;an dari perkataan Ibnu Taimiyah dan Ibnul Qayyim\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/id/surah/15.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/surah/15.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/surah/15.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/surah/15.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/surah/15.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/surah/15.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/surah/15.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/surah/15.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/surah/15.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/surah/15.html\">\n<link rel=\"alternate\" hreflan