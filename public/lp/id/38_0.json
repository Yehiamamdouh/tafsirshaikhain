\"item\": \"https://tafsirshaikhain.com/id/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Saad\", \"item\": \"https://tafsirshaikhain.com/id/surah/38.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 45\", \"item\": \"https://tafsirshaikhain.com/id/ayah/38-45.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/id/\">Beranda</a> › <a href=\"/id/surah/38.html\">Surah Saad</a> › Ayat 45</nav><h1>Tafsir Surah Saad 38:45</h1><p class=\"vt ar\" lang=\"ar\">﴿وَاذْكُرْ عِبَادَنَا إِبْرَاهِيمَ وَإِسْحَاقَ وَيَعْقُوبَ أُولِي الْأَيْدِي وَالْأَبْصَارِ﴾</p><section><h3>Terjemah makna</h3><p class=\"tr\">Dan ingatlah hamba-hamba Kami: Ibrahim, Ishak dan Yakub yang mempunyai kekuatan-kekuatan yang besar dan ilmu-ilmu (yang tinggi).</p><span class=\"cr\" dir=\"ltr\">Indonesian Translation - Ministry of Religious Affairs — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Perkataan kedua imam disajikan dalam bahasa Arab aslinya, apa adanya, beserta rujukannya.</p><section><h2>Syaikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">فالعلم النافع هو أصل الهدى والعمل بالحق هو الرشاد<cite>«مجموع الفتاوى» 10/40</cite></blockquote><h3>Yang beliau nukil dari selainnya</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن عباس</span> <span class=\"st\">أقرّه</span> «أولوا القوة في العبادة»<cite>«مجموع الفتاوى» 19/170</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">سعيد بن جبير وعطاء الخراساني والحسن والضحاك والسدي وقتادة وأبو سنان ومبشر بن عبيد</span> <span class=\"st\">حكاه</span> «قال ابن أبي حاتم: وروي عن سعيد بن جبير وعطاء الخراساني والحسن والضحاك والسدي وقتادة وأبي سنان ومبشر بن عبيد نحو ذلك.»<cite>«مجموع الفتاوى» 19/170</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن عباس</span> <span class=\"st\">حكاه</span> «و (الأبصار) قال: الأبصار الفقه في الدين.»<cite>«مجموع الفتاوى» 19/170</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">مجاهد</span> <span class=\"st\">حكاه</span> «وقال مجاهد: (الأبصار) الصواب في الحكم»<cite>«مجموع الفتاوى» 19/170</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">سعيد بن جبير</span> <span class=\"st\">حكاه</span> «وعن سعيد بن جبير قال: البصيرة بدين الله وكتابه.»<cite>«مجموع الفتاوى» 19/170</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">قتادة</span> <span class=\"st\">حكاه</span> «وروي عن قتادة قال: أعطوا قوة في العبادة وبصرا في الدين.»<cite>«مجموع الفتاوى» 19/170</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=id#s38a45\">Buka di tafsir interaktif (teks lengkap)</a><div class=\"pn\"><a href=\"/id/ayah/38-28.html\">Ayat sebelumnya (38:28)</a><a href=\"/id/ayah/38-54.html\">Ayat berikutnya (38:54)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/id/\">Beranda</a> · <a href=\"/about.html\">Tentang proyek</a> · <a href=\"/privacy.html\">Privasi &amp; ketentuan</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/38.html":"<!doctype html>\n<html lang=\"id\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir Surah Saad — menurut Ibnu Taimiyah dan Ibnul Qayyim</title>\n<meta name=\"descripti