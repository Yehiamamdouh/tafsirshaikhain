ion\": 1, \"name\": \"Beranda\", \"item\": \"https://tafsirshaikhain.com/id/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Ash-Shu'araa\", \"item\": \"https://tafsirshaikhain.com/id/surah/26.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 192\", \"item\": \"https://tafsirshaikhain.com/id/ayah/26-192.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/id/\">Beranda</a> › <a href=\"/id/surah/26.html\">Surah Ash-Shu&#x27;araa</a> › Ayat 192</nav><h1>Tafsir Surah Ash-Shu&#x27;araa 26:192</h1><p class=\"vt ar\" lang=\"ar\">﴿وَإِنَّهُ لَتَنزِيلُ رَبِّ الْعَالَمِينَ﴾</p><section><h3>Terjemah makna</h3><p class=\"tr\">Dan sungguh, (Al-Qur`an) ini benar-benar diturunkan oleh Tuhan seluruh alam,</p><span class=\"cr\" dir=\"ltr\">Indonesian Translation - Ministry of Religious Affairs — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Perkataan kedua imam disajikan dalam bahasa Arab aslinya, apa adanya, beserta rujukannya.</p><section><h2>Syaikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">فجمع بين قوله: {إنه لقول رسول كريم} وبين قوله: {وإنه لتنزيل رب العالمين} والضميران عائدان إلى واحد فلو كان الرسول أحدثه وأنشأه لم يكن تنزيلا من رب العالمين؛ بل كان يكون تنزيلا من الرسول.<cite>«مجموع الفتاوى» 12/271</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=id#s26a192\">Buka di tafsir interaktif (teks lengkap)</a><div class=\"pn\"><a href=\"/id/ayah/26-189.html\">Ayat sebelumnya (26:189)</a><a href=\"/id/ayah/26-193.html\">Ayat berikutnya (26:193)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/id/\">Beranda</a> · <a href=\"/about.html\">Tentang proyek</a> · <a href=\"/privacy.html\">Privasi &amp; ketentuan</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/26-193.html":"<!doctype html>\n<html lang=\"id\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir Ash-Shu&#x27;araa 26:193 — menurut Ibnu Taimiyah dan Ibnul Qayyim</title>\n<meta name=\"description\" content=\"Yang dibawa turun oleh Ar-Rūḥ Al-Amīn (Jibril),\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/id/ayah/26-193.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/26-193.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/26-193.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/26-193.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/26-193.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/26-193.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/26-193.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/26-193.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/26-193.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/26-193.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/26-193.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/26-193.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/26-193.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/26-193.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/26-193.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/26-193.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/26-193.html\">\n<meta property=\"og:title\" content=\"Tafsir Ash-Shu&#x27;araa 26:193 — menurut Ibnu Taimiyah dan Ibnul Qayyim\">\n<meta property=\"og:description\" content=\"Yang dibawa turun oleh Ar-Rūḥ Al-Amīn (Jibril),\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Beranda\", \"item\": \"https://tafsirshaikhain.com/id/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Ash-Shu'araa\", \"item\": \"https://tafsirshaikhain.com/id/surah/26.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 193\", \"item\": \"https://tafsirshaikhain.com/id/ayah/26-193.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/id/\">Beranda</a> › <a href=\"/id/surah/26.html\">Surah Ash-Shu&#x27;araa</a> › Ayat 193</nav><h1>Tafsir Surah Ash-Shu&#x27;araa 26:193</h1><p class=\"vt ar\" lang=\"ar\">﴿نَزَلَ بِهِ الرُّوحُ الْأَمِينُ﴾</p><section><h3>Terjemah makna</h3><p class=\"tr\">Yang dibawa turun oleh Ar-Rūḥ Al-Amīn (Jibril),</p><span class=\"cr\" dir=\"ltr\">Indonesian Translation - Ministry of Religious Affairs — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Perkataan kedua imam disajikan dalam bahasa Arab aslinya, apa adanya, beserta rujukannya.</p><section><h2>Syaikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">أي أنه مؤتمن لا يزيد ولا ينقص؛ فإن الخائن قد يغير الرسالة.<cite>«مجموع الفتاوى» 15/221</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وروح القدس هو جبريل كما قال في الآية الأخرى {نزل به الروح الأمين} {على قلبك}<cite>«مجموع الفتاوى» 12/519</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=id#s26a193\">Buka di tafsir interaktif (teks lengkap)</a><div class=\"pn\"><a href=\"/id/ayah/26-192.html\">Ayat sebelumnya (26:192)</a><a href=\"/id/ayah/26-196.html\">Ayat berikutnya (26:196)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/id/\">Beranda</a> · <a href=\"/about.html\">Tentang proyek</a> · <a href=\"/privacy.html\">Privasi &amp; ketentuan</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/26-196.html":"<!doctype html>\n<html lang=\"id\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir Ash-Shu&#x27;araa 26:196 — menurut Ibnu Taimiyah dan Ibnul Qayyim</title>\n<meta name=\"description\" content=\"Dan sungguh, (Al-Qur`an) itu (disebut) dalam kitab-kitab orang yang terdahulu.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/id/ayah/26-196.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/26-196.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/26-196.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/26-196.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/26-196.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/26-196.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/26-196.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/26-196.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/26-196.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/26-196.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/26-196.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/26-196.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/26-196.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/26-196.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/26-196.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/26-196.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/26-196.html\">\n<meta property=\"og:title\" content=\"Tafsir Ash-Shu&#x27;araa 26:196 — menurut Ibnu Taimiyah dan Ibnul Qayyim\">\n<meta property=\"og:description\" content=\"Dan sungguh, (Al-Qur`an) itu (disebut) dalam kitab-kitab orang yang terdahulu.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Beranda\", \"item\": \"https://tafsirshaikhain.com/id/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Ash-Shu'araa\", \"item\": \"https://tafsirshaikhain.com/id/surah/26.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 196\", \"item\": \"https://tafsirshaikhain.com/id/ayah/26-196.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/id/\">Beranda</a> › <a href=\"/id/surah/26.html\">Surah Ash-Shu&#x27;araa</a> › Ayat 196</nav><h1>Tafsir Surah Ash-Shu&#x27;araa 26:196</h1><p class=\"vt ar\" lang=\"ar\">﴿وَإِنَّهُ لَفِي زُبُرِ الْأَوَّلِينَ﴾</p><section><h3>Terjemah makna</h3><p class=\"tr\">Dan sungguh, (Al-Qur`an) itu (disebut) dalam kitab-kitab orang yang terdahulu.</p><span class=\"cr\" dir=\"ltr\">Indonesian Translation - Ministry of Religious Affairs — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Perkataan kedua imam disajikan dalam bahasa Arab aslinya, apa adanya, beserta rujukannya.</p><section><h2>Syaikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">فإن المراد بذلك ذكره وكتابته.<cite>«مجموع الفتاوى» 12/386</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">و &quot; الزبر &quot; جمع زبور والزبور فعول بمعنى مفعول أي مزبور أي: مكتوب فلفظ الزبور يدل على الكتابة<cite>«مجموع الفتاوى» 12/386</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فالقرآن نفسه ليس عند بني إسرائيل ولكن ذكره كما أن محمدا نفسه ليس عندهم ولكن ذكره فثبوت الرسول في كتبهم كثبوت القرآن في كتبهم؛ بخلاف ثبوت القرآن في اللوح المحفوظ وفي المصاحف؛ فإن نفس القرآن أثبت فيها<cite>«مجموع الفتاوى» 12/290</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=id#s26a196\">Buka di tafsir interaktif (teks lengkap)</a><div class=\"pn\"><a href=\"/id/ayah/26-193.html\">Ayat sebelumnya (26:193)</a><a href=\"/id/ayah/26-200.html\">Ayat berikutnya (26:200)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/id/\">Beranda</a> · <a href=\"/about.html\">Tentang proyek</a> · <a href=\"/privacy.html\">Privasi &amp; ketentuan</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}