ntent=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Beranda\", \"item\": \"https://tafsirshaikhain.com/id/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Ash-Shu'araa\", \"item\": \"https://tafsirshaikhain.com/id/surah/26.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 197\", \"item\": \"https://tafsirshaikhain.com/id/ayah/26-197.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/id/\">Beranda</a> › <a href=\"/id/surah/26.html\">Surah Ash-Shu&#x27;araa</a> › Ayat 197</nav><h1>Tafsir Surah Ash-Shu&#x27;araa 26:197</h1><p class=\"vt ar\" lang=\"ar\">﴿أَوَلَمْ يَكُن لَّهُمْ آيَةً أَن يَعْلَمَهُ عُلَمَاءُ بَنِي إِسْرَائِيلَ﴾</p><section><h3>Terjemah makna</h3><p class=\"tr\">Apakah tidak (cukup) menjadi bukti bagi mereka, bahwa para ulama Bani Israil mengetahuinya?</p><span class=\"cr\" dir=\"ltr\">Indonesian Translation - Ministry of Religious Affairs — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Perkataan kedua imam disajikan dalam bahasa Arab aslinya, apa adanya, beserta rujukannya.</p><section><h2>Syaikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">وهذا غير شهادة أهل الكتاب له نفسه بما يجدونه من نعته في كتبهم كقوله تعالى: {أولم يكن لهم آية أن يعلمه علماء بني إسرائيل} وقوله تعالى {والذين آتيناهم الكتاب يعلمون أنه منزل من ربك بالحق} وأمثال ذلك.<cite>«مجموع الفتاوى» 19/12</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">إلى أمثال ذلك مما يخاطبهم باستفهام التقرير المتضمن إقرارهم واعترافهم بالمقدمات البرهانية التي تدل على المطلوب فهو من أحسن جدل بالبرهان؛<cite>«مجموع الفتاوى» 19/165</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=id#s26a197\">Buka di tafsir interaktif (teks lengkap)</a><div class=\"pn\"><a href=\"/id/ayah/26-196.html\">Ayat sebelumnya (26:196)</a><a href=\"/id/ayah/26-200.html\">Ayat berikutnya (26:200)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/id/\">Beranda</a> · <a href=\"/about.html\">Tentang proyek</a> · <a href=\"/privacy.html\">Privasi &amp; ketentuan</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}