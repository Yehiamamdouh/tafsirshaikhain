1.html\">\n<meta property=\"og:title\" content=\"Tafsir Al-Kawthar 108:1 — menurut Ibnu Taimiyah dan Ibnul Qayyim\">\n<meta property=\"og:description\" content=\"Sungguh, Kami telah memberimu (Muhammad) nikmat yang banyak.\">\n<meta property=\"og:url\" content=\"https://tafsirshaikhain.com/id/ayah/108-1.html\">\n<meta property=\"og:site_name\" content=\"Tafsir al-Syaikhain\">\n<meta property=\"og:locale\" content=\"id_ID\">\n<meta property=\"og:type\" content=\"article\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta property=\"og:image:width\" content=\"1200\">\n<meta property=\"og:image:height\" content=\"630\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<link rel=\"manifest\" href=\"/manifest.webmanifest\">\n<link rel=\"apple-touch-icon\" href=\"/icon-192.png\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"Tafsir Al-Kawthar 108:1 — menurut Ibnu Taimiyah dan Ibnul Qayyim\", \"description\": \"Sungguh, Kami telah memberimu (Muhammad) nikmat yang banyak.\", \"inLanguage\": \"id\", \"url\": \"https://tafsirshaikhain.com/id/ayah/108-1.html\", \"mainEntityOfPage\": \"https://tafsirshaikhain.com/id/ayah/108-1.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"Syaikhul Islam Ibnu Taimiyah\"}, {\"@type\": \"Person\", \"name\": \"Imam Ibnul Qayyim\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"Tafsir al-Syaikhain\", \"url\": \"https://tafsirshaikhain.com/id/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Beranda\", \"item\": \"https://tafsirshaikhain.com/id/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Al-Kawthar\", \"item\": \"https://tafsirshaikhain.com/id/surah/108.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 1\", \"item\": \"https://tafsirshaikhain.com/id/ayah/108-1.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/id/\">Beranda</a> › <a href=\"/id/surah/108.html\">Surah Al-Kawthar</a> › Ayat 1</nav><h1>Tafsir Surah Al-Kawthar 108:1</h1><p class=\"vt ar\" lang=\"ar\">﴿بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ إِنَّا أَعْطَيْنَاكَ الْكَوْثَرَ﴾</p><section><h3>Terjemah makna</h3><p class=\"tr\">Sungguh, Kami telah memberimu (Muhammad) nikmat yang banyak.</p><span class=\"cr\" dir=\"ltr\">Indonesian Translation - Ministry of Religious Affairs — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Perkataan kedua imam disajikan dalam bahasa Arab aslinya, apa adanya, beserta rujukannya.</p><section><h2>Syaikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">تدل هذه الآية على عطية كثيرة صادرة عن معط كبير غني واسع.<cite>«مجموع الفتاوى» 16/529</cite></blockquote></section><section><h2>Imam Ibnul Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">وإذا كان المقصود ذكرهما ذكرا معا كقوله تعالى {إنا أعطيناك الكوثر} الكوثر 1 فإن المقصود إخباره لرسوله صلى الله عليه وسلم بما خصه به وأعطاه إياه من الكوثر ولا يتم هذا إلا بذكر المفعولين<cite>«جلاء الأفهام في فضل الصلاة على محمد خير الأنام» 1/460</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=id#s108a1\">Buka di tafsir interaktif (teks lengkap)</a><div class=\"pn\"><span></span><a href=\"/id/ayah/108-2.html\">Ayat berikutnya (108:2)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/108-1.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/108-1.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/108-1.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <b lang=\"id\">Bahasa Indonesia</b> · <a href=\"/tr/ayah/108-1.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/108-1.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/108-1.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/108-1.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/108-1.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/108-1.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/108-1.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/108-1.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/108-1.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/108-1.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/108-1.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a></nav>\n<footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/id/\">Beranda</a> · <a href=\"/about.html\">Tentang proyek