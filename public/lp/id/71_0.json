m/ru/ayah/71-23.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/71-23.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/71-23.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/71-23.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/71-23.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/71-23.html\">\n<meta property=\"og:title\" content=\"Tafsir Nooh 71:23 — menurut Ibnu Taimiyah dan Ibnul Qayyim\">\n<meta property=\"og:description\" content=\"Dan mereka berkata, &quot;Jangan sekali-kali kamu meninggalkan (penyembahan) tuhan-tuhan kamu dan jangan pula sekali-kali kamu meninggalkan (penyembahan) Wadd, \">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Beranda\", \"item\": \"https://tafsirshaikhain.com/id/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Nooh\", \"item\": \"https://tafsirshaikhain.com/id/surah/71.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 23\", \"item\": \"https://tafsirshaikhain.com/id/ayah/71-23.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/id/\">Beranda</a> › <a href=\"/id/surah/71.html\">Surah Nooh</a> › Ayat 23</nav><h1>Tafsir Surah Nooh 71:23</h1><p class=\"vt ar\" lang=\"ar\">﴿وَقَالُوا لَا تَذَرُنَّ آلِهَتَكُمْ وَلَا تَذَرُنَّ وَدًّا وَلَا سُوَاعًا وَلَا يَغُوثَ وَيَعُوقَ وَنَسْرًا﴾</p><section><h3>Terjemah makna</h3><p class=\"tr\">Dan mereka berkata, &quot;Jangan sekali-kali kamu meninggalkan (penyembahan) tuhan-tuhan kamu dan jangan pula sekali-kali kamu meninggalkan (penyembahan) Wadd, dan jangan pula Suwā&#x27;, Yagūṡ, Ya&#x27;ūq dan Nasr.&quot;871)</p><span class=\"cr\" dir=\"ltr\">Indonesian Translation - Ministry of Religious Affairs — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Perkataan kedua imam disajikan dalam bahasa Arab aslinya, apa adanya, beserta rujukannya.</p><section><h2>Syaikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">فإن هؤلاء كانوا قوما صالحين في قوم نوح. فلما ماتوا عكفوا على قبورهم ثم صوروهم ثم اتخذوا الأصنام على صورهم كما تقدم ذكر ذلك عن ابن عباس وغيره من علماء السلف.<cite>«مجموع الفتاوى» 1/357</cite></blockquote><h3>Yang beliau nukil dari selainnya</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن عباس وغيره من السلف</span> <span class=\"st\">استشهد به</span> «أن هذه أسماء قوم صالحين، كانوا في قوم نوح، فلما ماتوا عكفوا على قبورهم، وصوروا تماثيلهم، ثم طال عليهم الأمد فعبدوهم»<cite>«اقتضاء الصراط المستقيم لمخالفة أصحاب الجحيم» 2/300</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن عباس وغيره من السلف</span> <span class=\"st\">أقرّه</span> «أن هذه أسماء قوم صالحين، كانوا في قوم نوح، فلما ماتوا عكفوا على قبورهم، وصوروا تماثيلهم»<cite>«اقتضاء الصراط المستقيم لمخالفة أصحاب الجحيم» 2/300</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن عباس وغيره</span> <span class=\"st\">أقرّه</span> «هؤلاء قوم صالحون كانوا في قوم نوح فلما ماتوا عكفوا على قبورهم ثم صوروا تماثيلهم فعبدوهم»<cite>«مجموع الفتاوى» 1/151</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=id#s71a23\">Buka di tafsir interaktif (teks lengkap)</a><div class=\"pn\"><a href=\"/id/ayah/71-17.html\">Ayat sebelumnya (71:17)</a><a href=\"/id/ayah/71-28.html\">Ayat berikutnya (71:28)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/id/\">Beranda</a> · <a href=\"/about.html\">Tentang proyek</a> · <a href=\"/privacy.html\">Privasi &amp; ketentuan</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/71-28.html":"<!doctype html>\n<html lang=\"id\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir Nooh 71:28 — menurut Ibnu Taimiyah dan Ibnul Qayyim</title>\n<meta name=\"description\" content=\"Ya Tuhanku, ampunilah aku, ibu bapakku, dan siapa pun yang memasuki rumahku dengan beriman dan semua orang yang beriman laki-laki dan perempuan. Dan jangan\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/id/ayah/71-28.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/71-28.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/71-28.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/71-28.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/71-28.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/71-28.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/71-28.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/71-28.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/71-28.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/71-28.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/71-28.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/71-28.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/71-28.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/71-28.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/71-28.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/71-28.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/71-28.html\">\n<meta property=\"og:title\" content=\"Tafsir Nooh 71:28 — menurut Ibnu Taimiyah dan Ibnul Qayyim\">\n<meta property=\"og:description\" content=\"Ya Tuhanku, ampunilah aku, ibu bapakku, dan siapa pun yang memasuki rumahku dengan beriman dan semua orang yang beriman laki-laki dan perempuan. Dan jangan\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Beranda\", \"item\": \"https://tafsirshaikhain.com/id/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Nooh\", \"item\": \"https://tafsirshaikhain.com/id/surah/71.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 28\", \"item\": \"https://tafsirshaikhain.com/id/ayah/71-28.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/id/\">Beranda</a> › <a href=\"/id/surah/71.html\">Surah Nooh</a> › Ayat 28</nav><h1>Tafsir Surah Nooh 71:28</h1><p class=\"vt ar\" lang=\"ar\">﴿رَّبِّ اغْفِرْ لِي وَلِوَالِدَيَّ وَلِمَن دَخَلَ بَيْتِيَ مُؤْمِنًا وَلِلْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ وَلَا تَزِدِ الظَّالِمِينَ إِلَّا تَبَارًا﴾</p><section><h3>Terjemah makna</h3><p class=\"tr\">Ya Tuhanku, ampunilah aku, ibu bapakku, dan siapa pun yang memasuki rumahku dengan beriman dan semua orang yang beriman laki-laki dan perempuan. Dan janganlah Engkau tambahkan bagi orang-orang yang zalim itu selain kehancuran.&quot;</p><span class=\"cr\" dir=\"ltr\">Indonesian Translation - Ministry of Religious Affairs — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Perkataan kedua imam disajikan dalam bahasa Arab aslinya, apa adanya, beserta rujukannya.</p><section><h2>Syaikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">فقد ذكر استغفار الرسل للمؤمنين، أمرا بذلك، وإخبارا عنهم بذلك.<cite>«الفتاوى الكبرى لابن تيمية» 3/28</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">و &quot; الرب &quot; هو المربي الخالق الرازق الناصر الهادي وهذا الاسم أحق باسم الاستعانة والمسألة.<cite>«مجموع الفتاوى» 14/13</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=id#s71a28\">Buka di tafsir interaktif (teks lengkap)</a><div class=\"pn\"><a href=\"/id/ayah/71-23.html\">Ayat sebelumnya (71:23)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/id/\">Beranda</a> · <a href=\"/about.html\">Tentang proyek</a> · <a href=\"/p