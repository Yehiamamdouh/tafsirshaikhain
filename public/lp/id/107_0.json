"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 5\", \"item\": \"https://tafsirshaikhain.com/id/ayah/107-5.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/id/\">Beranda</a> › <a href=\"/id/surah/107.html\">Surah Al-Maa&#x27;un</a> › Ayat 5</nav><h1>Tafsir Surah Al-Maa&#x27;un 107:5</h1><p class=\"vt ar\" lang=\"ar\">﴿الَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ﴾</p><section><h3>Terjemah makna</h3><p class=\"tr\">(yaitu) orang-orang yang lalai terhadap salatnya,927)</p><span class=\"cr\" dir=\"ltr\">Indonesian Translation - Ministry of Religious Affairs — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Perkataan kedua imam disajikan dalam bahasa Arab aslinya, apa adanya, beserta rujukannya.</p><section><h2>Syaikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">وقد فسر السلف السهو عنها بتأخيرها عن وقتها، وبترك ما يؤمر به فيه<cite>«الفتاوى الكبرى لابن تيمية» 4/456</cite></blockquote><h3>Yang beliau nukil dari selainnya</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">السلف</span> <span class=\"st\">أقرّه</span> «وقد فسر السلف السهو عنها بتأخيرها عن وقتها، وبترك ما يؤمر به فيه»<cite>«الفتاوى الكبرى لابن تيمية» 4/456</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">طائفة من السلف</span> <span class=\"st\">أقرّه</span> «هم الذين يؤخرونها عن وقتها.»<cite>«مجموع الفتاوى» 22/29</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">بعض السلف</span> <span class=\"st\">حكاه</span> «هم الذين لا يؤدونها على الوجه المأمور به.»<cite>«مجموع الفتاوى» 22/29</cite></blockquote></section><section><h2>Imam Ibnul Qayyim</h2><h3>Yang beliau nukil dari selainnya</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">سعد بن أبي وقاص ومسروق بن الأجدع وغيرهما</span> <span class=\"st\">استشهد به</span> «هو تركها حتى يخرج وقتها»<cite>«الصلاة وأحكام تاركها» 1/46</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">سعد بن أبي وقاص</span> <span class=\"st\">استشهد به</span> «إنه ليس ذاك ولكنه إضاعة الوقت»<cite>«الصلاة وأحكام تاركها» 1/46</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">محمد بن كعب القرظي</span> <span class=\"st\">استشهد به</span> «هو تاركها»<cite>«الصلاة وأحكام تاركها» 1/46</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">النبي صلى الله عليه وسلم</span> <span class=\"st\">استشهد به</span> «هم الذين يؤخرون الصلاة عن وقتها»<cite>«الصلاة وأحكام تاركها» 1/46</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=id#s107a5\">Buka di tafsir interaktif (teks lengkap)</a><div class=\"pn\"><span></span><a href=\"/id/ayah/107-6.html\">Ayat berikutnya (107:6)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/107-5.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/107-5.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/107-5.html\" hreflang=