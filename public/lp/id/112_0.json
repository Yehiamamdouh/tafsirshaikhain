ed)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/id/\">Beranda</a> › <a href=\"/id/surah/112.html\">Surah Al-Ikhlaas</a> › Ayat 3</nav><h1>Tafsir Surah Al-Ikhlaas 112:3</h1><p class=\"vt ar\" lang=\"ar\">﴿لَمْ يَلِدْ وَلَمْ يُولَدْ﴾</p><section><h3>Terjemah makna</h3><p class=\"tr\">(Allah) tidak beranak dan tidak pula diperanakkan.</p><span class=\"cr\" dir=\"ltr\">Indonesian Translation - Ministry of Religious Affairs — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Perkataan kedua imam disajikan dalam bahasa Arab aslinya, apa adanya, beserta rujukannya.</p><section><h2>Syaikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">فاسمه (الأحد دل على نفي المشاركة والمماثلة واسمه (الصمد دل على أنه مستحق لجميع صفات الكمال<cite>«مجموع الفتاوى» 17/107</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=id#s112a3\">Buka di tafsir interaktif (teks lengkap)</a><div class=\"pn\"><a href=\"/id/ayah/112-2.html\">Ayat sebelumnya (112:2)</a><a href=\"/id/ayah/112-4.html\">Ayat berikutnya (112:4)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/id/\">Beranda</a> · <a href=\"/about.html\">Tentang proyek</a> · <a href=\"/privacy.html\">Privasi &amp; ketentuan</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/112-4.html":"<!doctype html>\n<html lang=\"id\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir Al-Ikhlaas 112:4 — menurut Ibnu Taimiyah dan Ibnul Qayyim</title>\n<meta name=\"description\" content=\"Dan tidak ada sesuatu yang setara dengan Dia.&quot;\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/id/ayah/112-4.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/112-4.html\">\n<link rel=\"alternate\" hreflang=\"x-