ml\">\n<meta property=\"og:title\" content=\"Tafsir An-Nasr 110:3 — menurut Ibnu Taimiyah dan Ibnul Qayyim\">\n<meta property=\"og:description\" content=\"Maka bertasbihlah dengan memuji Tuhanmu dan mohonlah ampunan kepada-Nya. Sungguh, Dia Maha Penerima tobat.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Beranda\", \"item\": \"https://tafsirshaikhain.com/id/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah An-Nasr\", \"item\": \"https://tafsirshaikhain.com/id/surah/110.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 3\", \"item\": \"https://tafsirshaikhain.com/id/ayah/110-3.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/id/\">Beranda</a> › <a href=\"/id/surah/110.html\">Surah An-Nasr</a> › Ayat 3</nav><h1>Tafsir Surah An-Nasr 110:3</h1><p class=\"vt ar\" lang=\"ar\">﴿فَسَبِّحْ بِحَمْدِ رَبِّكَ وَاسْتَغْفِرْهُ إِنَّهُ كَانَ تَوَّابًا﴾</p><section><h3>Terjemah makna</h3><p class=\"tr\">Maka bertasbihlah dengan memuji Tuhanmu dan mohonlah ampunan kepada-Nya. Sungguh, Dia Maha Penerima tobat.</p><span class=\"cr\" dir=\"ltr\">Indonesian Translation - Ministry of Religious Affairs — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Perkataan kedua imam disajikan dalam bahasa Arab aslinya, apa adanya, beserta rujukannya.</p><section><h2>Syaikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">فكان هذا الكلام تأويل قوله: {فسبح بحمد ربك واستغفره}<cite>«مجموع الفتاوى» 17/369</cite></blockquote></section><section><h2>Imam Ibnul Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">فعلم أن المأمور به من ذلك التسبيح بعد الفتح ودخول الناس في هذا الدين أمر أكبر من ذلك المتقدم، وذلك مقدمة بين يدي انتقاله إلى الرفيق الأعلى.<cite>«إعلام الموقعين عن رب العالمين» 1/266</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=id#s110a3\">Buka di tafsir interaktif (teks lengkap)</a><div class=\"pn\"><a href=\"/id/ayah/110-2.html\">Ayat sebelumnya (110:2)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/id/\">Beranda</a> · <a href=\"/about.html\">Tentang proyek</a> · <a href=\"/privacy.html\">Privasi &amp; ketentuan</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/110.html":"<!doctype html>\n<html lang=\"id\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir Surah An-Nasr — menurut Ibnu Taimiyah dan Ibnul Qayyim</title>\n<meta name=\"description\" content=\"Tafsir Surah An-Nasr — Makna Al-Qur&#x27;an dari perkataan Ibnu Taimiyah dan Ibnul Qayyim\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/id/surah/110.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/surah/110.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/surah/110.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/surah/110.html\">\n<link rel=\"alternate\" hre