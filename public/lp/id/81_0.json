:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/id/\">Beranda</a> › <a href=\"/id/surah/81.html\">Surah At-Takwir</a> › Ayat 15</nav><h1>Tafsir Surah At-Takwir 81:15</h1><p class=\"vt ar\" lang=\"ar\">﴿فَلَا أُقْسِمُ بِالْخُنَّسِ﴾</p><section><h3>Terjemah makna</h3><p class=\"tr\">Aku bersumpah demi bintang-bintang,</p><span class=\"cr\" dir=\"ltr\">Indonesian Translation - Ministry of Religious Affairs — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Perkataan kedua imam disajikan dalam bahasa Arab aslinya, apa adanya, beserta rujukannya.</p><section><h2>Syaikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">يعني: الكواكب التي تكون في السماء خانسة أي: مختفية قبل طلوعها<cite>«مجموع الفتاوى» 11/273</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">يقتضي تعظيم قدر المقسم به والتنبيه على ما فيه من الآيات والعبرة والمنفعة للناس؛ والإنعام عليهم وغير ذلك؛<cite>«مجموع الفتاوى» 35/177</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=id#s81a15\">Buka di tafsir interaktif (teks lengkap)</a><div class=\"pn\"><a href=\"/id/ayah/81-9.html\">Ayat sebelumnya (81:9)</a><a href=\"/id/ayah/81-17.html\">Ayat berikutnya (81:17)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/id/\">Beranda</a> · <a href=\"/about.html\">Tentang proyek</a> · <a href=\"/privacy.html\">Privasi &amp; ketentuan</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/81-17.html":"<!doctype html>\n<html lang=\"id\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-wid