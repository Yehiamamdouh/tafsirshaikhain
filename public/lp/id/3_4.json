.html\", \"mainEntityOfPage\": \"https://tafsirshaikhain.com/id/ayah/3-200.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"Syaikhul Islam Ibnu Taimiyah\"}, {\"@type\": \"Person\", \"name\": \"Imam Ibnul Qayyim\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"Tafsir al-Syaikhain\", \"url\": \"https://tafsirshaikhain.com/id/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Beranda\", \"item\": \"https://tafsirshaikhain.com/id/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Aal-i-Imraan\", \"item\": \"https://tafsirshaikhain.com/id/surah/3.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 200\", \"item\": \"https://tafsirshaikhain.com/id/ayah/3-200.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.muy{display:grid;gap:6px;background:var(--sheet,#fff);border:1px dashed var(--line,#d9dee6);border-inline-start:4px solid var(--muted,#5b6676);border-radius:10px;padding:12px 14px;margin:4px 0}.muy-head{display:flex;flex-wrap:wrap;gap:4px 10px;align-items:baseline}.muy-head b{font-family:var(--f-display,sans-serif);font-weight:600;font-size:15px}.muy-head small{font-size:12.5px;color:var(--muted,#5b6676)}.muy-text{margin:0;font-family:var(--f-read,serif);font-size:17px;line-height:1.95;overflow-wrap:anywhere}.muy-fn{margin:0;font-size:14px;line-height:1.7;color:var(--muted,#5b6676);white-space:pre-line}.muy-credit{font-size:12px;color:var(--muted,#5b6676);overflow-wrap:anywhere}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/id/\">Beranda</a> › <a href=\"/id/surah/3.html\">Surah Aal-i-Imraan</a> › Ayat 200</nav><h1>Tafsir Surah Aal-i-Imraan 3:200</h1><p class=\"vt ar\" lang=\"ar\">﴿يَا أَيُّهَا الَّذِينَ آمَنُوا اصْبِرُوا وَصَابِرُوا وَرَابِطُوا وَاتَّقُوا اللَّهَ لَعَلَّكُمْ تُفْلِحُونَ﴾</p><section><h3>Terjemah makna</h3><p class=\"tr\">Wahai orang-orang yang beriman! Bersabarlah kamu dan kuatkanlah kesabaranmu dan tetaplah bersiap-siaga (di perbatasan negerimu) dan bertakwalah kepada Allah agar kamu beruntung.</p><span class=\"cr\" dir=\"ltr\">Indonesian Translation - Ministry of Religious Affairs — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Perkataan kedua imam disajikan dalam bahasa Arab aslinya, apa adanya, beserta rujukannya.</p><section><h2>Imam Ibnul Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">قال الله تعالى {يا أيها الذين آمنوا اصبروا وصابروا ورابطوا واتقوا الله لعلكم تفلحون} فأمرهم بالصبر وهو حال الصابر في نفسه والمصابرة وهى حاله في الصبر مع خصمه والمرابطة وهى الثبات واللزوم والاقامة على الصبر والمصابرة<cite>«عدة الصابرين وذخيرة الشاكرين» 1/21</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فأخبر سبحانه أن ملاك ذلك كله التقوى وأن الفلاح موقوف عليها فقال {واتقوا الله لعلكم تفلحون} فالمرابطة كما أنها لزوم الثغر الذي يخاف هجوم العدو منه في الظاهر فهي لزوم ثغر القلب لئلا يدخل منه الهوى والشيطان فيزيله عن مملكته<cite>«عدة الصابرين وذخيرة الشاكرين» 1/21</cite></blockquote><h3>Yang beliau nukil dari selainnya</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">قيل</span> <span class=\"st\">حكاه</span> «إنه انتقال من الأدنى إلى الأعلى. فالصبر دون المصابرة. والمصابرة دون المرابطة»<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 2/158</cite></blockquote></section><div class=\"muy\"><div class=\"muy-head\"><b>Al-Mukhtaṣar fī Tafsīr Al-Qur&#x27;ān Al-Karīm</b><small>Makna umum ayat — bukan perkataan dua syaikh</small></div><p class=\"muy-text\">Wahai orang-orang yang beriman kepada Allah dan mengikuti Rasul-Nya! Bersabarlah kalian terhadap beban-beban syariat (agama) serta musibah-musibah dunia yang menimpa kalian, dan kalahkanlah orang-orang kafir dalam hal kesabaran, serta angan sampai mereka lebih sabar dari kalian. Tegakkanlah jihad di jalan Allah, dan takutlah kalian kepada Allah dengan cara menjalankan perintah-perintah-Nya dan menjauhi larangan-larangan-Nya, supaya kalian mendapatkan apa yang kalian harapkan, yaitu selamat dari neraka dan masuk ke dalam surga.</p><a class=\"muy-credit\" href=\"https://quranenc.com/en/browse/indonesian_mokhtasar\" target=\"_blank\" rel=\"noopener\" dir=\"ltr\">Indonesian Translation of Al-Mukhtasar in Interpreting the Noble Quran — 2026-11-04 · QuranEnc.com</a></div><a class=\"btn pri open\" href=\"/tafsir.html?lang=id#s3a200\">Buka di tafsir interaktif (teks lengkap)</a><div class=\"pn\"><a href=\"/id/ayah/3-199.html\">Ayat sebelumnya (3:199)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/3-200.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/3-200.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/3-200.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <b lang=\"id\">Bahasa Indonesia</b> · <a href=\"/tr/ayah/3-200.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\