ListItem\", \"position\": 1, \"name\": \"Beranda\", \"item\": \"https://tafsirshaikhain.com/id/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Al-Muddaththir\", \"item\": \"https://tafsirshaikhain.com/id/surah/74.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 56\", \"item\": \"https://tafsirshaikhain.com/id/ayah/74-56.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/id/\">Beranda</a> › <a href=\"/id/surah/74.html\">Surah Al-Muddaththir</a> › Ayat 56</nav><h1>Tafsir Surah Al-Muddaththir 74:56</h1><p class=\"vt ar\" lang=\"ar\">﴿وَمَا يَذْكُرُونَ إِلَّا أَن يَشَاءَ اللَّهُ هُوَ أَهْلُ التَّقْوَىٰ وَأَهْلُ الْمَغْفِرَةِ﴾</p><section><h3>Terjemah makna</h3><p class=\"tr\">Dan mereka tidak akan mengambil pelajaran darinya (Al-Qur`an) kecuali (jika) Allah menghendakinya. Dialah Tuhan yang patut (kita) bertakwa kepada-Nya dan yang berhak memberi ampun.</p><span class=\"cr\" dir=\"ltr\">Indonesian Translation - Ministry of Religious Affairs — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Perkataan kedua imam disajikan dalam bahasa Arab aslinya, apa adanya, beserta rujukannya.</p><section><h2>Imam Ibnul Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">وقد أخبر سبحانه أن العباد لا يشاؤن إلا بعد مشيئته ولا يفعلون شيئا إلا بعد مشيئته<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/104</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=id#s74a56\">Buka di tafsir interaktif (teks lengkap)</a><div class=\"pn\"><a href=\"/id/ayah/74-55.html\">Ayat sebelumnya (74:55)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/id/\">Beranda</a> · <a href=\"/about.html\">Tentang proyek</a> · <a href=\"/privacy.html\">Privasi &amp; ketentuan</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}