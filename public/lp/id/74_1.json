 \"https://tafsirshaikhain.com/id/surah/74.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 55\", \"item\": \"https://tafsirshaikhain.com/id/ayah/74-55.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/id/\">Beranda</a> › <a href=\"/id/surah/74.html\">Surah Al-Muddaththir</a> › Ayat 55</nav><h1>Tafsir Surah Al-Muddaththir 74:55</h1><p class=\"vt ar\" lang=\"ar\">﴿فَمَن شَاءَ ذَكَرَهُ﴾</p><section><h3>Terjemah makna</h3><p class=\"tr\">Maka barangsiapa menghendaki, tentu dia mengambil pelajaran darinya.</p><span class=\"cr\" dir=\"ltr\">Indonesian Translation - Ministry of Religious Affairs — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Perkataan kedua imam disajikan dalam bahasa Arab aslinya, apa adanya, beserta rujukannya.</p><section><h2>Syaikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">فأثبت مشيئة العبد، وأخبر أنها لا تكون إلا بمشيئة الرب<cite>«منهاج السنة النبوية في نقض كلام الشيعة القدرية» 3/111</cite></blockquote></section><section><h2>Imam Ibnul Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">ولا يكفي في وقوع الفعل مشيئة الله للعبد إن شاءه فقط، فإن العبد قد يشاء الفعل، ولا يقع، فإن مشيئته ليست موجبة، ولا تلزمه، بل لا بد من مشيئة الله له أن يفعل،<cite>«إعلام الموقعين عن رب العالمين» 4/52</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=id#s74a55\">Buka di tafsir interaktif (teks lengkap)</a><div class=\"pn\"><a href=\"/id/ayah/74-49.html\">Ayat sebelumnya (74:49)</a><a href=\"/id/ayah/74-56.html\">Ayat berikutnya (74:56)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/74-55.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/74-55.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/74-55.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <b lang=\"id\">Bahasa Indonesia</b> · <a href=\"/tr/ayah/74-55.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/74-55.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/74-55.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/74-55.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/74-55.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/74-55.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/74-55.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/74-55.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/74-55.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/74-55.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/74-55.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a></nav>\n<footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/id/\">Beranda</a> · <a h