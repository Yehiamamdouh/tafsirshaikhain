g\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Beranda\", \"item\": \"https://tafsirshaikhain.com/id/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Al-Jumu'a\", \"item\": \"https://tafsirshaikhain.com/id/surah/62.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 10\", \"item\": \"https://tafsirshaikhain.com/id/ayah/62-10.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/id/\">Beranda</a> › <a href=\"/id/surah/62.html\">Surah Al-Jumu&#x27;a</a> › Ayat 10</nav><h1>Tafsir Surah Al-Jumu&#x27;a 62:10</h1><p class=\"vt ar\" lang=\"ar\">﴿فَإِذَا قُضِيَتِ الصَّلَاةُ فَانتَشِرُوا فِي الْأَرْضِ وَابْتَغُوا مِن فَضْلِ اللَّهِ وَاذْكُرُوا اللَّهَ كَثِيرًا لَّعَلَّكُمْ تُفْلِحُونَ﴾</p><section><h3>Terjemah makna</h3><p class=\"tr\">Apabila salat telah dilaksanakan, maka bertebaranlah kamu di bumi; carilah karunia Allah dan ingatlah Allah banyak-banyak agar kamu beruntung.</p><span class=\"cr\" dir=\"ltr\">Indonesian Translation - Ministry of Religious Affairs — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Perkataan kedua imam disajikan dalam bahasa Arab aslinya, apa adanya, beserta rujukannya.</p><section><h2>Syaikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">ونظير هذا لفظ &quot; القضاء &quot; فإنه في كلام الله وكلام الرسول المراد به إتمام العبادة وإن كان ذلك في وقتها<cite>«مجموع الفتاوى» 12/106</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فمن فعل العبادة كاملة فقد قضاها، وإن فعلها في وقتها.<cite>«مجموع الفتاوى» 22/37</cite></blockquote></section><section><h2>Imam Ibnul Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">وأما تعليق الفلاح بالإكثار منه: فكقوله: {واذكروا الله كثيرا لعلكم تفلحون} [الجمعة: 10] .<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 2/397</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=id#s62a10\">Buka di tafsir interaktif (teks lengkap)</a><div class=\"pn\"><a href=\"/id/ayah/62-9.html\">Ayat sebelumnya (62:9)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/id/\">Beranda</a> · <a href=\"/about.html\">Tentang proyek</a> · <a href=\"/privacy.html\">Privasi &amp; ketentuan</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/62.html":"<!doctype html>\n<html lang=\"id\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir Surah Al-Jumu&#x27;a — menurut Ibnu Taimiyah dan Ibnul Qayyim</title>\n<meta name=\"description\" content=\"Tafsir Surah Al-Jumu&#x27;a — Makna Al-Qur&#x27;an dari perkataan Ibnu Taimiyah dan Ibnul Qayyim\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/id/surah/62.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/surah/62.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/surah/62.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/surah/62.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/surah/62.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/surah/62.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikh