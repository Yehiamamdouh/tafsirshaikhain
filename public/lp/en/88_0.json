ight\" content=\"630\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<link rel=\"manifest\" href=\"/manifest.webmanifest\">\n<link rel=\"apple-touch-icon\" href=\"/icon-192.png\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"Tafsir of Al-Ghaashiya 88:22 — by Ibn Taymiyyah and Ibn al-Qayyim\", \"description\": \"You are not over them a controller.\", \"inLanguage\": \"en\", \"url\": \"https://tafsirshaikhain.com/en/ayah/88-22.html\", \"mainEntityOfPage\": \"https://tafsirshaikhain.com/en/ayah/88-22.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"Shaykh al-Islam Ibn Taymiyyah\"}, {\"@type\": \"Person\", \"name\": \"Imam Ibn al-Qayyim\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"Tafsir al-Shaykhayn\", \"url\": \"https://tafsirshaikhain.com/en/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://tafsirshaikhain.com/en/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Al-Ghaashiya\", \"item\": \"https://tafsirshaikhain.com/en/surah/88.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verse 22\", \"item\": \"https://tafsirshaikhain.com/en/ayah/88-22.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/en/\">Home</a> › <a href=\"/en/surah/88.html\">Surah Al-Ghaashiya</a> › Verse 22</nav><h1>Tafsir of Surah Al-Ghaashiya 88:22</h1><p class=\"vt ar\" lang=\"ar\">﴿لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ﴾</p><section><h3>Translation of the meaning</h3><p class=\"tr\">You are not over them a controller.</p><span class=\"cr\" dir=\"ltr\">English Translation - Noor International Center — v1.1.2 · QuranEnc.com</span></section><p class=\"cr\">The words of the two imams are given in their original Arabic, verbatim, with references.</p><section><h2>Shaykh al-Islam Ibn Taymiyyah</h2><blockquote class=\"ar\" lang=\"ar\">لم ينف كونه مع التذكير مبشرا وهاديا وداعيا.<cite>«الرد على السبكي في مسألة تعليق الطلاق» 1/466</cite></blockquote></section><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">فهذا من المنقطع لا بالاعتبار الذي ذكره ابن خروف من كون المستثنى جملة مستقلة بل باعتبار آخر وهو أنه ليس المراد إثبات السيطرة على الكفار فإن الله سبحانه بعثه نذيرا مبلغا لرسالات ربه فمن أطاعة فله الجنة ومن عصاه فله النار<cite>«بدائع الفوائد» 3/69</cite></blockquote><h3>What he quoted from others</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">المفسرون</span> <span class=\"st\">أقرّه</span> «المعنى أنك لم ترسل مسلطا عليهم قاهرا لهم جبارا كالملوك بل أنت عبدي ورسولي المبلغ رسالاتي فمن أطاعك فله الجنة ومن عصاك فله النار»<cite>«بدائع الفوائد» 3/69</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=en#s88a22\">Open in the interactive tafsir (full texts)</a><div class=\"pn\"><a href=\"/en/ayah/88-21.html\">Previous verse (88:21)</a><a href=\"/en/ayah/88-23.html\">Next verse (88:23)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/88-22.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <b lang