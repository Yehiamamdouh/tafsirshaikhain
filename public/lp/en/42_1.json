\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/42-50.html\">\n<meta property=\"og:title\" content=\"Tafsir of Ash-Shura 42:50 — by Ibn Taymiyyah and Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"Or He makes them [both] males and females, and He renders whom He wills barren. Indeed, He is Knowing and Competent.\">\n<meta property=\"og:url\" content=\"https://tafsirshaikhain.com/en/ayah/42-50.html\">\n<meta property=\"og:site_name\" content=\"Tafsir al-Shaykhayn\">\n<meta property=\"og:locale\" content=\"en_US\">\n<meta property=\"og:type\" content=\"article\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta property=\"og:image:width\" content=\"1200\">\n<meta property=\"og:image:height\" content=\"630\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<link rel=\"manifest\" href=\"/manifest.webmanifest\">\n<link rel=\"apple-touch-icon\" href=\"/icon-192.png\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"Tafsir of Ash-Shura 42:50 — by Ibn Taymiyyah and Ibn al-Qayyim\", \"description\": \"Or He makes them [both] males and females, and He renders whom He wills barren. Indeed, He is Knowing and Competent.\", \"inLanguage\": \"en\", \"url\": \"https://tafsirshaikhain.com/en/ayah/42-50.html\", \"mainEntityOfPage\": \"https://tafsirshaikhain.com/en/ayah/42-50.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"Shaykh al-Islam Ibn Taymiyyah\"}, {\"@type\": \"Person\", \"name\": \"Imam Ibn al-Qayyim\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"Tafsir al-Shaykhayn\", \"url\": \"https://tafsirshaikhain.com/en/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://tafsirshaikhain.com/en/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Ash-Shura\", \"item\": \"https://tafsirshaikhain.com/en/surah/42.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verse 50\", \"item\": \"https://tafsirshaikhain.com/en/ayah/42-50.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/en/\">Home</a> › <a href=\"/en/surah/42.html\">Surah Ash-Shura</a> › Verse 50</nav><h1>Tafsir of Surah Ash-Shura 42:50</h1><p class=\"vt ar\" lang=\"ar\">﴿أَوْ يُزَوِّجُهُمْ ذُكْرَانًا وَإِنَاثًا وَيَجْعَلُ مَن يَشَاءُ عَقِيمًا إِنَّهُ عَلِيمٌ قَدِيرٌ﴾</p><section><h3>Translation of the meaning</h3><p class=\"tr\">Or He makes them [both] males and females, and He renders whom He wills barren. Indeed, He is Knowing and Competent.</p><span class=\"cr\" dir=\"ltr\">English Translation - Noor International Center — v1.1.2 · QuranEnc.com</span></section><p class=\"cr\">The words of the two imams are given in their original Arabic, verbatim, with references.</p><section><h2>Shaykh al-Islam Ibn Taymiyyah</h2><blockquote class=\"ar\" lang=\"ar\">والزوج أعم من النكاح المعروف قال تعالى: {يهب لمن يشاء إناثا ويهب لمن يشاء الذكور} {أو يزوجهم ذكرانا وإناثا}<cite>«مجموع الفتاوى» 15/326</cite></blockquote></section><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">وأما الإذكار والإيناث: فليس بسبب طبيعي، وإنما سببه: الفاعل المختار الذي يأمر الملك به، مع تقدير الشقاوة والسعادة، والرزق، والأجل، ولذلك جمع بين هذه الأربع في الحديث «فيقول الملك: يا رب، ذكر؟ يا رب، أنثى؟ فيقضي ربك ما شاء، ويكتب الملك» . وقد رد سبحانه ذلك إلى محض مشيئته في قوله تعالى: {يهب لمن يشاء إناثا ويهب لمن يشاء الذكور} [الشورى: 49] {أو يزوجهم ذكرانا وإناثا ويجعل من يشاء عقيما} [الشورى: 50] .<cite>«الطرق الحكمية» 1/185</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=en#s42a50\">Open in the interactive tafsir (full texts)</a><div class=\"pn\"><a href=\"/en/ayah/42-49.html\">Previous verse (42:49)</a><a href=\"/en/ayah/42-51.html\">Next verse (42:51)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/42-50.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <b lang=\"en\">English</b> · <a href=\"/ur/ayah/42-50.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/42-50.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/42-50.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/42-50.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/42-50.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/42-50.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/42-50.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/42-50.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/42-50.html\" hreflan