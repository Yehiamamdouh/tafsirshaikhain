khain.com/ha/ayah/61-13.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/61-13.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/61-13.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/61-13.html\">\n<meta property=\"og:title\" content=\"Tafsir of As-Saff 61:13 — by Ibn Taymiyyah and Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"And [you will obtain] another [favor] that you love - victory from Allāh and an imminent conquest; and give good tidings to the believers.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://tafsirshaikhain.com/en/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah As-Saff\", \"item\": \"https://tafsirshaikhain.com/en/surah/61.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verse 13\", \"item\": \"https://tafsirshaikhain.com/en/ayah/61-13.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/en/\">Home</a> › <a href=\"/en/surah/61.html\">Surah As-Saff</a> › Verse 13</nav><h1>Tafsir of Surah As-Saff 61:13</h1><p class=\"vt ar\" lang=\"ar\">﴿وَأُخْرَىٰ تُحِبُّونَهَا نَصْرٌ مِّنَ اللَّهِ وَفَتْحٌ قَرِيبٌ وَبَشِّرِ الْمُؤْمِنِينَ﴾</p><section><h3>Translation of the meaning</h3><p class=\"tr\">And [you will obtain] another [favor] that you love - victory from Allāh and an imminent conquest; and give good tidings to the believers.</p><span class=\"cr\" dir=\"ltr\">English Translation - Noor International Center — v1.1.2 · QuranEnc.com</span></section><p class=\"cr\">The words of the two imams are given in their original Arabic, verbatim, with references.</p><section><h2>Shaykh al-Islam Ibn Taymiyyah</h2><blockquote class=\"ar\" lang=\"ar\">وفي الدنيا النصر والفتح وهما أيضا دفع المضرة وحصول المنفعة<cite>«مجموع الفتاوى» 20/194</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=en#s61a13\">Open in the interactive tafsir (full texts)</a><div class=\"pn\"><a href=\"/en/ayah/61-12.html\">Previous verse (61:12)</a><a href=\"/en/ayah/61-14.html\">Next verse (61:14)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Shaykhayn · <a href=\"/en/\">Home</a> · <a href=\"/about.html\">About the project</a> · <a href=\"/privacy.html\">Privacy &amp; terms</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/61-14.html":"<!doctype html>\n<html lang=\"en\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir of As-Saff 61:14 — by Ibn Taymiyyah and Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"O you who have believed, be supporters of Allāh, as when Jesus, the son of Mary, said to the disciples, &quot;Who are my supporters for Allāh?&quot; The disciples sa\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/en/ayah/61-14.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafs