ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://tafsirshaikhain.com/en/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Al-Israa\", \"item\": \"https://tafsirshaikhain.com/en/surah/17.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verse 107\", \"item\": \"https://tafsirshaikhain.com/en/ayah/17-107.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/en/\">Home</a> › <a href=\"/en/surah/17.html\">Surah Al-Israa</a> › Verse 107</nav><h1>Tafsir of Surah Al-Israa 17:107</h1><p class=\"vt ar\" lang=\"ar\">﴿قُلْ آمِنُوا بِهِ أَوْ لَا تُؤْمِنُوا إِنَّ الَّذِينَ أُوتُوا الْعِلْمَ مِن قَبْلِهِ إِذَا يُتْلَىٰ عَلَيْهِمْ يَخِرُّونَ لِلْأَذْقَانِ سُجَّدًا﴾</p><section><h3>Translation of the meaning</h3><p class=\"tr\">Say, &quot;Believe in it or do not believe.&quot; Indeed, those who were given knowledge before it - when it is recited to them, they fall upon their faces in prostration,</p><span class=\"cr\" dir=\"ltr\">English Translation - Noor International Center — v1.1.2 · QuranEnc.com</span></section><p class=\"cr\">The words of the two imams are given in their original Arabic, verbatim, with references.</p><section><h2>Shaykh al-Islam Ibn Taymiyyah</h2><blockquote class=\"ar\" lang=\"ar\">فمدح هؤلاء، وأثني عليهم بخرورهم للأذقان، أي على الأذقان سجدا.<cite>«سجود التلاوة معانيه وأحكامه» 1/26</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=en#s17a107\">Open in the interactive tafsir (full texts)</a><div class=\"pn\"><a href=\"/en/ayah/17-102.html\">Previous verse (17:102)</a><a href=\"/en/ayah/17-109.html\">Next verse (17:109)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Shaykhayn · <a href=\"/en/\">Home</a> · <a href=\"/about.html\">About the project</a> · <a href=\"/privacy.html\">Privacy &amp; terms</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/17-109.html":"<!doctype html>\n<html lang=\"en\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir of Al-Israa 17:109 — by Ibn Taymiyyah and Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"And they fall upon their faces weeping, and it [i.e., the Qur’ān] increases them in humble submission.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/en/ayah/17-109.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/17-109.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/17-109.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/17-109.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/17-109.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/17-109.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/17-109.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/17-109.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/17-109.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/17-109.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/17-109.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/17-109.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/17-109.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/17-109.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/17-109.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/17-109.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/17-109.html\">\n<meta property=\"og:title\" content=\"Tafsir of Al-Israa 17:109 — by Ibn Taymiyyah and Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"And they fall upon their faces weeping, and it [i.e., the Qur’ān] increases them in humble submission.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://tafsirshaikhain.com/en/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Al-Israa\", \"item\": \"https://tafsirshaikhain.com/en/surah/17.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verse 109\", \"item\": \"https://tafsirshaikhain.com/en/ayah/17-109.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/en/\">Home</a> › <a href=\"/en/surah/17.html\">Surah Al-Israa</a> › Verse 109</nav><h1>Tafsir of Surah Al-Israa 17:109</h1><p class=\"vt ar\" lang=\"ar\">﴿وَيَخِرُّونَ لِلْأَذْقَانِ يَبْكُونَ وَيَزِيدُهُمْ خُشُوعًا﴾</p><section><h3>Translation of the meaning</h3><p class=\"tr\">And they fall upon their faces weeping, and it [i.e., the Qur’ān] increases them in humble submission.</p><span class=\"cr\" dir=\"ltr\">English Translation - Noor International Center — v1.1.2 · QuranEnc.com</span></section><p class=\"cr\">The words of the two imams are given in their original Arabic, verbatim, with references.</p><section><h2>Shaykh al-Islam Ibn Taymiyyah</h2><blockquote class=\"ar\" lang=\"ar\">وليس المراد بالخرور إلصاق الذقن بالأرض كما تلصق الجبهة والخرور على الذقن هو مبدأ الركوع والسجود منتهاه فإن الساجد يسجد على جبهته لا على ذقنه لكنه يخر على ذقنه والذقن آخر حد الوجه وهو أسفل شيء منه وأقربه إلى الأرض.<cite>«مجموع الفتاوى» 23/142</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وهذا وإن قيل: إنه متناول سجود الصلاة فإنهم إذا سمعوا القرآن ركعوا وسجدوا فلا ريب أنه متناول سجود القرآن بطريق الأولى؛ لأن هناك السجود بعض الصلاة وهنا ذكر سجودا مجردا على الأذقان فما بقي يمكن حمله على الركوع؛ لأن الركوع لا يكون على الأذقان.<cite>«مجموع الفتاوى» 23/157</cite></blockquote><h3>What he quoted from others</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن عباس</span> <span class=\"st\">أقرّه</span> «وقد روي عن ابن عباس {يخرون للأذقان} أي للوجوه.»<cite>«مجموع الفتاوى» 23/142</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=en#s17a109\">Open in the interactive tafsir (full texts)</a><div class=\"pn\"><a href=\"/en/ayah/17-107.html\">Previous verse (17:107)</a><a href=\"/en/ayah/17-110.html\">Next verse (17:110)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Shaykhayn · <a href=\"/en/\">Home</a> · <a href=\"/about.html\">About the project</a> · <a href=\"/privacy.html\">Privacy &amp; terms</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/17-110.html":"<!doctype html>\n<html lang=\"en\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir of Al-Israa 17:110 — by Ibn Taymiyyah and Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Say, &quot;Call upon Allāh or call upon the Most Merciful [ar-Raḥmān]. Whichever [name] you call - to Him belong the best names.&quot; And do not recite [too] loudly\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/en/ayah/17-110.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/17-110.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/17-110.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/17-110.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/17-110.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/17-110.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/17-110.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/17-110.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/17-110.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/17-110.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/17-110.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/17-110.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/17-110.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/17-110.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/17-110.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/17-110.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/17-110.html\">\n<meta property=\"og:title\" content=\"Tafsir of Al-Israa 17:110 — by Ibn Taymiyyah and Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"Say, &quot;Call upon Allāh or call upon the Most Merciful [ar-Raḥmān]. Whichever [name] you call - to Him belong the best names.&quot; And do not recite [too] loudly\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://tafsirshaikhain.com/en/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Al-Israa\", \"item\": \"https://tafsirshaikhain.com/en/surah/17.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verse 110\", \"item\": \"https://tafsirshaikhain.com/en/ayah/17-110.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/en/\">Home</a> › <a href=\"/en/surah/17.html\">Surah Al-Israa</a> › Verse 110</nav><h1>Tafsir of Surah Al-Israa 17:110</h1><p class=\"vt ar\" lang=\"ar\">﴿قُلِ ادْعُوا اللَّهَ أَوِ ادْعُوا الرَّحْمَٰنَ أَيًّا مَّا تَدْعُوا فَلَهُ الْأَسْمَاءُ الْحُسْنَىٰ وَلَا تَجْهَرْ بِصَلَاتِكَ وَلَا تُخَافِتْ بِهَا وَابْتَغِ بَيْنَ ذَٰلِكَ سَبِيلًا﴾</p><section><h3>Translation of the meaning</h3><p class=\"tr\">Say, &quot;Call upon Allāh or call upon the Most Merciful [ar-Raḥmān]. Whichever [name] you call - to Him belong the best names.&quot; And do not recite [too] loudly in your prayer or [too] quietly but seek between that an [intermediate] way.</p><span class=\"cr\" dir=\"ltr\">English Translation - Noor International Center — v1.1.2 · QuranEnc.com</span></section><p class=\"cr\">The words of the two imams are given in their original Arabic, verbatim, with references.</p><section><h2>Shaykh al-Islam Ibn Taymiyyah</h2><blockquote class=\"ar\" lang=\"ar\">أي ادعوا هذا الاسم أو هذا الاسم والمراد إذا دعوته هو المسمى<cite>«مجموع الفتاوى» 6/212</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فقوله: {أيا ما تدعوا} يقتضي تعدد المدعو لقوله {أيا ما} وقوله {فله الأسماء الحسنى} يقتضي أن المدعو واحد له الأسماء الحسنى<cite>«مجموع الفتاوى» 6/211</cite></blockquote></section><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">فهذا الدعاء المشهور وأنه دعاء المسألة<cite>«بدائع الفوائد» 3/5</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فليس المراد مجرد التسمية الخالية عن العبادة والطلب بل التسمية الواقعة في دعاء الثناء والطلب<cite>«بدائع الفوائد» 3/5</cite></blockquote><h3>What he quoted from others</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن عباس</span> <span class=\"st\">حكاه</span> «قال ابن عباس: &quot;سمع المشركون النبي صلى الله عليه وسلم يدعو في سجوده (يا رحمن يا رحيم) فقالوا: هذا يزعم أنه يدعوا واحدا وهو يدعوا مثنى مثنى فأنزل الله هذه الآية {قل ادعوا الله أو ادعوا الرحمن} .»<cite>«بدائع الفوائد» 3/5</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الزمخشري</span> <span class=\"st\">رجّح غيره</span> «وقيل إن الدعاء ههنا بمعنى التسمية كقولهم: &quot;دعوت ولدي سعيدا&quot; &quot;وادعه بعبد الله&quot; ونحوه والمعنى: سموا الله أو أو سموا الرحمن فالدعاء ههنا بمعنى التسمية وهذا قول الزمخشري»<cite>«بدائع الفوائد» 3/5</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=en#s17a110\">Open in the interactive tafsir (full texts)</a><div class=\"pn\"><a href=\"/en/ayah/17-109.html\">Previous verse (17:109)</a><a href=\"/en/ayah/17-111.html\">Next verse (17:111)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Shaykhayn · <a href=\"/en/\">Home</a> · <a href=\"/about.html\">About the project</a> · <a href=\"/privacy.html\">Privacy &amp; terms</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/17-111.html":"<!doctype html>\n<html lang=\"en\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir of Al-Israa 17:111 — by Ibn Taymiyyah and Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"And say, &quot;Praise to Allāh, who has not taken a son and has had no partner in [His] dominion and has no [need of a] protector out of weakness; and glorify H\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/en/ayah/17-111.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/17-111.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/17-111.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/17-111.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/17-111.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/17-111.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/17-111.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/17-111.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/17-111.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/17-111.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/17-111.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/17-111.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/17-111.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/17-111.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/17-111.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/17-111.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/17-111.html\">\n<meta property=\"og:title\" content=\"Tafsir of Al-Israa 17:111 — by Ibn Taymiyyah and Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"And say, &quot;Praise to Allāh, who has not taken a son and has had no partner in [His] dominion and has no [need of a] protector out of weakness; and glorify H\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://tafsirshaikhain.com/en/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Al-Israa\", \"item\": \"https://tafsirshaikhain.com/en/surah/17.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verse 111\", \"item\": \"https://tafsirshaikhain.com/en/ayah/17-111.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/en/\">Home</a> › <a href=\"/en/surah/17.html\">Surah Al-Israa</a> › Verse 111</nav><h1>Tafsir of Surah Al-Israa 17:111</h1><p class=\"vt ar\" lang=\"ar\">﴿وَقُلِ الْحَمْدُ لِلَّهِ الَّذِي لَمْ يَتَّخِذْ وَلَدًا وَلَمْ يَكُن لَّهُ شَرِيكٌ فِي الْمُلْكِ وَلَمْ يَكُن لَّهُ وَلِيٌّ مِّنَ الذُّلِّ وَكَبِّرْهُ تَكْبِيرًا﴾</p><section><h3>Translation of the meaning</h3><p class=\"tr\">And say, &quot;Praise to Allāh, who has not taken a son and has had no partner in [His] dominion and has no [need of a] protector out of weakness; and glorify Him with [great] glorification.&quot;</p><span class=\"cr\" dir=\"ltr\">English Translation - Noor International Center — v1.1.2 · QuranEnc.com</span></section><p class=\"cr\">The words of the two imams are given in their original Arabic, verbatim, with references.</p><section><h2>Shaykh al-Islam Ibn Taymiyyah</h2><blockquote class=\"ar\" lang=\"ar\">فهو سبحانه لم يوال عباده من ذل ليعتز بهم، كما يوالي الملوك لأوليائهم.<cite>«قاعدة عظيمة في الفرق بين عبادات أهل الإسلام والإيمان وعبادات أهل الشرك والنفاق» 1/132</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">كما أن ما نفاه من اتخاذ الولد يعم أيضا جميع أنواع الاتخاذات الاصطفائية<cite>«مجموع الفتاوى» 17/269</cite></blockquote><h3>What he quoted from others</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">مجاهد</span> <span class=\"st\">أقرّه</span> «قال مجاهد: لم يذل فيحتاج إلى ولي يتعزز به.»<cite>«قاعدة عظيمة في الفرق بين عبادات أهل الإسلام والإيمان وعبادات أهل الشرك والنفاق» 1/132</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=en#s17a111\">Open in the interactive tafsir (full texts)</a><div class=\"pn\"><a href=\"/en/ayah/17-110.html\">Previous verse (17:110)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Shaykhayn · <a href=\"/en/\">Home</a> · <a href=\"/about.html\">About the project</a> · <a href=\"/privacy.html\">Privacy &amp; terms</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}