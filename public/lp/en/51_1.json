https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://tafsirshaikhain.com/en/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Adh-Dhaariyat\", \"item\": \"https://tafsirshaikhain.com/en/surah/51.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verse 57\", \"item\": \"https://tafsirshaikhain.com/en/ayah/51-57.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/en/\">Home</a> › <a href=\"/en/surah/51.html\">Surah Adh-Dhaariyat</a> › Verse 57</nav><h1>Tafsir of Surah Adh-Dhaariyat 51:57</h1><p class=\"vt ar\" lang=\"ar\">﴿مَا أُرِيدُ مِنْهُم مِّن رِّزْقٍ وَمَا أُرِيدُ أَن يُطْعِمُونِ﴾</p><section><h3>Translation of the meaning</h3><p class=\"tr\">I do not want from them any provision, nor do I want them to feed Me.</p><span class=\"cr\" dir=\"ltr\">English Translation - Noor International Center — v1.1.2 · QuranEnc.com</span></section><p class=\"cr\">The words of the two imams are given in their original Arabic, verbatim, with references.</p><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">فأخبر أنه لم يخلق الجن والإنس لحاجة منه إليهم، ولا ليربح عليهم<cite>«طريق الهجرتين وباب السعادتين» 1/135</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">لكن خلقهم جودا وإحسانا ليعبدوه فيربحوا هم عليه كل الأرباح<cite>«طريق الهجرتين وباب السعادتين» 1/135</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=en#s51a57\">Open in the interactive tafsir (full texts)</a><div class=\"pn\"><a href=\"/en/ayah/51-56.html\">Previous verse (51:56)</a><a href=\"/en/ayah/51-58.html\">Next verse (51:58)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Shaykhayn · <a href=\"/en/\">Home</a> · <a href=\"/about.html\">About the project</a> · <a href=\"/privacy.html\">Privacy &amp; terms</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/51-58.html":"<!doctype html>\n<html lang=\"en\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir of Adh-Dhaariyat 51:58 — by Ibn Taymiyyah and Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Indeed, it is Allāh who is the [continual] Provider, the firm possessor of strength.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/en/ayah/51-58.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/51-58.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/51-58.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/51-58.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/51-58.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/51-58.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/51-58.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/51-58.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/51-58.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/51-58.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/51-58.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/51-58.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/51-58.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/51-58.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/51-58.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/51-58.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/51-58.html\">\n<meta property=\"og:title\" content=\"Tafsir of Adh-Dhaariyat 51:58 — by Ibn Taymiyyah and Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"Indeed, it is Allāh who is the [continual] Provider, the firm possessor of strength.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://tafsirshaikhain.com/en/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Adh-Dhaariyat\", \"item\": \"https://tafsirshaikhain.com/en/surah/51.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verse 58\", \"item\": \"https://tafsirshaikhain.com/en/ayah/51-58.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/en/\">Home</a> › <a href=\"/en/surah/51.html\">Surah Adh-Dhaariyat</a> › Verse 58</nav><h1>Tafsir of Surah Adh-Dhaariyat 51:58</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّ اللَّهَ هُوَ الرَّزَّاقُ ذُو الْقُوَّةِ الْمَتِينُ﴾</p><section><h3>Translation of the meaning</h3><p class=\"tr\">Indeed, it is Allāh who is the [continual] Provider, the firm possessor of strength.</p><span class=\"cr\" dir=\"ltr\">English Translation - Noor International Center — v1.1.2 · QuranEnc.com</span></section><p class=\"cr\">The words of the two imams are given in their original Arabic, verbatim, with references.</p><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">فعلم أن القوي من أسمائه، ومعناه الموصوف بالقوة<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/52</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=en#s51a58\">Open in the interactive tafsir (full texts)</a><div class=\"pn\"><a href=\"/en/ayah/51-57.html\">Previous verse (51:57)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Shaykhayn · <a href=\"/en/\">Home</a> · <a href=\"/about.html\">About the project</a> · <a href=\"/privacy.html\">Privacy &amp; terms</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}