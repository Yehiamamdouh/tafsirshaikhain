ikhain.com/zh/ayah/15-72.html\">\n<meta property=\"og:title\" content=\"Tafsir of Al-Hijr 15:72 — by Ibn Taymiyyah and Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"By your life, [O Muḥammad], indeed they were, in their intoxication, wandering blindly.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://tafsirshaikhain.com/en/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Al-Hijr\", \"item\": \"https://tafsirshaikhain.com/en/surah/15.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verse 72\", \"item\": \"https://tafsirshaikhain.com/en/ayah/15-72.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/en/\">Home</a> › <a href=\"/en/surah/15.html\">Surah Al-Hijr</a> › Verse 72</nav><h1>Tafsir of Surah Al-Hijr 15:72</h1><p class=\"vt ar\" lang=\"ar\">﴿لَعَمْرُكَ إِنَّهُمْ لَفِي سَكْرَتِهِمْ يَعْمَهُونَ﴾</p><section><h3>Translation of the meaning</h3><p class=\"tr\">By your life, [O Muḥammad], indeed they were, in their intoxication, wandering blindly.</p><span class=\"cr\" dir=\"ltr\">English Translation - Noor International Center — v1.1.2 · QuranEnc.com</span></section><p class=\"cr\">The words of the two imams are given in their original Arabic, verbatim, with references.</p><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">أكثر المفسرين من السلف والخلف بل لا يعرف عن السلف فيه إلا نزاعا أن هذا قسم من الله بحياة رسوله وهذا من أعظم فضائله<cite>«التبيان في أقسام القرآن» 1/429</cite></blockquote><h3>What he quoted from others</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الزمخشري (أن القسم بحياة لوط من قول الملائكة)</span> <span class=\"st\">ردّه</span> «فصرف القسم إلى أنه بحياة لوط وأنه من قول الملائكة»<cite>«التبيان في أقسام القرآن» 1/429</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=en#s15a72\">Open in the interactive tafsir (full texts)</a><div class=\"pn\"><a href=\"/en/ayah/15-42.html\">Previous verse (15:42)</a><a href=\"/en/ayah/15-75.html\">Next verse (15:75)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Shaykhayn · <a href=\"/en/\">Home</a> · <a href=\"/about.html\">About the project</a> · <a href=\"/privacy.html\">Privacy &amp; terms</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/15-75.html":"<!doctype html>\n<html lang=\"en\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir of Al-Hijr 15:75 — by Ibn Taymiyyah and Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Indeed in that are signs for those who discern.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/en/ayah/15-75.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/15-75.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/15-75.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/15-75.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/15-75.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/15-75.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/15-75.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/15-75.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/15-75.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/15-75.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/15-75.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/15-75.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/15-75.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/15-75.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/15-75.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/15-75.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/15-75.html\">\n<meta property=\"og:title\" content=\"Tafsir of Al-Hijr 15:75 — by Ibn Taymiyyah and Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"Indeed in that are signs for those who discern.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://tafsirshaikhain.com/en/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Al-Hijr\", \"item\": \"https://tafsirshaikhain.com/en/surah/15.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verse 75\", \"item\": \"https://tafsirshaikhain.com/en/ayah/15-75.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/en/\">Home</a> › <a href=\"/en/surah/15.html\">Surah Al-Hijr</a> › Verse 75</nav><h1>Tafsir of Surah Al-Hijr 15:75</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّ فِي ذَٰلِكَ لَآيَاتٍ لِّلْمُتَوَسِّمِينَ﴾</p><section><h3>Translation of the meaning</h3><p class=\"tr\">Indeed in that are signs for those who discern.</p><span class=\"cr\" dir=\"ltr\">English Translation - Noor International Center — v1.1.2 · QuranEnc.com</span></section><p class=\"cr\">The words of the two imams are given in their original Arabic, verbatim, with references.</p><section><h2>Shaykh al-Islam Ibn Taymiyyah</h2><blockquote class=\"ar\" lang=\"ar\">والتوسم من السمة وهي العلامة<cite>«مجموع الفتاوى» 15/398</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فدل ذلك على أن من اعتبر بما عاقب الله به غيره من أهل الفواحش كان من المتوسمين.<cite>«مجموع الفتاوى» 15/399</cite></blockquote></section><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">وأما الفراسة فأثنى على أهلها ومدحهم في قوله تعالى {إن في ذلك لآيات للمتوسمين}<cite>«الروح في الكلام على أرواح الأموات والأحياء بالدلائل من الكتاب والسنة» 1/238</cite></blockquote><h3>What he quoted from others</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن عباس وغيره</span> <span class=\"st\">أقرّه</span> «هم المتفرسون الذين يأخذون بالسيما وهي العلامة»<cite>«الكلام على مسألة السماع» 1/245</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">النبي صلى الله عليه وسلم</span> <span class=\"st\">استشهد به</span> «قلت: وأصل هذا في الترمذي مرفوعا: «اتقوا فراسة المؤمن؛ فإنه ينظر بنور الله، ثم قرأ {إن في ذلك لآيات للمتوسمين} [الحجر: 75] »»<cite>«إعلام الموقعين عن رب العالمين» 1/51</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=en#s15a75\">Open in the interactive tafsir (full texts)</a><div class=\"pn\"><a href=\"/en/ayah/15-72.html\">Previous verse (15:72)</a><a href=\"/en/ayah/15-91.html\">Next verse (15:91)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Shaykhayn · <a href=\"/en/\">Home</a> · <a href=\"/about.html\">About the project</a> · <a href=\"/privacy.html\">Privacy &amp; terms</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/15-91.html":"<!doctype html>\n<html lang=\"en\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir of Al-Hijr 15:91 — by Ibn Taymiyyah and Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Who have made the Qur’ān into portions.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/en/ayah/15-91.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/15-91.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/15-91.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/15-91.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/15-91.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/15-