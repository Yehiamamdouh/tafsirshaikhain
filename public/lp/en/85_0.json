mily=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/en/\">Home</a> › <a href=\"/en/surah/85.html\">Surah Al-Burooj</a> › Verse 15</nav><h1>Tafsir of Surah Al-Burooj 85:15</h1><p class=\"vt ar\" lang=\"ar\">﴿ذُو الْعَرْشِ الْمَجِيدُ﴾</p><section><h3>Translation of the meaning</h3><p class=\"tr\">Honorable Owner of the Throne,</p><span class=\"cr\" dir=\"ltr\">English Translation - Noor International Center — v1.1.2 · QuranEnc.com</span></section><p class=\"cr\">The words of the two imams are given in their original Arabic, verbatim, with references.</p><section><h2>Shaykh al-Islam Ibn Taymiyyah</h2><blockquote class=\"ar\" lang=\"ar\">وقد تجيء خبرا بعد خبر كقوله: {وهو الغفور الودود} {ذو العرش المجيد} {فعال لما يريد} .<cite>«مجموع الفتاوى» 16/128</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=en#s85a15\">Open in the interactive tafsir (full texts)</a><div class=\"pn\"><a href=\"/en/ayah/85-14.html\">Previous verse (85:14)</a><a href=\"/en/ayah/85-16.html\">Next verse (85:16)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Shaykhayn · <a href=\"/en/\">Home</a> · <a href=\"/about.html\">About the project</a> · <a href=\"/privacy.html\">Privacy &amp; terms</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/85-16.html":"<!doctype html>\n<html lang=\"en\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir of Al-Burooj 85:16 — by Ibn Taymiyyah and Ibn al-Qayyim</title>\n<meta name=\"descript