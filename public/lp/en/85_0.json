stElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://tafsirshaikhain.com/en/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Al-Burooj\", \"item\": \"https://tafsirshaikhain.com/en/surah/85.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verse 14\", \"item\": \"https://tafsirshaikhain.com/en/ayah/85-14.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/en/\">Home</a> › <a href=\"/en/surah/85.html\">Surah Al-Burooj</a> › Verse 14</nav><h1>Tafsir of Surah Al-Burooj 85:14</h1><p class=\"vt ar\" lang=\"ar\">﴿وَهُوَ الْغَفُورُ الْوَدُودُ﴾</p><section><h3>Translation of the meaning</h3><p class=\"tr\">And He is the Forgiving, the Affectionate,</p><span class=\"cr\" dir=\"ltr\">English Translation - Noor International Center — v1.1.2 · QuranEnc.com</span></section><p class=\"cr\">The words of the two imams are given in their original Arabic, verbatim, with references.</p><section><h2>Shaykh al-Islam Ibn Taymiyyah</h2><h3>What he quoted from others</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">قيل</span> <span class=\"st\">حكاه</span> «معناه المودود؛ كالحلوب، والركوب؛ بمعنى المحلوب والمركوب»<cite>«النبوات» 1/362</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">قيل</span> <span class=\"st\">حكاه</span> «يغفر، ويود أن يغفر»<cite>«النبوات» 1/362</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">قيل</span> <span class=\"st\">حكاه</span> «المتودد إلى أوليائه بالمغفرة»<cite>«النبوات» 1/362</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">غير مسمى في المقطع</span> <span class=\"st\">حكاه</span> «أي المحب لهم،»<cite>«النبوات» 1/362</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=en#s85a14\">Open in the interactive tafsir (full texts)</a><div class=\"pn\"><a href=\"/en/ayah/85-10.html\">Previous verse (85:10)</a><a href=\"/en/ayah/85-15.html\">Next verse (85:15)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Shaykhayn · <a href=\"/en/\">Home</a> · <a href=\"/about.html\">About the project</a> · <a href=\"/privacy.html\">Privacy &amp; terms</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/85-15.html":"<!doctype html>\n<html lang=\"en\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir of Al-Burooj 85:15 — by Ibn Taymiyyah and Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Honorable Owner of the Throne,\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/en/ayah/85-15.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/85-15.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/85-15.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/85-15.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/85-15.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/85-15.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/85-15.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/