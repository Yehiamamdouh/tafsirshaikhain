artOf\": {\"@type\": \"WebSite\", \"name\": \"Tafsir al-Shaykhayn\", \"url\": \"https://tafsirshaikhain.com/en/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://tafsirshaikhain.com/en/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Al-Muddaththir\", \"item\": \"https://tafsirshaikhain.com/en/surah/74.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verse 56\", \"item\": \"https://tafsirshaikhain.com/en/ayah/74-56.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/en/\">Home</a> › <a href=\"/en/surah/74.html\">Surah Al-Muddaththir</a> › Verse 56</nav><h1>Tafsir of Surah Al-Muddaththir 74:56</h1><p class=\"vt ar\" lang=\"ar\">﴿وَمَا يَذْكُرُونَ إِلَّا أَن يَشَاءَ اللَّهُ هُوَ أَهْلُ التَّقْوَىٰ وَأَهْلُ الْمَغْفِرَةِ﴾</p><section><h3>Translation of the meaning</h3><p class=\"tr\">And they will not remember except that Allāh wills. He is worthy of fear and adequate for [granting] forgiveness.</p><span class=\"cr\" dir=\"ltr\">English Translation - Noor International Center — v1.1.2 · QuranEnc.com</span></section><p class=\"cr\">The words of the two imams are given in their original Arabic, verbatim, with references.</p><section><h2>Shaykh al-Islam Ibn Taymiyyah</h2><blockquote class=\"ar\" lang=\"ar\">فهو سبحانه أهل التقوى ولم يقل سبحانه أهل للتقوى. بل قال: {أهل التقوى} فهو وحده أهل أن يتقى فيعبد دون ما سواه ولا يستحق غيره أن يتقى كما قال: {وله ما في السماوات والأرض وله الدين واصبا أفغير الله تتقون}<cite>«مجموع الفتاوى» 11/690</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وهو أهل المغفرة ولا يغفر الذنوب غيره كما قال تعالى: {ومن يغفر الذنوب إلا الله}<cite>«مجموع الفتاوى» 11/690</cite></blockquote></section><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">وقد أخبر سبحانه أن العباد لا يشاؤن إلا بعد مشيئته ولا يفعلون شيئا إلا بعد مشيئته<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/104</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=en#s74a56\">Open in the interactive tafsir (full texts)</a><div class=\"pn\"><a href=\"/en/ayah/74-55.html\">Previous verse (74:55)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/74-56.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <b lang=\"en\">English</b> · <a href=\"/ur/ayah/74-56.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/74-56.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/74-56.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/74-56.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/74-56.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/74-56.html\" hreflang=\"ms\" la