=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/en/\">Home</a> › <a href=\"/en/surah/93.html\">Surah Ad-Dhuhaa</a> › Verse 11</nav><h1>Tafsir of Surah Ad-Dhuhaa 93:11</h1><p class=\"vt ar\" lang=\"ar\">﴿وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ﴾</p><section><h3>Translation of the meaning</h3><p class=\"tr\">But as for the favor of your Lord, report [it].</p><span class=\"cr\" dir=\"ltr\">English Translation - Noor International Center — v1.1.2 · QuranEnc.com</span></section><p class=\"cr\">The words of the two imams are given in their original Arabic, verbatim, with references.</p><section><h2>Imam Ibn al-Qayyim</h2><h3>What he quoted from others</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">مجاهد والكلبي</span> <span class=\"st\">أقرّه</span> «قال مجاهد بالقرآن وقال الكلبي بمعنى أظهرها»<cite>«التبيان في أقسام القرآن» 1/75</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=en#s93a11\">Open in the interactive tafsir (full texts)</a><div class=\"pn\"><a href=\"/en/ayah/93-10.html\">Previous verse (93:10)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Shaykhayn · <a href=\"/en/\">Home</a> · <a href=\"/about.html\">About the project</a> · <a href=\"/privacy.html\">Privacy &amp; terms</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/93.html":"<!doctype html>\n<html lang=\"en\" dir=\"ltr\