ntityOfPage\": \"https://tafsirshaikhain.com/en/ayah/7-206.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"Shaykh al-Islam Ibn Taymiyyah\"}, {\"@type\": \"Person\", \"name\": \"Imam Ibn al-Qayyim\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"Tafsir al-Shaykhayn\", \"url\": \"https://tafsirshaikhain.com/en/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://tafsirshaikhain.com/en/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Al-A'raaf\", \"item\": \"https://tafsirshaikhain.com/en/surah/7.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verse 206\", \"item\": \"https://tafsirshaikhain.com/en/ayah/7-206.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/en/\">Home</a> › <a href=\"/en/surah/7.html\">Surah Al-A&#x27;raaf</a> › Verse 206</nav><h1>Tafsir of Surah Al-A&#x27;raaf 7:206</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّ الَّذِينَ عِندَ رَبِّكَ لَا يَسْتَكْبِرُونَ عَنْ عِبَادَتِهِ وَيُسَبِّحُونَهُ وَلَهُ يَسْجُدُونَ﴾</p><section><h3>Translation of the meaning</h3><p class=\"tr\">Indeed, those who are near your Lord [i.e., the angels] are not prevented by arrogance from His worship, and they exalt Him, and to Him they prostrate.</p><span class=\"cr\" dir=\"ltr\">English Translation - Noor International Center — v1.1.2 · QuranEnc.com</span></section><p class=\"cr\">The words of the two imams are given in their original Arabic, verbatim, with references.</p><section><h2>Shaykh al-Islam Ibn Taymiyyah</h2><blockquote class=\"ar\" lang=\"ar\">وهذا ونحوه مما فيه وصف أكابر المخلوقات بالعبادة وذم من خرج عن ذلك متعدد في القرآن<cite>«مجموع الفتاوى» 10/177</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فلو كان موجب العندية معنى عاما كدخولهم تحت قدرته ومشيئته وأمثال ذلك: لكان كل مخلوق عنده؛ ولم يكن أحد مستكبرا عن عبادته بل مسبحا له ساجدا<cite>«مجموع الفتاوى» 5/165</cite></blockquote></section><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">ففرق بين من له عموما ومن عنده من مماليكه وعبيده خصوصا،<cite>«إعلام الموقعين عن رب العالمين» 2/215</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=en#s7a206\">Open in the interactive tafsir (full texts)</a><div class=\"pn\"><a href=\"/en/ayah/7-205.html\">Previous verse (7:205)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/7-206.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <b lang=\"en\">English</b> · <a href=\"/ur/ayah/7-206.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/7-206.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/7-206.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/7-206.h