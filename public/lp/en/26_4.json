\"https://tafsirshaikhain.com/es/ayah/26-225.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/26-225.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/26-225.html\">\n<meta property=\"og:title\" content=\"Tafsir of Ash-Shu&#x27;araa 26:225 — by Ibn Taymiyyah and Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"Do you not see that in every valley they roam\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://tafsirshaikhain.com/en/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Ash-Shu'araa\", \"item\": \"https://tafsirshaikhain.com/en/surah/26.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verse 225\", \"item\": \"https://tafsirshaikhain.com/en/ayah/26-225.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/en/\">Home</a> › <a href=\"/en/surah/26.html\">Surah Ash-Shu&#x27;araa</a> › Verse 225</nav><h1>Tafsir of Surah Ash-Shu&#x27;araa 26:225</h1><p class=\"vt ar\" lang=\"ar\">﴿أَلَمْ تَرَ أَنَّهُمْ فِي كُلِّ وَادٍ يَهِيمُونَ﴾</p><section><h3>Translation of the meaning</h3><p class=\"tr\">Do you not see that in every valley they roam</p><span class=\"cr\" dir=\"ltr\">English Translation - Noor International Center — v1.1.2 · QuranEnc.com</span></section><p class=\"cr\">The words of the two imams are given in their original Arabic, verbatim, with references.</p><section><h2>Shaykh al-Islam Ibn Taymiyyah</h2><blockquote class=\"ar\" lang=\"ar\">والغاوي: هو الذي يتبع هواه بغير علم؛ وهذا هو الغي؛ وهو خلاف الرشد.<cite>«مجموع الفتاوى» 28/163</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">والشعراء جرت عادتهم أن يمشوا مع الطبع؛ كما قال الله تعالى: {ألم تر أنهم في كل واد يهيمون} {وأنهم يقولون ما لا يفعلون}<cite>«مجموع الفتاوى» 28/163</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=en#s26a225\">Open in the interactive tafsir (full texts)</a><div class=\"pn\"><a href=\"/en/ayah/26-222.html\">Previous verse (26:222)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Shaykhayn · <a href=\"/en/\">Home</a> · <a href=\"/about.html\">About the project</a> · <a href=\"/privacy.html\">Privacy &amp; terms</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}