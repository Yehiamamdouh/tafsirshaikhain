/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Nooh\", \"item\": \"https://tafsirshaikhain.com/en/surah/71.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verse 17\", \"item\": \"https://tafsirshaikhain.com/en/ayah/71-17.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/en/\">Home</a> › <a href=\"/en/surah/71.html\">Surah Nooh</a> › Verse 17</nav><h1>Tafsir of Surah Nooh 71:17</h1><p class=\"vt ar\" lang=\"ar\">﴿وَاللَّهُ أَنبَتَكُم مِّنَ الْأَرْضِ نَبَاتًا﴾</p><section><h3>Translation of the meaning</h3><p class=\"tr\">And Allāh has caused you to grow from the earth a [progressive] growth.</p><span class=\"cr\" dir=\"ltr\">English Translation - Noor International Center — v1.1.2 · QuranEnc.com</span></section><p class=\"cr\">The words of the two imams are given in their original Arabic, verbatim, with references.</p><section><h2>Shaykh al-Islam Ibn Taymiyyah</h2><blockquote class=\"ar\" lang=\"ar\">بل قد يكون اسم مصدر أقيم مقامه<cite>«مجموع الفتاوى» 17/33</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=en#s71a17\">Open in the interactive tafsir (full texts)</a><div class=\"pn\"><a href=\"/en/ayah/71-16.html\">Previous verse (71:16)</a><a href=\"/en/ayah/71-23.html\">Next verse (71:23)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Shaykhayn · <a href=\"/en/\">Home</a> · <a hre