rshaikhain.com/ms/ayah/23-28.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/23-28.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/23-28.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/23-28.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/23-28.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/23-28.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/23-28.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/23-28.html\">\n<meta property=\"og:title\" content=\"Tafsir of Al-Muminoon 23:28 — by Ibn Taymiyyah and Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"And when you have boarded the ship, you and those with you, then say, &#x27;Praise to Allāh who has saved us from the wrongdoing people.&#x27;\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://tafsirshaikhain.com/en/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Al-Muminoon\", \"item\": \"https://tafsirshaikhain.com/en/surah/23.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verse 28\", \"item\": \"https://tafsirshaikhain.com/en/ayah/23-28.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/en/\">Home</a> › <a href=\"/en/surah/23.html\">Surah Al-Muminoon</a> › Verse 28</nav><h1>Tafsir of Surah Al-Muminoon 23:28</h1><p class=\"vt ar\" lang=\"ar\">﴿فَإِذَا اسْتَوَيْتَ أَنتَ وَمَن مَّعَكَ عَلَى الْفُلْكِ فَقُلِ الْحَمْدُ لِلَّهِ الَّذِي نَجَّانَا مِنَ الْقَوْمِ الظَّالِمِينَ﴾</p><section><h3>Translation of the meaning</h3><p class=\"tr\">And when you have boarded the ship, you and those with you, then say, &#x27;Praise to Allāh who has saved us from the wrongdoing people.&#x27;</p><span class=\"cr\" dir=\"ltr\">English Translation - Noor International Center — v1.1.2 · QuranEnc.com</span></section><p class=\"cr\">The words of the two imams are given in their original Arabic, verbatim, with references.</p><section><h2>Shaykh al-Islam Ibn Taymiyyah</h2><h3>What he quoted from others</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">أبو عبيدة معمر بن المثنى</span> <span class=\"st\">حكاه</span> «استوى بمعنى علا»<cite>«مجموع الفتاوى» 5/520</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=en#s23a28\">Open in the interactive tafsir (full texts)</a><div class=\"pn\"><a href=\"/en/ayah/23-19.html\">Previous verse (23:19)</a><a href=\"/en/ayah/23-35.html\">Next verse (23:35)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Shaykhayn · <a href=\"/en/\">Home</a> · <a href=\"/about.html\">About the project</a> · <a href=\"/privacy.html\">Privacy &amp; terms</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/23-35.html":"<!doctype html>\n<html lang=\"en\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir of Al-Muminoon 23:35 — by Ibn Taymiyyah and Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Does he promise you that when you have died and become dust and bones that you will be brought forth [once more]?\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/en/ayah/23-35.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/23-35.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/23-35.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/23-35.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/23-35.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/23-35.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/23-35.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/23-35.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/23-35.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/23-35.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/23-35.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/23-35.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/23-35.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/23-35.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/23-35.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/23-35.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/23-35.html\">\n<meta property=\"og:title\" content=\"Tafsir of Al-Muminoon 23:35 — by Ibn Taymiyyah and Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"Does he promise you that when you have died and become dust and bones that you will be brought forth [once more]?\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://tafsirshaikhain.com/en/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Al-Muminoon\", \"item\": \"https://tafsirshaikhain.com/en/surah/23.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verse 35\", \"item\": \"https://tafsirshaikhain.com/en/ayah/23-35.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/en/\">Home</a> › <a href=\"/en/surah/23.html\">Surah Al-Muminoon</a> › Verse 35</nav><h1>Tafsir of Surah Al-Muminoon 23:35</h1><p class=\"vt ar\" lang=\"ar\">﴿أَيَعِدُكُمْ أَنَّكُمْ إِذَا مِتُّمْ وَكُنتُمْ تُرَابًا وَعِظَامًا أَنَّكُم مُّخْرَجُونَ﴾</p><section><h3>Translation of the meaning</h3><p class=\"tr\">Does he promise you that when you have died and become dust and bones that you will be brought forth [once more]?</p><span class=\"cr\" dir=\"ltr\">English Translation - Noor International Center — v1.1.2 · QuranEnc.com</span></section><p class=\"cr\">The words of the two imams are given in their original Arabic, verbatim, with references.</p><section><h2>Shaykh al-Islam Ibn Taymiyyah</h2><blockquote class=\"ar\" lang=\"ar\">وأحسن من هذا أن يقال: كل واحدة من هاتين الجملتين جملة شرطية مركبة من جملتين<cite>«مجموع الفتاوى» 15/276</cite></blockquote><h3>What he quoted from others</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الزجاج وطائفة</span> <span class=\"st\">رجّح غيره</span> «طال الفصل بين أن واسمها وخبرها فأعاد (أن) لتقع على الخبر لتأكيده بها»<cite>«مجموع الفتاوى» 15/276</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=en#s23a35\">Open in the interactive tafsir (full texts)</a><div class=\"pn\"><a href=\"/en/ayah/23-28.html\">Previous verse (23:28)</a><a href=\"/en/ayah/23-51.html\">Next verse (23:51)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Shaykhayn · <a href=\"/en/\">Home</a> · <a href=\"/about.html\">About the project</a> · <a href=\"/privacy.html\">Privacy &amp; terms</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/23.html":"<!doctype html>\n<html lang=\"en\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir of Surah Al-Muminoon — by Ibn Taymiyyah and Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Tafsir of Surah Al-Muminoon — The meanings of the Qur&#x27;an in the words of Ibn Taymiyyah and Ibn al-Qayyim\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/en/surah/23.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/surah/23.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/surah/23.html\">\