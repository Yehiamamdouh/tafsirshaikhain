n.com/de/ayah/18-104.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/18-104.html\">\n<meta property=\"og:title\" content=\"Tafsir of Al-Kahf 18:104 — by Ibn Taymiyyah and Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"[They are] those whose effort is lost in worldly life, while they think that they are doing well in work.&quot;\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Home\", \"item\": \"https://tafsirshaikhain.com/en/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Al-Kahf\", \"item\": \"https://tafsirshaikhain.com/en/surah/18.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Verse 104\", \"item\": \"https://tafsirshaikhain.com/en/ayah/18-104.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/en/\">Home</a> › <a href=\"/en/surah/18.html\">Surah Al-Kahf</a> › Verse 104</nav><h1>Tafsir of Surah Al-Kahf 18:104</h1><p class=\"vt ar\" lang=\"ar\">﴿الَّذِينَ ضَلَّ سَعْيُهُمْ فِي الْحَيَاةِ الدُّنْيَا وَهُمْ يَحْسَبُونَ أَنَّهُمْ يُحْسِنُونَ صُنْعًا﴾</p><section><h3>Translation of the meaning</h3><p class=\"tr\">[They are] those whose effort is lost in worldly life, while they think that they are doing well in work.&quot;</p><span class=\"cr\" dir=\"ltr\">English Translation - Noor International Center — v1.1.2 · QuranEnc.com</span></section><p class=\"cr\">The words of the two imams are given in their original Arabic, verbatim, with references.</p><section><h2>Shaykh al-Islam Ibn Taymiyyah</h2><h3>What he quoted from others</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">سعد بن أبي وقاص وغيره من السلف</span> <span class=\"st\">حكاه</span> «نزلت في أصحاب الصوامع والديارات.»<cite>«الفتاوى الكبرى لابن تيمية» 1/191</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=en#s18a104\">Open in the interactive tafsir (full texts)</a><div class=\"pn\"><a href=\"/en/ayah/18-103.html\">Previous verse (18:103)</a><a href=\"/en/ayah/18-105.html\">Next verse (18:105)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Shaykhayn · <a href=\"/en/\">Home</a> · <a href=\"/about.html\">About the project</a> · <a href=\"/privacy.html\">Privacy &amp; terms</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/18-105.html":"<!doctype html>\n<html lang=\"en\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir of Al-Kahf 18:105 — by Ibn Taymiyyah and Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Those are the ones who disbelieve in the verses of their Lord and in [their] meeting Him, so their deeds have become worthless; and We will not assign to t\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/en/ayah/18-105.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/18-105.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/