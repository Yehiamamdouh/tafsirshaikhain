agmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ta/\">முகப்பு</a> › <a href=\"/ta/surah/103.html\">சூரா Al-Asr</a> › வசனம் 1</nav><h1>தஃப்ஸீர்: சூரா Al-Asr 103:1</h1><p class=\"vt ar\" lang=\"ar\">﴿بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَالْعَصْرِ﴾</p><section><h3>பொருளின் மொழிபெயர்ப்பு</h3><p class=\"tr\">காலத்தின் மீது சத்தியமாக!</p><span class=\"cr\" dir=\"ltr\">Tamil Translation - Omar Sharif — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">இரு இமாம்களின் சொற்கள் மூல அரபியில், உள்ளவாறே, ஆதாரக் குறிப்புகளுடன் தரப்பட்டுள்ளன.</p><section><h2>இமாம் இப்னுல் கய்யிம்</h2><blockquote class=\"ar\" lang=\"ar\">اقسامه بالعصر على حال الإنسان في الآخرة<cite>«التبيان في أقسام القرآن» 1/83</cite></blockquote></section><div class=\"muy\"><div class=\"muy-head\"><b>அல்-முக்தஸர் ஃபீ தஃப்ஸீரில் குர்ஆனில் கரீம்</b><small>வசனத்தின் பொதுப் பொருள் — இரு ஷைகுகளின் சொற்கள் அல்ல</small></div><p class=\"muy-text\">103.1. அல்லாஹ் அஸர் நேரத்தைக் கொண்டு சத்தியம் செய்கின்றான்.</p><a class=\"muy-credit\" href=\"https://quranenc.com/en/browse/tamil_mokhtasar\" target=\"_blank\" rel=\"noopener\" dir=\"ltr\">Tamil Translation of Al-Mukhtasar in Interpreting the Noble Quran — 2026-11-04 · QuranEnc.com</a></div><a class=\"btn pri open\" href=\"/tafsir.html?lang=ta#s103a1\">ஊடாடும் தஃப்ஸீரில் திறக்கவும் (முழு உரைகள்)</a><div class=\"pn\"><span></span><a href=\"/ta/ayah/103-2.html\">அடுத்த வசனம் (103:2)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/103-1.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/103-1.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/103-1.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\"