:var(--f-read,serif);font-size:17px;line-height:1.95;overflow-wrap:anywhere}.muy-fn{margin:0;font-size:14px;line-height:1.7;color:var(--muted,#5b6676);white-space:pre-line}.muy-credit{font-size:12px;color:var(--muted,#5b6676);overflow-wrap:anywhere}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ta/\">முகப்பு</a> › <a href=\"/ta/surah/103.html\">சூரா Al-Asr</a> › வசனம் 2</nav><h1>தஃப்ஸீர்: சூரா Al-Asr 103:2</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّ الْإِنسَانَ لَفِي خُسْرٍ﴾</p><section><h3>பொருளின் மொழிபெயர்ப்பு</h3><p class=\"tr\">நிச்சயமாக மனிதன் நஷ்டத்தில்தான் இருக்கிறான்.</p><span class=\"cr\" dir=\"ltr\">Tamil Translation - Omar Sharif — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">இரு இமாம்களின் சொற்கள் மூல அரபியில், உள்ளவாறே, ஆதாரக் குறிப்புகளுடன் தரப்பட்டுள்ளன.</p><section><h2>ஷைகுல் இஸ்லாம் இப்னு தைமிய்யா</h2><blockquote class=\"ar\" lang=\"ar\">فإن الله تعالى أخبر أن جميع الناس خاسرون إلا من كان في نفسه مؤمنا صالحا؛ ومع غيره موصيا بالحق موصيا بالصبر.<cite>«مجموع الفتاوى» 28/151</cite></blockquote></section><section><h2>இமாம் இப்னுல் கய்யிம்</h2><blockquote class=\"ar\" lang=\"ar\">وتأمل حكمة القرآن لما قال {إن الإنسان لفي خسر} فإنه ضيق الاستثناء وخصصه فقال {إلا الذين آمنوا وعملوا الصالحات وتواصوا بالحق وتواصوا بالصبر}<cite>«التبيان في أقسام القرآن» 1/85</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فمطلق الخسار شيء والخسار المطلق شيء وهو سبحانه إنما قال {إن الإنسان لفي خسر} ومن ربح في سلعة وخسر في غيرها قد يطلق عليه أنه في خسر وأنه ذو خسر<cite>«التبيان في أقسام القرآن» 1/86</cite></blockquote></section><div class=\"muy\"><div class=\"muy-head\"><b>அல்-முக்தஸர் ஃபீ தஃப்ஸீரில் குர்ஆனில் கரீம்</b><small>வசனத்தின் பொதுப் பொருள் — இரு ஷைகுகளின் சொற்கள் அல்ல</small></div><p class=\"muy-text\">103.2. நிச்சயமாக மனிதன் நஷ்டத்திலும் அழிவிலும் இருக்கின்றான்.</p><a class=\"muy-credit\" href=\"https://quranenc.com/en/browse/tamil_mokhtasar\" target=\"_blank\" rel=\"noopener\" dir=\"ltr\">Tamil Translation of Al-Mukhtasar in Interpreting the Noble Quran — 2026-11-04 · QuranEnc.com</a></div><a class=\"btn pri open\" href=\"/tafsir.html?lang=ta#s103a2\">ஊடாடும் தஃப்ஸீரில் திறக்கவும் (முழு உரைகள்)</a><div class=\"pn\"><a href=\"/ta/ayah/103-1.html\">முந்தைய வசனம் (103:1)</a><a href=\"/ta/ayah/103-3.html\">அடுத்த வசனம் (103:3)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/103-2.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/103-2.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/103-2.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/103-2.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/103-2.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/103-2.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/103-2.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/103-2.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/103-2.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/103-2.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/103-2.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/103-2.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/103