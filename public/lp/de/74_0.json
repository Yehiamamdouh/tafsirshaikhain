eta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Startseite\", \"item\": \"https://tafsirshaikhain.com/de/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Al-Muddaththir\", \"item\": \"https://tafsirshaikhain.com/de/surah/74.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Vers 48\", \"item\": \"https://tafsirshaikhain.com/de/ayah/74-48.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/de/\">Startseite</a> › <a href=\"/de/surah/74.html\">Sura Al-Muddaththir</a> › Vers 48</nav><h1>Tafsir von Sura Al-Muddaththir 74:48</h1><p class=\"vt ar\" lang=\"ar\">﴿فَمَا تَنفَعُهُمْ شَفَاعَةُ الشَّافِعِينَ﴾</p><section><h3>Übersetzung der Bedeutung</h3><p class=\"tr\">Nun nützt ihnen die Fürsprache derjenigen nicht, die Fürsprache einlegen (können).</p><span class=\"cr\" dir=\"ltr\">German Translation - Frank Bubenheim — v1.1.4 · QuranEnc.com</span></section><p class=\"cr\">Die Worte der beiden Imame werden im arabischen Original wortgetreu und mit Quellenangaben wiedergegeben.</p><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">أي لا تكون شفاعة فتنفع<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 2/221</cite></blockq