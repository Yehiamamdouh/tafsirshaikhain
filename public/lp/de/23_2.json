com/de/ayah/23-100.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/23-100.html\">\n<meta property=\"og:title\" content=\"Tafsir von Al-Muminoon 23:100 — nach Ibn Taimiyya und Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"auf daß ich rechtschaffen handele in dem, was ich hinterlassen habe. Keineswegs! Es ist nur ein Wort, das er (so) sagt; hinter ihnen wird ein trennendes Hi\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Startseite\", \"item\": \"https://tafsirshaikhain.com/de/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Al-Muminoon\", \"item\": \"https://tafsirshaikhain.com/de/surah/23.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Vers 100\", \"item\": \"https://tafsirshaikhain.com/de/ayah/23-100.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/de/\">Startseite</a> › <a href=\"/de/surah/23.html\">Sura Al-Muminoon</a> › Vers 100</nav><h1>Tafsir von Sura Al-Muminoon 23:100</h1><p class=\"vt ar\" lang=\"ar\">﴿لَعَلِّي أَعْمَلُ صَالِحًا فِيمَا تَرَكْتُ كَلَّا إِنَّهَا كَلِمَةٌ هُوَ قَائِلُهَا وَمِن وَرَائِهِم بَرْزَخٌ إِلَىٰ يَوْمِ يُبْعَثُونَ﴾</p><section><h3>Übersetzung der Bedeutung</h3><p class=\"tr\">auf daß ich rechtschaffen handele in dem, was ich hinterlassen habe. Keineswegs! Es ist nur ein Wort, das er (so) sagt; hinter ihnen wird ein trennendes Hindernis sein bis zu dem Tag, da sie auferweckt werden.</p><span class=\"cr\" dir=\"ltr\">German Translation - Frank Bubenheim — v1.1.4 · QuranEnc.com</span></section><p class=\"cr\">Die Worte der beiden Imame werden im arabischen Original wortgetreu und mit Quellenangaben wiedergegeben.</p><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">البرزخ ونعيمه وهو ما بين الدنيا والآخرة<cite>«الروح في الكلام على أرواح الأموات والأحياء بالدلائل من الكتاب والسنة» 1/73</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=de#s23a100\">Im interaktiven Tafsir öffnen (vollständige Texte)</a><div class=\"pn\"><a href=\"/de/ayah/23-98.html\">Vorheriger Vers (23:98)</a><a href=\"/de/ayah/23-101.html\">Nächster Vers (23:101)</a></div></main><footer class=\"site-foot\"><span>Tafsir der beiden Schaichs · <a href=\"/de/\">Startseite</a> · <a href=\"/about.html\">Über das Projekt</a> · <a href=\"/privacy.html\">Datenschutz &amp; Bedingungen</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/23-101.html":"<!doctype html>\n<html lang=\"de\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir von Al-Muminoon 23:101 — nach Ibn Taimiyya und Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Wenn dann ins Horn geblasen wird, dann wird es zwischen ihnen keine Verwandtschaft mehr geben an jenem Tag, und sie fragen sich nicht mehr gegenseitig.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/de/ayah/23-101.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/23-101.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/23-101.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/23-101.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/23-101.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/23-101.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/23-101.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/23-101.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/23-101.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/23-101.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/23-101.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/23-101.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/23-101.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/23-101.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/23-101.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/23-101.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/23-101.html\">\n<meta property=\"og:title\" content=\"Tafsir von Al-Muminoon 23:101 — nach Ibn Taimiyya und Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"Wenn dann ins Horn geblasen wird, dann wird es zwischen ihnen keine Verwandtschaft mehr geben an jenem Tag, und sie fragen sich nicht mehr gegenseitig.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Startseite\", \"item\": \"https://tafsirshaikhain.com/de/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Al-Muminoon\", \"item\": \"https://tafsirshaikhain.com/de/surah/23.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Vers 101\", \"item\": \"https://tafsirshaikhain.com/de/ayah/23-101.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/de/\">Startseite</a> › <a href=\"/de/surah/23.html\">Sura Al-Muminoon</a> › Vers 101</nav><h1>Tafsir von Sura Al-Muminoon 23:101</h1><p class=\"vt ar\" lang=\"ar\">﴿فَإِذَا نُفِخَ فِي الصُّورِ فَلَا أَنسَابَ بَيْنَهُمْ يَوْمَئِذٍ وَلَا يَتَسَاءَلُونَ﴾</p><section><h3>Übersetzung der Bedeutung</h3><p class=\"tr\">Wenn dann ins Horn geblasen wird, dann wird es zwischen ihnen keine Verwandtschaft mehr geben an jenem Tag, und sie fragen sich nicht mehr gegenseitig.</p><span class=\"cr\" dir=\"ltr\">German Translation - Frank Bubenheim — v1.1.4 · QuranEnc.com</span></section><p class=\"cr\">Die Worte der beiden Imame werden im arabischen Original wortgetreu und mit Quellenangaben wiedergegeben.</p><section><h2>Schaich al-Islam Ibn Taimiyya</h2><h3>Was er von anderen überliefert hat</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن عباس</span> <span class=\"st\">حكاه</span> «لا أنساب في النفخة الأولى {ونفخ في الصور فصعق من في السماوات ومن في الأرض إلا من شاء الله} [الزمر: 68] فلا أنساب عند ذلك ولا يتساءلون. في النفخة الآخرة أقبل بعضهم على بعض يتساءلون»<cite>«الفتاوى الكبرى لابن تيمية» 6/388</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=de#s23a101\">Im interaktiven Tafsir öffnen (vollständige Texte)</a><div class=\"pn\"><a href=\"/de/ayah/23-100.html\">Vorheriger Vers (23:100)</a><a href=\"/de/ayah/23-111.html\">Nächster Vers (23:111)</a></div></main><footer class=\"site-foot\"><span>Tafsir der beiden Schaichs · <a href=\"/de/\">Startseite</a> · <a href=\"/about.html\">Über das Projekt</a> · <a href=\"/privacy.html\">Datenschutz &amp; Bedingungen</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/23-111.html":"<!doctype html>\n<html lang=\"de\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir von Al-Muminoon 23:111 — nach Ibn Taimiyya und Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Ich habe ihnen heute, daß sie standhaft waren, damit vergolten, daß sie die Erfolgreichen sind.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/de/ayah/23-111.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/23-111.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/23-111.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/23-111.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/23-111.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/23-111.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/23-111.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/23-111.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/23-111.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/23-111.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/23-111.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/23-111.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/23-111.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/23-111.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/23-111.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/23-111.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/23-111.html\">\n<meta property=\"og:title\" content=\"Tafsir von Al-Muminoon 23:111 — nach Ibn Taimiyya und Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"Ich habe ihnen heute, daß sie standhaft waren, damit vergolten, daß sie die Erfolgreichen sind.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Startseite\", \"item\": \"https://tafsirshaikhain.com/de/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Al-Muminoon\", \"item\": \"https://tafsirshaikhain.com/de/surah/23.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Vers 111\", \"item\": \"https://tafsirshaikhain.com/de/ayah/23-111.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/de/\">Startseite</a> › <a href=\"/de/surah/23.html\">Sura Al-Muminoon</a> › Vers 111</nav><h1>Tafsir von Sura Al-Muminoon 23:111</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنِّي جَزَيْتُهُمُ الْيَوْمَ بِمَا صَبَرُوا أَنَّهُمْ هُمُ الْفَائِزُونَ﴾</p><section><h3>Übersetzung der Bedeutung</h3><p class=\"tr\">Ich habe ihnen heute, daß sie standhaft waren, damit vergolten, daß sie die Erfolgreichen sind.</p><span class=\"cr\" dir=\"ltr\">German Translation - Frank Bubenheim — v1.1.4 · QuranEnc.com</span></section><p class=\"cr\">Die Worte der beiden Imame werden im arabischen Original wortgetreu und mit Quellenangaben wiedergegeben.</p><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">وجعل الفوز بالجنة والنجاة من النار لا يحظى به الا الصابرون فقال تعالى {إني جزيتهم اليوم بما صبروا أنهم هم الفائزون}<cite>«عدة الصابرين وذخيرة الشاكرين» 1/12</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=de#s23a111\">Im interaktiven Tafsir öffnen (vollständige Texte)</a><div class=\"pn\"><a href=\"/de/ayah/23-101.html\">Vorheriger Vers (23:101)</a><a href=\"/de/ayah/23-115.html\">Nächster Vers (23:115)</a></div></main><footer class=\"site-foot\"><span>Tafsir der beiden Schaichs · <a href=\"/de/\">Startseite</a> · <a href=\"/about.html\">Über das Projekt</a> · <a href=\"/privacy.html\">Datenschutz &amp; Bedingungen</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/23-115.html":"<!doctype html>\n<html lang=\"de\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir von Al-Muminoon 23:115 — nach Ibn Taimiyya und Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Meint ihr denn, daß Wir euch zum sinnlosen Spiel erschaffen hätten und daß ihr nicht zu Uns zurückgebracht würdet?\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/de/ayah/23-115.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/23-115.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/23-115.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/23-115.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/23-115.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/23-115.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/23-115.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/23-115.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/23-115.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/23-115.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/23-115.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/23-115.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/23-115.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/23-115.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/23-115.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/23-115.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/23-115.html\">\n<meta property=\"og:title\" content=\"Tafsir von Al-Muminoon 23:115 — nach Ibn Taimiyya und Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"Meint ihr denn, daß Wir euch zum sinnlosen Spiel erschaffen hätten und daß ihr nicht zu Uns zurückgebracht würdet?\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Startseite\", \"item\": \"https://tafsirshaikhain.com/de/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Al-Muminoon\", \"item\": \"https://tafsirshaikhain.com/de/surah/23.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Vers 115\", \"item\": \"https://tafsirshaikhain.com/de/ayah/23-115.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/de/\">Startseite</a> › <a href=\"/de/surah/23.html\">Sura Al-Muminoon</a> › Vers 115</nav><h1>Tafsir von Sura Al-Muminoon 23:115</h1><p class=\"vt ar\" lang=\"ar\">﴿أَفَحَسِبْتُمْ أَنَّمَا خَلَقْنَاكُمْ عَبَثًا وَأَنَّكُمْ إِلَيْنَا لَا تُرْجَعُونَ﴾</p><section><h3>Übersetzung der Bedeutung</h3><p class=\"tr\">Meint ihr denn, daß Wir euch zum sinnlosen Spiel erschaffen hätten und daß ihr nicht zu Uns zurückgebracht würdet?</p><span class=\"cr\" dir=\"ltr\">German Translation - Frank Bubenheim — v1.1.4 · QuranEnc.com</span></section><p class=\"cr\">Die Worte der beiden Imame werden im arabischen Original wortgetreu und mit Quellenangaben wiedergegeben.</p><section><h2>Schaich al-Islam Ibn Taimiyya</h2><h3>Was er von anderen überliefert hat</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">المفسرون</span> <span class=\"st\">أقرّه</span> «العبث أن يعمل عملا لا لحكمة وهو جنس من اللعب»<cite>«مجموع الفتاوى» 17/174</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">جعفر بن محمد الصادق</span> <span class=\"st\">حكاه</span> «لم يخلقهم لجر منفعة ولا لدفع مضرة ولكن خلقهم وأحسن إليهم وأرسل إليهم الرسل حتى يفصلوا بين الحق والباطل فمن أحسن كافأه بالجنة ومن عصى كافأه بالنار.»<cite>«مجموع الفتاوى» 5/538</cite></blockquote></section><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">أي لغير شيء، لا تؤمرون ولا تنهون، ولا تثابون ولا تعاقبون، والعبث قبيح، فدل على أن قبح هذا مستقر في الفطر والعقول<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/252</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=de#s23a115\">Im interaktiven Tafsir öffnen (vollständige Texte)</a><div class=\"pn\"><a href=\"/de/ayah/23-111.html\">Vorheriger Vers (23:111)</a><a href=\"/de/ayah/23-116.html\">Nächster Vers (23:116)</a></div></main><footer class=\"site-foot\"><span>Tafsir der beiden Schaichs · <a href=\"/de/\">Startseite</a> · <a href=\"/about.html\">Über das Projekt</a> · <a href=\"/privacy.html\">Datenschutz &amp; Bedingungen</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/23-116.html":"<!doctype html>\n<html lang=\"de\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir von Al-Muminoon 23:116 — nach Ibn Taimiyya und Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Doch Erhaben ist Allah, der König, der Wahre. Es gibt keinen Gott außer Ihm, dem Herrn des ehrwürdigen Thrones.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/de/ayah/23-116.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/23-116.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/23-116.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/23-116.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/23-116.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/23-116.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/23-116.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/23-116.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/23-116.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/23-116.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/23-116.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/23-116.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/23-116.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/23-116.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/23-116.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/23-116.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/23-116.html\">\n<meta property=\"og:title\" content=\"Tafsir von Al-Muminoon 23:116 — nach Ibn Taimiyya und Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"Doch Erhaben ist Allah, der König, der Wahre. Es gibt keinen Gott außer Ihm, dem Herrn des ehrwürdigen Thrones.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Startseite\", \"item\": \"https://tafsirshaikhain.com/de/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Al-Muminoon\", \"item\": \"https://tafsirshaikhain.com/de/surah/23.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Vers 116\", \"item\": \"https://tafsirshaikhain.com/de/ayah/23-116.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/de/\">Startseite</a> › <a href=\"/de/surah/23.html\">Sura Al-Muminoon</a> › Vers 116</nav><h1>Tafsir von Sura Al-Muminoon 23:116</h1><p class=\"vt ar\" lang=\"ar\">﴿فَتَعَالَى اللَّهُ الْمَلِكُ الْحَقُّ لَا إِلَٰهَ إِلَّا هُوَ رَبُّ الْعَرْشِ الْكَرِيمِ﴾</p><section><h3>Übersetzung der Bedeutung</h3><p class=\"tr\">Doch Erhaben ist Allah, der König, der Wahre. Es gibt keinen Gott außer Ihm, dem Herrn des ehrwürdigen Thrones.</p><span class=\"cr\" dir=\"ltr\">German Translation - Frank Bubenheim — v1.1.4 · QuranEnc.com</span></section><p class=\"cr\">Die Worte der beiden Imame werden im arabischen Original wortgetreu und mit Quellenangaben wiedergegeben.</p><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">فنزه نفسه سبحانه وباعدها عن هذا الحسبان وأنه يتعالى عنه ولا يليق به لقبحه ولمنافاته لحكمته وملكه وإلهيته<cite>«مفتاح دار السعادة ومنشور ولاية العلم والإرادة» 2/12</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=de#s23a116\">Im interaktiven Tafsir öffnen (vollständige Texte)</a><div class=\"pn\"><a href=\"/de/ayah/23-115.html\">Vorheriger Vers (23:115)</a></div></main><footer class=\"site-foot\"><span>Tafsir der beiden Schaichs · <a href=\"/de/\">Startseite</a> · <a href=\"/about.html\">Über das Projekt</a> · <a href=\"/privacy.html\">Datenschutz &amp; Bedingungen</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}