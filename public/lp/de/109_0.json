an&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/de/\">Startseite</a> › <a href=\"/de/surah/109.html\">Sura Al-Kaafiroon</a> › Vers 6</nav><h1>Tafsir von Sura Al-Kaafiroon 109:6</h1><p class=\"vt ar\" lang=\"ar\">﴿لَكُمْ دِينُكُمْ وَلِيَ دِينِ﴾</p><section><h3>Übersetzung der Bedeutung</h3><p class=\"tr\">Euch eure Religion und mir meine Religion.</p><span class=\"cr\" dir=\"ltr\">German Translation - Frank Bubenheim — v1.1.4 · QuranEnc.com</span></section><p class=\"cr\">Die Worte der beiden Imame werden im arabischen Original wortgetreu und mit Quellenangaben wiedergegeben.</p><section><h2>Schaich al-Islam Ibn Taimiyya</h2><blockquote class=\"ar\" lang=\"ar\">{لكم دينكم ولي دين} خطاب لكل كافر وإن أسلم فيما بعد.<cite>«مجموع الفتاوى» 16/543</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وبهذا يظهر خطأ من قال إنه خطاب للمشركين والنصارى دون اليهود<cite>«مجموع الفتاوى» 16/564</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=de#s109a6\">Im interaktiven Tafsir öffnen (vollständige Texte)</a><div class=\"pn\"><a href=\"/de/ayah/109-5.html\">Vorheriger Vers (109:5)</a></div></main><footer class=\"site-foot\"><span>Tafsir der beiden Schaichs · <a href=\"/de/\">Startseite</a> · <a href=\"/about.html\">Über das Projekt</a> · <a href=\"/privacy.html\">Datenschutz &amp; Bedingungen</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/109.html":"<!doctype html>\n<html lang=\"de\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-widt