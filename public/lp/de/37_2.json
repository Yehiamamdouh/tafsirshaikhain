in.com/zh/ayah/37-107.html\">\n<meta property=\"og:title\" content=\"Tafsir von As-Saaffaat 37:107 — nach Ibn Taimiyya und Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"Und Wir lösten ihn mit einem großartigen Schlachtopfer aus.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Startseite\", \"item\": \"https://tafsirshaikhain.com/de/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura As-Saaffaat\", \"item\": \"https://tafsirshaikhain.com/de/surah/37.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Vers 107\", \"item\": \"https://tafsirshaikhain.com/de/ayah/37-107.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/de/\">Startseite</a> › <a href=\"/de/surah/37.html\">Sura As-Saaffaat</a> › Vers 107</nav><h1>Tafsir von Sura As-Saaffaat 37:107</h1><p class=\"vt ar\" lang=\"ar\">﴿وَفَدَيْنَاهُ بِذِبْحٍ عَظِيمٍ﴾</p><section><h3>Übersetzung der Bedeutung</h3><p class=\"tr\">Und Wir lösten ihn mit einem großartigen Schlachtopfer aus.</p><span class=\"cr\" dir=\"ltr\">German Translation - Frank Bubenheim — v1.1.4 · QuranEnc.com</span></section><p class=\"cr\">Die Worte der beiden Imame werden im arabischen Original wortgetreu und mit Quellenangaben wiedergegeben.</p><section><h2>Schaich al-Islam Ibn Taimiyya</h2><blockquote class=\"ar\" lang=\"ar\">كقوله {وفديناه بذبح عظيم} أي: بمذبوح،<cite>«التسعينية» 2/404</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=de#s37a107\">Im interaktiven Tafsir öffnen (vollständige Texte)</a><div class=\"pn\"><a href=\"/de/ayah/37-96.html\">Vorheriger Vers (37:96)</a><a href=\"/de/ayah/37-112.html\">Nächster Vers (37:112)</a></div></main><footer class=\"site-foot\"><span>Tafsir der beiden Schaichs · <a href=\"/de/\">Startseite</a> · <a href=\"/about.html\">Über das Projekt</a> · <a href=\"/privacy.html\">Datenschutz &amp; Bedingungen</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/37-112.html":"<!doctype html>\n<html lang=\"de\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir von As-Saaffaat 37:112 — nach Ibn Taimiyya und Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Und Wir verkündeten ihm Ishaq als einen Propheten von den Rechtschaffenen.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/de/ayah/37-112.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/37-112.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/37-112.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/37-112.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/37-112.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/37-112.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/37-112.html\">\n<link rel=\"