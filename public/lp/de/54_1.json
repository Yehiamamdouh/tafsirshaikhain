ent\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Startseite\", \"item\": \"https://tafsirshaikhain.com/de/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Al-Qamar\", \"item\": \"https://tafsirshaikhain.com/de/surah/54.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Vers 52\", \"item\": \"https://tafsirshaikhain.com/de/ayah/54-52.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/de/\">Startseite</a> › <a href=\"/de/surah/54.html\">Sura Al-Qamar</a> › Vers 52</nav><h1>Tafsir von Sura Al-Qamar 54:52</h1><p class=\"vt ar\" lang=\"ar\">﴿وَكُلُّ شَيْءٍ فَعَلُوهُ فِي الزُّبُرِ﴾</p><section><h3>Übersetzung der Bedeutung</h3><p class=\"tr\">Alles, was sie getan haben, (steht) in den Schriften.</p><span class=\"cr\" dir=\"ltr\">German Translation - Frank Bubenheim — v1.1.4 · QuranEnc.com</span></section><p class=\"cr\">Die Worte der beiden Imame werden im arabischen Original wortgetreu und mit Quellenangaben wiedergegeben.</p><section><h2>Schaich al-Islam Ibn Taimiyya</h2><blockquote class=\"ar\" lang=\"ar\">{وكل شيء فعلوه في الزبر} وفي قوله: {وإنه لفي زبر الأولين} فإن المراد بذلك ذكره وكتابته. و &quot; الزبر &quot; جمع زبور والزبور فعول بمعنى مفعول أي مزبور أي: مكتوب<cite>«مجموع الفتاوى» 12/386</cite></blockquote></section><section><h2>Imam Ibn al-Qayyim</h2><h3>Was er von anderen überliefert hat</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">عطاء ومقاتل</span> <span class=\"st\">أقرّه</span> «كل شيء فعلوه مكتوب عليهم في اللوح المحفوظ»<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/42</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">طائفة</span> <span class=\"st\">رجّح غيره</span> «المعنى أنه يحصى عليهم في كتب أعمالهم»<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/42</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">أبو إسحاق الزجاج</span> <span class=\"st\">أقرّه</span> «مكتوب عليهم قبل أن يفعلوه ومكتوب عليهم إذا فعلوه للجزاء»<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/42</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=de#s54a52\">Im interaktiven Tafsir öffnen (vollständige Texte)</a><div class=\"pn\"><a href=\"/de/ayah/54-50.html\">Vorheriger Vers (54:50)</a><a href=\"/de/ayah/54-53.html\">Nächster Vers (54:53)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/54-52.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/54-52.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/54-52.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/54-52.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/54-52.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/54-52.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/54-