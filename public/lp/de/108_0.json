.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/de/\">Startseite</a> › <a href=\"/de/surah/108.html\">Sura Al-Kawthar</a> › Vers 1</nav><h1>Tafsir von Sura Al-Kawthar 108:1</h1><p class=\"vt ar\" lang=\"ar\">﴿بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ إِنَّا أَعْطَيْنَاكَ الْكَوْثَرَ﴾</p><section><h3>Übersetzung der Bedeutung</h3><p class=\"tr\">Wir haben dir ja al-Kautar gegeben.</p><span class=\"cr\" dir=\"ltr\">German Translation - Frank Bubenheim — v1.1.4 · QuranEnc.com</span></section><p class=\"cr\">Die Worte der beiden Imame werden im arabischen Original wortgetreu und mit Quellenangaben wiedergegeben.</p><section><h2>Schaich al-Islam Ibn Taimiyya</h2><blockquote class=\"ar\" lang=\"ar\">تدل هذه الآية على عطية كثيرة صادرة عن معط كبير غني واسع.<cite>«مجموع الفتاوى» 16/529</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">والكوثر المعروف إنما هو نهر في الجنة كما قد وردت به الأحاديث الصحيحة الصريحة وقال ابن عباس الكوثر إنما هو من الخير الكثير الذي أعطاه الله إياه<cite>«مجموع الفتاوى» 16/529</cite></blockquote></section><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">وإذا كان المقصود ذكرهما ذكرا معا كقوله تعالى {إنا أعطيناك الكوثر} الكوثر 1 فإن المقصود إخباره لرسوله صلى الله عليه وسلم بما خصه به وأعطاه إياه من الكوثر ولا يتم هذا إلا بذكر المفعولين<cite>«جلاء الأفهام في فضل الصلاة على محمد خير الأنام» 1/460</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=de#s108a1\">Im interaktiven Tafsir öffnen (vollständige Texte)</a><div class=\"pn\"><span></span><a href=\"/de/ayah/108-2.html\">Nächster Vers (108:2)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/108-1.html\" hreflang=\"ar\" lang