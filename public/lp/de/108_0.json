name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Startseite\", \"item\": \"https://tafsirshaikhain.com/de/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Al-Kawthar\", \"item\": \"https://tafsirshaikhain.com/de/surah/108.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Vers 3\", \"item\": \"https://tafsirshaikhain.com/de/ayah/108-3.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/de/\">Startseite</a> › <a href=\"/de/surah/108.html\">Sura Al-Kawthar</a> › Vers 3</nav><h1>Tafsir von Sura Al-Kawthar 108:3</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّ شَانِئَكَ هُوَ الْأَبْتَرُ﴾</p><section><h3>Übersetzung der Bedeutung</h3><p class=\"tr\">Gewiß, derjenige, der dich haßt, - er ist vom Guten abgetrennt .</p><span class=\"cr\" dir=\"ltr\">German Translation - Frank Bubenheim — v1.1.4 · QuranEnc.com</span></section><p class=\"cr\">Die Worte der beiden Imame werden im arabischen Original wortgetreu und mit Quellenangaben wiedergegeben.</p><section><h2>Schaich al-Islam Ibn Taimiyya</h2><blockquote class=\"ar\" lang=\"ar\">وفي قوله: {إن شانئك هو الأبتر} أنواع من التأكيد<cite>«مجموع الفتاوى» 16/533</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وقوله {إن شانئك} أي مبغضك والأبتر المقطوع النسل الذي لا يولد له خير ولا عمل صالح فلا يتولد عنه خير ولا عمل صالح.<cite>«مجموع الفتاوى» 16/528</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">الثاني: الإتيان بضمير الفصل الدال على قوة الإسناد والاختصاص.<cite>«مجموع الفتاوى» 16/533</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=de#s108a3\">Im interaktiven Tafsir öffnen (vollständige Texte)</a><div class=\"pn\"><a href=\"/de/ayah/108-2.html\">Vorheriger Vers (108:2)</a></div></main><footer class=\"site-foot\"><span>Tafsir der beiden Schaichs · <a href=\"/de/\">Startseite</a> · <a href=\"/about.html\">Über das Projekt</a> · <a href=\"/privacy.html\">Datenschutz &amp; Bedingungen</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/108.html":"<!doctype html>\n<html lang=\"de\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir von Sura Al-Kawthar — nach Ibn Taimiyya und Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Tafsir von Sura Al-Kawthar — Die Bedeutungen des Korans in den Worten von Ibn Taimiyya und Ibn al-Qayyim\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/de/surah/108.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/surah/108.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/surah/108.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/surah/108.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/surah/108.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/surah/108.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://t