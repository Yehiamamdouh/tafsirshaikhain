, \"item\": \"https://tafsirshaikhain.com/de/surah/94.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Vers 8\", \"item\": \"https://tafsirshaikhain.com/de/ayah/94-8.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/de/\">Startseite</a> › <a href=\"/de/surah/94.html\">Sura Ash-Sharh</a> › Vers 8</nav><h1>Tafsir von Sura Ash-Sharh 94:8</h1><p class=\"vt ar\" lang=\"ar\">﴿وَإِلَىٰ رَبِّكَ فَارْغَب﴾</p><section><h3>Übersetzung der Bedeutung</h3><p class=\"tr\">und nach deinem Herrn richte dein Begehren aus.</p><span class=\"cr\" dir=\"ltr\">German Translation - Frank Bubenheim — v1.1.4 · QuranEnc.com</span></section><p class=\"cr\">Die Worte der beiden Imame werden im arabischen Original wortgetreu und mit Quellenangaben wiedergegeben.</p><section><h2>Schaich al-Islam Ibn Taimiyya</h2><blockquote class=\"ar\" lang=\"ar\">فجعل التحسب والرغبة إلى الله وحده.<cite>«مجموع الفتاوى» 10/276</cite></blockquote></section><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">فالرغبة والتوكل والإنابة والحسب لله وحده<cite>«زاد المعاد في هدي خير العباد» 1/38</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=de#s94a8\">Im interaktiven Tafsir öffnen (vollständige Texte)</a><div class=\"pn\"><a href=\"/de/ayah/94-7.html\">Vorheriger Vers (94:7)</a></div></main><footer class=\"site-foot\"><span>Tafsir der beiden Sc