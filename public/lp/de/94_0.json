tml\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Vers 7\", \"item\": \"https://tafsirshaikhain.com/de/ayah/94-7.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/de/\">Startseite</a> › <a href=\"/de/surah/94.html\">Sura Ash-Sharh</a> › Vers 7</nav><h1>Tafsir von Sura Ash-Sharh 94:7</h1><p class=\"vt ar\" lang=\"ar\">﴿فَإِذَا فَرَغْتَ فَانصَبْ﴾</p><section><h3>Übersetzung der Bedeutung</h3><p class=\"tr\">Wenn du nun fertig bist, dann strenge dich an</p><span class=\"cr\" dir=\"ltr\">German Translation - Frank Bubenheim — v1.1.4 · QuranEnc.com</span></section><p class=\"cr\">Die Worte der beiden Imame werden im arabischen Original wortgetreu und mit Quellenangaben wiedergegeben.</p><section><h2>Schaich al-Islam Ibn Taimiyya</h2><blockquote class=\"ar\" lang=\"ar\">مع أن تفسير قوله: {فإذا فرغت فانصب} أي فرغت من الصلاة قول ضعيف فإن قوله: إذا فرغت مطلق ولأن الفارغ إن أريد به الفارغ من العبادة فالدعاء أيضا عبادة<cite>«مجموع الفتاوى» 22/496</cite></blockquote><h3>Was er von anderen überliefert hat</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">أشهر قولي المفسرين</span> <span class=\"st\">أقرّه</span> «قيل: إذا فرغت من أشغال الدنيا فانصب في العبادة وإلى ربك فارغب. وهذا أشهر القولين.»<cite>«مجموع الفتاوى» 22/495</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">بعض المفسرين</span> <span class=\"st\">ردّه</span> «أي فرغت من الصلاة»<cite>«مجموع الفتاوى» 22/496</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">قيل</span> <span class=\"st\">حكاه</span> «{فإذا فرغت} من الصلاة {فانصب} في الدعاء {وإلى ربك فارغب} .»<cite>«مجموع الفتاوى» 22/495</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=de#s94a7\">Im interaktiven Tafsir öffnen (vollständige Texte)</a><div class=\"pn\"><a href=\"/de/ayah/94-4.html\">Vorheriger Vers (94:4)</a><a href=\"/de/ayah/94-8.html\">Nächster Vers (94:8)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/94-7.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/94-7.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/94-7.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/94-7.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/94-7.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/94-7.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/94-7.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/94-7.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/94-7.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/94-7.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/94-7.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah