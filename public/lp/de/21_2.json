 content=\"1200\">\n<meta property=\"og:image:height\" content=\"630\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<link rel=\"manifest\" href=\"/manifest.webmanifest\">\n<link rel=\"apple-touch-icon\" href=\"/icon-192.png\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"Tafsir von Al-Anbiyaa 21:112 — nach Ibn Taimiyya und Ibn al-Qayyim\", \"description\": \"Er sagte: Mein Herr, richte der Wahrheit entsprechend. Und unser Herr ist der Allerbarmer, bei Dem Hilfe zu suchen ist gegen das, was ihr beschreibt.\", \"inLanguage\": \"de\", \"url\": \"https://tafsirshaikhain.com/de/ayah/21-112.html\", \"mainEntityOfPage\": \"https://tafsirshaikhain.com/de/ayah/21-112.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"Schaich al-Islam Ibn Taimiyya\"}, {\"@type\": \"Person\", \"name\": \"Imam Ibn al-Qayyim\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"Tafsir der beiden Schaichs\", \"url\": \"https://tafsirshaikhain.com/de/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Startseite\", \"item\": \"https://tafsirshaikhain.com/de/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Al-Anbiyaa\", \"item\": \"https://tafsirshaikhain.com/de/surah/21.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Vers 112\", \"item\": \"https://tafsirshaikhain.com/de/ayah/21-112.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/de/\">Startseite</a> › <a href=\"/de/surah/21.html\">Sura Al-Anbiyaa</a> › Vers 112</nav><h1>Tafsir von Sura Al-Anbiyaa 21:112</h1><p class=\"vt ar\" lang=\"ar\">﴿قَالَ رَبِّ احْكُم بِالْحَقِّ وَرَبُّنَا الرَّحْمَٰنُ الْمُسْتَعَانُ عَلَىٰ مَا تَصِفُونَ﴾</p><section><h3>Übersetzung der Bedeutung</h3><p class=\"tr\">Er sagte: Mein Herr, richte der Wahrheit entsprechend. Und unser Herr ist der Allerbarmer, bei Dem Hilfe zu suchen ist gegen das, was ihr beschreibt.</p><span class=\"cr\" dir=\"ltr\">German Translation - Frank Bubenheim — v1.1.4 · QuranEnc.com</span></section><p class=\"cr\">Die Worte der beiden Imame werden im arabischen Original wortgetreu und mit Quellenangaben wiedergegeben.</p><section><h2>Schaich al-Islam Ibn Taimiyya</h2><blockquote class=\"ar\" lang=\"ar\">ويكون الحكم حكما بالحق والتكوين والفعل كقوله: {فلن أبرح الأرض حتى يأذن لي أبي أو يحكم الله لي} وقوله: {قال رب احكم بالحق} .<cite>«مجموع الفتاوى» 2/264</cite></blockquote></section><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">أي افعل ما تنصر به عبادك وتخذل به أعداءك<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/280</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">عطف الخبر على الطلب كثير كقوله تعالى: {قال رب احكم بالحق، وربنا الرحمن المستعان على ما تصفون} [الأنبياء: 112] ، وقوله تعالى: {وقل رب اغفر وارحم وأنت خير الراحمين}<cite>«طريق الهجرتين وباب السعادتين» 1/350</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=de#s21a112\">Im interaktiven Tafsir öffnen (vollständige Texte)</a><div class=\"pn\"><a href=\"/de/ayah/21-107.html\">Vorheriger Vers (21:107)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/21-112.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/21-112.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/21-112.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/21-112.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/21-112.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/21-112.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/21-112.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/21-112.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/21-112.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/21-112.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/21-112.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/21-112.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/21-112.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <b lang=\"de\">Deutsch</b> · <a href=\"/zh/ayah/21-112.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a></nav>\n<footer class=\"site-foot\"><span>Tafsir der beiden Schaichs · <a href=\"/de/\">Startseite</a> · <a href=\"/about.html\">Über das Projekt</a> · <a href=\"/privacy.html\">Datenschutz &amp; Bedingungen</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n<script>try{localStorage.setItem(\"lang\",\"de\")}catch(e){}document.addEventListener(\"click\",function(e){var a=e.target.closest&&e.target.closest(\"[data-l]\");if(a)try{localStorage.setItem(\"lang\",a.dataset.l)}catch(x){}})</script>\n</body>\n</html>\n"}