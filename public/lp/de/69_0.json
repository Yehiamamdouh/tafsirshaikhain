n/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Startseite\", \"item\": \"https://tafsirshaikhain.com/de/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Al-Haaqqa\", \"item\": \"https://tafsirshaikhain.com/de/surah/69.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Vers 44\", \"item\": \"https://tafsirshaikhain.com/de/ayah/69-44.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/de/\">Startseite</a> › <a href=\"/de/surah/69.html\">Sura Al-Haaqqa</a> › Vers 44</nav><h1>Tafsir von Sura Al-Haaqqa 69:44</h1><p class=\"vt ar\" lang=\"ar\">﴿وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ الْأَقَاوِيلِ﴾</p><section><h3>Übersetzung der Bedeutung</h3><p class=\"tr\">Und wenn er sich gegen Uns einige Aussprüche selbst ausgedacht hätte,</p><span class=\"cr\" dir=\"ltr\">German Translation - Frank Bubenheim — v1.1.4 · QuranEnc.com</span></section><p class=\"cr\">Die Worte der beiden Imame werden im arabischen Original wortgetreu und mit Quellenangaben wiedergegeben.</p><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">أي لو أتى بشيء من عند نفسه لأخذنا منه بيمينه، وقطعنا نياط قلبه وأهلكناه،<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/342</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">أفلا تراه كيف يخبر سبحانه: أن كماله وحكمته وقدرته تأبى أن يقر من تقول عليه بعض الأقاويل؟ بل لابد أن يجعله عبرة لعباده، كما جرت بذلك سنته في المتقولين عليه،<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 3/434</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=de#s69a44\">Im interaktiven Tafsir öffnen (vollständige Texte)</a><div class=\"pn\"><a href=\"/de/ayah/69-41.html\">Vorheriger Vers (69:41)</a><a href=\"/de/ayah/69-45.html\">Nächster Vers (69:45)</a></div></main><footer class=\"site-foot\"><span>Tafsir der beiden Schaichs · <a href=\"/de/\">Startseite</a> · <a href=\"/about.html\">Über das Projekt</a> · <a href=\"/privacy.html\">Datenschutz &amp; Bedingungen</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/69-45.html":"<!doctype html>\n<html lang=\"de\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir von Al-Haaqqa 69:45 — nach Ibn Taimiyya und Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"hätten Wir ihn sicherlich an der Rechten gefaßt\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/de/ayah/69-45.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/69-45.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/69-45.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/69-45.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/69-45.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/69-45.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/69-45.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/69-45.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshai