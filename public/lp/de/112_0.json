item\": \"https://tafsirshaikhain.com/de/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Al-Ikhlaas\", \"item\": \"https://tafsirshaikhain.com/de/surah/112.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Vers 4\", \"item\": \"https://tafsirshaikhain.com/de/ayah/112-4.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/de/\">Startseite</a> › <a href=\"/de/surah/112.html\">Sura Al-Ikhlaas</a> › Vers 4</nav><h1>Tafsir von Sura Al-Ikhlaas 112:4</h1><p class=\"vt ar\" lang=\"ar\">﴿وَلَمْ يَكُن لَّهُ كُفُوًا أَحَدٌ﴾</p><section><h3>Übersetzung der Bedeutung</h3><p class=\"tr\">und niemand ist Ihm jemals gleich.</p><span class=\"cr\" dir=\"ltr\">German Translation - Frank Bubenheim — v1.1.4 · QuranEnc.com</span></section><p class=\"cr\">Die Worte der beiden Imame werden im arabischen Original wortgetreu und mit Quellenangaben wiedergegeben.</p><section><h2>Schaich al-Islam Ibn Taimiyya</h2><blockquote class=\"ar\" lang=\"ar\">&quot; الأحد &quot; يقتضي أنه لا مثل له ولا نظير<cite>«مجموع الفتاوى» 16/99</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">استعملها هنا في النفي أي ليس شيء من الأشياء كفوا له في شيء من الأشياء لأنه أحد.<cite>«مجموع الفتاوى» 17/238</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=de#s112a4\">Im interaktiven Tafsir öffnen (vollständige Texte)</a><div class=\"pn\"><a href=\"/