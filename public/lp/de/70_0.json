+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/de/\">Startseite</a> › <a href=\"/de/surah/70.html\">Sura Al-Ma&#x27;aarij</a> › Vers 22</nav><h1>Tafsir von Sura Al-Ma&#x27;aarij 70:22</h1><p class=\"vt ar\" lang=\"ar\">﴿إِلَّا الْمُصَلِّينَ﴾</p><section><h3>Übersetzung der Bedeutung</h3><p class=\"tr\">außer den Betenden,</p><span class=\"cr\" dir=\"ltr\">German Translation - Frank Bubenheim — v1.1.4 · QuranEnc.com</span></section><p class=\"cr\">Die Worte der beiden Imame werden im arabischen Original wortgetreu und mit Quellenangaben wiedergegeben.</p><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">وإن من كان على غيرها فلأجل ما زكاه الله به من فضله وإحسانه.<cite>«طريق الهجرتين وباب السعادتين» 1/107</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=de#s70a22\">Im interaktiven Tafsir öffnen (vollständige Texte)</a><div class=\"pn\"><a href=\"/de/ayah/70-19.html\">Vorheriger Vers (70:19)</a><a href=\"/de/ayah/70-23.html\">Nächster Vers (70:23)</a></div></main><footer class=\"site-foot\"><span>Tafsir der beiden Schaichs · <a href=\"/de/\">Startseite</a> · <a href=\"/about.html\">Über das Projekt</a> · <a href=\"/privacy.html\">Datenschutz &amp; Bedingungen</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/70-23.html":"<!doctype html>\n<html lang=\"de\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir von Al-Ma&#x27;aarij 70:23 — nach Ibn Taimiyya und Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"diejenigen, die in ihrem Gebet beharrlich sind\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/de/ayah/70-23.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/70-23.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/70-23.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/70-23.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/70-23.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/70-23.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/70-23.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/70-23.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/70-23.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/70-23.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/70-23.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/70-23.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/70-23.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/70-23.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/70-23.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/70-23.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/70-23.html\">\n<meta property=\"og:title\" content=\"Tafsir von Al-Ma&#x27;aarij 70:23 — nach Ibn Taimiyya und Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"diejenigen, die in ihrem Gebet beharrlich sind\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/de/\">Startseite</a> › <a href=\"/de/surah/70.html\">Sura Al-Ma&#x27;aarij</a> › Vers 23</nav><h1>Tafsir von Sura Al-Ma&#x27;aarij 70:23</h1><p class=\"vt ar\" lang=\"ar\">﴿الَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَائِمُونَ﴾</p><section><h3>Übersetzung der Bedeutung</h3><p class=\"tr\">diejenigen, die in ihrem Gebet beharrlich sind</p><span class=\"cr\" dir=\"ltr\">German Translation - Frank Bubenheim — v1.1.4 · QuranEnc.com</span></section><p class=\"cr\">Die Worte der beiden Imame werden im arabischen Original wortgetreu und mit Quellenangaben wiedergegeben.</p><section><h2>Schaich al-Islam Ibn Taimiyya</h2><blockquote class=\"ar\" lang=\"ar\">والسلف من الصحابة ومن بعدهم قد فسروا الدائم على الصلاة بالمحافظ على أوقاتها وبالدائم على أفعالها بالإقبال عليها. والآية تعم هذا وهذا.<cite>«مجموع الفتاوى» 22/552</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=de#s70a23\">Im interaktiven Tafsir öffnen (vollständige Texte)</a><div class=\"pn\"><a href=\"/de/ayah/70-22.html\">Vorheriger Vers (70:22)</a><a href=\"/de/ayah/70-34.html\">Nächster Vers (70:34)</a></div></main><footer class=\"site-foot\"><span>Tafsir der beiden Schaichs · <a href=\"/de/\">Startseite</a> · <a href=\"/about.html\">Über das Projekt</a> · <a href=\"/privacy.html\">Datenschutz &amp; Bedingungen</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/70-34.html":"<!doctype html>\n<html lang=\"de\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir von Al-Ma&#x27;aarij 70:34 — nach Ibn Taimiyya und Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"und diejenigen, die ihr Gebet einhalten.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/de/ayah/70-34.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/70-34.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/70-34.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/70-34.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/70-34.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/70-34.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/70-34.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/70-34.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/70-34.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/70-34.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/70-34.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/70-34.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/70-34.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/70-34.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/70-34.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/70-34.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/70-34.html\">\n<meta property=\"og:title\" content=\"Tafsir von Al-Ma&#x27;aarij 70:34 — nach Ibn Taimiyya und Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"und diejenigen, die ihr Gebet einhalten.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/de/\">Startseite</a> › <a href=\"/de/surah/70.html\">Sura Al-Ma&#x27;aarij</a> › Vers 34</nav><h1>Tafsir von Sura Al-Ma&#x27;aarij 70:34</h1><p class=\"vt ar\" lang=\"ar\">﴿وَالَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ﴾</p><section><h3>Übersetzung der Bedeutung</h3><p class=\"tr\">und diejenigen, die ihr Gebet einhalten.</p><span class=\"cr\" dir=\"ltr\">German Translation - Frank Bubenheim — v1.1.4 · QuranEnc.com</span></section><p class=\"cr\">Die Worte der beiden Imame werden im arabischen Original wortgetreu und mit Quellenangaben wiedergegeben.</p><section><h2>Schaich al-Islam Ibn Taimiyya</h2><blockquote class=\"ar\" lang=\"ar\">وهذه الآيات تقتضي ذم من ترك شيئا من واجبات الصلاة وإن كان في الظاهر مصليا مثل أن يترك الوقت الواجب أو يترك تكميل الشرائط والأركان من الأعمال الظاهرة والباطنة وبذلك فسرها السلف.<cite>«مجموع الفتاوى» 22/572</cite></blockquote><h3>Was er von anderen überliefert hat</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">قتادة</span> <span class=\"st\">أقرّه</span> «على وضوئها ومواقيتها وركوعها»<cite>«مجموع الفتاوى» 22/572</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">عبد الله</span> <span class=\"st\">أقرّه</span> «ذلك على مواقيتها»<cite>«مجموع الفتاوى» 22/572</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن جريج</span> <span class=\"st\">ردّه</span> «المكتوبة والتي في سأل سائل: التطوع.»<cite>«مجموع الفتاوى» 22/572</cite></blockquote></section><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">وفسر الدوام بسكون الأطراف والطمأنينة.<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 2/365</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">والمداومة في قوله تعالى: {والذين هم على صلاتهم يحافظون} [المعارج: 34]<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 2/365</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=de#s70a34\">Im interaktiven Tafsir öffnen (vollständige Texte)</a><div class=\"pn\"><a href=\"/de/ayah/70-23.html\">Vorheriger Vers (70:23)</a><a href=\"/de/ayah/70-40.html\">Nächster Vers (70:40)</a></div></main><footer class=\"site-foot\"><span>Tafsir der beiden Schaichs · <a href=\"/de/\">Startseite</a> · <a href=\"/about.html\">Über das Projekt</a> · <a href=\"/privacy.html\">Datenschutz &amp; Bedingungen</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/70-40.html":"<!doctype html>\n<html lang=\"de\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir von Al-Ma&#x27;aarij 70:40 — nach Ibn Taimiyya und Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Nein! Ich schwöre beim Herrn der Osten und der Westen, Wir haben fürwahr die Macht dazu,\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/de/ayah/70-40.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/70-40.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/70-40.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/70-40.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/70-40.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/70-40.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/70-40.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/70-40.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/70-40.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/70-40.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/70-40.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/70-40.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/70-40.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/70-40.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/70-40.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/70-40.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/70-40.html\">\n<meta property=\"og:title\" content=\"Tafsir von Al-Ma&#x27;aarij 70:40 — nach Ibn Taimiyya und Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"Nein! Ich schwöre beim Herrn der Osten und der Westen, Wir haben fürwahr die Macht dazu,\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/de/\">Startseite</a> › <a href=\"/de/surah/70.html\">Sura Al-Ma&#x27;aarij</a> › Vers 40</nav><h1>Tafsir von Sura Al-Ma&#x27;aarij 70:40</h1><p class=\"vt ar\" lang=\"ar\">﴿فَلَا أُقْسِمُ بِرَبِّ الْمَشَارِقِ وَالْمَغَارِبِ إِنَّا لَقَادِرُونَ﴾</p><section><h3>Übersetzung der Bedeutung</h3><p class=\"tr\">Nein! Ich schwöre beim Herrn der Osten und der Westen, Wir haben fürwahr die Macht dazu,</p><span class=\"cr\" dir=\"ltr\">German Translation - Frank Bubenheim — v1.1.4 · QuranEnc.com</span></section><p class=\"cr\">Die Worte der beiden Imame werden im arabischen Original wortgetreu und mit Quellenangaben wiedergegeben.</p><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">أقسم سبحانه برب المشارق والمغارب وهي إما مشارق النجوم ومغاربها أو مشارق الشمس ومغاربها<cite>«التبيان في أقسام القرآن» 1/194</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=de#s70a40\">Im interaktiven Tafsir öffnen (vollständige Texte)</a><div class=\"pn\"><a href=\"/de/ayah/70-34.html\">Vorheriger Vers (70:34)</a><a href=\"/de/ayah/70-41.html\">Nächster Vers (70:41)</a></div></main><footer class=\"site-foot\"><span>Tafsir der beiden Schaichs · <a href=\"/de/\">Startseite</a> · <a href=\"/about.html\">Über das Projekt</a> · <a href=\"/privacy.html\">Datenschutz &amp; Bedingungen</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/70-41.html":"<!doctype html>\n<html lang=\"de\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir von Al-Ma&#x27;aarij 70:41 — nach Ibn Taimiyya und Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"daß Wir sie durch bessere als sie austauschen. Und niemand kann Uns zuvorkommen.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/de/ayah/70-41.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/70-41.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/70-41.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/70-41.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/70-41.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/70-41.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/70-41.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/70-41.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/70-41.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/70-41.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/70-41.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/70-41.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/70-41.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/70-41.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/70-41.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/70-41.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/70-41.html\">\n<meta property=\"og:title\" content=\"Tafsir von Al-Ma&#x27;aarij 70:41 — nach Ibn Taimiyya und Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"daß Wir sie durch bessere als sie austauschen. Und niemand kann Uns zuvorkommen.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/de/\">Startseite</a> › <a href=\"/de/surah/70.html\">Sura Al-Ma&#x27;aarij</a> › Vers 41</nav><h1>Tafsir von Sura Al-Ma&#x27;aarij 70:41</h1><p class=\"vt ar\" lang=\"ar\">﴿عَلَىٰ أَن نُّبَدِّلَ خَيْرًا مِّنْهُمْ وَمَا نَحْنُ بِمَسْبُوقِينَ﴾</p><section><h3>Übersetzung der Bedeutung</h3><p class=\"tr\">daß Wir sie durch bessere als sie austauschen. Und niemand kann Uns zuvorkommen.</p><span class=\"cr\" dir=\"ltr\">German Translation - Frank Bubenheim — v1.1.4 · QuranEnc.com</span></section><p class=\"cr\">Die Worte der beiden Imame werden im arabischen Original wortgetreu und mit Quellenangaben wiedergegeben.</p><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">أي لقادرون على أن نذهب بهم ونأتي بأطوع لنا منهم وخيرا منهم<cite>«التبيان في أقسام القرآن» 1/196</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">ذكر المشارق والمغارب لتضمنهما انتقال الشمس التي هي أحد آياته العظيمة الكبيرة ونقله سبحانه لها وتصريفها كل يوم في مشرق ومغرب فمن فعل هذا كيف يعجزه أن يبدل هؤلاء وينقل إلى أمكنتهم خيرا منهم<cite>«بدائع الفوائد» 1/122</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=de#s70a41\">Im interaktiven Tafsir öffnen (vollständige Texte)</a><div class=\"pn\"><a href=\"/de/ayah/70-40.html\">Vorheriger Vers (70:40)</a></div></main><footer class=\"site-foot\"><span>Tafsir der beiden Schaichs · <a href=\"/de/\">Startseite</a> · <a href=\"/about.html\">Über das Projekt</a> · <a href=\"/privacy.html\">Datenschutz &amp; Bedingungen</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/70.html":"<!doctype html>\n<html lang=\"de\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir von Sura Al-Ma&#x27;aarij — nach Ibn Taimiyya und Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Tafsir von Sura Al-Ma&#x27;aarij — Die Bedeutungen des Korans in den Worten von Ibn Taimiyya und Ibn al-Qayyim\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/de/surah/70.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/surah/70.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/surah/70.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/surah/70.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/surah/70.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/surah/70.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/surah/70.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/surah/70.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/surah/70.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/surah/70.html\">\n<link rel=\"al