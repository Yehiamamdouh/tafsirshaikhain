.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/34-51.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/34-51.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/34-51.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/34-51.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/34-51.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/34-51.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/34-51.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/34-51.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/34-51.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/34-51.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/34-51.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/34-51.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/34-51.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/34-51.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/34-51.html\">\n<meta property=\"og:title\" content=\"Tafsir von Saba 34:51 — nach Ibn Taimiyya und Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"Könntest du nur sehen, wenn sie erschrecken! - Da gibt es kein Entrinnen -, und sie werden von einem nahen Ort aus weggenommen.\">\n<meta property=\"og:url\" content=\"https://tafsirshaikhain.com/de/ayah/34-51.html\">\n<meta property=\"og:site_name\" content=\"Tafsir der beiden Schaichs\">\n<meta property=\"og:locale\" content=\"de_DE\">\n<meta property=\"og:type\" content=\"article\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta property=\"og:image:width\" content=\"1200\">\n<meta property=\"og:image:height\" content=\"630\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<link rel=\"manifest\" href=\"/manifest.webmanifest\">\n<link rel=\"apple-touch-icon\" href=\"/icon-192.png\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"Tafsir von Saba 34:51 — nach Ibn Taimiyya und Ibn al-Qayyim\", \"description\": \"Könntest du nur sehen, wenn sie erschrecken! - Da gibt es kein Entrinnen -, und sie werden von einem nahen Ort aus weggenommen.\", \"inLanguage\": \"de\", \"url\": \"https://tafsirshaikhain.com/de/ayah/34-51.html\", \"mainEntityOfPage\": \"https://tafsirshaikhain.com/de/ayah/34-51.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"Schaich al-Islam Ibn Taimiyya\"}, {\"@type\": \"Person\", \"name\": \"Imam Ibn al-Qayyim\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"Tafsir der beiden Schaichs\", \"url\": \"https://tafsirshaikhain.com/de/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Startseite\", \"item\": \"https://tafsirshaikhain.com/de/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Saba\", \"item\": \"https://tafsirshaikhain.com/de/surah/34.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Vers 51\", \"item\": \"https://tafsirshaikhain.com/de/ayah/34-51.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/de/\">Startseite</a> › <a href=\"/de/surah/34.html\">Sura Saba</a> › Vers 51</nav><h1>Tafsir von Sura Saba 34:51</h1><p class=\"vt ar\" lang=\"ar\">﴿وَلَوْ تَرَىٰ إِذْ فَزِعُوا فَلَا فَوْتَ وَأُخِذُوا مِن مَّكَانٍ قَرِيبٍ﴾</p><section><h3>Übersetzung der Bedeutung</h3><p class=\"tr\">Könntest du nur sehen, wenn sie erschrecken! - Da gibt es kein Entrinnen -, und sie werden von einem nahen Ort aus weggenommen.</p><span class=\"cr\" dir=\"ltr\">German Translation - Frank Bubenheim — v1.1.4 · QuranEnc.com</span></section><p class=\"cr\">Die Worte der beiden Imame werden im arabischen Original wortgetreu und mit Quellenangaben wiedergegeben.</p><section><h2>Schaich al-Islam Ibn Taimiyya</h2><blockquote class=\"ar\" lang=\"ar\">وهو سبحانه يذكر جواب القسم تارة وهو الغالب. وتارة يحذفه كما يحذف جواب لو كثيرا كقوله تعالى: {لو تعلمون علم اليقين} وقوله: {ولو أن قرآنا سيرت به الجبال} {ولو ترى إذ يتوفى الذين كفروا الملائكة} {ولو ترى إذ فزعوا فلا فوت} {ولو ترى إذ وقفوا على النار} {ولو ترى إذ وقفوا على ربهم} . ومثل هذا حذفه من أحسن الكلام؛ لأن المراد أنك لو رأيته لرأيت هولا عظيما<cite>«مجموع الفتاوى» 13/315</cite></blockquote></section><section><h2>Imam Ibn al-Qayyim</h2><h3>Was er von anderen überliefert hat</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">شيخه ابن تيمية (فصل أقسام القرآن، مجموع الفتاوى 13/314-316)</span> <span class=\"st\">أقرّه</span> «قوله تعالى {ولو يرى الذين ظلموا إذ يرون العذاب أن القوة لله جميعا وأن الله شديد العذاب} فالمعنى في أظهر الوجهين لو يرى الذين ظلموا في الدنيا إذ يرون العذاب في الآخرة والجواب محذوف ثم قال {أن القوة لله جميعا} كما قال تعالى {ولو ترى إذ فزعوا فلا فوت} {ولو ترى إذ يتوفى الذين كفروا الملائكة} أي لو ترى ذلك الوقت وما فيه»<cite>«التبيان في أقسام القرآن» 1/3</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=de#s34a51\">Im interaktiven Tafsir öffnen (vollständige Texte)</a><div class=\"pn\"><a href=\"/de/ayah/34-50.html\">Vorheriger Vers (34:50)</a><a href=\"/de/ayah/34-54.html\">Nächster Vers (34:54)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/34-51.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/34-51.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/34-51.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/34-51.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/34-51.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/34-51.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/34-51.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/34-51.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/34-51.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/34-51.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/34-51.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/34-51.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/34-51.html\"