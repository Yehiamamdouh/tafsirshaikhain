ng=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/90-10.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/90-10.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/90-10.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/90-10.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/90-10.html\">\n<meta property=\"og:title\" content=\"Tafsir von Al-Balad 90:10 — nach Ibn Taimiyya und Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"und ihn beide Hochebenen geleitet?\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Startseite\", \"item\": \"https://tafsirshaikhain.com/de/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Al-Balad\", \"item\": \"https://tafsirshaikhain.com/de/surah/90.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Vers 10\", \"item\": \"https://tafsirshaikhain.com/de/ayah/90-10.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/de/\">Startseite</a> › <a href=\"/de/surah/90.html\">Sura Al-Balad</a> › Vers 10</nav><h1>Tafsir von Sura Al-Balad 90:10</h1><p class=\"vt ar\" lang=\"ar\">﴿وَهَدَيْنَاهُ النَّجْدَيْنِ﴾</p><section><h3>Übersetzung der Bedeutung</h3><p class=\"tr\">und ihn beide Hochebenen geleitet?</p><span class=\"cr\" dir=\"ltr\">German Translation - Frank Bubenheim — v1.1.4 · QuranEnc.com</span></section><p class=\"cr\">Die Worte der beiden Imame werden im arabischen Original wortgetreu und mit Quellenangaben wiedergegeben.</p><section><h2>Schaich al-Islam Ibn Taimiyya</h2><blockquote class=\"ar\" lang=\"ar\">الهداية محلها القلب وهذه الأعضاء الثلاثة التي هي دائمة الحركة والكسب إما للإنسان وإما عليه<cite>«مجموع الفتاوى» 16/221</cite></blockquote></section><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">نبهك بهذا الدليل العقلي القاطع أن الذي جعلك تبصر وتتكلم وتعلم أولى أن يكون بصيرا متكلما عالما فأي دليل عقلي قطعي أقوى من هذا وأبين وأقرب إلى المعقول<cite>«الصواعق المرسلة في الرد على الجهمية والمعطلة» 3/915</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=de#s90a10\">Im interaktiven Tafsir öffnen (vollständige Texte)</a><div class=\"pn\"><a href=\"/de/ayah/90-9.html\">Vorheriger Vers (90:9)</a><a href=\"/de/ayah/90-11.html\">Nächster Vers (90:11)</a></div></main><footer class=\"site-foot\"><span>Tafsir der beiden Schaichs · <a href=\"/de/\">Startseite</a> · <a href=\"/about.html\">Über das Projekt</a> · <a href=\"/privacy.html\">Datenschutz &amp; Bedingungen</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/90-11.html":"<!doctype html>\n<html lang=\"de\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir von Al-Balad 90:11 — nach Ibn Taimiyya und Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Aber er ist nicht den steilen Paßweg hinaufgestürmt.\