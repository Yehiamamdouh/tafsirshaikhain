khain.com/de/ayah/86-8.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"Schaich al-Islam Ibn Taimiyya\"}, {\"@type\": \"Person\", \"name\": \"Imam Ibn al-Qayyim\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"Tafsir der beiden Schaichs\", \"url\": \"https://tafsirshaikhain.com/de/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Startseite\", \"item\": \"https://tafsirshaikhain.com/de/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura At-Taariq\", \"item\": \"https://tafsirshaikhain.com/de/surah/86.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Vers 8\", \"item\": \"https://tafsirshaikhain.com/de/ayah/86-8.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/de/\">Startseite</a> › <a href=\"/de/surah/86.html\">Sura At-Taariq</a> › Vers 8</nav><h1>Tafsir von Sura At-Taariq 86:8</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّهُ عَلَىٰ رَجْعِهِ لَقَادِرٌ﴾</p><section><h3>Übersetzung der Bedeutung</h3><p class=\"tr\">Er hat die Macht dazu, ihn zurückkehren zu lassen,</p><span class=\"cr\" dir=\"ltr\">German Translation - Frank Bubenheim — v1.1.4 · QuranEnc.com</span></section><p class=\"cr\">Die Worte der beiden Imame werden im arabischen Original wortgetreu und mit Quellenangaben wiedergegeben.</p><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">الصحيح أن الضمير يرجع على الإنسان، أي إن الله على رده إليه لقادر يوم القيامة<cite>«إعلام الموقعين عن رب العالمين» 1/113</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وطريقة القرآن - وهي الاستدلال بالمبدإ والنشأة الأولى على المعاد والرجوع إليه - وأيضا فإنه قيده بالظرف، وهو {يوم تبلى السرائر} [الطارق: 9]<cite>«إعلام الموقعين عن رب العالمين» 1/113</cite></blockquote><h3>Was er von anderen überliefert hat</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">من قال</span> <span class=\"st\">ردّه</span> «إن الضمير يرجع على الماء أي أن الله على رجعه في الإحليل أو في الصدر أو حبسه عن الخروج لقادر»<cite>«إعلام الموقعين عن رب العالمين» 1/113</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=de#s86a8\">Im interaktiven Tafsir öffnen (vollständige Texte)</a><div class=\"pn\"><a href=\"/de/ayah/86-7.html\">Vorheriger Vers (86:7)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/86-8.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/86-8.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/86-8.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/86-8.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/86-8.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/86-8.html\" hreflang=\"fr\" lang