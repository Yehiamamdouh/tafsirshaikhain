.com/az/ayah/108-2.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/az/\">Ana səhifə</a> › <a href=\"/az/surah/108.html\">Surə Al-Kawthar</a> › Ayə 2</nav><h1>Təfsir: Surə Al-Kawthar 108:2</h1><p class=\"vt ar\" lang=\"ar\">﴿فَصَلِّ لِرَبِّكَ وَانْحَرْ﴾</p><section><h3>Mənanın tərcüməsi</h3><p class=\"tr\">Elə isə Rəbbin üçün namaz qıl və qurban kəs!</p><span class=\"cr\" dir=\"ltr\">Azerbaijani Translation - Ali Khan Musayev — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">İki imamın sözləri mənbələri ilə birlikdə orijinal ərəbcə, olduğu kimi verilir.</p><section><h2>Şeyxülislam İbn Teymiyyə</h2><blockquote class=\"ar\" lang=\"ar\">وقوله: {فصل لربك وانحر} أمره الله أن يجمع بين هاتين العبادتين العظيمتين وهما الصلاة والنسك الدالتان على القرب والتواضع والافتقار وحسن الظن وقوة اليقين وطمأنينة القلب إلى الله وإلى عدته وأمره وفضله وخلفه<cite>«مجموع الفتاوى» 16/531</cite></blockquote></section><section><h2>İmam İbn əl-Qəyyim</h2><blockquote class=\"ar\" lang=\"ar\">الذبيحة تجري مجرى العبادة، ولهذا يقرن الله سبحانه بينهما كقوله: {فصل لربك وانحر} [الكوثر: 2] وقوله: {قل إن صلاتي ونسكي ومحياي ومماتي لله رب العالمين} [الأنعام: 162]<cite>«إعلام الموقعين عن رب العالمين» 2/118</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وبدأ في العيد بالصلاة ثم جعل النحر بعدها، وأخبر أن ( «من ذبح قبلها، فلا نسك له» ) تقديما لما بدأ الله به في قوله {فصل لربك وانحر}<cite>«زاد المعاد في هدي خير العباد» 2/320</cite></blockquote><h3>Başqalarından nəql etdikləri</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">بعض المتأولين</span> <span class=\"st\">ردّه</span> «إن المراد به ضع يدك على نحرك»<cite>«الصواعق المرسلة في الرد على الجهمية والمعطلة» 2/695</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">علي</span> <span class=\"st\">حكاه</span> «إنه وضع اليمين على الشمال في الصلاة تحت صدره،»<cite>«إعلام الموقعين عن رب العالمين» 2/290</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=az#s108a2\">İnteraktiv təfsirdə aç (tam mətnlər)</a><div class=\"pn\"><a href=\"/az/ayah/108-1.html\">Əvvəlki ayə (108:1)</a><a href=\"/az/ayah/108-3.html\">Növbəti ayə (108:3)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/108-2.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/108-2.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/108-2.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/108-2.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/108-2.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/108-2.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/108-2.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/108-2.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/108-2.html\" hreflan