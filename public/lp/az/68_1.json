"og:locale\" content=\"az_AZ\">\n<meta property=\"og:type\" content=\"article\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta property=\"og:image:width\" content=\"1200\">\n<meta property=\"og:image:height\" content=\"630\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<link rel=\"manifest\" href=\"/manifest.webmanifest\">\n<link rel=\"apple-touch-icon\" href=\"/icon-192.png\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"Təfsir: Al-Qalam 68:51 — İbn Teymiyyə və İbn əl-Qəyyimə görə\", \"description\": \"Həqiqətən, kafirlər Zikri (Quranı) eşitdikləri zaman öz baxışları ilə az qala səni gözə gətirsinlər. Onlar (çarəsizlikdən): “O, dəlidir!”– deyirlər.\", \"inLanguage\": \"az\", \"url\": \"https://tafsirshaikhain.com/az/ayah/68-51.html\", \"mainEntityOfPage\": \"https://tafsirshaikhain.com/az/ayah/68-51.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"Şeyxülislam İbn Teymiyyə\"}, {\"@type\": \"Person\", \"name\": \"İmam İbn əl-Qəyyim\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"İki Şeyxin Təfsiri\", \"url\": \"https://tafsirshaikhain.com/az/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Ana səhifə\", \"item\": \"https://tafsirshaikhain.com/az/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surə Al-Qalam\", \"item\": \"https://tafsirshaikhain.com/az/surah/68.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayə 51\", \"item\": \"https://tafsirshaikhain.com/az/ayah/68-51.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/az/\">Ana səhifə</a> › <a href=\"/az/surah/68.html\">Surə Al-Qalam</a> › Ayə 51</nav><h1>Təfsir: Surə Al-Qalam 68:51</h1><p class=\"vt ar\" lang=\"ar\">﴿وَإِن يَكَادُ الَّذِينَ كَفَرُوا لَيُزْلِقُونَكَ بِأَبْصَارِهِمْ لَمَّا سَمِعُوا الذِّكْرَ وَيَقُولُونَ إِنَّهُ لَمَجْنُونٌ﴾</p><section><h3>Mənanın tərcüməsi</h3><p class=\"tr\">Həqiqətən, kafirlər Zikri (Quranı) eşitdikləri zaman öz baxışları ilə az qala səni gözə gətirsinlər. Onlar (çarəsizlikdən): “O, dəlidir!”– deyirlər.</p><span class=\"cr\" dir=\"ltr\">Azerbaijani Translation - Ali Khan Musayev — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">İki imamın sözləri mənbələri ilə birlikdə orijinal ərəbcə, olduğu kimi verilir.</p><section><h2>Şeyxülislam İbn Teymiyyə</h2><blockquote class=\"ar\" lang=\"ar\">والكافر والمنافق يسمع ويرى على وجه البغض والجهل كما قال تعالى: {وإن يكاد الذين كفروا ليزلقونك بأبصارهم لما سمعوا الذكر}<cite>«مجموع الفتاوى» 15/342</cite></blockquote></section><section><h2>İmam İbn əl-Qəyyim</h2><blockquote class=\"ar\" lang=\"ar\">فالكفار كانوا ينظرون إليه نظر حاسد شديد العدواة فهو نظر يكاد يزلقه لولا حفظ الله وعصمته فهذا أشد من نظر العائن بل هو جنس من نظر العائن فمن قال إنه من الإصابة بالعين أراد هذا المعنى ومن قال: ليس به أراد أن نظرهم لم يكن نظر استحسان وإعجاب<cite>«بدائع الفوائد» 2/231</cite></blockquote><h3>Başqalarından nəql etdikləri</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">غير واحد من المفسرين</span> <span class=\"st\">حكاه</span> «إنه الإصابة بالعين فأرادوا أن يصيبوا بها رسول الله صلى الله عليه وسلم»<cite>«بدائع الفوائد» 2/231</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن قتيبة</span> <span class=\"st\">حكاه</span> «ليس المراد أنهم يصيبونك بالعين كما يصيب العائن بعينه ما يعجبه وإنما أراد أنهم ينظرون إليك إذا قرأت القرآن الكريم نظرا شديدا بالعداوة والبغضاء يكاد يسقطك»<cite>«بدائع الفوائد» 2/231</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الزجاج</span> <span class=\"st\">حكاه</span> «يعني من شدة العداوة يكادون بنظرهم نظر البغضاء أن يصرعوك»<cite>«بدائع الفوائد» 2/231</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=az#s68a51\">İnteraktiv təfsirdə aç (tam mətnlər)</a><div class=\"pn\"><a href=\"/az/ayah/68-50.html\">Əvvəlki ayə (68:50)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/68-51.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/68-51.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/68-51.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/68-51.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/68-51.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/68-51.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/68-51.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/68-51.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/68-51.html\" hrefl