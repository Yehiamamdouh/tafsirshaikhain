.com/de/ayah/85-2.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/85-2.html\">\n<meta property=\"og:title\" content=\"Тафсир: Al-Burooj 85:2 — по словам Ибн Таймии и Ибн аль-Каййима\">\n<meta property=\"og:description\" content=\"и Днём обещанным,\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ru/\">Главная</a> › <a href=\"/ru/surah/85.html\">Сура Al-Burooj</a> › Аят 2</nav><h1>Тафсир: Сура Al-Burooj 85:2</h1><p class=\"vt ar\" lang=\"ar\">﴿وَالْيَوْمِ الْمَوْعُودِ﴾</p><section><h3>Перевод смыслов</h3><p class=\"tr\">и Днём обещанным,</p><span class=\"cr\" dir=\"ltr\">Russian Translation - Rowwad Translation Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Слова двух имамов приводятся на арабском языке оригинала, дословно, со ссылками на источники.</p><section><h2>Имам Ибн аль-Каййим</h2><blockquote class=\"ar\" lang=\"ar\">ثم أقسم باليوم الموعود وهو يوم القيامة وهو المقسم به وعليه<cite>«التبيان في أقسام القرآن» 1/89</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ru#s85a2\">Открыть в интерактивном тафсире (полные тексты)</a><div class=\"pn\"><a href=\"/ru/ayah/85-1.html\">Предыдущий аят (85:1)</a><a href=\"/ru/ayah/85-10.html\">Следующий аят (85:10)</a></div></main><footer class=\"site-foot\"><span>Тафсир двух шейхов · <a href=\"/ru/\">Главная</a> · <a href=\"/about.html\">О проекте</a> · <a href=\"/privacy.html\">Конфиденциальность и условия</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/85-10.html":"<!doctype html>\n<html lang=\"ru\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Тафсир: Al-Burooj 85:10 — по словам Ибн Таймии и Ибн аль-Каййима</title>\n<meta name=\"description\" content=\"Воистину, те, которые подвергали испытанию верующих мужчин и верующих женщин, а затем не раскаялись, — для них наказание Геенны, и для них — наказание сжиг\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/ru/ayah/85-10.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/85-10.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/85-10.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/85-10.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/85-10.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/85-10.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/85-10.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/85-10.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/85-10.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/85-10.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/85-10.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/85-10.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/85-10.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/85-10.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/85-10.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/85-10.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/85-10.html\">\n<meta property=\"og:title\" content=\"Тафсир: Al-Burooj 85:10 — по словам Ибн Таймии и Ибн аль-Каййима\">\n<meta property=\"og:description\" content=\"Воистину, те, которые подвергали испытанию верующих мужчин и верующих женщин, а затем не раскаялись, — для них наказание Геенны, и для них — наказание сжиг\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ru/\">Главная</a> › <a href=\"/ru/surah/85.html\">Сура Al-Burooj</a> › Аят 10</nav><h1>Тафсир: Сура Al-Burooj 85:10</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّ الَّذِينَ فَتَنُوا الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ ثُمَّ لَمْ يَتُوبُوا فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ الْحَرِيقِ﴾</p><section><h3>Перевод смыслов</h3><p class=\"tr\">Воистину, те, которые подвергали испытанию верующих мужчин и верующих женщин, а затем не раскаялись, — для них наказание Геенны, и для них — наказание сжигающего огня.</p><span class=\"cr\" dir=\"ltr\">Russian Translation - Rowwad Translation Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Слова двух имамов приводятся на арабском языке оригинала, дословно, со ссылками на источники.</p><section><h2>Имам Ибн аль-Каййим</h2><blockquote class=\"ar\" lang=\"ar\">فسرت الفتنة هاهنا بتعذيبهم المؤمنين، وإحراقهم إياهم بالنار، واللفظ أعم من ذلك<cite>«زاد المعاد في هدي خير العباد» 3/151</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">ويدعوهم إلى التوبة وقد حاربوه وعذبوا أولياءه وأحرقوهم بالنار.<cite>«طريق الهجرتين وباب السعادتين» 1/317</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ru#s85a10\">Открыть в интерактивном тафсире (полные тексты)</a><div class=\"pn\"><a href=\"/ru/ayah/85-2.html\">Предыдущий аят (85:2)</a><a href=\"/ru/ayah/85-14.html\">Следующий аят (85:14)</a></div></main><footer class=\"site-foot\"><span>Тафсир двух шейхов · <a href=\"/ru/\">Главная</a> · <a href=\"/about.html\">О проекте</a> · <a href=\"/privacy.html\">Конфиденциальность и условия</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/85-14.html":"<!doctype html>\n<html lang=\"ru\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Тафсир: Al-Burooj 85:14 — по словам Ибн Таймии и Ибн аль-Каййима</title>\n<meta name=\"description\" content=\"Он — Прощающий, Любящий,\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/ru/ayah/85-14.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/85-14.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/85-14.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/85-14.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/85-14.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/85-14.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/85-14.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/85-14.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/85-14.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/85-14.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/85-14.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/85-14.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/85-14.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/85-14.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/85-14.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/85-14.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/85-14.html\">\n<meta property=\"og:title\" content=\"Тафсир: Al-Burooj 85:14 — по словам Ибн Таймии и Ибн аль-Каййима\">\n<meta property=\"og:description\" content=\"Он — Прощающий, Любящий,\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ru/\">Главная</a> › <a href=\"/ru/surah/85.html\">Сура Al-Burooj</a> › Аят 14</nav><h1>Тафсир: Сура Al-Burooj 85:14</h1><p class=\"vt ar\" lang=\"ar\">﴿وَهُوَ الْغَفُورُ الْوَدُودُ﴾</p><section><h3>Перевод смыслов</h3><p class=\"tr\">Он — Прощающий, Любящий,</p><span class=\"cr\" dir=\"ltr\">Russian Translation - Rowwad Translation Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Слова двух имамов приводятся на арабском языке оригинала, дословно, со ссылками на источники.</p><section><h2>Шейх-уль-Ислам Ибн Таймия</h2><h3>Что он передал от других</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">قيل</span> <span class=\"st\">حكاه</span> «معناه المودود؛ كالحلوب، والركوب؛ بمعنى المحلوب والمركوب»<cite>«النبوات» 1/362</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">قيل</span> <span class=\"st\">حكاه</span> «يغفر، ويود أن يغفر»<cite>«النبوات» 1/362</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">قيل</span> <span class=\"st\">حكاه</span> «المتودد إلى أوليائه بالمغفرة»<cite>«النبوات» 1/362</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">غير مسمى في المقطع</span> <span class=\"st\">حكاه</span> «أي المحب لهم،»<cite>«النبوات» 1/362</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ru#s85a14\">Открыть в интерактивном тафсире (полные тексты)</a><div class=\"pn\"><a href=\"/ru/ayah/85-10.html\">Предыдущий аят (85:10)</a><a href=\"/ru/ayah/85-20.html\">Следующий аят (85:20)</a></div></main><footer class=\"site-foot\"><span>Тафсир двух шейхов · <a href=\"/ru/\">Главная</a> · <a href=\"/about.html\">О проекте</a> · <a href=\"/privacy.html\">Конфиденциальность и условия</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/85-20.html":"<!doctype html>\n<html lang=\"ru\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Тафсир: Al-Burooj 85:20 — по словам Ибн Таймии и Ибн аль-Каййима</title>\n<met