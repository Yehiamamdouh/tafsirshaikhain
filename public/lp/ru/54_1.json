ment\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Главная\", \"item\": \"https://tafsirshaikhain.com/ru/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Сура Al-Qamar\", \"item\": \"https://tafsirshaikhain.com/ru/surah/54.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Аят 55\", \"item\": \"https://tafsirshaikhain.com/ru/ayah/54-55.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ru/\">Главная</a> › <a href=\"/ru/surah/54.html\">Сура Al-Qamar</a> › Аят 55</nav><h1>Тафсир: Сура Al-Qamar 54:55</h1><p class=\"vt ar\" lang=\"ar\">﴿فِي مَقْعَدِ صِدْقٍ عِندَ مَلِيكٍ مُّقْتَدِرٍ﴾</p><section><h3>Перевод смыслов</h3><p class=\"tr\">в Обители правды, у Всесильного Владыки.</p><span class=\"cr\" dir=\"ltr\">Russian Translation - Rowwad Translation Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Слова двух имамов приводятся на арабском языке оригинала, дословно, со ссылками на источники.</p><section><h2>Имам Ибн аль-Каййим</h2><blockquote class=\"ar\" lang=\"ar\">فسمى الجنة مقعد صدق لحصول كل ما يراد من المقعد الحسن فيها<cite>«حادي الأرواح إلى بلاد الأفراح» 1/101</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ru#s54a55\">Открыть в интерактивном тафсире (полные тексты)</a><div class=\"pn\"><a href=\"/ru/ayah/54-53.html\">Предыдущий аят (54:53)</a></div></main><footer class=\"site-f