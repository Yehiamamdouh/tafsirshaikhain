afsirshaikhain.com/ru/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Сура Ad-Dukhaan\", \"item\": \"https://tafsirshaikhain.com/ru/surah/44.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Аят 38\", \"item\": \"https://tafsirshaikhain.com/ru/ayah/44-38.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ru/\">Главная</a> › <a href=\"/ru/surah/44.html\">Сура Ad-Dukhaan</a> › Аят 38</nav><h1>Тафсир: Сура Ad-Dukhaan 44:38</h1><p class=\"vt ar\" lang=\"ar\">﴿وَمَا خَلَقْنَا السَّمَاوَاتِ وَالْأَرْضَ وَمَا بَيْنَهُمَا لَاعِبِينَ﴾</p><section><h3>Перевод смыслов</h3><p class=\"tr\">Мы не сотворили небеса, и землю, и всё, что между ними, забавляясь.</p><span class=\"cr\" dir=\"ltr\">Russian Translation - Rowwad Translation Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Слова двух имамов приводятся на арабском языке оригинала, дословно, со ссылками на источники.</p><section><h2>Имам Ибн аль-Каййим</h2><blockquote class=\"ar\" lang=\"ar\">إنكاره سبحانه على من زعم أنه لم يخلق الخلق لغاية ولا لحكمة<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/198</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ru#s44a38\">Открыть в интерактивном тафсире (полные тексты)</a><div class=\"pn\"><a href=\"/ru/ayah/44-32.html\">Предыдущий аят (44:32)</a><a href=\"/ru/ayah/44-39.html\">Следующий аят (44:39)</a></div></main><footer class=\"site-foot\"><span>Тафсир двух шейхов · <a href=\"/ru/\">Главная</a> · <a href=\"/about.html\">О проекте</a> · <a href=\"/privacy.html\">Конфиденциальность и условия</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/44-39.html":"<!doctype html>\n<html lang=\"ru\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Тафсир: Ad-Dukhaan 44:39 — по словам Ибн Таймии и Ибн аль-Каййима</title>\n<meta name=\"description\" content=\"Мы сотворили их только с истиной, но большинство из них не знает.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/ru/ayah/44-39.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/44-39.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/44-39.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/44-39.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/44-39.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/44-39.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/44-39.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/44-39.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/44-39.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/44-39.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/44-39.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/44-39.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/44-39.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/44-39.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/44-39.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/44-39.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/44-39.html\">\n<meta property=\"og:title\" content=\"Тафсир: Ad-Dukhaan 44:39 — по словам Ибн Таймии и Ибн аль-Каййима\">\n<meta property=\"og:description\" content=\"Мы сотворили их только с истиной, но большинство из них не знает.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Главная\", \"item\": \"https://tafsirshaikhain.com/ru/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Сура Ad-Dukhaan\", \"item\": \"https://tafsirshaikhain.com/ru/surah/44.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Аят 39\", \"item\": \"https://tafsirshaikhain.com/ru/ayah/44-39.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ru/\">Главная</a> › <a href=\"/ru/surah/44.html\">Сура Ad-Dukhaan</a> › Аят 39</nav><h1>Тафсир: Сура Ad-Dukhaan 44:39</h1><p class=\"vt ar\" lang=\"ar\">﴿مَا خَلَقْنَاهُمَا إِلَّا بِالْحَقِّ وَلَٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ﴾</p><section><h3>Перевод смыслов</h3><p class=\"tr\">Мы сотворили их только с истиной, но большинство из них не знает.</p><span class=\"cr\" dir=\"ltr\">Russian Translation - Rowwad Translation Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Слова двух имамов приводятся на арабском языке оригинала, дословно, со ссылками на источники.</p><section><h2>Имам Ибн аль-Каййим</h2><blockquote class=\"ar\" lang=\"ar\">والحق هو الحكم والغايات المحمودة التي لأجلها خلق ذلك كله<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/198</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فخلق مخلوقاته بسبب الحق ولأجل الحق وخلقها ملتبس بالحق وهو في نفسه حق فمصدره حق وغايته حق وهو يتضمن للحق<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/198</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ru#s44a39\">Открыть в интерактивном тафсире (полные тексты)</a><div class=\"pn\"><a href=\"/ru/ayah/44-38.html\">Предыдущий аят (44:38)</a><a href=\"/ru/ayah/44-56.html\">Следующий аят (44:56)</a></div></main><footer class=\"site-foot\"><span>Тафсир двух шейхов · <a href=\"/ru/\">Главная</a> · <a href=\"/about.html\">О проекте</a> · <a href=\"/privacy.html\">Конфиденциальность и условия</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/44.html":"<!doctype html>\n<html lang=\"ru\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Тафсир: Сура Ad-Dukhaan — по словам Ибн Таймии и Ибн аль-Каййима</title>\n<meta name=\"description\" content=\"Тафсир: Сура Ad-Dukhaan — Смыслы Корана в словах Ибн Таймии и Ибн аль-Каййима\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/ru/surah/44.html\">\n<link rel=\"alternate\" h