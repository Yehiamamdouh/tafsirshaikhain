:title\" content=\"Тафсир: Al-Qadr 97:1 — по словам Ибн Таймии и Ибн аль-Каййима\">\n<meta property=\"og:description\" content=\"Воистину, Мы ниспослали его в Ночь предопределения.\">\n<meta property=\"og:url\" content=\"https://tafsirshaikhain.com/ru/ayah/97-1.html\">\n<meta property=\"og:site_name\" content=\"Тафсир двух шейхов\">\n<meta property=\"og:locale\" content=\"ru_RU\">\n<meta property=\"og:type\" content=\"article\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta property=\"og:image:width\" content=\"1200\">\n<meta property=\"og:image:height\" content=\"630\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<link rel=\"manifest\" href=\"/manifest.webmanifest\">\n<link rel=\"apple-touch-icon\" href=\"/icon-192.png\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"Тафсир: Al-Qadr 97:1 — по словам Ибн Таймии и Ибн аль-Каййима\", \"description\": \"Воистину, Мы ниспослали его в Ночь предопределения.\", \"inLanguage\": \"ru\", \"url\": \"https://tafsirshaikhain.com/ru/ayah/97-1.html\", \"mainEntityOfPage\": \"https://tafsirshaikhain.com/ru/ayah/97-1.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"Шейх-уль-Ислам Ибн Таймия\"}, {\"@type\": \"Person\", \"name\": \"Имам Ибн аль-Каййим\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"Тафсир двух шейхов\", \"url\": \"https://tafsirshaikhain.com/ru/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Главная\", \"item\": \"https://tafsirshaikhain.com/ru/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Сура Al-Qadr\", \"item\": \"https://tafsirshaikhain.com/ru/surah/97.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Аят 1\", \"item\": \"https://tafsirshaikhain.com/ru/ayah/97-1.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ru/\">Главная</a> › <a href=\"/ru/surah/97.html\">Сура Al-Qadr</a> › Аят 1</nav><h1>Тафсир: Сура Al-Qadr 97:1</h1><p class=\"vt ar\" lang=\"ar\">﴿بِّسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ إِنَّا أَنزَلْنَاهُ فِي لَيْلَةِ الْقَدْرِ﴾</p><section><h3>Перевод смыслов</h3><p class=\"tr\">Воистину, Мы ниспослали его в Ночь предопределения.</p><span class=\"cr\" dir=\"ltr\">Russian Translation - Rowwad Translation Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Слова двух имамов приводятся на арабском языке оригинала, дословно, со ссылками на источники.</p><section><h2>Шейх-уль-Ислам Ибн Таймия</h2><blockquote class=\"ar\" lang=\"ar\">فلما أمر في هذه السورة بالقراءة ذكر في التي تليها نزول القرآن ليلة القدر وذكر فيها تنزل الملائكة والروح وفي (المعارج) عروج الملائكة والروح وفي (النبأ) قيام الملائكة والروح. فذكر الصعود والنزول والقيام ثم في التي تليها تلاوته على المنذرين حيث قال: {يتلو صحفا مطهرة} {فيها كتب قيمة} . فهذه السور الثلاث منتظمة للقرآن أمرا به وذكرا لنزوله ولتلاوة الرسول له على المنذرين<cite>«مجموع الفتاوى» 16/477</cite></blockquote></section><section><h2>Имам Ибн аль-Каййим</h2><blockquote class=\"ar\" lang=\"ar\">قال تعالى: {حم والكتاب المبين إنا أنزلناه في ليلة مباركة إنا كنا منذرين فيها يفرق كل أمر حكيم أمرا من عندنا إنا كنا مرسلين} وهذه هي ليلة القدر قطعا لقوله تعالى: {إنا أنزلناه في ليلة القدر}<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/22</cite></blockquote><h3>Что он передал от других</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">مجاهد</span> <span class=\"st\">أقرّه</span> «قال سفيان عن ابن أبي نجيح عن مجاهد ليلة القدر ليلة الحكم»<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/22</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">سعيد بن جبير</span> <span class=\"st\">استشهد به</span> «وقال سفيان عن محمد بن سوقة عن سعيد بن جبير يؤذن للحجاج في ليلة القدر فيكتبون بأسمائهم وأسماء آبائهم فلا يغادر منهم أحد ولا يزاد فيهم ولا ينقص منهم»<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/22</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الحسن</span> <span class=\"st\">استشهد به</span> «وقال ابن علية ثنا ربيعة بن كلثوم قال قال رجل للحسن وأنا أسمع أرأيت ليلة القدر في كل رمضان هي قال نعم والله الذي لا إله إلا هو»<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/22</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ru#s97a1\">Открыть в интерактивном тафсире (полные тексты)</a><div class=\"pn\"><span></span><a href=\"/ru/ayah/97-4.html\">Следующий аят (97:4)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/97-1.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/97-1.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/97-1.html\" hreflan