: \"Сура Al-Maa'un\", \"item\": \"https://tafsirshaikhain.com/ru/surah/107.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Аят 5\", \"item\": \"https://tafsirshaikhain.com/ru/ayah/107-5.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ru/\">Главная</a> › <a href=\"/ru/surah/107.html\">Сура Al-Maa&#x27;un</a> › Аят 5</nav><h1>Тафсир: Сура Al-Maa&#x27;un 107:5</h1><p class=\"vt ar\" lang=\"ar\">﴿الَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ﴾</p><section><h3>Перевод смыслов</h3><p class=\"tr\">которые небрежны в своих молитвах,</p><span class=\"cr\" dir=\"ltr\">Russian Translation - Rowwad Translation Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Слова двух имамов приводятся на арабском языке оригинала, дословно, со ссылками на источники.</p><section><h2>Шейх-уль-Ислам Ибн Таймия</h2><blockquote class=\"ar\" lang=\"ar\">وقد فسر السلف السهو عنها بتأخيرها عن وقتها، وبترك ما يؤمر به فيه<cite>«الفتاوى الكبرى لابن تيمية» 4/456</cite></blockquote><h3>Что он передал от других</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">السلف</span> <span class=\"st\">أقرّه</span> «وقد فسر السلف السهو عنها بتأخيرها عن وقتها، وبترك ما يؤمر به فيه»<cite>«الفتاوى الكبرى لابن تيمية» 4/456</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">طائفة من السلف</span> <span class=\"st\">أقرّه</span> «هم الذين يؤخرونها عن وقتها.»<cite>«مجموع الفتاوى» 22/29</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">بعض السلف</span> <span class=\"st\">حكاه</span> «هم الذين لا يؤدونها على الوجه المأمور به.»<cite>«مجموع الفتاوى» 22/29</cite></blockquote></section><section><h2>Имам Ибн аль-Каййим</h2><h3>Что он передал от других</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">سعد بن أبي وقاص ومسروق بن الأجدع وغيرهما</span> <span class=\"st\">استشهد به</span> «هو تركها حتى يخرج وقتها»<cite>«الصلاة وأحكام تاركها» 1/46</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">سعد بن أبي وقاص</span> <span class=\"st\">استشهد به</span> «إنه ليس ذاك ولكنه إضاعة الوقت»<cite>«الصلاة وأحكام تاركها» 1/46</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">محمد بن كعب القرظي</span> <span class=\"st\">استشهد به</span> «هو تاركها»<cite>«الصلاة وأحكام تاركها» 1/46</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">النبي صلى الله عليه وسلم</span> <span class=\"st\">استشهد به</span> «هم الذين يؤخرون الصلاة عن وقتها»<cite>«الصلاة وأحكام تاركها» 1/46</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ru#s107a5\">Открыть в интерактивном тафсире (полные тексты)</a><div class=\"pn\"><a href=\"/ru/ayah/107-4.html\">Предыдущий аят (107:4)</a><a href=\"/ru/ayah/107-6.html\">Следующий аят (107:6)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/107-5.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/107-5.html\" hr