 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ru/\">Главная</a> › <a href=\"/ru/surah/30.html\">Сура Ar-Room</a> › Аят 54</nav><h1>Тафсир: Сура Ar-Room 30:54</h1><p class=\"vt ar\" lang=\"ar\">﴿اللَّهُ الَّذِي خَلَقَكُم مِّن ضَعْفٍ ثُمَّ جَعَلَ مِن بَعْدِ ضَعْفٍ قُوَّةً ثُمَّ جَعَلَ مِن بَعْدِ قُوَّةٍ ضَعْفًا وَشَيْبَةً يَخْلُقُ مَا يَشَاءُ وَهُوَ الْعَلِيمُ الْقَدِيرُ﴾</p><section><h3>Перевод смыслов</h3><p class=\"tr\">Аллах — Тот, Кто сотворил вас из слабости, затем после слабости наделил силой, затем сделал после силы слабость и старость. Он творит, что пожелает, и Он — Знающий, Могущественный.</p><span class=\"cr\" dir=\"ltr\">Russian Translation - Rowwad Translation Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Слова двух имамов приводятся на арабском языке оригинала, дословно, со ссылками на источники.</p><section><h2>Шейх-уль-Ислам Ибн Таймия</h2><blockquote class=\"ar\" lang=\"ar\">ولفظ القوة قد يراد به ما كان في القدرة أكمل من غيره؛ فهو قدرة أرجح من غيرها أو القدرة التامة.<cite>«مجموع الفتاوى» 5/575</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ru#s30a54\">Открыть в интерактивном тафсире (полные тексты)</a><div class=\"pn\"><a href=\"/ru/ayah/30-52.html\">Предыдущий аят (30:52)</a><a href=\"/ru/ayah/30-57.html\">Следующий аят (30:57)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/30-54.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/30-54.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/30-54.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/30-54.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/30-54.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/30-54.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/30-54.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/30-54.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/30-54.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <b lang=\"ru\">Русский</b> · <a href=\"/sw/ayah/30-54.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/30-54.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/30-54.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/30-54.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/30-54.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a></nav>\n<footer class=\"site-foot\"><span>Тафсир двух шейхов · <a href=\"/ru/\">Главная</a> · <a href=\"/about.html\">О проекте</a> · <a href=\"/privacy.html\">Конфиденциальность и условия</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n<script>try{localStorage.setItem(\"lang\",\"ru\")}catch(e){}document.addEventListener(\"click\",function(e){var a=e.target.closest&&e.target.closest(\"[data-l]\");if(a)try{localStorage.setItem(\"lang\",a.dataset.l)}catch(x){}})</script>\n</body>\n</html>\n","ayah/30-57.html":"<!doctype html>\n<html lang=\"ru\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Тафсир: Ar-Room 30:57 — 