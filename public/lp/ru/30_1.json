lization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ru/\">Главная</a> › <a href=\"/ru/surah/30.html\">Сура Ar-Room</a> › Аят 52</nav><h1>Тафсир: Сура Ar-Room 30:52</h1><p class=\"vt ar\" lang=\"ar\">﴿فَإِنَّكَ لَا تُسْمِعُ الْمَوْتَىٰ وَلَا تُسْمِعُ الصُّمَّ الدُّعَاءَ إِذَا وَلَّوْا مُدْبِرِينَ﴾</p><section><h3>Перевод смыслов</h3><p class=\"tr\">Ведь, воистину, ты не заставишь слышать мёртвых и не заставишь глухих услышать зов, когда они обращаются вспять.</p><span class=\"cr\" dir=\"ltr\">Russian Translation - Rowwad Translation Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Слова двух имамов приводятся на арабском языке оригинала, дословно, со ссылками на источники.</p><section><h2>Имам Ибн аль-Каййим</h2><blockquote class=\"ar\" lang=\"ar\">وأما سماع الفهم فهو المنفي عن أهل الإعراض والغفلة، بقوله تعالى {فإنك لا تسمع الموتى ولا تسمع الصم الدعاء} [الروم: 52]<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/480</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ru#s30a52\">Открыть в интерактивном тафсире (полные тексты)</a><div class=\"pn\"><a href=\"/ru/ayah/30-50.html\">Предыдущий аят (30:50)</a><a href=\"/ru/ayah/30-54.html\">Следующий аят (30:54)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/30-52.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/30-52.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/30-52.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/30-52.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/30-52.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/30-52.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/30-52.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/30-52.html\" hreflang=\"