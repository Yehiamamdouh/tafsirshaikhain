https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Главная\", \"item\": \"https://tafsirshaikhain.com/ru/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Сура As-Saff\", \"item\": \"https://tafsirshaikhain.com/ru/surah/61.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Аят 13\", \"item\": \"https://tafsirshaikhain.com/ru/ayah/61-13.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ru/\">Главная</a> › <a href=\"/ru/surah/61.html\">Сура As-Saff</a> › Аят 13</nav><h1>Тафсир: Сура As-Saff 61:13</h1><p class=\"vt ar\" lang=\"ar\">﴿وَأُخْرَىٰ تُحِبُّونَهَا نَصْرٌ مِّنَ اللَّهِ وَفَتْحٌ قَرِيبٌ وَبَشِّرِ الْمُؤْمِنِينَ﴾</p><section><h3>Перевод смыслов</h3><p class=\"tr\">И [дарует вам] другое, что вы любите: помощь от Аллаха и близкую победу. Обрадуй же верующих.</p><span class=\"cr\" dir=\"ltr\">Russian Translation - Rowwad Translation Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Слова двух имамов приводятся на арабском языке оригинала, дословно, со ссылками на источники.</p><section><h2>Шейх-уль-Ислам Ибн Таймия</h2><blockquote class=\"ar\" lang=\"ar\">وفي الدنيا النصر والفتح وهما أيضا دفع المضرة وحصول المنفعة<cite>«مجموع الفتاوى» 20/194</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ru#s61a13\">Открыть в ин