\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Главная\", \"item\": \"https://tafsirshaikhain.com/ru/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Сура Ad-Dukhaan\", \"item\": \"https://tafsirshaikhain.com/ru/surah/44.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Аят 56\", \"item\": \"https://tafsirshaikhain.com/ru/ayah/44-56.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ru/\">Главная</a> › <a href=\"/ru/surah/44.html\">Сура Ad-Dukhaan</a> › Аят 56</nav><h1>Тафсир: Сура Ad-Dukhaan 44:56</h1><p class=\"vt ar\" lang=\"ar\">﴿لَا يَذُوقُونَ فِيهَا الْمَوْتَ إِلَّا الْمَوْتَةَ الْأُولَىٰ وَوَقَاهُمْ عَذَابَ الْجَحِيمِ﴾</p><section><h3>Перевод смыслов</h3><p class=\"tr\">Там они не вкусят смерти, кроме первой смерти; и Аллах защитил их от наказания адского пекла.</p><span class=\"cr\" dir=\"ltr\">Russian Translation - Rowwad Translation Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Слова двух имамов приводятся на арабском языке оригинала, дословно, со ссылками на источники.</p><section><h2>Шейх-уль-Ислам Ибн Таймия</h2><blockquote class=\"ar\" lang=\"ar\">فإن قيل: فلم لم يصف نعيم الجنة بالذوق؟ قيل: لأن الذوق يدل على جنس الإحساس ويقال: ذاق الطعام لمن وجد طعمه وإن لم يأكله. وأهل الجنة نعيمهم كامل تام لا يقتصر فيه على الذوق؛ بل استعمل لفظ الذوق في النفي كما قال عن أهل النار: {لا يذوقون فيها بردا ولا شرابا} أي لا يحصل لهم من ذلك ولا ذوق. وقال عن أهل الجنة: {لا يذوقون فيها الموت إلا الموتة الأولى}<cite>«مجموع الفتاوى» 7/111</cite></blockquote></section><section><h2>Имам Ибн аль-Каййим</h2><blockquote class=\"ar\" lang=\"ar\">وأما قوله: {لا يذوقون فيها الموت إلا الموتة الأولى} [الدخان: 56] فهذا الاستثناء هو لتحقيق دوام الحياة وعدم ذوق الموت<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/326</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">قوله تعالى: {لا يذوقون فيها الموت إلا الموتة الأولى} فهذا من الاستثناء السابق زمانه زمان المستثنى منه<cite>«بدائع الفوائد» 3/70</cite></blockquote><h3>Что он передал от других</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">بعضهم</span> <span class=\"st\">أقرّه</span> «(إلا) بمعنى بعد والمعنى لا يذوقون بعد الموتة الأولى موتا في الجنة»<cite>«بدائع الفوائد» 3/70</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ru#s44a56\">Открыть в интерактивном тафсире (полные тексты)</a><div class=\"pn\"><a href=\"/ru/ayah/44-51.html\">Предыдущий аят (44:51)</a><a href=\"/ru/ayah/44-58.html\">Следующий аят (44:58)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/44-56.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/44-56.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/44-56.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/44-56.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/44-56.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/44-56.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/44-56.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/44-56.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/44-56.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <b lang=\"ru\">Русский</b> · <a href=\"/sw/ayah/44-56.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/44-56.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/44-56.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/44-56.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/44-56.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a></nav>\n<footer class=\"site-foot\"><span>Тафсир двух шейхов · <a href=\"/ru/\">Главная</a> · <a href=\"/about.html\">О проекте</a> · <a href=\"/privacy.html\">Конфиденциальность и условия</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n<script>try{localStorage.setItem(\"lang\",\"ru\")}catch(e){}document.addEventListener(\"click\",function(e){var a=e.target.closest&&e.target.closest(\"[data-l]\");if(a)try{localStorage.setItem(\"lang\",a.dataset.l)}catch(x){}})</script>\n</body>\n</html>\n","ayah/44-58.html":"<!doctype html>\n<html lang=\"ru\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Тафсир: Ad-Dukhaan 44:58 — по словам Ибн Таймии и Ибн аль-Каййима</title>\n<meta name=\"description\" content=\"И, воистину, Мы облегчили его [Коран] на твоём языке, — быть может, они внемлют напоминанию.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/ru/ayah/44-58.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/44-58.html\">\