em\": \"https://tafsirshaikhain.com/ru/surah/56.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Аят 25\", \"item\": \"https://tafsirshaikhain.com/ru/ayah/56-25.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ru/\">Главная</a> › <a href=\"/ru/surah/56.html\">Сура Al-Waaqia</a> › Аят 25</nav><h1>Тафсир: Сура Al-Waaqia 56:25</h1><p class=\"vt ar\" lang=\"ar\">﴿لَا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا تَأْثِيمًا﴾</p><section><h3>Перевод смыслов</h3><p class=\"tr\">Не услышат они там ни пустословия, ни побуждения к греху,</p><span class=\"cr\" dir=\"ltr\">Russian Translation - Rowwad Translation Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Слова двух имамов приводятся на арабском языке оригинала, дословно, со ссылками на источники.</p><section><h2>Имам Ибн аль-Каййим</h2><blockquote class=\"ar\" lang=\"ar\">وهذا فيه نفي لسماع اللغو والتأثيم وإثبات لضده وهو السلام المنافي لهما<cite>«بدائع الفوائد» 3/69</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وعلى هذا فلا حاجة إلى تكلف دخوله تحت المستثنى منه لأنه يتضمن زوال هذه الفائدة من الكلام<cite>«بدائع الفوائد» 3/69</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ru#s56a25\">Открыть в интерактивном тафсире (полные тексты)</a><div class=\"pn\"><a href=\"/ru/ayah/56-17.html\">Предыдущий аят (56:17)</a><a href=\"/ru/ayah/56-26.html\">Следующий аят (56:26)</a></div></main><footer class=\"site-foot\"><span>Тафсир двух шейхов · <a href=\"/ru/\">Главная</a> · <a href=\"/about.html\">О проекте</a> · <a href=\"/privacy.html\">Конфиденциальность и условия</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/56-26.html":"<!doctype html>\n<html lang=\"ru\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Тафсир: Al-Waaqia 56:26 — по словам Ибн Таймии и Ибн аль-Каййима</title>\n<meta name=\"description\" content=\"а только слова: «Мир! Мир!»\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/ru/ayah/56-26.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/56-26.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/56-26.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/56-26.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/56-26.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/56-26.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/56-26.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/56-26.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/56-26.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/56-26.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/56-26.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/56-26.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/56-26.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/56-26.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/56-26.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/56-26.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/56-26.html\">\n<meta property=\"og:title\" content=\"Тафсир: Al-Waaqia 56:26 — по словам Ибн Таймии и Ибн аль-Каййима\">\n<meta property=\"og:description\" content=\"а только слова: «Мир! Мир!»\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Главная\", \"item\": \"https://tafsirshaikhain.com/ru/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Сура Al-Waaqia\", \"item\": \"https://tafsirshaikhain.com/ru/surah/56.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Аят 26\", \"item\": \"https://tafsirshaikhain.com/ru/ayah/56-26.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ru/\">Главная</a> › <a href=\"/ru/surah/56.html\">Сура Al-Waaqia</a> › Аят 26</nav><h1>Тафсир: Сура Al-Waaqia 56:26</h1><p class=\"vt ar\" lang=\"ar\">﴿إِلَّا قِيلًا سَلَامًا سَلَامًا﴾</p><section><h3>Перевод смыслов</h3><p class=\"tr\">а только слова: «Мир! Мир!»</p><span class=\"cr\" dir=\"ltr\">Russian Translation - Rowwad Translation Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Слова двух имамов приводятся на арабском языке оригинала, дословно, со ссылками на источники.</p><section><h2>Имам Ибн аль-Каййим</h2><blockquote class=\"ar\" lang=\"ar\">وهذا فيه نفي لسماع اللغو والتأثيم وإثبات لضده وهو السلام المنافي لهما<cite>«بدائع الفوائد» 3/69</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وعلى هذا فلا حاجة إلى تكلف دخوله تحت المستثنى منه لأنه يتضمن زوال هذه الفائدة من الكلام<cite>«بدائع الفوائد» 3/69</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ru#s56a26\">Открыть в интерактивном тафсире (полные тексты)</a><div class=\"pn\"><a href=\"/ru/ayah/56-25.html\">Предыдущий аят (56:25)</a><a href=\"/ru/ayah/56-29.html\">Следующий аят (56:29)</a></div></main><footer class=\"site-foot\"><span>Тафсир двух шейхов · <a href=\"/ru/\">Главная</a> · <a href=\"/about.html\">О проекте</a> · <a href=\"/privacy.html\">Конфиденциальность и условия</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/56-29.html":"<!doctype html>\n<html lang=\"ru\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Тафсир: Al-Waaqia 56:29 — по словам Ибн Таймии и Ибн аль-Каййима</title>\n<meta name=\"description\" content=\"и акаций с рядами [соцветий],\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/ru/ayah/56-29.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/56-29.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/56-29.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/56-29.html\">\n<link rel=\"alter