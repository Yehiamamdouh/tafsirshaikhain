\" content=\"Тафсир двух шейхов\">\n<meta property=\"og:locale\" content=\"ru_RU\">\n<meta property=\"og:type\" content=\"article\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta property=\"og:image:width\" content=\"1200\">\n<meta property=\"og:image:height\" content=\"630\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<link rel=\"manifest\" href=\"/manifest.webmanifest\">\n<link rel=\"apple-touch-icon\" href=\"/icon-192.png\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"Тафсир: Ash-Shura 42:52 — по словам Ибн Таймии и Ибн аль-Каййима\", \"description\": \"И так Мы внушили тебе дух [Откровение] по Нашему велению. Ты не знал ни что такое Писание, ни что такое вера. Однако Мы сделали его светом, посредством кот\", \"inLanguage\": \"ru\", \"url\": \"https://tafsirshaikhain.com/ru/ayah/42-52.html\", \"mainEntityOfPage\": \"https://tafsirshaikhain.com/ru/ayah/42-52.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"Шейх-уль-Ислам Ибн Таймия\"}, {\"@type\": \"Person\", \"name\": \"Имам Ибн аль-Каййим\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"Тафсир двух шейхов\", \"url\": \"https://tafsirshaikhain.com/ru/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Главная\", \"item\": \"https://tafsirshaikhain.com/ru/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Сура Ash-Shura\", \"item\": \"https://tafsirshaikhain.com/ru/surah/42.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Аят 52\", \"item\": \"https://tafsirshaikhain.com/ru/ayah/42-52.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ru/\">Главная</a> › <a href=\"/ru/surah/42.html\">Сура Ash-Shura</a> › Аят 52</nav><h1>Тафсир: Сура Ash-Shura 42:52</h1><p class=\"vt ar\" lang=\"ar\">﴿وَكَذَٰلِكَ أَوْحَيْنَا إِلَيْكَ رُوحًا مِّنْ أَمْرِنَا مَا كُنتَ تَدْرِي مَا الْكِتَابُ وَلَا الْإِيمَانُ وَلَٰكِن جَعَلْنَاهُ نُورًا نَّهْدِي بِهِ مَن نَّشَاءُ مِنْ عِبَادِنَا وَإِنَّكَ لَتَهْدِي إِلَىٰ صِرَاطٍ مُّسْتَقِيمٍ﴾</p><section><h3>Перевод смыслов</h3><p class=\"tr\">И так Мы внушили тебе дух [Откровение] по Нашему велению. Ты не знал ни что такое Писание, ни что такое вера. Однако Мы сделали его светом, посредством которого наставляем на верный путь тех из Наших рабов, кого пожелаем. И, воистину, ты непременно наставляешь на прямой путь —</p><span class=\"cr\" dir=\"ltr\">Russian Translation - Rowwad Translation Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Слова двух имамов приводятся на арабском языке оригинала, дословно, со ссылками на источники.</p><section><h2>Шейх-уль-Ислам Ибн Таймия</h2><blockquote class=\"ar\" lang=\"ar\">وهو في اللفظ يعود إلى الروح الذي أوحاه وهو الوحي الذي جاء بالإيمان والقرآن.<cite>«مجموع الفتاوى» 15/73</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فقد تبين أن كلاهما من الله نور وهدى ومنه هذا يعقل بالقلب؛ لما قد يشاهد من دلائل الإيمان مثل دلائل الربوبية والنبوة وهذا يسمع بالآذان<cite>«مجموع الفتاوى» 15/73</cite></blockquote><h3>Что он передал от других</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن عباس والسدي (في مرجع الضمير: جعلناه نورا)</span> <span class=\"st\">أقرّه</span> «يعود إلى الإيمان ذكر ذلك عن ابن عباس. وقيل: إلى القرآن. وهو قول السدي»<cite>«مجموع الفتاوى» 15/73</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن عباس</span> <span class=\"st\">رجّح غيره</span> «وقيل الضمير في قوله: {جعلناه نورا نهدي به من نشاء من عبادنا} يعود إلى الإيمان ذكر ذلك عن ابن عباس.»<cite>«مجموع الفتاوى» 15/73</cite></blockquote></section><section><h2>Имам Ибн аль-Каййим</h2><blockquote class=\"ar\" lang=\"ar\">فأخبر أنه روح تحصل به الحياة، وأنه نور تحصل به الإضاءة<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 3/243</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">ونورا لما يحصل به من الهدى والرشاد.<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 3/155</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ru#s42a52\">Открыть в интерактивном тафсире (полные тексты)</a><div class=\"pn\"><a href=\"/ru/ayah/42-51.html\">Предыдущий аят (42:51)</a><a href=\"/ru/ayah/42-53.html\">Следующий аят (42:53)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/42-52.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/42-52.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/42-52.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/42-52.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/42-52.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/42-52.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/42-52.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/42-52.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/42-52.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <b lang=\"ru\">Русский</b> · <a href=\"/sw/ayah/42-52.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/42-52.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/42-52.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/42-52.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/42-52.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a></nav>\n<footer class=\"site-foot\"><span>Тафсир двух шейхов · <a href=\"/ru/\">Главная</a> · <a href=\"/about.html\">О проекте</a> · <a href=\"/privacy.html\">Конфиденциальность и условия</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n<script>try{localStorage.setItem(\"lang\",\"ru\")}catch(e){}document.addEventListener(\"click\",function(e){var a=e.target.closest&&e.target.closest(\"[data-l]\");if(a)try{localStorage.setItem(\"lang\",a.dataset.l)}catch(x){}})</script>\n</body>\n</html>\n","ayah/42-53.html":"<!doctype html>\n<html lang=\"ru\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Тафсир: Ash-Shura 42:53 — по словам Ибн Таймии и Ибн аль-Каййима</title>\n<meta name=\"description\" content=\"путь Аллаха, Которому принадлежит всё, что в небесах, и всё, что на земле. Знайте же: к Аллаху возвращаются [все] дела.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/ru/ayah/42-53.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/42-53.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/42-53.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/42-53.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/42-53.html\">\n<link rel=\"alternate\" hrefl