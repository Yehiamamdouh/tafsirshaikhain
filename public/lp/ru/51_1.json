://tafsirshaikhain.com/ru/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Сура Adh-Dhaariyat\", \"item\": \"https://tafsirshaikhain.com/ru/surah/51.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Аят 55\", \"item\": \"https://tafsirshaikhain.com/ru/ayah/51-55.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ru/\">Главная</a> › <a href=\"/ru/surah/51.html\">Сура Adh-Dhaariyat</a> › Аят 55</nav><h1>Тафсир: Сура Adh-Dhaariyat 51:55</h1><p class=\"vt ar\" lang=\"ar\">﴿وَذَكِّرْ فَإِنَّ الذِّكْرَىٰ تَنفَعُ الْمُؤْمِنِينَ﴾</p><section><h3>Перевод смыслов</h3><p class=\"tr\">И напоминай, воистину, напоминание приносит пользу верующим.</p><span class=\"cr\" dir=\"ltr\">Russian Translation - Rowwad Translation Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Слова двух имамов приводятся на арабском языке оригинала, дословно, со ссылками на источники.</p><section><h2>Шейх-уль-Ислам Ибн Таймия</h2><blockquote class=\"ar\" lang=\"ar\">والنفع نوعان: حصول النعمة واندفاع النقمة.<cite>«مجموع الفتاوى» 16/184</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وهذا التام النافع يخص به المؤمنين المنتفعين. فهم إذا آمنوا ذكرهم بما أنزل وكلما أنزل شيء من القرآن ذكرهم به ويذكرهم بمعانيه ويذكرهم بما نزل قبل ذلك.<cite>«مجموع الفتاوى» 16/163</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فهو إذا بلغ قوما الرسالة فقامت الحجة عليهم ثم امتنعوا من سماع كلامه أعرض عنهم. فإن الذكرى حينئذ لا تنفع أحدا.<cite>«مجموع الفتاوى» 16/163</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ru#s51a55\">Открыть в интерактивном тафсире (полные тексты)</a><div class=\"pn\"><a href=\"/ru/ayah/51-54.html\">Предыдущий аят (51:54)</a><a href=\"/ru/ayah/51-56.html\">Следующий аят (51:56)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/51-55.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/51-55.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/51-55.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/51-55.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/51-55.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/51-55.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/51-55.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/51-55.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/51-55.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <b lang=\"ru\">Русский</b> · <a href=\"/sw/ayah/51-55.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/51-55.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/51-55.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/51-55.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/51-55.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a></nav>\n<footer class=\"site-foot\"><span>Тафсир двух шейхов · <a href=\"/ru/\">Главная</a> · <a href=\"/about.html\">О проекте</a> · <a href=\"/privacy.html\">Конфиденциальность и условия<