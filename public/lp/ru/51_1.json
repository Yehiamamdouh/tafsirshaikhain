шейхов\", \"url\": \"https://tafsirshaikhain.com/ru/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Главная\", \"item\": \"https://tafsirshaikhain.com/ru/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Сура Adh-Dhaariyat\", \"item\": \"https://tafsirshaikhain.com/ru/surah/51.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Аят 56\", \"item\": \"https://tafsirshaikhain.com/ru/ayah/51-56.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ru/\">Главная</a> › <a href=\"/ru/surah/51.html\">Сура Adh-Dhaariyat</a> › Аят 56</nav><h1>Тафсир: Сура Adh-Dhaariyat 51:56</h1><p class=\"vt ar\" lang=\"ar\">﴿وَمَا خَلَقْتُ الْجِنَّ وَالْإِنسَ إِلَّا لِيَعْبُدُونِ﴾</p><section><h3>Перевод смыслов</h3><p class=\"tr\">И Я не сотворил джиннов и людей не иначе как для того, чтобы они поклонялись Мне.</p><span class=\"cr\" dir=\"ltr\">Russian Translation - Rowwad Translation Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Слова двух имамов приводятся на арабском языке оригинала, дословно, со ссылками на источники.</p><section><h2>Шейх-уль-Ислам Ибн Таймия</h2><blockquote class=\"ar\" lang=\"ar\">والإجابة والاستجابة هي طاعة الأمر والنهي وهي العبادة التي خلق لها الثقلان؛ كما قال تعالى: {وما خلقت الجن والإنس إلا ليعبدون} .<cite>«مجموع الفتاوى» 4/235</cite></blockquote><h3>Что он передал от других</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">مجاهد</span> <span class=\"st\">حكاه</span> «لآمرهم وأنهاهم»<cite>«مجموع الفتاوى» 8/52</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">زيد بن أسلم</span> <span class=\"st\">حكاه</span> «جبلهم على الشقاوة والسعادة»<cite>«مجموع الفتاوى» 8/45</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">علي بن أبي طالب</span> <span class=\"st\">أقرّه</span> «إلا لآمرهم أن يعبدون وأدعوهم إلى عبادتي.»<cite>«مجموع الفتاوى» 8/52</cite></blockquote></section><section><h2>Имам Ибн аль-Каййим</h2><blockquote class=\"ar\" lang=\"ar\">فالعبادة هي الغاية التي خلق لها الجن والإنس والخلائق كلها<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/118</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فأخبر أنه لم يخلق الجن والإنس لحاجة منه إليهم، ولا ليربح عليهم، لكن خلقهم جودا وإحسانا ليعبدوه فيربحوا هم عليه كل الأرباح<cite>«طريق الهجرتين وباب السعادتين» 1/135</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ru#s51a56\">Открыть в интерактивном тафсире (полные тексты)</a><div class=\"pn\"><a href=\"/ru/ayah/51-55.html\">Предыдущий аят (51:55)</a><a href=\"/ru/ayah/51-57.html\">Следующий аят (51:57)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/51-56.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/51-56.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/51-56.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/51-56.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/51-56.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/51-56.h