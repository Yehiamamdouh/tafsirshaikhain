nts)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ru/\">Главная</a> › <a href=\"/ru/surah/113.html\">Сура Al-Falaq</a> › Аят 3</nav><h1>Тафсир: Сура Al-Falaq 113:3</h1><p class=\"vt ar\" lang=\"ar\">﴿وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ﴾</p><section><h3>Перевод смыслов</h3><p class=\"tr\">и от зла ночного мрака, когда он сгущается,</p><span class=\"cr\" dir=\"ltr\">Russian Translation - Rowwad Translation Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Слова двух имамов приводятся на арабском языке оригинала, дословно, со ссылками на источники.</p><section><h2>Шейх-уль-Ислам Ибн Таймия</h2><blockquote class=\"ar\" lang=\"ar\">فإن الغاسق قد فسر بالليل كقولة: {أقم الصلاة لدلوك الشمس إلى غسق الليل} وهذا قول أكثر المفسرين وأهل اللغة.<cite>«مجموع الفتاوى» 17/505</cite></blockquote></section><section><h2>Имам Ибн аль-Каййим</h2><blockquote class=\"ar\" lang=\"ar\">الشر الثاني: شر الغاسق إذا وقب فهذا خاص بعد عام وقد قال أكثر المفسرين أنه الليل<cite>«بدائع الفوائد» 2/216</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ru#s113a3\">Открыть в интерактивном тафсире (полные тексты)</a><div class=\"pn\"><a href=\"/ru/ayah/113-2.html\">Предыдущий аят (113:2)</a><a href=\"/ru/ayah/113-4.html\">Следующий аят (113:4)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/113-3.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/113-3.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/113-3.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/113-3.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/113-3.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/113-3.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Fran