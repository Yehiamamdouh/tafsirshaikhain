rshaikhain.com/ru/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Сура Al-Jumu'a\", \"item\": \"https://tafsirshaikhain.com/ru/surah/62.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Аят 3\", \"item\": \"https://tafsirshaikhain.com/ru/ayah/62-3.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ru/\">Главная</a> › <a href=\"/ru/surah/62.html\">Сура Al-Jumu&#x27;a</a> › Аят 3</nav><h1>Тафсир: Сура Al-Jumu&#x27;a 62:3</h1><p class=\"vt ar\" lang=\"ar\">﴿وَآخَرِينَ مِنْهُمْ لَمَّا يَلْحَقُوا بِهِمْ وَهُوَ الْعَزِيزُ الْحَكِيمُ﴾</p><section><h3>Перевод смыслов</h3><p class=\"tr\">А [Он отправил его] и к другим из них, которые ещё не присоединились к ним. Он — Могущественный, Мудрый.</p><span class=\"cr\" dir=\"ltr\">Russian Translation - Rowwad Translation Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Слова двух имамов приводятся на арабском языке оригинала, дословно, со ссылками на источники.</p><section><h2>Шейх-уль-Ислам Ибн Таймия</h2><blockquote class=\"ar\" lang=\"ar\">فهذا يتناول كل من دخل في الإسلام بعد دخول العرب فيه إلى يوم القيامة<cite>«مجموع الفتاوى» 16/190</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فإن قوله {وآخرين منهم} أي في الدين دون النسب<cite>«مجموع الفتاوى» 16/190</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ru#s62a3\">Открыть в интерактивном тафсире 