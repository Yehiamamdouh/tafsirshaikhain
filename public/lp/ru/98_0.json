\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Аят 6\", \"item\": \"https://tafsirshaikhain.com/ru/ayah/98-6.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ru/\">Главная</a> › <a href=\"/ru/surah/98.html\">Сура Al-Bayyina</a> › Аят 6</nav><h1>Тафсир: Сура Al-Bayyina 98:6</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّ الَّذِينَ كَفَرُوا مِنْ أَهْلِ الْكِتَابِ وَالْمُشْرِكِينَ فِي نَارِ جَهَنَّمَ خَالِدِينَ فِيهَا أُولَٰئِكَ هُمْ شَرُّ الْبَرِيَّةِ﴾</p><section><h3>Перевод смыслов</h3><p class=\"tr\">Воистину, те, которые отвергли веру, — из людей Писания и придающих Аллаху сотоварищей — окажутся в огне Геенны, пребывая там вечно. Такие и есть худшие из созданий.</p><span class=\"cr\" dir=\"ltr\">Russian Translation - Rowwad Translation Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Слова двух имамов приводятся на арабском языке оригинала, дословно, со ссылками на источники.</p><section><h2>Шейх-уль-Ислам Ибн Таймия</h2><blockquote class=\"ar\" lang=\"ar\">فهذه كلها يدخل فيها &quot; المنافقون &quot; الذين هم في الباطن كفار<cite>«مجموع الفتاوى» 7/54</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ru#s98a6\">Открыть в интерактивном тафсире (полные тексты)</a><div class=\"pn\"><a href=\"/ru/ayah/98-4.html\">Предыдущий аят (98:4)</a><a href=\"/ru/ayah/98-7.html\">Следующий аят (98:7)</a></div></main><footer cla