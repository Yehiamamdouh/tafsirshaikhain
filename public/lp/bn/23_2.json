st\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"প্রথম পাতা\", \"item\": \"https://tafsirshaikhain.com/bn/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"সূরা Al-Muminoon\", \"item\": \"https://tafsirshaikhain.com/bn/surah/23.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"আয়াত 116\", \"item\": \"https://tafsirshaikhain.com/bn/ayah/23-116.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/23.html\">সূরা Al-Muminoon</a> › আয়াত 116</nav><h1>তাফসীর সূরা Al-Muminoon 23:116</h1><p class=\"vt ar\" lang=\"ar\">﴿فَتَعَالَى اللَّهُ الْمَلِكُ الْحَقُّ لَا إِلَٰهَ إِلَّا هُوَ رَبُّ الْعَرْشِ الْكَرِيمِ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">সুতরাং আল্লাহ্‌ মহিমান্বিত, প্রকৃত মালিক, তিনি ছাড়া কোনো হক্ক ইলাহ নেই; তিনি সম্মানিত ‘আরাশের রব।</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>ইমাম ইবনুল কাইয়্যিম</h2><blockquote class=\"ar\" lang=\"ar\">فنزه نفسه سبحانه وباعدها عن هذا الحسبان وأنه يتعالى عنه ولا يليق به لقبحه ولمنافاته لحكمته وملكه وإلهيته<cite>«مفتاح دار السعادة ومنشور ولاية العلم والإرادة» 2/12</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s23a116\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/23-115.html\">আগের আয়াত (23:115)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}