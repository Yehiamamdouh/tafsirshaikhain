link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/8.html\">সূরা Al-Anfaal</a> › আয়াত 68</nav><h1>তাফসীর সূরা Al-Anfaal 8:68</h1><p class=\"vt ar\" lang=\"ar\">﴿لَّوْلَا كِتَابٌ مِّنَ اللَّهِ سَبَقَ لَمَسَّكُمْ فِيمَا أَخَذْتُمْ عَذَابٌ عَظِيمٌ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">আল্লাহ্‌র পূর্ব বিধান না থাকলে  তোমরা যা গ্রহণ করেছ সে জন্য তোমাদের উপর মহাশাস্তি আপতিত হত।</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>ইমাম ইবনুল কাইয়্যিম</h2><h3>অন্যদের থেকে যা তিনি উদ্ধৃত করেছেন</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">جمهور المفسرين من السلف ومن بعدهم</span> <span class=\"st\">أقرّه</span> «لولا قضاء من الله سبق لكم يا أهل بدر في اللوح المحفوظ أن الغنائم حلال لكم لعاقبكم»<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/28</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">آخرون</span> <span class=\"st\">أقرّه</span> «لولا كتاب من الله سبق أنه لا يعذب أحدا إلا بعد الحجة لعاقبكم»<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/28</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">آخرون</span> <span class=\"st\">أقرّه</span> «لولا كتاب من الله سبق لأهل بدر أنه مغفور لهم وإن عملوا ما شاؤا لعاقبهم»<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/28</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s8a68\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/8-64.html\">আগের আয়াত (8:64)</a><a href=\"/bn/ayah/8-75.html\">পরের আয়াত (8:75)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/8-75.html":"<!doctype html>\n<html lang=\"bn\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>তাফসীর Al-Anfaal 8:75 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে</title>\n<meta name=\"description\" content=\"আর যারা পরে ঈমান এনেছে, হিজরত করেছে এবং তোমাদের সাথে থেকে জিহদ করেছে  তারাও তোমাদের অন্তর্ভুক্ত এবং আত্মীয়রা আল্লাহ্‌র বিধানে একে অন্যের জন্য বেশি হকদার। ন\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/bn/ayah/8-75.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/8-75.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/8-75.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/8-75.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/8-75.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/8-75.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/8-75.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/8-75.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/8-75.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/8-75.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/8-75.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/8-75.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/8-75.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/8-75.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/8-75.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/8-75.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/8-75.html\">\n<meta property=\"og:title\" content=\"তাফসীর Al-Anfaal 8:75 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে\">\n<meta property=\"og:description\" content=\"আর যারা পরে ঈমান এনেছে, হিজরত করেছে এবং তোমাদের সাথে থেকে জিহদ করেছে  তারাও তোমাদের অন্তর্ভুক্ত এবং আত্মীয়রা আল্লাহ্‌র বিধানে একে অন্যের জন্য বেশি হকদার। ন\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/8.html\">সূরা Al-Anfaal</a> › আয়াত 75</nav><h1>তাফসীর সূরা Al-Anfaal 8:75</h1><p class=\"vt ar\" lang=\"ar\">﴿وَالَّذِينَ آمَنُوا مِن بَعْدُ وَهَاجَرُوا وَجَاهَدُوا مَعَكُمْ فَأُولَٰئِكَ مِنكُمْ وَأُولُو الْأَرْحَامِ بَعْضُهُمْ أَوْلَىٰ بِبَعْضٍ فِي كِتَابِ اللَّهِ إِنَّ اللَّهَ بِكُلِّ شَيْءٍ عَلِيمٌ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">আর যারা পরে ঈমান এনেছে, হিজরত করেছে এবং তোমাদের সাথে থেকে জিহদ করেছে  তারাও তোমাদের অন্তর্ভুক্ত এবং আত্মীয়রা আল্লাহ্‌র বিধানে একে অন্যের জন্য বেশি হকদার। নিশ্চয় আল্লাহ্‌ সবকিছু সম্যক আবগত ।</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">فدخل في الصنف الثالث كل من جاء على هذا الوجه إلى يوم القيامة؛ كما دخلوا في قوله تعالى {والذين آمنوا من بعد وهاجروا وجاهدوا معكم فأولئك منكم}<cite>«مجموع الفتاوى» 28/275</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s8a75\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/8-68.html\">আগের আয়াত (8:68)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}