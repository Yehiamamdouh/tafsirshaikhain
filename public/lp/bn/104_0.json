\"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"প্রথম পাতা\", \"item\": \"https://tafsirshaikhain.com/bn/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"সূরা Al-Humaza\", \"item\": \"https://tafsirshaikhain.com/bn/surah/104.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"আয়াত 2\", \"item\": \"https://tafsirshaikhain.com/bn/ayah/104-2.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/104.html\">সূরা Al-Humaza</a> › আয়াত 2</nav><h1>তাফসীর সূরা Al-Humaza 104:2</h1><p class=\"vt ar\" lang=\"ar\">﴿الَّذِي جَمَعَ مَالًا وَعَدَّدَهُ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">যে সম্পদ জমায় ও তা বার বার গণনা করে ;</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">وصفه بالطعن في الناس والعيب لهم وبجمع المال وتعديده<cite>«مجموع الفتاوى» 16/522</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وقوله: {الذي جمع مالا وعدده} وصفه بالطعن في الناس والعيب لهم وبجمع المال وتعديده وهذا نظير قوله: {والله لا يحب كل مختال فخور} {الذين يبخلون} في &quot; الحديد &quot; ونظيرها في المعنى في &quot; النساء &quot; فإن الهمزة اللمزة يشبه المختال الفخور والجماع المحصي نظير البخيل. وكذلك نظيرهما: قوله {هماز مشاء بنميم} {مناع للخير معتد أثيم} {عتل بعد ذلك زنيم} وصفه بالكبر والبخل وكذلك قوله: {وأما من بخل واستغنى} فهذه خمس مواضع وذلك ناشئ عن حب الشرف والمال فإن محبة الشرف تحمل على انتقاص غيره بالهمز واللمز والفخر والخيلاء ومحبة المال تحمل على البخل<cite>«مجموع الفتاوى» 16/522</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s104a2\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/104-1.html\">আগের আয়াত (104:1)</a><a href=\"/bn/ayah/104-8.html\">পরের আয়াত (104:8)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/104-2.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/104-2.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/104-2.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/104-2.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/104-2.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/104-2.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <b lang=\"bn\">বাংলা</b> · <a href=\"/ms/ayah/104-2.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/104-2.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/104-2.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/104-2.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\