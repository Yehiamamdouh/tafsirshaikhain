/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/31.html\">সূরা Luqman</a> › আয়াত 18</nav><h1>তাফসীর সূরা Luqman 31:18</h1><p class=\"vt ar\" lang=\"ar\">﴿وَلَا تُصَعِّرْ خَدَّكَ لِلنَّاسِ وَلَا تَمْشِ فِي الْأَرْضِ مَرَحًا إِنَّ اللَّهَ لَا يُحِبُّ كُلَّ مُخْتَالٍ فَخُورٍ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">‘আর তুমি মানুষের প্রতি অবজ্ঞাভরে তোমার গাল বাঁকা কর না  এবং যমীনে উদ্ধতভাবে বিচরণ কর না ; নিশ্চয় আল্লাহ্ কোনো উদ্ধত, অহংকারীকে পছন্দ করেন না ।</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">فالفخر يشبه غمط الناس فإن كليهما تكبر على الناس.<cite>«مجموع الفتاوى» 14/220</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وأما بطر الحق - وهو جحده ودفعه - فيشبه الاختيال الباطل فإنه تخيل أن الحق باطل بجحده ودفعه.<cite>«مجموع الفتاوى» 14/220</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s31a18\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/31-15.html\">আগের আয়াত (31:15)</a><a href=\"/bn/ayah/31-21.html\">পরের আয়াত (31:21)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/31-21.html":"<!doctype html>\n<html lang=\"bn\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>তাফসীর Luqman 31:21 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে</title>\n<meta name=\"description\" content=\"আর তাদেরকে যখন বলা হয়, &#x27;আল্লাহ্ যা নাযিল করেছেন তোমরা তা অনুসরণ কর।&#x27; তারা বলে, &#x27;বরং আমরা আমাদের পিতৃপুরুষদেরকে যাতে পেয়েছি তারই অনুসরণ করব।&#x27; শয়তান যদি তাদে\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/bn/ayah/31-21.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/31-21.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/31-21.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/31-21.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/31-21.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/31-21.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/31-21.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/31-21.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/31-21.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/31-21.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/31-21.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/31-21.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/31-21.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/31-21.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/31-21.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/31-21.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/31-21.html\">\n<meta property=\"og:title\" content=\"তাফসীর Luqman 31:21 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে\">\n<meta property=\"og:description\" content=\"আর তাদেরকে যখন বলা হয়, &#x27;আল্লাহ্ যা নাযিল করেছেন তোমরা তা অনুসরণ কর।&#x27; তারা বলে, &#x27;বরং আমরা আমাদের পিতৃপুরুষদেরকে যাতে পেয়েছি তারই অনুসরণ করব।&#x27; শয়তান যদি তাদে\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"প্রথম পাতা\", \"item\": \"https://tafsirshaikhain.com/bn/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"সূরা Luqman\", \"item\": \"https://tafsirshaikhain.com/bn/surah/31.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"আয়াত 21\", \"item\": \"https://tafsirshaikhain.com/bn/ayah/31-21.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/31.html\">সূরা Luqman</a> › আয়াত 21</nav><h1>তাফসীর সূরা Luqman 31:21</h1><p class=\"vt ar\" lang=\"ar\">﴿وَإِذَا قِيلَ لَهُمُ اتَّبِعُوا مَا أَنزَلَ اللَّهُ قَالُوا بَلْ نَتَّبِعُ مَا وَجَدْنَا عَلَيْهِ آبَاءَنَا أَوَلَوْ كَانَ الشَّيْطَانُ يَدْعُوهُمْ إِلَىٰ عَذَابِ السَّعِيرِ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">আর তাদেরকে যখন বলা হয়, &#x27;আল্লাহ্ যা নাযিল করেছেন তোমরা তা অনুসরণ কর।&#x27; তারা বলে, &#x27;বরং আমরা আমাদের পিতৃপুরুষদেরকে যাতে পেয়েছি তারই অনুসরণ করব।&#x27; শয়তান যদি তাদেরকে জ্বলন্ত আগুনের দিকে ডাকে, তবুও কি? (তারা পিতৃপুরুষদের অনুসরণ করবে?)</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>ইমাম ইবনুল কাইয়্যিম</h2><blockquote class=\"ar\" lang=\"ar\">فهذه مناظرة حكاها الله بين المسلمين والكفار فإن الكفار لجأوا إلى تقليد الآباء وظنوا أنه منجيهم لإحسانهم ظنهم بهم<cite>«بدائع الفوائد» 4/173</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s31a21\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/31-18.html\">আগের আয়াত (31:18)</a><a href=\"/bn/ayah/31-25.html\">পরের আয়াত (31:25)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/31-25.html":"<!doctype html>\n<html lang=\"bn\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>তাফসীর Luqman 31:25 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে</title>\n<meta name=\"description\" content=\"আর যদি আপনি তাদেরকে জিজ্ঞেস করেন, &#x27;আসমানসমূহ ও যমীন কে সৃষ্টি করেছেন?&#x27; তারাই অবশ্যই বলবে, &#x27;আল্লাহ।&#x27; বলুন, ‘সকল প্রশংসা আল্লাহ্‌রই’, কিন্তু তাদের অধিকাংশই জ\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/bn/ayah/31-25.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/31-25.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/31-25.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/31-25.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/31-25.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/31-25.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/31-25.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/31-25.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/31-25.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/31-25.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/31-25.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/31-25.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/31-25.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/31-25.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/31-25.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/31-25.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/31-25.html\">\n<meta property=\"og:title\" content=\"তাফসীর Luqman 31:25 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে\">\n<meta property=\"og:description\" content=\"আর যদি আপনি তাদেরকে জিজ্ঞেস করেন, &#x27;আসমানসমূহ ও যমীন কে সৃষ্টি করেছেন?&#x27; তারাই অবশ্যই বলবে, &#x27;আল্লাহ।&#x27; বলুন, ‘সকল প্রশংসা আল্লাহ্‌রই’, কিন্তু তাদের অধিকাংশই জ\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"প্রথম পাতা\", \"item\": \"https://tafsirshaikhain.com/bn/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"সূরা Luqman\", \"item\": \"https://tafsirshaikhain.com/bn/surah/31.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"আয়াত 25\", \"item\": \"https://tafsirshaikhain.com/bn/ayah/31-25.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/31.html\">সূরা Luqman</a> › আয়াত 25</nav><h1>তাফসীর সূরা Luqman 31:25</h1><p class=\"vt ar\" lang=\"ar\">﴿وَلَئِن سَأَلْتَهُم مَّنْ خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ لَيَقُولُنَّ اللَّهُ قُلِ الْحَمْدُ لِلَّهِ بَلْ أَكْثَرُهُمْ لَا يَعْلَمُونَ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">আর যদি আপনি তাদেরকে জিজ্ঞেস করেন, &#x27;আসমানসমূহ ও যমীন কে সৃষ্টি করেছেন?&#x27; তারাই অবশ্যই বলবে, &#x27;আল্লাহ।&#x27; বলুন, ‘সকল প্রশংসা আল্লাহ্‌রই’, কিন্তু তাদের অধিকাংশই জানে না।</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">كانوا يقرون بأن الله خالق كل شيء وربه ومليكه؛ كما أخبر الله عنهم في القرآن في غير موضع<cite>«الاستغاثة في الرد على البكري» 1/158</cite></blockquote></section><section><h2>ইমাম ইবনুল কাইয়্যিম</h2><blockquote class=\"ar\" lang=\"ar\">ولهذا يحتج عليهم به على توحيد إلهيته<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/96</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وهو توحيد الربوبية الذي اعترف به مشركو العرب، ولم يخرجوا به عن الشرك،<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/96</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s31a25\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/31-21.html\">আগের আয়াত (31:21)</a><a href=\"/bn/ayah/31-27.html\">পরের আয়াত (31:27)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/31-27.html":"<!doctype html>\n<html lang=\"bn\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>তাফসীর Luqman 31:27 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে</title>\n<meta name=\"description\" content=\"আর যমীনের সব গাছ যদি কলম হয় এবং সাগর, তার পরে আরও সাত সাগর কালি হিসেবে যুক্ত হয়, তবুও আল্লাহর বাণী  নিঃশেষ হবে না। নিশ্চয় আল্লাহ্ মহা পরাক্রমশালী, হিকমতওয়া\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/bn/ayah/31-27.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/31-27.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/31-27.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/31-27.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/31-27.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/31-27.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/31-27.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/31-27.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/31-27.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/31-27.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/31-27.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/31-27.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/31-27.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/31-27.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/31-27.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/31-27.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/31-27.html\">\n<meta property=\"og:title\" content=\"তাফসীর Luqman 31:27 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে\">\n<meta property=\"og:description\" content=\"আর যমীনের সব গাছ যদি কলম হয় এবং সাগর, তার পরে আরও সাত সাগর কালি হিসেবে যুক্ত হয়, তবুও আল্লাহর বাণী  নিঃশেষ হবে না। নিশ্চয় আল্লাহ্ মহা পরাক্রমশালী, হিকমতওয়া\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"প্রথম পাতা\", \"item\": \"https://tafsirshaikhain.com/bn/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"সূরা Luqman\", \"item\": \"https://tafsirshaikhain.com/bn/surah/31.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"আয়াত 27\", \"item\": \"https://tafsirshaikhain.com/bn/ayah/31-27.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/31.html\">সূরা Luqman</a> › আয়াত 27</nav><h1>তাফসীর সূরা Luqman 31:27</h1><p class=\"vt ar\" lang=\"ar\">﴿وَلَوْ أَنَّمَا فِي الْأَرْضِ مِن شَجَرَةٍ أَقْلَامٌ وَالْبَحْرُ يَمُدُّهُ مِن بَعْدِهِ سَبْعَةُ أَبْحُرٍ مَّا نَفِدَتْ كَلِمَاتُ اللَّهِ إِنَّ اللَّهَ عَزِيزٌ حَكِيمٌ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">আর যমীনের সব গাছ যদি কলম হয় এবং সাগর, তার পরে আরও সাত সাগর কালি হিসেবে যুক্ত হয়, তবুও আল্লাহর বাণী  নিঃশেষ হবে না। নিশ্চয় আল্লাহ্ মহা পরাক্রমশালী, হিকমতওয়ালা।</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">فالأبحر إذا قدرت مدادا تنفد وكلمات الله لا تنفد؛ ولهذا قال أئمة السنة لم يزل الله متكلما كيف شاء وبما شاء<cite>«مجموع الفتاوى» 12/304</cite></blockquote></section><section><h2>ইমাম ইবনুল কাইয়্যিম</h2><blockquote class=\"ar\" lang=\"ar\">فاخبر عن عدم نفاد كلماته لعزته وحكمته وهذان وصفان ذاتيان له سبحانه وتعالى<cite>«حادي الأرواح إلى بلاد الأفراح» 1/351</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فإن الآية سيقت لبيان أن أشجار الأرض لو كانت أقلاما والبحار مدادا فكتبت بها كلمات الله لنفدت البحار والأقلام ولم تنفد كلمات الله<cite>«بدائع الفوائد» 1/57</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فإذا كانت الملازمة ثابتة على هذا التقدير الذي هو أبلغ تقدير يكون في نفاد المكتوب فثبوتها على غيره من التقادير أولى<cite>«بدائع الفوائد» 1/57</cite></blockquote><h3>অন্যদের থেকে যা তিনি উদ্ধৃত করেছেন</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الربيع بن أنس</span> <span class=\"st\">حكاه</span> «وذكر ابن أبي حاتم في تفسيره عن سليمان بن عامر قال سمعت الربيع بن أنس يقول إن مثل علم العباد كلهم في علم الله عز وجل كقطرة من هذه البحور كلها»<cite>«حادي الأرواح إلى بلاد الأفراح» 1/351</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s31a27\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/31-25.html\">আগের আয়াত (31:25)</a><a href=\"/bn/ayah/31-32.html\">পরের আয়াত (31:32)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/31-32.html":"<!doctype html>\n<html lang=\"bn\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>তাফসীর Luqman 31:32 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে</title>\n<meta name=\"description\" content=\"আর যখন তরঙ্গ তাদেরকে আচ্ছন্ন করে ছায়ার মত , তখন তারা আল্লাহকে ডাকে তাঁর আনুগত্যে একনিষ্ঠ হয়ে। অতঃপর যখন তিনি তাদেরকে উদ্ধার করে স্থলে পৌঁছান তখন তাদের কেউ \">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/bn/ayah/31-32.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/31-32.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/31-32.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/31-32.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/31-32.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/31-32.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/31-32.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/31-32.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/31-32.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/31-32.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/31-32.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/31-32.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/31-32.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/31-32.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/31-32.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/31-32.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/31-32.html\">\n<meta property=\"og:title\" content=\"তাফসীর Luqman 31:32 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে\">\n<meta property=\"og:description\" content=\"আর যখন তরঙ্গ তাদেরকে আচ্ছন্ন করে ছায়ার মত , তখন তারা আল্লাহকে ডাকে তাঁর আনুগত্যে একনিষ্ঠ হয়ে। অতঃপর যখন তিনি তাদেরকে উদ্ধার করে স্থলে পৌঁছান তখন তাদের কেউ \">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"প্রথম পাতা\", \"item\": \"https://tafsirshaikhain.com/bn/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"সূরা Luqman\", \"item\": \"https://tafsirshaikhain.com/bn/surah/31.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"আয়াত 32\", \"item\": \"https://tafsirshaikhain.com/bn/ayah/31-32.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/31.html\">সূরা Luqman</a> › আয়াত 32</nav><h1>তাফসীর সূরা Luqman 31:32</h1><p class=\"vt ar\" lang=\"ar\">﴿وَإِذَا غَشِيَهُم مَّوْجٌ كَالظُّلَلِ دَعَوُا اللَّهَ مُخْلِصِينَ لَهُ الدِّينَ فَلَمَّا نَجَّاهُمْ إِلَى الْبَرِّ فَمِنْهُم مُّقْتَصِدٌ وَمَا يَجْحَدُ بِآيَاتِنَا إِلَّا كُلُّ خَتَّارٍ كَفُورٍ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">আর যখন তরঙ্গ তাদেরকে আচ্ছন্ন করে ছায়ার মত , তখন তারা আল্লাহকে ডাকে তাঁর আনুগত্যে একনিষ্ঠ হয়ে। অতঃপর যখন তিনি তাদেরকে উদ্ধার করে স্থলে পৌঁছান তখন তাদের কেউ কেউ মাঝামাঝি অবস্থানে থাকে ; আর শুধু বিশ্বাসঘাতক, কাফির ব্যক্তিই আমাদের নিদর্শনাবলীকে অস্বীকার করে ।</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">فأخبر أنهم مقرون بربوبيته، وأنهم مخلصون له الدين إذا مسهم الضر في دعائهم واستعانتهم،<cite>«قاعدة جامعة في توحيد الله وإخلاص الوجه والعمل له عبادة واستعانة» 1/68</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s31a32\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/31-27.html\">আগের আয়াত (31:27)</a><a href=\"/bn/ayah/31-34.html\">পরের আয়াত (31:34)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/31-34.html":"<!doctype html>\n<html lang=\"bn\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>তাফসীর Luqman 31:34 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে</title>\n<meta name=\"description\" content=\"নিশ্চয় আল্লাহ্ , তাঁর কাছেই রয়েছে কিয়ামতের জ্ঞান, তিনি বৃষ্টি বর্ষণ করেন এবং তিনি জানেন যা মাতৃগর্ভে আছে। আর কেউ জানে না আগামীকাল সে কি অর্জন করবে এবং কেউ \">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/bn/ayah/31-34.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/31-34.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/31-34.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/31-34.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/31-34.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/31-34.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/31-34.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/31-34.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/31-34.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/31-34.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/31-34.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/31-34.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/31-34.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/31-34.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/31-34.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/31-34.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/31-34.html\">\n<meta property=\"og:title\" content=\"তাফসীর Luqman 31:34 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে\">\n<meta property=\"og:description\" content=\"নিশ্চয় আল্লাহ্ , তাঁর কাছেই রয়েছে কিয়ামতের জ্ঞান, তিনি বৃষ্টি বর্ষণ করেন এবং তিনি জানেন যা মাতৃগর্ভে আছে। আর কেউ জানে না আগামীকাল সে কি অর্জন করবে এবং কেউ \">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"প্রথম পাতা\", \"item\": \"https://tafsirshaikhain.com/bn/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"সূরা Luqman\", \"item\": \"https://tafsirshaikhain.com/bn/surah/31.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"আয়াত 34\", \"item\": \"https://tafsirshaikhain.com/bn/ayah/31-34.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/31.html\">সূরা Luqman</a> › আয়াত 34</nav><h1>তাফসীর সূরা Luqman 31:34</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّ اللَّهَ عِندَهُ عِلْمُ السَّاعَةِ وَيُنَزِّلُ الْغَيْثَ وَيَعْلَمُ مَا فِي الْأَرْحَامِ وَمَا تَدْرِي نَفْسٌ مَّاذَا تَكْسِبُ غَدًا وَمَا تَدْرِي نَفْسٌ بِأَيِّ أَرْضٍ تَمُوتُ إِنَّ اللَّهَ عَلِيمٌ خَبِيرٌ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">নিশ্চয় আল্লাহ্ , তাঁর কাছেই রয়েছে কিয়ামতের জ্ঞান, তিনি বৃষ্টি বর্ষণ করেন এবং তিনি জানেন যা মাতৃগর্ভে আছে। আর কেউ জানে না আগামীকাল সে কি অর্জন করবে এবং কেউ জানে না কোন্‌ স্থানে তার মৃত্যু ঘটবে। নিশ্চয় আল্লাহ্ সর্বজ্ঞ, সম্যক অবহিত।</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">فالساعة هنا: معلومة، لا عالمة،<cite>«الحسنة والسيئة» 1/137</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s31a34\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/31-32.html\">আগের আয়াত (31:32)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https: