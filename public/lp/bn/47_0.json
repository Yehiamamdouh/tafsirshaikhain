abic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/47.html\">সূরা Muhammad</a> › আয়াত 22</nav><h1>তাফসীর সূরা Muhammad 47:22</h1><p class=\"vt ar\" lang=\"ar\">﴿فَهَلْ عَسَيْتُمْ إِن تَوَلَّيْتُمْ أَن تُفْسِدُوا فِي الْأَرْضِ وَتُقَطِّعُوا أَرْحَامَكُمْ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">সুতরাং অবাধ্য হয়ে মুখ ফিরিয়ে নিলে সম্ভবত তোমরা যমীনে বিপর্যয় সৃষ্টি করবে এবং আত্নীয়তার বন্ধন  ছিন্ন করবে।</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>ইমাম ইবনুল কাইয়্যিম</h2><blockquote class=\"ar\" lang=\"ar\">أي إن أعرضتم عن الإيمان بالقرآن والرسول وطاعته فليس إلا الفساد في الأرض والشرك والمعاصي<cite>«التبيان في أقسام القرآن» 1/127</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s47a22\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/47-17.html\">আগের আয়াত (47:17)</a><a href=\"/bn/ayah/47-24.html\">পরের আয়াত (47:24)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/47-24.html":"<!doctype html>\n<html lang=\"bn\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>তাফসীর Muhammad 47:24 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে</title>\n<meta name=\"description\" content=\"তবে কি তারা কুরআন নিয়ে গভীর চিন্তা করে না? নাকি তাদের অন্তরসমূহে তালা রয়েছে?\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/bn/ayah/47-24.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/47-24.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/47-24.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/47-24.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/47-24.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/47-24.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/47-24.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/47-24.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/47-24.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/47-24.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/47-24.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/47-24.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/47-24.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/47-24.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/47-24.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/47-24.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/47-24.html\">\n<meta property=\"og:title\" content=\"তাফসীর Muhammad 47:24 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে\">\n<meta property=\"og:description\" content=\"তবে কি তারা কুরআন নিয়ে গভীর চিন্তা করে না? নাকি তাদের অন্তরসমূহে তালা রয়েছে?\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/47.html\">সূরা Muhammad</a> › আয়াত 24</nav><h1>তাফসীর সূরা Muhammad 47:24</h1><p class=\"vt ar\" lang=\"ar\">﴿أَفَلَا يَتَدَبَّرُونَ الْقُرْآنَ أَمْ عَلَىٰ قُلُوبٍ أَقْفَالُهَا﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">তবে কি তারা কুরআন নিয়ে গভীর চিন্তা করে না? নাকি তাদের অন্তরসমূহে তালা রয়েছে?</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">فحض على تدبره وفقهه وعقله والتذكر به والتفكر فيه ولم يستثن من ذلك شيئا؛ بل نصوص متعددة تصرح بالعموم فيه مثل قوله {أفلا يتدبرون القرآن أم على قلوب أقفالها}<cite>«مجموع الفتاوى» 13/307</cite></blockquote></section><section><h2>ইমাম ইবনুল কাইয়্যিম</h2><blockquote class=\"ar\" lang=\"ar\">فلو رفعت الأقفال عن القلوب لباشرتها حقائق القرآن، واستنارت فيها مصابيح الإيمان<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 3/437</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وكأن القلب بمنزلة الباب المرتج الذي قد ضرب عليه قفل فإنه ما لم يفتح القفل لا يمكن فتح الباب والوصول إلى ما وراءه<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/95</cite></blockquote><h3>অন্যদের থেকে যা তিনি উদ্ধৃত করেছেন</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن عباس</span> <span class=\"st\">استشهد به</span> «يريد على قلوب هؤلاء أقفال»<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/95</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">مقاتل</span> <span class=\"st\">استشهد به</span> «يعني الطبع على القلب»<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/95</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s47a24\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/47-22.html\">আগের আয়াত (47:22)</a><a href=\"/bn/ayah/47-30.html\">পরের আয়াত (47:30)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/47-30.html":"<!doctype html>\n<html lang=\"bn\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>তাফসীর Muhammad 47:30 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে</title>\n<meta name=\"description\" content=\"আর আমরা ইচ্ছে করলে আপনাকে তাদের পরিচয় দিতাম; ফলে আপনি তাদের লক্ষণ দেখে তাদেরকে চিনতে পারতেন। তবে আপনি অবশ্যই কথার ভঙ্গিতে তাদেরকে চিনতে পারবেন। আর আল্লাহ \">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/bn/ayah/47-30.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/47-30.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/47-30.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/47-30.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/47-30.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/47-30.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/47-30.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/47-30.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/47-30.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/47-30.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/47-30.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/47-30.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/47-30.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/47-30.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/47-30.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/47-30.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/47-30.html\">\n<meta property=\"og:title\" content=\"তাফসীর Muhammad 47:30 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে\">\n<meta property=\"og:description\" content=\"আর আমরা ইচ্ছে করলে আপনাকে তাদের পরিচয় দিতাম; ফলে আপনি তাদের লক্ষণ দেখে তাদেরকে চিনতে পারতেন। তবে আপনি অবশ্যই কথার ভঙ্গিতে তাদেরকে চিনতে পারবেন। আর আল্লাহ \">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/47.html\">সূরা Muhammad</a> › আয়াত 30</nav><h1>তাফসীর সূরা Muhammad 47:30</h1><p class=\"vt ar\" lang=\"ar\">﴿وَلَوْ نَشَاءُ لَأَرَيْنَاكَهُمْ فَلَعَرَفْتَهُم بِسِيمَاهُمْ وَلَتَعْرِفَنَّهُمْ فِي لَحْنِ الْقَوْلِ وَاللَّهُ يَعْلَمُ أَعْمَالَكُمْ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">আর আমরা ইচ্ছে করলে আপনাকে তাদের পরিচয় দিতাম; ফলে আপনি তাদের লক্ষণ দেখে তাদেরকে চিনতে পারতেন। তবে আপনি অবশ্যই কথার ভঙ্গিতে তাদেরকে চিনতে পারবেন। আর আল্লাহ তোমাদের যাবতীয় আমল সম্পর্কে জানেন।</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">وهو جواب قسم محذوف أي: والله لتعرفهم في لحن القول<cite>«مجموع الفتاوى» 14/110</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فجعل الإرادة والتعريف بالسيما الذي يدرك بالبصر معلقا على المشيئة<cite>«مجموع الفتاوى» 16/68</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s47a30\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/47-24.html\">আগের আয়াত (47:24)</a><a href=\"/bn/ayah/47-33.html\">পরের আয়াত (47:33)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/47-33.html":"<!doctype html>\n<html lang=\"bn\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>তাফসীর Muhammad 47:33 — ইবনে ত