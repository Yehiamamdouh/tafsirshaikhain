ma.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"প্রথম পাতা\", \"item\": \"https://tafsirshaikhain.com/bn/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"সূরা Al-Asr\", \"item\": \"https://tafsirshaikhain.com/bn/surah/103.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"আয়াত 3\", \"item\": \"https://tafsirshaikhain.com/bn/ayah/103-3.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/103.html\">সূরা Al-Asr</a> › আয়াত 3</nav><h1>তাফসীর সূরা Al-Asr 103:3</h1><p class=\"vt ar\" lang=\"ar\">﴿إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَتَوَاصَوْا بِالْحَقِّ وَتَوَاصَوْا بِالصَّبْرِ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">কিন্তু তারা নয় , যারা ঈমান এনেছে  এবং সৎকাজ করেছে  আর পরস্পরকে উপদেশ দিয়েছে হকের  এবং উপদেশ দিয়েছে ধৈর্যের ।</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">فإن الله تعالى أخبر أن جميع الناس خاسرون إلا من كان في نفسه مؤمنا صالحا؛ ومع غيره موصيا بالحق موصيا بالصبر.<cite>«مجموع الفتاوى» 28/151</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فالعلم النافع هو أصل الهدى والعمل بالحق هو الرشاد وضد الأول الضلال وضد الثاني الغي فالضلال العمل بغير علم والغي اتباع الهوى.<cite>«مجموع الفتاوى» 10/40</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فلا ينال الهدى إلا بالعلم ولا ينال الرشاد إلا بالصبر؛<cite>«مجموع الفتاوى» 10/40</cite></blockquote><h3>অন্যদের থেকে যা তিনি উদ্ধৃত করেছেন</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الإمام الشافعي</span> <span class=\"st\">أقرّه</span> «وروي عن الشافعي رضي الله عنه أنه قال: لو فكر الناس كلهم في سورة (والعصر لكفتهم.»<cite>«مجموع الفتاوى» 28/151</cite></blockquote></section><section><h2>ইমাম ইবনুল কাইয়্যিম</h2><blockquote class=\"ar\" lang=\"ar\">ولما كان الإنسان له قوتان قوة العلم وقوة العمل وله حالتان حالة يأتمر فيها بأمر غيره وحالة يأمر فيها غيره استثنى سبحانه من كمل قوته العلمية بالإيمان وقوته العملية بالعمل الصالح وإنقاد لأمر غيره له بذلك وأمر غيره به من الانسان الذي هو في خسر فإن العبد له حالتان حالة كمال في نفسه وحالة تكميل لغيره وكماله وتكميله موقوف على أمرين علم بالحق وصبر عليه فتضمنت الآية جميع مراتب الكمال الانساني من العلم النافع والعمل الصالح والاحسان إلى نفسه بذلك وإلى أخيه به وانقياده وقبوله لمن يأمره بذلك<cite>«التبيان في أقسام القرآن» 1/86</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فإن التواصي هو امر الغير بالإيمان والعمل الصالح وهو قدر زائد على مجرد فعله<cite>«التبيان في أقسام القرآن» 1/85</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s103a3\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/103-2.html\">আগের আয়াত (103:2)</a></div></main><nav cla