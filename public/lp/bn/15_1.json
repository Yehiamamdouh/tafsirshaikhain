mily=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/15.html\">সূরা Al-Hijr</a> › আয়াত 93</nav><h1>তাফসীর সূরা Al-Hijr 15:93</h1><p class=\"vt ar\" lang=\"ar\">﴿عَمَّا كَانُوا يَعْمَلُونَ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">সে বিষয়ে, যা তারা আমল করত।</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">فالأولى تحقيق شهادة أن لا إله إلا الله والثانية تحقيق الشهادة بأن محمدا رسول<cite>«مجموع الفتاوى» 19/172</cite></blockquote><h3>অন্যদের থেকে যা তিনি উদ্ধৃত করেছেন</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">أبو العالية</span> <span class=\"st\">أقرّه</span> «خلتان يسأل عنهما كل أحد: ماذا كنت تعبد؟ وماذا أجبت المرسلين؟»<cite>«مجموع الفتاوى» 19/172</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s15a93\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/15-92.html\">আগের আয়াত (15:92)</a><a href=\"/bn/ayah/15-99.html\">পরের আয়াত (15:99)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/15-99.html":"<!doctype html>\n<html lang=\"bn\" dir=\"ltr\">\n