rty=\"og:title\" content=\"তাফসীর Al-Maa&#x27;un 107:4 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে\">\n<meta property=\"og:description\" content=\"কাজেই দুর্ভোগ সে সালাত আদায়কারীদের,\">\n<meta property=\"og:url\" content=\"https://tafsirshaikhain.com/bn/ayah/107-4.html\">\n<meta property=\"og:site_name\" content=\"তাফসীরুশ শাইখাইন\">\n<meta property=\"og:locale\" content=\"bn_BD\">\n<meta property=\"og:type\" content=\"article\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta property=\"og:image:width\" content=\"1200\">\n<meta property=\"og:image:height\" content=\"630\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<link rel=\"manifest\" href=\"/manifest.webmanifest\">\n<link rel=\"apple-touch-icon\" href=\"/icon-192.png\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"তাফসীর Al-Maa'un 107:4 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে\", \"description\": \"কাজেই দুর্ভোগ সে সালাত আদায়কারীদের,\", \"inLanguage\": \"bn\", \"url\": \"https://tafsirshaikhain.com/bn/ayah/107-4.html\", \"mainEntityOfPage\": \"https://tafsirshaikhain.com/bn/ayah/107-4.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"শাইখুল ইসলাম ইবনে তাইমিয়া\"}, {\"@type\": \"Person\", \"name\": \"ইমাম ইবনুল কাইয়্যিম\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"তাফসীরুশ শাইখাইন\", \"url\": \"https://tafsirshaikhain.com/bn/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"প্রথম পাতা\", \"item\": \"https://tafsirshaikhain.com/bn/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"সূরা Al-Maa'un\", \"item\": \"https://tafsirshaikhain.com/bn/surah/107.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"আয়াত 4\", \"item\": \"https://tafsirshaikhain.com/bn/ayah/107-4.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/107.html\">সূরা Al-Maa&#x27;un</a> › আয়াত 4</nav><h1>তাফসীর সূরা Al-Maa&#x27;un 107:4</h1><p class=\"vt ar\" lang=\"ar\">﴿فَوَيْلٌ لِّلْمُصَلِّينَ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">কাজেই দুর্ভোগ সে সালাত আদায়কারীদের,</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">وأيضا فإن الله تعالى يقول: {فويل للمصلين} [الماعون: 4] {الذين هم عن صلاتهم ساهون} [الماعون: 5] فتوعد بالويل لمن يسهو عن الصلاة حتى يخرج وقتها وإن صلاها بعد ذلك<cite>«الفتاوى الكبرى لابن تيمية» 2/34</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فإذا كان هؤلاء المصلون الويل لهم، فكيف بمن لا يصلي؟<cite>«الفتاوى الكبرى لابن تيمية» 3/479</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s107a4\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><span></span><a href=\"/bn/ayah/107-5.html\">পরের আয়াত (107:5)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/107-4.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/107-4.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/107-4.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/107-4.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/107-4.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/107-4.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <b lang=\"bn\">বাংলা</b> · <a href=\"/ms/ayah/107-4.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/107-4.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/107-4.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/107-4.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/107-4.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/107-4.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/107-4.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/107-4.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a></nav>\n<footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n<script>try{localStorage.setItem(\"lang\",\"bn\")}catch(e){}document.addEventListener(\"click\",function(e){var a=