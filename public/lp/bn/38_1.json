 property=\"og:title\" content=\"তাফসীর Saad 38:54 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে\">\n<meta property=\"og:description\" content=\"নিশ্চয় এটা আমাদের দেয়া রিযিক যা নিঃশেষ হওয়ার নয়।\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"প্রথম পাতা\", \"item\": \"https://tafsirshaikhain.com/bn/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"সূরা Saad\", \"item\": \"https://tafsirshaikhain.com/bn/surah/38.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"আয়াত 54\", \"item\": \"https://tafsirshaikhain.com/bn/ayah/38-54.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/38.html\">সূরা Saad</a> › আয়াত 54</nav><h1>তাফসীর সূরা Saad 38:54</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّ هَٰذَا لَرِزْقُنَا مَا لَهُ مِن نَّفَادٍ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">নিশ্চয় এটা আমাদের দেয়া রিযিক যা নিঃশেষ হওয়ার নয়।</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>ইমাম ইবনুল কাইয়্যিম</h2><blockquote class=\"ar\" lang=\"ar\">وإنما استفيد عدم انتهاء نعيم الجنة بقوله: {إن هذا لرزقنا ما له من نفاد}<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/258</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">ولهذا جاء أن أهل الجنة في مزيد دائم بلا انتهاء فإن نعيمهم متصل ممن لا نهاية لفضله ولا لعطائه، ولا لمزيده ولا لأوصافه.<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 2/256</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s38a54\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/38-45.html\">আগের আয়াত (38:45)</a><a href=\"/bn/ayah/38-75.html\">পরের আয়াত (38:75)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/38-75.html":"<!doctype html>\n<html lang=\"bn\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>তাফসীর Saad 38:75 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে</title>\n<meta name=\"description\" content=\"তিনি বললেন, &#x27;হে ইবলীস! আমি যাকে আমার দু&#x27;হাতে  সৃষ্টি করেছি, তার প্রতি সাজদাবনত হতে তোমাকে কিসে বাধা দিল? তুমি কি ঔদ্ধত্য প্রকাশ করলে, না তুমি অধিকতর উচ্চ ম\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/bn/ayah/38-75.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/38-75.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/38-75.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/38-75.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/38-75.html\">\n<l