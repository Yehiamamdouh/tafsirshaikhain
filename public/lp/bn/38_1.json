y=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/38.html\">সূরা Saad</a> › আয়াত 54</nav><h1>তাফসীর সূরা Saad 38:54</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّ هَٰذَا لَرِزْقُنَا مَا لَهُ مِن نَّفَادٍ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">নিশ্চয় এটা আমাদের দেয়া রিযিক যা নিঃশেষ হওয়ার নয়।</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>ইমাম ইবনুল কাইয়্যিম</h2><blockquote class=\"ar\" lang=\"ar\">وإنما استفيد عدم انتهاء نعيم الجنة بقوله: {إن هذا لرزقنا ما له من نفاد}<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/258</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">ولهذا جاء أن أهل الجنة في مزيد دائم بلا انتهاء فإن نعيمهم متصل ممن لا نهاية لفضله ولا لعطائه، ولا لمزيده ولا لأوصافه.<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 2/256</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s38a54\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/38-50.html\">আগের আয়াত (38:50)</a><a href=\"/bn/ayah/38-75.html\">পরের আয়াত (38:75)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/38-54.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/38-54.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/38-54.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> 