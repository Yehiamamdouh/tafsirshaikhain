istItem\", \"position\": 2, \"name\": \"সূরা Al-Ikhlaas\", \"item\": \"https://tafsirshaikhain.com/bn/surah/112.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"আয়াত 2\", \"item\": \"https://tafsirshaikhain.com/bn/ayah/112-2.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/112.html\">সূরা Al-Ikhlaas</a> › আয়াত 2</nav><h1>তাফসীর সূরা Al-Ikhlaas 112:2</h1><p class=\"vt ar\" lang=\"ar\">﴿اللَّهُ الصَّمَدُ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">‘আল্লাহ্ হচ্ছেন ‘সামাদ&#x27;  (তিনি কারো মুখাপেক্ষী নন, সকলেই তাঁর মুখাপেক্ষী);</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">فأدخل اللام في الصمد ولم يدخلها في أحد؛ لأنه ليس في الموجودات ما يسمى أحدا في الإثبات مفردا غير مضاف إلا الله تعالى<cite>«مجموع الفتاوى» 17/235</cite></blockquote><h3>অন্যদের থেকে যা তিনি উদ্ধৃত করেছেন</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">حديث مرفوع (من رواية أبي بن كعب)</span> <span class=\"st\">استشهد به</span> «الصمد الذي لم يلد ولم يولد؛ لأنه ليس شيء يولد إلا سيموت وليس شيء يموت إلا سيورث»<cite>«مجموع الفتاوى» 17/216</cite></blockquote></section><a class=\"btn pri open\" href