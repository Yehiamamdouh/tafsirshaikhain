r\" href=\"https://tafsirshaikhain.com/ayah/70-34.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/70-34.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/70-34.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/70-34.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/70-34.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/70-34.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/70-34.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/70-34.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/70-34.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/70-34.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/70-34.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/70-34.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/70-34.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/70-34.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/70-34.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/70-34.html\">\n<meta property=\"og:title\" content=\"তাফসীর Al-Ma&#x27;aarij 70:34 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে\">\n<meta property=\"og:description\" content=\"আর যারা তাদের সালাতের হিফাযত করে ---\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"প্রথম পাতা\", \"item\": \"https://tafsirshaikhain.com/bn/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"সূরা Al-Ma'aarij\", \"item\": \"https://tafsirshaikhain.com/bn/surah/70.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"আয়াত 34\", \"item\": \"https://tafsirshaikhain.com/bn/ayah/70-34.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/70.html\">সূরা Al-Ma&#x27;aarij</a> › আয়াত 34</nav><h1>তাফসীর সূরা Al-Ma&#x27;aarij 70:34</h1><p class=\"vt ar\" lang=\"ar\">﴿وَالَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">আর যারা তাদের সালাতের হিফাযত করে ---</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">وهذه الآيات تقتضي ذم من ترك شيئا من واجبات الصلاة وإن كان في الظاهر مصليا مثل أن يترك الوقت الواجب أو يترك تكميل الشرائط والأركان من الأعمال الظاهرة والباطنة وبذلك فسرها السلف.<cite>«مجموع الفتاوى» 22/572</cite></blockquote><h3>অন্যদের থেকে যা তিনি উদ্ধৃত করেছেন</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">قتادة</span> <span class=\"st\">أقرّه</span> «على وضوئها ومواقيتها وركوعها»<cite>«مجموع الفتاوى» 22/572</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">عبد الله</span> <span class=\"st\">أقرّه</span> «ذلك على مواقيتها»<cite>«مجموع الفتاوى» 22/572</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن جريج</span> <span class=\"st\">ردّه</span> «المكتوبة والتي في سأل سائل: التطوع.»<cite>«مجموع الفتاوى» 22/572</cite></blockquote></section><section><h2>ইমাম ইবনুল কাইয়্যিম</h2><blockquote class=\"ar\" lang=\"ar\">وفسر الدوام بسكون الأطراف والطمأنينة.<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 2/365</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">والمداومة في قوله تعالى: {والذين هم على صلاتهم يحافظون} [المعارج: 34]<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 2/365</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s70a34\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/70-23.html\">আগের আয়াত (70:23)</a><a href=\"/bn/ayah/70-40.html\">পরের আয়াত (70:40)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/70-40.html":"<!doctype html>\n<html lang=\"bn\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>তাফসীর Al-Ma&#x27;aarij 70:40 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে</title>\n<meta name=\"description\" content=\"অতএব, আমি শপথ করছি উদয়াচলসমূহ এবং অস্তাচলসমূহের রবের – অবশ্যই আমরা সক্ষম\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/bn/ayah/70-40.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/70-40.html\">\n<link rel=\"alte