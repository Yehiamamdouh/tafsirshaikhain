\": 1, \"name\": \"প্রথম পাতা\", \"item\": \"https://tafsirshaikhain.com/bn/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"সূরা Al-Kaafiroon\", \"item\": \"https://tafsirshaikhain.com/bn/surah/109.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"আয়াত 2\", \"item\": \"https://tafsirshaikhain.com/bn/ayah/109-2.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/109.html\">সূরা Al-Kaafiroon</a> › আয়াত 2</nav><h1>তাফসীর সূরা Al-Kaafiroon 109:2</h1><p class=\"vt ar\" lang=\"ar\">﴿لَا أَعْبُدُ مَا تَعْبُدُونَ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">‘আমি তার ‘ইবাদাত করি না যার ‘ইবাদাত তোমরা কর</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">وسورة: {قل يا أيها الكافرون} [الكافرون: 1] فيها التوحيد القصدي العملي، كما قال تعالى {قل يا أيها الكافرون - لا أعبد ما تعبدون} [الكافرون: 1 - 2] وبهذا يتميز من يعبد الله ممن يعبد غيره وإن كان كلاهما يقر بأن الله رب كل شيء<cite>«اقتضاء الصراط المستقيم لمخالفة أصحاب الجحيم» 2/394</cite></blockquote></section><section><h2>ইমাম ইবনুল কাইয়্যিম</h2><blockquote class=\"ar\" lang=\"ar\">وهذه براءة منهم ومن معبودهم وسماها براءة من الشرك.<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/186</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s109a2\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/109-1.html\">আগের আয়াত (109:1)</a><a href=\"/bn/ayah/109-3.html\">পরের আয়াত (109:3)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/109-2.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/109-2.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/109-2.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/109-2.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/109-2.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/109-2.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <b lang=\"bn\">বাংলা</b> · <a href=\"/ms/ayah/109-2.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/109-2.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/109-2.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/109-2.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/109-2.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/109-2.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/109-2.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href