aLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/109.html\">সূরা Al-Kaafiroon</a> › আয়াত 5</nav><h1>তাফসীর সূরা Al-Kaafiroon 109:5</h1><p class=\"vt ar\" lang=\"ar\">﴿وَلَا أَنتُمْ عَابِدُونَ مَا أَعْبُدُ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">এবং তোমরাও তাঁর ‘ইবাদাতকারী হবে না যাঁর ‘ইবাদাত আমি করি,</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">و &quot; ما &quot; فيها عموم وإجمال يصلح لما لا يعلم ولصفات من يعلم كقوله تعالى: {لا أعبد ما تعبدون} {ولا أنتم عابدون ما أعبد} وقوله {فانكحوا ما طاب لكم من النساء} .<cite>«مجموع الفتاوى» 16/228</cite></blockquote></section><section><h2>ইমাম ইবনুল কাইয়্যিম</h2><blockquote class=\"ar\" lang=\"ar\">قيل: هي في هذا كله على أصلها من الإبهام والوقوع على الجنس العام لما يراد بما ما يراد بمن من التعيين لما يعقل والاختصاص دون الشيوع<cite>«بدائع الفوائد» 1/132</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s109a5\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/109-3.html\">আগের আয়াত (109:3)</a><a href=\"/bn/ayah/109-6.html\">পরের আয়াত (109:6)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/109-5.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/109-5.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/109-5.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/109-5.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/109-5.html\" hreflang=\"tr\" lang=\"tr\" data