 \"name\": \"শাইখুল ইসলাম ইবনে তাইমিয়া\"}, {\"@type\": \"Person\", \"name\": \"ইমাম ইবনুল কাইয়্যিম\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"তাফসীরুশ শাইখাইন\", \"url\": \"https://tafsirshaikhain.com/bn/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"প্রথম পাতা\", \"item\": \"https://tafsirshaikhain.com/bn/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"সূরা Al-Kaafiroon\", \"item\": \"https://tafsirshaikhain.com/bn/surah/109.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"আয়াত 3\", \"item\": \"https://tafsirshaikhain.com/bn/ayah/109-3.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/109.html\">সূরা Al-Kaafiroon</a> › আয়াত 3</nav><h1>তাফসীর সূরা Al-Kaafiroon 109:3</h1><p class=\"vt ar\" lang=\"ar\">﴿وَلَا أَنتُمْ عَابِدُونَ مَا أَعْبُدُ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">এবং তোমরাও তাঁর ‘ইবাদাতকারী নও যাঁর ‘ইবাদাত আমি করি ,</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">و &quot; ما &quot; فيها عموم وإجمال يصلح لما لا يعلم ولصفات من يعلم كقوله تعالى: {لا أعبد ما تعبدون} {ولا أنتم عابدون ما أعبد} وقوله {فانكحوا ما طاب لكم من النساء} .<cite>«مجموع الفتاوى» 16/228</cite></blockquote></section><section><h2>ইমাম ইবনুল কাইয়্যিম</h2><blockquote class=\"ar\" lang=\"ar\">قيل: هي في هذا كله على أصلها من الإبهام والوقوع على الجنس العام لما يراد بما ما يراد بمن من التعيين لما يعقل والاختصاص دون الشيوع<cite>«بدائع الفوائد» 1/132</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s109a3\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/109-2.html\">আগের আয়াত (109:2)</a><a href=\"/bn/ayah/109-5.html\">পরের আয়াত (109:5)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/109-3.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/109-3.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/109-3.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/109-3.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/109-3.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/109-3.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <b lang=\"bn\">বাংলা</b> · <a href=\"/ms/ayah/109-3.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/109-3.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/109-3.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"r