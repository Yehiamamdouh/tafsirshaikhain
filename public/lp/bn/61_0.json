ml\">\n<meta property=\"og:title\" content=\"তাফসীর As-Saff 61:13 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে\">\n<meta property=\"og:description\" content=\"এবং (তিনি দান করবেন) আরও একটি অনুগ্রহ, যা তোমরা পছন্দ কর। আল্লাহর পক্ষ থেকে সাহায্য ও আসন্ন বিজয়; আর আপনি মুমিনদেরকে সুসংবাদ দিন ।\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"প্রথম পাতা\", \"item\": \"https://tafsirshaikhain.com/bn/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"সূরা As-Saff\", \"item\": \"https://tafsirshaikhain.com/bn/surah/61.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"আয়াত 13\", \"item\": \"https://tafsirshaikhain.com/bn/ayah/61-13.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/61.html\">সূরা As-Saff</a> › আয়াত 13</nav><h1>তাফসীর সূরা As-Saff 61:13</h1><p class=\"vt ar\" lang=\"ar\">﴿وَأُخْرَىٰ تُحِبُّونَهَا نَصْرٌ مِّنَ اللَّهِ وَفَتْحٌ قَرِيبٌ وَبَشِّرِ الْمُؤْمِنِينَ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">এবং (তিনি দান করবেন) আরও একটি অনুগ্রহ, যা তোমরা পছন্দ কর। আল্লাহর পক্ষ থেকে সাহায্য ও আসন্ন বিজয়; আর আপনি মুমিনদেরকে সুসংবাদ দিন ।</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">وفي الدنيا النصر والفتح وهما أيضا دفع المضرة وحصول المنفعة<cite>«مجموع الفتاوى» 20/194</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s61a13\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/61-12.html\">আগের আয়াত (61:12)</a><a href=\"/bn/ayah/61-14.html\">পরের আয়াত (61:14)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/61-14.html":"<!doctype html>\n<html lang=\"bn\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>তাফসীর As-Saff 61:14 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে</title>\n<meta name=\"description\" content=\"হে ঈমানদারগণ! তোমরা আল্লাহর সাহায্যকারী হও, যেমন মারইয়াম-পুত্র ‘ঈসা হাওয়ারীগণকে বলেছিলেন, ‘আল্লাহর পথে কারা আমার সাহায্যকারী হবে?’ হাওয়ারীগণ বলেছিলেন, ‘আ\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/bn/ayah/61-14.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/61-14.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/61-14.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/61-14.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/61-14.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirsh