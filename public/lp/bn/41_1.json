ize:12px;color:var(--muted,#5b6676);overflow-wrap:anywhere}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/41.html\">সূরা Fussilat</a> › আয়াত 50</nav><h1>তাফসীর সূরা Fussilat 41:50</h1><p class=\"vt ar\" lang=\"ar\">﴿وَلَئِنْ أَذَقْنَاهُ رَحْمَةً مِّنَّا مِن بَعْدِ ضَرَّاءَ مَسَّتْهُ لَيَقُولَنَّ هَٰذَا لِي وَمَا أَظُنُّ السَّاعَةَ قَائِمَةً وَلَئِن رُّجِعْتُ إِلَىٰ رَبِّي إِنَّ لِي عِندَهُ لَلْحُسْنَىٰ فَلَنُنَبِّئَنَّ الَّذِينَ كَفَرُوا بِمَا عَمِلُوا وَلَنُذِيقَنَّهُم مِّنْ عَذَابٍ غَلِيظٍ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">আর যদি দুঃখ-দৈন্য স্পর্শ করার পর আমরা তাকে আমার পক্ষ থেকে অনুগ্রহের আস্বাদন দেই, তখন সে অবশ্যই বলে থাকে, &#x27;এ আমার প্রাপ্য এবং আমি মনে করি না যে, কিয়ামত সংঘটিত হবে। আর যদি আমাকে আমার রবের কাছে ফিরিয়ে নেয়াও হয়, তবুও তাঁর কাছে আমার জন্য কল্যাণই থাকবে।&#x27; অতএব, আমরা অবশ্যই কাফিরদেরকে তাদের আমল সম্বন্ধে অবহিত করব এবং তাদেরকে অবশ্যই আস্বাদন করাব কঠোর শাস্তি।</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>ইমাম ইবনুল কাইয়্যিম</h2><blockquote class=\"ar\" lang=\"ar\">واعظم الناس غرورا بربه من إذا مسه الله برحمة منه وفضل قال هذا لي أي أنا أهله وجدير به ومستحق له ثم قال {وما أظن الساعة قائمة} فظن أنه أهل لما أولاه من النعم مع كفره بالله<cite>«الروح في الكلام على أرواح الأموات والأحياء بالدلائل من الكتاب والسنة» 1/245</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">ثم زاد في غروره فقال {ولئن رجعت إلى ربي إن لي عنده للحسنى} يعني الجنة والكرامة<cite>«الروح في الكلام على أرواح الأموات والأحياء بالدلائل من الكتاب والسنة» 1/245</cite></blockquote></section><div class=\"muy\"><div class=\"muy-head\"><b>আল-মুখতাসার ফী তাফসীরিল কুরআনিল কারীম</b><small>আয়াতের সামগ্রিক অর্থ — দুই শাইখের বক্তব্য নয়</small></div><p class=\"muy-text\">৫০. আর আমি যদি তাকে বিপদগ্রস্ত ও রোগাক্রান্ত করার পর সুস্বাস্থ্য, ধনাঢ্যতা ও নিরাপত্তা প্রদান করি তাহলে সে অচিরেই বলবে, এটি আমারই। কেননা, আমি এর অধিকারী। আর আমি মনে করি না যে, কিয়ামত অনুষ্ঠিত হবে। একান্ত যদি ধরে নেয়া যায় যে, কিয়ামত অনুষ্ঠিত হবে তাহলে আল্লাহর নিকট আমার জন্য ধনাঢ্যতা ও সম্পদ থাকবে। যেভাবে আমি অধিকারী হিসাবে দুনিয়াতে তিনি আমাকে নি‘আমত প্রদান করেছেন ঠিক পরকালেও তা প্রদান করবেন। তাই আমি আল্লাহকে অস্বীকারকারীদেরকে তাদের কুফরী ও পাপাচারের সংবাদ অবশ্যই প্রদান করবো এবং তাদেরকে চরম পর্যায়ের কঠিন শাস্তি আস্বাদন করাবো।</p><a class=\"muy-credit\" href=\"https://quranenc.com/en/browse/bengali_mokhtasar\" target=\"_blank\" rel=\"noopener\" dir=\"ltr\">Bengali Translation of Al-Mukhtasar in Interpreting the Noble Quran — 2026-11-04 · QuranEnc.com</a></div><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s41a50\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/41-49.html\">আগের আয়াত (41:49)</a><a href=\"/bn/ayah/41-51.html\">পরের আয়াত (41:51)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/41-50.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/41-50.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/41-50.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/41-50.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/41-50.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/41