: \"শাইখুল ইসলাম ইবনে তাইমিয়া\"}, {\"@type\": \"Person\", \"name\": \"ইমাম ইবনুল কাইয়্যিম\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"তাফসীরুশ শাইখাইন\", \"url\": \"https://tafsirshaikhain.com/bn/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"প্রথম পাতা\", \"item\": \"https://tafsirshaikhain.com/bn/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"সূরা Fussilat\", \"item\": \"https://tafsirshaikhain.com/bn/surah/41.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"আয়াত 53\", \"item\": \"https://tafsirshaikhain.com/bn/ayah/41-53.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.muy{display:grid;gap:6px;background:var(--sheet,#fff);border:1px dashed var(--line,#d9dee6);border-inline-start:4px solid var(--muted,#5b6676);border-radius:10px;padding:12px 14px;margin:4px 0}.muy-head{display:flex;flex-wrap:wrap;gap:4px 10px;align-items:baseline}.muy-head b{font-family:var(--f-display,sans-serif);font-weight:600;font-size:15px}.muy-head small{font-size:12.5px;color:var(--muted,#5b6676)}.muy-text{margin:0;font-family:var(--f-read,serif);font-size:17px;line-height:1.95;overflow-wrap:anywhere}.muy-fn{margin:0;font-size:14px;line-height:1.7;color:var(--muted,#5b6676);white-space:pre-line}.muy-credit{font-size:12px;color:var(--muted,#5b6676);overflow-wrap:anywhere}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/41.html\">সূরা Fussilat</a> › আয়াত 53</nav><h1>তাফসীর সূরা Fussilat 41:53</h1><p class=\"vt ar\" lang=\"ar\">﴿سَنُرِيهِمْ آيَاتِنَا فِي الْآفَاقِ وَفِي أَنفُسِهِمْ حَتَّىٰ يَتَبَيَّنَ لَهُمْ أَنَّهُ الْحَقُّ أَوَلَمْ يَكْفِ بِرَبِّكَ أَنَّهُ عَلَىٰ كُلِّ شَيْءٍ شَهِيدٌ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">অচিরেই আমরা তাদেরকে আমাদের নিদর্শনাবলী দেখাব, বিশ্ব জগতের প্রান্তসমূহে এবং তাদের নিজেদের মধ্যে; যাতে তাদের কাছে সুস্পষ্ট হয়ে উঠে যে, অবশ্যই এটা (কুরআন) সত্য। এটা কি আপনার রবের সম্পর্কে যথেষ্ট নয় যে, তিনি সব কিছুর উপর সাক্ষী ?</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">فأخبر: أنه سيريهم الآيات المرئية المشهودة حتى يتبين لهم أن القرآن حق. ثم قال: {أولم يكف بربك أنه على كل شيء شهيد} أي بإخبار الله ربك في القرآن وشهادته بذلك.<cite>«مجموع الفتاوى» 4/9</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">والصواب الذي عليه المفسرون وعليه تدل الآية أن الضمير عائد إلى القرآن<cite>«درء تعارض العقل والنقل» 3/134</cite></blockquote></section><section><h2>ইমাম ইবনুল কাইয়্যিম</h2><blockquote class=\"ar\" lang=\"ar\">والمقصود: أن الله سبحانه يشهد بما جعل آياته المخلوقة دالة عليه، فإن دلالتها إنما هي بخلقه وجعله، ويشهد بآياته القولية الكلامية المطابقة لما شهدت به آياته الخلقية، فتتطابق شهادة القول وشهادة الفعل، كما قال تعالى: {سنريهم آياتنا في الآفاق وفي أنفسهم حتى يتبين لهم أنه الحق} [فصلت: 53] ، أي أن القرآن حق، فأخبر أنه يدل بآياته الأفقية والنفسية على صدق آياته القولية الكلامية<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 3/422</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فقال تعالى {سنريهم آياتنا في الآفاق وفي أنفسهم حتى يتبين لهم أنه الحق} [فصلت: 53] أي القرآن، فإنه هو المتقدم في قوله: {قل أرأيتم إن كان من عند الله ثم كفرتم به}<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 3/432</cite></blockquote></section><div class=\"muy\"><div class=\"muy-head\"><b>আল-মুখতাসার ফী তাফসীরিল কুরআনিল কারীম</b><small>আয়াতের সামগ্রিক অর্থ — দুই শাইখের বক্তব্য নয়</small></div><p class=\"muy-text\">৫৩. অচিরেই আমি কুরাইশের কাফিরদেরকে মুসলিমদের বিজিত এলাকার দিগন্ত দেখাবো এবং মক্কা বিজয়ের মাধ্যমে তাদের ব্যক্তি সত্তায় তা ফুটিয়ে তুলবো। পরিশেষে তাদের কাছে এ কথা সুস্পষ্ট হবে যে, এই কুরআন এমন সত্য গ্রন্থ যাতে কোনরূপ সন্দেহের অবকাশ নেই। এ সব মুশরিকদের জন্য কি যথেষ্ট নয় যে, কুরআনের সত্যতা স্বয়ং আল্লাহর পক্ষ থেকে এই বলে সাক্ষ্য প্রদান দ্বারা সাব্যস্ত যে, এটি তাঁর পক্ষ থেকে?! আল্লাহ অপেক্ষা মহা সাক্ষ্যদাতা কেই বা আছে?! তারা সত্য চাইলে তাদের রবের সাক্ষ্যকেই যথেষ্ট মনে করতো।</p><a class=\"muy-credit\" href=\"https://quranenc.com/en/browse/bengali_mokhtasar\" target=\"_blank\" rel=\"noopener\" dir=\"ltr\">Bengali Translation of Al-Mukhtasar in Interpreting the Noble Quran — 2026-11-04 · QuranEnc.com</a></div><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s41a53\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/41-51.html\">আগের আয়াত (41:51)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/41-53.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/41-53.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/41-53.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/41-53.html\" hreflang=\"id\" lang=\