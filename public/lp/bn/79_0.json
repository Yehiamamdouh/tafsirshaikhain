gleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/79.html\">সূরা An-Naazi&#x27;aat</a> › আয়াত 45</nav><h1>তাফসীর সূরা An-Naazi&#x27;aat 79:45</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّمَا أَنتَ مُنذِرُ مَن يَخْشَاهَا﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">যে এটার ভয় রাখে আপনি শুধু তার সতর্ককারী।</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">فهذا الإنذار الخاص وهو التام النافع الذي انتفع به المنذر. والإنذار هو الإعلام بالمخوف فعلم المخوف فخاف فآمن وأطاع.<cite>«مجموع الفتاوى» 16/157</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s79a45\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/79-40.html\">আগের আয়াত (79:40)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/79.html":"<!doctype html>\n<html lang=\"bn\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>তাফসীর সূরা An-Naazi&#x27;aat — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে</title>\n<meta name=\"descrip