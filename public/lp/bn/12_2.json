https://tafsirshaikhain.com/bn/surah/12.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"আয়াত 111\", \"item\": \"https://tafsirshaikhain.com/bn/ayah/12-111.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/12.html\">সূরা Yusuf</a> › আয়াত 111</nav><h1>তাফসীর সূরা Yusuf 12:111</h1><p class=\"vt ar\" lang=\"ar\">﴿لَقَدْ كَانَ فِي قَصَصِهِمْ عِبْرَةٌ لِّأُولِي الْأَلْبَابِ مَا كَانَ حَدِيثًا يُفْتَرَىٰ وَلَٰكِن تَصْدِيقَ الَّذِي بَيْنَ يَدَيْهِ وَتَفْصِيلَ كُلِّ شَيْءٍ وَهُدًى وَرَحْمَةً لِّقَوْمٍ يُؤْمِنُونَ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">তাদের বৃত্তান্তে অবশ্যই বোধশক্তি সম্পন্ন ব্যক্তিদের জন্য আছে শিক্ষা । এটা কোনো বানানো রচনা নয়। বরং এটা আগের গ্রন্থে যা আছে তার সত্যায়ন  ও সব কিছুর বিশদ বিবরণ, আর যারা ঈমান আনে এমন সম্পপ্রদায়ের জন্য হিদায়াত ও রহমত।</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">والاعتبار أن يقرن الشيء بمثله فيعلم أن حكمه مثل حكمه<cite>«مجموع الفتاوى» 13/20</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">أفاد أن من عمل مثل أعمالهم جوزي مثل جزائهم؛ ليحذر أن يعمل مثل أعمال الكفار؛ وليرغب في أن يعمل مثل أعمال المؤمنين أتباع الأنبياء<cite>«مجموع الفتاوى» 13/20</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s12a111\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/12-110.html\">আগের আয়াত (12:110)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}