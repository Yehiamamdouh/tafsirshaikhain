l\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"শাইখুল ইসলাম ইবনে তাইমিয়া\"}, {\"@type\": \"Person\", \"name\": \"ইমাম ইবনুল কাইয়্যিম\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"তাফসীরুশ শাইখাইন\", \"url\": \"https://tafsirshaikhain.com/bn/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"প্রথম পাতা\", \"item\": \"https://tafsirshaikhain.com/bn/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"সূরা Al-Anbiyaa\", \"item\": \"https://tafsirshaikhain.com/bn/surah/21.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"আয়াত 105\", \"item\": \"https://tafsirshaikhain.com/bn/ayah/21-105.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/21.html\">সূরা Al-Anbiyaa</a> › আয়াত 105</nav><h1>তাফসীর সূরা Al-Anbiyaa 21:105</h1><p class=\"vt ar\" lang=\"ar\">﴿وَلَقَدْ كَتَبْنَا فِي الزَّبُورِ مِن بَعْدِ الذِّكْرِ أَنَّ الْأَرْضَ يَرِثُهَا عِبَادِيَ الصَّالِحُونَ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">আর অবশ্যই আমরা ‘যিকর’ এর পর যাবূরে  লিখে দিয়েছি যে, যমীনের  অধিকারী হবে আমার যোগ্য বান্দাগণই।</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">قوله: {كتب في الذكر} يعني: اللوح المحفوظ كما قال: {ولقد كتبنا في الزبور من بعد الذكر} أي: من بعد اللوح المحفوظ<cite>«مجموع الفتاوى» 18/211</cite></blockquote></section><section><h2>ইমাম ইবনুল কাইয়্যিম</h2><blockquote class=\"ar\" lang=\"ar\">فالزبور هنا جميع الكتب المنزلة من السماء لا تختص بزبور داود والذكر أم الكتاب الذي عند الله<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/39</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s21a105\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/21-104.html\">আগের আয়াত (21:104)</a><a href=\"/bn/ayah/21-112.html\">পরের আয়াত (21:112)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/21-105.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/21-105.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/21-105.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/21-105.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/21-105.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/21-105.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <b lang=\"bn\">বাংলা</b> · <a href=\"/ms/ayah/21-105.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/21-105.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/21-105.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/21-105.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/21-105.html\" hreflang=\"ha