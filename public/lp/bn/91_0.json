>\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/91.html\">সূরা Ash-Shams</a> › আয়াত 7</nav><h1>তাফসীর সূরা Ash-Shams 91:7</h1><p class=\"vt ar\" lang=\"ar\">﴿وَنَفْسٍ وَمَا سَوَّاهَا﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">শপথ নফ্সের  এবং যিনি তা সুবিন্যস্ত করেছেন তাঁর  ,</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">لأن &quot; ما &quot; يراد به الصفات دون الأعيان وهو المقصود كقوله {فانكحوا ما طاب لكم من النساء} وقوله {لا أعبد ما تعبدون} وقوله {ونفس وما سواها} .<cite>«مجموع الفتاوى» 16/289</cite></blockquote></section><section><h2>ইমাম ইবনুল কাইয়্যিম</h2><blockquote class=\"ar\" lang=\"ar\">فعبر عن خلق النفس بالتسوية للدلالة على الاعتدال والتمام.<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 2/361</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s91a7\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/91-5.html\">আগের আয়াত (91:5)</a><a href=\"/bn/ayah/91-8.html\">পরের আয়াত (91:8)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/91-8.html":"<!doctype html>\n<html lang=\"bn\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\