&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/62.html\">সূরা Al-Jumu&#x27;a</a> › আয়াত 3</nav><h1>তাফসীর সূরা Al-Jumu&#x27;a 62:3</h1><p class=\"vt ar\" lang=\"ar\">﴿وَآخَرِينَ مِنْهُمْ لَمَّا يَلْحَقُوا بِهِمْ وَهُوَ الْعَزِيزُ الْحَكِيمُ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">এবং তাদের মধ্য হতে অন্যান্যদের জন্যও যারা এখনো তাদের সাথে মিলিত হয়নি । আর আল্লাহ্‌ পরাক্রমশালী, প্রজ্ঞাময়।</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">فهذا يتناول كل من دخل في الإسلام بعد دخول العرب فيه إلى يوم القيامة<cite>«مجموع الفتاوى» 16/190</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فإن قوله {وآخرين منهم} أي في الدين دون النسب<cite>«مجموع الفتاوى» 16/190</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s62a3\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/62-2.html\">আগের আয়াত (62:2)</a><a href=\"/bn/ayah/62-5.html\">পরের আয়াত (62:5)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/62-5.html":"<!doctype html>\n<html lang=\"bn\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>তাফসীর Al-Jumu&#x27;a 62:5 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে</title>\n<meta name=\"description\" content=\"যাদেরকে তাওরাতের দায়িত্বভার অর্পণ করা হয়েছিল, কিন্তু তারা তা বহন করেনি, তারা গাধার মত! যে বহু পুস্তক বহন করে । কত নিকৃষ্ট সে সম্প্রদায়ের দৃষ্টান্ত যারা \">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/bn/ayah/62-5.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/62-5.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/62-5.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/62-5.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/62-5.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/62-5.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/62-5.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/62-5.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/62-5.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/62-5.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/62-5.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/62-5.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/62-5.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/62-5.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/62-5.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/62-5.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/62-5.html\">\n<meta property=\"og:title\" content=\"তাফসীর Al-Jumu&#x27;a 62:5 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে\">\n<meta property=\"og:description\" content=\"যাদেরকে তাওরাতের দায়িত্বভার অর্পণ করা হয়েছিল, কিন্তু তারা তা বহন করেনি, তারা গাধার মত! যে বহু পুস্তক বহন করে । কত নিকৃষ্ট সে সম্প্রদায়ের দৃষ্টান্ত যারা \">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"প্রথম পাতা\", \"item\": \"https://tafsirshaikhain.com/bn/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"সূরা Al-Jumu'a\", \"item\": \"https://tafsirshaikhain.com/bn/surah/62.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"আয়াত 5\", \"item\": \"https://tafsirshaikhain.com/bn/ayah/62-5.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/62.html\">সূরা Al-Jumu&#x27;a</a> › আয়াত 5</nav><h1>তাফসীর সূরা Al-Jumu&#x27;a 62:5</h1><p class=\"vt ar\" lang=\"ar\">﴿مَثَلُ الَّذِينَ حُمِّلُوا التَّوْرَاةَ ثُمَّ لَمْ يَحْمِلُوهَا كَمَثَلِ الْحِمَارِ يَحْمِلُ أَسْفَارًا بِئْسَ مَثَلُ الْقَوْمِ الَّذِينَ كَذَّبُوا بِآيَاتِ اللَّهِ وَاللَّهُ لَا يَهْدِي الْقَوْمَ الظَّالِمِينَ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">যাদেরকে তাওরাতের দায়িত্বভার অর্পণ করা হয়েছিল, কিন্তু তারা তা বহন করেনি, তারা গাধার মত! যে বহু পুস্তক বহন করে । কত নিকৃষ্ট সে সম্প্রদায়ের দৃষ্টান্ত যারা আল্লাহর আয়াতসমূহে মিথ্যারোপ করে! আর আল্লাহ যালিম সম্প্রদায়কে হেদায়াত করেন না।</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>ইমাম ইবনুল কাইয়্যিম</h2><blockquote class=\"ar\" lang=\"ar\">فقاس من حمله سبحانه كتابه ليؤمن به ويتدبره ويعمل به ويدعو إليه ثم خالف ذلك ولم يحمله إلا على ظهر قلب<cite>«إعلام الموقعين عن رب العالمين» 1/127</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s62a5\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/62-3.html\">আগের আয়াত (62:3)</a><a href=\"/bn/ayah/62-9.html\">পরের আয়াত (62:9)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/62-9.html":"<!doctype html>\n<html lang=\"bn\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>তাফসীর Al-Jumu&#x27;a 62:9 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে</title>\n<meta name=\"description\" content=\"হে ঈমানদারগণ! জুমু’আর দিনে  যখন সালাতের জন্য ডাকা হয়  তখন তোমরা আল্লাহর স্বরণে ধাবিত হও  এবং কেনা-বেচা ত্যাগ কর, এটাই তোমাদের জন্য সর্বোত্তম, যদি তোমরা জান\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/bn/ayah/62-9.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/62-9.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=