gnals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/42.html\">সূরা Ash-Shura</a> › আয়াত 51</nav><h1>তাফসীর সূরা Ash-Shura 42:51</h1><p class=\"vt ar\" lang=\"ar\">﴿وَمَا كَانَ لِبَشَرٍ أَن يُكَلِّمَهُ اللَّهُ إِلَّا وَحْيًا أَوْ مِن وَرَاءِ حِجَابٍ أَوْ يُرْسِلَ رَسُولًا فَيُوحِيَ بِإِذْنِهِ مَا يَشَاءُ إِنَّهُ عَلِيٌّ حَكِيمٌ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">আর কোনো মানুষেরই এমন মর্যাদা নেই যে, আল্লাহ্ তার সাথে কথা বলবেন ওহীর মাধ্যম ছাড়া অথবা পর্দার আড়াল ছাড়া অথবা এমন দূত প্রেরণ ছাড়া, যে দূত তাঁর অনুমতিক্রমে তিনি যা চান তা ওহী করেন, তিনি সর্বোচ্চ, হিকমতওয়ালা।</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">فبين سبحانه أن التكليم تارة يكون وحيا<cite>«مجموع الفتاوى» 12/300</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وتارة من وراء حجاب كما كلم موسى وتارة يرسل رسولا فيوحي الرسول بإذن الله ما يشاء<cite>«مجموع الفتاوى» 12/300</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فدل على أن التكليم من وراء حجاب - كما كلم موسى - أمر غير الإيحاء.<cite>«مجموع الفتاوى» 12/129</cite></blockquote></section><section><h2>ইমাম ইবনুল কাইয়্যিম</h2><blockquote class=\"ar\" lang=\"ar\">فجعل الوحي في هذه الآية قسما من أقسام التكليم، وجعله في آية النساء قسيما للتكليم، وذلك باعتبارين، فإنه قسيم التكليم الخاص الذي هو بلا واسطة، وقسم من التكليم العام الذي هو إيصال المعنى بطرق متعددة.<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/62</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s42a51\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/42-50.html\">আগের আয়াত (42:50)</a><a href=\"/bn/ayah/42-52.html\">পরের আয়াত (42:52)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/42-51.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/42-51.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/42-51.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/42-51.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/42-51.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/42-51.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <b lang=\"bn\">বাংলা</b> · <a href=\"/ms/ayah/42-51.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/42-51.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/42-51.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/42-51.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/42-51.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/42-51.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/42-51.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/42-51.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a></nav>\n<footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n<script>try{localStorage.setItem(\"lang\",\"bn\")}catch(e){}document.addEventListener(\"click\",function(e){var a=e.target.closest&&e.target.closest(\"[data-l]\");if(a)try{localStorage.setItem(\"lang\",a.dataset.l)}catch(x){}})</script>\n</body>\n</html>\n","ayah/42-52.html":"<!doctype html>\n<html lang=\"bn\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"wid