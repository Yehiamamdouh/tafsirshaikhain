.com/bn/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"সূরা Ash-Shura\", \"item\": \"https://tafsirshaikhain.com/bn/surah/42.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"আয়াত 52\", \"item\": \"https://tafsirshaikhain.com/bn/ayah/42-52.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/42.html\">সূরা Ash-Shura</a> › আয়াত 52</nav><h1>তাফসীর সূরা Ash-Shura 42:52</h1><p class=\"vt ar\" lang=\"ar\">﴿وَكَذَٰلِكَ أَوْحَيْنَا إِلَيْكَ رُوحًا مِّنْ أَمْرِنَا مَا كُنتَ تَدْرِي مَا الْكِتَابُ وَلَا الْإِيمَانُ وَلَٰكِن جَعَلْنَاهُ نُورًا نَّهْدِي بِهِ مَن نَّشَاءُ مِنْ عِبَادِنَا وَإِنَّكَ لَتَهْدِي إِلَىٰ صِرَاطٍ مُّسْتَقِيمٍ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">আর এভাবে  আমরা আপনার প্রতি আমাদের নির্দেশ থেকে রূহকে ওহী করেছি; আপনি তো জানতেন না কিতাব কী এবং ঈমান কী! কিন্তু আমরা এটাকে করেছি নূর, যা দ্বারা আমরা আমাদের বান্দাদের মধ্যে যাকে ইচ্ছে হেদায়াত দান করি; আর আপনি তো অবশ্যই সরল পথের দিকে দিকনির্দেশনা করেন---</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">وهو في اللفظ يعود إلى الروح الذي أوحاه وهو الوحي الذي جاء بالإيمان والقرآن.<cite>«مجموع الفتاوى» 15/73</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فقد تبين أن كلاهما من الله نور وهدى ومنه هذا يعقل بالقلب؛ لما قد يشاهد من دلائل الإيمان مثل دلائل الربوبية والنبوة وهذا يسمع بالآذان<cite>«مجموع الفتاوى» 15/73</cite></blockquote><h3>অন্যদের থেকে যা তিনি উদ্ধৃত করেছেন</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن عباس والسدي (في مرجع الضمير: جعلناه نورا)</span> <span class=\"st\">أقرّه</span> «يعود إلى الإيمان ذكر ذلك عن ابن عباس. وقيل: إلى القرآن. وهو قول السدي»<cite>«مجموع الفتاوى» 15/73</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن عباس</span> <span class=\"st\">رجّح غيره</span> «وقيل الضمير في قوله: {جعلناه نورا نهدي به من نشاء من عبادنا} يعود إلى الإيمان ذكر ذلك عن ابن عباس.»<cite>«مجموع الفتاوى» 15/73</cite></blockquote></section><section><h2>ইমাম ইবনুল কাইয়্যিম</h2><blockquote class=\"ar\" lang=\"ar\">فأخبر أنه روح تحصل به الحياة، وأنه نور تحصل به الإضاءة<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 3/243</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">ونورا لما يحصل به من الهدى والرشاد.<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 3/155</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s42a52\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/42-51.html\">আগের আয়াত (42:51)</a><a href=\"/bn/ayah/42-53.html\">পরের আয়াত (42:53)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/42-52.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/aya