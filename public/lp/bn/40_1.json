ts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/40.html\">সূরা Al-Ghaafir</a> › আয়াত 57</nav><h1>তাফসীর সূরা Al-Ghaafir 40:57</h1><p class=\"vt ar\" lang=\"ar\">﴿لَخَلْقُ السَّمَاوَاتِ وَالْأَرْضِ أَكْبَرُ مِنْ خَلْقِ النَّاسِ وَلَٰكِنَّ أَكْثَرَ النَّاسِ لَا يَعْلَمُونَ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">মানুষ সৃষ্টি অপেক্ষা আসমানসমূহ ও যমীন সৃষ্টি অবশ্যই বড় বিষয়, কিন্তু অধিকাংশ মানুষ জানে না।</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">فإنه من المعلوم ببداهة العقول أن خلق السماوات والأرض أعظم من خلق أمثال بني آدم، والقدرة عليه أبلغ، وأن هذا الأيسر أولى بالإمكان والقدرة من ذلك.<cite>«درء تعارض العقل والنقل» 1/32</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s40a57\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/40-54.html\">আগের আয়াত (40:54)</a><a href=\"/bn/ayah/40-60.html\">পরের আয়াত (40:60)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/40-60.html":"<!doctype html>\n<html lang=\"bn\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>তাফসীর Al-Ghaafir 40:60 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে</title>\n<meta name=\"description\" content=\"আর তোমাদের রব বলেছেন, &#x27;তোমরা আমাকে ডাক , আমি তোমাদের ডাকে সাড়া দেব। নিশ্চয় যারা অহংকারবশে আমার &#x27;ইবাদাত থেকে বিমুখ থাকে, তারা অচিরেই জাহান্নামে প্রবেশ করব\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/bn/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/40-60.html\">\n<meta property=\"og:title\" content=\"তাফসীর Al-Ghaafir 40:60 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে\">\n<meta property=\"og:description\" content=\"আর তোমাদের রব বলেছেন, &#x27;তোমরা আমাকে ডাক , আমি তোমাদের ডাকে সাড়া দেব। নিশ্চয় যারা অহংকারবশে আমার &#x27;ইবাদাত থেকে বিমুখ থাকে, তারা অচিরেই জাহান্নামে প্রবেশ করব\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"প্রথম পাতা\", \"item\": \"https://tafsirshaikhain.com/bn/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"সূরা Al-Ghaafir\", \"item\": \"https://tafsirshaikhain.com/bn/surah/40.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"আয়াত 60\", \"item\": \"https://tafsirshaikhain.com/bn/ayah/40-60.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/40.html\">সূরা Al-Ghaafir</a> › আয়াত 60</nav><h1>তাফসীর সূরা Al-Ghaafir 40:60</h1><p class=\"vt ar\" lang=\"ar\">﴿وَقَالَ رَبُّكُمُ ادْعُونِي أَسْتَجِبْ لَكُمْ إِنَّ الَّذِينَ يَسْتَكْبِرُونَ عَنْ عِبَادَتِي سَيَدْخُلُونَ جَهَنَّمَ دَاخِرِينَ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">আর তোমাদের রব বলেছেন, &#x27;তোমরা আমাকে ডাক , আমি তোমাদের ডাকে সাড়া দেব। নিশ্চয় যারা অহংকারবশে আমার &#x27;ইবাদাত থেকে বিমুখ থাকে, তারা অচিরেই জাহান্নামে প্রবেশ করবে লাঞ্ছিত হয়ে ।&#x27;</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">فإن الله علق الإجابة به تعليق المسبب بالسبب<cite>«مجموع الفتاوى» 8/193</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وهو في دعاء العبادة أظهر؛ ولهذا أعقبه: {إن الذين يستكبرون عن عبادتي} الآية.<cite>«مجموع الفتاوى» 15/12</cite></blockquote><h3>অন্যদের থেকে যা তিনি উদ্ধৃত করেছেন</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">النبي صلى الله عليه وسلم</span> <span class=\"st\">استشهد به</span> «{أنه قال ما من مسلم يدعو الله بدعوة ليس فيها إثم ولا قطيعة رحم إلا أعطاه بها إحدى خصال ثلاث: إما أن يعجل له دعوته وإما أن يدخر له من الخير مثلها وإما أن يصرف عنه من الشر مثلها قالوا: يا رسول الله إذا نكثر قال الله أكثر}»<cite>«مجموع الفتاوى» 8/193</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">عمر بن الخطاب</span> <span class=\"st\">أقرّه</span> «وقال عمر بن الخطاب: إني لا أحمل هم الإجابة وإنما أحمل هم الدعاء فإذا ألهمت الدعاء فإن الإجابة معه»<cite>«مجموع الفتاوى» 8/193</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">النبي صلى الله عليه وسلم</span> <span class=\"st\">استشهد به</span> «{إن الدعاء هو العبادة. ثم قرأ قوله تعالى {وقال ربكم ادعوني أستجب لكم} الآية}»<cite>«مجموع الفتاوى» 15/12</cite></blockquote></section><section><h2>ইমাম ইবনুল কাইয়্যিম</h2><blockquote class=\"ar\" lang=\"ar\">فالدعاء يتضمن النوعين وهو في دعاء العبادة أظهر ولهذا عقبة بقوله: {إن الذين يستكبرون عن عبادتي سيدخلون جهنم داخرين}<cite>«بدائع الفوائد» 3/3</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s40a60\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/40-57.html\">আগের আয়াত (40:57)</a><a href=\"/bn/ayah/40-85.html\">পরের আয়াত (40:85)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/40-85.html":"<!doctype html>\n<html lang=\"bn\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>তাফসীর Al-Ghaafir 40:85 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে</title>\n<meta name=\"description\" content=\"কিন্তু তারা যখন আমার শাস্তি দেখল তখন তাদের ঈমান তাদের কোনো উপকারে আসল না । আল্লাহর এ বিধান পূর্ব থেকেই তাঁর বান্দাদের মধ্যে চলে আসছে এবং তখনই কাফিররা ক্ষতি\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/bn/ayah/40-85.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/40-85.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/40-85.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/40-85.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/40-85.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/40-85.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/40-85.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/40-85.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/40-85.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/40-85.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/40-85.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/40-85.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/40-85.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/40-85.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/40-85.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/40-85.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/40-85.html\">\n<meta property=\"og:title\" content=\"তাফসীর Al-Ghaafir 40:85 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে\">\n<meta property=\"og:description\" content=\"কিন্তু তারা যখন আমার শাস্তি দেখল তখন তাদের ঈমান তাদের কোনো উপকারে আসল না । আল্লাহর এ বিধান পূর্ব থেকেই তাঁর বান্দাদের মধ্যে চলে আসছে এবং তখনই কাফিররা ক্ষতি\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"প্রথম পাতা\", \"item\": \"https://tafsirshaikhain.com/bn/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"সূরা Al-Ghaafir\", \"item\": \"https://tafsirshaikhain.com/bn/surah/40.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"আয়াত 85\", \"item\": \"https://tafsirshaikhain.com/bn/ayah/40-85.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/40.html\">সূরা Al-Ghaafir</a> › আয়াত 85</nav><h1>তাফসীর সূরা Al-Ghaafir 40:85</h1><p class=\"vt ar\" lang=\"ar\">﴿فَلَمْ يَكُ يَنفَعُهُمْ إِيمَانُهُمْ لَمَّا رَأَوْا بَأْسَنَا سُنَّتَ اللَّهِ الَّتِي قَدْ خَلَتْ فِي عِبَادِهِ وَخَسِرَ هُنَالِكَ الْكَافِرُونَ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">কিন্তু তারা যখন আমার শাস্তি দেখল তখন তাদের ঈমান তাদের কোনো উপকারে আসল না । আল্লাহর এ বিধান পূর্ব থেকেই তাঁর বান্দাদের মধ্যে চলে আসছে এবং তখনই কাফিররা ক্ষতিগ্ৰস্ত হয়েছে।</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">فأخبر سبحانه وتعالى أن الكفار لم يك ينفعهم إيمانهم حين رأوا البأس وأخبر أن هذه سنته التي قد خلت في عباده ليبين أن هذه عادته سبحانه في المستقدمين والمستأخرين<cite>«رسالة في الرد على ابن عربي» 1/208</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s40a85\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/40-60.html\">আগের আয়াত (40:60)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}