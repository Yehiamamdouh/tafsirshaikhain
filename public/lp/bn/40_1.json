: \"https://tafsirshaikhain.com/bn/ayah/40-53.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/40.html\">সূরা Al-Ghaafir</a> › আয়াত 53</nav><h1>তাফসীর সূরা Al-Ghaafir 40:53</h1><p class=\"vt ar\" lang=\"ar\">﴿وَلَقَدْ آتَيْنَا مُوسَى الْهُدَىٰ وَأَوْرَثْنَا بَنِي إِسْرَائِيلَ الْكِتَابَ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">আর অবশ্যই আমরা মূসাকে দান করেছিলাম হেদায়াত এবং বনী ইসরাইলকে উত্তরাধিকারী করেছিলাম কিতাবের,</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>ইমাম ইবনুল কাইয়্যিম</h2><blockquote class=\"ar\" lang=\"ar\">ولما كان في سياق ذكر نعمه وآلائه ومنته عليهم قال: {وأورثنا بني إسرائيل الكتاب}<cite>«طريق الهجرتين وباب السعادتين» 1/195</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s40a53\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/40-51.html\">আগের আয়াত (40:51)</a><a href=\"/bn/ayah/40-54.html\">পরের আয়াত (40:54)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\"