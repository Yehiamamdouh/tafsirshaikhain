roperty=\"og:title\" content=\"তাফসীর An-Naas 114:1 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে\">\n<meta property=\"og:description\" content=\"বলুন, ‘আমি আশ্ৰয় প্রার্থনা করছি মানুষের রবের,\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"প্রথম পাতা\", \"item\": \"https://tafsirshaikhain.com/bn/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"সূরা An-Naas\", \"item\": \"https://tafsirshaikhain.com/bn/surah/114.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"আয়াত 1\", \"item\": \"https://tafsirshaikhain.com/bn/ayah/114-1.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/114.html\">সূরা An-Naas</a> › আয়াত 1</nav><h1>তাফসীর সূরা An-Naas 114:1</h1><p class=\"vt ar\" lang=\"ar\">﴿بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ النَّاسِ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">বলুন, ‘আমি আশ্ৰয় প্রার্থনা করছি মানুষের রবের,</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">فإن الوسواس أصل كل كفر وفسوق وعصيان فهو أصل الشر كله<cite>«مجموع الفتاوى» 17/518</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فأي ناس ليس الله ربهم؟ أم ليس ملكهم؟ أم ليس إلههم؟<cite>«مجموع الفتاوى» 6/444</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">والربوبية تستلزم الإلهية؛ فإن أحدهما إذا تضمن الآخر عند الانفراد لم يمنع أن يختص معناه عند الاقتران،<cite>«الفتاوى الكبرى لابن تيمية» 5/252</cite></blockquote></section><section><h2>ইমাম ইবনুল কাইয়্যিম</h2><blockquote class=\"ar\" lang=\"ar\">فذكر ربوبيته للناس وملكه إياهم وإلهيته لهم<cite>«بدائع الفوائد» 2/247</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وإذا كان وحده هو ربنا ومالكنا وإلهنا فلا مفزع لنا في الشدائد سواه<cite>«بدائع الفوائد» 2/248</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s114a1\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><span></span><a href=\"/bn/ayah/114-3.html\">পরের আয়াত (114:3)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/114-3.html":"<!doctype html>\n<html lang=\"bn\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>তাফসীর An-Naas 114:3 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে</title>\n<meta name=\"description\" content=\"মানুষের ইলাহের কাছে\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/bn/ayah/114-3.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/114-3.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/114-3.h