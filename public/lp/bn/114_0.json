istItem\", \"position\": 2, \"name\": \"সূরা An-Naas\", \"item\": \"https://tafsirshaikhain.com/bn/surah/114.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"আয়াত 3\", \"item\": \"https://tafsirshaikhain.com/bn/ayah/114-3.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/114.html\">সূরা An-Naas</a> › আয়াত 3</nav><h1>তাফসীর সূরা An-Naas 114:3</h1><p class=\"vt ar\" lang=\"ar\">﴿إِلَٰهِ النَّاسِ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">মানুষের ইলাহের কাছে</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">والربوبية تستلزم الإلهية؛ فإن أحدهما إذا تضمن الآخر عند الانفراد لم يمنع أن يختص معناه عند الاقتران، كما في قوله: {قل أعوذ برب الناس} [الناس: 1] {ملك الناس} [الناس: 2] {إله الناس} [الناس: 3]<cite>«الفتاوى الكبرى لابن تيمية» 5/252</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s114a3\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/114-1.html\">আগের আয়াত (114:1)</a><a href=\"/bn/ayah/114-4.html\">পরের আয়াত (114:4)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্র