.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"প্রথম পাতা\", \"item\": \"https://tafsirshaikhain.com/bn/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"সূরা At-Takaathur\", \"item\": \"https://tafsirshaikhain.com/bn/surah/102.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"আয়াত 7\", \"item\": \"https://tafsirshaikhain.com/bn/ayah/102-7.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/102.html\">সূরা At-Takaathur</a> › আয়াত 7</nav><h1>তাফসীর সূরা At-Takaathur 102:7</h1><p class=\"vt ar\" lang=\"ar\">﴿ثُمَّ لَتَرَوُنَّهَا عَيْنَ الْيَقِينِ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">তারপর অবশ্যই তোমরা তা দেখবে চাক্ষুষ প্রত্যয়ে ,</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">ولهذا أتبع ذلك بالقسم على الرؤية التي هي عين اليقين التي هي فوق الخبر الذي هو علم اليقين<cite>«مجموع الفتاوى» 16/518</cite></blockquote></section><section><h2>ইমাম ইবনুল কাইয়্যিম</h2><blockquote class=\"ar\" lang=\"ar\">فاليقين للسمع وعين اليقين للبصر<cite>«التبيان في أقسام القرآن» 1/192</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فهذه الرؤية الثانية غير الأولى من وجهين إطلاق الأولى وتقييد الثانية بعين اليقين وتقدم الأولى وتراخى الثانية عنها<cite>«عدة الصابرين وذخيرة الشاكرين» 1/188</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s102a7\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/102-5.html\">আগের আয়াত (102:5)</a><a href=\"/bn/ayah/102-8.html\">পরের আয়াত (102:8)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/102-8.html":"<!doctype html>\n<html lang=\"bn\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>তাফসীর At-Takaathur 102:8 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে</title>\n<meta name=\"description\" content=\"তারপর অবশ্যই সেদিন তোমাদেরকে নেয়ামত সম্পর্কে প্রশ্ন করা হবে ।\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/bn/ayah/102-8.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/102-8.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/102-8.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/102-8.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/102-8.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/102-8.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/102-8.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaik