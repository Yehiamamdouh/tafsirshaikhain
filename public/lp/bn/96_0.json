m/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/96.html\">সূরা Al-Alaq</a> › আয়াত 2</nav><h1>তাফসীর সূরা Al-Alaq 96:2</h1><p class=\"vt ar\" lang=\"ar\">﴿خَلَقَ الْإِنسَانَ مِنْ عَلَقٍ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">সৃষ্টি করেছেন মানুষকে ‘আলাক’ হতে ।</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">فالقرآن استدل بما هو معلوم للخلق من أنه {خلق الإنسان من علق}<cite>«مجموع الفتاوى» 16/272</cite></blockquote></section><section><h2>ইমাম ইবনুল কাইয়্যিম</h2><blockquote class=\"ar\" lang=\"ar\">إذ خلقه من علقة هو أول مبدء الإنسانية، وحينئذ يكتب رزقه وأجله وعمله وشقاوته وسعادته<cite>«طريق الهجرتين وباب السعادتين» 1/74</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s96a2\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/96-1.html\">আগের আয়াত (96:1)</a><a href=\"/bn/ayah/96-6.html\">পরের আয়াত (96:6)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/96-6.html":"<!doctype html>\n<html lang=\"bn\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<