 href=\"https://tafsirshaikhain.com/es/ayah/90-8.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/90-8.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/90-8.html\">\n<meta property=\"og:title\" content=\"তাফসীর Al-Balad 90:8 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে\">\n<meta property=\"og:description\" content=\"আমরা কি তার জন্য সৃষ্টি করিনি দুচোখ ?\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"প্রথম পাতা\", \"item\": \"https://tafsirshaikhain.com/bn/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"সূরা Al-Balad\", \"item\": \"https://tafsirshaikhain.com/bn/surah/90.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"আয়াত 8\", \"item\": \"https://tafsirshaikhain.com/bn/ayah/90-8.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/90.html\">সূরা Al-Balad</a> › আয়াত 8</nav><h1>তাফসীর সূরা Al-Balad 90:8</h1><p class=\"vt ar\" lang=\"ar\">﴿أَلَمْ نَجْعَل لَّهُ عَيْنَيْنِ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">আমরা কি তার জন্য সৃষ্টি করিনি দুচোখ ?</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">الهداية محلها القلب وهذه الأعضاء الثلاثة التي هي دائمة الحركة والكسب إما للإنسان وإما عليه بخلاف ما يتحرك من داخل فإنه لا يتعلق به ثواب ولا عقاب<cite>«مجموع الفتاوى» 16/221</cite></blockquote></section><section><h2>ইমাম ইবনুল কাইয়্যিম</h2><blockquote class=\"ar\" lang=\"ar\">نبهك بهذا الدليل العقلي القاطع أن الذي جعلك تبصر وتتكلم وتعلم أولى أن يكون بصيرا متكلما عالما فأي دليل عقلي قطعي أقوى من هذا وأبين وأقرب إلى المعقول<cite>«الصواعق المرسلة في الرد على الجهمية والمعطلة» 3/915</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s90a8\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/90-7.html\">আগের আয়াত (90:7)</a><a href=\"/bn/ayah/90-9.html\">পরের আয়াত (90:9)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/90-9.html":"<!doctype html>\n<html lang=\"bn\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>তাফসীর Al-Balad 90:9 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে</title>\n<meta name=\"description\" content=\"আর জিহ্বা ও দুই ঠোঁট ?\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/bn/ayah/90-9.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/90-9.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/90-9.html\">\n<lin