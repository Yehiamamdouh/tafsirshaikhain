t@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/69.html\">সূরা Al-Haaqqa</a> › আয়াত 46</nav><h1>তাফসীর সূরা Al-Haaqqa 69:46</h1><p class=\"vt ar\" lang=\"ar\">﴿ثُمَّ لَقَطَعْنَا مِنْهُ الْوَتِينَ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">তারপর অবশ্যই আমরা কেটে দিতাম তার হৃদপিণ্ডের শিরা,</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">ليبين سبحانه أنه ينتقم ممن يكذب في الرسالة كائنا من كان، وأنه لو قدر أنه غير الرسالة لانتقم منه، والمقصود نفي هذا التقدير لانتفاء لازمه.<cite>«الاستغاثة في الرد على البكري» 1/234</cite></blockquote></section><section><h2>ইমাম ইবনুল কাইয়্যিম</h2><blockquote class=\"ar\" lang=\"ar\">وقطعنا نياط قلبه وأهلكناه،<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/342</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s69a46\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/69-45.html\">আগের আয়াত (69:45)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/69.html":"<!doctype html>\n<html lang=\"bn\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"v