 \"ListItem\", \"position\": 2, \"name\": \"সূরা Al-Muminoon\", \"item\": \"https://tafsirshaikhain.com/bn/surah/23.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"আয়াত 9\", \"item\": \"https://tafsirshaikhain.com/bn/ayah/23-9.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/23.html\">সূরা Al-Muminoon</a> › আয়াত 9</nav><h1>তাফসীর সূরা Al-Muminoon 23:9</h1><p class=\"vt ar\" lang=\"ar\">﴿وَالَّذِينَ هُمْ عَلَىٰ صَلَوَاتِهِمْ يُحَافِظُونَ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">আর যারা নিজেদের সালাতে থাকে যত্নবান</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">وهذه الآيات تقتضي ذم من ترك شيئا من واجبات الصلاة وإن كان في الظاهر مصليا مثل أن يترك الوقت الواجب أو يترك تكميل الشرائط والأركان من الأعمال الظاهرة والباطنة وبذلك فسرها السلف.<cite>«مجموع الفتاوى» 22/572</cite></blockquote><h3>অন্যদের থেকে যা তিনি উদ্ধৃত করেছেন</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">قتادة</span> <span class=\"st\">أقرّه</span> «على وضوئها ومواقيتها وركوعها»<cite>«مجموع الفتاوى» 22/572</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">مسروق</span> <span class=\"st\">أقرّه</span> «على مواقيتها»<cite>«مجموع الفتاوى» 22/572</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن جريج</span> <span class=\"st\">ردّه</span> «المكتوبة والتي في سأل سائل: التطوع.»<cite>«مجموع الفتاوى» 22/572</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s23a9\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/23-2.html\">আগের আয়াত (23:2)</a><a href=\"/bn/ayah/23-13.html\">পরের আয়াত (23:13)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/23-13.html":"<!doctype html>\n<html lang=\"bn\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>তাফসীর Al-Muminoon 23:13 — ইবনে তাইমিয়া ও ইবনুল কাইয়্যিমের মতে</title>\n<meta name=\"description\" content=\"তারপর আমরা তাকে শুক্রবিন্দুরূপে স্থাপন করি এক নিরাপদ ভাণ্ডারে;\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/bn/ayah/23-13.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/23-13.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/23-13.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/23-13.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/23-13.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/23-13.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/23-13.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/23-13.html\">\n<link rel=\"alternate\" hre