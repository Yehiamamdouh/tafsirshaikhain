ily=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/23.html\">সূরা Al-Muminoon</a> › আয়াত 13</nav><h1>তাফসীর সূরা Al-Muminoon 23:13</h1><p class=\"vt ar\" lang=\"ar\">﴿ثُمَّ جَعَلْنَاهُ نُطْفَةً فِي قَرَارٍ مَّكِينٍ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">তারপর আমরা তাকে শুক্রবিন্দুরূপে স্থাপন করি এক নিরাপদ ভাণ্ডারে;</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>ইমাম ইবনুল কাইয়্যিম</h2><blockquote class=\"ar\" lang=\"ar\">فانظر الان الى النطفة بعين البصيرة وهي قطرة من ماء مهين ضعيف مستقذر لو مرت بها ساعة من الزمان فسدت وانتنت<cite>«مفتاح دار السعادة ومنشور ولاية العلم والإرادة» 1/188</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s23a13\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><a href=\"/bn/ayah/23-9.html\">আগের আয়াত (23:9)</a><a href=\"/bn/ayah/23-18.html\">পরের আয়াত (23:18)</a></div></main><footer class=\"site-foot\"><span>তাফসীরুশ শাইখাইন · <a href=\"/bn/\">প্রথম পাতা</a> · <a href=\"/about.html\">প্রকল্প সম্পর্কে</a> · <a href=\"/privacy.html\">গোপনীয়তা ও শর্তাবলি</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/23-18.html":"<!doctype html>\n<html lang=\"bn\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>তাফসীর Al-Muminoon 23:18 — ইবনে তাইমিয়া ও ইবনুল 