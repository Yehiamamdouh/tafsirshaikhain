n.com/bn/surah/108.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"আয়াত 2\", \"item\": \"https://tafsirshaikhain.com/bn/ayah/108-2.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/bn/\">প্রথম পাতা</a> › <a href=\"/bn/surah/108.html\">সূরা Al-Kawthar</a> › আয়াত 2</nav><h1>তাফসীর সূরা Al-Kawthar 108:2</h1><p class=\"vt ar\" lang=\"ar\">﴿فَصَلِّ لِرَبِّكَ وَانْحَرْ﴾</p><section><h3>অর্থের অনুবাদ</h3><p class=\"tr\">কাজেই আপনি আপনার রবের উদ্দেশ্যে সালাত আদায় করুন এবং কুরবানী করুন ।</p><span class=\"cr\" dir=\"ltr\">Bengali Translation - Abu Bakr Zakaria — v1.1.1 · QuranEnc.com</span></section><p class=\"cr\">দুই ইমামের বক্তব্য মূল আরবিতে হুবহু, সূত্রসহ দেওয়া হয়েছে।</p><section><h2>শাইখুল ইসলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">أمره الله أن يجمع بين هاتين العبادتين العظيمتين وهما الصلاة والنسك الدالتان على القرب والتواضع والافتقار وحسن الظن<cite>«مجموع الفتاوى» 16/531</cite></blockquote></section><section><h2>ইমাম ইবনুল কাইয়্যিম</h2><blockquote class=\"ar\" lang=\"ar\">ولهذا يقرن الله سبحانه بينهما كقوله: {فصل لربك وانحر}<cite>«إعلام الموقعين عن رب العالمين» 2/118</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وبدأ في العيد بالصلاة ثم جعل النحر بعدها، وأخبر أن ( «من ذبح قبلها، فلا نسك له» ) تقديما لما بدأ الله به في قوله {فصل لربك وانحر}<cite>«زاد المعاد في هدي خير العباد» 2/320</cite></blockquote><h3>অন্যদের থেকে যা তিনি উদ্ধৃত করেছেন</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">بعض المتأولين</span> <span class=\"st\">ردّه</span> «إن المراد به ضع يدك على نحرك»<cite>«الصواعق المرسلة في الرد على الجهمية والمعطلة» 2/695</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">علي</span> <span class=\"st\">حكاه</span> «إنه وضع اليمين على الشمال في الصلاة تحت صدره،»<cite>«إعلام الموقعين عن رب العالمين» 2/290</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=bn#s108a2\">ইন্টারঅ্যাকটিভ তাফসীরে খুলুন (পূর্ণ পাঠ)</a><div class=\"pn\"><span></span><a href=\"/bn/ayah/108-3.html\">পরের আয়াত (108:3)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/108-2.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/108-2.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/108-2.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/108-2.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/108-2.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/108-2.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <b lang=\"bn\">বাংলা</b> · <a href=\"/ms/ayah/108-2.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/108-2.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/108-2.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/108-2.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/108-2.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/108-2.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/108-2.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\