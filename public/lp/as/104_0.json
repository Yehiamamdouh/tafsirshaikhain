nction gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/as/\">মূল পৃষ্ঠা</a> › <a href=\"/as/surah/104.html\">ছূৰা Al-Humaza</a> › আয়াত 8</nav><h1>তাফছীৰ: ছূৰা Al-Humaza 104:8</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌ﴾</p><section><h3>অৰ্থানুবাদ</h3><p class=\"tr\">নিশ্চয় এইটোৱে সিহঁতক আৱদ্ধ কৰি ৰাখিব।</p><span class=\"cr\" dir=\"ltr\">Assamese Translation - Rafiqul Islam Habibur-Rahman — v1.0.5 · QuranEnc.com</span></section><p class=\"cr\">দুয়োজন ইমামৰ কথা মূল আৰবীত, যেনেকৈ আছে তেনেকৈ, উৎসসহ দিয়া হৈছে।</p><section><h2>ইমাম ইবনুল কাইয়িম</h2><blockquote class=\"ar\" lang=\"ar\">وأما النار فإذا دخلها أهلها أغلقت عليهم أبوابها كما قال تعالى {إنها عليهم مؤصدة} أي مطبقة<cite>«حادي الأرواح إلى بلاد الأفراح» 1/53</cite></blockquote></section><div class=\"muy\"><div class=\"muy-head\"><b>আল-মুখতাছাৰ ফী তাফছীৰিল কোৰআনিল কাৰীম</b><small>আয়াতৰ সাধাৰণ অৰ্থ — দুজন শ্বেখৰ কথা নহয়</small></div><p class=\"muy-text\">তাৰ ভিতৰত শাস্তিপ্ৰাপ্ত ব্যক্তিসকলক আৱদ্ধ কৰি সেইটো বন্ধ কৰি দিয়া হ’ব।</p><a class=\"muy-credit\" href=\"https://quranenc.com/en/browse/assamese_mokhtasar\" target=\"_blank\" rel=\"noopener\" dir=\"ltr\">Assamese Translation of Al-Mukhtasar in Interpreting the Noble Quran — 2026-11-04 · QuranEnc.com</a></div><a class=\"btn pri open\" href=\"/tafsir.html?lang=as#s104a8\">ইণ্টাৰেক্টিভ তাফছীৰত খোলক (সম্পূৰ্ণ পাঠ)</a><div class=\"pn\"><a href=\"/as/ayah/104-2.html\">আগৰ আয়াত (104:2)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/104-8.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/104-8.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/104-8.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/104-8.html\" hreflang=\"id\" lang=\"id\" data