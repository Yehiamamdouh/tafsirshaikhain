x;color:var(--muted,#5b6676);overflow-wrap:anywhere}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/as/\">মূল পৃষ্ঠা</a> › <a href=\"/as/surah/41.html\">ছূৰা Fussilat</a> › আয়াত 50</nav><h1>তাফছীৰ: ছূৰা Fussilat 41:50</h1><p class=\"vt ar\" lang=\"ar\">﴿وَلَئِنْ أَذَقْنَاهُ رَحْمَةً مِّنَّا مِن بَعْدِ ضَرَّاءَ مَسَّتْهُ لَيَقُولَنَّ هَٰذَا لِي وَمَا أَظُنُّ السَّاعَةَ قَائِمَةً وَلَئِن رُّجِعْتُ إِلَىٰ رَبِّي إِنَّ لِي عِندَهُ لَلْحُسْنَىٰ فَلَنُنَبِّئَنَّ الَّذِينَ كَفَرُوا بِمَا عَمِلُوا وَلَنُذِيقَنَّهُم مِّنْ عَذَابٍ غَلِيظٍ﴾</p><section><h3>অৰ্থানুবাদ</h3><p class=\"tr\">আকৌ দুখ-দৈন্যই স্পৰ্শ কৰাৰ পিছত যদি আমি তাক আমাৰ তৰফৰ পৰা অনুগ্ৰহৰ সোৱাদ ল’বলৈ দিওঁ, তেতিয়া সি কয়, ‘এয়া হৈছে মোৰ প্ৰাপ্য আৰু মোৰ বিশ্বাস নহয় যে কিয়ামত সংঘটিত হ’ব। আনহাতে যদি মোক মোৰ প্ৰতিপালকৰ ওচৰলৈ ওভতাই নিয়াও হয়, তথাপিও তেওঁৰ ওচৰত মোৰ বাবে কল্যাণেই থাকিব’। এতেকে নিশ্চয় আমি কাফিৰসকলক সিহঁতৰ আমল সম্পৰ্কে অৱহিত কৰিম আৰু সিহঁতক অৱশ্যে কঠোৰ শাস্তি আস্বাদন কৰাম।</p><span class=\"cr\" dir=\"ltr\">Assamese Translation - Rafiqul Islam Habibur-Rahman — v1.0.5 · QuranEnc.com</span></section><p class=\"cr\">দুয়োজন ইমামৰ কথা মূল আৰবীত, যেনেকৈ আছে তেনেকৈ, উৎসসহ দিয়া হৈছে।</p><section><h2>ইমাম ইবনুল কাইয়িম</h2><blockquote class=\"ar\" lang=\"ar\">واعظم الناس غرورا بربه من إذا مسه الله برحمة منه وفضل قال هذا لي أي أنا أهله وجدير به ومستحق له ثم قال {وما أظن الساعة قائمة} فظن أنه أهل لما أولاه من النعم مع كفره بالله<cite>«الروح في الكلام على أرواح الأموات والأحياء بالدلائل من الكتاب والسنة» 1/245</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">ثم زاد في غروره فقال {ولئن رجعت إلى ربي إن لي عنده للحسنى} يعني الجنة والكرامة<cite>«الروح في الكلام على أرواح الأموات والأحياء بالدلائل من الكتاب والسنة» 1/245</cite></blockquote></section><div class=\"muy\"><div class=\"muy-head\"><b>আল-মুখতাছাৰ ফী তাফছীৰিল কোৰআনিল কাৰীম</b><small>আয়াতৰ সাধাৰণ অৰ্থ — দুজন শ্বেখৰ কথা নহয়</small></div><p class=\"muy-text\">আনহাতে পৰীক্ষা তথা বেমাৰ-আজাৰৰ পিছত যদি আমি তাক সুস্বাস্থ্য আৰু ধন-সম্পদ দান কৰোঁ, তেতিয়া সি নিশ্চয় ক’বঃ “এইবোৰ মই এইকাৰণে লাভ কৰিছোঁ, কাৰণ মই ইয়াৰ যোগ্য আছিলোঁ, তথা এইটো আছিল মোৰ প্ৰাপ্য। লগতে কিয়ামত সংঘটিত হ’ব বুলিও মোৰ বিশ্বাস নহয়। যদি মানিও লওঁ যে, কিয়ামত সংঘটিত হ’ব তথাপিও আল্লাহৰ ওচৰত থাকিব মোৰ বাবে অজস্ৰ ধন-সম্পদ। কিয়নো যিদৰে তেওঁ মোৰ যোগ্যতা অনুসাৰে পৃথিৱীত মোক ধন-সম্পত্তি দান কৰিছে, ঠিক সেইদৰে আখিৰাততো তেওঁ মোক মোৰ প্ৰাপ্যখিনি প্ৰদান কৰি উপকাৰ কৰিব”। নিশ্চয় আল্লাহৰ লগত কুফৰী কৰা ব্যক্তিসকলক সিহঁতৰ কুফৰী আৰু গুনাহৰ বিষয়ে অচিৰেই আমি সিহঁতক অৱগত কৰিম। তথা অতি কঠিন শাস্তিৰ সোৱাদ উপভোগ কৰিবলৈ দিম।</p><a class=\"muy-credit\" href=\"https://quranenc.com/en/browse/assamese_mokhtasar\" target=\"_blank\" rel=\"noopener\" dir=\"ltr\">Assamese Translation of Al-Mukhtasar in Interpreting the Noble Quran — 2026-11-04 · QuranEnc.com</a></div><a class=\"btn pri open\" href=\"/tafsir.html?lang=as#s41a50\">ইণ্টাৰেক্টিভ তাফছীৰত খোলক (সম্পূৰ্ণ পাঠ)</a><div class=\"pn\"><a href=\"/as/ayah/41-49.html\">আগৰ আয়াত (41:49)</a><a href=\"/as/ayah/41-51.html\">পিছৰ আয়াত (41:51)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/41-50.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/41-50.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/41-50.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/41-50.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/41-50.html\"