,sans-serif);font-weight:600;font-size:15px}.muy-head small{font-size:12.5px;color:var(--muted,#5b6676)}.muy-text{margin:0;font-family:var(--f-read,serif);font-size:17px;line-height:1.95;overflow-wrap:anywhere}.muy-fn{margin:0;font-size:14px;line-height:1.7;color:var(--muted,#5b6676);white-space:pre-line}.muy-credit{font-size:12px;color:var(--muted,#5b6676);overflow-wrap:anywhere}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/as/\">মূল পৃষ্ঠা</a> › <a href=\"/as/surah/41.html\">ছূৰা Fussilat</a> › আয়াত 51</nav><h1>তাফছীৰ: ছূৰা Fussilat 41:51</h1><p class=\"vt ar\" lang=\"ar\">﴿وَإِذَا أَنْعَمْنَا عَلَى الْإِنسَانِ أَعْرَضَ وَنَأَىٰ بِجَانِبِهِ وَإِذَا مَسَّهُ الشَّرُّ فَذُو دُعَاءٍ عَرِيضٍ﴾</p><section><h3>অৰ্থানুবাদ</h3><p class=\"tr\">আৰু যেতিয়া আমি মানুহৰ প্ৰতি অনুগ্ৰহ কৰোঁ তেতিয়া সি মুখ ঘূৰাই লয় আৰু দূৰলৈ আঁতৰি যায়। কিন্তু যেতিয়া তাক অকল্যাণে স্পৰ্শ কৰে তেতিয়া সি দীৰ্ঘ প্ৰাৰ্থনাকাৰী হয়।</p><span class=\"cr\" dir=\"ltr\">Assamese Translation - Rafiqul Islam Habibur-Rahman — v1.0.5 · QuranEnc.com</span></section><p class=\"cr\">দুয়োজন ইমামৰ কথা মূল আৰবীত, যেনেকৈ আছে তেনেকৈ, উৎসসহ দিয়া হৈছে।</p><section><h2>শ্বেখুল ইছলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">وحزب يتضرعون إليه في حال الضراء. ويتوبون إليه. فإذا كشفها عنهم: أعرضوا عنه كما قال تعالى {وإذا مس الإنسان الضر دعانا لجنبه أو قاعدا أو قائما فلما كشفنا عنه ضره مر كأن لم يدعنا إلى ضر مسه كذلك زين للمسرفين ما كانوا يعملون} وقال تعالى {وإذا أنعمنا على الإنسان أعرض ونأى بجانبه وإذا مسه الشر فذو دعاء عريض}<cite>«مجموع الفتاوى» 14/371</cite></blockquote></section><div class=\"muy\"><div class=\"muy-head\"><b>আল-মুখতাছাৰ ফী তাফছীৰিল কোৰআনিল কাৰীম</b><small>আয়াতৰ সাধাৰণ অৰ্থ — দুজন শ্বেখৰ কথা নহয়</small></div><p class=\"muy-text\">মানুহক যেতিয়া আমি সুস্বাস্থ্য, আৰোগ্য আদিৰ মাধ্যমত নিয়ামত প্ৰদান কৰোঁ, তেতিয়া সি আল্লাহৰ স্মৰণ আৰু আনুগত্যৰ পৰা অমনোযোগী হৈ পৰে, তথা অহংকাৰ কৰি বিমুখ হৈ পৰে। কিন্তু যেতিয়াই বেমাৰ-আজাৰ আৰু দৰিদ্ৰতা আদিয়ে স্পৰ্শ কৰে, তেতিয়াই আল্লাহৰ ওচৰত বেছি বেছি দুআ কৰিবলৈ আৰম্ভ কৰে। তেওঁৰ ওচৰত বিপদ-আপদ সম্পৰ্কে অভিযোগ কৰে, যাতে তেওঁ সেই বিপদ-আপদ দূৰ কৰি দিয়ে। পক্ষান্তৰে সি নিয়ামত আদি লাভৰ সময়ত আল্লাহৰ কৃতজ্ঞতা জ্ঞাপন নকৰে, আৰু তেওঁ যেতিয়া তাক বিপদ-আপদৰ দ্বাৰা পৰীক্ষা কৰে, সেই সময়তো সি ধৈৰ্য্য ধাৰণ নকৰে।</p><a class=\"muy-credit\" href=\"https://quranenc.com/en/browse/assamese_mokhtasar\" target=\"_blank\" rel=\"noopener\" dir=\"ltr\">Assamese Translation of Al-Mukhtasar in Interpreting the Noble Quran — 2026-11-04 · QuranEnc.com</a></div><a class=\"btn pri open\" href=\"/tafsir.html?lang=as#s41a51\">ইণ্টাৰেক্টিভ তাফছীৰত খোলক (সম্পূৰ্ণ পাঠ)</a><div class=\"pn\"><a href=\"/as/ayah/41-50.html\">আগৰ আয়াত (41:50)</a><a href=\"/as/ayah/41-53.html\">পিছৰ আয়াত (41:53)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/41-51.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/41-51.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/41-51.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/41-51.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/41-51.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/41-51.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/41-51.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/41-51.html\" hreflang=\"ms\" lang