s:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/as/\">মূল পৃষ্ঠা</a> › <a href=\"/as/surah/41.html\">ছূৰা Fussilat</a> › আয়াত 51</nav><h1>তাফছীৰ: ছূৰা Fussilat 41:51</h1><p class=\"vt ar\" lang=\"ar\">﴿وَإِذَا أَنْعَمْنَا عَلَى الْإِنسَانِ أَعْرَضَ وَنَأَىٰ بِجَانِبِهِ وَإِذَا مَسَّهُ الشَّرُّ فَذُو دُعَاءٍ عَرِيضٍ﴾</p><section><h3>অৰ্থানুবাদ</h3><p class=\"tr\">আৰু যেতিয়া আমি মানুহৰ প্ৰতি অনুগ্ৰহ কৰোঁ তেতিয়া সি মুখ ঘূৰাই লয় আৰু দূৰলৈ আঁতৰি যায়। কিন্তু যেতিয়া তাক অকল্যাণে স্পৰ্শ কৰে তেতিয়া সি দীৰ্ঘ প্ৰাৰ্থনাকাৰী হয়।</p><span class=\"cr\" dir=\"ltr\">Assamese Translation - Rafiqul Islam Habibur-Rahman — v1.0.5 · QuranEnc.com</span></section><p class=\"cr\">দুয়োজন ইমামৰ কথা মূল আৰবীত, যেনেকৈ আছে তেনেকৈ, উৎসসহ দিয়া হৈছে।</p><section><h2>শ্বেখুল ইছলাম ইবনে তাইমিয়া</h2><blockquote class=\"ar\" lang=\"ar\">وحزب يتضرعون إليه في حال الضراء. ويتوبون إليه. فإذا كشفها عنهم: أعرضوا عنه كما قال تعالى {وإذا مس الإنسان الضر دعانا لجنبه أو قاعدا أو قائما فلما كشفنا عنه ضره مر كأن لم يدعنا إلى ضر مسه كذلك زين للمسرفين ما كانوا يعملون} وقال تعالى {وإذا أنعمنا على الإنسان أعرض ونأى بجانبه وإذا مسه الشر فذو دعاء عريض}<cite>«مجموع الفتاوى» 14/371</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=as#s41a51\">ইণ্টাৰেক্টিভ তাফছীৰত খোলক (সম্পূৰ্ণ পাঠ)</a><div class=\"pn\"><a href=\"/as/ayah/41-50.html\">আগৰ আয়াত (41:50)</a><a href=\"/as/ayah/41-53.html\">পিছৰ আয়াত (41:53)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/41-51.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/41-51.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/41-51.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/41-51.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/41-51.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=