irshaikhain.com/og.png\">\n<meta property=\"og:image:width\" content=\"1200\">\n<meta property=\"og:image:height\" content=\"630\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<link rel=\"manifest\" href=\"/manifest.webmanifest\">\n<link rel=\"apple-touch-icon\" href=\"/icon-192.png\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"তাফছীৰ: Fussilat 41:50 — ইবনে তাইমিয়া আৰু ইবনুল কাইয়িমৰ মতে\", \"description\": \"আকৌ দুখ-দৈন্যই স্পৰ্শ কৰাৰ পিছত যদি আমি তাক আমাৰ তৰফৰ পৰা অনুগ্ৰহৰ সোৱাদ ল’বলৈ দিওঁ, তেতিয়া সি কয়, ‘এয়া হৈছে মোৰ প্ৰাপ্য আৰু মোৰ বিশ্বাস নহয় যে কিয়ামত সংঘট\", \"inLanguage\": \"as\", \"url\": \"https://tafsirshaikhain.com/as/ayah/41-50.html\", \"mainEntityOfPage\": \"https://tafsirshaikhain.com/as/ayah/41-50.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"শ্বেখুল ইছলাম ইবনে তাইমিয়া\"}, {\"@type\": \"Person\", \"name\": \"ইমাম ইবনুল কাইয়িম\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"দুজন শ্বেখৰ তাফছীৰ\", \"url\": \"https://tafsirshaikhain.com/as/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"মূল পৃষ্ঠা\", \"item\": \"https://tafsirshaikhain.com/as/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"ছূৰা Fussilat\", \"item\": \"https://tafsirshaikhain.com/as/surah/41.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"আয়াত 50\", \"item\": \"https://tafsirshaikhain.com/as/ayah/41-50.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/as/\">মূল পৃষ্ঠা</a> › <a href=\"/as/surah/41.html\">ছূৰা Fussilat</a> › আয়াত 50</nav><h1>তাফছীৰ: ছূৰা Fussilat 41:50</h1><p class=\"vt ar\" lang=\"ar\">﴿وَلَئِنْ أَذَقْنَاهُ رَحْمَةً مِّنَّا مِن بَعْدِ ضَرَّاءَ مَسَّتْهُ لَيَقُولَنَّ هَٰذَا لِي وَمَا أَظُنُّ السَّاعَةَ قَائِمَةً وَلَئِن رُّجِعْتُ إِلَىٰ رَبِّي إِنَّ لِي عِندَهُ لَلْحُسْنَىٰ فَلَنُنَبِّئَنَّ الَّذِينَ كَفَرُوا بِمَا عَمِلُوا وَلَنُذِيقَنَّهُم مِّنْ عَذَابٍ غَلِيظٍ﴾</p><section><h3>অৰ্থানুবাদ</h3><p class=\"tr\">আকৌ দুখ-দৈন্যই স্পৰ্শ কৰাৰ পিছত যদি আমি তাক আমাৰ তৰফৰ পৰা অনুগ্ৰহৰ সোৱাদ ল’বলৈ দিওঁ, তেতিয়া সি কয়, ‘এয়া হৈছে মোৰ প্ৰাপ্য আৰু মোৰ বিশ্বাস নহয় যে কিয়ামত সংঘটিত হ’ব। আনহাতে যদি মোক মোৰ প্ৰতিপালকৰ ওচৰলৈ ওভতাই নিয়াও হয়, তথাপিও তেওঁৰ ওচৰত মোৰ বাবে কল্যাণেই থাকিব’। এতেকে নিশ্চয় আমি কাফিৰসকলক সিহঁতৰ আমল সম্পৰ্কে অৱহিত কৰিম আৰু সিহঁতক অৱশ্যে কঠোৰ শাস্তি আস্বাদন কৰাম।</p><span class=\"cr\" dir=\"ltr\">Assamese Translation - Rafiqul Islam Habibur-Rahman — v1.0.5 · QuranEnc.com</span></section><p class=\"cr\">দুয়োজন ইমামৰ কথা মূল আৰবীত, যেনেকৈ আছে তেনেকৈ, উৎসসহ দিয়া হৈছে।</p><section><h2>ইমাম ইবনুল কাইয়িম</h2><blockquote class=\"ar\" lang=\"ar\">واعظم الناس غرورا بربه من إذا مسه الله برحمة منه وفضل قال هذا لي أي أنا أهله وجدير به ومستحق له ثم قال {وما أظن الساعة قائمة} فظن أنه أهل لما أولاه من النعم مع كفره بالله<cite>«الروح في الكلام على أرواح الأموات والأحياء بالدلائل من الكتاب والسنة» 1/245</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">ثم زاد في غروره فقال {ولئن رجعت إلى ربي إن لي عنده للحسنى} يعني الجنة والكرامة<cite>«الروح في الكلام على أرواح الأموات والأحياء بالدلائل من الكتاب والسنة» 1/245</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=as#s41a50\">ইণ্টাৰেক্টিভ তাফছীৰত খোলক (সম্পূৰ্ণ পাঠ)</a><div class=\"pn\"><a href=\"/as/ayah/41-49.html\">আগৰ আয়াত (41:49)</a><a href=\"/as/ayah/41-51.html\">পিছৰ আয়াত (41:51)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/41-50.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/41-50.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/41-50.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/41-50.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/41-50.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/41-50.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/41-50.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/41-50.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/41-50.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/41-50.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/41-50.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/41-50.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/41-50.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/41-50.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/41-50.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a> · <a href=\"/hi/