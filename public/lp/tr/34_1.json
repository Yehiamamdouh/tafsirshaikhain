erty=\"og:image:height\" content=\"630\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<link rel=\"manifest\" href=\"/manifest.webmanifest\">\n<link rel=\"apple-touch-icon\" href=\"/icon-192.png\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"Tefsiri: Saba 34:51 — İbn Teymiyye ve İbnü'l-Kayyim'e göre\", \"description\": \"(Rasûlüm!) Korkuya düştükleri zaman, onları bir görsen! Artık kurtuluş yoktur, yakın bir yerden yakalanmışlardır.\", \"inLanguage\": \"tr\", \"url\": \"https://tafsirshaikhain.com/tr/ayah/34-51.html\", \"mainEntityOfPage\": \"https://tafsirshaikhain.com/tr/ayah/34-51.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"Şeyhülislam İbn Teymiyye\"}, {\"@type\": \"Person\", \"name\": \"İmam İbnü'l-Kayyim\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"Tefsîru'ş-Şeyhayn\", \"url\": \"https://tafsirshaikhain.com/tr/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Ana sayfa\", \"item\": \"https://tafsirshaikhain.com/tr/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sûre Saba\", \"item\": \"https://tafsirshaikhain.com/tr/surah/34.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Âyet 51\", \"item\": \"https://tafsirshaikhain.com/tr/ayah/34-51.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.muy{display:grid;gap:6px;background:var(--sheet,#fff);border:1px dashed var(--line,#d9dee6);border-inline-start:4px solid var(--muted,#5b6676);border-radius:10px;padding:12px 14px;margin:4px 0}.muy-head{display:flex;flex-wrap:wrap;gap:4px 10px;align-items:baseline}.muy-head b{font-family:var(--f-display,sans-serif);font-weight:600;font-size:15px}.muy-head small{font-size:12.5px;color:var(--muted,#5b6676)}.muy-text{margin:0;font-family:var(--f-read,serif);font-size:17px;line-height:1.95;overflow-wrap:anywhere}.muy-fn{margin:0;font-size:14px;line-height:1.7;color:var(--muted,#5b6676);white-space:pre-line}.muy-credit{font-size:12px;color:var(--muted,#5b6676);overflow-wrap:anywhere}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/tr/\">Ana sayfa</a> › <a href=\"/tr/surah/34.html\">Sûre Saba</a> › Âyet 51</nav><h1>Tefsiri: Sûre Saba 34:51</h1><p class=\"vt ar\" lang=\"ar\">﴿وَلَوْ تَرَىٰ إِذْ فَزِعُوا فَلَا فَوْتَ وَأُخِذُوا مِن مَّكَانٍ قَرِيبٍ﴾</p><section><h3>Meal</h3><p class=\"tr\">(Rasûlüm!) Korkuya düştükleri zaman, onları bir görsen! Artık kurtuluş yoktur, yakın bir yerden yakalanmışlardır.</p><span class=\"cr\" dir=\"ltr\">Turkish Translation - Rowwad Translation Center — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">İki imamın sözleri, kaynaklarıyla birlikte, aslı olan Arapça metinle aynen verilmiştir.</p><section><h2>Şeyhülislam İbn Teymiyye</h2><blockquote class=\"ar\" lang=\"ar\">وهو سبحانه يذكر جواب القسم تارة وهو الغالب. وتارة يحذفه كما يحذف جواب لو كثيرا كقوله تعالى: {لو تعلمون علم اليقين} وقوله: {ولو أن قرآنا سيرت به الجبال} {ولو ترى إذ يتوفى الذين كفروا الملائكة} {ولو ترى إذ فزعوا فلا فوت} {ولو ترى إذ وقفوا على النار} {ولو ترى إذ وقفوا على ربهم} . ومثل هذا حذفه من أحسن الكلام؛ لأن المراد أنك لو رأيته لرأيت هولا عظيما<cite>«مجموع الفتاوى» 13/315</cite></blockquote></section><section><h2>İmam İbnü&#x27;l-Kayyim</h2><h3>Başkalarından naklettikleri</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">شيخه ابن تيمية (فصل أقسام القرآن، مجموع الفتاوى 13/314-316)</span> <span class=\"st\">أقرّه</span> «قوله تعالى {ولو يرى الذين ظلموا إذ يرون العذاب أن القوة لله جميعا وأن الله شديد العذاب} فالمعنى في أظهر الوجهين لو يرى الذين ظلموا في الدنيا إذ يرون العذاب في الآخرة والجواب محذوف ثم قال {أن القوة لله جميعا} كما قال تعالى {ولو ترى إذ فزعوا فلا فوت} {ولو ترى إذ يتوفى الذين كفروا الملائكة} أي لو ترى ذلك الوقت وما فيه»<cite>«التبيان في أقسام القرآن» 1/3</cite></blockquote></section><div class=\"muy\"><div class=\"muy-head\"><b>el-Muhtasar fî Tefsîri&#x27;l-Kur&#x27;âni&#x27;l-Kerîm</b><small>Âyetin genel anlamı — iki şeyhin sözü değildir</small></div><p class=\"muy-text\">Ey Resul! O yalanlayanlar, kıyamet günü azabı bizzat gördüklerinde bundan kaçacakları ve sığınacakları bir sığınak yoktur. Onlar, ilk andan ve işin başından itibaren yakın bir yerden yakalanıvermişlerdir. Eğer sen bu durumu görseydin şaşılacak bir şey görmüş olurdun.</p><a class=\"muy-credit\" href=\"https://quranenc.com/en/browse/turkish_mokhtasar\" target=\"_blank\" rel=\"noopener\" dir=\"ltr\">Turkish Translation of Al-Mukhtasar in Interpreting the Noble Quran — 2026-11-04 · QuranEnc.com</a></div><a class=\"btn pri open\" href=\"/tafsir.html?lang=tr#s34a51\">Etkileşimli tefsirde aç (tam metinler)</a><div class=\"pn\"><a href=\"/tr/ayah/34-50.html\">Önceki âyet (34:50)</a><a href=\"/tr/ayah/34-54.html\">Sonraki âyet (34:54)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ay