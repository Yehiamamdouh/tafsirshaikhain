\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/tr/\">Ana sayfa</a> › <a href=\"/tr/surah/113.html\">Sûre Al-Falaq</a> › Âyet 2</nav><h1>Tefsiri: Sûre Al-Falaq 113:2</h1><p class=\"vt ar\" lang=\"ar\">﴿مِن شَرِّ مَا خَلَقَ﴾</p><section><h3>Meal</h3><p class=\"tr\">Yarattığı varlıkların şerrinden.</p><span class=\"cr\" dir=\"ltr\">Turkish Translation - Rowwad Translation Center — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">İki imamın sözleri, kaynaklarıyla birlikte, aslı olan Arapça metinle aynen verilmiştir.</p><section><h2>Şeyhülislam İbn Teymiyye</h2><blockquote class=\"ar\" lang=\"ar\">فمن المخلوقات ماله شر، وإن كان بقضائه وقدره.<cite>«الحسنة والسيئة» 1/40</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وإما أن يضاف إلى السبب كقوله تعالى: {من شر ما خلق} [الفلق: 2]<cite>«الحسنة والسيئة» 1/45</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=tr#s113a2\">Etkileşimli tefsirde aç (tam metinler)</a><div class=\"pn\"><a href=\"/tr/ayah/113-1.html\">Önceki âyet (113:1)</a><a href=\"/tr/ayah/113-4.html\">Sonraki âyet (113:4)</a></div></main><footer class=\"site-foot\"><span>Tefsîru&#x27;ş-Şeyhayn · <a href=\"/tr/\">Ana sayfa</a> · <a href=\"/about.html\">Proje hakkında</a> · <a href=\"/privacy.html\">Gizlilik ve şartlar</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/113-4.html":"<!doctype html>\n<html lang=\