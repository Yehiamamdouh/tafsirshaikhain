 \"item\": \"https://tafsirshaikhain.com/tr/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sûre Al-Haaqqa\", \"item\": \"https://tafsirshaikhain.com/tr/surah/69.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Âyet 44\", \"item\": \"https://tafsirshaikhain.com/tr/ayah/69-44.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/tr/\">Ana sayfa</a> › <a href=\"/tr/surah/69.html\">Sûre Al-Haaqqa</a> › Âyet 44</nav><h1>Tefsiri: Sûre Al-Haaqqa 69:44</h1><p class=\"vt ar\" lang=\"ar\">﴿وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ الْأَقَاوِيلِ﴾</p><section><h3>Meal</h3><p class=\"tr\">Eğer Peygamber bizim adımıza bazı sözler uydurmuş olsaydı;</p><span class=\"cr\" dir=\"ltr\">Turkish Translation - Rowwad Translation Center — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">İki imamın sözleri, kaynaklarıyla birlikte, aslı olan Arapça metinle aynen verilmiştir.</p><section><h2>İmam İbnü&#x27;l-Kayyim</h2><blockquote class=\"ar\" lang=\"ar\">أي لو أتى بشيء من عند نفسه لأخذنا منه بيمينه، وقطعنا نياط قلبه وأهلكناه،<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/342</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">أفلا تراه كيف يخبر سبحانه: أن كماله وحكمته وقدرته تأبى أن يقر من تقول عليه بعض الأقاويل؟ بل لابد أن يجعله عبرة لعباده، كما جرت بذلك سنته في المتقولين عليه،<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 3/434</cite><