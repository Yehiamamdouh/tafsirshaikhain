ype\": \"ListItem\", \"position\": 2, \"name\": \"Sûre Hud\", \"item\": \"https://tafsirshaikhain.com/tr/surah/11.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Âyet 55\", \"item\": \"https://tafsirshaikhain.com/tr/ayah/11-55.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/tr/\">Ana sayfa</a> › <a href=\"/tr/surah/11.html\">Sûre Hud</a> › Âyet 55</nav><h1>Tefsiri: Sûre Hud 11:55</h1><p class=\"vt ar\" lang=\"ar\">﴿مِن دُونِهِ فَكِيدُونِي جَمِيعًا ثُمَّ لَا تُنظِرُونِ﴾</p><section><h3>Meal</h3><p class=\"tr\">Bana hepiniz toptan tuzağınızı kurun. Sonra da bana mühlet vermeyin, dedi.</p><span class=\"cr\" dir=\"ltr\">Turkish Translation - Rowwad Translation Center — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">İki imamın sözleri, kaynaklarıyla birlikte, aslı olan Arapça metinle aynen verilmiştir.</p><section><h2>Şeyhülislam İbn Teymiyye</h2><blockquote class=\"ar\" lang=\"ar\">ثم يتحداهم ويعجزهم بقوله { فكيدوني جميعا ثم لا تنظرون إني توكلت على الله ربي وربكم ما من دابة إلا هو آخذ بناصيتها }<cite>«رسالة في تحقيق التوكل» 1/96</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=tr#s11a55\">Etkileşimli tefsirde aç (tam metinler)</a><div class=\"pn\"><a href=\"/tr/ayah/11-52.html\">Önceki âyet (11:52)</a><a href=\"/tr/ayah/11-56.html\">Sonraki âyet (11:56)</a></div></main><footer class=\"site-foot\"><span>Tef