m\", \"position\": 2, \"name\": \"Sûre Ash-Shura\", \"item\": \"https://tafsirshaikhain.com/tr/surah/42.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Âyet 53\", \"item\": \"https://tafsirshaikhain.com/tr/ayah/42-53.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/tr/\">Ana sayfa</a> › <a href=\"/tr/surah/42.html\">Sûre Ash-Shura</a> › Âyet 53</nav><h1>Tefsiri: Sûre Ash-Shura 42:53</h1><p class=\"vt ar\" lang=\"ar\">﴿صِرَاطِ اللَّهِ الَّذِي لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ أَلَا إِلَى اللَّهِ تَصِيرُ الْأُمُورُ﴾</p><section><h3>Meal</h3><p class=\"tr\">Göklerdeki ve yerdeki her şeyin sahibi olan Allah’ın yoluna. İyi bilin ki, bütün işler sonunda Allah’a döner.</p><span class=\"cr\" dir=\"ltr\">Turkish Translation - Rowwad Translation Center — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">İki imamın sözleri, kaynaklarıyla birlikte, aslı olan Arapça metinle aynen verilmiştir.</p><section><h2>İmam İbnü&#x27;l-Kayyim</h2><blockquote class=\"ar\" lang=\"ar\">والصراط تارة يضاف إلى الله، إذ هو الذي شرعه ونصبه، كقوله تعالى {وأن هذا صراطي مستقيما} [الأنعام: 153] وقوله {وإنك لتهدي إلى صراط مستقيم صراط الله} [الشورى: 52]<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/34</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=tr#s42a53\">Etkileşimli tefsirde aç (tam metinler)</a><div class=\"pn\"><a href=\"/tr/ayah/42-52.html\">Önceki âyet (42:52)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/42-53.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/42-53.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/42-53.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/42-53.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <b lang=\"tr\">Türkçe</b> · <a href=\"/fr/ayah/42-53.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/42-53.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/42-53.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/42-53.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/42-53.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/42-53.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/42-53.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/42-53.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/42-53.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/42-53.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a></nav>\n<footer class=\"site-foot\"><span>Tefsîru&#x27;ş-Şeyhayn · <a href=\"/tr/\">Ana sayfa</a> · <a href=\"/about.html\">Proje hakkında</a> · <a href=\"/privacy.html\">Gizlilik ve şartlar</a></sp