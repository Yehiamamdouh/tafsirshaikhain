surah/91.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Âyet 9\", \"item\": \"https://tafsirshaikhain.com/tr/ayah/91-9.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/tr/\">Ana sayfa</a> › <a href=\"/tr/surah/91.html\">Sûre Ash-Shams</a> › Âyet 9</nav><h1>Tefsiri: Sûre Ash-Shams 91:9</h1><p class=\"vt ar\" lang=\"ar\">﴿قَدْ أَفْلَحَ مَن زَكَّاهَا﴾</p><section><h3>Meal</h3><p class=\"tr\">Şüphe yok ki, nefsini temizlemiş olan felaha ermiştir.</p><span class=\"cr\" dir=\"ltr\">Turkish Translation - Rowwad Translation Center — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">İki imamın sözleri, kaynaklarıyla birlikte, aslı olan Arapça metinle aynen verilmiştir.</p><section><h2>Şeyhülislam İbn Teymiyye</h2><blockquote class=\"ar\" lang=\"ar\">إثبات لفعل العبد والوعد والوعيد بفلاح من زكى نفسه وخيبة من دساها.<cite>«مجموع الفتاوى» 16/243</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وأما الزكاة فهي متضمنة النماء والزيادة كالزرع وإن كانت الطهارة قد تدخل في معناها؛ فإن الشيء إذا تنظف مما يفسده زكا ونما وصلح وزاد في نفسه كالزرع ينفى من الدغل<cite>«مجموع الفتاوى» 15/387</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">والمفلحون هم الذين أدوا الواجبات وتركوا المحرمات<cite>«مجموع الفتاوى» 15/388</cite></blockquote><h3>Başkalarından naklettikleri</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">بعض المفسرين</span> <span class=\"st\">ردّه</span> «إن الضمير عائد إلى &quot; الله &quot; أي &quot; قد أفلح من زكاها الله وقد خاب من دساها الله &quot;»<cite>«مجموع الفتاوى» 16/231</cite></blockquote></section><section><h2>İmam İbnü&#x27;l-Kayyim</h2><blockquote class=\"ar\" lang=\"ar\">أى تعمل بطاعة الله تعالى، فتصير زاكيا<cite>«إغاثة اللهفان من مصايد الشيطان» 1/50</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">ثم خص بالفلاح من زكاها فنماها وعلاها. ورفعها بآدابه التي أدب بها رسله وأنبياءه وأولياءه. وهي التقوى.<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 2/361</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فالعالم بالحق العامل به هو المنعم عليه، وهو الذي زكى نفسه بالعلم النافع والعمل الصالح، وهو المفلح {قد أفلح من زكاها} [الشمس: 9]<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/34</cite></blockquote><h3>Başkalarından naklettikleri</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الحسن البصري وقتادة</span> <span class=\"st\">حكاه</span> «قد أفلح من زكى نفسه وحملها على طاعة الله وقد خاب من أهلكها وحملها على معصية الله»<cite>«التبيان في أقسام القرآن» 1/21</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الزجاج وغيره</span> <span class=\"st\">حكاه</span> «جواب القسم {قد أفلح من زكاها} ولما طال الكلام حسن حذف اللام من الجواب»<cite>«التبيان في أقسام القرآن» 1/18</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=tr#s91a9\">Etkileşimli tefsirde aç (tam metinler)</a><div class=\"pn\"><a href=\"/tr/ayah/91-8.html\">Önceki âyet (91:8)</a><a href=\"/tr/ayah/91-10.html\">Sonraki âyet (91:10)</a></div></main><footer class=\"site-foot\"><span>Tefsîru&#x27;ş-Şeyhayn · <a href=\"/tr/\">Ana sayfa</a> · <a href=\"/about.html\">Proje hakkında</a> · <a href=\"/privacy.html\">Gizlilik ve şartlar</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/91-10.html":"<!doctype html>\n<html lang=\"tr\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tefsiri: Ash-Shams 91:10 — İbn Teymiyye ve İbnü&#x27;l-Kayyim&#x27;e göre</title>\n<meta name=\"description\" content=\"Onu kötülüklere gömüp kirleten kimse de ziyana uğramıştır.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/tr/ayah/91-10.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/91-10.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/91-10.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/91-10.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/91-10.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/91-10.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/91-10.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/91-10.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/91-10.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/91-10.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/91-10.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/91-10.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/91-10.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/91-10.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/91-10.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/91-10.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/91-10.html\">\n<meta property=\"og:title\" content=\"Tefsiri: Ash-Shams 91:10 — İbn Teymiyye ve İbnü&#x27;l-Kayyim&#x27;e göre\">\n<meta property=\"og:description\" content=\"Onu kötülüklere gömüp kirleten kimse de ziyana uğramıştır.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Ana sayfa\", \"item\": \"https://tafsirshaikhain.com/tr/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sûre Ash-Shams\", \"item\": \"https://tafsirshaikhain.com/tr/surah/91.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Âyet 10\", \"item\": \"https://tafsirshaikhain.com/tr/ayah/91-10.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/tr/\">Ana sayfa</a> › <a href=\"/tr/surah/91.html\">Sûre Ash-Shams</a> › Âyet 10</nav><h1>Tefsiri: Sûre Ash-Shams 91:10</h1><p class=\"vt ar\" lang=\"ar\">﴿وَقَدْ خَابَ مَن دَسَّاهَا﴾</p><section><h3>Meal</h3><p class=\"tr\">Onu kötülüklere gömüp kirleten kimse de ziyana uğramıştır.</p><span class=\"cr\" dir=\"ltr\">Turkish Translation - Rowwad Translation Center — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">İki imamın sözleri, kaynaklarıyla birlikte, aslı olan Arapça metinle aynen verilmiştir.</p><section><h2>Şeyhülislam İbn Teymiyye</h2><blockquote class=\"ar\" lang=\"ar\">فلما عرضت له إرادة الشر طلب دفع ذلك فإنه يفسد القلب كما يفسد الزرع بما ينبت فيه من الدغل ولهذا قال تعالى: {قد أفلح من زكاها} {وقد خاب من دساها}<cite>«مجموع الفتاوى» 10/188</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=tr#s91a10\">Etkileşimli tefsirde aç (tam metinler)</a><div class=\"pn\"><a href=\"/tr/ayah/91-9.html\">Önceki âyet (91:9)</a></div></main><footer class=\"site-foot\"><span>Tefsîru&#x27;ş-Şeyhayn · <a href=\"/tr/\">Ana sayfa</a> · <a href=\"/about.html\">Proje hakkında</a> · <a href=\"/privacy.html\">Gizlilik ve şartlar</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/91.html":"<!doctype html>\n<html lang=\"tr\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tefsiri: Sûre Ash-Shams — İbn Teymiyye ve İbnü&#x27;l-Kayyim&#x27;e göre</title>\n<meta name=\"description\" content=\"Tefsiri: Sûre Ash-Shams — İbn Teymiyye ve İbnü&#x27;l-Kayyim&#x27;in sözleriyle Kur&#x27;an&#x27;ın manaları\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/tr/surah/91.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/surah/91.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/surah/91.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/surah/91.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/surah/91.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/surah/91.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/surah/91.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/surah/91.html\">\n<link rel=\"alternate\" hreflang=\"