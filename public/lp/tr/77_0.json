\": \"ListItem\", \"position\": 2, \"name\": \"Sûre Al-Mursalaat\", \"item\": \"https://tafsirshaikhain.com/tr/surah/77.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Âyet 20\", \"item\": \"https://tafsirshaikhain.com/tr/ayah/77-20.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/tr/\">Ana sayfa</a> › <a href=\"/tr/surah/77.html\">Sûre Al-Mursalaat</a> › Âyet 20</nav><h1>Tefsiri: Sûre Al-Mursalaat 77:20</h1><p class=\"vt ar\" lang=\"ar\">﴿أَلَمْ نَخْلُقكُّم مِّن مَّاءٍ مَّهِينٍ﴾</p><section><h3>Meal</h3><p class=\"tr\">Sizi basit bir sudan yaratmadık mı?</p><span class=\"cr\" dir=\"ltr\">Turkish Translation - Rowwad Translation Center — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">İki imamın sözleri, kaynaklarıyla birlikte, aslı olan Arapça metinle aynen verilmiştir.</p><section><h2>İmam İbnü&#x27;l-Kayyim</h2><blockquote class=\"ar\" lang=\"ar\">فانظر الان الى النطفة بعين البصيرة وهي قطرة من ماء مهين ضعيف مستقذر لو مرت بها ساعة من الزمان فسدت وانتنت<cite>«مفتاح دار السعادة ومنشور ولاية العلم والإرادة» 1/188</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وهذا كثير في القرآن يدعو العبد الى النظر والفكر في مبدأ خلقه ووسطه وآخره إذ نفسه وخلقه من اعظم الدلائل على خالقه وفاطره<cite>«مفتاح دار السعادة ومنشور ولاية العلم والإرادة» 1/188</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=tr#s77a20\">Etkileşimli tefsirde aç (tam metinler)</a><div class=\"pn\"><a href=\"/tr/ayah/77-6.html\">Önceki âyet (77:6)</a><a href=\"/tr/ayah/77-23.html\">Sonraki âyet (77:23)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/77-20.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/77-20.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/77-20.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/77-20.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <b lang=\"tr\">Türkçe</b> · <a href=\"/fr/ayah/77-20.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/77-20.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/77-20.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/77-20.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/77-20.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/77-20.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/77-20.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/77-20.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/77-20.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/77-20.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a></nav>\n<footer class=\"site-foot\"><span>Tefsîru&#x27;ş-Şeyhayn · <a href=\"/tr/\">An