t\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Ana sayfa\", \"item\": \"https://tafsirshaikhain.com/tr/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sûre Ad-Dukhaan\", \"item\": \"https://tafsirshaikhain.com/tr/surah/44.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Âyet 56\", \"item\": \"https://tafsirshaikhain.com/tr/ayah/44-56.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/tr/\">Ana sayfa</a> › <a href=\"/tr/surah/44.html\">Sûre Ad-Dukhaan</a> › Âyet 56</nav><h1>Tefsiri: Sûre Ad-Dukhaan 44:56</h1><p class=\"vt ar\" lang=\"ar\">﴿لَا يَذُوقُونَ فِيهَا الْمَوْتَ إِلَّا الْمَوْتَةَ الْأُولَىٰ وَوَقَاهُمْ عَذَابَ الْجَحِيمِ﴾</p><section><h3>Meal</h3><p class=\"tr\">İlk ölümden başka bir ölüm tatmazlar. Onlar Cehennem azabından korunmuştur.</p><span class=\"cr\" dir=\"ltr\">Turkish Translation - Rowwad Translation Center — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">İki imamın sözleri, kaynaklarıyla birlikte, aslı olan Arapça metinle aynen verilmiştir.</p><section><h2>Şeyhülislam İbn Teymiyye</h2><blockquote class=\"ar\" lang=\"ar\">بل استعمل لفظ الذوق في النفي كما قال عن أهل النار: {لا يذوقون فيها بردا ولا شرابا} أي لا يحصل لهم من ذلك ولا ذوق.<cite>«مجموع الفتاوى» 7/111</cite></blockquote></section><section><h2>İmam İbnü&#x27;l-Kayyim</h2><blockquote class=\"ar\" lang=\"ar\">وأما قوله: {لا يذوقون فيها الموت إلا الموتة الأولى} [الدخان: 56] فهذا الاستثناء هو لتحقيق دوام الحياة وعدم ذوق الموت<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/326</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">قوله تعالى: {لا يذوقون فيها الموت إلا الموتة الأولى} فهذا من الاستثناء السابق زمانه زمان المستثنى منه<cite>«بدائع الفوائد» 3/70</cite></blockquote><h3>Başkalarından naklettikleri</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">بعضهم (إلا بمعنى بعد)</span> <span class=\"st\">أقرّه</span> «(إلا) بمعنى بعد والمعنى لا يذوقون بعد الموتة الأولى موتا في الجنة»<cite>«بدائع الفوائد» 3/70</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=tr#s44a56\">Etkileşimli tefsirde aç (tam metinler)</a><div class=\"pn\"><a href=\"/tr/ayah/44-51.html\">Önceki âyet (44:51)</a><a href=\"/tr/ayah/44-58.html\">Sonraki âyet (44:58)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/44-56.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/44-56.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/44-56.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/44-56.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <b lang=\"tr\">Türkçe</b> · <a href=\"/fr/ayah/44-56.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/44-56.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/44-56.html\" hreflang=\"ms\" lang=\"ms\" data-l=\