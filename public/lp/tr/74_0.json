/tafsirshaikhain.com/zh/ayah/74-47.html\">\n<meta property=\"og:title\" content=\"Tefsiri: Al-Muddaththir 74:47 — İbn Teymiyye ve İbnü&#x27;l-Kayyim&#x27;e göre\">\n<meta property=\"og:description\" content=\"“Nihayet ölüm bize gelip çatıncaya dek.&#x27;&#x27;\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Ana sayfa\", \"item\": \"https://tafsirshaikhain.com/tr/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sûre Al-Muddaththir\", \"item\": \"https://tafsirshaikhain.com/tr/surah/74.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Âyet 47\", \"item\": \"https://tafsirshaikhain.com/tr/ayah/74-47.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/tr/\">Ana sayfa</a> › <a href=\"/tr/surah/74.html\">Sûre Al-Muddaththir</a> › Âyet 47</nav><h1>Tefsiri: Sûre Al-Muddaththir 74:47</h1><p class=\"vt ar\" lang=\"ar\">﴿حَتَّىٰ أَتَانَا الْيَقِينُ﴾</p><section><h3>Meal</h3><p class=\"tr\">“Nihayet ölüm bize gelip çatıncaya dek.&#x27;&#x27;</p><span class=\"cr\" dir=\"ltr\">Turkish Translation - Rowwad Translation Center — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">İki imamın sözleri, kaynaklarıyla birlikte, aslı olan Arapça metinle aynen verilmiştir.</p><section><h2>İmam İbnü&#x27;l-Kayyim</h2><blockquote class=\"ar\" lang=\"ar\">واليقين هاهنا هو الموت بإجماع أهل التفسير<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/124</cite></blockquote><h3>Başkalarından naklettikleri</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">النبي صلى الله عليه وسلم</span> <span class=\"st\">استشهد به</span> «وقال صلى الله عليه وسلم «أما عثمان بن مظعون فقد جاءه اليقين من ربه»»<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/184</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=tr#s74a47\">Etkileşimli tefsirde aç (tam metinler)</a><div class=\"pn\"><a href=\"/tr/ayah/74-38.html\">Önceki âyet (74:38)</a><a href=\"/tr/ayah/74-48.html\">Sonraki âyet (74:48)</a></div></main><footer class=\"site-foot\"><span>Tefsîru&#x27;ş-Şeyhayn · <a href=\"/tr/\">Ana sayfa</a> · <a href=\"/about.html\">Proje hakkında</a> · <a href=\"/privacy.html\">Gizlilik ve şartlar</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/74-48.html":"<!doctype html>\n<html lang=\"tr\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tefsiri: Al-Muddaththir 74:48 — İbn Teymiyye ve İbnü&#x27;l-Kayyim&#x27;e göre</title>\n<meta name=\"description\" content=\"Artık şefaat edenlerin şefaatleri onlara yarar sağlamaz.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/tr/ayah/74-48.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/74-48.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/74-48.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/74-48.html\">\n<link rel=\"alternate\" hreflang=