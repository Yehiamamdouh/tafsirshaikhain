\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/tr/\">Ana sayfa</a> › <a href=\"/tr/surah/93.html\">Sûre Ad-Dhuhaa</a> › Âyet 3</nav><h1>Tefsiri: Sûre Ad-Dhuhaa 93:3</h1><p class=\"vt ar\" lang=\"ar\">﴿مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ﴾</p><section><h3>Meal</h3><p class=\"tr\">Rabbin ne seni terk etti, ne de sana darıldı.</p><span class=\"cr\" dir=\"ltr\">Turkish Translation - Rowwad Translation Center — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">İki imamın sözleri, kaynaklarıyla birlikte, aslı olan Arapça metinle aynen verilmiştir.</p><section><h2>Şeyhülislam İbn Teymiyye</h2><blockquote class=\"ar\" lang=\"ar\">والرسول هو الذي أنزل عليه القرآن والخطاب في هذه السور له كقوله {ما ودعك ربك وما قلى} وقوله {ألم نشرح لك صدرك} وقوله {اقرأ باسم ربك} .<cite>«مجموع الفتاوى» 16/284</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=tr#s93a3\">Etkileşimli tefsirde aç (tam metinler)</a><div class=\"pn\"><a href=\"/tr/ayah/93-1.html\">Önceki âyet (93:1)</a><a href=\"/tr/ayah/93-6.html\">Sonraki âyet (93:6)</a></div></main><footer class=\"site-foot\"><span>Tefsîru&#x27;ş-Şeyhayn · <a href=\"/tr/\">Ana sayfa</a> · <a href=\"/about.html\">Proje hakkında</a> · <a href=\"/privacy.html\">Gizlilik ve şartlar</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/93-6.html":"<!doctype html>\n<html lang=\"tr\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tefsiri: Ad-Dhuhaa 93:6 — İbn Teymiyye ve İbnü&#x27;l-Kayyim&#x27;e göre</title>\n<meta name=\"description\" content=\"Seni bir yetim olarak bulup barındırmadı mı?\"