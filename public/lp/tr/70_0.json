\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/tr/\">Ana sayfa</a> › <a href=\"/tr/surah/70.html\">Sûre Al-Ma&#x27;aarij</a> › Âyet 22</nav><h1>Tefsiri: Sûre Al-Ma&#x27;aarij 70:22</h1><p class=\"vt ar\" lang=\"ar\">﴿إِلَّا الْمُصَلِّينَ﴾</p><section><h3>Meal</h3><p class=\"tr\">Ancak namaz kılanlar müstesna.</p><span class=\"cr\" dir=\"ltr\">Turkish Translation - Rowwad Translation Center — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">İki imamın sözleri, kaynaklarıyla birlikte, aslı olan Arapça metinle aynen verilmiştir.</p><section><h2>İmam İbnü&#x27;l-Kayyim</h2><blockquote class=\"ar\" lang=\"ar\">وإن من كان على غيرها فلأجل ما زكاه الله به من فضله وإحسانه.<cite>«طريق الهجرتين وباب السعادتين» 1/107</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=tr#s70a22\">Etkileşimli tefsirde aç (tam metinler)</a><div class=\"pn\"><a href=\"/tr/ayah/70-19.html\">Önceki âyet (70:19)</a><a href=\"/tr/ayah/70-23.html\">Sonraki âyet (70:23)</a></div></main><footer class=\"site-foot\"><span>Tefsîru&#x27;ş-Şeyhayn · <a href=\"/tr/\">Ana sayfa</a> · <a href=\"/about.html\">Proje hakkında</a> · <a href=\"/privacy.html\">Gizlilik ve şartlar</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/70-23.html":"<!doctype html>\n<html lang=\"tr\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tefsiri: Al-Ma&#x27;aarij 70:23 — İbn Teymiyye ve İbnü&#x27;l-Kayyim&#x27;e göre</title>\n<meta name=\"description\" content=\"Onlar ki, namazlarını devamlı kılarlar.\">\n<link rel=\"canonical\" hre