ersonalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/tr/\">Ana sayfa</a> › <a href=\"/tr/surah/21.html\">Sûre Al-Anbiyaa</a> › Âyet 104</nav><h1>Tefsiri: Sûre Al-Anbiyaa 21:104</h1><p class=\"vt ar\" lang=\"ar\">﴿يَوْمَ نَطْوِي السَّمَاءَ كَطَيِّ السِّجِلِّ لِلْكُتُبِ كَمَا بَدَأْنَا أَوَّلَ خَلْقٍ نُّعِيدُهُ وَعْدًا عَلَيْنَا إِنَّا كُنَّا فَاعِلِينَ﴾</p><section><h3>Meal</h3><p class=\"tr\">Gökleri kitap sayfalarının katlandığı gibi katlayacağımız günü düşün. Başlangıçta ilk yaratmayı nasıl yaptıysak, -üzerimize aldığımız bir vaad olarak- onu yine yapacağız. Biz bunu muhakkak yapacağız.</p><span class=\"cr\" dir=\"ltr\">Turkish Translation - Rowwad Translation Center — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">İki imamın sözleri, kaynaklarıyla birlikte, aslı olan Arapça metinle aynen verilmiştir.</p><section><h2>Şeyhülislam İbn Teymiyye</h2><blockquote class=\"ar\" lang=\"ar\">ومن المعلوم أنه لم يتعقب الإعادة عدمه، كما لم يتقدم ابتداء خلق السموات والأرض العدم المطلق<cite>«بيان تلبيس الجهمية في تأسيس بدعهم الكلامية» 1/464</cite></blockquote></section><section><h2>İmam İbnü&#x27;l-Kayyim</h2><blockquote class=\"ar\" lang=\"ar\">والسجل: الورق المكتوب فيه، والكتاب: نفس المكتوب<cite>«إعلام الموقعين عن رب العالمين» 1/114</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=tr#s21a104\">Etkileşimli tefsirde aç (tam metinler)</a><div class=\"pn\"><a href=\"/tr/ayah/21-101.html\">Önceki âyet (21:101)</a><a href=\"/tr/ayah/21-105.html\">Sonraki âyet (21:105)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/21-104.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/21-104.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/21-104.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/21-104.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <b lan