: {\"@type\": \"WebSite\", \"name\": \"Tefsîru'ş-Şeyhayn\", \"url\": \"https://tafsirshaikhain.com/tr/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Ana sayfa\", \"item\": \"https://tafsirshaikhain.com/tr/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sûre At-Taariq\", \"item\": \"https://tafsirshaikhain.com/tr/surah/86.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Âyet 8\", \"item\": \"https://tafsirshaikhain.com/tr/ayah/86-8.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/tr/\">Ana sayfa</a> › <a href=\"/tr/surah/86.html\">Sûre At-Taariq</a> › Âyet 8</nav><h1>Tefsiri: Sûre At-Taariq 86:8</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّهُ عَلَىٰ رَجْعِهِ لَقَادِرٌ﴾</p><section><h3>Meal</h3><p class=\"tr\">Şüphesiz Allah’ın onu, öldükten sonra tekrar diriltmeye de gücü yeter.</p><span class=\"cr\" dir=\"ltr\">Turkish Translation - Rowwad Translation Center — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">İki imamın sözleri, kaynaklarıyla birlikte, aslı olan Arapça metinle aynen verilmiştir.</p><section><h2>İmam İbnü&#x27;l-Kayyim</h2><blockquote class=\"ar\" lang=\"ar\">وقوله: {إنه على رجعه لقادر} [الطارق: 8] الصحيح أن الضمير يرجع على الإنسان، أي إن الله على رده إليه لقادر يوم القيامة، وهو اليوم الذي يبلى فيه السرائر، ومن قال: &quot; إن الضمير يرجع على الماء أي أن الله على رجعه في الإحليل أو في الصدر أو حبسه عن الخروج لقادر &quot; فقد أبعد، وإن كان الله سبحانه قادرا على ذلك، ولكن السياق يأباه، وطريقة القرآن - وهي الاستدلال بالمبدإ والنشأة الأولى على المعاد والرجوع إليه - وأيضا فإنه قيده بالظرف، وهو {يوم تبلى السرائر} [الطارق: 9]<cite>«إعلام الموقعين عن رب العالمين» 1/113</cite></blockquote><h3>Başkalarından naklettikleri</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">من قال</span> <span class=\"st\">ردّه</span> «إن الضمير يرجع على الماء أي أن الله على رجعه في الإحليل أو في الصدر أو حبسه عن الخروج لقادر»<cite>«إعلام الموقعين عن رب العالمين» 1/113</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=tr#s86a8\">Etkileşimli tefsirde aç (tam metinler)</a><div class=\"pn\"><a href=\"/tr/ayah/86-7.html\">Önceki âyet (86:7)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/86-8.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/86-8.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/86-8.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/86-8.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <b lang=\"tr\">Türkçe</b> · <a href=\"/fr/ayah/86-8.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/86-8.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/86-8.html\" hreflang=\"ms\" lang=\"ms\"