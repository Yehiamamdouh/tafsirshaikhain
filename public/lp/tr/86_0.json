tml\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/tr/\">Ana sayfa</a> › <a href=\"/tr/surah/86.html\">Sûre At-Taariq</a> › Âyet 7</nav><h1>Tefsiri: Sûre At-Taariq 86:7</h1><p class=\"vt ar\" lang=\"ar\">﴿يَخْرُجُ مِن بَيْنِ الصُّلْبِ وَالتَّرَائِبِ﴾</p><section><h3>Meal</h3><p class=\"tr\">Bu su, bel ile kaburga kemikleri arasından çıkar.</p><span class=\"cr\" dir=\"ltr\">Turkish Translation - Rowwad Translation Center — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">İki imamın sözleri, kaynaklarıyla birlikte, aslı olan Arapça metinle aynen verilmiştir.</p><section><h2>İmam İbnü&#x27;l-Kayyim</h2><blockquote class=\"ar\" lang=\"ar\">والأول أظهر؛ لأنه سبحانه قال: {يخرج من بين الصلب والترائب} [الطارق: 7] ولم يقل يخرج من الصلب والترائب فلا بد أن يكون ماء الرجل خارجا من بين هذين المختلفين<cite>«إعلام الموقعين عن رب العالمين» 1/113</cite></blockquote><h3>Başkalarından naklettikleri</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">قيل</span> <span class=\"st\">أقرّه</span> «المراد بها ترائبه أيضا، وهي عظام الصدر ما بين الترقوة إلى الثندوة»<cite>«إعلام الموقعين عن رب العالمين» 1/113</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">قيل</span> <span class=\"st\">رجّح غيره</span> «المراد ترائب المرأة»<cite>«إعلام الموقعين عن رب العالمين» 1/113</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=tr#s86a7\">Etkileşimli tefsirde aç (tam metinler)</a><div class=\"pn\"><a href=\"/tr/ayah/86-4.html\">Önceki âyet (86:4)</a><a href=\"/tr/ayah/86-8.html\">Sonraki âyet (86:8)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/86-7.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/86-7.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/86-7.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/86-7.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <b lang=\"tr\">Türkçe</b> · <a href=\"/fr/ayah/86-7.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/86-7.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/86-7.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/86-7.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/86-7.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/86-7.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/86-7.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/86-7.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/86-7.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/86-7.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a></nav>\n<footer class=\"site-foot\"><span>Tefsîru&#x27;ş-Şeyhayn · <a href=\"/tr/\">Ana sa