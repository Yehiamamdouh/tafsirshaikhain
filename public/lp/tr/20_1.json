\": 2, \"name\": \"Sûre Taa-Haa\", \"item\": \"https://tafsirshaikhain.com/tr/surah/20.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Âyet 74\", \"item\": \"https://tafsirshaikhain.com/tr/ayah/20-74.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/tr/\">Ana sayfa</a> › <a href=\"/tr/surah/20.html\">Sûre Taa-Haa</a> › Âyet 74</nav><h1>Tefsiri: Sûre Taa-Haa 20:74</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّهُ مَن يَأْتِ رَبَّهُ مُجْرِمًا فَإِنَّ لَهُ جَهَنَّمَ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ﴾</p><section><h3>Meal</h3><p class=\"tr\">Gerçek şu ki, kim Rabbine günahkâr olarak gelirse onun için cehennem vardır. Orada ne ölür, ne de (güzel bir hayat) yaşar.</p><span class=\"cr\" dir=\"ltr\">Turkish Translation - Rowwad Translation Center — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">İki imamın sözleri, kaynaklarıyla birlikte, aslı olan Arapça metinle aynen verilmiştir.</p><section><h2>Şeyhülislam İbn Teymiyye</h2><blockquote class=\"ar\" lang=\"ar\">ونظيره قوله تعالى {إنه من يأت ربه مجرما فإن له جهنم لا يموت فيها ولا يحيا} ونظيره: {أنه من عمل منكم سوءا بجهالة ثم تاب من بعده وأصلح فأنه غفور رحيم} فهما تأكيدان مقصودان لمعنيين مختلفين<cite>«مجموع الفتاوى» 15/277</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=tr#s20a74\">Etkileşimli tefsirde aç (tam metinler)</a><div class=\"pn\"><a href=\"/tr/ayah/20-71.htm