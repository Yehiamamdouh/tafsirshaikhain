": \"ListItem\", \"position\": 2, \"name\": \"Sûre Ash-Shu'araa\", \"item\": \"https://tafsirshaikhain.com/tr/surah/26.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Âyet 197\", \"item\": \"https://tafsirshaikhain.com/tr/ayah/26-197.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/tr/\">Ana sayfa</a> › <a href=\"/tr/surah/26.html\">Sûre Ash-Shu&#x27;araa</a> › Âyet 197</nav><h1>Tefsiri: Sûre Ash-Shu&#x27;araa 26:197</h1><p class=\"vt ar\" lang=\"ar\">﴿أَوَلَمْ يَكُن لَّهُمْ آيَةً أَن يَعْلَمَهُ عُلَمَاءُ بَنِي إِسْرَائِيلَ﴾</p><section><h3>Meal</h3><p class=\"tr\">İsrail oğulları bilginlerinin onu bilmesi, onlar için ispatlayıcı bir delil (ayet) değil midir?</p><span class=\"cr\" dir=\"ltr\">Turkish Translation - Rowwad Translation Center — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">İki imamın sözleri, kaynaklarıyla birlikte, aslı olan Arapça metinle aynen verilmiştir.</p><section><h2>Şeyhülislam İbn Teymiyye</h2><blockquote class=\"ar\" lang=\"ar\">وهذا غير شهادة أهل الكتاب له نفسه بما يجدونه من نعته في كتبهم كقوله تعالى: {أولم يكن لهم آية أن يعلمه علماء بني إسرائيل} وقوله تعالى {والذين آتيناهم الكتاب يعلمون أنه منزل من ربك بالحق} وأمثال ذلك.<cite>«مجموع الفتاوى» 19/12</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">إلى أمثال ذلك مما يخاطبهم باستفهام التقرير المتضمن إقرارهم واعترافهم بالمقدمات البرهانية التي تدل على المطلوب فهو من أحسن جدل بالبرهان؛<cite>«مجموع الفتاوى» 19/165</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=tr#s26a197\">Etkileşimli tefsirde aç (tam metinler)</a><div class=\"pn\"><a href=\"/tr/ayah/26-196.html\">Önceki âyet (26:196)</a><a href=\"/tr/ayah/26-200.html\">Sonraki âyet (26:200)</a></div></main><footer class=\"site-foot\"><span>Tefsîru&#x27;ş-Şeyhayn · <a href=\"/tr/\">Ana sayfa</a> · <a href=\"/about.html\">Proje hakkında</a> · <a href=\"/privacy.html\">Gizlilik ve şartlar</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}