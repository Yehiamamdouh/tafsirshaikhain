.com/es/ayah/7-206.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/7-206.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/7-206.html\">\n<meta property=\"og:title\" content=\"Tefsiri: Al-A&#x27;raaf 7:206 — İbn Teymiyye ve İbnü&#x27;l-Kayyim&#x27;e göre\">\n<meta property=\"og:description\" content=\"Doğrusu Rabbinin katında olanlar, O&#x27;na ibadet etmekten büyüklenmezler, O&#x27;nu tenzih ederler ve yalnız O&#x27;na secde ederler\">\n<meta property=\"og:url\" content=\"https://tafsirshaikhain.com/tr/ayah/7-206.html\">\n<meta property=\"og:site_name\" content=\"Tefsîru&#x27;ş-Şeyhayn\">\n<meta property=\"og:locale\" content=\"tr_TR\">\n<meta property=\"og:type\" content=\"article\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta property=\"og:image:width\" content=\"1200\">\n<meta property=\"og:image:height\" content=\"630\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<link rel=\"manifest\" href=\"/manifest.webmanifest\">\n<link rel=\"apple-touch-icon\" href=\"/icon-192.png\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"Tefsiri: Al-A'raaf 7:206 — İbn Teymiyye ve İbnü'l-Kayyim'e göre\", \"description\": \"Doğrusu Rabbinin katında olanlar, O'na ibadet etmekten büyüklenmezler, O'nu tenzih ederler ve yalnız O'na secde ederler\", \"inLanguage\": \"tr\", \"url\": \"https://tafsirshaikhain.com/tr/ayah/7-206.html\", \"mainEntityOfPage\": \"https://tafsirshaikhain.com/tr/ayah/7-206.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"Şeyhülislam İbn Teymiyye\"}, {\"@type\": \"Person\", \"name\": \"İmam İbnü'l-Kayyim\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"Tefsîru'ş-Şeyhayn\", \"url\": \"https://tafsirshaikhain.com/tr/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Ana sayfa\", \"item\": \"https://tafsirshaikhain.com/tr/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sûre Al-A'raaf\", \"item\": \"https://tafsirshaikhain.com/tr/surah/7.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Âyet 206\", \"item\": \"https://tafsirshaikhain.com/tr/ayah/7-206.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/tr/\">Ana sayfa</a> › <a href=\"/tr/surah/7.html\">Sûre Al-A&#x27;raaf</a> › Âyet 206</nav><h1>Tefsiri: Sûre Al-A&#x27;raaf 7:206</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّ الَّذِينَ عِندَ رَبِّكَ لَا يَسْتَكْبِرُونَ عَنْ عِبَادَتِهِ وَيُسَبِّحُونَهُ وَلَهُ يَسْجُدُونَ﴾</p><section><h3>Meal</h3><p class=\"tr\">Doğrusu Rabbinin katında olanlar, O&#x27;na ibadet etmekten büyüklenmezler, O&#x27;nu tenzih ederler ve yalnız O&#x27;na secde ederler</p><span class=\"cr\" dir=\"ltr\">Turkish Translation - Rowwad Translation Center — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">İki imamın sözleri, kaynaklarıyla birlikte, aslı olan Arapça metinle aynen verilmiştir.</p><section><h2>Şeyhülislam İbn Teymiyye</h2><blockquote class=\"ar\" lang=\"ar\">وهذا ونحوه مما فيه وصف أكابر المخلوقات بالعبادة وذم من خرج عن ذلك متعدد في القرآن<cite>«مجموع الفتاوى» 10/177</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فلو كان موجب العندية معنى عاما كدخولهم تحت قدرته ومشيئته وأمثال ذلك: لكان كل مخلوق عنده؛ ولم يكن أحد مستكبرا عن عبادته بل مسبحا له ساجدا<cite>«مجموع الفتاوى» 5/165</cite></blockquote></section><section><h2>İmam İbnü&#x27;l-Kayyim</h2><blockquote class=\"ar\" lang=\"ar\">ففرق بين من له عموما ومن عنده من مماليكه وعبيده خصوصا،<cite>«إعلام الموقعين عن رب العالمين» 2/215</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=tr#s7a206\">Etkileşimli tefsirde aç (tam metinler)</a><div class=\"pn\"><a href=\"/tr/ayah/7-205.html\">Önceki âyet (7:205)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/7-206.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/7-206.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/7-206.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/7-206.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <b lang=\"tr\">Türkçe</b> · <a href=\"/fr/ayah/7-206.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/7-206.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/7-206.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/7-206.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/7-206.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/7-206.html\