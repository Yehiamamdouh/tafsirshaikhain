ush(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/tr/\">Ana sayfa</a> › <a href=\"/tr/surah/7.html\">Sûre Al-A&#x27;raaf</a> › Âyet 204</nav><h1>Tefsiri: Sûre Al-A&#x27;raaf 7:204</h1><p class=\"vt ar\" lang=\"ar\">﴿وَإِذَا قُرِئَ الْقُرْآنُ فَاسْتَمِعُوا لَهُ وَأَنصِتُوا لَعَلَّكُمْ تُرْحَمُونَ﴾</p><section><h3>Meal</h3><p class=\"tr\">Kur’an okunduğu zaman ona kulak verip dinleyin ve susun ki, merhamet olunasınız.</p><span class=\"cr\" dir=\"ltr\">Turkish Translation - Rowwad Translation Center — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">İki imamın sözleri, kaynaklarıyla birlikte, aslı olan Arapça metinle aynen verilmiştir.</p><section><h2>Şeyhülislam İbn Teymiyye</h2><blockquote class=\"ar\" lang=\"ar\">فقد أمر الله ورسوله بالإنصات للإمام إذا قرأ وجعل النبي صلى الله عليه وسلم ذلك من جملة الائتمام به فمن لم ينصت له لم يكن قد ائتم به<cite>«مجموع الفتاوى» 22/295</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=tr#s7a204\">Etkileşimli tefsirde aç (tam metinler)</a><div class=\"pn\"><a href=\"/tr/ayah/7-201.html\">Önceki âyet (7:201)</a><a href=\"/tr/ayah/7-205.html\">Sonraki âyet (7:205)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/7-204.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/7-204.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/7-204.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/7-204.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <b lang=\"tr\">Türkçe</b> · <a href=\"/fr/ayah/7-204.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/7-204.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/7-204.html\" hreflang=\"ms\" lang=\"ms\" data-l=