ontent=\"630\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<link rel=\"manifest\" href=\"/manifest.webmanifest\">\n<link rel=\"apple-touch-icon\" href=\"/icon-192.png\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"Tefsiri: Al-A'raaf 7:205 — İbn Teymiyye ve İbnü'l-Kayyim'e göre\", \"description\": \"Rabbini, içinden yalvararak ve korkarak, yüksek olmayan bir sesle sabah-akşam zikret ve gafillerden olma!\", \"inLanguage\": \"tr\", \"url\": \"https://tafsirshaikhain.com/tr/ayah/7-205.html\", \"mainEntityOfPage\": \"https://tafsirshaikhain.com/tr/ayah/7-205.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"Şeyhülislam İbn Teymiyye\"}, {\"@type\": \"Person\", \"name\": \"İmam İbnü'l-Kayyim\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"Tefsîru'ş-Şeyhayn\", \"url\": \"https://tafsirshaikhain.com/tr/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Ana sayfa\", \"item\": \"https://tafsirshaikhain.com/tr/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sûre Al-A'raaf\", \"item\": \"https://tafsirshaikhain.com/tr/surah/7.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Âyet 205\", \"item\": \"https://tafsirshaikhain.com/tr/ayah/7-205.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/tr/\">Ana sayfa</a> › <a href=\"/tr/surah/7.html\">Sûre Al-A&#x27;raaf</a> › Âyet 205</nav><h1>Tefsiri: Sûre Al-A&#x27;raaf 7:205</h1><p class=\"vt ar\" lang=\"ar\">﴿وَاذْكُر رَّبَّكَ فِي نَفْسِكَ تَضَرُّعًا وَخِيفَةً وَدُونَ الْجَهْرِ مِنَ الْقَوْلِ بِالْغُدُوِّ وَالْآصَالِ وَلَا تَكُن مِّنَ الْغَافِلِينَ﴾</p><section><h3>Meal</h3><p class=\"tr\">Rabbini, içinden yalvararak ve korkarak, yüksek olmayan bir sesle sabah-akşam zikret ve gafillerden olma!</p><span class=\"cr\" dir=\"ltr\">Turkish Translation - Rowwad Translation Center — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">İki imamın sözleri, kaynaklarıyla birlikte, aslı olan Arapça metinle aynen verilmiştir.</p><section><h2>Şeyhülislam İbn Teymiyye</h2><blockquote class=\"ar\" lang=\"ar\">ونظير قوله: {واذكر ربك في نفسك} قوله صلى الله عليه وسلم فيما روى عن ربه &quot; {من ذكرني في نفسه ذكرته في نفسي. ومن ذكرني في ملأ ذكرته في ملأ خير منه} &quot; وهذا يدخل فيه ذكره باللسان في نفسه فإنه جعله قسيم الذكر في الملأ وهو نظير قوله: {ودون الجهر من القول}<cite>«مجموع الفتاوى» 15/34</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فإن الجهر هو الإظهار الشديد يقال: رجل جهوري الصوت ورجل جهير.<cite>«مجموع الفتاوى» 15/34</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">ومعلوم أن ذكر الله المشروع بالغدو والآصال في الصلاة وخارج الصلاة هو باللسان مع القلب مثل صلاتي الفجر والعصر والذكر المشروع عقب الصلاتين<cite>«مجموع الفتاوى» 15/34</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=tr#s7a205\">Etkileşimli tefsirde aç (tam metinler)</a><div class=\"pn\"><a href=\"/tr/ayah/7-204.html\">Önceki âyet (7:204)</a><a href=\"/tr/ayah/7-206.html\">Sonraki âyet (7:206)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/7-205.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/7-205.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/7-205.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/7-205.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <b lang=\"tr\">Türkçe</b> · <a href=\"/fr/ayah/7-205.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/7-205.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/7-205.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/7-205.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/7-205.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/7-205.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/7-205.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/7-205.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/7-205.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/7-205.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a></nav>\n<footer class=\"site-foot\"><span>Tefsîru&#x27;ş-Şeyhayn · <a href=\"/tr/\">Ana sayfa</a> · <a href=\"/about.html\">Proje hakkında</a> · <a href=\"/privacy.html\">Gizlilik ve şartlar</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n<script>try{localStorage.setItem(\"lang\",\"tr\")}catch(e){}document.addEventListener(\"click\",function(e){var a=e.target.closest&&