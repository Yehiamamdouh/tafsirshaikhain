ly=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/tr/\">Ana sayfa</a> › <a href=\"/tr/surah/109.html\">Sûre Al-Kaafiroon</a> › Âyet 6</nav><h1>Tefsiri: Sûre Al-Kaafiroon 109:6</h1><p class=\"vt ar\" lang=\"ar\">﴿لَكُمْ دِينُكُمْ وَلِيَ دِينِ﴾</p><section><h3>Meal</h3><p class=\"tr\">Sizin dininiz size, benim dinim ise banadır.</p><span class=\"cr\" dir=\"ltr\">Turkish Translation - Rowwad Translation Center — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">İki imamın sözleri, kaynaklarıyla birlikte, aslı olan Arapça metinle aynen verilmiştir.</p><section><h2>Şeyhülislam İbn Teymiyye</h2><blockquote class=\"ar\" lang=\"ar\">{لكم دينكم ولي دين} خطاب لكل كافر وإن أسلم فيما بعد.<cite>«مجموع الفتاوى» 16/543</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وبهذا يظهر خطأ من قال إنه خطاب للمشركين والنصارى دون اليهود<cite>«مجموع الفتاوى» 16/564</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=tr#s109a6\">Etkileşimli tefsirde aç (tam metinler)</a><div class=\"pn\"><a href=\"/tr/ayah/109-5.html\">Önceki âyet (109:5)</a></div></main><footer class=\"site-foot\"><span>Tefsîru&#x27;ş-Şeyhayn · <a href=\"/tr/\">Ana sayfa</a> · <a href=\"/about.html\">Proje hakkında</a> · <a href=\"/privacy.html\">Gizlilik ve şartlar</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/109.html":"<!doctype html>\n<html lang=\"tr\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tefsiri: Sûre Al-Kaafiroo