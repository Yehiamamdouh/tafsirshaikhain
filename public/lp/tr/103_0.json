, \"item\": \"https://tafsirshaikhain.com/tr/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sûre Al-Asr\", \"item\": \"https://tafsirshaikhain.com/tr/surah/103.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Âyet 3\", \"item\": \"https://tafsirshaikhain.com/tr/ayah/103-3.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/tr/\">Ana sayfa</a> › <a href=\"/tr/surah/103.html\">Sûre Al-Asr</a> › Âyet 3</nav><h1>Tefsiri: Sûre Al-Asr 103:3</h1><p class=\"vt ar\" lang=\"ar\">﴿إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَتَوَاصَوْا بِالْحَقِّ وَتَوَاصَوْا بِالصَّبْرِ﴾</p><section><h3>Meal</h3><p class=\"tr\">Ancak iman edenler ve salih amel yapanlar, birbirlerine hakkı ve sabrı tavsiye edenler müstesna.</p><span class=\"cr\" dir=\"ltr\">Turkish Translation - Rowwad Translation Center — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">İki imamın sözleri, kaynaklarıyla birlikte, aslı olan Arapça metinle aynen verilmiştir.</p><section><h2>Şeyhülislam İbn Teymiyye</h2><h3>Başkalarından naklettikleri</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الإمام الشافعي</span> <span class=\"st\">استشهد به</span> «لو فكر الناس كلهم في سورة (والعصر لكفت»<cite>«مجموع الفتاوى» 28/152</cite></blockquote></section><section><h2>İmam İbnü&#x27;l-Kayyim</h2><blockquote class=\"ar\" lang=\"ar\">ولما كان الإنسان له قوتان قوة العلم وقوة العمل<cite>«التبيان في أقسام القرآن» 1/86</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فإن التواصي هو امر الغير بالإيمان والعمل الصالح وهو قدر زائد على مجرد فعله<cite>«التبيان في أقسام القرآن» 1/85</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">استثنى سبحانه من كمل قوته العلمية بالإيمان وقوته العملية بالعمل الصالح وإنقاد لأمر غيره له بذلك وأمر غيره به من الانسان الذي هو في خسر<cite>«التبيان في أقسام القرآن» 1/86</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=tr#s103a3\">Etkileşimli tefsirde aç (tam metinler)</a><div class=\"pn\"><a href=\"/tr/ayah/103-2.html\">Önceki âyet (103:2)</a></div></main><footer class=\"site-foot\"><span>Tefsîru&#x27;ş-Şeyhayn · <a href=\"/tr/\">Ana sayfa</a> · <a href=\"/about.html\">Proje hakkında</a> · <a href=\"/privacy.html\">Gizlilik ve şartlar</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/103.html":"<!doctype html>\n<html lang=\"tr\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tefsiri: Sûre Al-Asr — İbn Teymiyye ve İbnü&#x27;l-Kayyim&#x27;e göre</title>\n<meta name=\"description\" content=\"Tefsiri: Sûre Al-Asr — İbn Teymiyye ve İbnü&#x27;l-Kayyim&#x27;in sözleriyle Kur&#x27;an&#x27;ın manaları\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/tr/surah/103.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/surah/103.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/surah/103.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/surah/103.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/surah/103.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/surah/103.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirs