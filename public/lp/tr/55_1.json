type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Ana sayfa\", \"item\": \"https://tafsirshaikhain.com/tr/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sûre Ar-Rahmaan\", \"item\": \"https://tafsirshaikhain.com/tr/surah/55.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Âyet 60\", \"item\": \"https://tafsirshaikhain.com/tr/ayah/55-60.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/tr/\">Ana sayfa</a> › <a href=\"/tr/surah/55.html\">Sûre Ar-Rahmaan</a> › Âyet 60</nav><h1>Tefsiri: Sûre Ar-Rahmaan 55:60</h1><p class=\"vt ar\" lang=\"ar\">﴿هَلْ جَزَاءُ الْإِحْسَانِ إِلَّا الْإِحْسَانُ﴾</p><section><h3>Meal</h3><p class=\"tr\">İyiliğin karşılığı iyilikten başkası olabilir mi?</p><span class=\"cr\" dir=\"ltr\">Turkish Translation - Rowwad Translation Center — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">İki imamın sözleri, kaynaklarıyla birlikte, aslı olan Arapça metinle aynen verilmiştir.</p><section><h2>İmam İbnü&#x27;l-Kayyim</h2><blockquote class=\"ar\" lang=\"ar\">يعني هل جزاء من أحسن عبادة ربه إلا أن يحسن ربه إليه<cite>«بدائع الفوائد» 3/18</cite></blockquote><h3>Başkalarından naklettikleri</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن عباس</span> <span class=\"st\">أقرّه</span> «قال ابن عباس: &quot;هل جزاء من قال لا إله إلا الله وعمل بما جاء به محمد إلا الجنة&quot;»<cite>«بدائع الفوائد» 3/18</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">النبي صلى الله عليه وسلم</span> <span class=\"st\">استشهد به</span> «قال: &quot;قرأ رسول الله {هل جزاء الإحسان إلا الإحسان} ثم قال: هل تدرون ما قال ربكم؟ قالوا الله ورسوله أعلم قال: يقول هل جزاء من أنعمت عليه بالتوحيد إلا الجنة &quot;.»<cite>«بدائع الفوائد» 3/18</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=tr#s55a60\">Etkileşimli tefsirde aç (tam metinler)</a><div class=\"pn\"><a href=\"/tr/ayah/55-58.html\">Önceki âyet (55:58)</a><a href=\"/tr/ayah/55-68.html\">Sonraki âyet (55:68)</a></div></main><footer class=\"site-foot\"><span>Tefsîru&#x27;ş-Şeyhayn · <a href=\"/tr/\">Ana sayfa</a> · <a href=\"/about.html\">Proje hakkında</a> · <a href=\"/privacy.html\">Gizlilik ve şartlar</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/55-68.html":"<!doctype html>\n<html lang=\"tr\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tefsiri: Ar-Rahmaan 55:68 — İbn Teymiyye ve İbnü&#x27;l-Kayyim&#x27;e göre</title>\n<meta name=\"description\" content=\"Her ikisinde de meyve, hurma ve nar vardır.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/tr/ayah/55-68.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/55-68.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/55-68.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/55-68.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/55-68.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/55-68.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/55-68.html\">\n<link