t-size:12px;color:var(--muted,#5b6676);overflow-wrap:anywhere}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/hi/\">मुखपृष्ठ</a> › <a href=\"/hi/surah/41.html\">सूरह Fussilat</a> › आयत 50</nav><h1>तफ़सीर: सूरह Fussilat 41:50</h1><p class=\"vt ar\" lang=\"ar\">﴿وَلَئِنْ أَذَقْنَاهُ رَحْمَةً مِّنَّا مِن بَعْدِ ضَرَّاءَ مَسَّتْهُ لَيَقُولَنَّ هَٰذَا لِي وَمَا أَظُنُّ السَّاعَةَ قَائِمَةً وَلَئِن رُّجِعْتُ إِلَىٰ رَبِّي إِنَّ لِي عِندَهُ لَلْحُسْنَىٰ فَلَنُنَبِّئَنَّ الَّذِينَ كَفَرُوا بِمَا عَمِلُوا وَلَنُذِيقَنَّهُم مِّنْ عَذَابٍ غَلِيظٍ﴾</p><section><h3>अर्थ का अनुवाद</h3><p class=\"tr\">और निश्चय यदि हम उसे, किसी तकलीफ़ के पश्चात् जो उसे पहुँची हो, अपनी रहमत का मज़ा चखाएँ, तो अवश्य कहेगा : यह मेरा हक़ है, और मैं नहीं समझता कि क़ियामत आने वाली है, और यदि मैं अपने पालनहार की ओर लौटाया गया, तो निश्चय ही मेरे लिए उसके पास अवश्य भलाई है। अतः हम निश्चय उन लोगों को जिन्होंने कुफ़्र किया अवश्य बता देंगे जो कुछ उन्होंने किया, तथा निश्चय हम उन्हें एक कठिन यातना अवश्य चखाएँगे।</p><span class=\"cr\" dir=\"ltr\">Hindi Translation - Azizul Haq Al-Omari — v1.1.5 · QuranEnc.com</span></section><p class=\"cr\">दोनों इमामों के शब्द मूल अरबी में, ज्यों के त्यों, हवालों के साथ दिए गए हैं।</p><section><h2>इमाम इब्नुल क़य्यिम</h2><blockquote class=\"ar\" lang=\"ar\">واعظم الناس غرورا بربه من إذا مسه الله برحمة منه وفضل قال هذا لي أي أنا أهله وجدير به ومستحق له ثم قال {وما أظن الساعة قائمة} فظن أنه أهل لما أولاه من النعم مع كفره بالله<cite>«الروح في الكلام على أرواح الأموات والأحياء بالدلائل من الكتاب والسنة» 1/245</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">ثم زاد في غروره فقال {ولئن رجعت إلى ربي إن لي عنده للحسنى} يعني الجنة والكرامة<cite>«الروح في الكلام على أرواح الأموات والأحياء بالدلائل من الكتاب والسنة» 1/245</cite></blockquote></section><div class=\"muy\"><div class=\"muy-head\"><b>अल-मुख़्तसर फ़ी तफ़सीरिल क़ुरआनिल करीम</b><small>आयत का सामान्य अर्थ — दोनों शैख़ों के शब्द नहीं</small></div><p class=\"muy-text\">और यदि हम उसे विपत्ति और बीमारी के बाद स्वास्थ्य, धन और सुख का स्वाद चखाएँ, तो निश्चय वह कहेगा : यह तो मेरे ही लिए है; क्योंकि मैं इसका योग्य और हक़दार हूँ। और मैं नहीं समझता कि क़ियामत आने वाली है। यदि मान भी लिया जाए कि क़ियामत आएगी, तो अल्लाह के पास भी मुझे संपन्नता और धन प्राप्त होगा। अतः जिस तरह उसने मेरे उसका हक़दार होने के कारण इस दुनिया में मुझ पर अनुग्रह किया है, उसी तरह आख़िरत में भी मुझ पर अनुग्रह करेगा। तो हम अल्लाह के साथ कुफ़्र करने वालों को ज़रूर उनके कुफ़्र और पापों से सूचित करेंगे और उन्हें ज़रूर कठोरतम यातना का स्वाद चखाएँगे।</p><a class=\"muy-credit\" href=\"https://quranenc.com/en/browse/hindi_mokhtasar\" target=\"_blank\" rel=\"noopener\" dir=\"ltr\">Hindi Translation of Al-Mukhtasar in Interpreting the Noble Quran — 2026-11-04 · QuranEnc.com</a></div><a class=\"btn pri open\" href=\"/tafsir.html?lang=hi#s41a50\">इंटरैक्टिव तफ़सीर में खोलें (पूरे पाठ)</a><div class=\"pn\"><a href=\"/hi/ayah/41-49.html\">पिछली आयत (41:49)</a><a href=\"/hi/ayah/41-51.html\">अगली आयत (41:51)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/41-50.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/41-50.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/41-50.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/41-50.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/41-50.html\" hreflang=\"tr\" lang=\"t