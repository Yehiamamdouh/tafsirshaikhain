nt=\"https://tafsirshaikhain.com/hi/ayah/68-51.html\">\n<meta property=\"og:site_name\" content=\"दो शैख़ों की तफ़सीर\">\n<meta property=\"og:locale\" content=\"hi_IN\">\n<meta property=\"og:type\" content=\"article\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta property=\"og:image:width\" content=\"1200\">\n<meta property=\"og:image:height\" content=\"630\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<link rel=\"manifest\" href=\"/manifest.webmanifest\">\n<link rel=\"apple-touch-icon\" href=\"/icon-192.png\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"तफ़सीर: Al-Qalam 68:51 — इब्ने तैमिया और इब्नुल क़य्यिम के अनुसार\", \"description\": \"और वे लोग जिन्होंने इनकार किया, निश्चय क़रीब हैं कि वे अपनी निगाहों से (घूर घूरकर) आपको अवश्य ही फिसला देंगे, जब वे क़ुरआन को सुनते हैं और कहते हैं कि यह अ\", \"inLanguage\": \"hi\", \"url\": \"https://tafsirshaikhain.com/hi/ayah/68-51.html\", \"mainEntityOfPage\": \"https://tafsirshaikhain.com/hi/ayah/68-51.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"शैख़ुल इस्लाम इब्ने तैमिया\"}, {\"@type\": \"Person\", \"name\": \"इमाम इब्नुल क़य्यिम\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"दो शैख़ों की तफ़सीर\", \"url\": \"https://tafsirshaikhain.com/hi/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"मुखपृष्ठ\", \"item\": \"https://tafsirshaikhain.com/hi/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"सूरह Al-Qalam\", \"item\": \"https://tafsirshaikhain.com/hi/surah/68.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"आयत 51\", \"item\": \"https://tafsirshaikhain.com/hi/ayah/68-51.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/hi/\">मुखपृष्ठ</a> › <a href=\"/hi/surah/68.html\">सूरह Al-Qalam</a> › आयत 51</nav><h1>तफ़सीर: सूरह Al-Qalam 68:51</h1><p class=\"vt ar\" lang=\"ar\">﴿وَإِن يَكَادُ الَّذِينَ كَفَرُوا لَيُزْلِقُونَكَ بِأَبْصَارِهِمْ لَمَّا سَمِعُوا الذِّكْرَ وَيَقُولُونَ إِنَّهُ لَمَجْنُونٌ﴾</p><section><h3>अर्थ का अनुवाद</h3><p class=\"tr\">और वे लोग जिन्होंने इनकार किया, निश्चय क़रीब हैं कि वे अपनी निगाहों से (घूर घूरकर) आपको अवश्य ही फिसला देंगे, जब वे क़ुरआन को सुनते हैं और कहते हैं कि यह अवश्य ही दीवाना है।</p><span class=\"cr\" dir=\"ltr\">Hindi Translation - Azizul Haq Al-Omari — v1.1.5 · QuranEnc.com</span></section><p class=\"cr\">दोनों इमामों के शब्द मूल अरबी में, ज्यों के त्यों, हवालों के साथ दिए गए हैं।</p><section><h2>शैख़ुल इस्लाम इब्ने तैमिया</h2><blockquote class=\"ar\" lang=\"ar\">والكافر والمنافق يسمع ويرى على وجه البغض والجهل كما قال تعالى: {وإن يكاد الذين كفروا ليزلقونك بأبصارهم لما سمعوا الذكر}<cite>«مجموع الفتاوى» 15/342</cite></blockquote></section><section><h2>इमाम इब्नुल क़य्यिम</h2><blockquote class=\"ar\" lang=\"ar\">فالكفار كانوا ينظرون إليه نظر حاسد شديد العدواة فهو نظر يكاد يزلقه لولا حفظ الله وعصمته فهذا أشد من نظر العائن بل هو جنس من نظر العائن فمن قال إنه من الإصابة بالعين أراد هذا المعنى ومن قال: ليس به أراد أن نظرهم لم يكن نظر استحسان وإعجاب<cite>«بدائع الفوائد» 2/231</cite></blockquote><h3>जो उन्होंने दूसरों से नक़्ल किया</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">غير واحد من المفسرين</span> <span class=\"st\">حكاه</span> «إنه الإصابة بالعين فأرادوا أن يصيبوا بها رسول الله صلى الله عليه وسلم»<cite>«بدائع الفوائد» 2/231</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن قتيبة</span> <span class=\"st\">حكاه</span> «ليس المراد أنهم يصيبونك بالعين كما يصيب العائن بعينه ما يعجبه وإنما أراد أنهم ينظرون إليك إذا قرأت القرآن الكريم نظرا شديدا بالعداوة والبغضاء يكاد يسقطك»<cite>«بدائع الفوائد» 2/231</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الزجاج</span> <span class=\"st\">حكاه</span> «يعني من شدة العداوة يكادون بنظرهم نظر البغضاء أن يصرعوك»<cite>«بدائع الفوائد» 2/231</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=hi#s68a51\">इंटरैक्टिव तफ़सीर में खोलें (पूरे पाठ)</a><div class=\"pn\"><a href=\"/hi/ayah/68-50.html\">पिछली आयत (68:50)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/68-51.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/68-51.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/68-51.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/68-51.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/68-51.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/68-51.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/68-51.html\" hreflang=\"b