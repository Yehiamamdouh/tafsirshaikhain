googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/hi/\">मुखपृष्ठ</a> › <a href=\"/hi/surah/108.html\">सूरह Al-Kawthar</a> › आयत 1</nav><h1>तफ़सीर: सूरह Al-Kawthar 108:1</h1><p class=\"vt ar\" lang=\"ar\">﴿بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ إِنَّا أَعْطَيْنَاكَ الْكَوْثَرَ﴾</p><section><h3>अर्थ का अनुवाद</h3><p class=\"tr\">(ऐ नबी!) हमने आपको कौसर प्रदान किया है।</p><span class=\"cr\" dir=\"ltr\">Hindi Translation - Azizul Haq Al-Omari — v1.1.5 · QuranEnc.com</span></section><p class=\"cr\">दोनों इमामों के शब्द मूल अरबी में, ज्यों के त्यों, हवालों के साथ दिए गए हैं।</p><section><h2>शैख़ुल इस्लाम इब्ने तैमिया</h2><blockquote class=\"ar\" lang=\"ar\">تدل هذه الآية على عطية كثيرة صادرة عن معط كبير غني واسع.<cite>«مجموع الفتاوى» 16/529</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">والكوثر المعروف إنما هو نهر في الجنة كما قد وردت به الأحاديث الصحيحة الصريحة وقال ابن عباس الكوثر إنما هو من الخير الكثير الذي أعطاه الله إياه<cite>«مجموع الفتاوى» 16/529</cite></blockquote></section><section><h2>इमाम इब्नुल क़य्यिम</h2><blockquote class=\"ar\" lang=\"ar\">وإذا كان المقصود ذكرهما ذكرا معا كقوله تعالى {إنا أعطيناك الكوثر} الكوثر 1 فإن المقصود إخباره لرسوله صلى الله عليه وسلم بما خصه به وأعطاه إياه من الكوثر ولا يتم هذا إلا بذكر المفعولين<cite>«جلاء الأفهام في فضل الصلاة على محمد خير الأنام» 1/460</cite></blockquote></section><div class=\"muy\"><div class=\"muy-head\"><b>अल-मुख़्तसर फ़ी तफ़सीरिल क़ुरआनिल करीम</b><small>आयत का सामान्य अर्थ — दोनों शैख़ों के शब्द नहीं</small></div><p class=\"muy-text\">(ऐ रसूल) हमने आपको ढेर सारी भलाई प्रदान की है, और उसी में से एक जन्नत में कौसर नहर भी है।</p><a class=\"muy-credit\" href=\"https://quranenc.com/en/browse/hindi_mokhtasar\" target=\"_blank\" rel=\"noopener\" dir=\"ltr\">Hindi Translation of Al-Mukhtasar in Interpreting the Noble Quran — 2026-11-04 · QuranEnc.com</a></div><a class=\"btn pri open\" href=\"/tafsir.html?lang=hi#s108a1\">इंटरैक्टिव तफ़सीर में खोलें (पूरे पाठ)</a><div class=\"pn\"><span></span><a href=\"/hi/ayah/108-2.html\">अगली आयत (108:2)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/108-1.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/108-1.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/108-1.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/108-1.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/108-1.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/108-1.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/108-1.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/108-1.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/108-1.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/108-1.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/108-1.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/108-1.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/108-1.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/108-1.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/108-1.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a> · <b lang=\"hi\">हिन्दी</b> · <a href=\"/ps/ayah/108-1.html\" hreflang=\"ps\" lang=\"ps\" data-l=\"ps\">پښتو</a> · <a href=\"/so/ayah/108-1.html\" hreflang=\"so\" lang=\"so\" data-l=\"so\">Soomaali</a> · <a href=\"/uz/ayah/108-1.html\" hreflang=\"uz\" lang=\"uz\" data-l=\"uz\">Ўзбекча</a>