href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ha/\">Shafin farko</a> › <a href=\"/ha/surah/79.html\">Sura An-Naazi&#x27;aat</a> › Aya 27</nav><h1>Tafsirin Sura An-Naazi&#x27;aat 79:27</h1><p class=\"vt ar\" lang=\"ar\">﴿أَأَنتُمْ أَشَدُّ خَلْقًا أَمِ السَّمَاءُ بَنَاهَا﴾</p><section><h3>Fassarar ma&#x27;ana</h3><p class=\"tr\">Shin, kũ ne mafi wuyar halitta ko sama? Allah Ya gina ta.</p><span class=\"cr\" dir=\"ltr\">Hausa Translation - Abu Bakr Jumi — v1.2.2 · QuranEnc.com</span></section><p class=\"cr\">An kawo maganganun limaman biyu da Larabci na asali, kalma bayan kalma, tare da madogara.</p><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">هو على التقرير والتوبيخ والمعنى أي المخلوقين أشد خلقا وأعظم<cite>«بدائع الفوائد» 1/204</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">بل هي احكم خلقا واتقن صنعا واجمع العجائب من بدن الانسان بل لا نسبة لجميع ما في الارض الى عجائب السموات<cite>«مفتاح دار السعادة ومنشور ولاية العلم والإرادة» 1/196</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ha#s79a27\">Bude a cikin tafsiri mai mu&#x27;amala (cikakkun rubutu)</a><div class=\"pn\"><a href=\"/ha/ayah/79-25.html\">Ayar da ta gabata (79:25)</a><a href=\"/ha/ayah/79-28.html\">Aya ta gaba (79:28)</a></div></main><footer class=\"site-foot\"><span>Tafsirin Shehunan Biyu · <a href=\"/ha/\">Shafin farko</a> · <a href=\"/about.html\">Game da aikin</a> · <a href=\"/privacy.html\">Sirri da sharudda</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/79-28.html":"<!doctype html>\n<html lang=\"ha\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\"