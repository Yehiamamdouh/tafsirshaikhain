ttps://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Shafin farko\", \"item\": \"https://tafsirshaikhain.com/ha/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Al-Haaqqa\", \"item\": \"https://tafsirshaikhain.com/ha/surah/69.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aya 44\", \"item\": \"https://tafsirshaikhain.com/ha/ayah/69-44.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ha/\">Shafin farko</a> › <a href=\"/ha/surah/69.html\">Sura Al-Haaqqa</a> › Aya 44</nav><h1>Tafsirin Sura Al-Haaqqa 69:44</h1><p class=\"vt ar\" lang=\"ar\">﴿وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ الْأَقَاوِيلِ﴾</p><section><h3>Fassarar ma&#x27;ana</h3><p class=\"tr\">Kuma dã (Muhammadu) yã faɗi wata maganã, yã jingina ta garẽ Mu.</p><span class=\"cr\" dir=\"ltr\">Hausa Translation - Abu Bakr Jumi — v1.2.2 · QuranEnc.com</span></section><p class=\"cr\">An kawo maganganun limaman biyu da Larabci na asali, kalma bayan kalma, tare da madogara.</p><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">أي لو أتى بشيء من عند نفسه لأخذنا منه بيمينه، وقطعنا نياط قلبه وأهلكناه،<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/342</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">أفلا تراه كيف يخبر سبحانه: أن كماله وحكمته وقدرته تأبى أن يقر من تقول عليه 