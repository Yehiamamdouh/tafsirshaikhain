 \"Shafin farko\", \"item\": \"https://tafsirshaikhain.com/ha/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Al-Anbiyaa\", \"item\": \"https://tafsirshaikhain.com/ha/surah/21.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aya 101\", \"item\": \"https://tafsirshaikhain.com/ha/ayah/21-101.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ha/\">Shafin farko</a> › <a href=\"/ha/surah/21.html\">Sura Al-Anbiyaa</a> › Aya 101</nav><h1>Tafsirin Sura Al-Anbiyaa 21:101</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّ الَّذِينَ سَبَقَتْ لَهُم مِّنَّا الْحُسْنَىٰ أُولَٰئِكَ عَنْهَا مُبْعَدُونَ﴾</p><section><h3>Fassarar ma&#x27;ana</h3><p class=\"tr\">Lalle ne waɗanda kalmar yabo tã gabãta a garẽ su daga garẽ Mu, waɗannan waɗanda ake nĩsantarwa daga barinta ne.</p><span class=\"cr\" dir=\"ltr\">Hausa Translation - Abu Bakr Jumi — v1.2.2 · QuranEnc.com</span></section><p class=\"cr\">An kawo maganganun limaman biyu da Larabci na asali, kalma bayan kalma, tare da madogara.</p><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">وهذا الإيراد الذي أورده ابن الزبعري لا يرد على الآية فإنه سبحانه قال إنكم وما تعبدون من دون الله ولم يقل ومن تعبدون<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/27</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ha#s21a101\">Bude a cikin tafsiri mai mu&#x27;amala (cikakkun rubutu)</a><div class=\"pn\"><a href=\"/ha/ayah/21-99.html\">Ayar da ta gabata (21:99)</a><a href=\"/ha/ayah/21-104.html\">Aya ta gaba (21:104)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/21-101.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/21-101.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/21-101.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/21-101.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/21-101.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/21-101.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/21-101.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/21-101.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/21-101.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/21-101.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/21-101.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <b lang=\"ha\">Hausa</b> · <a href=\"/es/ayah/21-101.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/21-101.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/21-101.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a></nav>\n<footer class=\"site-foot\"><span>Tafsirin Shehunan Biyu · <a hre