ps://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"Shaikhul Islam Ibn Taimiyya\"}, {\"@type\": \"Person\", \"name\": \"Imam Ibn al-Qayyim\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"Tafsirin Shehunan Biyu\", \"url\": \"https://tafsirshaikhain.com/ha/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Shafin farko\", \"item\": \"https://tafsirshaikhain.com/ha/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Saba\", \"item\": \"https://tafsirshaikhain.com/ha/surah/34.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aya 51\", \"item\": \"https://tafsirshaikhain.com/ha/ayah/34-51.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ha/\">Shafin farko</a> › <a href=\"/ha/surah/34.html\">Sura Saba</a> › Aya 51</nav><h1>Tafsirin Sura Saba 34:51</h1><p class=\"vt ar\" lang=\"ar\">﴿وَلَوْ تَرَىٰ إِذْ فَزِعُوا فَلَا فَوْتَ وَأُخِذُوا مِن مَّكَانٍ قَرِيبٍ﴾</p><section><h3>Fassarar ma&#x27;ana</h3><p class=\"tr\">Kuma dã kã gani, a lõkacin da suka firgita, to, bãbu kuɓuta, kuma aka kãma su daga wuri makusanci.</p><span class=\"cr\" dir=\"ltr\">Hausa Translation - Abu Bakr Jumi — v1.2.2 · QuranEnc.com</span></section><p class=\"cr\">An kawo maganganun limaman biyu da Larabci na asali, kalma bayan kalma, tare da madogara.</p><section><h2>Shaikhul Islam Ibn Taimiyya</h2><blockquote class=\"ar\" lang=\"ar\">وتارة يحذفه كما يحذف جواب لو كثيرا كقوله تعالى: {لو تعلمون علم اليقين} وقوله: {ولو أن قرآنا سيرت به الجبال} {ولو ترى إذ يتوفى الذين كفروا الملائكة} {ولو ترى إذ فزعوا فلا فوت} {ولو ترى إذ وقفوا على النار} {ولو ترى إذ وقفوا على ربهم} .<cite>«مجموع الفتاوى» 13/315</cite></blockquote></section><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">كما قال تعالى {ولو ترى إذ فزعوا فلا فوت} {ولو ترى إذ يتوفى الذين كفروا الملائكة} أي لو ترى ذلك الوقت وما فيه<cite>«التبيان في أقسام القرآن» 1/3</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ha#s34a51\">Bude a cikin tafsiri mai mu&#x27;amala (cikakkun rubutu)</a><div class=\"pn\"><a href=\"/ha/ayah/34-50.html\">Ayar da ta gabata (34:50)</a><a href=\"/ha/ayah/34-54.html\">Aya ta gaba (34:54)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/34-51.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/34-51.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/34-51.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/34-51.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/34-51.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/34-51.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/34-51.html\" h