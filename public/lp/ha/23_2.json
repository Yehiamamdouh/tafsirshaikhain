"item\": \"https://tafsirshaikhain.com/ha/ayah/23-116.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ha/\">Shafin farko</a> › <a href=\"/ha/surah/23.html\">Sura Al-Muminoon</a> › Aya 116</nav><h1>Tafsirin Sura Al-Muminoon 23:116</h1><p class=\"vt ar\" lang=\"ar\">﴿فَتَعَالَى اللَّهُ الْمَلِكُ الْحَقُّ لَا إِلَٰهَ إِلَّا هُوَ رَبُّ الْعَرْشِ الْكَرِيمِ﴾</p><section><h3>Fassarar ma&#x27;ana</h3><p class=\"tr\">Allah Mamallaki gaskiya, Yã ɗaukaka. Bãbu abin bautãwa, fãce Shi. Shĩ ne Ubangijin Al&#x27;arshi, mai daraja.</p><span class=\"cr\" dir=\"ltr\">Hausa Translation - Abu Bakr Jumi — v1.2.2 · QuranEnc.com</span></section><p class=\"cr\">An kawo maganganun limaman biyu da Larabci na asali, kalma bayan kalma, tare da madogara.</p><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">فنزه نفسه سبحانه وباعدها عن هذا الحسبان وأنه يتعالى عنه ولا يليق به لقبحه ولمنافاته لحكمته وملكه وإلهيته<cite>«مفتاح دار السعادة ومنشور ولاية العلم والإرادة» 2/12</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ha#s23a116\">Bude a cikin tafsiri mai mu&#x27;amala (cikakkun rubutu)</a><div class=\"pn\"><a href=\"/ha/ayah/23-115.html\">Ayar da ta gabata (23:115)</a></div></main><nav class=\"langs\" aria-label=\"L