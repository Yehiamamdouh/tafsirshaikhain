tion/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"Tafsirin Al-Muminoon 23:115 — bisa ga Ibn Taimiyya da Ibn al-Qayyim\", \"description\": \"\\\"Shin, to, kun yi zaton cẽwa Mun halitta ku ne da wãsa kuma lalle ku, zuwa gare Mu, bã zã ku kõmo ba?\\\"\", \"inLanguage\": \"ha\", \"url\": \"https://tafsirshaikhain.com/ha/ayah/23-115.html\", \"mainEntityOfPage\": \"https://tafsirshaikhain.com/ha/ayah/23-115.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"Shaikhul Islam Ibn Taimiyya\"}, {\"@type\": \"Person\", \"name\": \"Imam Ibn al-Qayyim\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"Tafsirin Shehunan Biyu\", \"url\": \"https://tafsirshaikhain.com/ha/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Shafin farko\", \"item\": \"https://tafsirshaikhain.com/ha/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Al-Muminoon\", \"item\": \"https://tafsirshaikhain.com/ha/surah/23.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aya 115\", \"item\": \"https://tafsirshaikhain.com/ha/ayah/23-115.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ha/\">Shafin farko</a> › <a href=\"/ha/surah/23.html\">Sura Al-Muminoon</a> › Aya 115</nav><h1>Tafsirin Sura Al-Muminoon 23:115</h1><p class=\"vt ar\" lang=\"ar\">﴿أَفَحَسِبْتُمْ أَنَّمَا خَلَقْنَاكُمْ عَبَثًا وَأَنَّكُمْ إِلَيْنَا لَا تُرْجَعُونَ﴾</p><section><h3>Fassarar ma&#x27;ana</h3><p class=\"tr\">&quot;Shin, to, kun yi zaton cẽwa Mun halitta ku ne da wãsa kuma lalle ku, zuwa gare Mu, bã zã ku kõmo ba?&quot;</p><span class=\"cr\" dir=\"ltr\">Hausa Translation - Abu Bakr Jumi — v1.2.2 · QuranEnc.com</span></section><p class=\"cr\">An kawo maganganun limaman biyu da Larabci na asali, kalma bayan kalma, tare da madogara.</p><section><h2>Shaikhul Islam Ibn Taimiyya</h2><h3>Abin da ya ruwaito daga wasu</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">المفسرون</span> <span class=\"st\">أقرّه</span> «العبث أن يعمل عملا لا لحكمة وهو جنس من اللعب»<cite>«مجموع الفتاوى» 17/174</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">جعفر بن محمد الصادق</span> <span class=\"st\">حكاه</span> «لم يخلقهم لجر منفعة ولا لدفع مضرة ولكن خلقهم وأحسن إليهم وأرسل إليهم الرسل حتى يفصلوا بين الحق والباطل فمن أحسن كافأه بالجنة ومن عصى كافأه بالنار.»<cite>«مجموع الفتاوى» 5/538</cite></blockquote></section><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">أي لغير شيء، لا تؤمرون ولا تنهون، ولا تثابون ولا تعاقبون، والعبث قبيح، فدل على أن قبح هذا مستقر في الفطر والعقول<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/252</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ha#s23a115\">Bude a cikin tafsiri mai mu&#x27;amala (cikakkun rubutu)</a><div class=\"pn\"><a href=\"/ha/ayah/23-111.html\">Ayar da ta gabata (23:111)</a><a href=\"/ha/ayah/23-116.html\">Aya ta gaba (23:116)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/23-115.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <