nt=\"Tafsirin Ad-Dukhaan 44:2 — bisa ga Ibn Taimiyya da Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"Inã rantsuwa da Littãfi Mabayyani.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Shafin farko\", \"item\": \"https://tafsirshaikhain.com/ha/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Ad-Dukhaan\", \"item\": \"https://tafsirshaikhain.com/ha/surah/44.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aya 2\", \"item\": \"https://tafsirshaikhain.com/ha/ayah/44-2.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ha/\">Shafin farko</a> › <a href=\"/ha/surah/44.html\">Sura Ad-Dukhaan</a> › Aya 2</nav><h1>Tafsirin Sura Ad-Dukhaan 44:2</h1><p class=\"vt ar\" lang=\"ar\">﴿وَالْكِتَابِ الْمُبِينِ﴾</p><section><h3>Fassarar ma&#x27;ana</h3><p class=\"tr\">Inã rantsuwa da Littãfi Mabayyani.</p><span class=\"cr\" dir=\"ltr\">Hausa Translation - Abu Bakr Jumi — v1.2.2 · QuranEnc.com</span></section><p class=\"cr\">An kawo maganganun limaman biyu da Larabci na asali, kalma bayan kalma, tare da madogara.</p><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">وأقسم سبحانه بكتابه على صدق رسوله وصحة نبوته ورسالته فتأمل قدر المقسم به والمقسم عليه<cite>«التبيان في أقسام القرآن» 1/426</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ha#s44a2\">Bude a cikin tafsiri mai mu&#x27;amala (cikakkun rubutu)</a><div class=\"pn\"><span></span><a href=\"/ha/ayah/44-26.html\">Aya ta gaba (44:26)</a></div></main><footer class=\"site-foot\"><span>Tafsirin Shehunan Biyu · <a href=\"/ha/\">Shafin farko</a> · <a href=\"/about.html\">Game da aikin</a> · <a href=\"/privacy.html\">Sirri da sharudda</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/44-26.html":"<!doctype html>\n<html lang=\"ha\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsirin Ad-Dukhaan 44:26 — bisa ga Ibn Taimiyya da Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Da shuke-shuke da matsayi mai kyau.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/ha/ayah/44-26.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/44-26.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/44-26.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/44-26.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/44-26.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/44-26.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/44-26.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/44-26.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/44-26.html\">\n<link rel=\"alternate\" hreflang=\"m