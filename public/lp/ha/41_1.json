xt\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Shafin farko\", \"item\": \"https://tafsirshaikhain.com/ha/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Fussilat\", \"item\": \"https://tafsirshaikhain.com/ha/surah/41.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aya 50\", \"item\": \"https://tafsirshaikhain.com/ha/ayah/41-50.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ha/\">Shafin farko</a> › <a href=\"/ha/surah/41.html\">Sura Fussilat</a> › Aya 50</nav><h1>Tafsirin Sura Fussilat 41:50</h1><p class=\"vt ar\" lang=\"ar\">﴿وَلَئِنْ أَذَقْنَاهُ رَحْمَةً مِّنَّا مِن بَعْدِ ضَرَّاءَ مَسَّتْهُ لَيَقُولَنَّ هَٰذَا لِي وَمَا أَظُنُّ السَّاعَةَ قَائِمَةً وَلَئِن رُّجِعْتُ إِلَىٰ رَبِّي إِنَّ لِي عِندَهُ لَلْحُسْنَىٰ فَلَنُنَبِّئَنَّ الَّذِينَ كَفَرُوا بِمَا عَمِلُوا وَلَنُذِيقَنَّهُم مِّنْ عَذَابٍ غَلِيظٍ﴾</p><section><h3>Fassarar ma&#x27;ana</h3><p class=\"tr\">Kuma lalle idan Mun ɗanɗana masa wata rahama daga gareMu, daga bãyan wata cũta ta shãfe shi, lalle zai ce, &quot;Wannan (ni&#x27;ima) tãwa ce kuma bã ni zaton Sã&#x27;a mai tsayuwa ce, kuma lalle idan aka mayar da ni zuwa ga Ubangijĩna, haƙĩƙa, inã da makõma mafi kyau, a wurin Sa.&quot; To, lalle zã Mu bã da lãbãri ga waɗanda suka kãfirta game da abin da suka aikata, kuma lalle Munã ɗanɗana musu daga azãba, Mai kauri.</p><span class=\"cr\" dir=\"ltr\">Hausa Translation - Abu Bakr Jumi — v1.2.2 · QuranEnc.com</span></section><p class=\"cr\">An kawo maganganun limaman biyu da Larabci na asali, kalma bayan kalma, tare da madogara.</p><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">قال هذا لي أي أنا أهله وجدير به ومستحق له<cite>«الروح في الكلام على أرواح الأموات والأحياء بالدلائل من الكتاب والسنة» 1/245</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">ثم زاد في غروره فقال {ولئن رجعت إلى ربي إن لي عنده للحسنى} يعني الجنة والكرامة<cite>«الروح في الكلام على أرواح الأموات والأحياء بالدلائل من الكتاب والسنة» 1/245</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ha#s41a50\">Bude a cikin tafsiri mai mu&#x27;amala (cikakkun rubutu)</a><div class=\"pn\"><a href=\"/ha/ayah/41-49.html\">Ayar da ta gabata (41:49)</a><a href=\"/ha/ayah/41-51.html\">Aya ta gaba (41:51)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/41-50.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/41-50.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/41-50.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/41-50.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/41-50.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/41-50.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/41-50.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/41-50.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/41-50.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/41-50.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/41-50.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <b lang=\"ha\">Hausa</b> · <a href=\"/es/ayah/41-50.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/41-50.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/41-50.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a></nav>\n<footer class=\"site-foot\"><span>Tafsirin Shehunan Biyu · <a href=\"/ha/\">Shafin farko</a> · <a href=\"/about.html\">Game da aikin</a> · <a href=\"/privacy.html\">Sirri da sharudda</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n<script>try{localStorage.setItem(\"lang\",\"ha\")}catch(e){}document.addEventListener(\"click\",function(e){var a=e.target.closest&&e.target.closest(\"[data-l]\");if(a)try{localStorage.setItem(\"lang\",a.dataset.l)}catch(x){}})</script>\n</body>\n</html>\n","ayah/41-51.html":"<!doctype html>\n<html lang=\"ha\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsirin Fussilat 41:51 — bisa ga Ibn Taimiyya da Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Kuma idan Muka yi ni&#x27;ima ga mutum, sai ya bijire, kuma ya nĩsantar da gẽfensa, kuma idan sharri ya sãme shi, sai ya zama ma&#x27;abũcin addu&#x27;a mai fãɗi.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/ha/ayah/41-51.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/41-51.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/41-51.html\">\n<l