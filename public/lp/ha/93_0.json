fsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Shafin farko\", \"item\": \"https://tafsirshaikhain.com/ha/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Ad-Dhuhaa\", \"item\": \"https://tafsirshaikhain.com/ha/surah/93.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aya 7\", \"item\": \"https://tafsirshaikhain.com/ha/ayah/93-7.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ha/\">Shafin farko</a> › <a href=\"/ha/surah/93.html\">Sura Ad-Dhuhaa</a> › Aya 7</nav><h1>Tafsirin Sura Ad-Dhuhaa 93:7</h1><p class=\"vt ar\" lang=\"ar\">﴿وَوَجَدَكَ ضَالًّا فَهَدَىٰ﴾</p><section><h3>Fassarar ma&#x27;ana</h3><p class=\"tr\">Kuma Ya sãme ka bã ka da shari&#x27;ã, sai Ya shiryar da kai?</p><span class=\"cr\" dir=\"ltr\">Hausa Translation - Abu Bakr Jumi — v1.2.2 · QuranEnc.com</span></section><p class=\"cr\">An kawo maganganun limaman biyu da Larabci na asali, kalma bayan kalma, tare da madogara.</p><section><h2>Shaikhul Islam Ibn Taimiyya</h2><blockquote class=\"ar\" lang=\"ar\">وقد يكون في سياق أنه لا يسمع ولا يعلم إلا ما أسمعه الله إياه وأعلمه إياه، فإنه [ليس]، من تلقاء نفسه ليس له [علم بشيء]، بل الله هو الذي أسمعه وأعلمه،<cite>«الاستغاثة في الرد على البكري» 1/360</cite></blockquote><h3>Abin da ya ruwaito daga wasu</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن عطية</span> <span class=\"st\">حكاه</span> «وجده فأغاثه إنعامه بالنبوة والرسالة على غير الطريق التي هو عليها في نبوته»<cite>«تفسير آيات أشكلت على كثير من العلماء» 1/209</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ha#s93a7\">Bude a cikin tafsiri mai mu&#x27;amala (cikakkun rubutu)</a><div class=\"pn\"><a href=\"/ha/ayah/93-3.html\">Ayar da ta gabata (93:3)</a><a href=\"/ha/ayah/93-10.html\">Aya ta gaba (93:10)</a></div></main><footer class=\"site-foot\"><span>Tafsirin Shehunan Biyu · <a href=\"/ha/\">Shafin farko</a> · <a href=\"/about.html\">Game da aikin</a> · <a href=\"/privacy.html\">Sirri da sharudda</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/93-10.html":"<!doctype html>\n<html lang=\"ha\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsirin Ad-Dhuhaa 93:10 — bisa ga Ibn Taimiyya da Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Kuma amma mai tambaya, kada ka yi masa tsãwa.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/ha/ayah/93-10.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/93-10.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/93-10.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/93-10.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/93-10.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/93-10.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/93-10.html\">\n<link rel=\"alternate\" hreflang=\"fr\" 