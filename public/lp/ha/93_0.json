=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ha/\">Shafin farko</a> › <a href=\"/ha/surah/93.html\">Sura Ad-Dhuhaa</a> › Aya 3</nav><h1>Tafsirin Sura Ad-Dhuhaa 93:3</h1><p class=\"vt ar\" lang=\"ar\">﴿مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ﴾</p><section><h3>Fassarar ma&#x27;ana</h3><p class=\"tr\">Ubangijinka bai yi maka bankwana ba, kuma bai ƙĩ kaba.</p><span class=\"cr\" dir=\"ltr\">Hausa Translation - Abu Bakr Jumi — v1.2.2 · QuranEnc.com</span></section><p class=\"cr\">An kawo maganganun limaman biyu da Larabci na asali, kalma bayan kalma, tare da madogara.</p><section><h2>Shaikhul Islam Ibn Taimiyya</h2><blockquote class=\"ar\" lang=\"ar\">والرسول هو الذي أنزل عليه القرآن والخطاب في هذه السور له كقوله {ما ودعك ربك وما قلى} وقوله {ألم نشرح لك صدرك} وقوله {اقرأ باسم ربك} .<cite>«مجموع الفتاوى» 16/284</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ha#s93a3\">Bude a cikin tafsiri mai mu&#x27;amala (cikakkun rubutu)</a><div class=\"pn\"><a href=\"/ha/ayah/93-1.html\">Ayar da ta gabata (93:1)</a><a href=\"/ha/ayah/93-7.html\">Aya ta gaba (93:7)</a></div></main><footer class=\"site-foot\"><span>Tafsirin Shehunan Biyu · <a href=\"/ha/\">Shafin farko</a> · <a href=\"/about.html\">Game da aikin</a> · <a href=\"/privacy.html\">Sirri da sharudda</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/93-7.html":"<!doctype html>\n<html lang=\"ha\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsirin Ad-Dhuhaa 93:7 — bisa ga Ibn Taimiyya da Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Kuma Ya sãme 