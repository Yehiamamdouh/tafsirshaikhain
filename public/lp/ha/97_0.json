ifest.webmanifest\">\n<link rel=\"apple-touch-icon\" href=\"/icon-192.png\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"Tafsirin Al-Qadr 97:1 — bisa ga Ibn Taimiyya da Ibn al-Qayyim\", \"description\": \"Lalle ne Mũ, Mun saukar da shi (Alƙur'ãni) a cikin Lailatul ƙadari (daren daraja)\", \"inLanguage\": \"ha\", \"url\": \"https://tafsirshaikhain.com/ha/ayah/97-1.html\", \"mainEntityOfPage\": \"https://tafsirshaikhain.com/ha/ayah/97-1.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"Shaikhul Islam Ibn Taimiyya\"}, {\"@type\": \"Person\", \"name\": \"Imam Ibn al-Qayyim\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"Tafsirin Shehunan Biyu\", \"url\": \"https://tafsirshaikhain.com/ha/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Shafin farko\", \"item\": \"https://tafsirshaikhain.com/ha/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Al-Qadr\", \"item\": \"https://tafsirshaikhain.com/ha/surah/97.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aya 1\", \"item\": \"https://tafsirshaikhain.com/ha/ayah/97-1.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ha/\">Shafin farko</a> › <a href=\"/ha/surah/97.html\">Sura Al-Qadr</a> › Aya 1</nav><h1>Tafsirin Sura Al-Qadr 97:1</h1><p class=\"vt ar\" lang=\"ar\">﴿بِّسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ إِنَّا أَنزَلْنَاهُ فِي لَيْلَةِ الْقَدْرِ﴾</p><section><h3>Fassarar ma&#x27;ana</h3><p class=\"tr\">Lalle ne Mũ, Mun saukar da shi (Alƙur&#x27;ãni) a cikin Lailatul ƙadari (daren daraja)</p><span class=\"cr\" dir=\"ltr\">Hausa Translation - Abu Bakr Jumi — v1.2.2 · QuranEnc.com</span></section><p class=\"cr\">An kawo maganganun limaman biyu da Larabci na asali, kalma bayan kalma, tare da madogara.</p><section><h2>Shaikhul Islam Ibn Taimiyya</h2><blockquote class=\"ar\" lang=\"ar\">السور القصار في أواخر المصحف متناسبة. فسورة (اقرأ هي أول ما نزل من القرآن؛ ولهذا افتتحت بالأمر بالقراءة<cite>«مجموع الفتاوى» 16/477</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فلما أمر في هذه السورة بالقراءة ذكر في التي تليها نزول القرآن ليلة القدر وذكر فيها تنزل الملائكة والروح وفي (المعارج) عروج الملائكة والروح وفي (النبأ) قيام الملائكة والروح. فذكر الصعود والنزول والقيام ثم في التي تليها تلاوته على المنذرين<cite>«مجموع الفتاوى» 16/477</cite></blockquote></section><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">قال تعالى: {حم والكتاب المبين إنا أنزلناه في ليلة مباركة إنا كنا منذرين فيها يفرق كل أمر حكيم أمرا من عندنا إنا كنا مرسلين} وهذه هي ليلة القدر قطعا لقوله تعالى: {إنا أنزلناه في ليلة القدر} ومن زعم أنها ليلة النصف من شعبان فقد غلط<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/22</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وهذا هو الصحيح أن القدر مصدر قدر الشيء يقدره قدرا فهي ليلة الحكم والتقدير وقالت طائفة ليلة القدر ليلة الشرف والعظمة من قولهم لفلان قدر في الناس فإن أراد صاحب هذا القول أن لها قدرا وشرفا مع ما يكون فيها من التقدير فقد أصاب وإن أراد أن معنى القدر فيها هو الشرف والخطر فقد غلط<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/22</cite></blockquote><h3>Abin da ya ruwaito daga wasu</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">مجاهد</span> <span class=\"st\">أقرّه</span> «قال سفيان عن ابن أبي نجيح عن مجاهد ليلة القدر ليلة الحكم»<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/22</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">سعيد بن جبير</span> <span class=\"st\">استشهد به</span> «وقال سفيان عن محمد بن سوقة عن سعيد بن جبير يؤذن للحجاج في ليلة القدر فيكتبون بأسمائهم وأسماء آبائهم فلا يغادر منهم أحد ولا يزاد فيهم ولا ينقص منهم»<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/22</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الحسن</span> <span class=\"st\">استشهد به</span> «وقال ابن علية ثنا ربيعة بن كلثوم قال قال رجل للحسن وأنا أسمع أرأيت ليلة القدر في كل رمضان هي قال نعم والله الذي لا إله إلا هو إنها لفي كل رمضان وأنها لليلة القدر يفرق فيها كل أمر حكيم فيها يقضي الله كل أجل وعمل ورزق إلى مثلها»<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/22</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ha#s97a1\">Bude a cikin tafsiri mai mu&#x27;amala (cikakkun rubutu)</a><div class=\"pn\"><span></span><a href=\"/ha/ayah/97-4.html\">Aya ta gaba (97:4)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/97-1.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/97-1.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/97-1.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/97-1.html\" hreflang=\"