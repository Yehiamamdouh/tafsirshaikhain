 href=\"https://tafsirshaikhain.com/es/ayah/53-61.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/53-61.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/53-61.html\">\n<meta property=\"og:title\" content=\"Tafsirin An-Najm 53:61 — bisa ga Ibn Taimiyya da Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"Alhãli kunã mãsu wãsã?\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Shafin farko\", \"item\": \"https://tafsirshaikhain.com/ha/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura An-Najm\", \"item\": \"https://tafsirshaikhain.com/ha/surah/53.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aya 61\", \"item\": \"https://tafsirshaikhain.com/ha/ayah/53-61.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ha/\">Shafin farko</a> › <a href=\"/ha/surah/53.html\">Sura An-Najm</a> › Aya 61</nav><h1>Tafsirin Sura An-Najm 53:61</h1><p class=\"vt ar\" lang=\"ar\">﴿وَأَنتُمْ سَامِدُونَ﴾</p><section><h3>Fassarar ma&#x27;ana</h3><p class=\"tr\">Alhãli kunã mãsu wãsã?</p><span class=\"cr\" dir=\"ltr\">Hausa Translation - Abu Bakr Jumi — v1.2.2 · QuranEnc.com</span></section><p class=\"cr\">An kawo maganganun limaman biyu da Larabci na asali, kalma bayan kalma, tare da madogara.</p><section><h2>Imam Ibn al-Qayyim</h2><h3>Abin da ya ruwaito daga wasu</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">غير واحد من السلف</span> <span class=\"st\">حكاه</span> «هو الغناء، يقال: سمد لنا أي غنى لنا.»<cite>«الكلام على مسألة السماع» 1/131</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ha#s53a61\">Bude a cikin tafsiri mai mu&#x27;amala (cikakkun rubutu)</a><div class=\"pn\"><a href=\"/ha/ayah/53-56.html\">Ayar da ta gabata (53:56)</a></div></main><footer class=\"site-foot\"><span>Tafsirin Shehunan Biyu · <a href=\"/ha/\">Shafin farko</a> · <a href=\"/about.html\">Game da aikin</a> · <a href=\"/privacy.html\">Sirri da sharudda</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}