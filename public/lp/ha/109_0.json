2px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ha/\">Shafin farko</a> › <a href=\"/ha/surah/109.html\">Sura Al-Kaafiroon</a> › Aya 6</nav><h1>Tafsirin Sura Al-Kaafiroon 109:6</h1><p class=\"vt ar\" lang=\"ar\">﴿لَكُمْ دِينُكُمْ وَلِيَ دِينِ﴾</p><section><h3>Fassarar ma&#x27;ana</h3><p class=\"tr\">&quot;Addininku na garẽ ku, kuma addinina yanã gare ni.&quot;</p><span class=\"cr\" dir=\"ltr\">Hausa Translation - Abu Bakr Jumi — v1.2.2 · QuranEnc.com</span></section><p class=\"cr\">An kawo maganganun limaman biyu da Larabci na asali, kalma bayan kalma, tare da madogara.</p><section><h2>Shaikhul Islam Ibn Taimiyya</h2><blockquote class=\"ar\" lang=\"ar\">{لكم دينكم ولي دين} خطاب لكل كافر وإن أسلم فيما بعد.<cite>«مجموع الفتاوى» 16/543</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وبهذا يظهر خطأ من قال إنه خطاب للمشركين والنصارى دون اليهود<cite>«مجموع الفتاوى» 16/564</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ha#s109a6\">Bude a cikin tafsiri mai mu&#x27;amala (cikakkun rubutu)</a><div class=\"pn\"><a href=\"/ha/ayah/109-5.html\">Ayar da ta gabata (109:5)</a></div></main><footer class=\"site-foot\"><span>Tafsirin Shehunan Biyu · <a href=\"/ha/\">Shafin farko</a> · <a href=\"/about.html\">Game da aikin</a> · <a href=\"/privacy.html\">Sirri da sharudda</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/109.html":"<!doctype html>\n<html lang=\"ha\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsirin Sura Al-Kaafiroon — bisa ga Ibn Taimiyya da Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Tafsirin Sura Al-Kaafiroon — Ma&#x27;anonin Alkur&#x27;ani a cikin maganganun Ibn Taimiyya da Ibn al-Qayyim\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/ha/sura