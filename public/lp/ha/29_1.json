3, \"name\": \"Aya 69\", \"item\": \"https://tafsirshaikhain.com/ha/ayah/29-69.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ha/\">Shafin farko</a> › <a href=\"/ha/surah/29.html\">Sura Al-Ankaboot</a> › Aya 69</nav><h1>Tafsirin Sura Al-Ankaboot 29:69</h1><p class=\"vt ar\" lang=\"ar\">﴿وَالَّذِينَ جَاهَدُوا فِينَا لَنَهْدِيَنَّهُمْ سُبُلَنَا وَإِنَّ اللَّهَ لَمَعَ الْمُحْسِنِينَ﴾</p><section><h3>Fassarar ma&#x27;ana</h3><p class=\"tr\">Kuma wadannan da suka yi ƙõƙari ga nẽman yardarMu, lalle Munã shiryar da su ga hanyõyinMu, kuma lalle Allah, tabbas, Yanã tãre da mãsu kyautatãwa (ga addĩninsu).</p><span class=\"cr\" dir=\"ltr\">Hausa Translation - Abu Bakr Jumi — v1.2.2 · QuranEnc.com</span></section><p class=\"cr\">An kawo maganganun limaman biyu da Larabci na asali, kalma bayan kalma, tare da madogara.</p><section><h2>Shaikhul Islam Ibn Taimiyya</h2><blockquote class=\"ar\" lang=\"ar\">فجعل لمن جاهد فيه هداية جميع سبله تعالى<cite>«مجموع الفتاوى» 28/442</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فإن الكلام فيمن جاهد في سبيل الله لا في سبيل الرياسة ولا في سبيل المال ولا في سبيل الحمية وهذا لا يكون إلا لمن قاتل ليكون الدين كله لله ولتكون كلمة الله هي العليا.<cite>«مجموع الفتاوى» 28/442</cite></blockquote><h3>Abin da ya ruwaito daga wasu</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">عبد الله بن المبارك وأحمد بن حنبل وغيرهما</span> <span class=\"st\">أقرّه</span> «ولهذا قال الإمامان عبد الله بن المبارك وأحمد بن حنبل وغيرهما: إذا اختلف الناس في شيء فانظروا ماذا عليه أهل الثغر فإن الحق معهم؛ لأن الله يقول: {والذين جاهدوا فينا لنهدينهم سبلنا} .»<cite>«مجموع الفتاوى» 28/442</cite></blockquote></section><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">ولأهل الجهاد في هذا من الهداية والكشف ما ليس لأهل المجاهدة<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/506</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ha#s29a69\">Bude a cikin tafsiri mai mu&#x27;amala (cikakkun rubutu)</a><div class=\"pn\"><a href=\"/ha/ayah/29-67.html\">Ayar da ta gabata (29:67)</a></div></main><footer class=\"site-foot\"><span>Tafsirin Shehunan Biyu · <a href=\"/ha/\">Shafin farko</a> · <a href=\"/about.html\">Game da aikin</a> · <a href=\"/privacy.html\">Sirri da sharudda</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}