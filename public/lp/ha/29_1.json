\"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Shafin farko\", \"item\": \"https://tafsirshaikhain.com/ha/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Al-Ankaboot\", \"item\": \"https://tafsirshaikhain.com/ha/surah/29.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aya 64\", \"item\": \"https://tafsirshaikhain.com/ha/ayah/29-64.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ha/\">Shafin farko</a> › <a href=\"/ha/surah/29.html\">Sura Al-Ankaboot</a> › Aya 64</nav><h1>Tafsirin Sura Al-Ankaboot 29:64</h1><p class=\"vt ar\" lang=\"ar\">﴿وَمَا هَٰذِهِ الْحَيَاةُ الدُّنْيَا إِلَّا لَهْوٌ وَلَعِبٌ وَإِنَّ الدَّارَ الْآخِرَةَ لَهِيَ الْحَيَوَانُ لَوْ كَانُوا يَعْلَمُونَ﴾</p><section><h3>Fassarar ma&#x27;ana</h3><p class=\"tr\">Kuma wannan rãyuwa ta dũniya ba ta zamo ba, fãce abar shagala da wãsã kuma lalle Lãhira tabbas, ita ce rãyuwa, dã sun kasance sunã sani.</p><span class=\"cr\" dir=\"ltr\">Hausa Translation - Abu Bakr Jumi — v1.2.2 · QuranEnc.com</span></section><p class=\"cr\">An kawo maganganun limaman biyu da Larabci na asali, kalma bayan kalma, tare da madogara.</p><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">والمراد الجنة عند أهل التفسير<cite>«حادي الأرواح إلى بلاد الأفراح» 1/98</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وأهل اللغة على أن الحيوان بمعنى الحياة<cite>«حادي الأرواح إلى بلاد الأفراح» 1/98</cite></blockquote><h3>Abin da ya ruwaito daga wasu</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">أهل التفسير</span> <span class=\"st\">أقرّه</span> «وأن الآخرة يعني الجنة لهي الحيوان لهي دار الحياة التي لا موت فيها»<cite>«حادي الأرواح إلى بلاد الأفراح» 1/98</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الكلبي</span> <span class=\"st\">حكاه</span> «هي حياة لا موت فيها»<cite>«حادي الأرواح إلى بلاد الأفراح» 1/98</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الزجاج</span> <span class=\"st\">حكاه</span> «هي دار الحياة الدائمة»<cite>«حادي الأرواح إلى بلاد الأفراح» 1/98</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">أبو عبيدة</span> <span class=\"st\">حكاه</span> «الحياة والحيوان والحي بكسر الحاء واحد»<cite>«حادي الأرواح إلى بلاد الأفراح» 1/98</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ha#s29a64\">Bude a cikin tafsiri mai mu&#x27;amala (cikakkun rubutu)</a><div class=\"pn\"><a href=\"/ha/ayah/29-61.html\">Ayar da ta gabata (29:61)</a><a href=\"/ha/ayah/29-67.html\">Aya ta gaba (29:67)</a></div></main><footer class=\"site-foot\"><span>Tafsirin Shehunan Biyu · <a href=\"/ha/\">Shafin farko</a> · <a href=\"/about.html\">Game da aikin</a> · <a href=\"/privacy.html\">Sirri da sharudda</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/29-67.html":"<!doctype html>\n<html lang=\"ha\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsirin Al-Ankaboot 29:67 — bisa ga Ibn Taimiyya da Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Shin, ba su ga cẽwa, lalle Mun sanya Hurumi amintacce ba alhãli kuwa anã fisge mutãne a gẽfensu? Shin, da ɓãtaccen abu suke ĩmãni kuma da ni&#x27;imarAllah suka\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/ha/ayah/29-67.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/29-67.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/29-67.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/29-67.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/29-67.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/29-67.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/29-67.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/29-67.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/29-67.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/29-67.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/29-67.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/29-67.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/29-67.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/29-67.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/29-67.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/29-67.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/29-67.html\">\n<meta property=\"og:title\" content=\"Tafsirin Al-Ankaboot 29:67 — bisa ga Ibn Taimiyya da Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"Shin, ba su ga cẽwa, lalle Mun sanya Hurumi amintacce ba alhãli kuwa anã fisge mutãne a gẽfensu? Shin, da ɓãtaccen abu suke ĩmãni kuma da ni&#x27;imarAllah suka\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Shafin farko\", \"item\": \"https://tafsirshaikhain.com/ha/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Al-Ankaboot\", \"item\": \"https://tafsirshaikhain.com/ha/surah/29.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aya 67\", \"item\": \"https://tafsirshaikhain.com/ha/ayah/29-67.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ha/\">Shafin farko</a> › <a href=\"/ha/surah/29.html\">Sura Al-Ankaboot</a> › Aya 67</nav><h1>Tafsirin Sura Al-Ankaboot 29:67</h1><p class=\"vt ar\" lang=\"ar\">﴿أَوَلَمْ يَرَوْا أَنَّا جَعَلْنَا حَرَمًا آمِنًا وَيُتَخَطَّفُ النَّاسُ مِنْ حَوْلِهِمْ أَفَبِالْبَاطِلِ يُؤْمِنُونَ وَبِنِعْمَةِ اللَّهِ يَكْفُرُونَ﴾</p><section><h3>Fassarar ma&#x27;ana</h3><p class=\"tr\">Shin, ba su ga cẽwa, lalle Mun sanya Hurumi amintacce ba alhãli kuwa anã fisge mutãne a gẽfensu? Shin, da ɓãtaccen abu suke ĩmãni kuma da ni&#x27;imarAllah suka kãfirta?</p><span class=\"cr\" dir=\"ltr\">Hausa Translation - Abu Bakr Jumi — v1.2.2 · QuranEnc.com</span></section><p class=\"cr\">An kawo maganganun limaman biyu da Larabci na asali, kalma bayan kalma, tare da madogara.</p><section><h2>Shaikhul Islam Ibn Taimiyya</h2><blockquote class=\"ar\" lang=\"ar\">فكانوا في الجاهلية يقتل بعضهم بعضا خارج الحرم فإذا دخلوا الحرم أو لقي الرجل قاتل أبيه لم يهجه وكان هذا من الآيات التي جعلها الله فيه<cite>«مجموع الفتاوى» 18/343</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ha#s29a67\">Bude a cikin tafsiri mai mu&#x27;amala (cikakkun rubutu)</a><div class=\"pn\"><a href=\"/ha/ayah/29-64.html\">Ayar da ta gabata (29:64)</a><a href=\"/ha/ayah/29-69.html\">Aya ta gaba (29:69)</a></div></main><footer class=\"site-foot\"><span>Tafsirin Shehunan Biyu · <a href=\"/ha/\">Shafin farko</a> · <a href=\"/about.html\">Game da aikin</a> · <a href=\"/privacy.html\">Sirri da sharudda</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/29-69.html":"<!doctype html>\n<html lang=\"ha\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsirin Al-Ankaboot 29:69 — bisa ga Ibn Taimiyya da Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Kuma wadannan da suka yi ƙõƙari ga nẽman yardarMu, lalle Munã shiryar da su ga hanyõyinMu, kuma lalle Allah, tabbas, Yanã tãre da mãsu kyautatãwa (ga addĩn\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/ha/ayah/29-69.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/29-69.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/29-69.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/29-69.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/29-69.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/29-69.html\">\n<li