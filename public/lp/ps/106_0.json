nt=\"630\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<link rel=\"manifest\" href=\"/manifest.webmanifest\">\n<link rel=\"apple-touch-icon\" href=\"/icon-192.png\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"تفسیر قريش 106:4 — د ابن تیمیه او ابن القیم له مخې\", \"description\": \"هغه چې په لوږه کې يې خواړه ورکړل او له وېرې يې په امن کړل.\", \"inLanguage\": \"ps\", \"url\": \"https://tafsirshaikhain.com/ps/ayah/106-4.html\", \"mainEntityOfPage\": \"https://tafsirshaikhain.com/ps/ayah/106-4.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"شیخ الاسلام ابن تیمیه\"}, {\"@type\": \"Person\", \"name\": \"امام ابن القیم\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"د دوو شیخانو تفسیر\", \"url\": \"https://tafsirshaikhain.com/ps/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"کورپاڼه\", \"item\": \"https://tafsirshaikhain.com/ps/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سورت قريش\", \"item\": \"https://tafsirshaikhain.com/ps/surah/106.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیت 4\", \"item\": \"https://tafsirshaikhain.com/ps/ayah/106-4.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ps/\">کورپاڼه</a> › <a href=\"/ps/surah/106.html\">سورت قريش</a> › آیت 4</nav><h1>تفسیر سورت قريش 106:4</h1><p class=\"vt ar\" lang=\"ar\">﴿الَّذِي أَطْعَمَهُم مِّن جُوعٍ وَآمَنَهُم مِّنْ خَوْفٍ﴾</p><section><h3>د معنا ژباړه</h3><p class=\"tr\">هغه چې په لوږه کې يې خواړه ورکړل او له وېرې يې په امن کړل.</p><span class=\"cr\" dir=\"ltr\">Pashto Translation - Rowwad Translation Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">د دواړو امامانو خبرې په اصلي عربي کې، لکه څنګه چې دي، له مآخذو سره راوړل شوې دي.</p><section><h2>شیخ الاسلام ابن تیمیه</h2><blockquote class=\"ar\" lang=\"ar\">وقال تعالى: {فليعبدوا رب هذا البيت} {الذي أطعمهم من جوع وآمنهم من خوف} وقال تعالى: {أولم نمكن لهم حرما آمنا يجبى إليه ثمرات كل شيء} فكانوا في الجاهلية يقتل بعضهم بعضا خارج الحرم فإذا دخلوا الحرم أو لقي الرجل قاتل أبيه لم يهجه وكان هذا من الآيات التي جعلها الله فيه<cite>«مجموع الفتاوى» 18/343</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ps#s106a4\">په تعاملي تفسیر کې یې پرانیزئ (بشپړ متنونه)</a><div class=\"pn\"><a href=\"/ps/ayah/106-3.html\">مخکینی آیت (106:3)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/106-4.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/106-4.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/106-4.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/106-4.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Baha