.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ps/\">کورپاڼه</a> › <a href=\"/ps/surah/69.html\">سورت الحاقة</a> › آیت 50</nav><h1>تفسیر سورت الحاقة 69:50</h1><p class=\"vt ar\" lang=\"ar\">﴿وَإِنَّهُ لَحَسْرَةٌ عَلَى الْكَافِرِينَ﴾</p><section><h3>د معنا ژباړه</h3><p class=\"tr\">او هغه پر کافرانو پښېماني ده</p><span class=\"cr\" dir=\"ltr\">Pashto Translation - Rowwad Translation Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">د دواړو امامانو خبرې په اصلي عربي کې، لکه څنګه چې دي، له مآخذو سره راوړل شوې دي.</p><section><h2>امام ابن القیم</h2><blockquote class=\"ar\" lang=\"ar\">ثم أخبر سبحانه أن رسوله وكلامه حسرة على الكافرين إذا عاينوا حقيقة ما أخبر به كان تكذيبهم عليهم من أعظم الحسرات حين لا ينفعهم التحسر<cite>«التبيان في أقسام القرآن» 1/191</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ps#s69a50\">په تعاملي تفسیر کې یې پرانیزئ (بشپړ متنونه)</a><div class=\"pn\"><a href=\"/ps/ayah/69-49.html\">مخکینی آیت (69:49)</a><a href=\"/ps/ayah/69-51.html\">راتلونکی آیت (69:51)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/69-50.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/69-50.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/69-50.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/69-50.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/69-50.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/69-50.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/69-50.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/69-50.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Ba