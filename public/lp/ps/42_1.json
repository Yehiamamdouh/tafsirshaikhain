est\" href=\"/manifest.webmanifest\">\n<link rel=\"apple-touch-icon\" href=\"/icon-192.png\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"تفسیر الشورى 42:50 — د ابن تیمیه او ابن القیم له مخې\", \"description\": \"يا جوړه نارينه او ښځينه وركوي، او چا ته يې چې خوښه شي شنډوي يې، بېشكه هغه ډېر پوه قادر دى.\", \"inLanguage\": \"ps\", \"url\": \"https://tafsirshaikhain.com/ps/ayah/42-50.html\", \"mainEntityOfPage\": \"https://tafsirshaikhain.com/ps/ayah/42-50.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"شیخ الاسلام ابن تیمیه\"}, {\"@type\": \"Person\", \"name\": \"امام ابن القیم\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"د دوو شیخانو تفسیر\", \"url\": \"https://tafsirshaikhain.com/ps/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"کورپاڼه\", \"item\": \"https://tafsirshaikhain.com/ps/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سورت الشورى\", \"item\": \"https://tafsirshaikhain.com/ps/surah/42.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیت 50\", \"item\": \"https://tafsirshaikhain.com/ps/ayah/42-50.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ps/\">کورپاڼه</a> › <a href=\"/ps/surah/42.html\">سورت الشورى</a> › آیت 50</nav><h1>تفسیر سورت الشورى 42:50</h1><p class=\"vt ar\" lang=\"ar\">﴿أَوْ يُزَوِّجُهُمْ ذُكْرَانًا وَإِنَاثًا وَيَجْعَلُ مَن يَشَاءُ عَقِيمًا إِنَّهُ عَلِيمٌ قَدِيرٌ﴾</p><section><h3>د معنا ژباړه</h3><p class=\"tr\">يا جوړه نارينه او ښځينه وركوي، او چا ته يې چې خوښه شي شنډوي يې، بېشكه هغه ډېر پوه قادر دى.</p><span class=\"cr\" dir=\"ltr\">Pashto Translation - Rowwad Translation Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">د دواړو امامانو خبرې په اصلي عربي کې، لکه څنګه چې دي، له مآخذو سره راوړل شوې دي.</p><section><h2>شیخ الاسلام ابن تیمیه</h2><blockquote class=\"ar\" lang=\"ar\">والزوج أعم من النكاح المعروف قال تعالى: {يهب لمن يشاء إناثا ويهب لمن يشاء الذكور} {أو يزوجهم ذكرانا وإناثا}<cite>«مجموع الفتاوى» 15/326</cite></blockquote></section><section><h2>امام ابن القیم</h2><blockquote class=\"ar\" lang=\"ar\">وأما الإذكار والإيناث: فليس بسبب طبيعي، وإنما سببه: الفاعل المختار الذي يأمر الملك به، مع تقدير الشقاوة والسعادة، والرزق، والأجل، ولذلك جمع بين هذه الأربع في الحديث «فيقول الملك: يا رب، ذكر؟ يا رب، أنثى؟ فيقضي ربك ما شاء، ويكتب الملك» . وقد رد سبحانه ذلك إلى محض مشيئته في قوله تعالى: {يهب لمن يشاء إناثا ويهب لمن يشاء الذكور} [الشورى: 49] {أو يزوجهم ذكرانا وإناثا ويجعل من يشاء عقيما} [الشورى: 50] .<cite>«الطرق الحكمية» 1/185</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ps#s42a50\">په تعاملي تفسیر کې یې پرانیزئ (بشپړ متنونه)</a><div class=\"pn\"><a href=\"/ps/ayah/42-49.html\">مخکینی آیت (42:49)</a><a href=\"/ps/ayah/42-51.html\">راتلونکی آیت (42:51)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/42-50.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/42-50.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/42-50.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/42-50.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/42-50.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/42-50.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/42-50.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/42-50.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/42-50.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/42-50.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/42-50.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/42-50.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/42-50.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/42-50.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/42-50.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a> · <a href=\"/hi/ayah/42-50.html\" hreflang=\"hi\" lang=\"hi\" data-l=\"hi\">हिन्दी</a> · <b lang=\"ps\">پښتو</b> · <a href=\"/so/ayah/42-50.html\" hreflang=\"so\" lang=\"so\" data-l=\"so\">Soomaali</a> · <a href=\"/uz/ayah/42-50.html\" hreflang=\"uz\" lang=\"uz\" data-l=\"uz\">Ўзбекча</a> · <a href=\"/ku/ayah/42-50.html\" hreflang=\"ku\" lang=\"ku\" data-l=\"ku\">کوردی</a> · <a href=\"/az/ayah/42-50.html\" hreflang=\"az\" lang=\"az\" data-l=\"az\">Azərbaycanca</a> · <a href=\"/bs/ayah/42-50.html\" hreflang=\"bs\" lang=\"bs\" data-l=\"bs\">Bosanski</a> · <a href=\"/