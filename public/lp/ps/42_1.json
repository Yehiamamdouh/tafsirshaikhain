"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سورت الشورى\", \"item\": \"https://tafsirshaikhain.com/ps/surah/42.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیت 52\", \"item\": \"https://tafsirshaikhain.com/ps/ayah/42-52.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ps/\">کورپاڼه</a> › <a href=\"/ps/surah/42.html\">سورت الشورى</a> › آیت 52</nav><h1>تفسیر سورت الشورى 42:52</h1><p class=\"vt ar\" lang=\"ar\">﴿وَكَذَٰلِكَ أَوْحَيْنَا إِلَيْكَ رُوحًا مِّنْ أَمْرِنَا مَا كُنتَ تَدْرِي مَا الْكِتَابُ وَلَا الْإِيمَانُ وَلَٰكِن جَعَلْنَاهُ نُورًا نَّهْدِي بِهِ مَن نَّشَاءُ مِنْ عِبَادِنَا وَإِنَّكَ لَتَهْدِي إِلَىٰ صِرَاطٍ مُّسْتَقِيمٍ﴾</p><section><h3>د معنا ژباړه</h3><p class=\"tr\">همدارنګه وحې وکړه موږ تا ته د قران پخپل حکم او ته نه پوهیدې [مخکې له دې وحې] چې کتاب څه دی او ایمان څه دی؟ لیکن وګرځاوه موږ دا کتاب رڼا چې هدایت کوو چا ته یې چې وغواړو د خپلو بنده ګانو څخه او بیشکه ته ښودنه کوې د نیغې لارې.</p><span class=\"cr\" dir=\"ltr\">Pashto Translation - Rowwad Translation Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">د دواړو امامانو خبرې په اصلي عربي کې، لکه څنګه چې دي، له مآخذو سره راوړل شوې دي.</p><section><h2>شیخ الاسلام ابن تیمیه</h2><blockquote class=\"ar\" lang=\"ar\">وقيل الضمير في قوله: {جعلناه نورا نهدي به من نشاء من عبادنا} يعود إلى الإيمان ذكر ذلك عن ابن عباس. وقيل: إلى القرآن. وهو قول السدي وهو يتناولهما وهو في اللفظ يعود إلى الروح الذي أوحاه وهو الوحي الذي جاء بالإيمان والقرآن. فقد تبين أن كلاهما من الله نور وهدى ومنه هذا يعقل بالقلب؛ لما قد يشاهد من دلائل الإيمان مثل دلائل الربوبية والنبوة وهذا يسمع بالآذان<cite>«مجموع الفتاوى» 15/73</cite></blockquote><h3>هغه څه چې ده له نورو نقل کړي</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن عباس والسدي</span> <span class=\"st\">أقرّه</span> «يعود إلى الإيمان ذكر ذلك عن ابن عباس. وقيل: إلى القرآن. وهو قول السدي»<cite>«مجموع الفتاوى» 15/73</cite></blockquote></section><section><h2>امام ابن القیم</h2><blockquote class=\"ar\" lang=\"ar\">فأخبر أنه روح تحصل به الحياة، وأنه نور تحصل به الإضاءة<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 3/243</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وقال تعالى: {وكذلك أوحينا إليك روحا من أمرنا ما كنت تدري ما الكتاب ولا الإيمان ولكن جعلناه نورا نهدي به من نشاء من عبادنا} [الشورى: 52] . فجعله روحا لما يحصل به من حياة القلوب والأرواح. ونورا لما يحصل به من الهدى والرشاد.<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 3/155</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ps#s42a52\">په تعاملي تفسیر کې یې پرانیزئ (بشپړ متنونه)</a><div class=\"pn\"><a href=\"/ps/ayah/42-51.html\">مخکینی آیت (42:51)</a><a href=\"/ps/ayah/42-53.html\">راتلونکی آیت (42:53)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/42-52.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/42-52.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a hr