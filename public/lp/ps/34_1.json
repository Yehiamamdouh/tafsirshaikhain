\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"کورپاڼه\", \"item\": \"https://tafsirshaikhain.com/ps/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"سورت سبإ\", \"item\": \"https://tafsirshaikhain.com/ps/surah/34.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"آیت 51\", \"item\": \"https://tafsirshaikhain.com/ps/ayah/34-51.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.muy{display:grid;gap:6px;background:var(--sheet,#fff);border:1px dashed var(--line,#d9dee6);border-inline-start:4px solid var(--muted,#5b6676);border-radius:10px;padding:12px 14px;margin:4px 0}.muy-head{display:flex;flex-wrap:wrap;gap:4px 10px;align-items:baseline}.muy-head b{font-family:var(--f-display,sans-serif);font-weight:600;font-size:15px}.muy-head small{font-size:12.5px;color:var(--muted,#5b6676)}.muy-text{margin:0;font-family:var(--f-read,serif);font-size:17px;line-height:1.95;overflow-wrap:anywhere}.muy-fn{margin:0;font-size:14px;line-height:1.7;color:var(--muted,#5b6676);white-space:pre-line}.muy-credit{font-size:12px;color:var(--muted,#5b6676);overflow-wrap:anywhere}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ps/\">کورپاڼه</a> › <a href=\"/ps/surah/34.html\">سورت سبإ</a> › آیت 51</nav><h1>تفسیر سورت سبإ 34:51</h1><p class=\"vt ar\" lang=\"ar\">﴿وَلَوْ تَرَىٰ إِذْ فَزِعُوا فَلَا فَوْتَ وَأُخِذُوا مِن مَّكَانٍ قَرِيبٍ﴾</p><section><h3>د معنا ژباړه</h3><p class=\"tr\">که چیرته تا (دا حالت) لیدلای (ای مخاطبه!) چې كله ووېريږي [ملک الموت یا عذاب ورته راشۍ] پټېدلای به نه شي، او په كوم نېږدې ځاى كې به راګير كړى شي.</p><span class=\"cr\" dir=\"ltr\">Pashto Translation - Rowwad Translation Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">د دواړو امامانو خبرې په اصلي عربي کې، لکه څنګه چې دي، له مآخذو سره راوړل شوې دي.</p><section><h2>شیخ الاسلام ابن تیمیه</h2><blockquote class=\"ar\" lang=\"ar\">وهو سبحانه يذكر جواب القسم تارة وهو الغالب. وتارة يحذفه كما يحذف جواب لو كثيرا كقوله تعالى: {لو تعلمون علم اليقين} وقوله: {ولو أن قرآنا سيرت به الجبال} {ولو ترى إذ يتوفى الذين كفروا الملائكة} {ولو ترى إذ فزعوا فلا فوت} {ولو ترى إذ وقفوا على النار} {ولو ترى إذ وقفوا على ربهم} . ومثل هذا حذفه من أحسن الكلام؛ لأن المراد أنك لو رأيته لرأيت هولا عظيما<cite>«مجموع الفتاوى» 13/315</cite></blockquote></section><section><h2>امام ابن القیم</h2><h3>هغه څه چې ده له نورو نقل کړي</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">شيخه ابن تيمية (فصل أقسام القرآن، مجموع الفتاوى 13/314-316)</span> <span class=\"st\">أقرّه</span> «قوله تعالى {ولو يرى الذين ظلموا إذ يرون العذاب أن القوة لله جميعا وأن الله شديد العذاب} فالمعنى في أظهر الوجهين لو يرى الذين ظلموا في الدنيا إذ يرون العذاب في الآخرة والجواب محذوف ثم قال {أن القوة لله جميعا} كما قال تعالى {ولو ترى إذ فزعوا فلا فوت} {ولو ترى إذ يتوفى الذين كفروا الملائكة} أي لو ترى ذلك الوقت وما فيه»<cite>«التبيان في أقسام القرآن» 1/3</cite></blockquote></section><div class=\"muy\"><div class=\"muy-head\"><b>المختصر في تفسیر القرآن الکریم</b><small>د آیت عمومي معنا — د دواړو شیخانو خبرې نه دي</small></div><p class=\"muy-text\">او ای رسوله! که ته ووينې چې دغه درواغ ګڼونکي وېريږي کله چې هغوی د قيامت په ورځ عذاب وويني، چې هغوی لره به ترې هيڅ د تېښتې ځای نه وي او نه به پناه ځای وي چې پناه ور وړي، او له نېږدې ځایه را ونيول شي چې په لومړي پړاو کې يې را نيول آسانه وي، که چېرې ته دغه ووينې نو يو عجيب امر به ووينې.</p><a class=\"muy-credit\" href=\"https://quranenc.com/en/browse/pashto_mokhtasar\" target=\"_blank\" rel=\"noopener\" dir=\"ltr\">Pashto Translation of Al-Mukhtasar in Interpreting the Noble Quran — 2026-11-04 · QuranEnc.com</a></div><a class=\"btn pri open\" href=\"/tafsir.html?lang=ps#s34a51\">په تعاملي تفسیر کې یې پرانیزئ (بشپړ متنونه)</a><div class=\"pn\"><a href=\"/ps/ayah/34-50.html\">مخکینی آیت (34:50)</a><a href=\"/ps/ayah/34-54.html\">راتلونکی آیت (34:54)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/34-51.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/34-51.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/34-51.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/34-51.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/34-51.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/34-51.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/34-51.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/34-51.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/34-51.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/34-51.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/34-51.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/34-51.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/34-51.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a