\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/sw/\">Mwanzo</a> › <a href=\"/sw/surah/109.html\">Sura Al-Kaafiroon</a> › Aya 6</nav><h1>Tafsiri ya Sura Al-Kaafiroon 109:6</h1><p class=\"vt ar\" lang=\"ar\">﴿لَكُمْ دِينُكُمْ وَلِيَ دِينِ﴾</p><section><h3>Tafsiri ya maana</h3><p class=\"tr\">Nyinyi mna dini yenu, nami nina Dini yangu.</p><span class=\"cr\" dir=\"ltr\">Swahili Translation - Ali Mohsin Al-Barwani — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Maneno ya maimamu wawili yametolewa kwa Kiarabu asilia, neno kwa neno, pamoja na marejeo.</p><section><h2>Sheikh al-Islam Ibn Taymiyyah</h2><blockquote class=\"ar\" lang=\"ar\">{لكم دينكم ولي دين} خطاب لكل كافر وإن أسلم فيما بعد.<cite>«مجموع الفتاوى» 16/543</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وبهذا يظهر خطأ من قال إنه خطاب للمشركين والنصارى دون اليهود<cite>«مجموع الفتاوى» 16/564</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=sw#s109a6\">Fungua katika tafsiri shirikishi (maandiko kamili)</a><div class=\"pn\"><a href=\"/sw/ayah/109-5.html\">Aya iliyotangulia (109:5)</a></div></main><footer class=\"site-foot\"><span>Tafsiri ya Masheikh Wawili · <a href=\"/sw/\">Mwanzo</a> · <a href=\"/about.html\">Kuhusu mradi</a> · <a href=\"/privacy.html\">Faragha na masharti</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/109.html":"<!doctype html>\n<html lang=\"sw\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsiri ya Sura Al-Kaafiroon — kwa mujibu wa Ibn Taymiyyah na Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"