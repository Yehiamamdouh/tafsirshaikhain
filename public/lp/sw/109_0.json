rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/109-3.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/109-3.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/109-3.html\">\n<meta property=\"og:title\" content=\"Tafsiri ya Al-Kaafiroon 109:3 — kwa mujibu wa Ibn Taymiyyah na Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"Wala nyinyi hamuabudu ninaye muabudu.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/sw/\">Mwanzo</a> › <a href=\"/sw/surah/109.html\">Sura Al-Kaafiroon</a> › Aya 3</nav><h1>Tafsiri ya Sura Al-Kaafiroon 109:3</h1><p class=\"vt ar\" lang=\"ar\">﴿وَلَا أَنتُمْ عَابِدُونَ مَا أَعْبُدُ﴾</p><section><h3>Tafsiri ya maana</h3><p class=\"tr\">Wala nyinyi hamuabudu ninaye muabudu.</p><span class=\"cr\" dir=\"ltr\">Swahili Translation - Ali Mohsin Al-Barwani — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Maneno ya maimamu wawili yametolewa kwa Kiarabu asilia, neno kwa neno, pamoja na marejeo.</p><section><h2>Sheikh al-Islam Ibn Taymiyyah</h2><blockquote class=\"ar\" lang=\"ar\">و &quot; ما &quot; فيها عموم وإجمال يصلح لما لا يعلم ولصفات من يعلم كقوله تعالى: {لا أعبد ما تعبدون} {ولا أنتم عابدون ما أعبد} وقوله {فانكحوا ما طاب لكم من النساء} .<cite>«مجموع الفتاوى» 16/228</cite></blockquote></section><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">قيل: هي في هذا كله على أصلها من الإبهام والوقوع على الجنس العام لما يراد بما ما يراد بمن من التعيين لما يعقل والاختصاص دون الشيوع<cite>«بدائع الفوائد» 1/132</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=sw#s109a3\">Fungua katika tafsiri shirikishi (maandiko kamili)</a><div class=\"pn\"><a href=\"/sw/ayah/109-2.html\">Aya iliyotangulia (109:2)</a><a href=\"/sw/ayah/109-5.html\">Aya inayofuata (109:5)</a></div></main><footer class=\"site-foot\"><span>Tafsiri ya Masheikh Wawili · <a href=\"/sw/\">Mwanzo</a> · <a href=\"/about.html\">Kuhusu mradi</a> · <a href=\"/privacy.html\">Faragha na masharti</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/109-5.html":"<!doctype html>\n<html lang=\"sw\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsiri ya Al-Kaafiroon 109:5 — kwa mujibu wa Ibn Taymiyyah na Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Wala nyinyi hamuabudu ninaye muabudu.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/sw/ayah/109-5.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/109-5.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/109-5.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/109-5.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/109-5.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/109-5.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/109-5.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/109-5.html\">\n<link rel=\"alternate\" hreflang=