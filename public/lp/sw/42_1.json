.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"Sheikh al-Islam Ibn Taymiyyah\"}, {\"@type\": \"Person\", \"name\": \"Imam Ibn al-Qayyim\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"Tafsiri ya Masheikh Wawili\", \"url\": \"https://tafsirshaikhain.com/sw/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Mwanzo\", \"item\": \"https://tafsirshaikhain.com/sw/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Ash-Shura\", \"item\": \"https://tafsirshaikhain.com/sw/surah/42.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aya 51\", \"item\": \"https://tafsirshaikhain.com/sw/ayah/42-51.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/sw/\">Mwanzo</a> › <a href=\"/sw/surah/42.html\">Sura Ash-Shura</a> › Aya 51</nav><h1>Tafsiri ya Sura Ash-Shura 42:51</h1><p class=\"vt ar\" lang=\"ar\">﴿وَمَا كَانَ لِبَشَرٍ أَن يُكَلِّمَهُ اللَّهُ إِلَّا وَحْيًا أَوْ مِن وَرَاءِ حِجَابٍ أَوْ يُرْسِلَ رَسُولًا فَيُوحِيَ بِإِذْنِهِ مَا يَشَاءُ إِنَّهُ عَلِيٌّ حَكِيمٌ﴾</p><section><h3>Tafsiri ya maana</h3><p class=\"tr\">Na haikuwa kwa mwanaadamu kwamba Mwenyezi Mungu amsemeze ila kwa Wahyi (Ufunuo), au kwa nyuma ya pazia, au kumtuma Mjumbe. Naye humfunulia ayatakayo kwa idhini yake. Hakika Yeye ni Mtukufu, Mwenye hikima.</p><span class=\"cr\" dir=\"ltr\">Swahili Translation - Ali Mohsin Al-Barwani — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Maneno ya maimamu wawili yametolewa kwa Kiarabu asilia, neno kwa neno, pamoja na marejeo.</p><section><h2>Sheikh al-Islam Ibn Taymiyyah</h2><blockquote class=\"ar\" lang=\"ar\">فبين سبحانه أن التكليم تارة يكون وحيا<cite>«مجموع الفتاوى» 12/300</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وتارة من وراء حجاب كما كلم موسى وتارة يرسل رسولا فيوحي الرسول بإذن الله ما يشاء<cite>«مجموع الفتاوى» 12/300</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فدل على أن التكليم من وراء حجاب - كما كلم موسى - أمر غير الإيحاء.<cite>«مجموع الفتاوى» 12/129</cite></blockquote></section><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">فجعل الوحي في هذه الآية قسما من أقسام التكليم، وجعله في آية النساء قسيما للتكليم، وذلك باعتبارين، فإنه قسيم التكليم الخاص الذي هو بلا واسطة، وقسم من التكليم العام الذي هو إيصال المعنى بطرق متعددة.<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/62</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=sw#s42a51\">Fungua katika tafsiri shirikishi (maandiko kamili)</a><div class=\"pn\"><a href=\"/sw/ayah/42-50.html\">Aya iliyotangulia (42:50)</a><a href=\"/sw/ayah/42-52.html\">Aya inayofuata (42:52)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/42-51.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/42-51.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/42-51.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/42-51.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/42-51.html\" hreflang=\"tr\" 