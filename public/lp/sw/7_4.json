item\": \"https://tafsirshaikhain.com/sw/surah/7.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aya 201\", \"item\": \"https://tafsirshaikhain.com/sw/ayah/7-201.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/sw/\">Mwanzo</a> › <a href=\"/sw/surah/7.html\">Sura Al-A&#x27;raaf</a> › Aya 201</nav><h1>Tafsiri ya Sura Al-A&#x27;raaf 7:201</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّ الَّذِينَ اتَّقَوْا إِذَا مَسَّهُمْ طَائِفٌ مِّنَ الشَّيْطَانِ تَذَكَّرُوا فَإِذَا هُم مُّبْصِرُونَ﴾</p><section><h3>Tafsiri ya maana</h3><p class=\"tr\">Hakika wale wamchaomungu zinapowagusa pepesi za Shetani, mara huzindukana na hapo huwa niwenye kuiyona haki</p><span class=\"cr\" dir=\"ltr\">Swahili Translation - Ali Mohsin Al-Barwani — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Maneno ya maimamu wawili yametolewa kwa Kiarabu asilia, neno kwa neno, pamoja na marejeo.</p><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">والتذكر: تفعل من الذكر، وهو حضور صورة من المذكور في القلب<cite>«إعلام الموقعين عن رب العالمين» 1/112</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فإذا استحضره القلب وشاهده على وجهه أوجب له البصيرة، فأبصر ما جعل دليلا عليه،<cite>«إعلام الموقعين عن رب العالمين» 1/112</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=sw#s7a201\">Fungua katika tafsiri shirikishi (maandiko kamili)