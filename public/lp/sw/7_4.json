name\": \"Sura Al-A'raaf\", \"item\": \"https://tafsirshaikhain.com/sw/surah/7.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aya 206\", \"item\": \"https://tafsirshaikhain.com/sw/ayah/7-206.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/sw/\">Mwanzo</a> › <a href=\"/sw/surah/7.html\">Sura Al-A&#x27;raaf</a> › Aya 206</nav><h1>Tafsiri ya Sura Al-A&#x27;raaf 7:206</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّ الَّذِينَ عِندَ رَبِّكَ لَا يَسْتَكْبِرُونَ عَنْ عِبَادَتِهِ وَيُسَبِّحُونَهُ وَلَهُ يَسْجُدُونَ﴾</p><section><h3>Tafsiri ya maana</h3><p class=\"tr\">Hakika wale walioko kwa Mola wako Mlezi hawajivuni wakaacha kumuabdu, na wanamtakasa na wanamsujudia</p><span class=\"cr\" dir=\"ltr\">Swahili Translation - Ali Mohsin Al-Barwani — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Maneno ya maimamu wawili yametolewa kwa Kiarabu asilia, neno kwa neno, pamoja na marejeo.</p><section><h2>Sheikh al-Islam Ibn Taymiyyah</h2><blockquote class=\"ar\" lang=\"ar\">وهذا ونحوه مما فيه وصف أكابر المخلوقات بالعبادة وذم من خرج عن ذلك<cite>«مجموع الفتاوى» 10/177</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فلو كان موجب العندية معنى عاما كدخولهم تحت قدرته ومشيئته وأمثال ذلك: لكان كل مخلوق عنده؛ ولم يكن أحد مستكبرا عن عبادته بل مسبحا له ساجدا<cite>«مجموع الفتاوى» 5/165</cite></blockquote></section><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">ففرق بين من له عموما ومن عنده من مماليكه وعبيده خصوصا،<cite>«إعلام الموقعين عن رب العالمين» 2/215</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=sw#s7a206\">Fungua katika tafsiri shirikishi (maandiko kamili)</a><div class=\"pn\"><a href=\"/sw/ayah/7-205.html\">Aya iliyotangulia (7:205)</a></div></main><footer class=\"site-foot\"><span>Tafsiri ya Masheikh Wawili · <a href=\"/sw/\">Mwanzo</a> · <a href=\"/about.html\">Kuhusu mradi</a> · <a href=\"/privacy.html\">Faragha na masharti</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}