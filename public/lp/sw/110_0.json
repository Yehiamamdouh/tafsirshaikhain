w.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/sw/\">Mwanzo</a> › <a href=\"/sw/surah/110.html\">Sura An-Nasr</a> › Aya 3</nav><h1>Tafsiri ya Sura An-Nasr 110:3</h1><p class=\"vt ar\" lang=\"ar\">﴿فَسَبِّحْ بِحَمْدِ رَبِّكَ وَاسْتَغْفِرْهُ إِنَّهُ كَانَ تَوَّابًا﴾</p><section><h3>Tafsiri ya maana</h3><p class=\"tr\">Zitakase sifa za Mola wako Mlezi, na umwombe msamaha; hakika Yeye ndiye anaye pokea toba.</p><span class=\"cr\" dir=\"ltr\">Swahili Translation - Ali Mohsin Al-Barwani — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Maneno ya maimamu wawili yametolewa kwa Kiarabu asilia, neno kwa neno, pamoja na marejeo.</p><section><h2>Sheikh al-Islam Ibn Taymiyyah</h2><blockquote class=\"ar\" lang=\"ar\">فكان هذا الكلام تأويل قوله: {فسبح بحمد ربك واستغفره}<cite>«مجموع الفتاوى» 17/369</cite></blockquote></section><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">فعلم أن المأمور به من ذلك التسبيح بعد الفتح ودخول الناس في هذا الدين أمر أكبر من ذلك المتقدم، وذلك مقدمة بين يدي انتقاله إلى الرفيق الأعلى.<cite>«إعلام الموقعين عن رب العالمين» 1/266</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=sw#s110a3\">Fungua katika tafsiri shirikishi (maandiko kamili)</a><div class=\"pn\"><a href=\"/sw/ayah/110-2.html\">Aya iliyotangulia (110:2)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/110-3.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/110-3.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/110-3.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/110-3.html\" hreflang=\"id\" lang=\"id\" data-l=\"id