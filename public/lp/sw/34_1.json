com/sw/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Saba\", \"item\": \"https://tafsirshaikhain.com/sw/surah/34.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aya 51\", \"item\": \"https://tafsirshaikhain.com/sw/ayah/34-51.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/sw/\">Mwanzo</a> › <a href=\"/sw/surah/34.html\">Sura Saba</a> › Aya 51</nav><h1>Tafsiri ya Sura Saba 34:51</h1><p class=\"vt ar\" lang=\"ar\">﴿وَلَوْ تَرَىٰ إِذْ فَزِعُوا فَلَا فَوْتَ وَأُخِذُوا مِن مَّكَانٍ قَرِيبٍ﴾</p><section><h3>Tafsiri ya maana</h3><p class=\"tr\">Na lau ungeli ona watapo babaika, basi hapana pa kukimbilia! Na watakamatwa mahala pa karibu.</p><span class=\"cr\" dir=\"ltr\">Swahili Translation - Ali Mohsin Al-Barwani — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Maneno ya maimamu wawili yametolewa kwa Kiarabu asilia, neno kwa neno, pamoja na marejeo.</p><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">كما قال تعالى {ولو ترى إذ فزعوا فلا فوت} {ولو ترى إذ يتوفى الذين كفروا الملائكة} أي لو ترى ذلك الوقت وما فيه<cite>«التبيان في أقسام القرآن» 1/3</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=sw#s34a51\">Fungua katika tafsiri shirikishi (maandiko kamili)</a><div class=\"pn\"><a href=\"/sw/ayah/34-50.html\">Aya iliyotangulia (34:50)</a></div></main><footer class=\"site-foot\"><span>Tafsiri ya Masheikh Wawili · <a href=\"/sw/\">Mwanzo</a> · <a href=\"/about.html\">Kuhusu mradi</a> · <a href=\"/privacy.html\">Faragha na masharti</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}