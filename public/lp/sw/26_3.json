ment\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Mwanzo\", \"item\": \"https://tafsirshaikhain.com/sw/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Ash-Shu'araa\", \"item\": \"https://tafsirshaikhain.com/sw/surah/26.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aya 196\", \"item\": \"https://tafsirshaikhain.com/sw/ayah/26-196.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/sw/\">Mwanzo</a> › <a href=\"/sw/surah/26.html\">Sura Ash-Shu&#x27;araa</a> › Aya 196</nav><h1>Tafsiri ya Sura Ash-Shu&#x27;araa 26:196</h1><p class=\"vt ar\" lang=\"ar\">﴿وَإِنَّهُ لَفِي زُبُرِ الْأَوَّلِينَ﴾</p><section><h3>Tafsiri ya maana</h3><p class=\"tr\">Na hakika bila ya shaka haya yamo katika Vitabu vya kale.</p><span class=\"cr\" dir=\"ltr\">Swahili Translation - Ali Mohsin Al-Barwani — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Maneno ya maimamu wawili yametolewa kwa Kiarabu asilia, neno kwa neno, pamoja na marejeo.</p><section><h2>Sheikh al-Islam Ibn Taymiyyah</h2><blockquote class=\"ar\" lang=\"ar\">فإن المراد بذلك ذكره وكتابته.<cite>«مجموع الفتاوى» 12/386</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">و &quot; الزبر &quot; جمع زبور والزبور فعول بمعنى مفعول أي مزبور أي: مكتوب فلفظ الزبور يدل على الكتابة<cite>«مجموع الفتاوى» 12/386</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فالقرآن نفسه ليس عند بني إسرائيل ولكن ذكره كما أن محمدا نفسه ليس عندهم ولكن ذكره فثبوت الرسول في كتبهم كثبوت القرآن في كتبهم؛ بخلاف ثبوت القرآن في اللوح المحفوظ وفي المصاحف؛ فإن نفس القرآن أثبت فيها<cite>«مجموع الفتاوى» 12/290</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=sw#s26a196\">Fungua katika tafsiri shirikishi (maandiko kamili)</a><div class=\"pn\"><a href=\"/sw/ayah/26-193.html\">Aya iliyotangulia (26:193)</a><a href=\"/sw/ayah/26-200.html\">Aya inayofuata (26:200)</a></div></main><footer class=\"site-foot\"><span>Tafsiri ya Masheikh Wawili · <a href=\"/sw/\">Mwanzo</a> · <a href=\"/about.html\">Kuhusu mradi</a> · <a href=\"/privacy.html\">Faragha na masharti</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}