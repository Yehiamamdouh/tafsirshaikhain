ntent=\"Tafsiri ya Al-Muddaththir 74:4 — kwa mujibu wa Ibn Taymiyyah na Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"Na nguo zako, zisafishe.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Mwanzo\", \"item\": \"https://tafsirshaikhain.com/sw/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Al-Muddaththir\", \"item\": \"https://tafsirshaikhain.com/sw/surah/74.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aya 4\", \"item\": \"https://tafsirshaikhain.com/sw/ayah/74-4.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/sw/\">Mwanzo</a> › <a href=\"/sw/surah/74.html\">Sura Al-Muddaththir</a> › Aya 4</nav><h1>Tafsiri ya Sura Al-Muddaththir 74:4</h1><p class=\"vt ar\" lang=\"ar\">﴿وَثِيَابَكَ فَطَهِّرْ﴾</p><section><h3>Tafsiri ya maana</h3><p class=\"tr\">Na nguo zako, zisafishe.</p><span class=\"cr\" dir=\"ltr\">Swahili Translation - Ali Mohsin Al-Barwani — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Maneno ya maimamu wawili yametolewa kwa Kiarabu asilia, neno kwa neno, pamoja na marejeo.</p><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">فكنى عن النفس بالثوب.<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 2/22</cite></blockquote><h3>Aliyoyanukuu kutoka kwa wengine</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">قتادة ومجاهد</span> <span class=\"st\">أقرّه</span> «نفسك فطهر من الذنب. فكنى عن النفس بالثوب. وهذا قول إبراهيم، النخعي والضحاك، والشعبي، والزهري، والمحققين من أهل التفسير»<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 2/22</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن عباس</span> <span class=\"st\">أقرّه</span> «لا تلبسها على معصية ولا غدر.»<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 2/22</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">قتادة ومجاهد</span> <span class=\"st\">أقرّه</span> «قال قتادة ومجاهد: نفسك فطهر من الذنب.»<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 2/22</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">إبراهيم النخعي والضحاك والشعبي والزهري والمحققون من أهل التفسير</span> <span class=\"st\">أقرّه</span> «وهذا قول إبراهيم، النخعي والضحاك، والشعبي، والزهري، والمحققين من أهل التفسير.»<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 2/22</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=sw#s74a4\">Fungua katika tafsiri shirikishi (maandiko kamili)</a><div class=\"pn\"><span></span><a href=\"/sw/ayah/74-6.html\">Aya inayofuata (74:6)</a></div></main><footer class=\"site-foot\"><span>Tafsiri ya Masheikh Wawili · <a href=\"/sw/\">Mwanzo</a> · <a href=\"/about.html\">Kuhusu mradi</a> · <a href=\"/privacy.html\">Faragha na masharti</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/74-6.html":"<!doctype html>\n<html lang=\"sw\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsiri ya Al-Muddaththir 74:6 — kwa mujibu wa Ibn Taymiyyah na Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Wala usitoe kwa kutaraji kuzidishiwa.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/sw/ayah/74-6.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/74-6.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/74-6.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/74-6.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/74-6.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/74-6.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/74-6.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/74-6.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/74-6.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/74-6.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/74-6.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/74-6.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/74-6.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/74-6.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/74-6.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/74-6.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/74-6.html\">\n<meta property=\"og:title\" content=\"Tafsiri ya Al-Muddaththir 74:6 — kwa mujibu wa Ibn Taymiyyah na Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"Wala usitoe kwa kutaraji k