o\", \"item\": \"https://tafsirshaikhain.com/sw/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Al-Maa'un\", \"item\": \"https://tafsirshaikhain.com/sw/surah/107.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aya 5\", \"item\": \"https://tafsirshaikhain.com/sw/ayah/107-5.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/sw/\">Mwanzo</a> › <a href=\"/sw/surah/107.html\">Sura Al-Maa&#x27;un</a> › Aya 5</nav><h1>Tafsiri ya Sura Al-Maa&#x27;un 107:5</h1><p class=\"vt ar\" lang=\"ar\">﴿الَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ﴾</p><section><h3>Tafsiri ya maana</h3><p class=\"tr\">Ambao wanapuuza Sala zao;</p><span class=\"cr\" dir=\"ltr\">Swahili Translation - Ali Mohsin Al-Barwani — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Maneno ya maimamu wawili yametolewa kwa Kiarabu asilia, neno kwa neno, pamoja na marejeo.</p><section><h2>Sheikh al-Islam Ibn Taymiyyah</h2><h3>Aliyoyanukuu kutoka kwa wengine</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">السلف</span> <span class=\"st\">أقرّه</span> «وقد فسر السلف السهو عنها بتأخيرها عن وقتها، وبترك ما يؤمر به فيه»<cite>«الفتاوى الكبرى لابن تيمية» 4/456</cite></blockquote></section><section><h2>Imam Ibn al-Qayyim</h2><h3>Aliyoyanukuu kutoka kwa wengine</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">سعد بن أبي وقاص ومسروق بن الأجدع وغيرهما</span> <span class=\"st\">حكاه</span> «هو تركها حتى يخرج وقتها»<cite>«الصلاة وأحكام تاركها» 1/46</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">سعد بن أبي وقاص</span> <span class=\"st\">استشهد به</span> «إنه ليس ذاك ولكنه إضاعة الوقت»<cite>«الصلاة وأحكام تاركها» 1/46</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">محمد بن كعب القرظي</span> <span class=\"st\">حكاه</span> «هو تاركها»<cite>«الصلاة وأحكام تاركها» 1/46</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">النبي صلى الله عليه وسلم</span> <span class=\"st\">استشهد به</span> «هم الذين يؤخرون الصلاة عن وقتها»<cite>«الصلاة وأحكام تاركها» 1/46</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=sw#s107a5\">Fungua katika tafsiri shirikishi (maandiko kamili)</a><div class=\"pn\"><a href=\"/sw/ayah/107-4.html\">Aya iliyotangulia (107:4)</a><a href=\"/sw/ayah/107-6.html\">Aya inayofuata (107:6)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/107-5.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/107-5.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/107-5.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/107-5.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/107-5.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/107-5.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/107-5.h