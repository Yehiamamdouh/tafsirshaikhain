ype\": \"WebSite\", \"name\": \"Tafsiri ya Masheikh Wawili\", \"url\": \"https://tafsirshaikhain.com/sw/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Mwanzo\", \"item\": \"https://tafsirshaikhain.com/sw/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Al-Ghaashiya\", \"item\": \"https://tafsirshaikhain.com/sw/surah/88.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aya 22\", \"item\": \"https://tafsirshaikhain.com/sw/ayah/88-22.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/sw/\">Mwanzo</a> › <a href=\"/sw/surah/88.html\">Sura Al-Ghaashiya</a> › Aya 22</nav><h1>Tafsiri ya Sura Al-Ghaashiya 88:22</h1><p class=\"vt ar\" lang=\"ar\">﴿لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ﴾</p><section><h3>Tafsiri ya maana</h3><p class=\"tr\">Wewe si mwenye kuwatawalia.</p><span class=\"cr\" dir=\"ltr\">Swahili Translation - Ali Mohsin Al-Barwani — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Maneno ya maimamu wawili yametolewa kwa Kiarabu asilia, neno kwa neno, pamoja na marejeo.</p><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">قوله تعالى: {لست عليهم بمصيطر إلا من تولى وكفر فيعذبه الله العذاب الأكبر} فهذا من المنقطع لا بالاعتبار الذي ذكره ابن خروف من كون المستثنى جملة مستقلة بل باعتبار آخر وهو أنه ليس المراد إثبات السيطرة على الكفار فإن الله سبحانه بعثه نذيرا مبلغا لرسالات ربه فمن أطاعة فله الجنة ومن عصاه فله النار<cite>«بدائع الفوائد» 3/69</cite></blockquote><h3>Aliyoyanukuu kutoka kwa wengine</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">المفسرون</span> <span class=\"st\">أقرّه</span> «المعنى أنك لم ترسل مسلطا عليهم قاهرا لهم جبارا كالملوك بل أنت عبدي ورسولي المبلغ رسالاتي فمن أطاعك فله الجنة ومن عصاك فله النار»<cite>«بدائع الفوائد» 3/69</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=sw#s88a22\">Fungua katika tafsiri shirikishi (maandiko kamili)</a><div class=\"pn\"><a href=\"/sw/ayah/88-21.html\">Aya iliyotangulia (88:21)</a><a href=\"/sw/ayah/88-23.html\">Aya inayofuata (88:23)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/88-22.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/88-22.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/88-22.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/88-22.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/88-22.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/88-22.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/88-22.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/88-22.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah