/schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Mwanzo\", \"item\": \"https://tafsirshaikhain.com/sw/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Ar-Rahmaan\", \"item\": \"https://tafsirshaikhain.com/sw/surah/55.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aya 60\", \"item\": \"https://tafsirshaikhain.com/sw/ayah/55-60.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/sw/\">Mwanzo</a> › <a href=\"/sw/surah/55.html\">Sura Ar-Rahmaan</a> › Aya 60</nav><h1>Tafsiri ya Sura Ar-Rahmaan 55:60</h1><p class=\"vt ar\" lang=\"ar\">﴿هَلْ جَزَاءُ الْإِحْسَانِ إِلَّا الْإِحْسَانُ﴾</p><section><h3>Tafsiri ya maana</h3><p class=\"tr\">Ati yaweza kuwa malipo ya ihsani ila ihsani?</p><span class=\"cr\" dir=\"ltr\">Swahili Translation - Ali Mohsin Al-Barwani — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Maneno ya maimamu wawili yametolewa kwa Kiarabu asilia, neno kwa neno, pamoja na marejeo.</p><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">يعني هل جزاء من أحسن عبادة ربه إلا أن يحسن ربه إليه<cite>«بدائع الفوائد» 3/18</cite></blockquote><h3>Aliyoyanukuu kutoka kwa wengine</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن عباس</span> <span class=\"st\">أقرّه</span> «قال ابن عباس: &quot;هل جزاء من قال لا إله إلا الله وعمل بما جاء به محمد إلا الجنة&quot;»<cite>«بدائع الفوائد» 3/18</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">النبي صلى الله عليه وسلم</span> <span class=\"st\">استشهد به</span> «قال: &quot;قرأ رسول الله {هل جزاء الإحسان إلا الإحسان} ثم قال: هل تدرون ما قال ربكم؟ قالوا الله ورسوله أعلم قال: يقول هل جزاء من أنعمت عليه بالتوحيد إلا الجنة &quot;.»<cite>«بدائع الفوائد» 3/18</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=sw#s55a60\">Fungua katika tafsiri shirikishi (maandiko kamili)</a><div class=\"pn\"><a href=\"/sw/ayah/55-58.html\">Aya iliyotangulia (55:58)</a><a href=\"/sw/ayah/55-68.html\">Aya inayofuata (55:68)</a></div></main><footer class=\"site-foot\"><span>Tafsiri ya Masheikh Wawili · <a href=\"/sw/\">Mwanzo</a> · <a href=\"/about.html\">Kuhusu mradi</a> · <a href=\"/privacy.html\">Faragha na masharti</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/55-68.html":"<!doctype html>\n<html lang=\"sw\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsiri ya Ar-Rahmaan 55:68 — kwa mujibu wa Ibn Taymiyyah na Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Imo humo miti ya matunda, na mitende na mikomamanga.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/sw/ayah/55-68.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/55-68.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/55-68.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/55-68.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/55-68.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/55-68.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafs