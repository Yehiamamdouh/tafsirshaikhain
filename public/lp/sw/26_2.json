ily=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/sw/\">Mwanzo</a> › <a href=\"/sw/surah/26.html\">Sura Ash-Shu&#x27;araa</a> › Aya 123</nav><h1>Tafsiri ya Sura Ash-Shu&#x27;araa 26:123</h1><p class=\"vt ar\" lang=\"ar\">﴿كَذَّبَتْ عَادٌ الْمُرْسَلِينَ﴾</p><section><h3>Tafsiri ya maana</h3><p class=\"tr\">Kina A&#x27;d waliwakanusha Mitume.</p><span class=\"cr\" dir=\"ltr\">Swahili Translation - Ali Mohsin Al-Barwani — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Maneno ya maimamu wawili yametolewa kwa Kiarabu asilia, neno kwa neno, pamoja na marejeo.</p><section><h2>Sheikh al-Islam Ibn Taymiyyah</h2><blockquote class=\"ar\" lang=\"ar\">ويشبه هذا أنه من كذب رسولا معينا كان كتكذيب جنس الرسل كما قيل فيه: {كذبت قوم نوح المرسلين} {كذبت عاد المرسلين} ونحو ذلك.<cite>«مجموع الفتاوى» 10/725</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=sw#s26a123\">Fungua katika tafsiri shirikishi (maandiko kamili)</a><div class=\"pn\"><a href=\"/sw/ayah/26-105.html\">Aya iliyotangulia (26:105)</a><a href=\"/sw/ayah/26-189.html\">Aya inayofuata (26:189)</a></div></main><footer class=\"site-foot\"><span>Tafsiri ya Masheikh Wawili · <a href=\"/sw/\">Mwanzo</a> · <a href=\"/about.html\">Kuhusu mradi</a> · <a href=\"/privacy.html\">Faragha na masharti</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}