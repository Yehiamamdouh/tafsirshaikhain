 \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Mwanzo\", \"item\": \"https://tafsirshaikhain.com/sw/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Al-Mursalaat\", \"item\": \"https://tafsirshaikhain.com/sw/surah/77.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aya 20\", \"item\": \"https://tafsirshaikhain.com/sw/ayah/77-20.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/sw/\">Mwanzo</a> › <a href=\"/sw/surah/77.html\">Sura Al-Mursalaat</a> › Aya 20</nav><h1>Tafsiri ya Sura Al-Mursalaat 77:20</h1><p class=\"vt ar\" lang=\"ar\">﴿أَلَمْ نَخْلُقكُّم مِّن مَّاءٍ مَّهِينٍ﴾</p><section><h3>Tafsiri ya maana</h3><p class=\"tr\">Kwani hatukukuumbeni kwa maji ya kudharauliwa?</p><span class=\"cr\" dir=\"ltr\">Swahili Translation - Ali Mohsin Al-Barwani — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Maneno ya maimamu wawili yametolewa kwa Kiarabu asilia, neno kwa neno, pamoja na marejeo.</p><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">فانظر الان الى النطفة بعين البصيرة وهي قطرة من ماء مهين ضعيف مستقذر لو مرت بها ساعة من الزمان فسدت وانتنت<cite>«مفتاح دار السعادة ومنشور ولاية العلم والإرادة» 1/188</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وهذا كثير في القرآن يدعو العبد الى النظر والفكر في مبدأ خلقه ووسطه وآخره إذ نفسه وخلقه من اعظم الدلائل على خالقه وفاطره<cite>«مفتاح دار السعادة ومنشور ولاية العلم والإرادة» 1/188</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=sw#s77a20\">Fungua katika tafsiri shirikishi (maandiko kamili)</a><div class=\"pn\"><a href=\"/sw/ayah/77-17.html\">Aya iliyotangulia (77:17)</a><a href=\"/sw/ayah/77-23.html\">Aya inayofuata (77:23)</a></div></main><footer class=\"site-foot\"><span>Tafsiri ya Masheikh Wawili · <a href=\"/sw/\">Mwanzo</a> · <a href=\"/about.html\">Kuhusu mradi</a> · <a href=\"/privacy.html\">Faragha na masharti</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/77-23.html":"<!doctype html>\n<html lang=\"sw\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsiri ya Al-Mursalaat 77:23 — kwa mujibu wa Ibn Taymiyyah na Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Tukakadiria na Sisi ni wabora wa kukadiria.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/sw/ayah/77-23.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/77-23.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/77-23.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/77-23.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/77-23.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/77-23.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/77-23.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/77-23.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/77-23.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/77-23.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/77-23.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/77-23.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/77-23.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/77-23.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/77-23.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/77-23.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/77-23.html\">\n<meta property=\"og:title\" content=\"Tafsiri ya Al-Mursalaat 77:23 — kwa mujibu wa Ibn Taymiyyah na Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"Tukakadiria na Sisi ni wabora wa kukadiria.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Mwanzo\", \"item\": \"https://tafsirshaikhain.com/sw/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Al-Mursalaat\", \"item\": \"https://tafsirshaikhain.com/sw/surah/77.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aya 23\", \"item\": \"https://tafsirshaikhain.com/sw/ayah/77-23.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/sw/\">Mwanzo</a> › <a href=\"/sw/surah/77.html\">Sura Al-Mursalaat</a> › Aya 23</nav><h1>Tafsiri ya Sura Al-Mursalaat 77:23</h1><p class=\"vt ar\" lang=\"ar\">﴿فَقَدَرْنَا فَنِعْمَ الْقَادِرُونَ﴾</p><section><h3>Tafsiri ya maana</h3><p class=\"tr\">Tukakadiria na Sisi ni wabora wa kukadiria.</p><span class=\"cr\" dir=\"ltr\">Swahili Translation - Ali Mohsin Al-Barwani — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Maneno ya maimamu wawili yametolewa kwa Kiarabu asilia, neno kwa neno, pamoja na marejeo.</p><section><h2>Sheikh al-Islam Ibn Taymiyyah</h2><blockquote class=\"ar\" lang=\"ar\">وقد يستدل بقوله: {ألم نخلقكم من ماء مهين} إلى قوله؛ {فنعم القادرون} على قول من جعله من القدرة فإنه يتناول القدرة على المخلوقين وإن كان سبحانه قادرا أيضا على خلقه فالقدرة على خلقه قدرة عليه والقدرة عليه قدرة على خلقه<cite>«مجموع الفتاوى» 8/12</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=sw#s77a23\">Fungua katika tafsiri shirikishi (maandiko kamili)</a><div class=\"pn\"><a href=\"/sw/ayah/77-20.html\">Aya iliyotangulia (77:20)</a><a href=\"/sw/ayah/77-39.html\">Aya inayofuata (77:39)</a></div></main><footer class=\"site-foot\"><span>Tafsiri ya Masheikh Wawili · <a href=\"/sw/\">Mwanzo</a> · <a href=\"/about.html\">Kuhusu mradi</a> · <a href=\"/privacy.html\">Faragha na masharti</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/77-39.html":"<!doctype html>\n<html lang=\"sw\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsiri ya Al-Mursalaat 77:39 — kwa mujibu wa Ibn Taymiyyah na Ibn al-Qayyim</title>\n<meta name=