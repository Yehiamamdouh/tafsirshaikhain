"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Mwanzo\", \"item\": \"https://tafsirshaikhain.com/sw/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Al-Burooj\", \"item\": \"https://tafsirshaikhain.com/sw/surah/85.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aya 10\", \"item\": \"https://tafsirshaikhain.com/sw/ayah/85-10.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/sw/\">Mwanzo</a> › <a href=\"/sw/surah/85.html\">Sura Al-Burooj</a> › Aya 10</nav><h1>Tafsiri ya Sura Al-Burooj 85:10</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّ الَّذِينَ فَتَنُوا الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ ثُمَّ لَمْ يَتُوبُوا فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ الْحَرِيقِ﴾</p><section><h3>Tafsiri ya maana</h3><p class=\"tr\">Hakika walio wafitini Waumini wanaume na Waumini wanawake, kisha hawakutubu, basi watapata adhabu ya Jahannamu na watapata adhabu ya kuungua.</p><span class=\"cr\" dir=\"ltr\">Swahili Translation - Ali Mohsin Al-Barwani — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Maneno ya maimamu wawili yametolewa kwa Kiarabu asilia, neno kwa neno, pamoja na marejeo.</p><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">فسرت الفتنة هاهنا بتعذيبهم المؤمنين، وإحراقهم إياهم بالنار، واللفظ أعم من ذلك<cite>«زاد المعاد في هدي خير العباد» 3/151</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">ويدعوهم إلى التوبة وقد حاربوه وعذبوا أولياءه وأحرقوهم بالنار.<cite>«طريق الهجرتين وباب السعادتين» 1/317</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=sw#s85a10\">Fungua katika tafsiri shirikishi (maandiko kamili)</a><div class=\"pn\"><a href=\"/sw/ayah/85-2.html\">Aya iliyotangulia (85:2)</a><a href=\"/sw/ayah/85-14.html\">Aya inayofuata (85:14)</a></div></main><footer class=\"site-foot\"><span>Tafsiri ya Masheikh Wawili · <a href=\"/sw/\">Mwanzo</a> · <a href=\"/about.html\">Kuhusu mradi</a> · <a href=\"/privacy.html\">Faragha na masharti</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/85-14.html":"<!doctype html>\n<html lang=\"sw\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsiri ya Al-Burooj 85:14 — kwa mujibu wa Ibn Taymiyyah na Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Naye ni Mwenye kusamehe, Mwenye mapenzi,\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/sw/ayah/85-14.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/85-14.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/85-14.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/85-14.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/85-14.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/85-14.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.co