ref=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/sw/\">Mwanzo</a> › <a href=\"/sw/surah/37.html\">Sura As-Saaffaat</a> › Aya 95</nav><h1>Tafsiri ya Sura As-Saaffaat 37:95</h1><p class=\"vt ar\" lang=\"ar\">﴿قَالَ أَتَعْبُدُونَ مَا تَنْحِتُونَ﴾</p><section><h3>Tafsiri ya maana</h3><p class=\"tr\">Akasema: Hivyo mnaviabudu vitu mnavyo vichonga wenyewe</p><span class=\"cr\" dir=\"ltr\">Swahili Translation - Ali Mohsin Al-Barwani — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Maneno ya maimamu wawili yametolewa kwa Kiarabu asilia, neno kwa neno, pamoja na marejeo.</p><section><h2>Sheikh al-Islam Ibn Taymiyyah</h2><blockquote class=\"ar\" lang=\"ar\">فجعل الأصنام منحوتة معمولة لهم<cite>«مجموع الفتاوى» 8/17</cite></blockquote></section><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">وأن الآية وردت لبيان عدم استحقاق معبوديهم للعبادة لأنها مخلوقة لله وذكرنا شواهده من القرآن<cite>«بدائع الفوائد» 1/151</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=sw#s37a95\">Fungua katika tafsiri shirikishi (maandiko kamili)</a><div class=\"pn\"><a href=\"/sw/ayah/37-89.html\">Aya iliyotangulia (37:89)</a><a href=\"/sw/ayah/37-96.html\">Aya inayofuata (37:96)</a></div></main><footer class=\"site-foot\"><span>Tafsiri ya Masheikh Wawili · <a href=\"/sw/\">Mwanzo</a> · <a href=\"/about.html\">Kuhusu mradi</a> · <a href=\"/privacy.html\">Faragha na masharti</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/37-96.html":"<!doctype html>\n<html lang=\"sw\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsiri ya As-Saaffaat 37:96 — kwa mujibu wa Ibn Taymiyyah na Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Na hali Mwenyezi Mungu ndiye aliye kuumbeni nyinyi na hivyo mnavyo vifanya!\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/sw/ayah/37-96.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/37-96.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/37-96.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/37-96.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/37-96.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/37-96.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/37-96.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/37-96.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/37-96.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/37-96.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/37-96.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/37-96.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/37-96.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/37-96.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/37-96.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/37-96.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/37-96.html\">\n<meta property=\"og:title\" content=\"Tafsiri ya As-Saaffaat 37:96 — kwa mujibu wa Ibn Taymiyyah na Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"Na hali Mwenyezi Mungu ndiye aliye kuumbeni nyinyi na hivyo mnavyo vifanya!\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Mwanzo\", \"item\": \"https://tafsirshaikhain.com/sw/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura As-Saaffaat\", \"item\": \"https://tafsirshaikhain.com/sw/surah/37.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aya 96\", \"item\": \"https://tafsirshaikhain.com/sw/ayah/37-96.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/sw/\">Mwanzo</a> › <a href=\"/sw/surah/37.html\">Sura As-Saaffaat</a> › Aya 96</nav><h1>Tafsiri ya Sura As-Saaffaat 37:96</h1><p class=\"vt ar\" lang=\"ar\">﴿وَاللَّهُ خَلَقَكُمْ وَمَا تَعْمَلُونَ﴾</p><section><h3>Tafsiri ya maana</h3><p class=\"tr\">Na hali Mwenyezi Mungu ndiye aliye kuumbeni nyinyi na hivyo mnavyo vifanya!</p><span class=\"cr\" dir=\"ltr\">Swahili Translation - Ali Mohsin Al-Barwani — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Maneno ya maimamu wawili yametolewa kwa Kiarabu asilia, neno kwa neno, pamoja na marejeo.</p><section><h2>Sheikh al-Islam Ibn Taymiyyah</h2><blockquote class=\"ar\" lang=\"ar\">فلا ننازعه في أن المراد بذلك الأصنام، فإن هذا هو أصح القولين. و &quot; ما &quot; بمعنى الذي، ومن قال: إنها مصدرية والمراد والله خلقكم وعملكم فهو ضعيف<cite>«منهاج السنة النبوية في نقض كلام الشيعة القدرية» 3/336</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وإذا كان خالقا للمعمول وفيه أثر الفعل دل على أنه خالق لأفعال العباد.<cite>«مجموع الفتاوى» 8/17</cite></blockquote></section><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">وليست مصدرية وإنما هي موصولة والمعنى والله خلقكم وخلق الذي تعملونه وتنحتونه من الأصنام فكيف تعبدونه وهو مخلوق لله ولو كانت مصدرية لكان الكلام إلى أن يكون حجة لهم أقرب من أن يكون حجة عليهم<cite>«بدائع الفوائد» 1/143</cite></blockquote><h3>Aliyoyanukuu kutoka kwa wengine</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">من حمل «ما» على المصدرية</span> <span class=\"st\">رجّح غيره</span> «بحمل ما على المصدر أي خلقكم وأعمالكم»<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/110</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=sw#s37a96\">Fungua katika tafsiri shirikishi (maandiko kamili)</a><div class=\"pn\"><a href=\"/sw/ayah/37-95.html\">Aya iliyotangulia (37:95)</a><a href=\"/sw/ayah/37-103.html\">Aya inayofuata (37:103)</a></div></main><footer class=\"site-foot\"><span>Tafsiri ya Masheikh Wawili · <a href=\"/sw/\">Mwanzo</a> · <a href=\"/about.html\">Kuhusu mradi</a> · <a href=\"/privacy.html\">Faragha na masharti</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}