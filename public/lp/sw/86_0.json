t=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Mwanzo\", \"item\": \"https://tafsirshaikhain.com/sw/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura At-Taariq\", \"item\": \"https://tafsirshaikhain.com/sw/surah/86.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aya 8\", \"item\": \"https://tafsirshaikhain.com/sw/ayah/86-8.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/sw/\">Mwanzo</a> › <a href=\"/sw/surah/86.html\">Sura At-Taariq</a> › Aya 8</nav><h1>Tafsiri ya Sura At-Taariq 86:8</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّهُ عَلَىٰ رَجْعِهِ لَقَادِرٌ﴾</p><section><h3>Tafsiri ya maana</h3><p class=\"tr\">Hakika Yeye ana uweza wa kumrudisha.</p><span class=\"cr\" dir=\"ltr\">Swahili Translation - Ali Mohsin Al-Barwani — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Maneno ya maimamu wawili yametolewa kwa Kiarabu asilia, neno kwa neno, pamoja na marejeo.</p><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">الصحيح أن الضمير يرجع على الإنسان، أي إن الله على رده إليه لقادر يوم القيامة<cite>«إعلام الموقعين عن رب العالمين» 1/113</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وطريقة القرآن - وهي الاستدلال بالمبدإ والنشأة الأولى على المعاد والرجوع إليه - وأيضا فإنه قيده بالظرف، وهو {يوم تبلى السرائر} [الطارق: 9]<cite>«إعلام الموقعين عن رب العالمين» 1/113</cite></blockquote><h3>Aliyoyanukuu kutoka kwa wengine</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">من قال</span> <span class=\"st\">ردّه</span> «إن الضمير يرجع على الماء أي أن الله على رجعه في الإحليل أو في الصدر أو حبسه عن الخروج لقادر»<cite>«إعلام الموقعين عن رب العالمين» 1/113</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=sw#s86a8\">Fungua katika tafsiri shirikishi (maandiko kamili)</a><div class=\"pn\"><a href=\"/sw/ayah/86-7.html\">Aya iliyotangulia (86:7)</a></div></main><footer class=\"site-foot\"><span>Tafsiri ya Masheikh Wawili · <a href=\"/sw/\">Mwanzo</a> · <a href=\"/about.html\">Kuhusu mradi</a> · <a href=\"/privacy.html\">Faragha na masharti</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/86.html":"<!doctype html>\n<html lang=\"sw\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsiri ya Sura At-Taariq — kwa mujibu wa Ibn Taymiyyah na Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Tafsiri ya Sura At-Taariq — Maana ya Qur&#x27;ani kwa maneno ya Ibn Taymiyyah na Ibn al-Qayyim\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/sw/surah/86.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/surah/86.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/surah/86.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/surah/86.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/surah/86.html\">\n<link rel=\"alternate\" hreflang=\"id\" hre