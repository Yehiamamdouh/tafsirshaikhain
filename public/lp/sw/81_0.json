swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/sw/\">Mwanzo</a> › <a href=\"/sw/surah/81.html\">Sura At-Takwir</a> › Aya 15</nav><h1>Tafsiri ya Sura At-Takwir 81:15</h1><p class=\"vt ar\" lang=\"ar\">﴿فَلَا أُقْسِمُ بِالْخُنَّسِ﴾</p><section><h3>Tafsiri ya maana</h3><p class=\"tr\">Naapa kwa nyota zinapo rejea nyuma,</p><span class=\"cr\" dir=\"ltr\">Swahili Translation - Ali Mohsin Al-Barwani — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Maneno ya maimamu wawili yametolewa kwa Kiarabu asilia, neno kwa neno, pamoja na marejeo.</p><section><h2>Sheikh al-Islam Ibn Taymiyyah</h2><blockquote class=\"ar\" lang=\"ar\">يعني: الكواكب التي تكون في السماء خانسة أي: مختفية قبل طلوعها<cite>«مجموع الفتاوى» 11/273</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">يقتضي تعظيم قدر المقسم به والتنبيه على ما فيه من الآيات والعبرة والمنفعة للناس؛ والإنعام عليهم وغير ذلك؛<cite>«مجموع الفتاوى» 35/177</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=sw#s81a15\">Fungua katika tafsiri shirikishi (maandiko kamili)</a><div class=\"pn\"><a href=\"/sw/ayah/81-9.html\">Aya iliyotangulia (81:9)</a><a href=\"/sw/ayah/81-17.html\">Aya inayofuata (81:17)</a></div></main><footer class=\"site-foot\"><span>Tafsiri ya Masheikh Wawili · <a href=\"/sw/\">Mwanzo</a> · <a href=\"/about.html\">Kuhusu mradi</a> · <a href=\"/privacy.html\">Faragha na masharti</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/81-17.html":"<!doctype html>\n<html lang=\"sw\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1