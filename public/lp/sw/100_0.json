n<meta property=\"og:title\" content=\"Tafsiri ya Al-Aadiyaat 100:1 — kwa mujibu wa Ibn Taymiyyah na Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"Naapa kwa farasi wendao mbio wakipumua,\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/sw/\">Mwanzo</a> › <a href=\"/sw/surah/100.html\">Sura Al-Aadiyaat</a> › Aya 1</nav><h1>Tafsiri ya Sura Al-Aadiyaat 100:1</h1><p class=\"vt ar\" lang=\"ar\">﴿بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَالْعَادِيَاتِ ضَبْحًا﴾</p><section><h3>Tafsiri ya maana</h3><p class=\"tr\">Naapa kwa farasi wendao mbio wakipumua,</p><span class=\"cr\" dir=\"ltr\">Swahili Translation - Ali Mohsin Al-Barwani — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Maneno ya maimamu wawili yametolewa kwa Kiarabu asilia, neno kwa neno, pamoja na marejeo.</p><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">أن الله سبحانه وتعالى أقسم بالخيل في كتابه وذلك يدل على شرفها وفضلها عنده<cite>«الفروسية» 1/130</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">أقسم سبحانه بالخيل تعدو في سبيله<cite>«الفروسية» 1/130</cite></blockquote><h3>Aliyoyanukuu kutoka kwa wengine</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">علي بن أبي طالب وابن مسعود</span> <span class=\"st\">حكاه</span> «فقال علي بن أبي طالب وعبد الله بن مسعود رضي الله عنهما هي إبل الحاج تعدو من عرفة إلى مزدلفة»<cite>«التبيان في أقسام القرآن» 1/75</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=sw#s100a1\">Fungua katika tafsiri shirikishi (maandiko kamili)</a><div class=\"pn\"><span></span><a href=\"/sw/ayah/100-2.html\">Aya inayofuata (100:2)</a></div></main><footer class=\"site-foot\"><span>Tafsiri ya Masheikh Wawili · <a href=\"/sw/\">Mwanzo</a> · <a href=\"/about.html\">Kuhusu mradi</a> · <a href=\"/privacy.html\">Faragha na masharti</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/100-2.html":"<!doctype html>\n<html lang=\"sw\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsiri ya Al-Aadiyaat 100:2 — kwa mujibu wa Ibn Taymiyyah na Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Na wakitoa moto kwa kupiga kwato zao chini,\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/sw/ayah/100-2.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/100-2.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/100-2.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/100-2.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/100-2.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/100-2.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/100-2.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/100-2.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/100-2.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/100-2.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/100-2.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/100-2.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/100-2.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/100-2.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/100-2.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/100-2.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/100-2.html\">\n<meta property=\"og:title\" content=\"Tafsiri ya Al-Aadiyaat 100:2 — kwa mujibu wa Ibn Taymiyyah na Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"Na wakitoa moto kwa kupiga kwato zao chini,\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/sw/\">Mwanzo</a> › <a href=\"/sw/surah/100.html\">Sura Al-Aadiyaat</a> › Aya 2</nav><h1>Tafsiri ya Sura Al-Aadiyaat 100:2</h1><p class=\"vt ar\" lang=\"ar\">﴿فَالْمُورِيَاتِ قَدْحًا﴾</p><section><h3>Tafsiri ya maana</h3><p class=\"tr\">Na wakitoa moto kwa kupiga kwato zao chini,</p><span class=\"cr\" dir=\"ltr\">Swahili Translation - Ali Mohsin Al-Barwani — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Maneno ya maimamu wawili yametolewa kwa Kiarabu asilia, neno kwa neno, pamoja na marejeo.</p><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">توري النار بحوافرها عندما تصك الحجارة<cite>«الفروسية» 1/131</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=sw#s100a2\">Fungua katika tafsiri shirikishi (maandiko kamili)</a><div class=\"pn\"><a href=\"/sw/ayah/100-1.html\">Aya iliyotangulia (100:1)</a></div></main><footer class=\"site-foot\"><span>Tafsiri ya Masheikh Wawili · <a href=\"/sw/\">Mwanzo</a> · <a href=\"/about.html\">Kuhusu mradi</a> · <a href=\"/privacy.html\">Faragha na masharti</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/100.html":"<!doctype html>\n<html lang=\"sw\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsiri ya Sura Al-Aadiyaat — kwa mujibu wa Ibn Taymiyyah na Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Tafsiri ya Sura Al-Aadiyaat — Maana ya Qur&#x27;ani kwa maneno ya Ibn Taymiyyah na Ibn al-Qayyim\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/sw/surah/100.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/surah/100.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/surah/100.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/surah/100.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/surah/100.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/surah/100.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/surah/100.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/surah/100.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/surah/100.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href