\": \"Person\", \"name\": \"Sheikh al-Islam Ibn Taymiyyah\"}, {\"@type\": \"Person\", \"name\": \"Imam Ibn al-Qayyim\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"Tafsiri ya Masheikh Wawili\", \"url\": \"https://tafsirshaikhain.com/sw/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Mwanzo\", \"item\": \"https://tafsirshaikhain.com/sw/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Al-Falaq\", \"item\": \"https://tafsirshaikhain.com/sw/surah/113.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aya 4\", \"item\": \"https://tafsirshaikhain.com/sw/ayah/113-4.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/sw/\">Mwanzo</a> › <a href=\"/sw/surah/113.html\">Sura Al-Falaq</a> › Aya 4</nav><h1>Tafsiri ya Sura Al-Falaq 113:4</h1><p class=\"vt ar\" lang=\"ar\">﴿وَمِن شَرِّ النَّفَّاثَاتِ فِي الْعُقَدِ﴾</p><section><h3>Tafsiri ya maana</h3><p class=\"tr\">Na shari ya wanao pulizia mafundoni,</p><span class=\"cr\" dir=\"ltr\">Swahili Translation - Ali Mohsin Al-Barwani — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Maneno ya maimamu wawili yametolewa kwa Kiarabu asilia, neno kwa neno, pamoja na marejeo.</p><section><h2>Sheikh al-Islam Ibn Taymiyyah</h2><blockquote class=\"ar\" lang=\"ar\">وإن مشيت على آيات القرآن كما تلقن الصبيان وجدت الأمر كذلك؛ فإنه سبحانه قال: {قل أعوذ برب الناس} {ملك الناس} {إله الناس} فأي ناس ليس الله ربهم؟ أم ليس ملكهم؟ أم ليس إلههم؟ ثم قوله: {من شر الوسواس الخناس} إن كان المسمى واحدا فلا عموم فيه وإن كان جنسا فهو عام فأي وسواس خناس لا يستعاذ بالله منه؟ . وكذلك قوله: {برب الفلق} أي جزء من &quot; الفلق &quot; أم أي (فلق ليس الله ربه؟ {من شر ما خلق} أي شر من المخلوق لا يستعاذ منه؟ {ومن شر النفاثات} أي نفاثة في العقد لا يستعاذ منها؟<cite>«مجموع الفتاوى» 6/444</cite></blockquote></section><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">وقد دل قوله: {ومن شر النفاثات في العقد} وحديث عائشة المذكور: على تأثير السحر وأن له حقيقة<cite>«بدائع الفوائد» 2/227</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">والسواحر تستعين بالنفث استعانة بينة، وإن لم تتصل بجسم المسحور، بل تنفث على العقدة وتعقدها، وتتكلم بالسحر فيعمل ذلك في المسحور بتوسط الأرواح السفلية الخبيثة،<cite>«زاد المعاد في هدي خير العباد» 4/165</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=sw#s113a4\">Fungua katika tafsiri shirikishi (maandiko kamili)</a><div class=\"pn\"><a href=\"/sw/ayah/113-2.html\">Aya iliyotangulia (113:2)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/113-4.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/113-4.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/113-4.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/113-4.html\" hre