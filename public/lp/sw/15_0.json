econnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/sw/\">Mwanzo</a> › <a href=\"/sw/surah/15.html\">Sura Al-Hijr</a> › Aya 15</nav><h1>Tafsiri ya Sura Al-Hijr 15:15</h1><p class=\"vt ar\" lang=\"ar\">﴿لَقَالُوا إِنَّمَا سُكِّرَتْ أَبْصَارُنَا بَلْ نَحْنُ قَوْمٌ مَّسْحُورُونَ﴾</p><section><h3>Tafsiri ya maana</h3><p class=\"tr\">Basi wangeli sema: Macho yetu yamelevywa, bali sisi wenyewe tumerogwa.</p><span class=\"cr\" dir=\"ltr\">Swahili Translation - Ali Mohsin Al-Barwani — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Maneno ya maimamu wawili yametolewa kwa Kiarabu asilia, neno kwa neno, pamoja na marejeo.</p><section><h2>Sheikh al-Islam Ibn Taymiyyah</h2><blockquote class=\"ar\" lang=\"ar\">فقد علموا أن السحر يغير الإحساس، كما يوجب المرض والقتل.<cite>«النبوات» 2/1053</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=sw#s15a15\">Fungua katika tafsiri shirikishi (maandiko kamili)</a><div class=\"pn\"><a href=\"/sw/ayah/15-1.html\">Aya iliyotangulia (15:1)</a><a href=\"/sw/ayah/15-39.html\">Aya inayofuata (15:39)</a></div></main><footer class=\"site-foot\"><span>Tafsiri ya Masheikh Wawili · <a href=\"/sw/\">Mwanzo</a> · <a href=\"/about.html\">Kuhusu mradi</a> · <a href=\"/privacy.html\">Faragha na masharti</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/15-39.html":"<!doctype html>\n<html lang=\"sw\" dir=\"ltr\">\n<head>\n<meta char