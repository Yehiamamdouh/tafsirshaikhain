display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/sw/\">Mwanzo</a> › <a href=\"/sw/surah/90.html\">Sura Al-Balad</a> › Aya 11</nav><h1>Tafsiri ya Sura Al-Balad 90:11</h1><p class=\"vt ar\" lang=\"ar\">﴿فَلَا اقْتَحَمَ الْعَقَبَةَ﴾</p><section><h3>Tafsiri ya maana</h3><p class=\"tr\">Lakini hakujitoma kwenye njia ya vikwazo vya milimani.</p><span class=\"cr\" dir=\"ltr\">Swahili Translation - Ali Mohsin Al-Barwani — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Maneno ya maimamu wawili yametolewa kwa Kiarabu asilia, neno kwa neno, pamoja na marejeo.</p><section><h2>Imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">تفسير لاقتحام العقبة مكان شاق كؤود يقتحمه الناس حتى يصلوا إلى الجنة واقتحامه بفعل هذه الأمور فمن فعلها فقد اقتحم العقبة<cite>«التبيان في أقسام القرآن» 1/41</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=sw#s90a11\">Fungua katika tafsiri shirikishi (maandiko kamili)</a><div class=\"pn\"><a href=\"/sw/ayah/90-10.html\">Aya iliyotangulia (90:10)</a><a href=\"/sw/ayah/90-17.html\">Aya inayofuata (90:17)</a></div></main><footer class=\"site-foot\"><span>Tafsiri ya Masheikh Wawili · <a href=\"/sw/\">Mwanzo</a> · <a href=\"/about.html\">Kuhusu mradi</a> · <a href=\"/privacy.html\">Faragha na masharti</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/90-17.html":"<!doctype html>\n<html lang=\"sw\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsiri ya Al-Balad 90:17 — kwa mujibu wa Ibn Taymiyyah na Ibn al-Qayyim</title>\n<meta name=\"