/54-50.html\">\n<meta property=\"og:title\" content=\"Tafsiri ya Al-Qamar 54:50 — kwa mujibu wa Ibn Taymiyyah na Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"Na amri yetu haikuwa ila ni moja tu, kama kupepesa jicho.\">\n<meta property=\"og:url\" content=\"https://tafsirshaikhain.com/sw/ayah/54-50.html\">\n<meta property=\"og:site_name\" content=\"Tafsiri ya Masheikh Wawili\">\n<meta property=\"og:locale\" content=\"sw_KE\">\n<meta property=\"og:type\" content=\"article\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta property=\"og:image:width\" content=\"1200\">\n<meta property=\"og:image:height\" content=\"630\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<link rel=\"manifest\" href=\"/manifest.webmanifest\">\n<link rel=\"apple-touch-icon\" href=\"/icon-192.png\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"Tafsiri ya Al-Qamar 54:50 — kwa mujibu wa Ibn Taymiyyah na Ibn al-Qayyim\", \"description\": \"Na amri yetu haikuwa ila ni moja tu, kama kupepesa jicho.\", \"inLanguage\": \"sw\", \"url\": \"https://tafsirshaikhain.com/sw/ayah/54-50.html\", \"mainEntityOfPage\": \"https://tafsirshaikhain.com/sw/ayah/54-50.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"Sheikh al-Islam Ibn Taymiyyah\"}, {\"@type\": \"Person\", \"name\": \"Imam Ibn al-Qayyim\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"Tafsiri ya Masheikh Wawili\", \"url\": \"https://tafsirshaikhain.com/sw/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Mwanzo\", \"item\": \"https://tafsirshaikhain.com/sw/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Al-Qamar\", \"item\": \"https://ta