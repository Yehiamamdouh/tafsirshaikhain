tafsirshaikhain.com/zh/ayah/26-10.html\">\n<meta property=\"og:title\" content=\"Tafsiri ya Ash-Shu&#x27;araa 26:10 — kwa mujibu wa Ibn Taymiyyah na Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"Na Mola wako Mlezi, alipo mwita Musa, akamwambia: Fika kwa watu madhaalimu,\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/sw/\">Mwanzo</a> › <a href=\"/sw/surah/26.html\">Sura Ash-Shu&#x27;araa</a> › Aya 10</nav><h1>Tafsiri ya Sura Ash-Shu&#x27;araa 26:10</h1><p class=\"vt ar\" lang=\"ar\">﴿وَإِذْ نَادَىٰ رَبُّكَ مُوسَىٰ أَنِ ائْتِ الْقَوْمَ الظَّالِمِينَ﴾</p><section><h3>Tafsiri ya maana</h3><p class=\"tr\">Na Mola wako Mlezi, alipo mwita Musa, akamwambia: Fika kwa watu madhaalimu,</p><span class=\"cr\" dir=\"ltr\">Swahili Translation - Ali Mohsin Al-Barwani — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Maneno ya maimamu wawili yametolewa kwa Kiarabu asilia, neno kwa neno, pamoja na marejeo.</p><section><h2>Sheikh al-Islam Ibn Taymiyyah</h2><blockquote class=\"ar\" lang=\"ar\">فأخبر أنه ظالم وطاغ ومفسد هو وقومه وهذه أسماء ذم الأفعال؛ والذم إنما. يكون في الأفعال السيئة القبيحة فدل ذلك على أن الأفعال تكون قبيحة مذمومة قبل مجيء الرسول إليهم<cite>«مجموع الفتاوى» 20/37</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=sw#s26a10\">Fungua katika tafsiri shirikishi (maandiko kamili)</a><div class=\"pn\"><span></span><a href=\"/sw/ayah/26-55.html\">Aya inayofuata (26:55)</a></div></main><footer class=\"site-foot\"><span>Tafsiri ya Masheikh Wawili · <a href=\"/sw/\">Mwanzo</a> · <a href=\"/about.html\">Kuhusu mradi</a> · <a href=\"/privacy.html\">Faragha na masharti</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/26.html":"<!doctype html>\n<html lang=\"sw\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsiri ya Sura Ash-Shu&#x27;araa — kwa mujibu wa Ibn Taymiyyah na Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Tafsiri ya Sura Ash-Shu&#x27;araa — Maana ya Qur&#x27;ani kwa maneno ya Ibn Taymiyyah na Ibn al-Qayyim\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/sw/surah/26.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/surah/26.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/surah/26.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/surah/26.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/surah/26.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/surah/26.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/surah/26.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/surah/26.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/surah/26.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/surah/26.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/surah/26.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/surah/26.html\">\n<link rel=\"alternate\" hreflang=\