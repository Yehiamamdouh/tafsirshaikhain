h(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/es/\">Inicio</a> › <a href=\"/es/surah/99.html\">Sura Az-Zalzala</a> › Aleya 7</nav><h1>Tafsir de Sura Az-Zalzala 99:7</h1><p class=\"vt ar\" lang=\"ar\">﴿فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُ﴾</p><section><h3>Traducción del significado</h3><p class=\"tr\">Quien haya realizado una buena acción, por pequeña que sea, la verá (recompensada).</p><span class=\"cr\" dir=\"ltr\">Spanish Translation - Noor International Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Las palabras de los dos imames se ofrecen en el árabe original, literalmente, con sus referencias.</p><section><h2>Shaij al-Islam Ibn Taymiyya</h2><blockquote class=\"ar\" lang=\"ar\">وعلم أن الرب جارية أفعاله على قانون العدل والإحسان<cite>«مجموع الفتاوى» 8/226</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">والعبد إذا اجتمع له سيئات وحسنات فإنه وإن استحق العقاب على سيئاته فإن الله يثيبه على حسناته، ولا يحبط حسنات المؤمن لأجل ما صدر منه؛<cite>«مجموع الفتاوى» 35/68</cite></blockquote></section><section><h2>El imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">وسمى النبي - صلى الله عليه وسلم - هذه الآية جامعة فاذة<cite>«إعلام الموقعين عن رب العالمين» 1/251</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=es#s99a7\">Abrir en el tafsir interactivo (textos completos)</a><div class=\"pn\"><a href=\"/es/ayah/99-4.html\">Aleya anterior (99:4)</a><a href=\"/es/ayah/99-8.html\">Aleya siguiente (99:8)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/99-7.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/99-7.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/99-7.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/99-7.html