bList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Inicio\", \"item\": \"https://tafsirshaikhain.com/es/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Al-Ghaashiya\", \"item\": \"https://tafsirshaikhain.com/es/surah/88.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aleya 23\", \"item\": \"https://tafsirshaikhain.com/es/ayah/88-23.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/es/\">Inicio</a> › <a href=\"/es/surah/88.html\">Sura Al-Ghaashiya</a> › Aleya 23</nav><h1>Tafsir de Sura Al-Ghaashiya 88:23</h1><p class=\"vt ar\" lang=\"ar\">﴿إِلَّا مَن تَوَلَّىٰ وَكَفَرَ﴾</p><section><h3>Traducción del significado</h3><p class=\"tr\">Mas a quien le dé la espalda a la verdad y la niegue,</p><span class=\"cr\" dir=\"ltr\">Spanish Translation - Noor International Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Las palabras de los dos imames se ofrecen en el árabe original, literalmente, con sus referencias.</p><section><h2>El imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">فهذا من المنقطع لا بالاعتبار الذي ذكره ابن خروف من كون المستثنى جملة مستقلة بل باعتبار آخر وهو أنه ليس المراد إثبات السيطرة على الكفار<cite>«بدائع الفوائد» 3/69</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">ويوضح هذا أن المخاطبين بهذا الخطاب هم الكفار فلا يصح أن يكونوا هم المستثنين.<cite>«بدائع الفوائد» 3/69</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=es#s88a23\">Abrir en el tafsir interactivo (textos completos)</a><div class=\"pn\"><a href=\"/es/ayah/88-22.html\">Aleya anterior (88:22)</a></div></main><footer class=\"site-foot\"><span>Tafsir de los dos Shaij · <a href=\"/es/\">Inicio</a> · <a href=\"/about.html\">Sobre el proyecto</a> · <a href=\"/privacy.html\">Privacidad y condiciones</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/88.html":"<!doctype html>\n<html lang=\"es\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir de Sura Al-Ghaashiya — según Ibn Taymiyya e Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Tafsir de Sura Al-Ghaashiya — El significado del Corán en las palabras de Ibn Taymiyya e Ibn al-Qayyim\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/es/surah/88.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/surah/88.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/surah/88.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/surah/88.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/surah/88.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/surah/88.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/surah/88.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/surah/88.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/surah/88.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/surah/88.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/surah/88.htm