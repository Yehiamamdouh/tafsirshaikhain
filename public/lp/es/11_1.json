sirshaikhain.com/es/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Hud\", \"item\": \"https://tafsirshaikhain.com/es/surah/11.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aleya 55\", \"item\": \"https://tafsirshaikhain.com/es/ayah/11-55.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/es/\">Inicio</a> › <a href=\"/es/surah/11.html\">Sura Hud</a> › Aleya 55</nav><h1>Tafsir de Sura Hud 11:55</h1><p class=\"vt ar\" lang=\"ar\">﴿مِن دُونِهِ فَكِيدُونِي جَمِيعًا ثُمَّ لَا تُنظِرُونِ﴾</p><section><h3>Traducción del significado</h3><p class=\"tr\">»fuera de Al-lah.Conspirad todos contra mí y actuad sin más demora.</p><span class=\"cr\" dir=\"ltr\">Spanish Translation - Noor International Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Las palabras de los dos imames se ofrecen en el árabe original, literalmente, con sus referencias.</p><section><h2>Shaij al-Islam Ibn Taymiyya</h2><blockquote class=\"ar\" lang=\"ar\">ثم يتحداهم ويعجزهم بقوله { فكيدوني جميعا ثم لا تنظرون إني توكلت على الله ربي وربكم ما من دابة إلا هو آخذ بناصيتها }<cite>«رسالة في تحقيق التوكل» 1/96</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=es#s11a55\">Abrir en el tafsir interactivo (textos completos)</a><div class=\"pn\"><a href=\"/es/ayah/11-52.html\">Aleya anterior (11:52)</a><a href=\"/es/ayah/11-56.html\">Aleya siguiente (11:56)</a></div></main><footer class=\"site-foot\"><span>Tafsir de los dos Shaij · <a href=\"/es/\">Inicio</a> · <a href=\"/about.html\">Sobre el proyecto</a> · <a href=\"/privacy.html\">Privacidad y condiciones</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/11-56.html":"<!doctype html>\n<html lang=\"es\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir de Hud 11:56 — según Ibn Taymiyya e Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"»Yo confío en Al-lah, mi Señor y vuestro Señor. No hay ninguna criatura que no esté bajo Su poder. Ciertamente, Al-lah es justo en Su proceder.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/es/ayah/11-56.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/11-56.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/11-56.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/11-56.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/11-56.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/11-56.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/11-56.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/11-56.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/11-56.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/11-56.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/11-56.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/11-56.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/11-56.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/11-56.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/11-56.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/11-56.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/11-56.html\">\n<meta property=\"og:title\" content=\"Tafsir de Hud 11:56 — según Ibn Taymiyya e Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"»Yo confío en Al-lah, mi Señor y vuestro Señor. No hay ninguna criatura que no esté bajo Su poder. Ciertamente, Al-lah es justo en Su proceder.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Inicio\", \"item\": \"https://tafsirshaikhain.com/es/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Hud\", \"item\": \"https://tafsirshaikhain.com/es/surah/11.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aleya 56\", \"item\": \"https://tafsirshaikhain.com/es/ayah/11-56.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/es/\">Inicio</a> › <a href=\"/es/surah/11.html\">Sura Hud</a> › Aleya 56</nav><h1>Tafsir de Sura Hud 11:56</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنِّي تَوَكَّلْتُ عَلَى اللَّهِ رَبِّي وَرَبِّكُم مَّا مِن دَابَّةٍ إِلَّا هُوَ آخِذٌ بِنَاصِيَتِهَا إِنَّ رَبِّي عَلَىٰ صِرَاطٍ مُّسْتَقِيمٍ﴾</p><section><h3>Traducción del significado</h3><p class=\"tr\">»Yo confío en Al-lah, mi Señor y vuestro Señor. No hay ninguna criatura que no esté bajo Su poder. Ciertamente, Al-lah es justo en Su proceder.</p><span class=\"cr\" dir=\"ltr\">Spanish Translation - Noor International Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Las palabras de los dos imames se ofrecen en el árabe original, literalmente, con sus referencias.</p><section><h2>Shaij al-Islam Ibn Taymiyya</h2><blockquote class=\"ar\" lang=\"ar\">بين أنه توكل على من أخذ بنواصي الأنفس وبسائر الدواب فهو يدفعكم عني لأني متوكل عليه<cite>«رسالة في تحقيق التوكل» 1/96</cite></blockquote></section><section><h2>El imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">أي هو ربي، فلا يسلمني ولا يضيعني، وهو ربكم فلا يسلطكم علي ولا يمكنكم مني، فإن نواصيكم بيده، لا تفعلون شيئا بدون مشيئته<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/44</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">أي مع كونه مالكا قاهرا متصرفا في عباده نواصيهم بيده فهو على صراط مستقيم<cite>«الفوائد» 1/23</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=es#s11a56\">Abrir en el tafsir interactivo (textos completos)</a><div class=\"pn\"><a href=\"/es/ayah/11-55.html\">Aleya anterior (11:55)</a><a href=\"/es/ayah/11-59.html\">Aleya siguiente (11:59)</a></div></main><footer class=\"site-foot\"><span>Tafsir de los dos Shaij · <a href=\"/es/\">Inicio</a> · <a href=\"/about.html\">Sobre el proyecto</a> · <a href=\"/privacy.html\">Privacidad y condiciones</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/11-59.html":"<!doctype html>\n<html lang=\"es\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir de Hud 11:59 — según Ibn Taymiyya e Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Ese fue el pueblo de ‘Ad. Rechazaron las pruebas de Su Señor, desobedecieron a Sus mensajeros y siguieron las órdenes de todo dirigente soberbio y obstinad\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/es/ayah/11-59.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/11-59.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/11-59.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/11-59.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/11-59.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/11-59.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/11-59.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/11-59.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/11-59.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/11-59.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/11-59.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/11-59.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/11-59.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/11-59.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/11-59.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/11-59.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/11-59.html\">\n<meta property=\"og:title\" content=\"Tafsir de Hud 11:59 — según Ibn Taymiyya e Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"Ese fue el pueblo de ‘Ad. Rechazaron las pruebas de Su Señor, desobedecieron a Sus mensajeros y siguieron las órdenes de todo dirigente soberbio y obstinad\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Inicio\", \"item\": \"https://tafsirshaikhain.com/es/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Hud\", \"item\": \"https://tafsirshaikhain.com/es/surah/11.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aleya 59\", \"item\": \"https://tafsirshaikhain.com/es/ayah/11-59.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/es/\">Inicio</a> › <a href=\"/es/surah/11.html\">Sura Hud</a> › Aleya 59</nav><h1>Tafsir de Sura Hud 11:59</h1><p class=\"vt ar\" lang=\"ar\">﴿وَتِلْكَ عَادٌ جَحَدُوا بِآيَاتِ رَبِّهِمْ وَعَصَوْا رُسُلَهُ وَاتَّبَعُوا أَمْرَ كُلِّ جَبَّارٍ عَنِيدٍ﴾</p><section><h3>Traducción del significado</h3><p class=\"tr\">Ese fue el pueblo de ‘Ad. Rechazaron las pruebas de Su Señor, desobedecieron a Sus mensajeros y siguieron las órdenes de todo dirigente soberbio y obstinado (que rechazaba la verdad).</p><span class=\"cr\" dir=\"ltr\">Spanish Translation - Noor International Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Las palabras de los dos imames se ofrecen en el árabe original, literalmente, con sus referencias.</p><section><h2>Shaij al-Islam Ibn Taymiyya</h2><blockquote class=\"ar\" lang=\"ar\">فأطلق معصيتهم للرسل بأنهم عصوا هودا معصية تكذيب لجنس الرسل<cite>«مجموع الفتاوى» 7/59</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=es#s11a59\">Abrir en el tafsir interactivo (textos completos)</a><div class=\"pn\"><a href=\"/es/ayah/11-56.html\">Aleya anterior (11:56)</a><a href=\"/es/ayah/11-67.html\">Aleya siguiente (11:67)</a></div></main><footer class=\"site-foot\"><span>Tafsir de los dos Shaij · <a href=\"/es/\">Inicio</a> · <a href=\"/about.html\">Sobre el proyecto</a> · <a href=\"/privacy.html\">Privacidad y condiciones</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/11-67.html":"<!doctype html>\n<html lang=\"es\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir de Hud 11:67 — según Ibn Taymiyya e Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Un gran estruendo alcanzó a quienes habían sido injustos (por desmentir a su mensajero), y amanecieron tendidos muertos en sus hogares,\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/es/ayah/11-67.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/11-67.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/11-67.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/11-67.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/11-67.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/11-67.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/11-67.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/11-67.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/11-67.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/11-67.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/11-67.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/11-67.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/11-67.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/11-67.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/11-67.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/11-67.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/11-67.html\">\n<meta property=\"og:title\" content=\"Tafsir de Hud 11:67 — según Ibn Taymiyya e Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"Un gran estruendo alcanzó a quienes habían sido injustos (por desmentir a su mensajero), y amanecieron tendidos muertos en sus hogares,\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Inicio\", \"item\": \"https://tafsirshaikhain.com/es/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Hud\", \"item\": \"https://tafsirshaikhain.com/es/surah/11.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aleya 67\", \"item\": \"https://tafsirshaikhain.com/es/ayah/11-67.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/es/\">Inicio</a> › <a href=\"/es/surah/11.html\">Sura Hud</a> › Aleya 67</nav><h1>Tafsir de Sura Hud 11:67</h1><p class=\"vt ar\" lang=\"ar\">﴿وَأَخَذَ الَّذِينَ ظَلَمُوا الصَّيْحَةُ فَأَصْبَحُوا فِي دِيَارِهِمْ جَاثِمِينَ﴾</p><section><h3>Traducción del significado</h3><p class=\"tr\">Un gran estruendo alcanzó a quienes habían sido injustos (por desmentir a su mensajero), y amanecieron tendidos muertos en sus hogares,</p><span class=\"cr\" dir=\"ltr\">Spanish Translation - Noor International Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Las palabras de los dos imames se ofrecen en el árabe original, literalmente, con sus referencias.</p><section><h2>El imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">أن الصيحة يراد بها المصدر بمعنى الصياح فيحسن فيها التذكير ويراد بها الواحدة من المصدر فيكون التأنيث أحسن<cite>«بدائع الفوائد» 1/126</cite></blockquote><h3>Lo que citó de otros</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">السهيلي</span> <span class=\"st\">رجّح غيره</span> «الصيحة في قصة صالح في معنى العذاب والخزي إذ كانت منتظمة بقوله سبحانه: {ومن خزي يومئذ إن ربك هو القوي العزيز} فصارت الصيحة عبارة عن ذلك الخزي وعن العذاب المذكور في الآية فقوي التذكير»<cite>«بدائع الفوائد» 1/126</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=es#s11a67\">Abrir en el tafsir interactivo (textos completos)</a><div class=\"pn\"><a href=\"/es/ayah/11-59.html\">Aleya anterior (11:59)</a><a href=\"/es/ayah/11-78.html\">Aleya siguiente (11:78)</a></div></main><footer class=\"site-foot\"><span>Tafsir de los dos Shaij · <a href=\"/es/\">Inicio</a> · <a href=\"/about.html\">Sobre el proyecto</a> · <a href=\"/privacy.html\">Privacidad y condiciones</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/11-78.html":"<!doctype html>\n<html lang=\"es\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir de Hud 11:78 — según Ibn Taymiyya e Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Y los hombres de su pueblo, que solían cometer obscenidades, se apresuraron hacia él (deseosos de cometer con sus huéspedes la inmoralidad a la que estaban\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/es/ayah/11-78.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/11-78.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/11-78.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/11-78.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/11-78.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/11-78.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/11-78.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/11-78.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/11-78.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/11-78.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/11-78.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/11-78.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/11-78.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/11-78.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/11-78.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/11-78.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/11-78.html\">\n<meta property=\"og:title\" content=\"Tafsir de Hud 11:78 — según Ibn Taymiyya e Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"Y los hombres de su pueblo, que solían cometer obscenidades, se apresuraron hacia él (deseosos de cometer con sus huéspedes la inmoralidad a la que estaban\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Inicio\", \"item\": \"https://tafsirshaikhain.com/es/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Hud\", \"item\": \"https://tafsirshaikhain.com/es/surah/11.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aleya 78\", \"item\": \"https://tafsirshaikhain.com/es/ayah/11-78.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/es/\">Inicio</a> › <a href=\"/es/surah/11.html\">Sura Hud</a> › Aleya 78</nav><h1>Tafsir de Sura Hud 11:78</h1><p class=\"vt ar\" lang=\"ar\">﴿وَجَاءَهُ قَوْمُهُ يُهْرَعُونَ إِلَيْهِ وَمِن قَبْلُ كَانُوا يَعْمَلُونَ السَّيِّئَاتِ قَالَ يَا قَوْمِ هَٰؤُلَاءِ بَنَاتِي هُنَّ أَطْهَرُ لَكُمْ فَاتَّقُوا اللَّهَ وَلَا تُخْزُونِ فِي ضَيْفِي أَلَيْسَ مِنكُمْ رَجُلٌ رَّشِيدٌ﴾</p><section><h3>Traducción del significado</h3><p class=\"tr\">Y los hombres de su pueblo, que solían cometer obscenidades, se apresuraron hacia él (deseosos de cometer con sus huéspedes la inmoralidad a la que estaban acostumbrados). Lot dijo: «¡Pueblo mío!, allí están mis hijas (para casaros con ellas); ellas son más puras para vosotros. Temed a Al-lah y no me avergoncéis ofendiendo a mis huéspedes. ¿Es que no hay entre vosotros ningún hombre sensato (que impida a los demás tales prácticas)?».</p><span class=\"cr\" dir=\"ltr\">Spanish Translation - Noor International Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Las palabras de los dos imames se ofrecen en el árabe original, literalmente, con sus referencias.</p><section><h2>Shaij al-Islam Ibn Taymiyya</h2><blockquote class=\"ar\" lang=\"ar\">وكانوا كفارًا من جهات من جهة استحلال الفاحشة ومن جهة الشرك ومن جهة تكذيب الرسل ففعلوا هذا وهذا ولكن الشرك والتكذيب مشترك بينهم وبين غيرهم والذي اختصوا به الفاحشة فلهذا عوقبوا عقوبة تخصهم لم يعاقب غيرهم بمثلها<cite>«تفسير آيات أشكلت على كثير من العلماء» 1/391</cite></blockquote></section><section><h2>El imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">فلما دخلوا إليه وهجموا عليه قال لهم وهو كظيم من الهم والغم وقلبه بالحزن عميد<cite>«روضة المحبين ونزهة المشتاقين» 1/192</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=es#s11a78\">Abrir en el tafsir interactivo (textos completos)</a><div class=\"pn\"><a href=\"/es/ayah/11-67.html\">Aleya anterior (11:67)</a><a href=\"/es/ayah/11-81.html\">Aleya siguiente (11:81)</a></div></main><footer class=\"site-foot\"><span>Tafsir de los dos Shaij · <a href=\"/es/\">Inicio</a> · <a href=\"/about.html\">Sobre el proyecto</a> · <a href=\"/privacy.html\">Privacidad y condiciones</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/11-81.html":"<!doctype html>\n<html lang=\"es\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir de Hud 11:81 — según Ibn Taymiyya e Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"(Los ángeles) dijeron: «¡Lot!, somos unos enviados de tu Señor. Tu pueblo no podrá hacerte ningún daño. Huye con tu familia durante la noche y que ninguno \">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/es/ayah/11-81.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/11-81.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/11-81.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/11-81.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/11-81.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/11-81.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/11-81.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/11-81.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/11-81.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/11-81.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/11-81.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/11-81.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/11-81.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/11-81.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/11-81.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/11-81.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/11-81.html\">\n<meta property=\"og:title\" content=\"Tafsir de Hud 11:81 — según Ibn Taymiyya e Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"(Los ángeles) dijeron: «¡Lot!, somos unos enviados de tu Señor. Tu pueblo no podrá hacerte ningún daño. Huye con tu familia durante la noche y que ninguno \">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Inicio\", \"item\": \"https://tafsirshaikhain.com/es/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Hud\", \"item\": \"https://tafsirshaikhain.com/es/surah/11.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aleya 81\", \"item\": \"https://tafsirshaikhain.com/es/ayah/11-81.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/es/\">Inicio</a> › <a href=\"/es/surah/11.html\">Sura Hud</a> › Aleya 81</nav><h1>Tafsir de Sura Hud 11:81</h1><p class=\"vt ar\" lang=\"ar\">﴿قَالُوا يَا لُوطُ إِنَّا رُسُلُ رَبِّكَ لَن يَصِلُوا إِلَيْكَ فَأَسْرِ بِأَهْلِكَ بِقِطْعٍ مِّنَ اللَّيْلِ وَلَا يَلْتَفِتْ مِنكُمْ أَحَدٌ إِلَّا امْرَأَتَكَ إِنَّهُ مُصِيبُهَا مَا أَصَابَهُمْ إِنَّ مَوْعِدَهُمُ الصُّبْحُ أَلَيْسَ الصُّبْحُ بِقَرِيبٍ﴾</p><section><h3>Traducción del significado</h3><p class=\"tr\">(Los ángeles) dijeron: «¡Lot!, somos unos enviados de tu Señor. Tu pueblo no podrá hacerte ningún daño. Huye con tu familia durante la noche y que ninguno de vosotros vuelva la mirada atrás, con la excepción de tu esposa. Le sucederá lo que a los demás. El momento fijado será el alba. ¿Acaso no está el alba cerca?».</p><span class=\"cr\" dir=\"ltr\">Spanish Translation - Noor International Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Las palabras de los dos imames se ofrecen en el árabe original, literalmente, con sus referencias.</p><section><h2>El imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">فنفس له رسل الله عن حقيقة الحال، وأعلموه أنهم ممن ليسوا يوصل إليهم، ولا إليه بسببهم، فلا تخف منهم، ولا تعبأ بهم، وهون عليك،<cite>«الجواب الكافي لمن سأل عن الدواء الشافي أو الداء والدواء» 1/172</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=es#s11a81\">Abrir en el tafsir interactivo (textos completos)</a><div class=\"pn\"><a href=\"/es/ayah/11-78.html\">Aleya anterior (11:78)</a><a href=\"/es/ayah/11-88.html\">Aleya siguiente (11:88)</a></div></main><footer class=\"site-foot\"><span>Tafsir de los dos Shaij · <a href=\"/es/\">Inicio</a> · <a href=\"/about.html\">Sobre el proyecto</a> · <a href=\"/privacy.html\">Privacidad y condiciones</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/11-88.html":"<!doctype html>\n<html lang=\"es\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir de Hud 11:88 — según Ibn Taymiyya e Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"(Shu&#x27;aib) respondió: «¡Pueblo mío!, decidme; si yo me basara en una prueba clara de mi Señor y Él me hubiese concedido una buena provisión, (¿la corromperí\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/es/ayah/11-88.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/11-88.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/11-88.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/11-88.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/11-88.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/11-88.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/11-88.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/11-88.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/11-88.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/11-88.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/11-88.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/11-88.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/11-88.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/11-88.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/11-88.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/11-88.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/11-88.html\">\n<meta property=\"og:title\" content=\"Tafsir de Hud 11:88 — según Ibn Taymiyya e Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"(Shu&#x27;aib) respondió: «¡Pueblo mío!, decidme; si yo me basara en una prueba clara de mi Señor y Él me hubiese concedido una buena provisión, (¿la corromperí\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Inicio\", \"item\": \"https://tafsirshaikhain.com/es/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Hud\", \"item\": \"https://tafsirshaikhain.com/es/surah/11.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aleya 88\", \"item\": \"https://tafsirshaikhain.com/es/ayah/11-88.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/es/\">Inicio</a> › <a href=\"/es/surah/11.html\">Sura Hud</a> › Aleya 88</nav><h1>Tafsir de Sura Hud 11:88</h1><p class=\"vt ar\" lang=\"ar\">﴿قَالَ يَا قَوْمِ أَرَأَيْتُمْ إِن كُنتُ عَلَىٰ بَيِّنَةٍ مِّن رَّبِّي وَرَزَقَنِي مِنْهُ رِزْقًا حَسَنًا وَمَا أُرِيدُ أَنْ أُخَالِفَكُمْ إِلَىٰ مَا أَنْهَاكُمْ عَنْهُ إِنْ أُرِيدُ إِلَّا الْإِصْلَاحَ مَا اسْتَطَعْتُ وَمَا تَوْفِيقِي إِلَّا بِاللَّهِ عَلَيْهِ تَوَكَّلْتُ وَإِلَيْهِ أُنِيبُ﴾</p><section><h3>Traducción del significado</h3><p class=\"tr\">(Shu&#x27;aib) respondió: «¡Pueblo mío!, decidme; si yo me basara en una prueba clara de mi Señor y Él me hubiese concedido una buena provisión, (¿la corrompería mezclándola con beneficios no lícitos basados en el engaño?) Yo no pretendo contradecirme incumpliendo lo que os prohíbo. Solo quiero corregiros en lo que pueda, pero el conseguirlo depende de Al-lah. En Él deposito mi confianza y ante Él me arrepiento.</p><span class=\"cr\" dir=\"ltr\">Spanish Translation - Noor International Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Las palabras de los dos imames se ofrecen en el árabe original, literalmente, con sus referencias.</p><section><h2>El imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">والإنابة الرجوع إلى الله وانصراف دواعى القلب وجواذبه إليه، وهى تتضمن المحبة والخشية<cite>«طريق الهجرتين وباب السعادتين» 1/173</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=es#s11a88\">Abrir en el tafsir interactivo (textos completos)</a><div class=\"pn\"><a href=\"/es/ayah/11-81.html\">Aleya anterior (11:81)</a><a href=\"/es/ayah/11-98.html\">Aleya siguiente (11:98)</a></div></main><footer class=\"site-foot\"><span>Tafsir de los dos Shaij · <a href=\"/es/\">Inicio</a> · <a href=\"/about.html\">Sobre el proyecto</a> · <a href=\"/privacy.html\">Privacidad y condiciones</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/11-98.html":"<!doctype html>\n<html lang=\"es\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir de Hud 11:98 — según Ibn Taymiyya e Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Irá al frente de su pueblo el Día de la Resurrección y los conducirá al fuego. ¡Y a qué pésimo lugar serán conducidos!\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/es/ayah/11-98.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/11-98.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/11-98.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/11-98.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/11-98.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/11-98.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/11-98.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/11-98.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/11-98.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/11-98.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/11-98.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/11-98.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/11-98.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/11-98.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/11-98.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/11-98.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/11-98.html\">\n<meta property=\"og:title\" content=\"Tafsir de Hud 11:98 — según Ibn Taymiyya e Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"Irá al frente de su pueblo el Día de la Resurrección y los conducirá al fuego. ¡Y a qué pésimo lugar serán conducidos!\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Inicio\", \"item\": \"https://tafsirshaikhain.com/es/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Hud\", \"item\": \"https://tafsirshaikhain.com/es/surah/11.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aleya 98\", \"item\": \"https://tafsirshaikhain.com/es/ayah/11-98.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/es/\">Inicio</a> › <a href=\"/es/surah/11.html\">Sura Hud</a> › Aleya 98</nav><h1>Tafsir de Sura Hud 11:98</h1><p class=\"vt ar\" lang=\"ar\">﴿يَقْدُمُ قَوْمَهُ يَوْمَ الْقِيَامَةِ فَأَوْرَدَهُمُ النَّارَ وَبِئْسَ الْوِرْدُ الْمَوْرُودُ﴾</p><section><h3>Traducción del significado</h3><p class=\"tr\">Irá al frente de su pueblo el Día de la Resurrección y los conducirá al fuego. ¡Y a qué pésimo lugar serán conducidos!</p><span class=\"cr\" dir=\"ltr\">Spanish Translation - Noor International Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Las palabras de los dos imames se ofrecen en el árabe original, literalmente, con sus referencias.</p><section><h2>Shaij al-Islam Ibn Taymiyya</h2><blockquote class=\"ar\" lang=\"ar\">فأخبر أنه يقدم قومه ولم يقل يسوقهم وأنه أوردهم النار. ومعلوم أن المتقدم إذا أورد المتأخرين النار: كان هو أول من يردها وإلا لم يكن قادما؛ بل كان سائقا؛<cite>«مجموع الفتاوى» 2/283</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=es#s11a98\">Abrir en el tafsir interactivo (textos completos)</a><div class=\"pn\"><a href=\"/es/ayah/11-88.html\">Aleya anterior (11:88)</a><a href=\"/es/ayah/11-101.html\">Aleya siguiente (11:101)</a></div></main><footer class=\"site-foot\"><span>Tafsir de los dos Shaij · <a href=\"/es/\">Inicio</a> · <a href=\"/about.html\">Sobre el proyecto</a> · <a href=\"/privacy.html\">Privacidad y condiciones</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}