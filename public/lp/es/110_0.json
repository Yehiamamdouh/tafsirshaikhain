, \"position\": 2, \"name\": \"Sura An-Nasr\", \"item\": \"https://tafsirshaikhain.com/es/surah/110.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aleya 1\", \"item\": \"https://tafsirshaikhain.com/es/ayah/110-1.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/es/\">Inicio</a> › <a href=\"/es/surah/110.html\">Sura An-Nasr</a> › Aleya 1</nav><h1>Tafsir de Sura An-Nasr 110:1</h1><p class=\"vt ar\" lang=\"ar\">﴿بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ إِذَا جَاءَ نَصْرُ اللَّهِ وَالْفَتْحُ﴾</p><section><h3>Traducción del significado</h3><p class=\"tr\">Cuando llegue el auxilio de Al-lah (a Su Profeta) y la liberación (de La Meca de la idolatría)</p><span class=\"cr\" dir=\"ltr\">Spanish Translation - Noor International Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Las palabras de los dos imames se ofrecen en el árabe original, literalmente, con sus referencias.</p><section><h2>Shaij al-Islam Ibn Taymiyya</h2><blockquote class=\"ar\" lang=\"ar\">وقد كان عمر يسأل ويسأل عن معاني الآيات الدقيقة وقد سأل أصحابه عن قوله {إذا جاء نصر الله والفتح} فذكروا ظاهر لفظها. ولما فسرها ابن عباس بأنها إعلام النبي صلى الله عليه وسلم بقرب وفاته قال: ما أعلم منها إلا ما تعلم. وهذا باطن الآية الموافق لظاهرها. فإنه لما أمر بالاستغفار عند ظهور الدين والاستغفار يؤمر به عند ختام الأعمال وبظهور الدين حصل مقصود الرسالة علموا أنه إعلام بقرب الأجل مع أمور أخر<cite>«مجموع الفتاوى» 16/416</cite></blockquote></section><section><h2>El imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">فإنه - سبحانه - لن يعلق الاستغفار بعمله، بل علقه بما يحدثه هو - سبحانه - من نعمة فتحه على رسوله ودخول الناس في دينه، وهذا ليس بسبب للاستغفار، فعلم أن سبب الاستغفار غيره، وهو حضور الأجل<cite>«إعلام الموقعين عن رب العالمين» 1/266</cite></blockquote><h3>Lo que citó de otros</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن عباس</span> <span class=\"st\">أقرّه</span> «هو أجل رسول الله - صلى الله عليه وسلم -، أعلمه إياه»<cite>«إعلام الموقعين عن رب العالمين» 1/266</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=es#s110a1\">Abrir en el tafsir interactivo (textos completos)</a><div class=\"pn\"><span></span><a href=\"/es/ayah/110-2.html\">Aleya siguiente (110:2)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/110-1.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/110-1.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/110-1.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/110-1.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/110-1.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/110-1.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/110-1.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/110-1.html\" hreflang=\"ms\"