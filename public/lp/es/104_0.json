lang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/104-2.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/104-2.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/104-2.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/104-2.html\">\n<meta property=\"og:title\" content=\"Tafsir de Al-Humaza 104:2 — según Ibn Taymiyya e Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"(¡Ay de) aquel que acumula bienes y los cuenta (continuamente)\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/es/\">Inicio</a> › <a href=\"/es/surah/104.html\">Sura Al-Humaza</a> › Aleya 2</nav><h1>Tafsir de Sura Al-Humaza 104:2</h1><p class=\"vt ar\" lang=\"ar\">﴿الَّذِي جَمَعَ مَالًا وَعَدَّدَهُ﴾</p><section><h3>Traducción del significado</h3><p class=\"tr\">(¡Ay de) aquel que acumula bienes y los cuenta (continuamente)</p><span class=\"cr\" dir=\"ltr\">Spanish Translation - Noor International Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Las palabras de los dos imames se ofrecen en el árabe original, literalmente, con sus referencias.</p><section><h2>Shaij al-Islam Ibn Taymiyya</h2><blockquote class=\"ar\" lang=\"ar\">وصفه بالطعن في الناس والعيب لهم وبجمع المال وتعديده<cite>«مجموع الفتاوى» 16/522</c