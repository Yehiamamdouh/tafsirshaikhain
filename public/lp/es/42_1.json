ication/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Inicio\", \"item\": \"https://tafsirshaikhain.com/es/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Ash-Shura\", \"item\": \"https://tafsirshaikhain.com/es/surah/42.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aleya 53\", \"item\": \"https://tafsirshaikhain.com/es/ayah/42-53.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.muy{display:grid;gap:6px;background:var(--sheet,#fff);border:1px dashed var(--line,#d9dee6);border-inline-start:4px solid var(--muted,#5b6676);border-radius:10px;padding:12px 14px;margin:4px 0}.muy-head{display:flex;flex-wrap:wrap;gap:4px 10px;align-items:baseline}.muy-head b{font-family:var(--f-display,sans-serif);font-weight:600;font-size:15px}.muy-head small{font-size:12.5px;color:var(--muted,#5b6676)}.muy-text{margin:0;font-family:var(--f-read,serif);font-size:17px;line-height:1.95;overflow-wrap:anywhere}.muy-fn{margin:0;font-size:14px;line-height:1.7;color:var(--muted,#5b6676);white-space:pre-line}.muy-credit{font-size:12px;color:var(--muted,#5b6676);overflow-wrap:anywhere}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/es/\">Inicio</a> › <a href=\"/es/surah/42.html\">Sura Ash-Shura</a> › Aleya 53</nav><h1>Tafsir de Sura Ash-Shura 42:53</h1><p class=\"vt ar\" lang=\"ar\">﴿صِرَاطِ اللَّهِ الَّذِي لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ أَلَا إِلَى اللَّهِ تَصِيرُ الْأُمُورُ﴾</p><section><h3>Traducción del significado</h3><p class=\"tr\">(hacia) el camino de Al-lah, a Quien pertenece cuanto hay en los cielos y en la tierra. Ciertamente, todos los asuntos retornarán a Al-lah (para que decida sobre ellos).</p><span class=\"cr\" dir=\"ltr\">Spanish Translation - Noor International Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Las palabras de los dos imames se ofrecen en el árabe original, literalmente, con sus referencias.</p><section><h2>Shaij al-Islam Ibn Taymiyya</h2><blockquote class=\"ar\" lang=\"ar\">فالصراط المستقيم هو ما بعث الله به رسوله محمدا صلى الله عليه وسلم بفعل ما أمر وترك ما حظر وتصديقه فيما أخبر ولا طريق إلى الله إلا ذلك<cite>«مجموع الفتاوى» 1/197</cite></blockquote></section><section><h2>El imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">والصراط تارة يضاف إلى الله، إذ هو الذي شرعه ونصبه، كقوله تعالى {وأن هذا صراطي مستقيما} [الأنعام: 153] وقوله {وإنك لتهدي إلى صراط مستقيم صراط الله} [الشورى: 52]<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/34</cite></blockquote></section><div class=\"muy\"><div class=\"muy-head\"><b>Al-Mujtasar: exégesis abreviada del Noble Corán</b><small>El sentido general de la aleya — no son palabras de los dos shaij</small></div><p class=\"muy-text\">53. El sendero de Al-lah, a Quien pertenece todo lo que está en el cielo y lo que está en la Tierra. Él lo creó, lo posee y lo controla todo. Sin duda, todos los asuntos retornan solo a Al‑lah.</p><a class=\"muy-credit\" href=\"https://quranenc.com/en/browse/spanish_mokhtasar\" target=\"_blank\" rel=\"noopener\" dir=\"ltr\">Spanish Translation of Al-Mukhtasar in Interpreting the Noble Quran — 2026-11-04 · QuranEnc.com</a></div><a class=\"btn pri open\" href=\"/tafsir.html?lang=es#s42a53\">Abrir en el tafsir interactivo (textos completos)</a><div class=\"pn\"><a href=\"/es/ayah/42-52.html\">Aleya anterior (42:52)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/42-53.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/42-53.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/42-53.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/42-53.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/42-53.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/42-53.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/42-53.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/42-53.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/42-53.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/42-53.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/42-53.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/42-53.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <b lang=\"es\">Español</b> · <a href=\"/de/ayah/42-53.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/42-53.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a> · <a href=\"/hi/ayah/42-53.html\" hreflang=\"hi\" lang=\"hi\" data-l=\"hi\">हिन्दी</a> · <a href=\"/ps/ayah/42-53.html\" hreflang=\"ps\" lang=\"ps\" data-l=\"ps\">پښتو</a> · <a href=\"/so/ayah/42-53.html\" hreflang=\"so\" lang=\"so\" data-l=\"so\">Soom