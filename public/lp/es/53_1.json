reflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/53-56.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/53-56.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/53-56.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/53-56.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/53-56.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/53-56.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/53-56.html\">\n<meta property=\"og:title\" content=\"Tafsir de An-Najm 53:56 — según Ibn Taymiyya e Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"Este mensajero (Muhammad) es un amonestador como los mensajeros que lo precedieron.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/es/\">Inicio</a> › <a href=\"/es/surah/53.html\">Sura An-Najm</a> › Aleya 56</nav><h1>Tafsir de Sura An-Najm 53:56</h1><p class=\"vt ar\" lang=\"ar\">﴿هَٰذَا نَذِيرٌ مِّنَ النُّذُرِ الْأُولَىٰ﴾</p><section><h3>Traducción del significado</h3><p class=\"tr\">Este mensajero (Muhammad) es un amonestador como los mensajeros que lo precedieron.</p><span class=\"cr\" dir=\"ltr\">Spanish Translation - Noor International Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Las palabras de los dos imames se ofrecen en el árabe original, literalmente, con sus referencias.</p><section><h2>Shaij al-Islam Ibn Taymiyya</h2><blockquote class=\"ar\" lang=\"ar\">قيل: محمد، وقيل: القرآن، وهما متلازمان<cite>«مجموع الفتاوى» 8/209</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">يقول: هذا نذير أنذر بما أنذرت به الرسل، والكتب الأولى. وقوله: من النذر الأولى، أي من جنسها،<cite>«مجموع الفتاوى» 8/209</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=es#s53a56\">Abrir en el tafsir interactivo (textos completos)</a><div class=\"pn\"><a href=\"/es/ayah/53-55.html\">Aleya anterior (53:55)</a><a href=\"/es/ayah/53-61.html\">Aleya siguiente (53:61)</a></div></main><footer class=\"site-foot\"><span>Tafsir de los dos Shaij · <a href=\"/es/\">Inicio</a> · <a href=\"/about.html\">Sobre el proyecto</a> · <a href=\"/privacy.html\">Privacidad y condiciones</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/53-61.html":"<!doctype html>\n<html lang=\"es\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir de An-Najm 53:61 — según Ibn Taymiyya e Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"¿Y vivís indiferentes a la otra vida y alejados de la verdad?\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/es/ayah/53-61.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/53-61.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/53-61.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/53-61.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/53-61.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/53-61.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/53-61.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/53-61.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/53-61.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/53-61.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/53-61.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/53-61.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/53-61.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/53-61.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/53-61.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/53-61.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/53-61.html\">\n<meta property=\"og:title\" content=\"Tafsir de An-Najm 53:61 — según Ibn Taymiyya e Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"¿Y vivís indiferentes a la otra vida y alejados de la verdad?\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/es/\">Inicio</a> › <a href=\"/es/surah/53.html\">Sura An-Najm</a> › Aleya 61</nav><h1>Tafsir de Sura An-Najm 53:61</h1><p class=\"vt ar\" lang=\"ar\">﴿وَأَنتُمْ سَامِدُونَ﴾</p><section><h3>Traducción del significado</h3><p class=\"tr\">¿Y vivís indiferentes a la otra vida y alejados de la verdad?</p><span class=\"cr\" dir=\"ltr\">Spanish Translation - Noor International Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Las palabras de los dos imames se ofrecen en el árabe original, literalmente, con sus referencias.</p><section><h2>El imam Ibn al-Qayyim</h2><h3>Lo que citó de otros</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">غير واحد من السلف</span> <span class=\"st\">حكاه</span> «هو الغناء، يقال: سمد لنا أي غنى لنا.»<cite>«الكلام على مسألة السماع» 1/131</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=es#s53a61\">Abrir en el tafsir interactivo (textos completos)</a><div class=\"pn\"><a href=\"/es/ayah/53-56.html\">Aleya anterior (53:56)</a></div></main><footer class=\"site-foot\"><span>Tafsir de los dos Shaij · <a href=\"/es/\">Inicio</a> · <a href=\"/about.html\">Sobre el proyecto</a> · <a href=\"/privacy.html\">Privacidad y condiciones</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}