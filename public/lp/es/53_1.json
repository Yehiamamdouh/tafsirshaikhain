ent\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Inicio\", \"item\": \"https://tafsirshaikhain.com/es/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura An-Najm\", \"item\": \"https://tafsirshaikhain.com/es/surah/53.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aleya 55\", \"item\": \"https://tafsirshaikhain.com/es/ayah/53-55.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/es/\">Inicio</a> › <a href=\"/es/surah/53.html\">Sura An-Najm</a> › Aleya 55</nav><h1>Tafsir de Sura An-Najm 53:55</h1><p class=\"vt ar\" lang=\"ar\">﴿فَبِأَيِّ آلَاءِ رَبِّكَ تَتَمَارَىٰ﴾</p><section><h3>Traducción del significado</h3><p class=\"tr\">¿Qué favor de los que tu Señor te ha concedido pondrás en duda (¡oh, hombre!)?</p><span class=\"cr\" dir=\"ltr\">Spanish Translation - Noor International Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Las palabras de los dos imames se ofrecen en el árabe original, literalmente, con sus referencias.</p><section><h2>Shaij al-Islam Ibn Taymiyya</h2><blockquote class=\"ar\" lang=\"ar\">والآلاء: هي النعم؛ والنعم كلها من آياته الدالة على نفسه المقدسة ووحدانيته ونعوته ومعاني أسمائه<cite>«مجموع الفتاوى» 8/31</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">قلت: قد ضمن {تتمارى} معنى تكذب. ولهذا عداه بالتاء.<cite>«مجموع الفتاوى» 14/302</cite></blockquote><h3>Lo que citó de otros</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن عباس</span> <span class=\"st\">أقرّه</span> «قال ابن عباس: تكذب؟ .»<cite>«مجموع الفتاوى» 14/302</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=es#s53a55\">Abrir en el tafsir interactivo (textos completos)</a><div class=\"pn\"><a href=\"/es/ayah/53-50.html\">Aleya anterior (53:50)</a><a href=\"/es/ayah/53-56.html\">Aleya siguiente (53:56)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/53-55.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/53-55.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/53-55.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/53-55.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/53-55.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/53-55.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/53-55.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/53-55.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/53-55.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/53-55.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/53-55.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/53-55.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <b lang=\"es