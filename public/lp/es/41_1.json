operty=\"og:type\" content=\"article\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta property=\"og:image:width\" content=\"1200\">\n<meta property=\"og:image:height\" content=\"630\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<link rel=\"manifest\" href=\"/manifest.webmanifest\">\n<link rel=\"apple-touch-icon\" href=\"/icon-192.png\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"Tafsir de Fussilat 41:51 — según Ibn Taymiyya e Ibn al-Qayyim\", \"description\": \"Y cuando agraciamos al hombre con algún favor, se aleja (ingrato) y se aparta (con arrogancia de la verdad); pero si le sucede una desgracia, no deja de su\", \"inLanguage\": \"es\", \"url\": \"https://tafsirshaikhain.com/es/ayah/41-51.html\", \"mainEntityOfPage\": \"https://tafsirshaikhain.com/es/ayah/41-51.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"Shaij al-Islam Ibn Taymiyya\"}, {\"@type\": \"Person\", \"name\": \"El imam Ibn al-Qayyim\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"Tafsir de los dos Shaij\", \"url\": \"https://tafsirshaikhain.com/es/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Inicio\", \"item\": \"https://tafsirshaikhain.com/es/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Fussilat\", \"item\": \"https://tafsirshaikhain.com/es/surah/41.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aleya 51\", \"item\": \"https://tafsirshaikhain.com/es/ayah/41-51.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.muy{display:grid;gap:6px;background:var(--sheet,#fff);border:1px dashed var(--line,#d9dee6);border-inline-start:4px solid var(--muted,#5b6676);border-radius:10px;padding:12px 14px;margin:4px 0}.muy-head{display:flex;flex-wrap:wrap;gap:4px 10px;align-items:baseline}.muy-head b{font-family:var(--f-display,sans-serif);font-weight:600;font-size:15px}.muy-head small{font-size:12.5px;color:var(--muted,#5b6676)}.muy-text{margin:0;font-family:var(--f-read,serif);font-size:17px;line-height:1.95;overflow-wrap:anywhere}.muy-fn{margin:0;font-size:14px;line-height:1.7;color:var(--muted,#5b6676);white-space:pre-line}.muy-credit{font-size:12px;color:var(--muted,#5b6676);overflow-wrap:anywhere}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/es/\">Inicio</a> › <a href=\"/es/surah/41.html\">Sura Fussilat</a> › Aleya 51</nav><h1>Tafsir de Sura Fussilat 41:51</h1><p class=\"vt ar\" lang=\"ar\">﴿وَإِذَا أَنْعَمْنَا عَلَى الْإِنسَانِ أَعْرَضَ وَنَأَىٰ بِجَانِبِهِ وَإِذَا مَسَّهُ الشَّرُّ فَذُو دُعَاءٍ عَرِيضٍ﴾</p><section><h3>Traducción del significado</h3><p class=\"tr\">Y cuando agraciamos al hombre con algún favor, se aleja (ingrato) y se aparta (con arrogancia de la verdad); pero si le sucede una desgracia, no deja de suplicarnos (ayuda).</p><span class=\"cr\" dir=\"ltr\">Spanish Translation - Noor International Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Las palabras de los dos imames se ofrecen en el árabe original, literalmente, con sus referencias.</p><section><h2>Shaij al-Islam Ibn Taymiyya</h2><blockquote class=\"ar\" lang=\"ar\">وحزب يتضرعون إليه في حال الضراء. ويتوبون إليه. فإذا كشفها عنهم: أعرضوا عنه كما قال تعالى {وإذا مس الإنسان الضر دعانا لجنبه أو قاعدا أو قائما فلما كشفنا عنه ضره مر كأن لم يدعنا إلى ضر مسه كذلك زين للمسرفين ما كانوا يعملون} وقال تعالى {وإذا أنعمنا على الإنسان أعرض ونأى بجانبه وإذا مسه الشر فذو دعاء عريض}<cite>«مجموع الفتاوى» 14/371</cite></blockquote></section><div class=\"muy\"><div class=\"muy-head\"><b>Al-Mujtasar: exégesis abreviada del Noble Corán</b><small>El sentido general de la aleya — no son palabras de los dos shaij</small></div><p class=\"muy-text\">51. Cuando bendigo al ser humano con el favor de la salud, el bienestar y otras cosas, luego se olvida de obedecer a Al-lah y se aleja soberbio. Cuando la enfermedad, la pobreza y cosas similares lo afligen, entonces vuelve a suplicar a Al-lah, quejándose de lo que lo afligió para que se lo quite, pero no le agradece a Su Señor cuando lo bendice y no es paciente cuando lo prueba.</p><a class=\"muy-credit\" href=\"https://quranenc.com/en/browse/spanish_mokhtasar\" target=\"_blank\" rel=\"noopener\" dir=\"ltr\">Spanish Translation of Al-Mukhtasar in Interpreting the Noble Quran — 2026-11-04 · QuranEnc.com</a></div><a class=\"btn pri open\" href=\"/tafsir.html?lang=es#s41a51\">Abrir en el tafsir interactivo (textos completos)</a><div class=\"pn\"><a href=\"/es/ayah/41-50.html\">Aleya anterior (41:50)</a><a href=\"/es/ayah/41-53.html\">Aleya siguiente (41:53)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/41-51.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/e