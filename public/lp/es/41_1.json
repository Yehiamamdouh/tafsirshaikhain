ype\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Inicio\", \"item\": \"https://tafsirshaikhain.com/es/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Fussilat\", \"item\": \"https://tafsirshaikhain.com/es/surah/41.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aleya 50\", \"item\": \"https://tafsirshaikhain.com/es/ayah/41-50.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/es/\">Inicio</a> › <a href=\"/es/surah/41.html\">Sura Fussilat</a> › Aleya 50</nav><h1>Tafsir de Sura Fussilat 41:50</h1><p class=\"vt ar\" lang=\"ar\">﴿وَلَئِنْ أَذَقْنَاهُ رَحْمَةً مِّنَّا مِن بَعْدِ ضَرَّاءَ مَسَّتْهُ لَيَقُولَنَّ هَٰذَا لِي وَمَا أَظُنُّ السَّاعَةَ قَائِمَةً وَلَئِن رُّجِعْتُ إِلَىٰ رَبِّي إِنَّ لِي عِندَهُ لَلْحُسْنَىٰ فَلَنُنَبِّئَنَّ الَّذِينَ كَفَرُوا بِمَا عَمِلُوا وَلَنُذِيقَنَّهُم مِّنْ عَذَابٍ غَلِيظٍ﴾</p><section><h3>Traducción del significado</h3><p class=\"tr\">Y si le enviamos Nuestra misericordia después de haber sufrido la adversidad, dice: «Esto lo he conseguido por mérito propio, y no creo que la Hora tenga lugar. Y si de verdad regresara a mi Señor, se me concederíalo mejor de todo (el paraíso)»Y, realmente, informaremos a quienes rechazaban la verdad sobre lo que hicieron y los haremos sufrir un severo castigo.</p><span class=\"cr\" dir=\"ltr\">Spanish Translation - Noor International Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Las palabras de los dos imames se ofrecen en el árabe original, literalmente, con sus referencias.</p><section><h2>El imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">واعظم الناس غرورا بربه من إذا مسه الله برحمة منه وفضل قال هذا لي أي أنا أهله وجدير به ومستحق له ثم قال {وما أظن الساعة قائمة} فظن أنه أهل لما أولاه من النعم مع كفره بالله<cite>«الروح في الكلام على أرواح الأموات والأحياء بالدلائل من الكتاب والسنة» 1/245</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">ثم زاد في غروره فقال {ولئن رجعت إلى ربي إن لي عنده للحسنى} يعني الجنة والكرامة<cite>«الروح في الكلام على أرواح الأموات والأحياء بالدلائل من الكتاب والسنة» 1/245</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=es#s41a50\">Abrir en el tafsir interactivo (textos completos)</a><div class=\"pn\"><a href=\"/es/ayah/41-49.html\">Aleya anterior (41:49)</a><a href=\"/es/ayah/41-51.html\">Aleya siguiente (41:51)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/41-50.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/41-50.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/41-50.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/41-50.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/41-50.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/41-50.html\" hreflang=\"fr\" lang=\"