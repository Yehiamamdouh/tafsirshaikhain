: \"https://tafsirshaikhain.com/es/ayah/78-38.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/es/\">Inicio</a> › <a href=\"/es/surah/78.html\">Sura An-Naba</a> › Aleya 38</nav><h1>Tafsir de Sura An-Naba 78:38</h1><p class=\"vt ar\" lang=\"ar\">﴿يَوْمَ يَقُومُ الرُّوحُ وَالْمَلَائِكَةُ صَفًّا لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ الرَّحْمَٰنُ وَقَالَ صَوَابًا﴾</p><section><h3>Traducción del significado</h3><p class=\"tr\">Ese día el ángel Gabriel se presentará junto con los ángeles alineados y solo hablará aquel a quien el Clemente conceda permiso y no dirá sino la verdad.</p><span class=\"cr\" dir=\"ltr\">Spanish Translation - Noor International Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Las palabras de los dos imames se ofrecen en el árabe original, literalmente, con sus referencias.</p><section><h2>Shaij al-Islam Ibn Taymiyya</h2><blockquote class=\"ar\" lang=\"ar\">فقد أخبر: أن &quot; الروح والملائكة &quot; يقومون صفا لا يتكلمون. وهذا هو تحقيق قوله {لا يملكون منه خطابا}<cite>«مجموع الفتاوى» 14/398</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=es#s78a38\">Abrir en el tafsir interactivo (textos completos)</a><div class=\"pn\"><a href=\"/es/ayah/78-37.html\">Aleya anterior (78:37)</a></div></main><footer class=\"site-foot\"><span>Tafsir de los dos Shaij · <a href=\"/es/\">Inicio</a> · <a href=\"/