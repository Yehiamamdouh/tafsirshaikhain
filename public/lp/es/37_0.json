n.com/fa/ayah/37-49.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/37-49.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/37-49.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/37-49.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/37-49.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/37-49.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/37-49.html\">\n<meta property=\"og:title\" content=\"Tafsir de As-Saaffaat 37:49 — según Ibn Taymiyya e Ibn al-Qayyim\">\n<meta property=\"og:description\" content=\"parecidas a perlas celosamente protegidas.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/es/\">Inicio</a> › <a href=\"/es/surah/37.html\">Sura As-Saaffaat</a> › Aleya 49</nav><h1>Tafsir de Sura As-Saaffaat 37:49</h1><p class=\"vt ar\" lang=\"ar\">﴿كَأَنَّهُنَّ بَيْضٌ مَّكْنُونٌ﴾</p><section><h3>Traducción del significado</h3><p class=\"tr\">parecidas a perlas celosamente protegidas.</p><span class=\"cr\" dir=\"ltr\">Spanish Translation - Noor International Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Las palabras de los dos imames se ofrecen en el árabe original, literalmente, con sus referencias.</p><section><h2>El imam Ibn al-Qayyim</h2><h3>Lo que citó de otros</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">حديث مرفوع</span> <span class=\"st\">استشهد به</span> «رقتهن كرقة الجلد الذي رأيت في داخل البيضة»<cite>«إعلام الموقعين عن رب العالمين» 4/211</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=es#s37a49\">Abrir en el tafsir interactivo (textos completos)</a><div class=\"pn\"><a href=\"/es/ayah/37-22.html\">Aleya anterior (37:22)</a><a href=\"/es/ayah/37-96.html\">Aleya siguiente (37:96)</a></div></main><footer class=\"site-foot\"><span>Tafsir de los dos Shaij · <a href=\"/es/\">Inicio</a> · <a href=\"/about.html\">Sobre el proyecto</a> · <a href=\"/privacy.html\">Privacidad y condiciones</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/37.html":"<!doctype html>\n<html lang=\"es\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir de Sura As-Saaffaat — según Ibn Taymiyya e Ibn al-Qayyim</title>\n<meta name=\"description\" content=\"Tafsir de Sura As-Saaffaat — El significado del Corán en las palabras de Ibn Taymiyya e Ibn al-Qayyim\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/es/surah/37.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/surah/37.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/surah/37.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/surah/37.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/surah/37.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/surah/37.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/surah/37.html\">\n<link rel=\"alternate