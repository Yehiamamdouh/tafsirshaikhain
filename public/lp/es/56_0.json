href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/es/\">Inicio</a> › <a href=\"/es/surah/56.html\">Sura Al-Waaqia</a> › Aleya 29</nav><h1>Tafsir de Sura Al-Waaqia 56:29</h1><p class=\"vt ar\" lang=\"ar\">﴿وَطَلْحٍ مَّنضُودٍ﴾</p><section><h3>Traducción del significado</h3><p class=\"tr\">y bananos cargados de frutas apiladas</p><span class=\"cr\" dir=\"ltr\">Spanish Translation - Noor International Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Las palabras de los dos imames se ofrecen en el árabe original, literalmente, con sus referencias.</p><section><h2>El imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">والمنضود: هو الذي قد نضد بعضه على بعض، كالمشط.<cite>«زاد المعاد في هدي خير العباد» 4/309</cite></blockquote><h3>Lo que citó de otros</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">أكثر المفسرين</span> <span class=\"st\">حكاه</span> «قال أكثر المفسرين، هو الموز. والمنضود: هو الذي قد نضد بعضه على بعض»<cite>«زاد المعاد في هدي خير العباد» 4/309</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=es#s56a29\">Abrir en el tafsir interactivo (textos completos)</a><div class=\"pn\"><a href=\"/es/ayah/56-26.html\">Aleya anterior (56:26)</a><a href=\"/es/ayah/56-60.html\">Aleya siguiente (56:60)</a></div></main><footer class=\"site-foot\"><span>Tafsir de los dos Shaij · <a href=\"/es/\">Inicio</a> · <a href=\"/about.html\">Sobre el proyecto</a> · <a href=\"/privacy.html\">Privacidad y condiciones</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/56.html":"<!doctype html>\n<html lang=\"es\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\