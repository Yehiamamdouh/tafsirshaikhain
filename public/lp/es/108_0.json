ype\": \"Person\", \"name\": \"El imam Ibn al-Qayyim\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"Tafsir de los dos Shaij\", \"url\": \"https://tafsirshaikhain.com/es/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Inicio\", \"item\": \"https://tafsirshaikhain.com/es/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Sura Al-Kawthar\", \"item\": \"https://tafsirshaikhain.com/es/surah/108.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Aleya 2\", \"item\": \"https://tafsirshaikhain.com/es/ayah/108-2.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/es/\">Inicio</a> › <a href=\"/es/surah/108.html\">Sura Al-Kawthar</a> › Aleya 2</nav><h1>Tafsir de Sura Al-Kawthar 108:2</h1><p class=\"vt ar\" lang=\"ar\">﴿فَصَلِّ لِرَبِّكَ وَانْحَرْ﴾</p><section><h3>Traducción del significado</h3><p class=\"tr\">Reza, pues, a tu Señor (con una fe sincera) y ofrece sacrificios (mencionando Su nombre).</p><span class=\"cr\" dir=\"ltr\">Spanish Translation - Noor International Center — v1.0.1 · QuranEnc.com</span></section><p class=\"cr\">Las palabras de los dos imames se ofrecen en el árabe original, literalmente, con sus referencias.</p><section><h2>Shaij al-Islam Ibn Taymiyya</h2><blockquote class=\"ar\" lang=\"ar\">أمره الله أن يجمع بين هاتين العبادتين العظيمتين وهما الصلاة والنسك الدالتان على القرب والتواضع والافتقار وحسن الظن<cite>«مجموع الفتاوى» 16/531</cite></blockquote></section><section><h2>El imam Ibn al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">الذبيحة تجري مجرى العبادة، ولهذا يقرن الله سبحانه بينهما كقوله: {فصل لربك وانحر} [الكوثر: 2] وقوله: {قل إن صلاتي ونسكي ومحياي ومماتي لله رب العالمين} [الأنعام: 162]<cite>«إعلام الموقعين عن رب العالمين» 2/118</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وبدأ في العيد بالصلاة ثم جعل النحر بعدها، وأخبر أن ( «من ذبح قبلها، فلا نسك له» ) تقديما لما بدأ الله به في قوله {فصل لربك وانحر}<cite>«زاد المعاد في هدي خير العباد» 2/320</cite></blockquote><h3>Lo que citó de otros</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">بعض المتأولين</span> <span class=\"st\">ردّه</span> «إن المراد به ضع يدك على نحرك»<cite>«الصواعق المرسلة في الرد على الجهمية والمعطلة» 2/695</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">علي</span> <span class=\"st\">حكاه</span> «إنه وضع اليمين على الشمال في الصلاة تحت صدره،»<cite>«إعلام الموقعين عن رب العالمين» 2/290</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=es#s108a2\">Abrir en el tafsir interactivo (textos completos)</a><div class=\"pn\"><a href=\"/es/ayah/108-1.html\">Aleya anterior (108:1)</a><a href=\"/es/ayah/108-3.html\">Aleya siguiente (108:3)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/108-2.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\"