\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Laman utama\", \"item\": \"https://tafsirshaikhain.com/ms/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Ar-Room\", \"item\": \"https://tafsirshaikhain.com/ms/surah/30.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 50\", \"item\": \"https://tafsirshaikhain.com/ms/ayah/30-50.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ms/\">Laman utama</a> › <a href=\"/ms/surah/30.html\">Surah Ar-Room</a> › Ayat 50</nav><h1>Tafsir Surah Ar-Room 30:50</h1><p class=\"vt ar\" lang=\"ar\">﴿فَانظُرْ إِلَىٰ آثَارِ رَحْمَتِ اللَّهِ كَيْفَ يُحْيِي الْأَرْضَ بَعْدَ مَوْتِهَا إِنَّ ذَٰلِكَ لَمُحْيِي الْمَوْتَىٰ وَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ﴾</p><section><h3>Terjemahan makna</h3><p class=\"tr\">Maka lihatlah olehmu kepada kesan-kesan rahmat Allah, bagaimana Ia menghidupkan bumi sesudah matinya (dengan tanaman-tanaman yang menghijau subur). Sesungguhnya Allah yang demikian kekuasaanNya, sudah tentu berkuasa menghidupkan orang-orang yang telah mati. Dan (ingatlah) Ia maha Kuasa atas tiap-tiap sesuatu.</p><span class=\"cr\" dir=\"ltr\">Malay Translation - Abdullah Basumayyah — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Kata-kata kedua-dua imam dipaparkan dalam bahasa Arab asal, kata demi kata, berserta rujukan.</p><section><h2>Syeikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">ولم يقل الله فانظر إلى آثار خطى الله وإنما قال: آثار رحمة<cite>«مجموع الفتاوى» 3/386</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">ورحمته هنا النبات.<cite>«مجموع الفتاوى» 3/386</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ms#s30a50\">Buka dalam tafsir interaktif (teks penuh)</a><div class=\"pn\"><a href=\"/ms/ayah/30-48.html\">Ayat sebelumnya (30:48)</a><a href=\"/ms/ayah/30-52.html\">Ayat seterusnya (30:52)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/30-50.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/30-50.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/30-50.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/30-50.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/30-50.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/30-50.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/30-50.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <b lang=\"ms\">Bahasa Melayu</b> · <a href=\"/fa/ayah/30-50.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/30-50.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/30-50.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/30-50.html\" hreflang=\"ha\" lang=\"ha\" data-l