/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ms/\">Laman utama</a> › <a href=\"/ms/surah/93.html\">Surah Ad-Dhuhaa</a> › Ayat 3</nav><h1>Tafsir Surah Ad-Dhuhaa 93:3</h1><p class=\"vt ar\" lang=\"ar\">﴿مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ﴾</p><section><h3>Terjemahan makna</h3><p class=\"tr\">(Bahawa) Tuhanmu (wahai Muhammad) tidak meninggalkanmu, dan Ia tidak benci (kepadamu, sebagaimana yang dituduh oleh kaum musyrik).</p><span class=\"cr\" dir=\"ltr\">Malay Translation - Abdullah Basumayyah — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Kata-kata kedua-dua imam dipaparkan dalam bahasa Arab asal, kata demi kata, berserta rujukan.</p><section><h2>Syeikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">والرسول هو الذي أنزل عليه القرآن والخطاب في هذه السور له كقوله {ما ودعك ربك وما قلى} وقوله {ألم نشرح لك صدرك} وقوله {اقرأ باسم ربك} .<cite>«مجموع الفتاوى» 16/284</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ms#s93a3\">Buka dalam tafsir interaktif (teks penuh)</a><div class=\"pn\"><a href=\"/ms/ayah/93-1.html\">Ayat sebelumnya (93:1)</a><a href=\"/ms/ayah/93-6.html\">Ayat seterusnya (93:6)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/ms/\">Laman utama</a> · <a href=\"/about.html\">Tentang projek</a> · <a href=\"/privacy.html\">Privasi &amp; terma</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/93-6.html":"<!doctype html>\n<html lang=\"ms\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n