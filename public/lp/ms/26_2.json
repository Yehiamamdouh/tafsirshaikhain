ink rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/26-123.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/26-123.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/26-123.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/26-123.html\">\n<meta property=\"og:title\" content=\"Tafsir Ash-Shu&#x27;araa 26:123 — menurut Ibnu Taimiyah dan Ibnu al-Qayyim\">\n<meta property=\"og:description\" content=\"(Demikian juga) kaum Aad telah mendustakan Rasul-rasul (yang diutus kepada mereka).\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ms/\">Laman utama</a> › <a href=\"/ms/surah/26.html\">Surah Ash-Shu&#x27;araa</a> › Ayat 123</nav><h1>Tafsir Surah Ash-Shu&#x27;araa 26:123</h1><p class=\"vt ar\" lang=\"ar\">﴿كَذَّبَتْ عَادٌ الْمُرْسَلِينَ﴾</p><section><h3>Terjemahan makna</h3><p class=\"tr\">(Demikian juga) kaum Aad telah mendustakan Rasul-rasul (yang diutus kepada mereka).</p><span class=\"cr\" dir=\"ltr\">Malay Translation - Abdullah Basumayyah — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Kata-kata kedua-dua imam dipaparkan dalam bahasa Arab asal, kata demi kata, berserta rujukan.</p><section><h2>Syeikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">ويشبه هذا أنه من كذب رسولا معينا كان كتكذيب جنس الرسل كما قيل فيه: {كذبت قوم نوح المرسلين} {كذبت عاد المرسلين} ونحو ذلك.<cite>«مجموع الفتاوى» 10/725</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ms#s26a123\">Buka dalam tafsir interaktif (teks penuh)</a><div class=\"pn\"><a href=\"/ms/ayah/26-105.html\">Ayat sebelumnya (26:105)</a><a href=\"/ms/ayah/26-193.html\">Ayat seterusnya (26:193)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/ms/\">Laman utama</a> · <a href=\"/about.html\">Tentang projek</a> · <a href=\"/privacy.html\">Privasi &amp; terma</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}