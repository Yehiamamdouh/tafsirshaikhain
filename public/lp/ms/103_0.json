ListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Laman utama\", \"item\": \"https://tafsirshaikhain.com/ms/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Al-Asr\", \"item\": \"https://tafsirshaikhain.com/ms/surah/103.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 3\", \"item\": \"https://tafsirshaikhain.com/ms/ayah/103-3.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ms/\">Laman utama</a> › <a href=\"/ms/surah/103.html\">Surah Al-Asr</a> › Ayat 3</nav><h1>Tafsir Surah Al-Asr 103:3</h1><p class=\"vt ar\" lang=\"ar\">﴿إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَتَوَاصَوْا بِالْحَقِّ وَتَوَاصَوْا بِالصَّبْرِ﴾</p><section><h3>Terjemahan makna</h3><p class=\"tr\">Kecuali orang-orang yang beriman dan beramal soleh, dan mereka pula berpesan-pesan dengan kebenaran serta berpesan-pesan dengan sabar.</p><span class=\"cr\" dir=\"ltr\">Malay Translation - Abdullah Basumayyah — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Kata-kata kedua-dua imam dipaparkan dalam bahasa Arab asal, kata demi kata, berserta rujukan.</p><section><h2>Syeikhul Islam Ibnu Taimiyah</h2><h3>Apa yang beliau nukilkan daripada orang lain</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الإمام الشافعي</span> <span class=\"st\">استشهد به</span> «لو فكر الناس كلهم في سورة (والعصر لكفت»<cite>«مجموع الفتاوى» 28/152</cite></blockquote></section><section><h2>Imam Ibnu al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">ولما كان الإنسان له قوتان قوة العلم وقوة العمل<cite>«التبيان في أقسام القرآن» 1/86</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فإن التواصي هو امر الغير بالإيمان والعمل الصالح وهو قدر زائد على مجرد فعله<cite>«التبيان في أقسام القرآن» 1/85</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">استثنى سبحانه من كمل قوته العلمية بالإيمان وقوته العملية بالعمل الصالح وإنقاد لأمر غيره له بذلك وأمر غيره به من الانسان الذي هو في خسر<cite>«التبيان في أقسام القرآن» 1/86</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ms#s103a3\">Buka dalam tafsir interaktif (teks penuh)</a><div class=\"pn\"><a href=\"/ms/ayah/103-2.html\">Ayat sebelumnya (103:2)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/ms/\">Laman utama</a> · <a href=\"/about.html\">Tentang projek</a> · <a href=\"/privacy.html\">Privasi &amp; terma</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/103.html":"<!doctype html>\n<html lang=\"ms\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir Surah Al-Asr — menurut Ibnu Taimiyah dan Ibnu al-Qayyim</title>\n<meta name=\"description\" content=\"Tafsir Surah Al-Asr — Makna al-Quran menerusi kata-kata Ibnu Taimiyah dan Ibnu al-Qayyim\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/ms/surah/103.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/surah/103.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/surah/103.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/surah/103.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/surah/103.html\">\n<link rel=\"alternate\" h