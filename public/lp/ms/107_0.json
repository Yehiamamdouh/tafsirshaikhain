position\": 1, \"name\": \"Laman utama\", \"item\": \"https://tafsirshaikhain.com/ms/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Al-Maa'un\", \"item\": \"https://tafsirshaikhain.com/ms/surah/107.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 5\", \"item\": \"https://tafsirshaikhain.com/ms/ayah/107-5.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ms/\">Laman utama</a> › <a href=\"/ms/surah/107.html\">Surah Al-Maa&#x27;un</a> › Ayat 5</nav><h1>Tafsir Surah Al-Maa&#x27;un 107:5</h1><p class=\"vt ar\" lang=\"ar\">﴿الَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ﴾</p><section><h3>Terjemahan makna</h3><p class=\"tr\">(laitu) mereka yang berkeadaan lalai daripada menyempurnakan sembahyangnya;</p><span class=\"cr\" dir=\"ltr\">Malay Translation - Abdullah Basumayyah — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Kata-kata kedua-dua imam dipaparkan dalam bahasa Arab asal, kata demi kata, berserta rujukan.</p><section><h2>Syeikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">وقد فسر السلف السهو عنها بتأخيرها عن وقتها، وبترك ما يؤمر به فيه<cite>«الفتاوى الكبرى لابن تيمية» 4/456</cite></blockquote><h3>Apa yang beliau nukilkan daripada orang lain</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">السلف</span> <span class=\"st\">أقرّه</span> «وقد فسر السلف السهو عنها بتأخيرها عن وقتها، وبترك ما يؤمر به فيه»<cite>«الفتاوى الكبرى لابن تيمية» 4/456</cite></blockquote></section><section><h2>Imam Ibnu al-Qayyim</h2><h3>Apa yang beliau nukilkan daripada orang lain</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">سعد بن أبي وقاص ومسروق بن الأجدع وغيرهما</span> <span class=\"st\">حكاه</span> «هو تركها حتى يخرج وقتها»<cite>«الصلاة وأحكام تاركها» 1/46</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">سعد بن أبي وقاص (جوابا لابنه مصعب)</span> <span class=\"st\">استشهد به</span> «إنه ليس ذاك ولكنه إضاعة الوقت»<cite>«الصلاة وأحكام تاركها» 1/46</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">محمد بن كعب القرظي</span> <span class=\"st\">حكاه</span> «هو تاركها»<cite>«الصلاة وأحكام تاركها» 1/46</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">النبي صلى الله عليه وسلم</span> <span class=\"st\">استشهد به</span> «هم الذين يؤخرون الصلاة عن وقتها»<cite>«الصلاة وأحكام تاركها» 1/46</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ms#s107a5\">Buka dalam tafsir interaktif (teks penuh)</a><div class=\"pn\"><a href=\"/ms/ayah/107-4.html\">Ayat sebelumnya (107:4)</a><a href=\"/ms/ayah/107-6.html\">Ayat seterusnya (107:6)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/ms/\">Laman utama</a> · <a href=\"/about.html\">Tentang projek</a> · <a href=\"/privacy.html\">Privasi &amp; terma</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/107-6.html":"<!doctype html>\n<html lang=\"ms\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir Al-Maa&#x27;un 107:6 — menurut Ibnu Taimiyah dan Ibnu al-Qayyim</title>\n<meta name=\"description\" content=\"(Juga bagi) orang-orang yang berkeadaan riak (bangga diri dalam ibadat dan bawaannya),\">\n<link rel=\"canonical\" href=\"https://tafsirs