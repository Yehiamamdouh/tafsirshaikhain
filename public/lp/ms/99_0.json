st\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Laman utama\", \"item\": \"https://tafsirshaikhain.com/ms/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Az-Zalzala\", \"item\": \"https://tafsirshaikhain.com/ms/surah/99.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 4\", \"item\": \"https://tafsirshaikhain.com/ms/ayah/99-4.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ms/\">Laman utama</a> › <a href=\"/ms/surah/99.html\">Surah Az-Zalzala</a> › Ayat 4</nav><h1>Tafsir Surah Az-Zalzala 99:4</h1><p class=\"vt ar\" lang=\"ar\">﴿يَوْمَئِذٍ تُحَدِّثُ أَخْبَارَهَا﴾</p><section><h3>Terjemahan makna</h3><p class=\"tr\">Pada hari itu bumipun menceritakan khabar beritanya:</p><span class=\"cr\" dir=\"ltr\">Malay Translation - Abdullah Basumayyah — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Kata-kata kedua-dua imam dipaparkan dalam bahasa Arab asal, kata demi kata, berserta rujukan.</p><section><h2>Syeikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">فالعجب في المخبر، لا في الخبر؛ كشهادة الأعضاء<cite>«النبوات» 2/880</cite></blockquote></section><section><h2>Imam Ibnu al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">إن في دوام الذكر في الطريق والبيت والحضر والسفر والبقاع تكثيرا لشهود العبد يوم القيامة، فإن البقعة والدار والجبل والأرض تشهد للذاكر يوم القيامة<cite>«الوابل الصيب من الكلم الطيب» 1/81</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ms#s99a4\">Buka dalam tafsir interaktif (teks penuh)</a><div class=\"pn\"><a href=\"/ms/ayah/99-1.html\">Ayat sebelumnya (99:1)</a><a href=\"/ms/ayah/99-7.html\">Ayat seterusnya (99:7)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/99-4.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/99-4.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/99-4.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/99-4.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/99-4.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/99-4.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/99-4.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <b lang=\"ms\">Bahasa Melayu</b> · <a href=\"/fa/ayah/99-4.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/99-4.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/99-4.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/99-4.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/99-4.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/99-4.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/99-4.html\" hreflang=\"zh\