ps://tafsirshaikhain.com/ms/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah An-Naba\", \"item\": \"https://tafsirshaikhain.com/ms/surah/78.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 38\", \"item\": \"https://tafsirshaikhain.com/ms/ayah/78-38.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ms/\">Laman utama</a> › <a href=\"/ms/surah/78.html\">Surah An-Naba</a> › Ayat 38</nav><h1>Tafsir Surah An-Naba 78:38</h1><p class=\"vt ar\" lang=\"ar\">﴿يَوْمَ يَقُومُ الرُّوحُ وَالْمَلَائِكَةُ صَفًّا لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ الرَّحْمَٰنُ وَقَالَ صَوَابًا﴾</p><section><h3>Terjemahan makna</h3><p class=\"tr\">(Tambahan pula) pada masa Jibril dan malaikat-malaikat yang lain berdiri bersaf-saf (menunggu perintah Tuhan), tidak ada yang berani berkata-kata (memohon pertimbangan) melainkan yang telah diizinkan baginya oleh Tuhan Yang Maha Pemurah, serta ia berkata benar.</p><span class=\"cr\" dir=\"ltr\">Malay Translation - Abdullah Basumayyah — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Kata-kata kedua-dua imam dipaparkan dalam bahasa Arab asal, kata demi kata, berserta rujukan.</p><section><h2>Syeikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">فقد أخبر: أن &quot; الروح والملائكة &quot; يقومون صفا لا يتكلمون. وهذا هو تحقيق قوله {لا يملكون منه خطابا}<cite>«مجموع الفتاوى» 14/398</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ms#s78a38\">Buka dalam tafsir interaktif (teks penuh)</a><div class=\"pn\"><a href=\"/ms/ayah/78-37.html\">Ayat sebelumnya (78:37)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/ms/\">Laman utama</a> · <a href=\"/about.html\">Tentang projek</a> · <a href=\"/privacy.html\">Privasi &amp; terma</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/78.html":"<!doctype html>\n<html lang=\"ms\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir Surah An-Naba — menurut Ibnu Taimiyah dan Ibnu al-Qayyim</title>\n<meta name=\"description\" content=\"Tafsir Surah An-Naba — Makna al-Quran menerusi kata-kata Ibnu Taimiyah dan Ibnu al-Qayyim\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/ms/surah/78.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/surah/78.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/surah/78.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/surah/78.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/surah/78.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/surah/78.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/surah/78.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/surah/78.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/surah/78.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/surah/78.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/surah/78.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\