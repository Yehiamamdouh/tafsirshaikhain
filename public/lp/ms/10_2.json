": \"https://tafsirshaikhain.com/ms/ayah/10-106.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ms/\">Laman utama</a> › <a href=\"/ms/surah/10.html\">Surah Yunus</a> › Ayat 106</nav><h1>Tafsir Surah Yunus 10:106</h1><p class=\"vt ar\" lang=\"ar\">﴿وَلَا تَدْعُ مِن دُونِ اللَّهِ مَا لَا يَنفَعُكَ وَلَا يَضُرُّكَ فَإِن فَعَلْتَ فَإِنَّكَ إِذًا مِّنَ الظَّالِمِينَ﴾</p><section><h3>Terjemahan makna</h3><p class=\"tr\">Dan janganlah engkau (wahai Muhammad) menyembah atau memuja yang lain dari Allah, yang tidak dapat mendatangkan manfaat kepadamu dan juga tidak dapat mendatangkan mudarat kepadamu. Oleh itu, sekiranya engkau mengerjakan yang demikian, maka pada saat itu menjadilah engkau dari orang-orang yang berlaku zalim (terhadap diri sendiri dengan perbuatan syirik itu).</p><span class=\"cr\" dir=\"ltr\">Malay Translation - Abdullah Basumayyah — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Kata-kata kedua-dua imam dipaparkan dalam bahasa Arab asal, kata demi kata, berserta rujukan.</p><section><h2>Imam Ibnu al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">فنفى سبحانه عن هؤلاء المعبودين من دونه النفع والضر القاصر والمتعدي فلا يملكونه لأنفسهم ولا لعابديهم.<cite>«بدائع الفوائد» 3/2</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ms#s10a106\">Buka dalam tafsir interaktif (teks penuh)</a><div class=\"pn\"><a href=\"/ms/ayah/10-103.html\">Ayat sebelumnya (10:103)</a><a href=\"/ms/ayah/10-107.html\">Ayat seterusnya (10:107)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/ms/\">Laman utama</a> · <a href=\"/about.html\">Tentang projek</a> · <a href=\"/privacy.html\">Privasi &amp; terma</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/10-107.html":"<!doctype html>\n<html lang=\"ms\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir Yunus 10:107 — menurut Ibnu Taimiyah dan Ibnu al-Qayyim</title>\n<meta name=\"description\" content=\"Dan jika Allah mengenakan engkau dengan sesuatu yang membahayakan, maka tiada sesiapa pun yang akan dapat menghapuskannya melainkan Dia; dan jika Ia menghe\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/ms/ayah/10-107.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/10-107.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/10-107.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/10-107.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/10-107.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/10-107.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/10-107.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/10-107.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/10-107.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/10-107.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/10-107.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/10-107.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/10-107.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/10-107.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/10-107.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/10-107.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/10-107.html\">\n<meta property=\"og:title\" content=\"Tafsir Yunus 10:107 — menurut Ibnu Taimiyah dan Ibnu al-Qayyim\">\n<meta property=\"og:description\" content=\"Dan jika Allah mengenakan engkau dengan sesuatu yang membahayakan, maka tiada sesiapa pun yang akan dapat menghapuskannya melainkan Dia; dan jika Ia menghe\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Laman utama\", \"item\": \"https://tafsirshaikhain.com/ms/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Yunus\", \"item\": \"https://tafsirshaikhain.com/ms/surah/10.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 107\", \"item\": \"https://tafsirshaikhain.com/ms/ayah/10-107.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ms/\">Laman utama</a> › <a href=\"/ms/surah/10.html\">Surah Yunus</a> › Ayat 107</nav><h1>Tafsir Surah Yunus 10:107</h1><p class=\"vt ar\" lang=\"ar\">﴿وَإِن يَمْسَسْكَ اللَّهُ بِضُرٍّ فَلَا كَاشِفَ لَهُ إِلَّا هُوَ وَإِن يُرِدْكَ بِخَيْرٍ فَلَا رَادَّ لِفَضْلِهِ يُصِيبُ بِهِ مَن يَشَاءُ مِنْ عِبَادِهِ وَهُوَ الْغَفُورُ الرَّحِيمُ﴾</p><section><h3>Terjemahan makna</h3><p class=\"tr\">Dan jika Allah mengenakan engkau dengan sesuatu yang membahayakan, maka tiada sesiapa pun yang akan dapat menghapuskannya melainkan Dia; dan jika Ia menghendaki engkau beroleh sesuatu kebaikan, maka tiada sesiapapun yang akan dapat menghalangi limpah kurniaNya. Allah melimpahkan kurniaNya itu kepada sesiapa yang dikendakiNya dari hamba-hambaNya, dan Dia lah yang Maha Pengampun lagi Maha Mengasihani.</p><span class=\"cr\" dir=\"ltr\">Malay Translation - Abdullah Basumayyah — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Kata-kata kedua-dua imam dipaparkan dalam bahasa Arab asal, kata demi kata, berserta rujukan.</p><section><h2>Syeikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">والذنوب سبب للضر والاستغفار يزيل أسبابه<cite>«مجموع الفتاوى» 10/255</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ms#s10a107\">Buka dalam tafsir interaktif (teks penuh)</a><div class=\"pn\"><a href=\"/ms/ayah/10-106.html\">Ayat sebelumnya (10:106)</a><a href=\"/ms/ayah/10-108.html\">Ayat seterusnya (10:108)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/ms/\">Laman utama</a> · <a href=\"/about.html\">Tentang projek</a> · <a href=\"/privacy.html\">Privasi &amp; terma</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/10-108.html"