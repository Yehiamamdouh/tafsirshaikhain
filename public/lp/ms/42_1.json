{\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 51\", \"item\": \"https://tafsirshaikhain.com/ms/ayah/42-51.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.muy{display:grid;gap:6px;background:var(--sheet,#fff);border:1px dashed var(--line,#d9dee6);border-inline-start:4px solid var(--muted,#5b6676);border-radius:10px;padding:12px 14px;margin:4px 0}.muy-head{display:flex;flex-wrap:wrap;gap:4px 10px;align-items:baseline}.muy-head b{font-family:var(--f-display,sans-serif);font-weight:600;font-size:15px}.muy-head small{font-size:12.5px;color:var(--muted,#5b6676)}.muy-text{margin:0;font-family:var(--f-read,serif);font-size:17px;line-height:1.95;overflow-wrap:anywhere}.muy-fn{margin:0;font-size:14px;line-height:1.7;color:var(--muted,#5b6676);white-space:pre-line}.muy-credit{font-size:12px;color:var(--muted,#5b6676);overflow-wrap:anywhere}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ms/\">Laman utama</a> › <a href=\"/ms/surah/42.html\">Surah Ash-Shura</a> › Ayat 51</nav><h1>Tafsir Surah Ash-Shura 42:51</h1><p class=\"vt ar\" lang=\"ar\">﴿وَمَا كَانَ لِبَشَرٍ أَن يُكَلِّمَهُ اللَّهُ إِلَّا وَحْيًا أَوْ مِن وَرَاءِ حِجَابٍ أَوْ يُرْسِلَ رَسُولًا فَيُوحِيَ بِإِذْنِهِ مَا يَشَاءُ إِنَّهُ عَلِيٌّ حَكِيمٌ﴾</p><section><h3>Terjemahan makna</h3><p class=\"tr\">Dan tidaklah layak bagi seseorang manusia bahawa Allah berkata-kata dengannya kecuali dengan jalan wahyu (dengan diberi ilham atau mimpi), atau dari sebalik dinding (dengan mendengar suara sahaja), atau dengan mengutuskan utusan (malaikat) lalu utusan itu menyampaikan wahyu kepadanya dengan izin Allah akan apa yang dikehendakiNya. Sesungguhnya Allah Maha Tinggi keadaanNya, lagi Maha Bijaksana.</p><span class=\"cr\" dir=\"ltr\">Malay Translation - Abdullah Basumayyah — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Kata-kata kedua-dua imam dipaparkan dalam bahasa Arab asal, kata demi kata, berserta rujukan.</p><section><h2>Syeikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">وقد بين الله تعالى أنواع تكليمه لعباده في قوله {وما كان لبشر أن يكلمه الله إلا وحيا أو من وراء حجاب أو يرسل رسولا فيوحي بإذنه ما يشاء} فبين سبحانه أن التكليم تارة يكون وحيا وتارة من وراء حجاب كما كلم موسى وتارة يرسل رسولا فيوحي الرسول بإذن الله ما يشاء<cite>«مجموع الفتاوى» 12/300</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فدل على أن التكليم من وراء حجاب - كما كلم موسى - أمر غير الإيحاء.<cite>«مجموع الفتاوى» 12/129</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فكان تكليم موسى من وراء الحجاب<cite>«مجموع الفتاوى» 12/515</cite></blockquote></section><section><h2>Imam Ibnu al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">قال الله تعالى {إنا أوحينا إليك كما أوحينا إلى نوح والنبيين من بعده} [النساء: 163] وقال {وما كان لبشر أن يكلمه الله إلا وحيا أو من وراء حجاب} [الشورى: 51] الآية، فجعل الوحي في هذه الآية قسما من أقسام التكليم، وجعله في آية النساء قسيما للتكليم، وذلك باعتبارين، فإنه قسيم التكليم الخاص الذي هو بلا واسطة، وقسم من التكليم العام الذي هو إيصال المعنى بطرق متعددة.<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 1/62</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ms#s42a51\">Buka dalam tafsir interaktif (teks penuh)</a><div class=\"pn\"><a href=\"/ms/ayah/42-50.html\">Ayat sebelumnya (42:50)</a><a href=\"/ms/ayah/42-52.html\">Ayat seterusnya (42:52)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/42-51.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/42-51.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/42-51.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/42-51.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/42-51.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/42-51.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/42-51.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <b lang=\"ms\">Bahasa Melayu</b> · <a href=\"/fa/ayah/42-51.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/42-51.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/42-51.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/42-51.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/42-51.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/42-51.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/42-51.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a> · <a href=\"/hi/ayah/42-51.html\" hreflang=\"hi\" lang=\"hi\" data-l=\"hi\">हिन्दी</a> · <a href=\"/ps/ayah/42-51.html\" hreflang=\"ps\" lang=\"ps\" data-l=\"ps\">پښتو</a> · <a href=\"/so/ayah/42-51.html\" hreflang=\"so\" lang=\"so\" data-l=\"so\">Soomaali</a> · <a href=\"/uz/ayah/42-51.html\" hreflang=\"uz\" lang=\"uz\" data-l=\"uz\">Ўзбекча</a> 