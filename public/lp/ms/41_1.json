\": [{\"@type\": \"Person\", \"name\": \"Syeikhul Islam Ibnu Taimiyah\"}, {\"@type\": \"Person\", \"name\": \"Imam Ibnu al-Qayyim\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"Tafsir al-Syaikhain\", \"url\": \"https://tafsirshaikhain.com/ms/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Laman utama\", \"item\": \"https://tafsirshaikhain.com/ms/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Fussilat\", \"item\": \"https://tafsirshaikhain.com/ms/surah/41.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 52\", \"item\": \"https://tafsirshaikhain.com/ms/ayah/41-52.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ms/\">Laman utama</a> › <a href=\"/ms/surah/41.html\">Surah Fussilat</a> › Ayat 52</nav><h1>Tafsir Surah Fussilat 41:52</h1><p class=\"vt ar\" lang=\"ar\">﴿قُلْ أَرَأَيْتُمْ إِن كَانَ مِنْ عِندِ اللَّهِ ثُمَّ كَفَرْتُم بِهِ مَنْ أَضَلُّ مِمَّنْ هُوَ فِي شِقَاقٍ بَعِيدٍ﴾</p><section><h3>Terjemahan makna</h3><p class=\"tr\">Katakanlah (wahai Muhammad): “Sudahkah nampak baiknya keadaan kamu jika Al-Quran ini (yang datangnya) dari Allah kemudian kamu mengingkarinya? Siapakah yang lebih sesat daripada orang yang tetap berada dalam perbalahan dan pertentangan, yang menyimpang jauh dari kebenaran?”</p><span class=\"cr\" dir=\"ltr\">Malay Translation - Abdullah Basumayyah — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Kata-kata kedua-dua imam dipaparkan dalam bahasa Arab asal, kata demi kata, berserta rujukan.</p><section><h2>Syeikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">والصواب الذي عليه المفسرون وعليه تدل الآية أن الضمير عائد إلى القرآن<cite>«درء تعارض العقل والنقل» 3/134</cite></blockquote></section><section><h2>Imam Ibnu al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">أي القرآن، فإنه هو المتقدم في قوله: {قل أرأيتم إن كان من عند الله ثم كفرتم به}<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 3/432</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ms#s41a52\">Buka dalam tafsir interaktif (teks penuh)</a><div class=\"pn\"><a href=\"/ms/ayah/41-51.html\">Ayat sebelumnya (41:51)</a><a href=\"/ms/ayah/41-53.html\">Ayat seterusnya (41:53)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/41-52.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/41-52.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/41-52.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/41-52.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/41-52.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/41-52.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/41-52.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <b lang=\"ms\">Bahasa Melayu</b> · <a href=\"/fa/ayah/41-52.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/41-52.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/41-52.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/41-52.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/41-52.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/41-52.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/41-52.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a></nav>\n<footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/ms/\">Laman utama</a> · <a href=\"/about.html\">Tentang projek</a> · <a href=\"/privacy.html\">Privasi &amp; terma</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n<script>try{localStorage.setItem(\"lang\",\"ms\")}catch(e){}document.addEventListener(\"click\",function(e){var a=e.target.closest&&e.target.closest(\"[data-l]\");if(a)try{localStorage.setItem(\"lang\",a.dataset.l)}catch(x){}})</script>\n</body>\n</html>\n","ayah/41-53.html":"<!doctype html>\n<html lang=\"ms\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir Fussilat 41:53 — menurut Ibnu Taimiyah dan Ibnu al-Qayyim</title>\n<meta name=\"description\" content=\"Kami akan perlihatkan kepada mereka tanda-tanda kekuasaan Kami di merata-rata tempat (dalam alam yang terbentang luas ini) dan pada diri mereka sendiri, se\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/ms/ayah/41-53.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/41-53.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/41-53.html\">\n