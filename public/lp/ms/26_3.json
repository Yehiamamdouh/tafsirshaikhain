ummary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Laman utama\", \"item\": \"https://tafsirshaikhain.com/ms/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Ash-Shu'araa\", \"item\": \"https://tafsirshaikhain.com/ms/surah/26.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 192\", \"item\": \"https://tafsirshaikhain.com/ms/ayah/26-192.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ms/\">Laman utama</a> › <a href=\"/ms/surah/26.html\">Surah Ash-Shu&#x27;araa</a> › Ayat 192</nav><h1>Tafsir Surah Ash-Shu&#x27;araa 26:192</h1><p class=\"vt ar\" lang=\"ar\">﴿وَإِنَّهُ لَتَنزِيلُ رَبِّ الْعَالَمِينَ﴾</p><section><h3>Terjemahan makna</h3><p class=\"tr\">Dan sesungguhnya Al-Quran (yang di antara isinya kisah-kisah yang tersebut) adalah diturunkan oleh Allah Tuhan sekalian alam.</p><span class=\"cr\" dir=\"ltr\">Malay Translation - Abdullah Basumayyah — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Kata-kata kedua-dua imam dipaparkan dalam bahasa Arab asal, kata demi kata, berserta rujukan.</p><section><h2>Syeikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">فجمع بين قوله: {إنه لقول رسول كريم} وبين قوله: {وإنه لتنزيل رب العالمين} والضميران عائدان إلى واحد فلو كان الرسول أحدثه وأنشأه لم يكن تنزيلا من رب العالمين؛ بل كان يكون تنزيلا من الرسول.<cite>«مجموع الفتاوى» 12/271</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ms#s26a192\">Buka dalam tafsir interaktif (teks penuh)</a><div class=\"pn\"><a href=\"/ms/ayah/26-189.html\">Ayat sebelumnya (26:189)</a><a href=\"/ms/ayah/26-193.html\">Ayat seterusnya (26:193)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/ms/\">Laman utama</a> · <a href=\"/about.html\">Tentang projek</a> · <a href=\"/privacy.html\">Privasi &amp; terma</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/26-193.html":"<!doctype html>\n<html lang=\"ms\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir Ash-Shu&#x27;araa 26:193 — menurut Ibnu Taimiyah dan Ibnu al-Qayyim</title>\n<meta name=\"description\" content=\"Ia dibawa turun oleh malaikat Jibril yang amanah.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/ms/ayah/26-193.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/26-193.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/26-193.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/26-193.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/26-193.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/26-193.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/26-193.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/26-193.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/26-193.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href