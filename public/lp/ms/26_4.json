"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Laman utama\", \"item\": \"https://tafsirshaikhain.com/ms/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Ash-Shu'araa\", \"item\": \"https://tafsirshaikhain.com/ms/surah/26.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 225\", \"item\": \"https://tafsirshaikhain.com/ms/ayah/26-225.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ms/\">Laman utama</a> › <a href=\"/ms/surah/26.html\">Surah Ash-Shu&#x27;araa</a> › Ayat 225</nav><h1>Tafsir Surah Ash-Shu&#x27;araa 26:225</h1><p class=\"vt ar\" lang=\"ar\">﴿أَلَمْ تَرَ أَنَّهُمْ فِي كُلِّ وَادٍ يَهِيمُونَ﴾</p><section><h3>Terjemahan makna</h3><p class=\"tr\">Tidakkah engkau melihat bahawa mereka merayau-rayau dengan tidak berketentuan hala dalam tiap-tiap lembah (khayal dan angan-angan kosong)?</p><span class=\"cr\" dir=\"ltr\">Malay Translation - Abdullah Basumayyah — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Kata-kata kedua-dua imam dipaparkan dalam bahasa Arab asal, kata demi kata, berserta rujukan.</p><section><h2>Syeikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">والغاوي: هو الذي يتبع هواه بغير علم؛ وهذا هو الغي؛ وهو خلاف الرشد.<cite>«مجموع الفتاوى» 28/163</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">والشعراء جرت عادتهم أن يمشوا مع الطبع؛ كما قال الله تعالى: {ألم تر أنهم في كل واد يهيمون} {وأنهم يقولون ما لا يفعلون}<cite>«مجموع الفتاوى» 28/163</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ms#s26a225\">Buka dalam tafsir interaktif (teks penuh)</a><div class=\"pn\"><a href=\"/ms/ayah/26-222.html\">Ayat sebelumnya (26:222)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/ms/\">Laman utama</a> · <a href=\"/about.html\">Tentang projek</a> · <a href=\"/privacy.html\">Privasi &amp; terma</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}