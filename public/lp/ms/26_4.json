/surah/26.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 221\", \"item\": \"https://tafsirshaikhain.com/ms/ayah/26-221.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ms/\">Laman utama</a> › <a href=\"/ms/surah/26.html\">Surah Ash-Shu&#x27;araa</a> › Ayat 221</nav><h1>Tafsir Surah Ash-Shu&#x27;araa 26:221</h1><p class=\"vt ar\" lang=\"ar\">﴿هَلْ أُنَبِّئُكُمْ عَلَىٰ مَن تَنَزَّلُ الشَّيَاطِينُ﴾</p><section><h3>Terjemahan makna</h3><p class=\"tr\">Mahukah, Aku khabarkan kepada kamu, kepada siapakah Syaitan-syaitan itu selalu turun?</p><span class=\"cr\" dir=\"ltr\">Malay Translation - Abdullah Basumayyah — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Kata-kata kedua-dua imam dipaparkan dalam bahasa Arab asal, kata demi kata, berserta rujukan.</p><section><h2>Syeikhul Islam Ibnu Taimiyah</h2><h3>Apa yang beliau nukilkan daripada orang lain</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن عمر أو ابن عباس (في المختار بن أبي عبيد)</span> <span class=\"st\">استشهد به</span> «وقيل للآخر: إنه يقول إنه ينزل عليه فقال {هل أنبئكم على من تنزل الشياطين}»<cite>«مجموع الفتاوى» 13/75</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ms#s26a221\">Buka dalam tafsir interaktif (teks penuh)</a><div class=\"pn\"><a href=\"/ms/ayah/26-217.html\">Ayat sebelumnya (26:217)</a><a href=\"/ms/ayah/26-222.ht