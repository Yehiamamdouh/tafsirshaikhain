a Kamilah sebaik-baik yang berkuasa menentukan dan melakukan (tiap-tiap sesuatu)!\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Laman utama\", \"item\": \"https://tafsirshaikhain.com/ms/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Al-Mursalaat\", \"item\": \"https://tafsirshaikhain.com/ms/surah/77.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 23\", \"item\": \"https://tafsirshaikhain.com/ms/ayah/77-23.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ms/\">Laman utama</a> › <a href=\"/ms/surah/77.html\">Surah Al-Mursalaat</a> › Ayat 23</nav><h1>Tafsir Surah Al-Mursalaat 77:23</h1><p class=\"vt ar\" lang=\"ar\">﴿فَقَدَرْنَا فَنِعْمَ الْقَادِرُونَ﴾</p><section><h3>Terjemahan makna</h3><p class=\"tr\">Serta Kami tentukan (keadaannya), maka Kamilah sebaik-baik yang berkuasa menentukan dan melakukan (tiap-tiap sesuatu)!</p><span class=\"cr\" dir=\"ltr\">Malay Translation - Abdullah Basumayyah — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Kata-kata kedua-dua imam dipaparkan dalam bahasa Arab asal, kata demi kata, berserta rujukan.</p><section><h2>Syeikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">وقد يستدل بقوله: {ألم نخلقكم من ماء مهين} إلى قوله؛ {فنعم القادرون} على قول من جعله من القدرة فإنه يتناول القدرة على المخلوقين وإن كان سبحانه قادرا أيضا على خلقه فالقدرة على خلقه قدرة عليه والقدرة عليه قدرة على خلقه<cite>«مجموع الفتاوى» 8/12</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ms#s77a23\">Buka dalam tafsir interaktif (teks penuh)</a><div class=\"pn\"><a href=\"/ms/ayah/77-20.html\">Ayat sebelumnya (77:20)</a><a href=\"/ms/ayah/77-39.html\">Ayat seterusnya (77:39)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/ms/\">Laman utama</a> · <a href=\"/about.html\">Tentang projek</a> · <a href=\"/privacy.html\">Privasi &amp; terma</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/77-39.html":"<!doctype html>\n<html lang=\"ms\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir Al-Mursalaat 77:39 — menurut Ibnu Taimiyah dan Ibnu al-Qayyim</title>\n<meta name=\"description\" content=\"Oleh itu, kalau kamu ada sebarang tipu-helah melepaskan diri, maka cubalah kamu lakukan terhadap azabKu.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/ms/ayah/77-39.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/77-39.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/77-39.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/77-39.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/77-39.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/77-39.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https: