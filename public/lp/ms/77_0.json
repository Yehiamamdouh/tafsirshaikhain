\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Laman utama\", \"item\": \"https://tafsirshaikhain.com/ms/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Al-Mursalaat\", \"item\": \"https://tafsirshaikhain.com/ms/surah/77.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 17\", \"item\": \"https://tafsirshaikhain.com/ms/ayah/77-17.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ms/\">Laman utama</a> › <a href=\"/ms/surah/77.html\">Surah Al-Mursalaat</a> › Ayat 17</nav><h1>Tafsir Surah Al-Mursalaat 77:17</h1><p class=\"vt ar\" lang=\"ar\">﴿ثُمَّ نُتْبِعُهُمُ الْآخِرِينَ﴾</p><section><h3>Terjemahan makna</h3><p class=\"tr\">Kemudian kami akan iringi mereka dengan (membinasakan orang-orang yang ingkar derhaka, dari) kaum-kaum yang datang kemudian.</p><span class=\"cr\" dir=\"ltr\">Malay Translation - Abdullah Basumayyah — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Kata-kata kedua-dua imam dipaparkan dalam bahasa Arab asal, kata demi kata, berserta rujukan.</p><section><h2>Syeikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">فهذه الآيات: تقتضي أن الهلاك استحالة وفساد في الشيء الموجود<cite>«مجموع الفتاوى» 2/29</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ms#s77a17\">Buka dalam tafsir interaktif (teks penuh)</a>