ah/55-70.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/55-70.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/55-70.html\">\n<meta property=\"og:title\" content=\"Tafsir Ar-Rahmaan 55:70 — menurut Ibnu Taimiyah dan Ibnu al-Qayyim\">\n<meta property=\"og:description\" content=\"Dalam kedua-dua Syurga itu juga terdapat (teman-teman) yang baik akhlaknya, lagi cantik parasnya;\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Laman utama\", \"item\": \"https://tafsirshaikhain.com/ms/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Ar-Rahmaan\", \"item\": \"https://tafsirshaikhain.com/ms/surah/55.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 70\", \"item\": \"https://tafsirshaikhain.com/ms/ayah/55-70.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ms/\">Laman utama</a> › <a href=\"/ms/surah/55.html\">Surah Ar-Rahmaan</a> › Ayat 70</nav><h1>Tafsir Surah Ar-Rahmaan 55:70</h1><p class=\"vt ar\" lang=\"ar\">﴿فِيهِنَّ خَيْرَاتٌ حِسَانٌ﴾</p><section><h3>Terjemahan makna</h3><p class=\"tr\">Dalam kedua-dua Syurga itu juga terdapat (teman-teman) yang baik akhlaknya, lagi cantik parasnya;</p><span class=\"cr\" dir=\"ltr\">Malay Translation - Abdullah Basumayyah — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Kata-kata kedua-dua imam dipaparkan dalam bahasa Arab asal, kata demi kata, berserta rujukan.</p><section><h2>Imam Ibnu al-Qayyim</h2><h3>Apa yang beliau nukilkan daripada orang lain</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">حديث مرفوع</span> <span class=\"st\">استشهد به</span> «خيرات الأخلاق، حسان الوجوه»<cite>«إعلام الموقعين عن رب العالمين» 4/211</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ms#s55a70\">Buka dalam tafsir interaktif (teks penuh)</a><div class=\"pn\"><a href=\"/ms/ayah/55-68.html\">Ayat sebelumnya (55:68)</a><a href=\"/ms/ayah/55-78.html\">Ayat seterusnya (55:78)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/ms/\">Laman utama</a> · <a href=\"/about.html\">Tentang projek</a> · <a href=\"/privacy.html\">Privasi &amp; terma</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/55-78.html":"<!doctype html>\n<html lang=\"ms\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir Ar-Rahmaan 55:78 — menurut Ibnu Taimiyah dan Ibnu al-Qayyim</title>\n<meta name=\"description\" content=\"Maha Sucilah nama Tuhanmu yang mempunyai Kebesaran dan Kemuliaan.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/ms/ayah/55-78.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/55-78.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/55-78.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/55-78.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/55-78.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/55-78.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/55-78.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/55-78.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/55-78.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/55-78.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/55-78.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/55-78.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/55-78.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/55-78.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/55-78.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/55-78.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/55-78.html\">\n<meta property=\"og:title\" content=\"Tafsir Ar-Rahmaan 55:78 — menurut Ibnu Taimiyah dan Ibnu al-Qayyim\">\n<meta property=\"og:description\" content=\"Maha Sucilah nama Tuhanmu yang mempunyai Kebesaran dan Kemuliaan.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"Laman utama\", \"item\": \"https://tafsirshaikhain.com/ms/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"Surah Ar-Rahmaan\", \"item\": \"https://tafsirshaikhain.com/ms/surah/55.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"Ayat 78\", \"item\": \"https://tafsirshaikhain.com/ms/ayah/55-78.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ms/\">Laman utama</a> › <a href=\"/ms/surah/55.html\">Surah Ar-Rahmaan</a> › Ayat 78</nav><h1>Tafsir Surah Ar-Rahmaan 55:78</h1><p class=\"vt ar\" lang=\"ar\">﴿تَبَارَكَ اسْمُ رَبِّكَ ذِي الْجَلَالِ وَالْإِكْرَامِ﴾</p><section><h3>Terjemahan makna</h3><p class=\"tr\">Maha Sucilah nama Tuhanmu yang mempunyai Kebesaran dan Kemuliaan.</p><span class=\"cr\" dir=\"ltr\">Malay Translation - Abdullah Basumayyah — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Kata-kata kedua-dua imam dipaparkan dalam bahasa Arab asal, kata demi kata, berserta rujukan.</p><section><h2>Syeikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">ففيها قراءتان: الأكثرون يقرءون {ذي الجلال} فالرب المسمى: هو ذو الجلال والإكرام.<cite>«مجموع الفتاوى» 6/193</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وقرأ ابن عامر: {ذو الجلال والإكرام} وكذلك هي في المصحف الشامي؛ وفي مصاحف أهل الحجاز والعراق هي بالياء.<cite>«مجموع الفتاوى» 6/193</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">ومعلوم أن نفس أسمائه مباركة وبركتها من جهة دلالتها على المسمى.<cite>«مجموع الفتاوى» 6/193</cite></blockquote><h3>Apa yang beliau nukilkan daripada orang lain</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن الأنباري وغيره</span> <span class=\"st\">أقرّه</span> «قال ابن الأنباري وغيره {تبارك} تفاعل من البركة والمعنى أن البركة تكتسب وتنال بذكر اسمه؛»<cite>«مجموع الفتاوى» 6/193</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ms#s55a78\">Buka dalam tafsir interaktif (teks penuh)</a><div class=\"pn\"><a href=\"/ms/ayah/55-70.html\">Ayat sebelumnya (55:70)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/ms/\">Laman utama</a> · <a href=\"/about.html\">Tentang projek</a> · <a href=\"/privacy.html\">Privasi &amp; terma</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}