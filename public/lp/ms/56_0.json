mily=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ms/\">Laman utama</a> › <a href=\"/ms/surah/56.html\">Surah Al-Waaqia</a> › Ayat 26</nav><h1>Tafsir Surah Al-Waaqia 56:26</h1><p class=\"vt ar\" lang=\"ar\">﴿إِلَّا قِيلًا سَلَامًا سَلَامًا﴾</p><section><h3>Terjemahan makna</h3><p class=\"tr\">Mereka hanya mendengar ucapan: “Selamat! Selamat!” (dari satu kepada yang lain).</p><span class=\"cr\" dir=\"ltr\">Malay Translation - Abdullah Basumayyah — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Kata-kata kedua-dua imam dipaparkan dalam bahasa Arab asal, kata demi kata, berserta rujukan.</p><section><h2>Imam Ibnu al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">وهذا فيه نفي لسماع اللغو والتأثيم وإثبات لضده وهو السلام المنافي لهما<cite>«بدائع الفوائد» 3/69</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وعلى هذا فلا حاجة إلى تكلف دخوله تحت المستثنى منه لأنه يتضمن زوال هذه الفائدة من الكلام<cite>«بدائع الفوائد» 3/69</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ms#s56a26\">Buka dalam tafsir interaktif (teks penuh)</a><div class=\"pn\"><a href=\"/ms/ayah/56-25.html\">Ayat sebelumnya (56:25)</a><a href=\"/ms/ayah/56-29.html\">Ayat seterusnya (56:29)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/ms/\">Laman utama</a> · <a href=\"/about.html\">Tentang projek</a> · <a href=\"/privacy.html\">Privasi &amp; terma</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/56-29.html":"<!doctype html>\n<html lang=\"ms\" dir=\"ltr\">\n<head>\n<me