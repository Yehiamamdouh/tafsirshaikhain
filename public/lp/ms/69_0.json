sirshaikhain.com/zh/ayah/69-29.html\">\n<meta property=\"og:title\" content=\"Tafsir Al-Haaqqa 69:29 — menurut Ibnu Taimiyah dan Ibnu al-Qayyim\">\n<meta property=\"og:description\" content=\"Kuat kuasaku (dan hujjah-hujjahku membela diri), telah binasa dan hilang lenyap dariku”.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ms/\">Laman utama</a> › <a href=\"/ms/surah/69.html\">Surah Al-Haaqqa</a> › Ayat 29</nav><h1>Tafsir Surah Al-Haaqqa 69:29</h1><p class=\"vt ar\" lang=\"ar\">﴿هَلَكَ عَنِّي سُلْطَانِيَهْ﴾</p><section><h3>Terjemahan makna</h3><p class=\"tr\">Kuat kuasaku (dan hujjah-hujjahku membela diri), telah binasa dan hilang lenyap dariku”.</p><span class=\"cr\" dir=\"ltr\">Malay Translation - Abdullah Basumayyah — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Kata-kata kedua-dua imam dipaparkan dalam bahasa Arab asal, kata demi kata, berserta rujukan.</p><section><h2>Imam Ibnu al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">والمقصود ان الله سبحانه سمى علم الحجة سلطانا لانها توجب تسلط صاحبها واقتداره<cite>«مفتاح دار السعادة ومنشور ولاية العلم والإرادة» 1/59</cite></blockquote><h3>Apa yang beliau nukilkan daripada orang lain</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">قيل</span> <span class=\"st\">حكاه</span> «فقيل المراد به القدرة والملك أي ذهب عني مالي وملكي فلا مال لي ولا سلطان»<cite>«مفتاح دار السعادة ومنشور ولاية العلم والإرادة» 1/59</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">وقيل</span> <span class=\"st\">حكاه</span> «وقيل هو على بابه أي انقطعت حجتي وبطلت»<cite>«مفتاح دار السعادة ومنشور ولاية العلم والإرادة» 1/59</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">قيل</span> <span class=\"st\">حكاه</span> «هو على بابه أي انقطعت حجتي وبطلت فلا حجة لي»<cite>«مفتاح دار السعادة ومنشور ولاية العلم والإرادة» 1/59</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ms#s69a29\">Buka dalam tafsir interaktif (teks penuh)</a><div class=\"pn\"><span></span><a href=\"/ms/ayah/69-40.html\">Ayat seterusnya (69:40)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/ms/\">Laman utama</a> · <a href=\"/about.html\">Tentang projek</a> · <a href=\"/privacy.html\">Privasi &amp; terma</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/69-40.html":"<!doctype html>\n<html lang=\"ms\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir Al-Haaqqa 69:40 — menurut Ibnu Taimiyah dan Ibnu al-Qayyim</title>\n<meta name=\"description\" content=\"Bahawa sesungguhnya Al-Quran itu ialah (wahyu dari Kami) yang disampaikan oleh Rasul yang mulia.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/ms/ayah/69-40.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/69-40.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/69-40.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/69-40.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/69-40.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/69-40.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/69-40.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/69-40.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/69-40.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/69-40.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/69-40.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/69-40.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/69-40.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/69-40.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/69-40.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/69-40.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/69-40.html\">\n<meta property=\"og:title\" content=\"Tafsir Al-Haaqqa 69:40 — menurut Ibnu Taimiyah dan Ibnu al-Qayyim\">\n<meta property=\"og:description\" content=\"Bahawa sesungguhnya Al-Quran itu ialah (wahyu dari Kami) yang disampaikan oleh Rasul yang mulia.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ms/\">Laman utama</a> › <a href=\"/ms/surah/69.html\">Surah Al-Haaqqa</a> › Ayat 40</nav><h1>Tafsir Surah Al-Haaqqa 69:40</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّهُ لَقَوْلُ رَسُولٍ كَرِيمٍ﴾</p><section><h3>Terjemahan makna</h3><p class=\"tr\">Bahawa sesungguhnya Al-Quran itu ialah (wahyu dari Kami) yang disampaikan oleh Rasul yang mulia.</p><span class=\"cr\" dir=\"ltr\">Malay Translation - Abdullah Basumayyah — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Kata-kata kedua-dua imam dipaparkan dalam bahasa Arab asal, kata demi kata, berserta rujukan.</p><section><h2>Syeikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">فالرسول هنا محمد صلى الله عليه وسلم<cite>«مجموع الفتاوى» 12/135</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وهذا مما يبين أنه أضافه إليه لأنه بلغه وأداه، لا لأنه أحدثه وأنشأه،<cite>«الفتاوى الكبرى لابن تيمية» 5/14</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ms#s69a40\">Buka dalam tafsir interaktif (teks penuh)</a><div class=\"pn\"><a href=\"/ms/ayah/69-29.html\">Ayat sebelumnya (69:29)</a><a href=\"/ms/ayah/69-41.html\">Ayat seterusnya (69:41)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/ms/\">Laman utama</a> · <a href=\"/about.html\">Tentang projek</a> · <a href=\"/privacy.html\">Privasi &amp; terma</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/69-41.html":"<!doctype html>\n<html lang=\"ms\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Tafsir Al-Haaqqa 69:41 — menurut Ibnu Taimiyah dan Ibnu al-Qayyim</title>\n<meta name=\"description\" content=\"Dan bukanlah Al-Quran itu perkataan seorang penyair (sebagaimana yang kamu dakwakan. Tetapi sayang!) amatlah sedikit kamu beriman.\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/ms/ayah/69-41.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/69-41.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/69-41.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/69-41.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/69-41.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/69-41.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/69-41.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/69-41.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/69-41.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/69-41.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/69-41.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/69-41.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/69-41.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/69-41.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/69-41.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/69-41.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/69-41.html\">\n<meta property=\"og:title\" content=\"Tafsir Al-Haaqqa 69:41 — menurut Ibnu Taimiyah dan Ibnu al-Qayyim\">\n<meta property=\"og:description\" content=\"Dan bukanlah Al-Quran itu perkataan seorang penyair (sebagaimana yang kamu dakwakan. Tetapi sayang!) amatlah sedikit kamu beriman.\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ms/\">Laman utama</a> › <a href=\"/ms/surah/69.html\">Surah Al-Haaqqa</a> › Ayat 41</nav><h1>Tafsir Surah Al-Haaqqa 69:41</h1><p class=\"vt ar\" lang=\"ar\">﴿وَمَا هُوَ بِقَوْلِ شَاعِرٍ قَلِيلًا مَّا تُؤْمِنُونَ﴾</p><section><h3>Terjemahan makna</h3><p class=\"tr\">Dan bukanlah Al-Quran itu perkataan seorang penyair (sebagaimana yang kamu dakwakan. Tetapi sayang!) amatlah sedikit kamu beriman.</p><span class=\"cr\" dir=\"ltr\">Malay Translation - Abdullah Basumayyah — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Kata-kata kedua-dua imam dipaparkan dalam bahasa Arab asal, kata demi kata, berserta rujukan.</p><section><h2>Syeikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">فنفى عنه أن يكون قول شاعر أو كاهن وهما من البشر.<cite>«مجموع الفتاوى» 2/50</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ms#s69a41\">Buka dalam tafsir interaktif (teks penuh)</a><div class=\"pn\"><a href=\"/ms/ayah/69-40.html\">Ayat sebelumnya (69:40)</a></div></main><footer class=\"site-foot\"><span>Tafsir al-Syaikhain · <a href=\"/ms/\">Laman utama</a> · <a href=\"/about.html\">Tentang projek</a> · <a href=\"/privacy.html\">Privasi &amp; terma</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/69.html":"<!doctype html>\n<html lang=\"ms\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta 