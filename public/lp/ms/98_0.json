://tafsirshaikhain.com/ms/ayah/98-7.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/ms/\">Laman utama</a> › <a href=\"/ms/surah/98.html\">Surah Al-Bayyina</a> › Ayat 7</nav><h1>Tafsir Surah Al-Bayyina 98:7</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ أُولَٰئِكَ هُمْ خَيْرُ الْبَرِيَّةِ﴾</p><section><h3>Terjemahan makna</h3><p class=\"tr\">Seungguhnya orang-orang yang beriman dan beramal soleh, mereka itulah sebaik-baik makhluk.</p><span class=\"cr\" dir=\"ltr\">Malay Translation - Abdullah Basumayyah — v1.0.0 · QuranEnc.com</span></section><p class=\"cr\">Kata-kata kedua-dua imam dipaparkan dalam bahasa Arab asal, kata demi kata, berserta rujukan.</p><section><h2>Syeikhul Islam Ibnu Taimiyah</h2><blockquote class=\"ar\" lang=\"ar\">عام في كل من اتصف بذلك، فما الذي أوجب تخصيصه بالشيعة؟<cite>«الإمامة في ضوء الكتاب والسنة» 1/230</cite></blockquote></section><section><h2>Imam Ibnu al-Qayyim</h2><blockquote class=\"ar\" lang=\"ar\">فالعبد المؤمن الصالح من خير البرية<cite>«الطرق الحكمية» 1/140</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=ms#s98a7\">Buka dalam tafsir interaktif (teks penuh)</a><div class=\"pn\"><a href=\"/ms/ayah/98-6.html\">Ayat sebelumnya (98:6)</a><a h