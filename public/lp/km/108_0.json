ListItem\", \"position\": 3, \"name\": \"វាក្យខណ្ឌ 2\", \"item\": \"https://tafsirshaikhain.com/km/ayah/108-2.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.muy{display:grid;gap:6px;background:var(--sheet,#fff);border:1px dashed var(--line,#d9dee6);border-inline-start:4px solid var(--muted,#5b6676);border-radius:10px;padding:12px 14px;margin:4px 0}.muy-head{display:flex;flex-wrap:wrap;gap:4px 10px;align-items:baseline}.muy-head b{font-family:var(--f-display,sans-serif);font-weight:600;font-size:15px}.muy-head small{font-size:12.5px;color:var(--muted,#5b6676)}.muy-text{margin:0;font-family:var(--f-read,serif);font-size:17px;line-height:1.95;overflow-wrap:anywhere}.muy-fn{margin:0;font-size:14px;line-height:1.7;color:var(--muted,#5b6676);white-space:pre-line}.muy-credit{font-size:12px;color:var(--muted,#5b6676);overflow-wrap:anywhere}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/km/\">ទំព័រដើម</a> › <a href=\"/km/surah/108.html\">ជំពូក Al-Kawthar</a> › វាក្យខណ្ឌ 2</nav><h1>តាហ្វសៀរ ជំពូក Al-Kawthar 108:2</h1><p class=\"vt ar\" lang=\"ar\">﴿فَصَلِّ لِرَبِّكَ وَانْحَرْ﴾</p><section><h3>ការបកប្រែអត្ថន័យ</h3><p class=\"tr\">ហេតុនេះ ចូរអ្នកប្រតិបត្តិសឡាតចំពោះព្រះជាម្ចាស់របស់អ្នក និងសំឡេះសត្វចុះ។</p><span class=\"cr\" dir=\"ltr\">Khmer Translation - Rowwad Translation Center — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">ពាក្យសម្ដីរបស់អ៊ីម៉ាមទាំងពីរត្រូវបានផ្ដល់ជាភាសាអារ៉ាប់ដើម ដូចដើម ព្រមទាំងប្រភព។</p><section><h2>ស៊ីខុលអ៊ីស្លាម អ៊ីបនូតៃមីយ៉ះ</h2><blockquote class=\"ar\" lang=\"ar\">وقوله: {فصل لربك وانحر} أمره الله أن يجمع بين هاتين العبادتين العظيمتين وهما الصلاة والنسك الدالتان على القرب والتواضع والافتقار وحسن الظن وقوة اليقين وطمأنينة القلب إلى الله وإلى عدته وأمره وفضله وخلفه<cite>«مجموع الفتاوى» 16/531</cite></blockquote></section><section><h2>អ៊ីម៉ាម អ៊ីបនុលកោយយិម</h2><blockquote class=\"ar\" lang=\"ar\">الذبيحة تجري مجرى العبادة، ولهذا يقرن الله سبحانه بينهما كقوله: {فصل لربك وانحر} [الكوثر: 2] وقوله: {قل إن صلاتي ونسكي ومحياي ومماتي لله رب العالمين} [الأنعام: 162]<cite>«إعلام الموقعين عن رب العالمين» 2/118</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وبدأ في العيد بالصلاة ثم جعل النحر بعدها، وأخبر أن ( «من ذبح قبلها، فلا نسك له» ) تقديما لما بدأ الله به في قوله {فصل لربك وانحر}<cite>«زاد المعاد في هدي خير العباد» 2/320</cite></blockquote><h3>អ្វីដែលលោកដកស្រង់ពីអ្នកដទៃ</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">بعض المتأولين</span> <span class=\"st\">ردّه</span> «إن المراد به ضع يدك على نحرك»<cite>«الصواعق المرسلة في الرد على الجهمية والمعطلة» 2/695</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">علي</span> <span class=\"st\">حكاه</span> «إنه وضع اليمين على الشمال في الصلاة تحت صدره،»<cite>«إعلام الموقعين عن رب العالمين» 2/290</cite></blockquote></section><div class=\"muy\"><div class=\"muy-head\"><b>អាល់មុខតាសារ ក្នុងការអធិប្បាយគម្ពីរគួរអាន</b><small>អត្ថន័យទូទៅនៃវាក្យខណ្ឌ — មិនមែនជាពាក្យសម្ដីរបស់ស៊ីខទាំងពីរទេ</small></div><p class=\"muy-text\">ហេតុនេះ ចូរអ្នកថ្លែងអំណរគុណអល់ឡោះចំពោះឧបការគុណនេះ ដោយអ្នកត្រូវប្រតិបត្តិសឡាតចំពោះអល់ឡោះ និងសម្លេះសត្វដើម្បីម្ចាស់របស់អ្នកតែមួយគត់ ខុសពីអ្វីដែលពួកមុស្ហរីគីន(ពួកពហុទេពនិយម)បានធ្វើ ដោយពួកគេបញ្ជិតខ្លួនទៅកាន់រូបបដិមារបស់ពួកគេដោយសារសម្លេះសត្វនោះ។</p><a class=\"muy-credit\" href=\"https://quranenc.com/en/browse/khmer_mokhtasar\" target=\"_blank\" rel=\"noopener\" dir=\"ltr\">Khmer Translation of Al-Mukhtasar in Interpreting the Noble Quran — 2026-11-04 · QuranEnc.com</a></div><a class=\"btn pri open\" href=\"/tafsir.html?lang=km#s108a2\">បើកក្នុងតាហ្វសៀរអន្តរកម្ម (អត្ថបទពេញ)</a><div class=\"pn\"><a href=\"/km/ayah/108-1.html\">វាក្យខណ្ឌមុន (108:1)</a><a href=\"/km/ayah/108-3.html\">វាក្យខណ្ឌបន្ទាប់ (108:3)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/108-2.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/108-2.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/108-2.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/108-2.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/108-2.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/108-2.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/108-2.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/108-2.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/108-2.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/108-2.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/108-2.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/108-2.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/108-2.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/108-2.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah