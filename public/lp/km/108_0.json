em\": \"https://tafsirshaikhain.com/km/surah/108.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"វាក្យខណ្ឌ 3\", \"item\": \"https://tafsirshaikhain.com/km/ayah/108-3.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.muy{display:grid;gap:6px;background:var(--sheet,#fff);border:1px dashed var(--line,#d9dee6);border-inline-start:4px solid var(--muted,#5b6676);border-radius:10px;padding:12px 14px;margin:4px 0}.muy-head{display:flex;flex-wrap:wrap;gap:4px 10px;align-items:baseline}.muy-head b{font-family:var(--f-display,sans-serif);font-weight:600;font-size:15px}.muy-head small{font-size:12.5px;color:var(--muted,#5b6676)}.muy-text{margin:0;font-family:var(--f-read,serif);font-size:17px;line-height:1.95;overflow-wrap:anywhere}.muy-fn{margin:0;font-size:14px;line-height:1.7;color:var(--muted,#5b6676);white-space:pre-line}.muy-credit{font-size:12px;color:var(--muted,#5b6676);overflow-wrap:anywhere}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/km/\">ទំព័រដើម</a> › <a href=\"/km/surah/108.html\">ជំពូក Al-Kawthar</a> › វាក្យខណ្ឌ 3</nav><h1>តាហ្វសៀរ ជំពូក Al-Kawthar 108:3</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّ شَانِئَكَ هُوَ الْأَبْتَرُ﴾</p><section><h3>ការបកប្រែអត្ថន័យ</h3><p class=\"tr\">ពិតប្រាកដណាស់ អ្នកដែលខឹងសម្បានឹងអ្នក គឺជាបុគ្គលដែលត្រូវបានគេកាត់ផ្តាច់(ពីប្រការល្អទាំងឡាយ)។</p><span class=\"cr\" dir=\"ltr\">Khmer Translation - Rowwad Translation Center — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">ពាក្យសម្ដីរបស់អ៊ីម៉ាមទាំងពីរត្រូវបានផ្ដល់ជាភាសាអារ៉ាប់ដើម ដូចដើម ព្រមទាំងប្រភព។</p><section><h2>ស៊ីខុលអ៊ីស្លាម អ៊ីបនូតៃមីយ៉ះ</h2><blockquote class=\"ar\" lang=\"ar\">وفي قوله: {إن شانئك هو الأبتر} أنواع من التأكيد: أحدها تصدير الجملة بإن. الثاني: الإتيان بضمير الفصل الدال على قوة الإسناد والاختصاص. الثالث: مجيء الخبر على أفعل التفضيل. دون اسم المفعول. الرابع: تعريفه باللام الدالة على حصول هذا الموصوف له بتمامه. وأنه أحق به من غيره<cite>«مجموع الفتاوى» 16/532</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وقوله {إن شانئك} أي مبغضك والأبتر المقطوع النسل الذي لا يولد له خير ولا عمل صالح فلا يتولد عنه خير ولا عمل صالح.<cite>«مجموع الفتاوى» 16/528</cite></blockquote></section><div class=\"muy\"><div class=\"muy-head\"><b>អាល់មុខតាសារ ក្នុងការអធិប្បាយគម្ពីរគួរអាន</b><small>អត្ថន័យទូទៅនៃវាក្យខណ្ឌ — មិនមែនជាពាក្យសម្ដីរបស់ស៊ីខទាំងពីរទេ</small></div><p class=\"muy-text\">ពិតប្រាកដណាស់ អ្នកដែលខឹងសម្បារនឹងអ្នកនោះ គឺជាបុគ្គលដែលត្រូវបានគេកាត់ផ្តាច់ពីប្រការល្អទាំងអស់ ជាអ្នកដែលត្រូវគេបំភ្លេចមិននឹកនានោះឡើយ ហើយបើទោះបីជាគេរំលឹកពីពួកគេ ក៏គេរំលឹកតែពីរឿងអាក្រក់របស់គេដែរ។</p><a class=\"muy-credit\" href=\"https://quranenc.com/en/browse/khmer_mokhtasar\" target=\"_blank\" rel=\"noopener\" dir=\"ltr\">Khmer Translation of Al-Mukhtasar in Interpreting the Noble Quran — 2026-11-04 · QuranEnc.com</a></div><a class=\"btn pri open\" href=\"/tafsir.html?lang=km#s108a3\">បើកក្នុងតាហ្វសៀរអន្តរកម្ម (អត្ថបទពេញ)</a><div class=\"pn\"><a href=\"/km/ayah/108-2.html\">វាក្យខណ្ឌមុន (108:2)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a hre