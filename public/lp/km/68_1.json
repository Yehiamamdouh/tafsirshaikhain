dee6);border-inline-start:4px solid var(--muted,#5b6676);border-radius:10px;padding:12px 14px;margin:4px 0}.muy-head{display:flex;flex-wrap:wrap;gap:4px 10px;align-items:baseline}.muy-head b{font-family:var(--f-display,sans-serif);font-weight:600;font-size:15px}.muy-head small{font-size:12.5px;color:var(--muted,#5b6676)}.muy-text{margin:0;font-family:var(--f-read,serif);font-size:17px;line-height:1.95;overflow-wrap:anywhere}.muy-fn{margin:0;font-size:14px;line-height:1.7;color:var(--muted,#5b6676);white-space:pre-line}.muy-credit{font-size:12px;color:var(--muted,#5b6676);overflow-wrap:anywhere}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/km/\">ទំព័រដើម</a> › <a href=\"/km/surah/68.html\">ជំពូក Al-Qalam</a> › វាក្យខណ្ឌ 51</nav><h1>តាហ្វសៀរ ជំពូក Al-Qalam 68:51</h1><p class=\"vt ar\" lang=\"ar\">﴿وَإِن يَكَادُ الَّذِينَ كَفَرُوا لَيُزْلِقُونَكَ بِأَبْصَارِهِمْ لَمَّا سَمِعُوا الذِّكْرَ وَيَقُولُونَ إِنَّهُ لَمَجْنُونٌ﴾</p><section><h3>ការបកប្រែអត្ថន័យ</h3><p class=\"tr\">ពិតប្រាកដណាស់ ពួកដែលគ្មានជំនឿ ស្ទើរតែធ្វើឱ្យអ្នកមានគ្រោះថ្នាក់ដោយសារតែក្រសែភ្នែករបស់ពួកគេ នៅពេលដែលពួកគេបានស្ដាប់ឮគម្ពីរគួរអាន ហើយពួកគេនិយាយថា៖ ពិតប្រាកដណាស់ រូបគេ(ព្យាការីមូហាំម៉ាត់) គឺជាមនុស្សវិកលចរិត។</p><span class=\"cr\" dir=\"ltr\">Khmer Translation - Rowwad Translation Center — v1.0.4 · QuranEnc.com</span></section><p class=\"cr\">ពាក្យសម្ដីរបស់អ៊ីម៉ាមទាំងពីរត្រូវបានផ្ដល់ជាភាសាអារ៉ាប់ដើម ដូចដើម ព្រមទាំងប្រភព។</p><section><h2>ស៊ីខុលអ៊ីស្លាម អ៊ីបនូតៃមីយ៉ះ</h2><blockquote class=\"ar\" lang=\"ar\">والكافر والمنافق يسمع ويرى على وجه البغض والجهل كما قال تعالى: {وإن يكاد الذين كفروا ليزلقونك بأبصارهم لما سمعوا الذكر}<cite>«مجموع الفتاوى» 15/342</cite></blockquote></section><section><h2>អ៊ីម៉ាម អ៊ីបនុលកោយយិម</h2><blockquote class=\"ar\" lang=\"ar\">فالكفار كانوا ينظرون إليه نظر حاسد شديد العدواة فهو نظر يكاد يزلقه لولا حفظ الله وعصمته فهذا أشد من نظر العائن بل هو جنس من نظر العائن فمن قال إنه من الإصابة بالعين أراد هذا المعنى ومن قال: ليس به أراد أن نظرهم لم يكن نظر استحسان وإعجاب<cite>«بدائع الفوائد» 2/231</cite></blockquote><h3>អ្វីដែលលោកដកស្រង់ពីអ្នកដទៃ</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">غير واحد من المفسرين</span> <span class=\"st\">حكاه</span> «إنه الإصابة بالعين فأرادوا أن يصيبوا بها رسول الله صلى الله عليه وسلم»<cite>«بدائع الفوائد» 2/231</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن قتيبة</span> <span class=\"st\">حكاه</span> «ليس المراد أنهم يصيبونك بالعين كما يصيب العائن بعينه ما يعجبه وإنما أراد أنهم ينظرون إليك إذا قرأت القرآن الكريم نظرا شديدا بالعداوة والبغضاء يكاد يسقطك»<cite>«بدائع الفوائد» 2/231</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الزجاج</span> <span class=\"st\">حكاه</span> «يعني من شدة العداوة يكادون بنظرهم نظر البغضاء أن يصرعوك»<cite>«بدائع الفوائد» 2/231</cite></blockquote></section><div class=\"muy\"><div class=\"muy-head\"><b>អាល់មុខតាសារ ក្នុងការអធិប្បាយគម្ពីរគួរអាន</b><small>អត្ថន័យទូទៅនៃវាក្យខណ្ឌ — មិនមែនជាពាក្យសម្ដីរបស់ស៊ីខទាំងពីរទេ</small></div><p class=\"muy-text\">ពិតប្រាកដណាស់ ពួកដែលគ្មានជំនឿនឹងអល់ឡោះ ព្រមទាំងបានបដិសេធនឹងអ្នកនាំសាររបស់ទ្រង់នោះ ស្ទើរតែធ្វើឱ្យអ្នកមានគ្រោះថ្នាក់ដោយសារតែការសម្លឹងមើលដ៏មុតស្រួចរបស់ពួកគេមកកាន់អ្នក នៅពេលដែលពួកគេបានស្ដាប់ឮគម្ពីរគួរអានដែលបានបញ្ចុះមកឱ្យអ្នកនេះ ហើយពួកគេថែមទាំងនិយាយ(ទៅតាមចំណង់តណ្ហារបស់ពួកគេ និងការបដិសេធពីការពិតរបស់ពួកគេ)ថាៈ ពិតប្រាកដណាស់ អ្នកនាំសារដែលបាននាំគម្ពីរគួរអានមកនោះ គឺជាមនុស្សវិកលចរិត។</p><a class=\"muy-credit\" href=\"https://quranenc.com/en/browse/khmer_mokhtasar\" target=\"_blank\" rel=\"noopener\" dir=\"ltr\">Khmer Translation of Al-Mukhtasar in Interpreting the Noble Quran — 2026-11-04 · QuranEnc.com</a></div><a class=\"btn pri open\" href=\"/tafsir.html?lang=km#s68a51\">បើកក្នុងតាហ្វសៀរអន្តរកម្ម (អត្ថបទពេញ)</a><div class=\"pn\"><a href=\"/km/ayah/68-50.html\">វាក្យខណ្ឌមុន (68:50)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/68-51.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/68-51.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/68-51.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/68-51.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/68-51.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/68-51.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/68-51.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/68-51.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/68-51.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/68-51.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/68-51.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/68-51.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/68-51.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/68-51.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <a href=\"/zh/ayah/68-51.html\" hreflang=\"zh\" lang=\"zh\" data-l=\"zh\">中文</a> · <a href=\"/hi/ayah/68-51.html\" hreflang=\"hi\" lang=\"hi\" data-l=\"hi\">हिन्दी</a> · <a href=\"/ps/ayah/68-51.html\" hreflang=\"ps\" lang=\"ps\" data-l=\"ps\">پښتو</a> · <a href=\"/so/ayah/68-51.html\" hreflang=\"so\" lang=\"so\" data-l=\"so\"