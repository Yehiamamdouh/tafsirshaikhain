\">\n<link rel=\"manifest\" href=\"/manifest.webmanifest\">\n<link rel=\"apple-touch-icon\" href=\"/icon-192.png\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"经注： Al-A'raaf 7:205 — 伊本·泰米叶与伊本·盖伊姆的解释\", \"description\": \"你当朝夕恭敬而恐惧地记念你的主，应当低声赞颂他，你不要疏忽。\", \"inLanguage\": \"zh\", \"url\": \"https://tafsirshaikhain.com/zh/ayah/7-205.html\", \"mainEntityOfPage\": \"https://tafsirshaikhain.com/zh/ayah/7-205.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"伊斯兰谢赫 伊本·泰米叶\"}, {\"@type\": \"Person\", \"name\": \"伊玛目 伊本·盖伊姆\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"两位谢赫经注汇编\", \"url\": \"https://tafsirshaikhain.com/zh/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"首页\", \"item\": \"https://tafsirshaikhain.com/zh/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"章 Al-A'raaf\", \"item\": \"https://tafsirshaikhain.com/zh/surah/7.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"节 205\", \"item\": \"https://tafsirshaikhain.com/zh/ayah/7-205.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/zh/\">首页</a> › <a href=\"/zh/surah/7.html\">章 Al-A&#x27;raaf</a> › 节 205</nav><h1>经注： 章 Al-A&#x27;raaf 7:205</h1><p class=\"vt ar\" lang=\"ar\">﴿وَاذْكُر رَّبَّكَ فِي نَفْسِكَ تَضَرُّعًا وَخِيفَةً وَدُونَ الْجَهْرِ مِنَ الْقَوْلِ بِالْغُدُوِّ وَالْآصَالِ وَلَا تَكُن مِّنَ الْغَافِلِينَ﴾</p><section><h3>意义翻译</h3><p class=\"tr\">你当朝夕恭敬而恐惧地记念你的主，应当低声赞颂他，你不要疏忽。</p><span class=\"cr\" dir=\"ltr\">Chinese Translation - Muhammad Makeen — v1.0.2 · QuranEnc.com</span></section><p class=\"cr\">两位伊玛目的话以阿拉伯语原文逐字呈现，并附出处。</p><section><h2>伊斯兰谢赫 伊本·泰米叶</h2><blockquote class=\"ar\" lang=\"ar\">ونظير قوله: {واذكر ربك في نفسك} قوله صلى الله عليه وسلم فيما روى عن ربه &quot; {من ذكرني في نفسه ذكرته في نفسي. ومن ذكرني في ملأ ذكرته في ملأ خير منه} &quot; وهذا يدخل فيه ذكره باللسان في نفسه فإنه جعله قسيم الذكر في الملأ وهو نظير قوله: {ودون الجهر من القول}<cite>«مجموع الفتاوى» 15/34</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فإن الجهر هو الإظهار الشديد يقال: رجل جهوري الصوت ورجل جهير.<cite>«مجموع الفتاوى» 15/34</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">ومعلوم أن ذكر الله المشروع بالغدو والآصال في الصلاة وخارج الصلاة هو باللسان مع القلب مثل صلاتي الفجر والعصر والذكر المشروع عقب الصلاتين<cite>«مجموع الفتاوى» 15/34</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=zh#s7a205\">在互动经注中打开（完整原文）</a><div class=\"pn\"><a href=\"/zh/ayah/7-204.html\">上一节 (7:204)</a><a href=\"/zh/ayah/7-206.html\">下一节 (7:206)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/7-205.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/7-205.html\" hreflan