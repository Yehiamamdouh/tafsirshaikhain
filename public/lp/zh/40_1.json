tent=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/zh/\">首页</a> › <a href=\"/zh/surah/40.html\">章 Al-Ghaafir</a> › 节 54</nav><h1>经注： 章 Al-Ghaafir 40:54</h1><p class=\"vt ar\" lang=\"ar\">﴿هُدًى وَذِكْرَىٰ لِأُولِي الْأَلْبَابِ﴾</p><section><h3>意义翻译</h3><p class=\"tr\">用作有心灵者的向导和教诲。</p><span class=\"cr\" dir=\"ltr\">Chinese Translation - Muhammad Makeen — v1.0.2 · QuranEnc.com</span></section><p class=\"cr\">两位伊玛目的话以阿拉伯语原文逐字呈现，并附出处。</p><section><h2>伊玛目 伊本·盖伊姆</h2><blockquote class=\"ar\" lang=\"ar\">فأخبر أنه إنما يكون هدى وذكرى لمن له لب عقل به الكتاب وعمل بما فيه<cite>«طريق الهجرتين وباب السعادتين» 1/195</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=zh#s40a54\">在互动经注中打开（完整原文）</a><div class=\"pn\"><a href=\"/zh/ayah/40-53.html\">上一节 (40:53)</a><a href=\"/zh/ayah/40-60.html\">下一节 (40:60)</a></div></main><footer class=\"site-foot\"><span>两位谢赫经注汇编 · <a href=\"/zh/\">首页</a> · <a href=\"/about.html\">关于项目</a> · <a href=\"/privacy.html\">隐私与条款</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/40-60.html":"<!doctype html>\n<html lang=\"zh\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>经注： Al-Ghaafir 40:60 — 伊本·泰米叶与伊本·盖伊姆的解释</title>\n<meta name=\"description\" content=\"你们的主说：“你们要祈祷我，我就应答你们；不肯崇拜我的骄傲自大者们，他们将卑贱地入火狱。”\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/zh/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/40-60.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/40-60.html\">\n<meta property=\"og:title\" content=\"经注： Al-Ghaafir 40:60 — 伊本·泰米叶与伊本·盖伊姆的解释\">\n<meta property=\"og:description\" content=\"你们的主说：“你们要祈祷我，我就应答你们；不肯崇拜我的骄傲自大者们，他们将卑贱地入火狱。”\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/zh/\">首页</a> › <a href=\"/zh/surah/40.html\">章 Al-Ghaafir</a> › 节 60</nav><h1>经注： 章 Al-Ghaafir 40:60</h1><p class=\"vt ar\" lang=\"ar\">﴿وَقَالَ رَبُّكُمُ ادْعُونِي أَسْتَجِبْ لَكُمْ إِنَّ الَّذِينَ يَسْتَكْبِرُونَ عَنْ عِبَادَتِي سَيَدْخُلُونَ جَهَنَّمَ دَاخِرِينَ﴾</p><section><h3>意义翻译</h3><p class=\"tr\">你们的主说：“你们要祈祷我，我就应答你们；不肯崇拜我的骄傲自大者们，他们将卑贱地入火狱。”</p><span class=\"cr\" dir=\"ltr\">Chinese Translation - Muhammad Makeen — v1.0.2 · QuranEnc.com</span></section><p class=\"cr\">两位伊玛目的话以阿拉伯语原文逐字呈现，并附出处。</p><section><h2>伊斯兰谢赫 伊本·泰米叶</h2><blockquote class=\"ar\" lang=\"ar\">فإن الله علق الإجابة به تعليق المسبب بالسبب<cite>«مجموع الفتاوى» 8/193</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وهو في دعاء العبادة أظهر؛ ولهذا أعقبه: {إن الذين يستكبرون عن عبادتي} الآية.<cite>«مجموع الفتاوى» 15/12</cite></blockquote><h3>他引述他人的说法</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">النبي صلى الله عليه وسلم</span> <span class=\"st\">استشهد به</span> «{أنه قال ما من مسلم يدعو الله بدعوة ليس فيها إثم ولا قطيعة رحم إلا أعطاه بها إحدى خصال ثلاث: إما أن يعجل له دعوته وإما أن يدخر له من الخير مثلها وإما أن يصرف عنه من الشر مثلها قالوا: يا رسول الله إذا نكثر قال الله أكثر}»<cite>«مجموع الفتاوى» 8/193</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">عمر بن الخطاب</span> <span class=\"st\">أقرّه</span> «وقال عمر بن الخطاب: إني لا أحمل هم الإجابة وإنما أحمل هم الدعاء فإذا ألهمت الدعاء فإن الإجابة معه»<cite>«مجموع الفتاوى» 8/193</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">النبي صلى الله عليه وسلم</span> <span class=\"st\">استشهد به</span> «{إن الدعاء هو العبادة. ثم قرأ قوله تعالى {وقال ربكم ادعوني أستجب لكم} الآية}»<cite>«مجموع الفتاوى» 15/12</cite></blockquote></section><section><h2>伊玛目 伊本·盖伊姆</h2><blockquote class=\"ar\" lang=\"ar\">فالدعاء يتضمن النوعين وهو في دعاء العبادة أظهر ولهذا عقبة بقوله: {إن الذين يستكبرون عن عبادتي سيدخلون جهنم داخرين}<cite>«بدائع الفوائد» 3/3</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=zh#s40a60\">在互动经注中打开（完整原文）</a><div class=\"pn\"><a href=\"/zh/ayah/40-54.html\">上一节 (40:54)</a></div></main><footer class=\"site-foot\"><span>两位谢赫经注汇编 · <a href=\"/zh/\">首页</a> · <a href=\"/about.html\">关于项目</a> · <a href=\"/privacy.html\">隐私与条款</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n"}