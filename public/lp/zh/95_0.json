preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/zh/\">首页</a> › <a href=\"/zh/surah/95.html\">章 At-Tin</a> › 节 5</nav><h1>经注： 章 At-Tin 95:5</h1><p class=\"vt ar\" lang=\"ar\">﴿ثُمَّ رَدَدْنَاهُ أَسْفَلَ سَافِلِينَ﴾</p><section><h3>意义翻译</h3><p class=\"tr\">然后，我使他变成最卑劣的；</p><span class=\"cr\" dir=\"ltr\">Chinese Translation - Muhammad Makeen — v1.0.2 · QuranEnc.com</span></section><p class=\"cr\">两位伊玛目的话以阿拉伯语原文逐字呈现，并附出处。</p><section><h2>伊斯兰谢赫 伊本·泰米叶</h2><blockquote class=\"ar\" lang=\"ar\">وفي قوله {أسفل سافلين} قولان. قيل: الهرم. وقيل: العذاب بعد الموت وهذا هو الذي دلت عليه الآية قطعا.<cite>«مجموع الفتاوى» 16/279</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=zh#s95a5\">在互动经注中打开（完整原文）</a><div class=\"pn\"><a href=\"/zh/ayah/95-1.html\">上一节 (95:1)</a></div></main><footer class=\"site-foot\"><span>两位谢赫经注汇编 · <a href=\"/zh/\">首页</a> · <a href=\"/about.html\">关于项目</a> · <a href=\"/privacy.html\">隐私与条款</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/95.html":"<!doctype html>\n<html lang=\"zh\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>经注： 章 At-Tin — 伊本·泰米叶与伊本·盖伊姆的解释</title>\n<meta name=\"description\" content=\"经注： 章 At-Tin — 伊本·泰米叶与伊本·盖伊姆论《古兰经》的意义\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/zh/surah/95.html\">\n<link rel=\"alternate\" 