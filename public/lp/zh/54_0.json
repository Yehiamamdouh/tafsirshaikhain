eflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/54-47.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/54-47.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/54-47.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/54-47.html\">\n<meta property=\"og:title\" content=\"经注： Al-Qamar 54:47 — 伊本·泰米叶与伊本·盖伊姆的解释\">\n<meta property=\"og:description\" content=\"犯罪者的确在迷误和烈火中。\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/zh/\">首页</a> › <a href=\"/zh/surah/54.html\">章 Al-Qamar</a> › 节 47</nav><h1>经注： 章 Al-Qamar 54:47</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّ الْمُجْرِمِينَ فِي ضَلَالٍ وَسُعُرٍ﴾</p><section><h3>意义翻译</h3><p class=\"tr\">犯罪者的确在迷误和烈火中。</p><span class=\"cr\" dir=\"ltr\">Chinese Translation - Muhammad Makeen — v1.0.2 · QuranEnc.com</span></section><p class=\"cr\">两位伊玛目的话以阿拉伯语原文逐字呈现，并附出处。</p><section><h2>伊玛目 伊本·盖伊姆</h2><blockquote class=\"ar\" lang=\"ar\">وجمع سبحانه بين الهدى والفلاح، والهدى والرحمة، كما يجمع بين الضلال والشقاء والضلال والعذاب: كقوله: {إن المجرمين فى ضلال وسعر} [القمر: 47] .<cite>«إغاثة اللهفان من مصايد الشيطان» 2/168</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=zh#s54a47\">在互动经注中打开（完整原文）</a><div class=\"pn\"><a href=\"/zh/ayah/54-45.html\">上一节 (54:45)</a><a href=\"/zh/ayah/54-49.html\">下一节 (54:49)</a></div></main><footer class=\"site-foot\"><span>两位谢赫经注汇编 · <a href=\"/zh/\">首页</a> · <a href=\"/about.html\">关于项目</a> · <a href=\"/privacy.html\">隐私与条款</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/54-49.html":"<!doctype html>\n<html lang=\"zh\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>经注： Al-Qamar 54:49 — 伊本·泰米叶与伊本·盖伊姆的解释</title>\n<meta name=\"description\" content=\"我确已依定量而创造万物，\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/zh/ayah/54-49.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/54-49.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/54-49.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/54-49.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/54-49.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/54-49.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/54-49.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/54-49.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/54-49.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/54-49.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/54-49.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/54-49.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/54-49.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/54-49.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/54-49.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/54-49.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/54-49.html\">\n<meta property=\"og:title\" content=\"经注： Al-Qamar 54:49 — 伊本·泰米叶与伊本·盖伊姆的解释\">\n<meta property=\"og:description\" content=\"我确已依定量而创造万物，\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/zh/\">首页</a> › <a href=\"/zh/surah/54.html\">章 Al-Qamar</a> › 节 49</nav><h1>经注： 章 Al-Qamar 54:49</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّا كُلَّ شَيْءٍ خَلَقْنَاهُ بِقَدَرٍ﴾</p><section><h3>意义翻译</h3><p class=\"tr\">我确已依定量而创造万物，</p><span class=\"cr\" dir=\"ltr\">Chinese Translation - Muhammad Makeen — v1.0.2 · QuranEnc.com</span></section><p class=\"cr\">两位伊玛目的话以阿拉伯语原文逐字呈现，并附出处。</p><section><h2>伊斯兰谢赫 伊本·泰米叶</h2><blockquote class=\"ar\" lang=\"ar\">فقد قدر سبحانه ما يريد أن يخلقه من هذا العالم حين كان عرشه على الماء إلى يوم القيامة<cite>«مجموع الفتاوى» 16/137</cite></blockquote><h3>他引述他人的说法</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن عباس (من رواية الضحاك)</span> <span class=\"st\">استشهد به</span> «إن الله قدر المقادير بقدرته ودبر الأمور بحكمته وعلم ما العباد صائرون إليه»<cite>«مجموع الفتاوى» 16/137</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">ابن عباس</span> <span class=\"st\">استشهد به</span> «إن الله قدر المقادير بقدرته ودبر الأمور بحكمته»<cite>«مجموع الفتاوى» 16/137</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الحسن</span> <span class=\"st\">حكاه</span> «خلق الله خلقا وأجل أجلا وقدر رزقا وقدر مصيبة وقدر بلاء وقدر عافية.»<cite>«مجموع الفتاوى» 16/138</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=zh#s54a49\">在互动经注中打开（完整原文）</a><div class=\"pn\"><a href=\"/zh/ayah/54-47.html\">上一节 (54:47)</a><a href=\"/zh/ayah/54-52.html\">下一节 (54:52)</a></div></main><footer class=\"site-foot\"><span>两位谢赫经注汇编 · <a href=\"/zh/\">首页</a> · <a href=\"/about.html\">关于项目</a> · <a href=\"/privacy.html\">隐私与条款</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/54.html":"<!doctype html>\n<html lang=\"zh\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>经注： 章 Al-Qamar — 伊本·泰米叶与伊本·盖伊姆的解释</title>\n<meta name=\"description\" content=\"经注： 章 Al-Qamar — 伊本·泰米叶与伊本·盖伊姆论《古兰经》的意义\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/zh/surah/54.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/surah/54.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/surah/54.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/surah/54.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/surah/54.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/surah/54.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/surah/54.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/surah/54.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.c