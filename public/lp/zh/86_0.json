ikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"首页\", \"item\": \"https://tafsirshaikhain.com/zh/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"章 At-Taariq\", \"item\": \"https://tafsirshaikhain.com/zh/surah/86.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"节 8\", \"item\": \"https://tafsirshaikhain.com/zh/ayah/86-8.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/zh/\">首页</a> › <a href=\"/zh/surah/86.html\">章 At-Taariq</a> › 节 8</nav><h1>经注： 章 At-Taariq 86:8</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّهُ عَلَىٰ رَجْعِهِ لَقَادِرٌ﴾</p><section><h3>意义翻译</h3><p class=\"tr\">安拉确是能使它复原的，</p><span class=\"cr\" dir=\"ltr\">Chinese Translation - Muhammad Makeen — v1.0.2 · QuranEnc.com</span></section><p class=\"cr\">两位伊玛目的话以阿拉伯语原文逐字呈现，并附出处。</p><section><h2>伊玛目 伊本·盖伊姆</h2><blockquote class=\"ar\" lang=\"ar\">الصحيح أن الضمير يرجع على الإنسان، أي إن الله على رده إليه لقادر يوم القيامة<cite>«إعلام الموقعين عن رب العالمين» 1/113</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وطريقة القرآن - وهي الاستدلال بالمبدإ والنشأة الأولى على المعاد والرجوع إليه - وأيضا فإنه قيده بالظرف، وهو {يوم تبلى السرائر} [الطارق: 9]<cite>«إعلام الموقعين عن رب العالمين» 1/113</cite></blockquote><h3>他引述他人的说法</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">من قال</span> <span class=\"st\">ردّه</span> «إن الضمير يرجع على الماء أي أن الله على رجعه في الإحليل أو في الصدر أو حبسه عن الخروج لقادر»<cite>«إعلام الموقعين عن رب العالمين» 1/113</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=zh#s86a8\">在互动经注中打开（完整原文）</a><div class=\"pn\"><a href=\"/zh/ayah/86-7.html\">上一节 (86:7)</a></div></main><footer class=\"site-foot\"><span>两位谢赫经注汇编 · <a href=\"/zh/\">首页</a> · <a href=\"/about.html\">关于项目</a> · <a href=\"/privacy.html\">隐私与条款</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/86.html":"<!doctype html>\n<html lang=\"zh\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>经注： 章 At-Taariq — 伊本·泰米叶与伊本·盖伊姆的解释</title>\n<meta name=\"description\" content=\"经注： 章 At-Taariq — 伊本·泰米叶与伊本·盖伊姆论《古兰经》的意义\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/zh/surah/86.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/surah/86.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/surah/86.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/surah/86.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/surah/86.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/surah/86.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/surah/86.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/surah/86.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/surah/86.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/surah