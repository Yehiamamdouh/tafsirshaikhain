:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/zh/\">首页</a> › <a href=\"/zh/surah/51.html\">章 Adh-Dhaariyat</a> › 节 55</nav><h1>经注： 章 Adh-Dhaariyat 51:55</h1><p class=\"vt ar\" lang=\"ar\">﴿وَذَكِّرْ فَإِنَّ الذِّكْرَىٰ تَنفَعُ الْمُؤْمِنِينَ﴾</p><section><h3>意义翻译</h3><p class=\"tr\">你应当教诲众人，因为教诲对于信士确是有益的。</p><span class=\"cr\" dir=\"ltr\">Chinese Translation - Muhammad Makeen — v1.0.2 · QuranEnc.com</span></section><p class=\"cr\">两位伊玛目的话以阿拉伯语原文逐字呈现，并附出处。</p><section><h2>伊斯兰谢赫 伊本·泰米叶</h2><blockquote class=\"ar\" lang=\"ar\">والنفع نوعان: حصول النعمة واندفاع النقمة.<cite>«مجموع الفتاوى» 16/184</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">الوجه الثاني: أن الأمر بالتذكير أمر بالتذكير التام النافع كما هو أمر بالتذكير المشترك. وهذا التام النافع يخص به المؤمنين المنتفعين. فهم إذا آمنوا ذكرهم بما أنزل وكلما أنزل شيء من القرآن ذكرهم به ويذكرهم بمعانيه ويذكرهم بما نزل قبل ذلك.<cite>«مجموع الفتاوى» 16/163</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فهو إذا بلغ قوما الرسالة فقامت الحجة عليهم ثم امتنعوا من سماع كلامه أعرض عنهم. فإن الذكرى حينئذ لا تنفع أحدا.<cite>«مجموع الفتاوى» 16/163</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=zh#s51a55\">在互动经注中打开（完整原文）</a><div class=\"pn\"><a href=\"/zh/ayah/51-54.html\">上一节 (51:54)</a><a href=\"/zh/ayah/51-56.html\">下一节 (51:56)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/51-55.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/51-55.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/51-55.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/51-55.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/51-55.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/51-55.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/51-55.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/51-55.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/51-55.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/51-55.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/51-55.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/51-55.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/51-55.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/51-55.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <b lang=\"zh\">中文</b></nav>\n<footer class=\"site-foot\"><span>两位谢赫经注汇编 · <a href=\"/zh/\">首页</a> · <a href=\"/about.html\">关于项目</a> · <a href=\"/privacy.html\">隐私与条款</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n<script>try{localStorage.setItem(\"lang\",\"zh\")}catch(e){}document.addEventListener(\"click\",function(e){var a=e.target.closest&&e.target.closest(\"[data-l]\");if(a)try{localStorage.setItem(\"lang\",a.dataset.l)}catch(x){}})</script>\n</body>\n</html>\n","ayah/51-56.html":"<!doctype html>\n<html lang=\"zh\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scal