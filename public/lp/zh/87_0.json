 name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/zh/\">首页</a> › <a href=\"/zh/surah/87.html\">章 Al-A&#x27;laa</a> › 节 3</nav><h1>经注： 章 Al-A&#x27;laa 87:3</h1><p class=\"vt ar\" lang=\"ar\">﴿وَالَّذِي قَدَّرَ فَهَدَىٰ﴾</p><section><h3>意义翻译</h3><p class=\"tr\">他预定万物，而加以引导。</p><span class=\"cr\" dir=\"ltr\">Chinese Translation - Muhammad Makeen — v1.0.2 · QuranEnc.com</span></section><p class=\"cr\">两位伊玛目的话以阿拉伯语原文逐字呈现，并附出处。</p><section><h2>伊玛目 伊本·盖伊姆</h2><blockquote class=\"ar\" lang=\"ar\">فلما كان المقصود الثناء عليه بهذه الأفعال وهي جملة دخلت الواو عاطفة جملة على جملة<cite>«بدائع الفوائد» 1/192</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=zh#s87a3\">在互动经注中打开（完整原文）</a><div class=\"pn\"><a href=\"/zh/ayah/87-1.html\">上一节 (87:1)</a><a href=\"/zh/ayah/87-9.html\">下一节 (87:9)</a></div></main><footer class=\"site-foot\"><span>两位谢赫经注汇编 · <a href=\"/zh/\">首页</a> · <a href=\"/about.html\">关于项目</a> · <a href=\"/privacy.html\">隐私与条款</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/87-9.html":"<!doctype html>\n<html lang=\"zh\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>经注： Al-A&#x27;laa 87:9 — 伊本·泰米叶与伊本·盖伊姆的解释</title>\n<meta name=\"description\" content=\"故你当教诲众人，如果教诲有裨于他们的话。\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/zh/ayah/87-9.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/87-9.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/87-9.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/87-9.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/87-9.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/87-9.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/87-9.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/87-9.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/87-9.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/87-9.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/87-9.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/87-9.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/87-9.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/87-9.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/87-9.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/87-9.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/87-9.html\">\n<meta property=\"og:title\" content=\"经注： Al-A&#x27;laa 87:9 — 伊本·泰米叶与伊本·盖伊姆的解释\">\n<meta property=\"og:description\" content=\"故你当教诲众人，如果教诲有裨于他们的话。\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/zh/\">首页</a> › <a href=\"/zh/surah/87.html\">章 Al-A&#x27;laa</a> › 节 9</nav><h1>经注： 章 Al-A&#x27;laa 87:9</h1><p class=\"vt ar\" lang=\"ar\">﴿فَذَكِّرْ إِن نَّفَعَتِ الذِّكْرَىٰ﴾</p><section><h3>意义翻译</h3><p class=\"tr\">故你当教诲众人，如果教诲有裨于他们的话。</p><span class=\"cr\" dir=\"ltr\">Chinese Translation - Muhammad Makeen — v1.0.2 · QuranEnc.com</span></section><p class=\"cr\">两位伊玛目的话以阿拉伯语原文逐字呈现，并附出处。</p><section><h2>伊斯兰谢赫 伊本·泰米叶</h2><blockquote class=\"ar\" lang=\"ar\">الوجه الثالث: أن قوله: {الذكرى} يتناول التذكر والتذكير. فإنه قال: {فذكر إن نفعت الذكرى} . فلا بد أن يتناول ذلك تذكيره.<cite>«مجموع الفتاوى» 16/166</cite></blockquote><h3>他引述他人的说法</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الفراء والنحاس والزهراوي والواحدي والبغوي</span> <span class=\"st\">حكاه</span> «وقيل: ذكر إن نفعت الذكرى وإن لم تنفع. قاله طائفة، أولهم الفراء»<cite>«مجموع الفتاوى» 16/154</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الفراء والنحاس والزهراوي</span> <span class=\"st\">حكاه</span> «معناه &quot; وإن لم تنفع &quot; فاقتصر على الاسم الواحد لدلالته على الثاني»<cite>«مجموع الفتاوى» 16/167</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">مقاتل</span> <span class=\"st\">حكاه</span> «فذكر وقد نفعت الذكرى»<cite>«مجموع الفتاوى» 16/154</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=zh#s87a9\">在互动经注中打开（完整原文）</a><div class=\"pn\"><a href=\"/zh/ayah/87-3.html\">上一节 (87:3)</a><a href=\"/zh/ayah/87-10.html\">下一节 (87:10)</a></div></main><footer class=\"site-foot\"><span>两位谢赫经注汇编 · <a href=\"/zh/\">首页</a> · <a href=\"/about.html\">关于项目</a> · <a href=\"/privacy.html\">隐私与条款</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/87-10.html":"<!doctype html>\n<html lang=\"zh\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>经注： Al-A&#x27;laa 87:10 — 伊本·泰米叶与伊本·盖伊姆的解释</title>\n<meta name=\"description\" content=\"畏主的人，将觉悟；\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/zh/ayah/87-10.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/87-10.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/87-10.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/87-10.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/87-10.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/87-10.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/87-10.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/87-10.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/87-10.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/87-10.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/87-10.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/87-10.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/87-10.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/87-10.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/87-10.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/87-10.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/87-10.html\">\n<meta property=\"og:title\" content=\"经注： Al-A&#x27;laa 87:10 — 伊本·泰米叶与伊本·盖伊姆的解释\">\n<meta property=\"og:description\" content=\"畏主的人，将觉悟；\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/zh/\">首页</a> › <a href=\"/zh/surah/87.html\">章 Al-A&#x27;laa</a> › 节 10</nav><h1>经注： 章 Al-A&#x27;laa 87:10</h1><p class=\"vt ar\" lang=\"ar\">﴿سَيَذَّكَّرُ مَن يَخْشَىٰ﴾</p><section><h3>意义翻译</h3><p class=\"tr\">畏主的人，将觉悟；</p><span class=\"cr\" dir=\"ltr\">Chinese Translation - Muhammad Makeen — v1.0.2 · QuranEnc.com</span></section><p class=\"cr\">两位伊玛目的话以阿拉伯语原文逐字呈现，并附出处。</p><section><h2>伊斯兰谢赫 伊本·泰米叶</h2><blockquote class=\"ar\" lang=\"ar\">يقتضي أن كل من يخشى يتذكر.<cite>«مجموع الفتاوى» 16/171</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">والخشية قد تحصل عقب الذكر وقد تحصل قبل الذكر وقوله: {من يخشى} مطلق. ومن الناس من يظن أن ذلك يقتضي أنه لا بد أن يكون قد خشي أولا حتى يذكر وليس كذلك.<cite>«مجموع الفتاوى» 16/171</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">والتذكر هو الذكر التام الذي يذكره المذكر به وينتفع به.<cite>«مجموع الفتاوى» 16/158</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=zh#s87a10\">在互动经注中打开（完整原文）</a><div class=\"pn\"><a href=\"/zh/ayah/87-9.html\">上一节 (87:9)</a><a href=\"/zh/ayah/87-14.html\">下一节 (87:14)</a></div></main><footer class=\"site-foot\"><span>两位谢赫经注汇编 · <a href=\"/zh/\">首页</a> · <a href=\"/about.html\">关于项目</a> · <a href=\"/privacy.html\">隐私与条款</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/87-14.html":"<!doctype html>\n<html lang=\"zh\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>经注： Al-A&#x27;laa 87:14 — 伊本·泰米叶与伊本·盖伊姆的解释</title>\n<meta name=\"description\" content=\"纯洁者必定成功，\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/zh/ayah/87-14.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/87-14.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/87-14.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/87-14.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/87-14.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/87-14.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/87-14.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/87-14.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/87-14.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/87-14.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/87-14.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/87-14.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/87-14.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/87-14.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/87-14.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/87-14.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/87-14.html\">\n<meta property=\"og:title\" content=\"经注： Al-A&#x27;laa 87:14 — 伊本·泰米叶与伊本·盖伊姆的解释\">\n<meta property=\"og:description\" content=\"纯洁者必定成功，\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/zh/\">首页</a> › <a href=\"/zh/surah/87.html\">章 Al-A&#x27;laa</a> › 节 14</nav><h1>经注： 章 Al-A&#x27;laa 87:14</h1><p class=\"vt ar\" lang=\"ar\">﴿قَدْ أَفْلَحَ مَن تَزَكَّىٰ﴾</p><section><h3>意义翻译</h3><p class=\"tr\">纯洁者必定成功，</p><span class=\"cr\" dir=\"ltr\">Chinese Translation - Muhammad Makeen — v1.0.2 · QuranEnc.com</span></section><p class=\"cr\">两位伊玛目的话以阿拉伯语原文逐字呈现，并附出处。</p><section><h2>伊斯兰谢赫 伊本·泰米叶</h2><blockquote class=\"ar\" lang=\"ar\">فالتزكية وإن كان أصلها النماء والبركة وزيادة الخير فإنما تحصل بإزالة الشر؛ فلهذا صار التزكي يجمع هذا وهذا.<cite>«مجموع الفتاوى» 10/97</cite></blockquote><h3>他引述他人的说法</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الحسن وأبو الأحوص والزجاج</span> <span class=\"st\">أقرّه</span> «من كان عمله زاكيا وقال أبو الأحوص: زكاة الأمور كلها وقال الزجاج: تزكى بطاعة الله عز وجل»<cite>«مجموع الفتاوى» 10/633</cite></blockquote><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الزجاج</span> <span class=\"st\">أقرّه</span> «تزكى بطاعة الله عز وجل ومعنى الزاكي النامي الكثير.»<cite>«مجموع الفتاوى» 10/633</cite></blockquote></section><section><h2>伊玛目 伊本·盖伊姆</h2><blockquote class=\"ar\" lang=\"ar\">أى تعمل بطاعة الله تعالى، فتصير زاكيا<cite>«إغاثة اللهفان من مصايد الشيطان» 1/50</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وقدم زكاة الفطر على صلاة العيد تقديما لما قدمه في قوله {قد أفلح من تزكى وذكر اسم ربه فصلى} [الأعلى: 14] [الأعلى: 13]<cite>«زاد المعاد في هدي خير العباد» 2/320</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=zh#s87a14\">在互动经注中打开（完整原文）</a><div class=\"pn\"><a href=\"/zh/ayah/87-10.html\">上一节 (87:10)</a></div></main><footer class=\"site-foot\"><span>两位谢赫经注汇编 · <a href=\"/zh/\">首页</a> · <a href=\"/about.html\">关于项目</a> · <a href=\"/privacy.html\">隐私与条款</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/87.html":"<!doctype html>\n<html lang=\"zh\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>经注： 章 Al-A&#x27;laa — 伊本·泰米叶与伊本·盖伊姆的解释</title>\n<meta name=\"description\" content=\"经注： 章 Al-A&#x27;laa — 伊本·泰米叶与伊本·盖伊姆论《古兰经》的意义\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/zh/surah/87.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/surah/87.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/surah/87.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/surah/87.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/surah/87.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/surah/87.h