shaikhain.com/ha/ayah/103-2.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/103-2.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/103-2.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/103-2.html\">\n<meta property=\"og:title\" content=\"经注： Al-Asr 103:2 — 伊本·泰米叶与伊本·盖伊姆的解释\">\n<meta property=\"og:description\" content=\"人确是在亏折之中，\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"首页\", \"item\": \"https://tafsirshaikhain.com/zh/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"章 Al-Asr\", \"item\": \"https://tafsirshaikhain.com/zh/surah/103.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"节 2\", \"item\": \"https://tafsirshaikhain.com/zh/ayah/103-2.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/zh/\">首页</a> › <a href=\"/zh/surah/103.html\">章 Al-Asr</a> › 节 2</nav><h1>经注： 章 Al-Asr 103:2</h1><p class=\"vt ar\" lang=\"ar\">﴿إِنَّ الْإِنسَانَ لَفِي خُسْرٍ﴾</p><section><h3>意义翻译</h3><p class=\"tr\">人确是在亏折之中，</p><span class=\"cr\" dir=\"ltr\">Chinese Translation - Muhammad Makeen — v1.0.2 · QuranEnc.com</span></section><p class=\"cr\">两位伊玛目的话以阿拉伯语原文逐字呈现，并附出处。</p><section><h2>伊斯兰谢赫 伊本·泰米叶</h2><blockquote class=\"ar\" lang=\"ar\">لأن من لغة القوم استعمال الواحد في الجمع كقوله: {إن الإنسان لفي خسر}<cite>«مجموع الفتاوى» 6/365</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فإن الله تعالى أخبر أن جميع الناس خاسرون إلا من كان في نفسه مؤمنا صالحا؛ ومع غيره موصيا بالحق موصيا بالصبر.<cite>«مجموع الفتاوى» 28/152</cite></blockquote></section><section><h2>伊玛目 伊本·盖伊姆</h2><blockquote class=\"ar\" lang=\"ar\">لما قال {إن الإنسان لفي خسر} فإنه ضيق الاستثناء وخصصه<cite>«التبيان في أقسام القرآن» 1/85</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فمطلق الخسار شيء والخسار المطلق شيء وهو سبحانه إنما قال {إن الإنسان لفي خسر}<cite>«التبيان في أقسام القرآن» 1/86</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=zh#s103a2\">在互动经注中打开（完整原文）</a><div class=\"pn\"><a href=\"/zh/ayah/103-1.html\">上一节 (103:1)</a><a href=\"/zh/ayah/103-3.html\">下一节 (103:3)</a></div></main><footer class=\"site-foot\"><span>两位谢赫经注汇编 · <a href=\"/zh/\">首页</a> · <a href=\"/about.html\">关于项目</a> · <a href=\"/privacy.html\">隐私与条款</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/103-3.html":"<!doctype html>\n<html lang=\"zh\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>经注： Al-Asr 103:3 — 伊本·泰米叶与伊本·盖伊姆的解释</title>\n<meta name=\"description\" content=\"惟信道而且行善，并以真理相劝，以坚忍相勉的人则不然。\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/zh/ayah/103-3.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/103-3.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/103-3.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/103-3.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/103-3.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/103-3.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/103-3.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/103-3.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/103-3.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/103-3.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/103-3.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/103-3.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/103-3.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/103-3.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/103-3.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/103-3.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/zh/ayah/103-3.html\">\n<meta property=\"og:title\" content=\"经注： Al-Asr 103:3 — 伊本·泰米叶与伊本·盖伊姆的解释\">\n<meta property=\"og:description\" content=\"惟信道而且行善，并以真理相劝，以坚忍相勉的人则不然。\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<meta property=\"og:image\" content=\"https://tafsirshaikhain.com/og.png\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"首页\", \"item\": \"https://tafsirshaikhain.com/zh/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"章 Al-Asr\", \"item\": \"https://tafsirshaikhain.com/zh/surah/103.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"节 3\", \"item\": \"https://tafsirshaikhain.com/zh/ayah/103-3.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/zh/\">首页</a> › <a href=\"/zh/surah/103.html\">章 Al-Asr</a> › 节 3</nav><h1>经注： 章 Al-Asr 103:3</h1><p class=\"vt ar\" lang=\"ar\">﴿إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَتَوَاصَوْا بِالْحَقِّ وَتَوَاصَوْا بِالصَّبْرِ﴾</p><section><h3>意义翻译</h3><p class=\"tr\">惟信道而且行善，并以真理相劝，以坚忍相勉的人则不然。</p><span class=\"cr\" dir=\"ltr\">Chinese Translation - Muhammad Makeen — v1.0.2 · QuranEnc.com</span></section><p class=\"cr\">两位伊玛目的话以阿拉伯语原文逐字呈现，并附出处。</p><section><h2>伊斯兰谢赫 伊本·泰米叶</h2><h3>他引述他人的说法</h3><blockquote class=\"ar\" lang=\"ar\"><span class=\"who\">الإمام الشافعي</span> <span class=\"st\">استشهد به</span> «لو فكر الناس كلهم في سورة (والعصر لكفت»<cite>«مجموع الفتاوى» 28/152</cite></blockquote></section><section><h2>伊玛目 伊本·盖伊姆</h2><blockquote class=\"ar\" lang=\"ar\">ولما كان الإنسان له قوتان قوة العلم وقوة العمل<cite>«التبيان في أقسام القرآن» 1/86</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فإن التواصي هو امر الغير بالإيمان والعمل الصالح وهو قدر زائد على مجرد فعله<cite>«التبيان في أقسام القرآن» 1/85</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">استثنى سبحانه من كمل قوته العلمية بالإيمان وقوته العملية بالعمل الصالح وإنقاد لأمر غيره له 