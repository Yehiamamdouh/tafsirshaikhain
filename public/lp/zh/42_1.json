.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"首页\", \"item\": \"https://tafsirshaikhain.com/zh/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"章 Ash-Shura\", \"item\": \"https://tafsirshaikhain.com/zh/surah/42.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"节 50\", \"item\": \"https://tafsirshaikhain.com/zh/ayah/42-50.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.muy{display:grid;gap:6px;background:var(--sheet,#fff);border:1px dashed var(--line,#d9dee6);border-inline-start:4px solid var(--muted,#5b6676);border-radius:10px;padding:12px 14px;margin:4px 0}.muy-head{display:flex;flex-wrap:wrap;gap:4px 10px;align-items:baseline}.muy-head b{font-family:var(--f-display,sans-serif);font-weight:600;font-size:15px}.muy-head small{font-size:12.5px;color:var(--muted,#5b6676)}.muy-text{margin:0;font-family:var(--f-read,serif);font-size:17px;line-height:1.95;overflow-wrap:anywhere}.muy-fn{margin:0;font-size:14px;line-height:1.7;color:var(--muted,#5b6676);white-space:pre-line}.muy-credit{font-size:12px;color:var(--muted,#5b6676);overflow-wrap:anywhere}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/zh/\">首页</a> › <a href=\"/zh/surah/42.html\">章 Ash-Shura</a> › 节 50</nav><h1>经注： 章 Ash-Shura 42:50</h1><p class=\"vt ar\" lang=\"ar\">﴿أَوْ يُزَوِّجُهُمْ ذُكْرَانًا وَإِنَاثًا وَيَجْعَلُ مَن يَشَاءُ عَقِيمًا إِنَّهُ عَلِيمٌ قَدِيرٌ﴾</p><section><h3>意义翻译</h3><p class=\"tr\">或使他们兼生男孩和女孩；他使他所意欲者成为不能生育的。他确是全知的，确是全能的。</p><span class=\"cr\" dir=\"ltr\">Chinese Translation - Muhammad Makeen — v1.0.2 · QuranEnc.com</span></section><p class=\"cr\">两位伊玛目的话以阿拉伯语原文逐字呈现，并附出处。</p><section><h2>伊斯兰谢赫 伊本·泰米叶</h2><blockquote class=\"ar\" lang=\"ar\">والزوج أعم من النكاح المعروف قال تعالى: {يهب لمن يشاء إناثا ويهب لمن يشاء الذكور} {أو يزوجهم ذكرانا وإناثا}<cite>«مجموع الفتاوى» 15/326</cite></blockquote></section><section><h2>伊玛目 伊本·盖伊姆</h2><blockquote class=\"ar\" lang=\"ar\">وأما الإذكار والإيناث: فليس بسبب طبيعي، وإنما سببه: الفاعل المختار الذي يأمر الملك به، مع تقدير الشقاوة والسعادة، والرزق، والأجل، ولذلك جمع بين هذه الأربع في الحديث «فيقول الملك: يا رب، ذكر؟ يا رب، أنثى؟ فيقضي ربك ما شاء، ويكتب الملك» . وقد رد سبحانه ذلك إلى محض مشيئته في قوله تعالى: {يهب لمن يشاء إناثا ويهب لمن يشاء الذكور} [الشورى: 49] {أو يزوجهم ذكرانا وإناثا ويجعل من يشاء عقيما} [الشورى: 50] .<cite>«الطرق الحكمية» 1/185</cite></blockquote></section><div class=\"muy\"><div class=\"muy-head\"><b>《古兰经简明注释》</b><small>经文的总体含义——并非两位谢赫的话</small></div><p class=\"muy-text\">诸天和大地的权力都归真主，祂随意创造男人、女人和其他，祂赐予祂意欲者女孩，禁止其得男孩；祂赐予祂意欲者男孩，禁止其得女孩；祂使祂意欲者成为不能生育子嗣之人。真主确是彻知当下和未来的，这是真主完美的属性和智慧，任何事务不得瞒祂，祂是万能的。</p><a class=\"muy-credit\" href=\"https://quranenc.com/en/browse/chinese_mokhtasar\" target=\"_blank\" rel=\"noopener\" dir=\"ltr\">Chinese Translation of Al-Mukhtasar in Interpreting the Noble Quran — 2026-11-04 · QuranEnc.com</a></div><a class=\"btn pri open\" href=\"/tafsir.html?lang=zh#s42a50\">在互动经注中打开（完整原文）</a><div class=\"pn\"><a href=\"/zh/ayah/42-49.html\">上一节 (42:49)</a><a href=\"/zh/ayah/42-51.html\">下一节 (42:51)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/42-50.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/42-50.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/42-50.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/42-50.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/42-50.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/42-50.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/42-50.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/42-50.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/42-50.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/42-50.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/42-50.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/42-50.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/42-50.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/42-50.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <b lang=\"zh\">中文</b> · <a href=\"/hi/ayah/42-50.html\" hreflang=\"hi\" lang=\"hi\" data-l=\"hi\">हिन्दी</a> · <a href=\"/ps/ayah/42-50.html\" hreflang=\"ps\" lang=\"ps\" data-l=\"ps\">پښتو</a> · <a href=\"/so/ayah/42-50.html\" hreflang=\"so\" lang=\"so\" data-l=\"so\">Soomaali</a> · <a href=\"/uz/ayah/42-50.html\" hreflang=\"uz\" lang=\"uz\" data-l=\"uz\">Ўзбекча</a> · <a href=\"/ku/ayah/42-50.html\" hreflang=\"ku\" lang=\"ku\" data-l=\"ku\">کوردی</a> · <a href=\"/az/ayah/42-50.html\" hreflang=\"az\" lang=\"az\" data-l=\"az\">Azərbaycanca</a> · <a href=\"/bs/ayah/42-50.html\" hreflang=\"bs\" lang