_image\">\n<link rel=\"manifest\" href=\"/manifest.webmanifest\">\n<link rel=\"apple-touch-icon\" href=\"/icon-192.png\">\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"Article\", \"headline\": \"经注： Ash-Shu'araa 26:23 — 伊本·泰米叶与伊本·盖伊姆的解释\", \"description\": \"法老说：“众世界的主是什么？”\", \"inLanguage\": \"zh\", \"url\": \"https://tafsirshaikhain.com/zh/ayah/26-23.html\", \"mainEntityOfPage\": \"https://tafsirshaikhain.com/zh/ayah/26-23.html\", \"image\": \"https://tafsirshaikhain.com/og.png\", \"author\": [{\"@type\": \"Person\", \"name\": \"伊斯兰谢赫 伊本·泰米叶\"}, {\"@type\": \"Person\", \"name\": \"伊玛目 伊本·盖伊姆\"}], \"isPartOf\": {\"@type\": \"WebSite\", \"name\": \"两位谢赫经注汇编\", \"url\": \"https://tafsirshaikhain.com/zh/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"首页\", \"item\": \"https://tafsirshaikhain.com/zh/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"章 Ash-Shu'araa\", \"item\": \"https://tafsirshaikhain.com/zh/surah/26.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"节 23\", \"item\": \"https://tafsirshaikhain.com/zh/ayah/26-23.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/zh/\">首页</a> › <a href=\"/zh/surah/26.html\">章 Ash-Shu&#x27;araa</a> › 节 23</nav><h1>经注： 章 Ash-Shu&#x27;araa 26:23</h1><p class=\"vt ar\" lang=\"ar\">﴿قَالَ فِرْعَوْنُ وَمَا رَبُّ الْعَالَمِينَ﴾</p><section><h3>意义翻译</h3><p class=\"tr\">法老说：“众世界的主是什么？”</p><span class=\"cr\" dir=\"ltr\">Chinese Translation - Muhammad Makeen — v1.0.2 · QuranEnc.com</span></section><p class=\"cr\">两位伊玛目的话以阿拉伯语原文逐字呈现，并附出处。</p><section><h2>伊斯兰谢赫 伊本·泰米叶</h2><blockquote class=\"ar\" lang=\"ar\">فإن سؤال فرعون بقوله: {وما رب العالمين} استفهام إنكار لوجوده، ليس هو استفهام طلب لتعريف ماهيته كما ظن ذلك بعض المتأخرين<cite>«منهاج السنة النبوية في نقض كلام الشيعة القدرية» 2/271</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فإن فرعون لم يكن مقرا بالصانع ألبتة، بل كان جاحدا له، وكان استفهامه استفهام إنكار لوجوده<cite>«منهاج السنة النبوية في نقض كلام الشيعة القدرية» 2/271</cite></blockquote></section><section><h2>伊玛目 伊本·盖伊姆</h2><blockquote class=\"ar\" lang=\"ar\">ولذلك لما سأل فرعون موسى عن حقيقة ربه، بقوله: {وما رب العالمين} [الشعراء: 23] أجابه موسى بقوله: {رب السماوات والأرض وما بينهما} [مريم: 65] إذ لا وصول للبشر إلى حقيقة ذاته<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 3/221</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">فدلهم على نفسه بصفاته الثبوتية؛ من كونه صمدا، وصفاته السلبية المتضمنة للثبوت؛ من كونه &quot; لم يلد ولم يولد ولم يكن له كفوا أحد &quot; لم يجعل لهم سبيلا إلى معرفة الذات والكنه.<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 3/221</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=zh#s26a23\">在互动经注中打开（完整原文）</a><div class=\"pn\"><a href=\"/zh/ayah/26-10.html\">上一节 (26:10)</a><a href=\"/zh/ayah/26-27.html\">下一节 (26:27)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/26-23.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/26-23.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/26-23.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/26-23.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/26-23.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/26-23.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/26-23.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/26-23.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/26-23.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/26-23.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/26-23.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/26-23.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/26-23.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español</a> · <a href=\"/de/ayah/26-23.html\" hreflang=\"de\" lang=\"de\" data-l=\"de\">Deutsch</a> · <b lang=\"zh\">中文</b></nav>\n<footer class=\"site-foot\"><span>两位谢赫经注汇编 · <a href=\"/zh/\">首页</a> · <a href=\"/about.html\">关于项目</a> · <a href=\"/privacy.html\">隐私与条款</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n<script>try{localStorage.setItem(\"lang\",\"zh\")}catch(e){}document.addEventListener(\"click\",function(e){var a=e.target.closest&&e.target.closest(\"[data-l]\");if(a)try{localStorage.setItem(\"lang\",a.dataset.l)}catch(x){}})</script>\n</body>\n</html>\n","ayah/26-27.html":"<!doctype html>\n<html lang=\"zh\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name