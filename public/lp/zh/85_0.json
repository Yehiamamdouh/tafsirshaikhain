operty=\"og:description\" content=\"记录在一块受保护的天牌上。\">\n<meta name=\"theme-color\" content=\"#1f4d3a\">\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/zh/\">首页</a> › <a href=\"/zh/surah/85.html\">章 Al-Burooj</a> › 节 22</nav><h1>经注： 章 Al-Burooj 85:22</h1><p class=\"vt ar\" lang=\"ar\">﴿فِي لَوْحٍ مَّحْفُوظٍ﴾</p><section><h3>意义翻译</h3><p class=\"tr\">记录在一块受保护的天牌上。</p><span class=\"cr\" dir=\"ltr\">Chinese Translation - Muhammad Makeen — v1.0.2 · QuranEnc.com</span></section><p class=\"cr\">两位伊玛目的话以阿拉伯语原文逐字呈现，并附出处。</p><section><h2>伊玛目 伊本·盖伊姆</h2><blockquote class=\"ar\" lang=\"ar\">والقرآن كتبه الله في اللوح المحفوظ قبل خلق السماوات والأرض كما قال تعالى: {بل هو قرآن مجيد في لوح محفوظ}<cite>«شفاء العليل في مسائل القضاء والقدر والحكمة والتعليل» 1/41</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=zh#s85a22\">在互动经注中打开（完整原文）</a><div class=\"pn\"><a href=\"/zh/ayah/85-20.html\">上一节 (85:20)</a></div></main><footer class=\"site-foot\"><span>两位谢赫经注汇编 · <a href=\"/zh/\">首页</a> · <a href=\"/about.html\">关于项目</a> · <a href=\"/privacy.html\">隐私与条款</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","surah/85.html":"<!doctype html>\n<html lang=\"zh\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>经注： 章 Al-Bu