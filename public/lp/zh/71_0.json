tItem\", \"position\": 2, \"name\": \"章 Nooh\", \"item\": \"https://tafsirshaikhain.com/zh/surah/71.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"节 15\", \"item\": \"https://tafsirshaikhain.com/zh/ayah/71-15.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}</style>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/zh/\">首页</a> › <a href=\"/zh/surah/71.html\">章 Nooh</a> › 节 15</nav><h1>经注： 章 Nooh 71:15</h1><p class=\"vt ar\" lang=\"ar\">﴿أَلَمْ تَرَوْا كَيْفَ خَلَقَ اللَّهُ سَبْعَ سَمَاوَاتٍ طِبَاقًا﴾</p><section><h3>意义翻译</h3><p class=\"tr\">难道你们没有看到安拉怎样创造七层天，</p><span class=\"cr\" dir=\"ltr\">Chinese Translation - Muhammad Makeen — v1.0.2 · QuranEnc.com</span></section><p class=\"cr\">两位伊玛目的话以阿拉伯语原文逐字呈现，并附出处。</p><section><h2>伊玛目 伊本·盖伊姆</h2><blockquote class=\"ar\" lang=\"ar\">كما قال تعالى: {ألم تروا كيف خلق الله سبع سماوات طباقا} [نوح: 15] ، وقوله تعالى: {ألم تر كيف فعل ربك بأصحاب الفيل} [الفيل: 1] فهاهنا أوقع الرؤية على نفس الفعل،<cite>«مدارج السالكين بين منازل إياك نعبد وإياك نستعين» 3/230</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=zh#s71a15\">在互动经注中打开（完整原文）</a><div class=\"pn\"><a href=\"/zh/ayah/71-10.html\">上一节 (71:10)</a><a href=\"/zh/ayah/71-16.html\">下一节 (71:16)</a></div></main><footer class=\"site-foot\"><span>两位谢赫经注汇编 · <a href=\"/zh/\">首页</a> · <a href=\"/about.html\">关于项目</a> · <a href=\"/privacy.html\">隐私与条款</a></span><a href=\"https://doersadv.com\" rel=\"noopener\" dir=\"ltr\">Developed by Doers</a></footer>\n</body>\n</html>\n","ayah/71-16.html":"<!doctype html>\n<html lang=\"zh\" dir=\"ltr\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>经注： Nooh 71:16 — 伊本·泰米叶与伊本·盖伊姆的解释</title>\n<meta name=\"description\" content=\"并以月亮为光明，以太阳为明灯吗？\">\n<link rel=\"canonical\" href=\"https://tafsirshaikhain.com/zh/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"ar\" href=\"https://tafsirshaikhain.com/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"x-default\" href=\"https://tafsirshaikhain.com/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"en\" href=\"https://tafsirshaikhain.com/en/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"ur\" href=\"https://tafsirshaikhain.com/ur/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"id\" href=\"https://tafsirshaikhain.com/id/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"tr\" href=\"https://tafsirshaikhain.com/tr/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"fr\" href=\"https://tafsirshaikhain.com/fr/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"bn\" href=\"https://tafsirshaikhain.com/bn/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"ms\" href=\"https://tafsirshaikhain.com/ms/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"fa\" href=\"https://tafsirshaikhain.com/fa/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"ru\" href=\"https://tafsirshaikhain.com/ru/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"sw\" href=\"https://tafsirshaikhain.com/sw/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"ha\" href=\"https://tafsirshaikhain.com/ha/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"es\" href=\"https://tafsirshaikhain.com/es/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"de\" href=\"https://tafsirshaikhain.com/de/ayah/71-16.html\">\n<link rel=\"alternate\" hreflang=\"zh\" href=\"https://tafsirshaikhain.com/z