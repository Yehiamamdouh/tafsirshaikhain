ps://tafsirshaikhain.com/zh/\"}}</script>\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"BreadcrumbList\", \"itemListElement\": [{\"@type\": \"ListItem\", \"position\": 1, \"name\": \"首页\", \"item\": \"https://tafsirshaikhain.com/zh/\"}, {\"@type\": \"ListItem\", \"position\": 2, \"name\": \"章 Al-Qadr\", \"item\": \"https://tafsirshaikhain.com/zh/surah/97.html\"}, {\"@type\": \"ListItem\", \"position\": 3, \"name\": \"节 4\", \"item\": \"https://tafsirshaikhain.com/zh/ayah/97-4.html\"}]}</script>\n<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"/theme.css\">\n<style>body{font-family:system-ui,\"Segoe UI\",sans-serif;color:var(--ink);padding:20px 16px 48px;line-height:1.6}.tr{font-size:17px;line-height:1.8;margin:0}.cr{font-size:12px;color:var(--muted)}.ar{direction:rtl;text-align:right}.langs{max-width:1100px;margin:24px auto 0;font-size:14px;line-height:2;color:var(--muted)}.langs a{color:var(--lapis)}</style>\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-ER9F5C2HC1\"></script>\n<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','G-ER9F5C2HC1',{allow_google_signals:false,allow_ad_personalization_signals:false});</script>\n</head>\n<body>\n<main class=\"sp\"><nav class=\"crumbs\"><a href=\"/zh/\">首页</a> › <a href=\"/zh/surah/97.html\">章 Al-Qadr</a> › 节 4</nav><h1>经注： 章 Al-Qadr 97:4</h1><p class=\"vt ar\" lang=\"ar\">﴿تَنَزَّلُ الْمَلَائِكَةُ وَالرُّوحُ فِيهَا بِإِذْنِ رَبِّهِم مِّن كُلِّ أَمْرٍ﴾</p><section><h3>意义翻译</h3><p class=\"tr\">众天使和精神，奉他们的主的命令，为一切事务而在那夜间降临</p><span class=\"cr\" dir=\"ltr\">Chinese Translation - Muhammad Makeen — v1.0.2 · QuranEnc.com</span></section><p class=\"cr\">两位伊玛目的话以阿拉伯语原文逐字呈现，并附出处。</p><section><h2>伊斯兰谢赫 伊本·泰米叶</h2><blockquote class=\"ar\" lang=\"ar\">وكذلك قوله: {تنزل الملائكة والروح فيها} يناسب قوله: {فيها يفرق كل أمر حكيم}<cite>«مجموع الفتاوى» 12/248</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">كما أن الروح خصه من بين الملائكة<cite>«بيان تلبيس الجهمية في تأسيس بدعهم الكلامية» 1/472</cite></blockquote><blockquote class=\"ar\" lang=\"ar\">وفي قوله تعالى: {تنزل الملائكة والروح فيها بإذن ربهم من كل أمر سلام} [القدر: 4-5] مع العلم أن ذلك جميعه مخلوق لله مملوك له، وأنه رب ذلك كله، وهم عباده.<cite>«بيان تلبيس الجهمية في تأسيس بدعهم الكلامية» 1/472</cite></blockquote></section><a class=\"btn pri open\" href=\"/tafsir.html?lang=zh#s97a4\">在互动经注中打开（完整原文）</a><div class=\"pn\"><a href=\"/zh/ayah/97-1.html\">上一节 (97:1)</a></div></main><nav class=\"langs\" aria-label=\"Language\">🌐 <a href=\"/ayah/97-4.html\" hreflang=\"ar\" lang=\"ar\" data-l=\"ar\">العربية</a> · <a href=\"/en/ayah/97-4.html\" hreflang=\"en\" lang=\"en\" data-l=\"en\">English</a> · <a href=\"/ur/ayah/97-4.html\" hreflang=\"ur\" lang=\"ur\" data-l=\"ur\">اردو</a> · <a href=\"/id/ayah/97-4.html\" hreflang=\"id\" lang=\"id\" data-l=\"id\">Bahasa Indonesia</a> · <a href=\"/tr/ayah/97-4.html\" hreflang=\"tr\" lang=\"tr\" data-l=\"tr\">Türkçe</a> · <a href=\"/fr/ayah/97-4.html\" hreflang=\"fr\" lang=\"fr\" data-l=\"fr\">Français</a> · <a href=\"/bn/ayah/97-4.html\" hreflang=\"bn\" lang=\"bn\" data-l=\"bn\">বাংলা</a> · <a href=\"/ms/ayah/97-4.html\" hreflang=\"ms\" lang=\"ms\" data-l=\"ms\">Bahasa Melayu</a> · <a href=\"/fa/ayah/97-4.html\" hreflang=\"fa\" lang=\"fa\" data-l=\"fa\">فارسی</a> · <a href=\"/ru/ayah/97-4.html\" hreflang=\"ru\" lang=\"ru\" data-l=\"ru\">Русский</a> · <a href=\"/sw/ayah/97-4.html\" hreflang=\"sw\" lang=\"sw\" data-l=\"sw\">Kiswahili</a> · <a href=\"/ha/ayah/97-4.html\" hreflang=\"ha\" lang=\"ha\" data-l=\"ha\">Hausa</a> · <a href=\"/es/ayah/97-4.html\" hreflang=\"es\" lang=\"es\" data-l=\"es\">Español