{
  // Cloudflare Worker with static assets: the whole site lives in ./public
  "name": "tafsirshaikhain",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "tafsirshaikhain.com", "custom_domain": true },
    { "pattern": "www.tafsirshaikhain.com", "custom_domain": true }
  ],
  "assets": { "directory": "./public", "binding": "ASSETS", "html_handling": "none", "run_worker_first": ["/api/*", "/en", "/en/", "/en/ayah/*", "/en/surah/*", "/ur", "/ur/", "/ur/ayah/*", "/ur/surah/*", "/id", "/id/", "/id/ayah/*", "/id/surah/*", "/tr", "/tr/", "/tr/ayah/*", "/tr/surah/*", "/fr", "/fr/", "/fr/ayah/*", "/fr/surah/*", "/bn", "/bn/", "/bn/ayah/*", "/bn/surah/*", "/ms", "/ms/", "/ms/ayah/*", "/ms/surah/*", "/fa", "/fa/", "/fa/ayah/*", "/fa/surah/*", "/ru", "/ru/", "/ru/ayah/*", "/ru/surah/*", "/sw", "/sw/", "/sw/ayah/*", "/sw/surah/*", "/ha", "/ha/", "/ha/ayah/*", "/ha/surah/*", "/es", "/es/", "/es/ayah/*", "/es/surah/*", "/de", "/de/", "/de/ayah/*", "/de/surah/*", "/zh", "/zh/", "/zh/ayah/*", "/zh/surah/*", "/hi", "/hi/", "/hi/ayah/*", "/hi/surah/*", "/ps", "/ps/", "/ps/ayah/*", "/ps/surah/*", "/so", "/so/", "/so/ayah/*", "/so/surah/*", "/uz", "/uz/", "/uz/ayah/*", "/uz/surah/*", "/ku", "/ku/", "/ku/ayah/*", "/ku/surah/*", "/az", "/az/", "/az/ayah/*", "/az/surah/*", "/bs", "/bs/", "/bs/ayah/*", "/bs/surah/*", "/sq", "/sq/", "/sq/ayah/*", "/sq/surah/*", "/ta", "/ta/", "/ta/ayah/*", "/ta/surah/*", "/ml", "/ml/", "/ml/ayah/*", "/ml/surah/*", "/am", "/am/", "/am/ayah/*", "/am/surah/*", "/pt", "/pt/", "/pt/ayah/*", "/pt/surah/*", "/ff", "/ff/", "/ff/ayah/*", "/ff/surah/*", "/om", "/om/", "/om/ayah/*", "/om/surah/*", "/yo", "/yo/", "/yo/ayah/*", "/yo/surah/*", "/ug", "/ug/", "/ug/ayah/*", "/ug/surah/*", "/as", "/as/", "/as/ayah/*", "/as/surah/*", "/te", "/te/", "/te/ayah/*", "/te/surah/*", "/tg", "/tg/", "/tg/ayah/*", "/tg/surah/*", "/kn", "/kn/", "/kn/ayah/*", "/kn/surah/*", "/ky", "/ky/", "/ky/ayah/*", "/ky/surah/*", "/gu", "/gu/", "/gu/ayah/*", "/gu/surah/*", "/th", "/th/", "/th/ayah/*", "/th/surah/*", "/tl", "/tl/", "/tl/ayah/*", "/tl/surah/*", "/km", "/km/", "/km/ayah/*", "/km/surah/*", "/si", "/si/", "/si/ayah/*", "/si/surah/*", "/nl", "/nl/", "/nl/ayah/*", "/nl/surah/*", "/sv", "/sv/", "/sv/ayah/*", "/sv/surah/*", "/ak", "/ak/", "/ak/ayah/*", "/ak/surah/*", "/mos", "/mos/", "/mos/ayah/*", "/mos/surah/*", "/nqo", "/nqo/", "/nqo/ayah/*", "/nqo/surah/*", "/aa", "/aa/", "/aa/ayah/*", "/aa/surah/*", "/mdh", "/mdh/", "/mdh/ayah/*", "/mdh/surah/*"] },
  // Feedback e-mail: destination is NOT stored here; it is the FEEDBACK_TO secret
  "send_email": [{ "name": "MAIL" }],
  // keep variables set in the dashboard (e.g. FEEDBACK_TO) across Git deploys
  "keep_vars": true,
  "vars": { "FEEDBACK_FROM": "feedback@tafsirshaikhain.com" }
}
